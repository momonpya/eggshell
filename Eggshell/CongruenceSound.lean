module

public import Eggshell.CongruenceComplete

@[expose] public section
namespace Eggshell.QuotientBuilder.CongruenceSound
open Partition

/-- Each computed class is generated by today's edges and Semantic
congruence. Exact-footprint safety alone cannot establish this provenance. -/
def Sound (edges : List UnionEdge) (partition : RawPartition) : Prop :=
  ∀ query, ∀ member ∈ lookup partition query,
    Eggshell.Equivalent edges member query

def IndexSound (edges : List UnionEdge) (index : Representatives) : Prop :=
  ∀ value, Eggshell.Equivalent edges value (index.getD value value)

theorem empty_sound (edges : List UnionEdge) : Sound edges [] := by
  intro query member present
  have equal : member = query := by simpa [lookup, takeClass] using present
  subst member
  exact .refl query

theorem initial_sound (edges : List UnionEdge) (values : List Value) :
    Sound edges (initial values) := by
  intro query member present
  rw [initial_equivalent_empty values query] at present
  exact empty_sound edges query member present

theorem merge_sound {edges : List UnionEdge} {partition : RawPartition}
    (valid : Valid partition) (sound : Sound edges partition) (left right : Value)
    (generated : Eggshell.Equivalent edges left right) :
    Sound edges (merge partition left right) := by
  intro query member present
  rw [merge_lookup valid] at present
  split at present
  · exact sound query member present
  · split at present
    · rename_i _ inside
      have queryLeft : Eggshell.Equivalent edges query left := by
        rcases List.mem_append.mp inside with first | second
        · exact sound left query first
        · exact .trans (sound right query second) (.symm generated)
      apply Eggshell.Equivalent.trans _ (.symm queryLeft)
      rcases List.mem_append.mp present with first | second
      · exact sound left member first
      · exact .trans (sound right member second) (.symm generated)
    · exact sound query member present

theorem explicit_sound {edges : List UnionEdge} {partition : RawPartition}
    (valid : Valid partition) (sound : Sound edges partition) (updates : List UnionEdge)
    (current : ∀ edge ∈ updates, edge ∈ edges) :
    Sound edges (mergeExplicit partition updates) := by
  induction updates generalizing partition with
  | nil => exact sound
  | cons edge rest ih =>
    exact ih (merge_valid valid edge.left edge.right)
      (merge_sound valid sound edge.left edge.right (.union edge (current edge (by simp))))
      (fun next member => current next (by simp [member]))

theorem representatives_sound {edges : List UnionEdge} {partition : RawPartition}
    (valid : Valid partition) (sound : Sound edges partition) :
    IndexSound edges (representatives partition) := by
  intro query
  have equation := Authority.raw_lookup partition valid ({} : Representatives) query
  change (representatives partition).getD query query = _ at equation
  rw [equation]
  split
  · apply Eggshell.Equivalent.symm
    apply sound query
    have present := lookup_contains partition query
    cases found : lookup partition query with
    | nil => simp [found] at present
    | cons head rest => simp
  · simpa using Eggshell.Equivalent.refl (edges := edges) query

theorem normalize_sound (edges : List UnionEdge) (index : Representatives)
    (sound : IndexSound edges index) (arguments : Refs) :
    RefsEquivalent edges arguments (normalizeRefs index arguments) := by
  cases arguments with
  | nil => exact .nil
  | semantic value rest =>
      exact .semantic (sound value) (normalize_sound edges index sound rest)
  | exact value rest => exact .exact (normalize_sound edges index sound rest)
termination_by sizeOf arguments

theorem signature_sound (edges : List UnionEdge) (index : Representatives)
    (sound : IndexSound edges index) (value : Value) :
    Eggshell.Equivalent edges value (signature index value) := by
  cases value with
  | atom bytes => exact .refl _
  | apply operator arguments => exact .apply operator (normalize_sound edges index sound arguments)

theorem application_step (edges : List UnionEdge) (index : Representatives)
    (indexSound : IndexSound edges index) (state : Representatives × RawPartition)
    (valid : Valid state.2) (sound : Sound edges state.2)
    (seen : ApplicationScan.Sound index state.1) (value : Value) :
    Valid (applicationStep index state value).2 ∧ Sound edges (applicationStep index state value).2 ∧
      ApplicationScan.Sound index (applicationStep index state value).1 := by
  rcases state with ⟨known, partition⟩
  cases value with
  | atom bytes => exact ⟨valid, sound, seen⟩
  | apply operator arguments =>
    cases found : known[signature index (.apply operator arguments)]? with
    | none =>
      simp only [applicationStep, congruenceStep, found]
      exact ⟨valid, sound, ApplicationScan.sound_insert index known seen _⟩
    | some prior =>
      have priorSignature := signature_sound edges index indexSound prior
      rw [seen _ _ found] at priorSignature
      have generated := Eggshell.Equivalent.trans priorSignature
        (.symm (signature_sound edges index indexSound (.apply operator arguments)))
      simp only [applicationStep, congruenceStep, found]
      exact ⟨merge_valid valid prior _, merge_sound valid sound prior _ generated, seen⟩

theorem application_fold (edges : List UnionEdge) (index : Representatives)
    (indexSound : IndexSound edges index) (values : List Value)
    (state : Representatives × RawPartition) (valid : Valid state.2)
    (sound : Sound edges state.2) (seen : ApplicationScan.Sound index state.1) :
    Valid (values.foldl (applicationStep index) state).2 ∧
      Sound edges (values.foldl (applicationStep index) state).2 := by
  induction values generalizing state with
  | nil => exact ⟨valid, sound⟩
  | cons value rest ih =>
    have next := application_step edges index indexSound state valid sound seen value
    exact ih _ next.1 next.2.1 next.2.2

theorem congruence_sound (edges : List UnionEdge) (values : List Value)
    {partition : RawPartition} (valid : Valid partition) (sound : Sound edges partition) :
    Valid (congruencePass values partition) ∧ Sound edges (congruencePass values partition) :=
  application_fold edges (representatives partition) (representatives_sound valid sound) values
    ({}, partition) valid sound (by simp [ApplicationScan.Sound])

theorem saturation_sound (edges : List UnionEdge) (values : List Value) (fuel : Nat)
    {partition : RawPartition} (valid : Valid partition) (sound : Sound edges partition) :
    Valid (saturateCongruence values fuel partition) ∧
      Sound edges (saturateCongruence values fuel partition) := by
  induction fuel generalizing partition with
  | zero => exact ⟨valid, sound⟩
  | succ fuel ih =>
    simp only [saturateCongruence_step]
    split
    · exact ⟨valid, sound⟩
    · have next := congruence_sound edges values valid sound
      exact ih next.1 next.2

def QuotientSound (edges : List UnionEdge) (quotient : Quotient) : Prop :=
  ∀ left right, quotient.toEquality.same left right = true →
    Eggshell.Equivalent edges left right

theorem certified_sound (edges : List UnionEdge) {partition : RawPartition}
    (valid : Valid partition) (sound : Sound edges partition) {quotient : Quotient}
    (certified : certify partition = some quotient) : QuotientSound edges quotient := by
  intro left right equal
  have heads : (lookup partition left).headD left = (lookup partition right).headD right := by
    simpa only [Quotient.same_iff_canonical_eq, certify_lookup valid certified] using equal
  exact .symm (sound left right ((heads_equal valid left right).mp heads))

/-- Any equality returned by the actual builder, for any roots, corrections,
deletions or mixed Atom/Apply edges, follows from the current edge set. -/
theorem build_sound (roots : List Value) (persistent runLocal : List UnionEdge)
    (quotient : Quotient) (built : build? roots persistent runLocal = some quotient) :
    QuotientSound (persistent ++ runLocal) quotient := by
  unfold build? at built
  split at built
  · cases Option.some.inj built
    intro left right same
    have same : left = right := by simpa [Quotient.toEquality, Quotient.literal_canonical] using same
    subst right
    exact .refl left
  · unfold congruenceBuild? kernelPartition at built
    let values := kernelValues roots (persistent ++ runLocal)
    have prepared := saturation_sound (persistent ++ runLocal) values values.length
      (explicit_valid (initial_valid values) _) (explicit_sound (initial_valid values) (initial_sound _ values) _
        (fun _ member => member))
    exact certified_sound _ prepared.1 prepared.2 built

/-- The runtime producer returns a generated quotient, not just an
authority-safe arbitrary partition. Proofs erase; no second scan is added. -/
structure Checked (roots : List Value) (persistent runLocal : List UnionEdge) where
  quotient : Quotient
  built : build? roots persistent runLocal = some quotient
  generated : QuotientSound (persistent ++ runLocal) quotient
  fixed : congruencePass (kernelValues roots (persistent ++ runLocal))
      (kernelPartition roots (persistent ++ runLocal)) = kernelPartition roots (persistent ++ runLocal)
  complete : ∀ left ∈ kernelValues roots (persistent ++ runLocal),
    ∀ right ∈ kernelValues roots (persistent ++ runLocal),
      Eggshell.Equivalent (persistent ++ runLocal) left right → quotient.toEquality.same left right = true

theorem Checked.ungenerated_rejected (checked : Checked roots persistent runLocal)
    (left right : Value) (unsupported : ¬ Eggshell.Equivalent (persistent ++ runLocal) left right) :
    checked.quotient.toEquality.same left right = false := by
  cases observed : checked.quotient.toEquality.same left right with
  | false => rfl
  | true => exact False.elim (unsupported (checked.generated left right observed))

theorem Checked.without_edges (checked : Checked roots [] []) (left right : Value) :
    checked.quotient.toEquality.same left right = true ↔ left = right := by
  constructor
  · intro same
    exact Eggshell.Equivalent.without_edges (checked.generated left right same)
  · intro same
    subst right
    exact checked.quotient.toEquality.reflexive left

/-- Corpus pruning/extension cannot change any comparison whose two terms
belong to both closed domains. The current generating edges are fixed;
neither final-result equality nor a corpus-size bound is assumed. -/
theorem Checked.domain_independent (first : Checked roots persistent runLocal)
    (second : Checked otherRoots persistent runLocal) (left right : Value)
    (firstLeft : left ∈ kernelValues roots (persistent ++ runLocal))
    (firstRight : right ∈ kernelValues roots (persistent ++ runLocal))
    (secondLeft : left ∈ kernelValues otherRoots (persistent ++ runLocal))
    (secondRight : right ∈ kernelValues otherRoots (persistent ++ runLocal)) :
    first.quotient.toEquality.same left right = second.quotient.toEquality.same left right := by
  apply Bool.eq_iff_iff.mpr
  exact ⟨fun same => second.complete left secondLeft right secondRight (first.generated left right same),
    fun same => first.complete left firstLeft right firstRight (second.generated left right same)⟩

/-- Text Work and ephemeral text fragments are independent of the root
catalogue even when the edge set contains mixed Atom/Apply unions. -/
theorem Checked.atoms_independent (first : Checked roots persistent runLocal)
    (second : Checked otherRoots persistent runLocal) (left right : ByteArray) :
    first.quotient.toEquality.same (.atom left) (.atom right) =
      second.quotient.toEquality.same (.atom left) (.atom right) := by
  apply Bool.eq_iff_iff.mpr
  exact ⟨fun same => CongruenceComplete.build_complete_atoms otherRoots persistent runLocal second.quotient second.built
      left right (first.generated _ _ same),
    fun same => CongruenceComplete.build_complete_atoms roots persistent runLocal first.quotient first.built
      left right (second.generated _ _ same)⟩

def attach (roots : List Value) (persistent runLocal : List UnionEdge)
    (result : Option Quotient) (exact : result = build? roots persistent runLocal) :
    Option (Checked roots persistent runLocal) :=
  match result with
  | none => none
  | some quotient =>
      some ⟨quotient, exact.symm, build_sound roots persistent runLocal quotient exact.symm,
        CongruenceFixed.kernel_fixed roots (persistent ++ runLocal),
        fun left leftIn right rightIn =>
          CongruenceComplete.build_complete roots persistent runLocal quotient exact.symm left right leftIn rightIn⟩

theorem attach_exact (roots : List Value) (persistent runLocal : List UnionEdge)
    (result : Option Quotient) (exact : result = build? roots persistent runLocal) :
    (attach roots persistent runLocal result exact).map (·.quotient) = result := by
  cases result <;> rfl

end Eggshell.QuotientBuilder.CongruenceSound

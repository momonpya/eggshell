@@ -7102,0 +7105,27 @@
+
+/-- The normal stored producer sends one closed source scope, not every owner
+or window. Original admission checks happen in the client and normal reader;
+the bounded numerical ranking remains advisory throughout. -/
+def keyedSemanticNominations (snapshot : Persistence.Store.Snapshot)
+    (command : List String) (current : String) (staged : List Matcher.Candidate := [])
+    (receipt : Option String := none) : IO (Option IndexedSemanticNominations) := do
+  let some nominated ← KeyedSearchClient.nominate command #[snapshot] current receipt | return none
+  let choice := fun row : KeyedProtocol.ScopedChoice #[snapshot] => row.choice
+  let stored : IndexedSemanticNominations := {
+    durable := nominated.related.map (fun row => (choice row).owner)
+    durableRanking := nominated.ranked.map (fun row => (choice row).owner)
+    durableWindows := nominated.ranked.filterMap fun row =>
+      let original := choice row
+      if original.windows.isEmpty then none else some (original.owner,original.windows.map (·.position))
+    presentationOrder := nominated.ranked.map (fun row => .inl (choice row).owner) }
+  if staged.isEmpty then return some stored
+  -- Unpublished text is a separate, already bounded local domain. No stored
+  -- catalogue is reopened to combine it with the persistent nominations.
+  let some unpublished ← indexedSemanticNominationsUsing snapshot [] {} {} command current staged receipt | return none
+  Receipt.observe receipt "keyed-staged" (Json.mkObj [
+    ("candidates",toJson staged.length),("related",toJson unpublished.staged.length)])
+  return some { stored with
+    staged := unpublished.staged
+    stagedRanking := unpublished.stagedRanking
+    stagedWindows := unpublished.stagedWindows
+    presentationOrder := stored.presentationOrder ++ unpublished.presentationOrder }

module

public import Eggshell.GraphStore
public import Eggshell.CongruenceSound

@[expose] public section
namespace Eggshell.WorkClassLookup
open QuotientBuilder

/-- Only the current generators determine a text Work's class. The source
Work catalogue is deliberately absent, including for mixed Atom/Apply edges.
This is an equality query, not a similarity nomination or a completion. -/
structure Prepared (persistent runLocal : List UnionEdge) where
  checked : CongruenceSound.Checked [] persistent runLocal
  aliases : Quotient.AliasIndex checked.quotient

def prepare? (persistent runLocal : List UnionEdge) : Option (Prepared persistent runLocal) :=
  (CongruenceSound.attach [] persistent runLocal (build? [] persistent runLocal) rfl).map
    fun checked => ⟨checked, Quotient.AliasIndex.prepare checked.quotient⟩

/-- Stored compiled Work is textual. Structured aliases can connect text
members through congruence, but are not themselves textual Work owners. -/
def Prepared.members (prepared : Prepared persistent runLocal) (query : ByteArray) : List Value :=
  (prepared.aliases.aliases (.atom query)).filter AtomQuotient.isAtom

theorem Prepared.member_iff (prepared : Prepared persistent runLocal)
    (query source : ByteArray) :
    Value.atom source ∈ prepared.members query ↔
      Eggshell.Equivalent (persistent ++ runLocal) (.atom query) (.atom source) := by
  simp only [Prepared.members, List.mem_filter, AtomQuotient.isAtom, and_true,
    prepared.aliases.aliases_exact]
  exact ⟨prepared.checked.generated _ _, fun equivalent =>
    CongruenceComplete.build_complete_atoms [] persistent runLocal prepared.checked.quotient
      prepared.checked.built query source equivalent⟩

/-- Equality with the complete corpus-rooted oracle, not a top-K subset.
The source may contain arbitrarily many unrelated Work roots. -/
theorem Prepared.full_iff (prepared : Prepared persistent runLocal)
    (full : CongruenceSound.Checked roots persistent runLocal) (query source : ByteArray) :
    Value.atom source ∈ prepared.members query ↔
      full.quotient.toEquality.same (.atom query) (.atom source) = true := by
  rw [prepared.member_iff]
  exact ⟨fun equivalent => CongruenceComplete.build_complete_atoms roots persistent runLocal
      full.quotient full.built query source equivalent,
    full.generated _ _⟩

/-- Specification of the existing Work-owner posting join, in original row
order. The executable reader below probes the selected Work buckets instead
of constructing this whole list. -/
def Prepared.select (prepared : Prepared persistent runLocal) (query : ByteArray)
    (rows : List α) (work : α → Value) : List α :=
  rows.filter fun row => (prepared.members query).contains (work row)

theorem Prepared.select_full (prepared : Prepared persistent runLocal)
    (full : CongruenceSound.Checked roots persistent runLocal) (query : ByteArray)
    (rows : List α) (work : α → Value)
    (textual : ∀ row ∈ rows, AtomQuotient.isAtom (work row) = true) :
    prepared.select query rows work =
      rows.filter (fun row => full.quotient.toEquality.same (.atom query) (work row)) := by
  apply List.filter_congr
  intro row present
  have atom := textual row present
  cases original : work row with
  | apply operator arguments => simp [original, AtomQuotient.isAtom] at atom
  | atom bytes =>
      apply Bool.eq_iff_iff.mpr
      simpa only [original, List.contains_iff_mem] using prepared.full_iff full query bytes

/-- This witness establishes only Work equality generated by today's edges.
Child membership, result grounding, freshness and extraction still decide
whether any saved operation may actually be skipped. -/
structure Owner (prepared : Prepared persistent runLocal) (query : ByteArray) where
  ordinal : Nat
  edge : OutcomeEdge
  same : prepared.checked.quotient.toEquality.same (.atom query) edge.work = true

theorem Owner.generated {prepared : Prepared persistent runLocal} (owner : Owner prepared query) :
    Eggshell.Equivalent (persistent ++ runLocal) (.atom query) owner.edge.work :=
  prepared.checked.generated _ _ owner.same

theorem Owner.preservesExact (owner : Owner prepared query) :
    Value.SameExactFootprint (.atom query) owner.edge.work :=
  prepared.checked.quotient.equality_preserves_exact owner.same

end Eggshell.WorkClassLookup

namespace Eggshell.Persistence.Store
open WorkClassLookup

/-- Original live Work-owner buckets, followed by original Outcome frames.
There is no source-body/window scan, candidate limit, derived owner, or saved
quotient here. The prepared class and pinned source are separate inputs. -/
def NodeReader.classOwners (reader : NodeReader snapshot)
    (prepared : Prepared persistent runLocal) (query : ByteArray) :
    IO (List (Owner prepared query)) := do
  let ids ← (prepared.members query).filterMapM (findNode? snapshot)
  let documents ← supportDocuments snapshot ids
  documents.mapM fun document => do
    let located ← reader.locateOutcome document.owner
    unless located.header.work == document.work do
      throw (IO.userError "class owner disagrees with original Work posting")
    let edge ← reader.outcome located
    let work ← reader.read document.work
    unless edge.work == work do
      throw (IO.userError "class owner disagrees with original Work value")
    if same : prepared.checked.quotient.toEquality.same (.atom query) edge.work = true then
      return ⟨← getNat snapshot.get (key "member" document.owner), edge, same⟩
    else throw (IO.userError "original Work owner is outside the demanded class")

/-- Source-local buckets also suffice for a fixed multi-DB query. Source
identity remains attached; no complete cross-DB Work catalogue is built. -/
def NodeReaders.classOwners (readers : NodeReaders snapshots)
    (prepared : Prepared persistent runLocal) (query : ByteArray) :
    IO (List (Fin snapshots.size × Owner prepared query)) := do
  let mut found := #[]
  for source in List.finRange snapshots.size do
    for owner in ← (readers.at source).classOwners prepared query do
      found := found.push (source, owner)
  return found.toList

end Eggshell.Persistence.Store

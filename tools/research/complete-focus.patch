+/-- Scored evidence is bounded by its immutable source directory, not by a
+foreground repair batch. Validating a rank never calls the source reader. -/
+structure WindowEvidence (document : Persistence.Store.SearchDocument) where
+  indices : List Nat
+  bounded : indices.length ≤ document.windows.length
+  distinct : hashDistinct indices = indices
+  within : indices.all (fun index => decide (index < document.windows.length)) = true
+
+def WindowEvidence.check? (document : Persistence.Store.SearchDocument) (indices : List Nat) :
+    Option (WindowEvidence document) :=
+  if valid : indices.length ≤ document.windows.length ∧ hashDistinct indices = indices ∧
+      indices.all (fun index => decide (index < document.windows.length)) = true then
+    some ⟨indices,valid.1,valid.2.1,valid.2.2⟩
+  else none
+
+def WindowEvidence.handles (evidence : WindowEvidence document) : List (Fin document.windows.length) :=
+  evidence.indices.attach.map fun index => ⟨index.val, by
+    have := (List.all_eq_true.mp evidence.within) index.val index.property
+    exact of_decide_eq_true this⟩
+
+theorem WindowEvidence.handles_exact (evidence : WindowEvidence document) :
+    evidence.handles.map Fin.val = evidence.indices := by simp [handles]
+
+theorem WindowEvidence.handles_bounded (evidence : WindowEvidence document) :
+    evidence.handles.length ≤ document.windows.length := by
+  simpa [handles] using evidence.bounded
+
+/-- Focus has already scored its finite admitted domain. A reply must preserve
+every original window, including lower ranks; no constant top-k is a domain. -/
+structure WindowOrder (document : Persistence.Store.SearchDocument) where
+  evidence : WindowEvidence document
+  complete : evidence.indices.mergeSort (· ≤ ·) = List.range document.windows.length

+def WindowOrder.check? (document : Persistence.Store.SearchDocument) (indices : List Nat) :
+    Option (WindowOrder document) := do
+  let evidence ← WindowEvidence.check? document indices
+  if complete : evidence.indices.mergeSort (· ≤ ·) = List.range document.windows.length then
+    some ⟨evidence,complete⟩ else none
+
+theorem WindowOrder.covers (order : WindowOrder document) (index : Nat)
+    (within : index < document.windows.length) : index ∈ order.evidence.indices := by
+  have sorted : index ∈ order.evidence.indices.mergeSort (· ≤ ·) := by
+    rw [order.complete]
+    exact List.mem_range.mpr within
+  exact List.mem_mergeSort.mp sorted
+

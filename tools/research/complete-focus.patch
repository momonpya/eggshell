+/-- Focus accumulates once and sorts once. It does not discard already scored
+original positions or repeatedly sort an ever-growing list for every row. -/
+def WindowScore.addComplete (state : WindowScore) (score : Float) (position : Nat) : WindowScore := {
+  best := (state.add score position).best
+  positions := (score,position) :: state.positions }

+theorem WindowScore.complete_best_unchanged (state : WindowScore) (score : Float) (position : Nat) :
+    (state.addComplete score position).best = (state.add score position).best := rfl

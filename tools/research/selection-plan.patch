+def fit (ceiling : Nat × Nat) (cost : List TransportSlice → Nat × Nat)
+    (families : List Family) (mandatory : List TransportSlice := [])
+    (bundles : Array Synapses.Bundles.Projected := #[]) : Option (Fitted ceiling cost mandatory) :=
+  (plan ceiling cost families mandatory bundles).map (·.result)
+
+def Plan.receipt (plan : Plan ceiling cost mandatory) : Json :=
+  let familyRows := plan.families.map fun family => Json.mkObj [
+    ("owner",toJson (relationKey family.owner.relation)),("work",toJson (relationKey family.owner.work)),
+    ("windows",toJson family.windows),("references",toJson family.references),
+    ("canonicalRows",toJson family.cached.size),("synapticRanges",toJson family.synapticRanges.length),
+    ("originalRanges",toJson family.outputRanges.length)]
+  let units := plan.units.mapIdx fun index unit => Id.run do
+    let offer := plan.problem.offers[index]?
+    let atoms := offer.map (·.closure.eraseDups) |>.getD []
+    let charged := atoms.foldl (fun total atom =>
+      (total.1+plan.problem.costs[atom].1,total.2+plan.problem.costs[atom].2)) (0,0)
+    let cues := offer.map (·.covers.eraseDups) |>.getD []
+    let benefit := cues.foldl (fun total cue => total+plan.problem.weights[cue]) 0
+    return Json.mkObj [("id",toJson index),("family",toJson unit.family),
+      ("ranges",toJson unit.ranges),("standaloneCost",toJson charged),("benefit",toJson benefit),
+      ("selected",toJson (plan.selected.contains index))]
+  Json.mkObj [("families",toJson familyRows),("units",toJson units),
+    ("fixedCost",toJson plan.problem.fixed),("limit",toJson plan.problem.limit),("scale",toJson plan.scale),
+    ("selected",toJson plan.selected)]


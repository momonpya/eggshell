+/-- Query-independent original domain. Bounded records remain whole; a row
+without such a record gets its own original unit. Relevance never determines
+which stored row can be purchased. The set is prepared once, not per hint. -/
+def catalogue (rows : Array StoredRow) (records : List (Record rows)) :
+    List (List (Fin rows.size)) :=
+  let entries := records.map (·.indices)
+  let covered := Std.HashSet.ofList entries.flatten
+  entries ++ ((List.finRange rows.size).filter fun index => !covered.contains index).map (fun index => [index])
+
+theorem catalogue_complete (rows : Array StoredRow) (records : List (Record rows))
+    (index : Fin rows.size) : index ∈ (catalogue rows records).flatten := by
+  simp only [catalogue,List.flatten_append]
+  by_cases present : index ∈ (records.map (·.indices)).flatten
+  · exact List.mem_append_left _ present
+  · apply List.mem_append_right
+    apply List.mem_flatten.mpr
+    refine ⟨[index],?_,by simp⟩
+    apply List.mem_map.mpr
+    refine ⟨index,?_,rfl⟩
+    simpa [Std.HashSet.contains_ofList] using present
+
+theorem catalogue_payload_original (rows : Array StoredRow) (records : List (Record rows))
+    (indices : List (Fin rows.size)) (_member : indices ∈ catalogue rows records)
+    (index : Fin rows.size) (_inside : index ∈ indices) : rows[index] ∈ rows :=
+  Array.getElem_mem index.isLt
+

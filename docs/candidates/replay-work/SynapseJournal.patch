+/-- One private project worker publishes replay output at a time. This lease
+does not occupy the short event/ACK journal publication claim. -/
+def refresh (source : PageMap.Snapshot) (storage : Sidecar.Storage) (deadline : Nat)
+    (limit : Nat := 8) (readCache : Option StoredReadLookup.Cache := none)
+    (runner : Option ReplayRunner := none) : IO Result := do
+  if !(← Build.required source storage) && !(← required source storage) then return {}
+  let journal ← prepare source
+  let path := journal.directory.parent.get! / "replay.guard"
+  FileSystem.immutableExistingBytes path ByteArray.empty
+  let lease ← FileSystem.openRead path.toString
+  unless ← FileSystem.tryReadLock lease true do return {complete := false}
+  try refreshQueued source storage deadline limit readCache runner
+  finally FileSystem.unlockRead lease
+

+module
+public import Eggshell.OperationPlan
+public import Eggshell.Worker
+
+@[expose] public section
+namespace Eggshell.Plugin.OperationPool
+open Lean OperationWire DB
+open Synapses.CanonicalSource.Shared (Budget)
+
+def replyBytes : Role → Nat | .search => Daemon.maxFrameBytes | .save => 65536
+def searchReplyCapacity : Nat := OperationPlan.searchWorkers*Daemon.maxFrameBytes
+def saveReplyCapacity : Nat := OperationPlan.saveWorkers*65536
+
+structure Job where
+  request : Request
+  admitted : Nat
+  cancelled : IO.Ref Bool
+  ready : IO.Ref (Option Nat)
+  expires : IO.Ref Nat
+  reply : IO.Promise (Option Json)
+  reservation : Std.Mutex (Worker.Lifetime.Cell Nat)
+
+structure State where
+  plan : OperationPlan.State := OperationPlan.initial
+  jobs : Std.HashMap String Job := {}
+  admitted : Nat := 0
+  started : Nat := 0
+  completed : Nat := 0
+  cancelled : Nat := 0
+  peakActive : Nat := 0
+  peakPending : Nat := 0
+  busy : Nat := 0
+  maxQueueMs : Nat := 0
+
+structure Pool where
+  state : Std.Mutex State
+  searchReplies : Std.Mutex (Budget searchReplyCapacity)
+  saveReplies : Std.Mutex (Budget saveReplyCapacity)
+
+def Pool.new : IO Pool := return ⟨← Std.Mutex.new {},← Std.Mutex.new {},← Std.Mutex.new {}⟩
+
+def validate (request : Request) : IO Unit := do
+  let now ← IO.monoMsNow
+  unless Receipt.validId request.id && !request.session.isEmpty && request.session.utf8ByteSize ≤ 512 &&
+      now < request.cutoff do throw (IO.userError "invalid or expired operation request")
+  match request.role with
+  | .search =>
+    let query ← IO.ofExcept (fromJson? request.payload : Except String Worker.Search)
+    unless query.pending.sessionId == request.session && request.identity == some query.identity &&
+        request.cutoff ≤ query.deadline && query.deadline ≤ now+OperationWire.searchBudgetMs do
+      throw (IO.userError "operation search changed its session or deadline")
+  | .save =>
+    unless request.identity.isNone && !request.finishReady && request.cutoff ≤ now+60000 &&
+        (request.payload.getObjValAs? String "session").toOption == some request.session do
+      throw (IO.userError "operation save changed its private session")
+    let path ← PageMap.absolute (.mk (← IO.ofExcept (request.payload.getObjValAs? String "path")))
+    let files ← sessionFiles request.session
+    unless path.parent == some (files.directory/"deferred") || path.parent == some (files.directory/"checkpoints") do
+      throw (IO.userError "operation save escaped its private durable queue")
+    FileSystem.rejectSymlinkAncestors path
+
+def Pool.submit (pool : Pool) (request : Request) (cancelled : IO.Ref Bool) : IO (Option Job) := do
+  validate request
+  let size := (toJson request).compress.utf8ByteSize
+  unless size ≤ Daemon.maxFrameBytes do throw (IO.userError "operation exceeds its request bound")
+  let job : Job := ⟨request,← IO.monoMsNow,cancelled,← IO.mkRef none,← IO.mkRef request.cutoff,
+    ← IO.Promise.new,← Std.Mutex.new (.open 0)⟩
+  unless !(← cancelled.get) && (← IO.monoMsNow) < request.cutoff do
+    throw (IO.userError "operation admission cancelled or expired")
+  pool.state.atomically do
+    let state ← get
+    if state.plan.contents.closed then throw (IO.userError "operation service is closed")
+    if state.jobs.contains request.id then throw (IO.userError "duplicate operation request identity")
+    let (plan,accepted) := OperationPlan.admit state.plan ⟨request.id,request.role,size,request.cutoff⟩
+    if !accepted then
+      set {state with busy := state.busy+1}
+      return none
+    set {state with
+      plan,jobs := state.jobs.insert request.id job,admitted := state.admitted+1,
+      peakPending := max state.peakPending plan.contents.pending.size}
+    return some job
+
+def Pool.take (pool : Pool) (lane : OperationPlan.Lane) : IO (Option (OperationPlan.Active × Job)) := do
+  let now ← IO.monoMsNow
+  pool.state.atomically do
+    let state ← get
+    let mut retired := #[]
+    let mut jobs := state.jobs
+    for entry in state.plan.contents.pending do
+      if let some job := jobs[entry.id]? then
+        if (← job.cancelled.get) || now ≥ entry.cutoff then
+          job.cancelled.set true
+          unless ← job.reply.isResolved do job.reply.resolve none
+          retired := retired.push entry.id
+          jobs := jobs.erase entry.id
+    let plan := OperationPlan.discard state.plan retired
+    let (plan,active) := OperationPlan.take plan lane now
+    let state := {state with plan,jobs,cancelled := state.cancelled+retired.size}
+    match active with
+    | none => set state; return none
+    | some active =>
+      let some job := jobs[active.job.id]? | throw (IO.userError "operation slot lost its request")
+      set {state with
+        started := state.started+1,
+        peakActive := max state.peakActive plan.contents.active.size,
+        maxQueueMs := max state.maxQueueMs (now-job.admitted)}
+      return some (active,job)
+
+def Pool.reserveReply (pool : Pool) (job : Job) : IO Bool := do
+  repeat
+    unless !(← job.cancelled.get) && (← IO.monoMsNow) < (← job.expires.get) do return false
+    let result ← job.reservation.atomically do
+      match ← get with
+      | .closed => return some false
+      | .open amount =>
+        if amount > 0 then return some true
+        let reserved ← match job.request.role with
+          | .search => pool.searchReplies.atomically do
+            let before : Budget searchReplyCapacity ← get
+            let some next := before.reserve? (replyBytes job.request.role) | return false
+            set next; return true
+          | .save => pool.saveReplies.atomically do
+            let before : Budget saveReplyCapacity ← get
+            let some next := before.reserve? (replyBytes job.request.role) | return false
+            set next; return true
+        if !reserved then return none
+        set (Worker.Lifetime.Cell.open (replyBytes job.request.role))
+        return some true
+    if let some result := result then return result
+    IO.sleep 1
+  return false
+
+def Pool.releaseReply (pool : Pool) (job : Job) : IO Unit := do
+  let amount ← job.reservation.atomically do
+    let (next,owned) := Worker.Lifetime.close (← get)
+    set next
+    return owned.getD 0
+  match job.request.role with
+  | .search => pool.searchReplies.atomically (modify (·.release amount))
+  | .save => pool.saveReplies.atomically (modify (·.release amount))
+
+/-- The slot is service-owned. A disconnected search cancels only its current
+pipe. Saves already in progress retain their durable source-ACK path. -/
+def Pool.run (pool : Pool) (lane : OperationPlan.Lane) (active : OperationPlan.Active) (job : Job) : IO Unit := do
+  let session := s!"shared-operation-{lane.val}"
+  let result ← try
+    unless lane.role == job.request.role do throw (IO.userError "operation role changed its assigned lane")
+    if !(← pool.reserveReply job) || (← job.cancelled.get) then pure none
+    else
+      let policy := job.request.identity.map fun identity => ({
+        identity,finishReady := job.request.finishReady,
+        onReady := fun now => do
+          if job.request.finishReady then job.expires.set identity.deadline
+          job.ready.set (some now)} : Worker.SearchPolicy)
+      let task ← IO.asTask (Worker.exchangeLocal session lane.role.name job.request.payload
+        job.request.cutoff policy) .dedicated
+      repeat
+        if ← IO.hasFinished task then break
+        if (← IO.monoMsNow) ≥ (← job.expires.get) ||
+            (job.request.role == .search && (← job.cancelled.get)) then
+          Worker.cancelLocal session job.request.role.name
+        IO.sleep 5
+      IO.ofExcept (← IO.wait task)
+    catch _ => pure none
+  let result := result.filter (fun value => value.compress.utf8ByteSize+1024 ≤ replyBytes job.request.role)
+  let wasCancelled := (← job.cancelled.get) || (← IO.monoMsNow) ≥ (← job.expires.get)
+  unless ← job.reply.isResolved do job.reply.resolve result
+  pool.state.atomically do
+    modify fun state => {state with
+      plan := OperationPlan.finish state.plan lane active.token
+      jobs := state.jobs.erase active.job.id,completed := state.completed+1,
+      cancelled := state.cancelled+(if wasCancelled then 1 else 0)}
+
+def Pool.close (pool : Pool) : IO Unit := pool.state.atomically do
+  let state ← get
+  for (_,job) in state.jobs do
+    job.cancelled.set true
+    unless ← job.reply.isResolved do job.reply.resolve none
+  set {state with plan := OperationPlan.close state.plan}
+
+def Pool.stats (pool : Pool) : IO Json := do
+  let search ← pool.searchReplies.atomically do return (← get).used
+  let save ← pool.saveReplies.atomically do return (← get).used
+  pool.state.atomically do
+    let state ← get
+    return Json.mkObj [("pending",toJson state.plan.contents.pending.size),
+      ("active",toJson state.plan.contents.active.size),("requestBytes",toJson state.plan.contents.charge),
+      ("maxRequests",toJson OperationPlan.maxRequests),("maxRequestBytes",toJson OperationPlan.maxBytes),
+      ("searchWorkers",toJson OperationPlan.searchWorkers),("saveWorkers",toJson OperationPlan.saveWorkers),
+      ("admitted",toJson state.admitted),("started",toJson state.started),("completed",toJson state.completed),
+      ("cancelled",toJson state.cancelled),("peakActive",toJson state.peakActive),("maxQueueMs",toJson state.maxQueueMs),
+      ("peakPending",toJson state.peakPending),("busyBeforeAdmission",toJson state.busy),
+      ("running",toJson (state.plan.contents.running.toArray.zipIdx |>.filterMap fun (slot,lane) =>
+        slot.map fun active => Json.mkObj [("lane",toJson lane),("id",toJson active.job.id),
+          ("role",toJson active.job.role)])),
+      ("searchReplyBytes",toJson search),("saveReplyBytes",toJson save),
+      ("closed",toJson state.plan.contents.closed)]
+
+end Eggshell.Plugin.OperationPool

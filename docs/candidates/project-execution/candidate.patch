+module
+
+public import Eggshell.PublicationStream
+public import Std.Sync.Mutex
+
+@[expose] public section
+namespace Eggshell.Plugin.OperationWire
+open Lean
+
+/-- The existing native hook budget; original source RPCs have their own
+shorter budget. Dispatch validates this limit without extending a request. -/
+def searchBudgetMs : Nat := 29000
+
+inductive Role where
+  | search | save
+  deriving BEq, DecidableEq, ToJson, FromJson
+
+def Role.name : Role → String | .search => "search" | .save => "save"
+def Role.ofName : String → Option Role | "search" => some .search | "save" => some .save | _ => none
+
+structure Identity where
+  turn : String
+  epoch : Nat
+  deadline : Nat
+  receipt : Option String
+  deriving BEq, Repr, ToJson, FromJson
+
+structure Request where
+  id : String
+  session : String
+  role : Role
+  payload : Json
+  cutoff : Nat
+  identity : Option Identity
+  finishReady : Bool
+  deriving ToJson, FromJson
+
+structure Reply where
+  id : String
+  completed : Bool
+  payload : Json
+  busy : Bool := false
+  deriving ToJson, FromJson
+
+def progress (id : String) (identity : Identity) : Json :=
+  Json.mkObj [("progress",toJson id),("identity",toJson identity)]
+
+/-- Poll the native promise directly: no detached blocking task can retain a
+caller after its cutoff. Connect and request writes consume the same window. -/
+def waitNative (promise : IO.Promise (Except IO.Error α)) (window : Std.Mutex Nat)
+    (cancelled : IO.Ref Bool) : IO α := do
+  repeat
+    unless !(← cancelled.get) && !(← IO.checkCanceled) &&
+        (← IO.monoMsNow) < (← window.atomically get) do
+      throw (IO.userError "operation transport cancelled or expired")
+    if ← promise.isResolved then
+      let some result := promise.result?.get | throw (IO.userError "native operation lost its response")
+      return ← IO.ofExcept result
+    IO.sleep 5
+  throw (IO.userError "unreachable native operation wait")
+
+def connect (endpoint : Daemon.Endpoint) (window : Std.Mutex Nat) (cancelled : IO.Ref Bool) :
+    IO Std.Async.TCP.Socket.Client := do
+  unless endpoint.port ≤ 65535 do throw (IO.userError "invalid operation service port")
+  let client ← Std.Async.TCP.Socket.Client.mk
+  waitNative (← client.native.connect (Daemon.loopback endpoint.port.toUInt16)) window cancelled
+  return client
+
+def sendFrame (client : Std.Async.TCP.Socket.Client) (bytes : ByteArray) (window : Std.Mutex Nat)
+    (cancelled : IO.Ref Bool) : IO Unit := do
+  unless bytes.size ≤ Daemon.maxFrameBytes do throw (IO.userError "operation exceeds its frame bound")
+  waitNative (← client.native.send #[Daemon.frameLength bytes,bytes]) window cancelled
+
+/-- Poll cancellation with the original deadline. No detached socket reader
+survives a cancelled caller; dropping this connection cancels that one job. -/
+partial def receiveExactly (client : Std.Async.TCP.Socket.Client) (remaining : Nat)
+    (window : Std.Mutex Nat) (cancelled : IO.Ref Bool) (received : ByteArray := ByteArray.empty) : IO ByteArray := do
+  if remaining == 0 then return received
+  let pending ← client.native.recv? remaining.toUInt64
+  let chunk ← try waitNative pending window cancelled finally client.native.cancelRecv
+  match chunk with
+  | none => throw (IO.userError "operation service closed its response")
+  | some chunk =>
+    unless !chunk.isEmpty do throw (IO.userError "empty operation frame")
+    receiveExactly client (remaining-chunk.size) window cancelled (received++chunk)
+
+def receiveFrame (client : Std.Async.TCP.Socket.Client) (window : Std.Mutex Nat)
+    (cancelled : IO.Ref Bool) : IO ByteArray := do
+  let size := Daemon.decodeLength (← receiveExactly client 4 window cancelled)
+  unless size ≤ Daemon.maxFrameBytes do throw (IO.userError "operation frame exceeds its bound")
+  receiveExactly client size window cancelled
+
+end Eggshell.Plugin.OperationWire

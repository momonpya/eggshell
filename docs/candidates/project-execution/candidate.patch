+
+/-- Long-lived execution waits have a different listener from the source RPCs
+they depend on. Its private address must belong to this exact service owner. -/
+def operationEndpoint : IO Daemon.Endpoint := do
+  let expected ← match ← endpoint? with
+    | some endpoint => pure endpoint
+    | none => resolve
+  unless expected.session == "publisher" && expected.compatible (← generation) do
+    throw (IO.userError "shared data service uses another implementation; explicitly stop its owner before replacement")
+  let some endpoint ← (readJson? ((← directory)/"operations.json") [] : IO (Option Daemon.Endpoint)) |
+    throw (IO.userError "shared data service has no operation listener")
+  unless endpoint.session == "publisher-operations" && endpoint.pid == expected.pid &&
+      endpoint.secret == expected.secret && endpoint.generation == expected.generation do
+    throw (IO.userError "operation listener changed its service owner")
+  return endpoint
+
+/-- Private local execution only. Progress and final data retain the same
+request identity; the caller owns cancellation and its absolute deadline. -/
+partial def operationExchange (request : OperationWire.Request) (window : Std.Mutex Nat)
+    (cancelled : IO.Ref Bool) (onReady : OperationWire.Identity → Nat → IO Unit) : IO (Option Json) := do
+  unless (← IO.monoMsNow) < request.cutoff && !(← cancelled.get) do return none
+  -- The authenticated operation is itself the liveness check. A preflight ping
+  -- for every waiting caller competes with the source RPCs that active work
+  -- needs, and a busy server is not a crashed server. Recovery is permitted
+  -- only when connection establishment failed, before any request was sent.
+  let endpoint ← operationEndpoint
+  let bytes := (Daemon.request endpoint.secret "worker-exchange" (toJson request)).compress.toUTF8
+  unless bytes.size ≤ Daemon.maxFrameBytes do throw (IO.userError "operation request exceeds its frame bound")
+  let (endpoint,client) ← try
+      pure (endpoint,← OperationWire.connect endpoint window cancelled)
+    catch _ =>
+      unless !(← cancelled.get) && (← IO.monoMsNow) < request.cutoff do
+        throw (IO.userError "operation connection cancelled or expired")
+      let _ ← resolve
+      let endpoint ← operationEndpoint
+      pure (endpoint,← OperationWire.connect endpoint window cancelled)
+  -- A recovered service has a fresh secret; no uncertain send is retried.
+  let bytes := (Daemon.request endpoint.secret "worker-exchange" (toJson request)).compress.toUTF8
+  OperationWire.sendFrame client bytes window cancelled
+  let frame := OperationWire.receiveFrame client window cancelled
+  let first ← frame
+  let some text := String.fromUTF8? first | throw (IO.userError "invalid operation response")
+  let header ← IO.ofExcept (Json.parse text)
+  let first ← if (header.getObjVal? "progress").isOk then do
+      unless (header.getObjValAs? String "progress").toOption == some request.id do
+        throw (IO.userError "foreign operation progress")
+      let identity ← IO.ofExcept (header.getObjVal? "identity" >>= fromJson? (α := OperationWire.Identity))
+      onReady identity (← IO.monoMsNow)
+      frame
+    else pure first
+  let initial ← IO.mkRef (some first)
+  let receive := do
+    match ← initial.get with
+    | some first => initial.set none; pure first
+    | none => frame
+  let response ← Stream.receiveWith receive "worker-exchange"
+  let reply ← IO.ofExcept (Json.parse response >>= fromJson? (α := OperationWire.Reply))
+  unless reply.id == request.id && (← IO.monoMsNow) < (← window.atomically get) && !(← cancelled.get) do
+    throw (IO.userError "foreign, cancelled or expired operation reply")
+  if reply.busy then
+    unless !reply.completed && !(header.getObjVal? "progress").isOk do
+      throw (IO.userError "operation became busy after starting")
+    IO.sleep 100
+    return ← operationExchange request window cancelled onReady
+  return if reply.completed then some reply.payload else none

+module
+public import Eggshell.OperationWire
+public import Init.Data.Vector.Basic
+
+@[expose] public section
+namespace Eggshell.Plugin.OperationPlan
+open Lean OperationWire
+
+def searchWorkers : Nat := 3
+def saveWorkers : Nat := 2
+def workers : Nat := searchWorkers+saveWorkers
+def maxRequests : Nat := 160
+def maxBytes : Nat := 16*1024*1024
+abbrev Lane := Fin workers
+def Lane.role (lane : Lane) : Role := if lane.val < searchWorkers then .search else .save
+
+theorem Lane.search_bound (lane : Lane) (role : lane.role = .search) : lane.val < searchWorkers := by
+  by_cases bound : lane.val < searchWorkers
+  · exact bound
+  · simp [Lane.role,bound] at role
+
+structure Job where
+  id : String
+  role : Role
+  bytes : Nat
+  cutoff : Nat
+
+structure Active where
+  job : Job
+  token : Nat
+
+structure Contents where
+  pending : Array Job := #[]
+  running : Vector (Option Active) workers := Vector.replicate workers none
+  nextToken : Nat := 0
+  closed : Bool := false
+
+def Contents.active (contents : Contents) := contents.running.toArray.filterMap id
+def Contents.count (contents : Contents) := contents.pending.size+contents.active.size
+def Contents.charge (contents : Contents) :=
+  contents.pending.foldl (fun total job => total+job.bytes) 0+
+  contents.active.foldl (fun total active => total+active.job.bytes) 0
+
+structure State where
+  contents : Contents
+  countBound : contents.count ≤ maxRequests
+  byteBound : contents.charge ≤ maxBytes
+
+@[no_expose] def initial : State := ⟨{},by decide,by decide⟩
+private def checked (contents : Contents) : Option State :=
+  if countBound : contents.count ≤ maxRequests then
+    if byteBound : contents.charge ≤ maxBytes then some ⟨contents,countBound,byteBound⟩ else none
+  else none
+
+@[no_expose] def admit (state : State) (job : Job) : State × Bool :=
+  if state.contents.closed || state.contents.pending.any (·.id == job.id) ||
+      state.contents.active.any (·.job.id == job.id) then (state,false)
+  else match checked {state.contents with pending := state.contents.pending.push job} with
+    | some next => (next,true) | none => (state,false)
+
+@[no_expose] def take (state : State) (lane : Lane) (now : Nat) : State × Option Active := Id.run do
+  let before := state.contents
+  if before.closed || before.running[lane].isSome then return (state,none)
+  let some position := before.pending.findIdx? (fun job => job.role == lane.role && now < job.cutoff) |
+    return (state,none)
+  let some job := before.pending[position]? | return (state,none)
+  let active : Active := ⟨job,before.nextToken⟩
+  let next := {before with
+    pending := before.pending.extract 0 position ++ before.pending.extract (position+1) before.pending.size
+    running := before.running.set lane (some active),nextToken := before.nextToken+1}
+  let some next := checked next | return (state,none)
+  return (next,some active)
+
+@[no_expose] def finish (state : State) (lane : Lane) (token : Nat) : State := Id.run do
+  unless state.contents.running[lane].any (·.token == token) do return state
+  (checked {state.contents with running := state.contents.running.set lane none}).getD state
+
+@[no_expose] def discard (state : State) (ids : Array String) : State :=
+  (checked {state.contents with pending := state.contents.pending.filter (!ids.contains ·.id)}).getD state
+
+def close (state : State) : State := by
+  let next := {state.contents with closed := true,pending := #[]}
+  refine ⟨next,?_,?_⟩
+  · have small : state.contents.active.size ≤ maxRequests := by
+      have bound := state.countBound
+      change state.contents.pending.size+state.contents.active.size ≤ maxRequests at bound
+      omega
+    simpa [next,Contents.count,Contents.active] using small
+  · have small : state.contents.active.foldl (fun total active => total+active.job.bytes) 0 ≤ maxBytes := by
+      have bound := state.byteBound
+      unfold Contents.charge at bound
+      omega
+    simpa [next,Contents.charge,Contents.active] using small
+
+theorem requests_bounded (state : State) : state.contents.count ≤ maxRequests := state.countBound
+theorem bytes_bounded (state : State) : state.contents.charge ≤ maxBytes := state.byteBound
+theorem workers_bounded (state : State) : state.contents.active.size ≤ workers := by
+  simpa [Contents.active] using
+    (Array.size_filterMap_le (f := id) (xs := state.contents.running.toArray))
+
+theorem close_is_terminal (state : State) : (close state).contents.closed = true := rfl
+theorem closed_starts_no_job (state : State) (lane : Lane) (now : Nat) :
+    (take (close state) lane now).2 = none := by simp [take,close]
+
+end Eggshell.Plugin.OperationPlan

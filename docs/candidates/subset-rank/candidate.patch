diff --git a/Eggshell/SubsetLexical.lean b/Eggshell/SubsetLexical.lean
new file mode 100644
index 00000000..84667953
--- /dev/null
+++ b/Eggshell/SubsetLexical.lean
@@ -0,0 +1,77 @@
+module
+public import Eggshell.SourceOwners
+public import Eggshell.SearchRank
+
+@[expose] public section
+namespace Eggshell.SubsetLexical
+open Lean DB
+
+/-- Read only the path to a requested canonical owner. An out-of-domain id
+must be rejected before taking a radix digit, rather than wrapping to a leaf. -/
+def point (reader : SourceBitmap.Reader) (height : Nat) (root : SourceBitmap.Ref) (id : Nat) : IO Bool := do
+  unless root.height == height do throw (IO.userError "point bitmap height mismatch")
+  if id ≥ 256*16^height then return false
+  let node ← reader.read root
+  match height with
+  | 0 => return SourceBitmap.contains (BitVec.ofNat 256 node.bits) id
+  | depth+1 =>
+    let width := 256*16^depth
+    match node.children.find? (fun row => row.1 == id/width) with
+    | none => return false
+    | some (_,child) => point reader depth child (id%width)
+
+/-- Retain the original row sequence, local document frequency, query-term
+order and Float additions. Repeated ids count as repeated rows. -/
+def rank (query : String) (ids : List Nat) (contains : Nat → String → Bool) : List Nat :=
+  SearchRank.rankRows query ids contains (fun term => (ids.filter (fun id => contains id term)).length) false
+
+theorem rank_exact (query : String) (ids : List Nat) (text : Nat → String)
+    (contains : Nat → String → Bool)
+    (same : ∀ id term, contains id term = (SearchRank.terms (text id)).contains term) :
+    rank query ids contains = SearchRank.lexical query (ids.map text) := by
+  have functions : contains = fun id term => (SearchRank.terms (text id)).contains term := by
+    funext id term
+    exact same id term
+  subst contains
+  rw [SearchRank.lexical_exact]
+  unfold SearchRank.referenceLexical
+  have documents : (ids.map text).map SearchRank.terms = ids.map (fun id => SearchRank.terms (text id)) := by
+    simp only [List.map_map,Function.comp_def]
+  rw [documents]
+  unfold SearchRank.rankDocuments
+  rw [SearchRank.rankRows_map]
+  unfold rank
+  congr 1
+  funext term
+  simp only [List.filter_map,List.length_map,Function.comp_def]
+
+/-- Capture query-term membership from the prepared lexical contract.
+No full common-term posting is enumerated. -/
+def project (reader : SourceOwners.Reader) (query : String) (ids : List Nat) :
+    IO (Std.HashMap String (Std.HashSet Nat)) := do
+  let unique := hashDistinct ids
+  let mut terms := {}
+  for term in SearchRank.terms query do
+    let mut present : Std.HashSet Nat := {}
+    if let some termId ← Persistence.Store.findTerm? reader.dictionary reader.dictionary.get ("lexical/"++term) then
+      let mut roots := #[]
+      for input in reader.inputs do
+        if let some root ← SourceOwners.root input.index input.index.get (Persistence.Store.key "postingRoot" termId.id) then
+          roots := roots.push root
+      for id in unique do
+        for root in roots do
+          if ← point reader.bitmap root.height root id then
+            present := present.insert id
+            break
+    terms := terms.insert term present
+  return terms
+
+def read? (reader : SourceOwners.Reader) (query : String) (ids : List Nat) : IO (Option (List Nat)) := do
+  if !ids.isEmpty then
+    let some candidates := reader.candidates | return none
+    for id in hashDistinct ids do
+      unless ← point reader.bitmap candidates.height candidates id do return none
+  let terms ← project reader query ids
+  return some (rank query ids (fun id term => (terms.getD term {}).contains id))
+
+end Eggshell.SubsetLexical

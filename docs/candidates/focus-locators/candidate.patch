+/-- Carry explicit current-question locators through a later evidence focus.
+The existing compiled corpus is reused; neither rows nor numerical evidence
+positions are filtered. This supplies advisory order, never Work authority. -/
+def Corpus.orderLocators {candidates : List String} (corpus : Corpus candidates) (query : String)
+    (ordinal : α → Nat) (ranked : List α) : List α :=
+  let wanted := (terms query).filter literalTerm
+  let documents := corpus.documents.toArray
+  preferLiteralMatches ranked fun row =>
+    (documents[ordinal row]?).any fun document => wanted.any document.contains
+
+theorem Corpus.orderLocators_members {candidates : List String} (corpus : Corpus candidates)
+    (query : String) (ordinal : α → Nat) (ranked : List α) (row : α) :
+    row ∈ corpus.orderLocators query ordinal ranked ↔ row ∈ ranked := by
+  simp only [orderLocators,preferLiteralMatches_members]
+
+theorem Corpus.orderLocators_without_locators {candidates : List String} (corpus : Corpus candidates)
+    (query : String) (ordinal : α → Nat) (ranked : List α)
+    (absent : (terms query).filter literalTerm = []) :
+    corpus.orderLocators query ordinal ranked = ranked := by
+  simp [orderLocators,absent,preferLiteralMatches]
+  have empty : ranked.filter (fun _ => false) = [] := by induction ranked <;> simp_all
+  have keep : ranked.filter (fun _ => true) = ranked := by induction ranked <;> simp_all
+  rw [empty,keep]
+  rfl
+

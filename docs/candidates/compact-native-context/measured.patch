+
+/-- Advisory native excerpts refer to their stored input without repeating its
+entire command. The DB retains the input; original fragments and conditions
+keep their existing typed transport. Completed control keeps its full input. -/
+def contextualWorkDisplay (owner : OutcomeEdge) (members : List Selected)
+    (work : String) : String :=
+  if Matcher.nativeOutcome owner && members.all (·.applicability == .advisory) then
+    "[Saved native input " ++ relationKey owner.work ++ "; full input remains in memory.]"
+  else work
+
+theorem completed_work_display_preserved (owner : OutcomeEdge) (members : List Selected)
+    (member : Selected) (present : member ∈ members)
+    (completed : member.applicability = .completed) (work : String) :
+    contextualWorkDisplay owner members work = work := by
+  unfold contextualWorkDisplay
+  split
+  next advisory =>
+    have found := List.all_eq_true.mp (Bool.and_eq_true_iff.mp advisory).2 member present
+    rw [completed] at found
+    change false = true at found
+    cases found
+  next => rfl
 
+theorem non_native_work_display_preserved (owner : OutcomeEdge)
+    (notNative : Matcher.nativeOutcome owner = false) (members : List Selected)
+    (work : String) : contextualWorkDisplay owner members work = work := by
+  simp [contextualWorkDisplay,notNative]
+

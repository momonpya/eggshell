+
+abbrev Retirement := IO.Promise (Option DB.PageMap.LocalPages.State)
+
+/-- Completion is single-writer. Returning a front never waits for this owner.
+Only the owner consumes completed fronts and changes its pending cache. -/
+def collectRetired (pool : PreparedReaders.Pool) (leases : Array Retirement) : IO (Array Retirement) := do
+  let mut live := #[]
+  for lease in leases do
+    if ← lease.isResolved then
+      if let some (some pages) := lease.result?.get then pool.pages.mergeRetired pages
+    else live := live.push lease
+  return live
+
+def baseAtBoundary (current pending : DB.PageMap.SharedPageCache) (live : Nat) : DB.PageMap.SharedPageCache :=
+  if live = 0 then pending else current
+
+theorem baseAtBoundary_live (current pending : DB.PageMap.SharedPageCache) (live : Nat) (busy : live ≠ 0) :
+    baseAtBoundary current pending live = current := by simp [baseAtBoundary,busy]
+
+theorem baseAtBoundary_quiescent (current pending : DB.PageMap.SharedPageCache) :
+    baseAtBoundary current pending 0 = pending := rfl

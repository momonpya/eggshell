+namespace Locations
+
+structure Group where
+  subject : Subject
+  ranges : List (Nat × Nat)
+  deriving ToJson, FromJson
+
+def expand (groups : List Group) : List Range :=
+  groups.flatMap fun group => group.ranges.map fun (first,last) => ⟨group.subject,first,last⟩
+
+def prepend (range : Range) : List Group → List Group
+  | [] => [⟨range.subject,[(range.first,range.last)]⟩]
+  | group::rest =>
+    if range.subject = group.subject then {group with ranges := (range.first,range.last)::group.ranges}::rest
+    else ⟨range.subject,[(range.first,range.last)]⟩::group::rest
+
+theorem prepend_exact (range : Range) (groups : List Group) :
+    expand (prepend range groups) = range::expand groups := by
+  cases groups with
+  | nil => cases range; rfl
+  | cons group rest =>
+    simp only [prepend]
+    split
+    · cases range; cases group; simp_all [expand]
+    · cases range; rfl
+
+def pack (ranges : List Range) : List Group := ranges.foldr prepend []
+
+/-- File metadata is shared without omitting, widening, reordering or
+inventing a single locator interval. This is unrelated to evidence credit. -/
+theorem expand_pack (ranges : List Range) : expand (pack ranges) = ranges := by
+  induction ranges with
+  | nil => rfl
+  | cons first rest ih =>
+    change expand (prepend first (pack rest)) = first::rest
+    rw [prepend_exact,ih]
+
+end Locations
+

+/-- A logical projection uses the reserved reply budget. Each physical frame
+stays small and carries raw bytes without another JSON-string wrapping. -/
+def maxBytes : Nat := 16*1024*1024
+def chunkBytes : Nat := 1024*1024
+def next (bytes : ByteArray) (offset : Nat) := min bytes.size (offset+chunkBytes)
+def fragment (bytes : ByteArray) (offset : Nat) := bytes.extract offset (next bytes offset)
+
+theorem fragment_bounded (bytes : ByteArray) (offset : Nat) :
+    (fragment bytes offset).size ≤ chunkBytes := by
+  simp only [fragment,ByteArray.size_extract,next]
+  omega
+
+theorem fragment_advances (bytes : ByteArray) (offset : Nat) (more : offset < bytes.size) :
+    offset < next bytes offset := by
+  simp only [next,chunkBytes]
+  omega
+
+theorem fragment_preserves_prefix (bytes : ByteArray) (offset : Nat) (valid : offset ≤ bytes.size) :
+    bytes.extract 0 offset ++ fragment bytes offset = bytes.extract 0 (next bytes offset) := by
+  have grows : offset ≤ next bytes offset := by simp only [next]; omega
+  ext1
+  simp only [fragment,ByteArray.data_append,ByteArray.data_extract]
+  rw [Array.extract_append_extract]
+  simp [Nat.max_eq_right grows]
+
+/-- The service supplies its existing deadline, cancellation and reservation
+aware sender. It finishes each frame before admitting the next. -/
+def send (frame : ByteArray → IO Unit) (reply : Except String String) : IO Unit := do
+  match reply with
+  | .error message => frame (Daemon.response (.error message)).compress.toUTF8
+  | .ok text =>
+    let bytes := text.toUTF8
+    unless bytes.size ≤ maxBytes do
+      frame (Daemon.response (.error "source projection exceeds reserved reply budget")).compress.toUTF8
+      return
+    frame (Json.mkObj [("ok",toJson true),("bytes",toJson bytes.size),
+      ("digest",toJson (Blake3.hex (Blake3.hash bytes)))]).compress.toUTF8
+    let mut offset := 0
+    while offset < bytes.size do
+      frame (fragment bytes offset)
+      offset := next bytes offset
+
+def receiveWith (frame : IO ByteArray) : IO String := do
+  let header ← frame
+  let some text := String.fromUTF8? header | throw (IO.userError "invalid source stream header")
+  let value ← IO.ofExcept (Json.parse text)
+  unless value.getObjValD "ok" == toJson true do
+    throw (IO.userError ((value.getObjValAs? String "error").toOption.getD "source stream failed"))
+  let size ← IO.ofExcept (value.getObjValAs? Nat "bytes")
+  let digest ← IO.ofExcept (value.getObjValAs? String "digest")
+  unless size ≤ maxBytes do throw (IO.userError "source stream exceeds reserved reply budget")
+  let mut bytes := ByteArray.emptyWithCapacity size
+  while bytes.size < size do
+    let part ← frame
+    unless !part.isEmpty && part.size ≤ chunkBytes && part.size ≤ size-bytes.size do
+      throw (IO.userError "invalid source stream extent")
+    bytes := bytes ++ part
+  unless Blake3.hex (Blake3.hash bytes) == digest do throw (IO.userError "source stream digest mismatch")
+  let some result := String.fromUTF8? bytes | throw (IO.userError "source stream is not UTF-8")
+  return result
+
+def receive (client : Socket.Client) (deadline : Nat) : IO String :=
+  receiveWith (Daemon.receiveFrameBefore client deadline)
+
+def exchange (endpoint : Daemon.Endpoint) (kind : String) (payload : Json) (budget : Nat) : IO String := do
+  let deadline := (← IO.monoMsNow)+budget
+  let client ← Daemon.connect endpoint
+  Daemon.sendFrame client (Daemon.request endpoint.secret kind payload).compress.toUTF8
+  receive client deadline
+
+end Eggshell.Plugin.Publication.Stream

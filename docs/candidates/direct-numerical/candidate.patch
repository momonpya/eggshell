+/-- A provider owns one sequential numerical client. Its keeper outlives all
+requests and is released only after the optional local score process exits.
+No query, source corpus or current response is retained in this handle. -/
+structure Client where
+  keeper : Keeper
+  scores : IO.Ref (Option Kernel)
+  shared : IO.Ref (Option Endpoint)
+  closed : IO.Ref Bool
+
+def openClient (config : Config) : IO Client := do
+  return ⟨← keep config,← IO.mkRef none,← IO.mkRef none,← IO.mkRef false⟩
+
+def sharedKind (marker : UInt8) : Option String :=
+  if marker = 69 then some "encode" else if marker = 66 then some "blocks" else none
+
+theorem shared_kind_requires_encode_or_blocks (marker : UInt8) (kind : String)
+    (shared : sharedKind marker = some kind) : marker = 69 ∨ marker = 66 := by
+  by_cases encode : marker = 69
+  · exact Or.inl encode
+  · by_cases blocks : marker = 66
+    · exact Or.inr blocks
+    · simp [sharedKind,encode,blocks] at shared
+
+theorem cache_only_is_not_shared : sharedKind 83 = none := rfl
+theorem close_is_not_a_shared_request : sharedKind 67 = none := rfl
+
+/-- Pipe reads already include their final newline; direct callers do not.
+The numerical kernels consume the same single terminated JSON frame. -/
+def requestBody (body : String) : String :=
+  if body.endsWith "\n" then body else body++"\n"
+
+theorem terminated_request_unchanged (body : String) (terminated : body.endsWith "\n" = true) :
+    requestBody body = body := by simp [requestBody,terminated]
+
+/-- The same bounded shared service handles encode and projected-block work.
+Legacy large cache-only frames remain local and never become large RPCs. -/
+def Client.request (client : Client) (marker : UInt8) (body : String) : IO String := do
+  if ← client.closed.get then throw (IO.userError "numerical client is closed")
+  let body := requestBody body
+  if let some kind := sharedKind marker then
+    let endpoint ← match ← client.shared.get with
+      | some endpoint => pure endpoint
+      | none => do
+          let endpoint ← resolve client.keeper.config
+          client.shared.set (some endpoint)
+          pure endpoint
+    exchange endpoint kind (toJson body)
+  else if marker == 83 then
+    let child ← match ← client.scores.get with
+      | some child => pure child
+      | none => do
+          let child ← spawnKernel client.keeper.config ((← directory client.keeper.config) / "score-unused.guard")
+          client.scores.set (some child)
+          pure child
+    child.stdin.putStr body
+    child.stdin.flush
+    awaitLine child ((← IO.monoMsNow)+24000)
+  else throw (IO.userError "invalid numerical pipe operation")
+
+def Client.close (client : Client) : IO Unit := do
+  if ← client.closed.get then return
+  client.closed.set true
+  try
+    if let some child ← client.scores.get then stopKernel child
+  finally release client.keeper
+
+/-- The CLI is an adapter over the same client used directly by Lean providers.
+It adds no numerical implementation or second resource-ownership policy. -/
+def proxy (config : Config) : IO UInt32 := do
+  let client ← openClient config
   try
     let input ← IO.getStdin
     let output ← IO.getStdout
@@ -384,31 +449,11 @@ def proxy (config : Config) : IO UInt32 := withKeeper config do
       if marker.isEmpty then break
       let body ← input.getLine
       if marker[0]! == 67 then break
-      let reply ← try
-        if marker[0]! == 69 || marker[0]! == 66 then
-          let endpoint ← match ← shared.get with
-            | some endpoint => pure endpoint
-            | none => do
-                let endpoint ← resolve config
-                shared.set (some endpoint)
-                pure endpoint
-          exchange endpoint (if marker[0]! == 69 then "encode" else "blocks") (toJson body)
-        else if marker[0]! == 83 then
-          let child ← match ← scores.get with
-            | some child => pure child
-            | none => do
-                let child ← spawnKernel config ((← directory config) / "score-unused.guard")
-                scores.set (some child)
-                pure child
-          child.stdin.putStr body
-          child.stdin.flush
-          awaitLine child ((← IO.monoMsNow)+24000)
-        else throw (IO.userError "invalid numerical pipe operation")
+      let reply ← try client.request marker[0]! body
       catch error => pure ((Json.mkObj [("error",toJson error.toString)]).compress ++ "\n")
       output.putStr reply
       output.flush
     return 0
-  finally
-    if let some child ← scores.get then stopKernel child
+  finally client.close
 
 end Eggshell.Numerical

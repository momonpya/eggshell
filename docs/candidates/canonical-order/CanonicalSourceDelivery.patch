+/-- Compare the exact existing encodings, creating them once per origin in
+this bounded row. Singleton rows require no encoding at all. -/
+def orderOrigins (origins : Array Origin) : Array Origin :=
+  let encode := fun origin : Origin => (toJson origin).compress
+  let memo := if origins.size < 2 then ({} : ExactMemo.Table encode) else
+    origins.foldl (fun memo origin => (ExactMemo.read encode memo origin).2) {}
+  origins.qsort fun a b => (ExactMemo.read encode memo a).1 < (ExactMemo.read encode memo b).1
+
+theorem orderOrigins_exact (origins : Array Origin) : orderOrigins origins =
+    origins.qsort (fun a b => (toJson a).compress < (toJson b).compress) := by
+  unfold orderOrigins
+  simp only [ExactMemo.read_exact]
+

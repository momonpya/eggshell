+def ownerStatusRowCost (owner : String) : Nat × Nat :=
+  let yes := ownerStatusDescription owner true
+  let no := ownerStatusDescription owner false
+  let changed := ownerStatusDescription owner false true
+  (max yes.length (max no.length changed.length),
+    max yes.utf8ByteSize (max no.utf8ByteSize changed.utf8ByteSize))
+
+theorem owner_status_row_bounded (owner : String) (verified changed : Bool) :
+    (ownerStatusDescription owner verified changed).length ≤ (ownerStatusRowCost owner).1 ∧
+      (ownerStatusDescription owner verified changed).utf8ByteSize ≤ (ownerStatusRowCost owner).2 := by
+  cases verified <;> cases changed <;> simp [ownerStatusRowCost,ownerStatusDescription] <;> omega
+

+import Eggshell.Handoff
+open Lean Eggshell Eggshell.Plugin
+private def check (value : Bool) (message : String) : IO Unit :=
+  unless value do throw (IO.userError message)
+private def native (source : String) : OutcomeEdge :=
+  let work := Value.text "w"
+  let outcome := Value.text source
+  let occurrence := Value.applyList .occurrence [.semantic outcome,.semantic work,.exact (.text "receipt")]
+  OutcomeEdge.make work outcome [occurrence] (by simp) (by simp [maxOutcomeObservations])
+private def costBasis : SharedCoverage.Problem := {
+  costs := #[(4,4),(4,4),(4,4)],weights := #[100,99,1]
+  offers := #[{closure := [⟨0,by decide⟩],covers := [⟨0,by decide⟩]},
+    {closure := [⟨1,by decide⟩],covers := [⟨1,by decide⟩]},
+    {closure := [⟨2,by decide⟩],covers := [⟨2,by decide⟩]}]
+  limit := (8,8)}
+def main : IO Unit := do
+  let words := SharedRangeAdapter.observedConceptTerms "123\tOPT_Name(42)\n999\tlast_arg"
+  check (!words.contains "P123" && !words.contains "P999" && words.contains "P42")
+    "numbered locators became value, or a source constant disappeared"
+  let source := String.join (List.replicate 165 "alpha ") ++ "rare_exception " ++ String.join (List.replicate 80 "alpha ")
+  let owner := native source
+  check (Matcher.nativeOutcome owner) "test lost original native occurrence orientation"
+  let context : ContextDelivery := {
+    owner := "original",outcome := "data",sourceChars := source.length,cues := []
+    leading := "",trailing := "",fragments := []}
+  let slice : TransportSlice := {
+    owner := some owner.relation,keys := [],text := source,members := [],visibleKeys := [],context := some context}
+  let family : SharedRangeAdapter.Family := {owner,template := slice,windows := [0,1,2]}
+  let cues := SharedRangeAdapter.rankedCues family
+  check (cues.length == 3) "test lost its original source coordinates"
+  let units := cues.map fun cue => ({family := 0,slice,ranges := [(cue.first,cue.last)]} : SharedRangeAdapter.UnitPlan)
+  let some problem := SharedRangeAdapter.conceptProblem costBasis [family] units (61*62*63) |
+    throw (IO.userError "source concepts failed")
+  check (problem.costs == costBasis.costs && problem.fixed == costBasis.fixed && problem.limit == costBasis.limit)
+    "value policy changed shared source costs or wire bounds"
+  let some first := problem.offers[0]? | throw (IO.userError "missing first offer")
+  let some second := problem.offers[1]? | throw (IO.userError "missing second offer")
+  check (first.covers == second.covers)
+    "duplicate lexical content acquired distinct concepts"
+  let some selected := SharedCoverage.choose? problem | throw (IO.userError "concept selection failed")
+  check ((selected.selected.map (·.val)).contains 2 && selected.selected.length == 1)
+    "new source condition lost to another occurrence of the same words"
+  let some old := SharedCoverage.choose? costBasis | throw (IO.userError "old selection failed")
+  check (!(old.selected.map (·.val)).contains 2) "test does not distinguish the value policies"
+  let partialUnits := units.map fun unit => {unit with ranges := [(0,1)]}
+  let some incompleteProblem := SharedRangeAdapter.conceptProblem costBasis [family] partialUnits (61*62*63) |
+    throw (IO.userError "partial context failed")
+  check (incompleteProblem.offers.toList.all (·.covers.isEmpty)) "partial context acquired an undispatched cue's concepts"
+  IO.println "source concept saturation, original cue, numerical constant and immutable cost checks passed"

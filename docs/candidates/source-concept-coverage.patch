+/-- Saved numbered-read prefixes are locators, not independent concepts.
+All normalization is retrieval advice; the original fragments remain intact. -/
+def observedConceptTerms (text : String) : List String :=
+  let content := "\n".intercalate ((text.splitOn "\n").map fun line =>
+    if (observedLineNumber? line).isSome then
+      String.ofList (((line.toList.dropWhile (· == ' ')).dropWhile Char.isDigit).drop 1)
+    else line)
+  SearchRank.terms content
+
+/-- Drop a clipped word/path edge from the feature view only. Complete
+source ranges and evidence rendering keep their original coordinates. CJK
+pair runs use their existing local pair semantics instead of word clipping. -/
+def conceptWord (c : Char) : Bool :=
+  !RetrievalResearch.script c &&
+    (RetrievalResearch.Unicode.letterNumber c || RetrievalResearch.Unicode.mark c ||
+      SearchRank.asciiTerm c.toLower)
+
+def conceptView (chars : Array Char) (first last : Nat) : String :=
+  let span := (chars.extract first last).toList
+  let left := first > 0 && ((chars[first-1]?).any conceptWord) &&
+    ((chars[first]?).any conceptWord)
+  let right := last > first && ((chars[last-1]?).any conceptWord) &&
+    ((chars[last]?).any conceptWord)
+  let span := if left then span.dropWhile conceptWord else span
+  let span := if right then (span.reverse.dropWhile conceptWord).reverse else span
+  String.ofList span
+
+structure ConceptSignal where
+  first : Nat
+  last : Nat
+  concepts : List Nat
+
+/-- Source words/identifier parts share one saturating concept across all
+original occurrences. A concept gets its best actual cue rank, never a byte
+multiplier. Historical interpretations have their own bounded cue labels and
+cannot stand in for an original tool-data concept. Costs and closures are
+copied from the original checked problem without modification. -/
+def conceptProblem (p : SharedCoverage.Problem) (families : List Family)
+    (units : List UnitPlan) (scale : Nat) : Option SharedCoverage.Problem := do
+  if units.length != p.offers.size then none else do
+    let mut keys : Std.HashMap (Bool × String) Nat := {}
+    let mut weights : Array Nat := #[]
+    let mut signals : Array (List ConceptSignal) := Array.replicate families.length []
+    for (family,index) in families.zipIdx do
+      let some source := Matcher.atomText? family.owner.outcome | continue
+      let native := Matcher.nativeOutcome family.owner
+      let decoded := (decodedToolText? source).map DecodedLayout.make
+      let plainChars := if native && decoded.isNone then source.toList.toArray else #[]
+      let cues := if family.template.context.isNone then
+          if source.isEmpty then [] else [{priority := 0,first := 0,last := source.length}]
+        else rankedCues family
+      for cue in cues do
+        let atomic := family.template.context.isNone
+        let weight := if atomic then scale/(61+index) else scale/(61+index)+scale/(61+cue.priority)
+        let original ← if bounds : cue.first < cue.last ∧ cue.last ≤ source.length ∧ cue.last-cue.first ≤ 2048 then
+            let range : EvidenceRange source := ⟨cue.first,cue.last,bounds.1,bounds.2.1,bounds.2.2⟩
+            if atomic || !native then pure (cue.first,cue.last,"") else
+              match decoded with
+              | none => pure (cue.first,cue.last,conceptView plainChars cue.first cue.last)
+              | some layout => match decodedEvidenceUsing? layout range with
+                  | none => pure (cue.first,cue.last,"")
+                  | some projected =>
+                    pure (projected.original.start,projected.original.stop,
+                      conceptView layout.content.chars projected.content.start projected.content.stop)
+          else if atomic then pure (cue.first,cue.last,"") else none
+        let concepts := if atomic || !native then
+            [(false,toString index ++ ":" ++ toString cue.first ++ ":" ++ toString cue.last)]
+          else (observedConceptTerms original.2.2).map (true,·)
+        let mut ids := []
+        for key in concepts do
+          let id := keys[key]?.getD weights.size
+          if id == weights.size then
+            weights := weights.push weight
+            keys := keys.insert key id
+          else
+            weights := weights.modify id (max weight)
+          ids := id :: ids
+        signals := signals.modify index (fun previous =>
+          {first := original.1,last := original.2.1,concepts := ids} :: previous)
+    let offers ← units.zipIdx.mapM fun (unit,index) => do
+      let prior ← p.offers[index]?
+      let source ← signals[unit.family]?
+      let ids := Eggshell.hashDistinct (source.flatMap fun cue =>
+        if covers unit.ranges cue.first cue.last then cue.concepts else [])
+      let covered ← ids.mapM fun id =>
+        if valid : id < weights.size then some (⟨id,valid⟩ : Fin weights.size) else none
+      pure ({closure := prior.closure,covers := covered} : SharedCoverage.Offer p.costs.size weights.size)
+    pure {costs := p.costs,weights,offers := offers.toArray,fixed := p.fixed,limit := p.limit}

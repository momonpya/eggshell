diff --git a/Eggshell/TaskDeadline.lean b/Eggshell/TaskDeadline.lean
new file mode 100644
index 0000000..5ee05af
--- /dev/null
+++ b/Eggshell/TaskDeadline.lean
@@ -0,0 +1,66 @@
+module
+public import Std.Async.Select
+public import Std.Async.Timer
+
+@[expose] public section
+namespace Eggshell.TaskDeadline
+open Std Async
+
+def live (cancelled : Bool) (now deadline : Nat) : Bool :=
+  !cancelled && decide (now < deadline)
+
+theorem expired_refused (cancelled : Bool) (now deadline : Nat) (expired : deadline ≤ now) :
+    live cancelled now deadline = false := by simp [live,Nat.not_lt_of_ge expired]
+
+theorem cancelled_refused (now deadline : Nat) : live true now deadline = false := by simp [live]
+
+def ensureLive (deadline : Nat) : IO Unit := do
+  let cancelled ← IO.checkCanceled
+  unless live cancelled (← IO.monoMsNow) deadline do
+    throw (IO.userError (if cancelled then "owned task cancelled" else "owned task deadline expired"))
+
+/-- One completion observer per task. Re-registering a waiter after a timer
+wake replaces its destination; it does not attach another task continuation. -/
+def event (task : AsyncTask α) : IO (Selector α) := do
+  let waiting ← IO.mkRef (none : Option (Waiter α))
+  let completed ← IO.mkRef (none : Option (Except IO.Error α))
+  let deliver (waiter : Waiter α) (reply : Except IO.Error α) : BaseIO Unit :=
+    waiter.race (pure ()) (fun promise => promise.resolve reply)
+  discard <| IO.mapTask (t := task) (sync := true) fun reply => do
+    completed.set (some reply)
+    if let some waiter ← waiting.get then deliver waiter reply
+  return {
+    tryFn := do
+      match ← completed.get with
+      | none => return none
+      | some (.ok value) => return some value
+      | some (.error error) => throw error
+    registerFn := fun waiter => do
+      waiting.set (some waiter)
+      -- Completion before registration must not lose its wakeup.
+      if let some reply ← completed.get then deliver waiter reply
+    unregisterFn := waiting.set none }
+
+/-- Completion and the absolute deadline are event driven. Cooperative task
+cancellation has a bounded 25ms observation interval, using a native timer and
+no sleeping dedicated thread. The owner must cancel/join the actual IO. -/
+def wait (task : AsyncTask α) (deadline : Nat) : IO α := do
+  let ready ← event task
+  repeat
+    ensureLive deadline
+    let now ← IO.monoMsNow
+    if now ≥ deadline then throw (IO.userError "owned task deadline expired")
+    let result ← (do
+      let timer ← Selector.sleep (.ofNat (min 25 (deadline-now)))
+      Selectable.one #[.case ready (fun value => pure (some value)),
+        .case timer (fun _ => pure none)]).block
+    if let some value := result then
+      ensureLive deadline
+      return value
+  throw (IO.userError "unreachable task wait")
+
+def run (action : Async α) (deadline : Nat) : IO α := do
+  ensureLive deadline
+  wait (← action.toIO) deadline
+
+end Eggshell.TaskDeadline

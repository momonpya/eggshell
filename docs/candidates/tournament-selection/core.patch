+module
+public import tools.DeferredCoverage
+public import tools.SelectionRating
+@[expose] public section
+namespace SharedCoverage.Deferred.Tournament
+open StableTournament
+variable {p : Problem} {prior : Selection p}
+
+def key (score : Score prior (evaluation prior)) : Rating.Key p.offers.size :=
+  ⟨score.index,score.gain,score.charge⟩
+
+def scorePreference (prior : Selection p) : Preference (Score prior (evaluation prior)) where
+  better := betterScore
+  trans a b c ab bc := by
+    exact Rating.better_trans (key a) (key b) (key c) ab bc
+  negTrans a b c ab bc := by
+    exact Rating.better_neg_trans (key a) (key b) (key c) ab bc
+
+theorem merge_key (left right : Option (Score prior (evaluation prior))) :
+    merge (Rating.preference p.offers.size) (left.map key) (right.map key) =
+      (merge (scorePreference prior) left right).map key := by
+  cases left <;> cases right <;> simp only [Option.map_none,Option.map_some,merge]
+  change (if betterScore _ _ then _ else _) = _
+  split <;> simp_all [scorePreference]
+
+theorem winner_key (values : List (Option (Score prior (evaluation prior)))) :
+    winner (Rating.preference p.offers.size) (values.map (Option.map key)) =
+      (winner (scorePreference prior) values).map key := by
+  have general : ∀ (initial : Option (Score prior (evaluation prior))),
+      (values.map (Option.map key)).foldl (merge (Rating.preference p.offers.size)) (initial.map key) =
+        (values.foldl (merge (scorePreference prior)) initial).map key := by
+    induction values with
+    | nil => intro _; rfl
+    | cons head tail ih =>
+      intro initial
+      simp only [List.map_cons,List.foldl_cons,merge_key]
+      exact ih _
+  exact general none
+
+def scores (prior : Selection p) (stored : Sparse.Values prior) : List (Option (Score prior (evaluation prior))) :=
+  (List.finRange p.offers.size).map (Sparse.score? prior stored (known prior))
+
+theorem scores_winner (stored : Sparse.Values prior) :
+    winner (scorePreference prior) (scores prior stored) = Sparse.best prior stored := by
+  have step : ∀ found index,
+      merge (scorePreference prior) found (Sparse.score? prior stored (known prior) index) =
+        Sparse.step prior stored (known prior) found index := by
+    intro found index
+    cases value : Sparse.score? prior stored (known prior) index <;> cases found <;>
+      simp [merge,Sparse.step,value,scorePreference]
+    split <;> simp_all
+  simp only [winner,scores,List.foldl_map,Sparse.best]
+  exact congrArg (fun f => (List.finRange p.offers.size).foldl f none) (funext fun found => funext fun index => step found index)
+
+theorem best_retract (stored : Sparse.Values prior) (score : Score prior (evaluation prior))
+    (found : Sparse.best prior stored = some score) :
+    Sparse.score? prior stored (known prior) score.index = some score := by
+  rw [← scores_winner stored] at found
+  have member := winner_mem (scorePreference prior) (scores prior stored) score found
+  obtain ⟨index,_,produced⟩ := List.mem_map.mp member
+  have identity : score.index = index := by
+    unfold Sparse.score? at produced
+    split at produced
+    · dsimp only at produced
+      split at produced
+      · split at produced
+        · exact (congrArg (fun s : Score prior (evaluation prior) => s.index) (Option.some.inj produced)).symm
+        · contradiction
+      · contradiction
+    · contradiction
+  simpa only [identity] using produced
+
+def ratingAt (prior : Selection p) (stored : Sparse.Values prior) (seen : Known prior)
+    (index : Nat) : Option (Rating.Key p.offers.size) :=
+  if bound : index < p.offers.size then
+    (Sparse.score? prior stored seen ⟨index,bound⟩).map key
+  else none
+
+theorem rating_prefix (stored : Sparse.Values prior) :
+    (List.range p.offers.size).map (ratingAt prior stored (known prior)) =
+      (scores prior stored).map (Option.map key) := by
+  apply List.ext_getElem
+  · simp [scores]
+  · intro index hleft hright
+    have bound : index < p.offers.size := by simpa using hleft
+    simp [scores,ratingAt,bound]
+
+theorem rating_winner (stored : Sparse.Values prior) (capacity : Nat) (bounded : p.offers.size ≤ capacity) :
+    winner (Rating.preference p.offers.size)
+      ((List.range capacity).map (ratingAt prior stored (known prior))) =
+        (Sparse.best prior stored).map key := by
+  have split : capacity = p.offers.size+(capacity-p.offers.size) := by omega
+  rw [split,List.range_add,List.map_append,winner_append,rating_prefix,winner_key,scores_winner]
+  have empty : winner (Rating.preference p.offers.size)
+      ((List.range (capacity-p.offers.size)).map
+        (fun index => ratingAt prior stored (known prior) (p.offers.size+index))) = none := by
+    have same : ∀ index, ratingAt prior stored (known prior) (p.offers.size+index) = none := by
+      intro index
+      simp only [ratingAt]
+      rw [dif_neg (by omega)]
+    simp only [same]
+    induction capacity-p.offers.size with
+    | zero => rfl
+    | succ n ih => simpa [List.range_succ,winner_append,winner] using ih
+  simp only [List.map_map,Function.comp_def,empty,merge_none_right]
+
+def depth (p : Problem) : Nat := p.offers.size.log2+1
+
+def refreshed (prior : Selection p) (stored : Sparse.Values prior)
+    (cached : Cache (Rating.preference p.offers.size) (depth p)) :=
+  cached.tree.refreshed cached.best rfl (ratingAt prior stored (known prior)) 0
+
+theorem refreshed_best (stored : Sparse.Values prior)
+    (cached : Cache (Rating.preference p.offers.size) (depth p)) :
+    (refreshed prior stored cached).best = (Sparse.best prior stored).map key := by
+  rw [← (refreshed prior stored cached).tree.best_exact]
+  simp only [refreshed,Tree.refreshed_values,Nat.zero_add]
+  exact rating_winner stored _ (Nat.le_of_lt (Nat.lt_log2_self))
+
+def recovered (prior : Selection p) (stored : Sparse.Values prior)
+    (cached : Cache (Rating.preference p.offers.size) (depth p)) :
+    Option (Score prior (evaluation prior)) :=
+  cached.best.bind fun selected => Sparse.score? prior stored (known prior) selected.index
+
+theorem recovered_exact (stored : Sparse.Values prior)
+    (cached : Cache (Rating.preference p.offers.size) (depth p)) :
+    recovered prior stored (refreshed prior stored cached) = Sparse.best prior stored := by
+  simp only [recovered,refreshed_best]
+  cases found : Sparse.best prior stored with
+  | none => rfl
+  | some score => exact best_retract stored score found
+
+def fill (layout : Sparse.Layout p) (fuel : Nat) (prior : Selection p) (stored : Sparse.Values prior)
+    (cached : Cache (Rating.preference p.offers.size) (depth p)) : Selection p :=
+  match fuel with
+  | 0 => prior
+  | fuel+1 =>
+    let nextCache := refreshed prior stored cached
+    match recovered prior stored nextCache with
+    | none => prior
+    | some score =>
+      let next := score.proposal.result
+      fill layout fuel next (stored.advance layout next score.index rfl) nextCache
+
+theorem fill_exact (layout : Sparse.Layout p) (fuel : Nat) (prior : Selection p)
+    (stored : Sparse.Values prior) (cached : Cache (Rating.preference p.offers.size) (depth p)) :
+    fill layout fuel prior stored cached = Sparse.fill layout fuel prior stored := by
+  induction fuel generalizing prior cached with
+  | zero => rfl
+  | succ fuel ih =>
+    simp only [fill,recovered_exact,Sparse.fill]
+    cases found : Sparse.best prior stored with
+    | none => rfl
+    | some score => exact ih _ _ _
+
+def choose? (p : Problem) : Option (Selection p) := do
+  let initial ← empty? p
+  let cached := build (Rating.preference p.offers.size) (depth p) #[]
+  pure (prefer (fill (Sparse.layout p) p.offers.size initial (Sparse.values initial) cached) (bestSingleton initial))
+
+@[csimp] theorem choose_exact : @SharedCoverage.choose? = @choose? := by
+  rw [Sparse.choose_exact]
+  funext p
+  simp only [Sparse.choose?,choose?,fill_exact]
+
+end SharedCoverage.Deferred.Tournament

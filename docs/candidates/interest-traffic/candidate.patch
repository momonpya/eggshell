+module
+
+@[expose] public section
+namespace Eggshell.PreparationCompletion
+
+def requestsReplay (sourceCut : Option α) : Bool := sourceCut.isNone
+
+theorem explicit_cut_excludes_private_replay (source : α) :
+    requestsReplay (some source) = false := rfl
+
+theorem current_maintenance_requests_private_replay :
+    requestsReplay (none : Option α) = true := rfl
+
+/-- A completed source frame is mandatory. Private replay is required only
+when that work was requested; absence is not a fabricated successful replay. -/
+def completed (prepared : Option α) (replay : Option Bool) : Bool :=
+  prepared.isSome && replay.all id
+
+theorem missing_source_never_completes (replay : Option Bool) :
+    completed (none : Option α) replay = false := rfl
+
+theorem source_only_completes (prepared : α) :
+    completed (some prepared) none = true := rfl
+
+theorem pending_requested_replay_never_completes (prepared : Option α) :
+    completed prepared (some false) = false := by simp [completed]
+
+theorem completed_has_source (prepared : Option α) (replay : Option Bool)
+    (accepted : completed prepared replay = true) : prepared.isSome = true := by
+  cases prepared <;> simp_all [completed]
+
+end Eggshell.PreparationCompletion

+/-- Immutable ownership values, updated only by the frontend loop. IO tasks
+receive their own inputs, never the mutable registry that tracks them. -/
+structure OwnedTasks where
+  readers : Array Reading := #[]
+  clients : Array Client := #[]
+  maintenance : Array Maintenance := #[]
+
+def OwnedTasks.addReader (owned : OwnedTasks) (reader : Reading) : OwnedTasks :=
+  {owned with readers := owned.readers.push reader}
+def OwnedTasks.addClient (owned : OwnedTasks) (client : Client) : OwnedTasks :=
+  {owned with clients := owned.clients.push client}
+def OwnedTasks.addMaintenance (owned : OwnedTasks) (work : Maintenance) : OwnedTasks :=
+  {owned with maintenance := owned.maintenance.push work}
+
+theorem OwnedTasks.reader_registered (owned : OwnedTasks) (reader : Reading) :
+    reader ∈ (owned.addReader reader).readers := by simp [addReader]
+theorem OwnedTasks.client_registered (owned : OwnedTasks) (client : Client) :
+    client ∈ (owned.addClient client).clients := by simp [addClient]
+theorem OwnedTasks.maintenance_registered (owned : OwnedTasks) (work : Maintenance) :
+    work ∈ (owned.addMaintenance work).maintenance := by simp [addMaintenance]
+theorem OwnedTasks.reader_preserves_others (owned : OwnedTasks) (reader : Reading) :
+    (owned.addReader reader).clients = owned.clients ∧
+      (owned.addReader reader).maintenance = owned.maintenance := ⟨rfl,rfl⟩
+theorem OwnedTasks.client_preserves_others (owned : OwnedTasks) (client : Client) :
+    (owned.addClient client).readers = owned.readers ∧
+      (owned.addClient client).maintenance = owned.maintenance := ⟨rfl,rfl⟩
+theorem OwnedTasks.maintenance_preserves_others (owned : OwnedTasks) (work : Maintenance) :
+    (owned.addMaintenance work).readers = owned.readers ∧
+      (owned.addMaintenance work).clients = owned.clients := ⟨rfl,rfl⟩
+
+/-- Finalization receives the last live ownership value, after the sole loop
+has stopped. It never captures the loop's initial mutable-local arrays. -/
+def OwnedTasks.finish (owned : OwnedTasks) (stopReaders : Std.CancellationToken) : IO Unit := do
+  stopReaders.cancel
+  for reader in owned.readers do discard <| IO.wait reader.task
+  for client in owned.clients do IO.cancel client.task
+  for work in owned.maintenance do IO.cancel work.task
+  Worker.shutdown
+  for client in owned.clients do discard <| IO.wait client.task
+  for work in owned.maintenance do discard <| IO.wait work.task
+

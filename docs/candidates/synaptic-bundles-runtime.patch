+structure BundlePlan (keys : Array String) (units : Array UnitPlan) where
+  projected : Synapses.Bundles.Projected
+  indices : List (Fin units.size)
+  complete : projected.members.all (memberCovered keys units indices) = true
+
+theorem BundlePlan.members_kept (plan : BundlePlan keys units)
+    (member : Synapses.Bundles.Member) (present : member ∈ plan.projected.members) :
+    memberCovered keys units plan.indices member = true := by
+  exact (Array.all_eq_true'.mp plan.complete) member present
+
+def unitCharge (p : SharedCoverage.Problem) (known : Std.HashSet (Fin p.costs.size))
+    (index : Nat) : Nat :=
+  let atoms := (p.offers[index]?).map (·.closure) |>.getD []
+  let fresh := atoms.eraseDups.filter (!known.contains ·)
+  let cost := fresh.foldl (fun total atom =>
+    (total.1+p.costs[atom].1,total.2+p.costs[atom].2)) (0,0)
+  max (cost.1*p.limit.2) (cost.2*p.limit.1)
+
+/-- Every member has a complete original binding. Choose among its original
+unit alternatives using the actual shared marginal wire cost, never gold. -/
+def bundlePlan? (keys : Array String) (units : Array UnitPlan) (p : SharedCoverage.Problem)
+    (candidates : Std.HashMap Synapses.Range (List (Fin units.size)))
+    (projected : Synapses.Bundles.Projected) : Option (BundlePlan keys units) := do
+  let mut indices := []
+  let mut known : Std.HashSet (Fin p.costs.size) := {}
+  for member in projected.members do
+    let choices := candidates[member.source]?.getD []
+    let chosen ← choices.foldl (fun found index => match found with
+      | none => some index
+      | some previous => if unitCharge p known index.val < unitCharge p known previous.val then some index else found) none
+    indices := indices ++ [chosen]
+    for atom in (p.offers[chosen.val]?).map (·.closure) |>.getD [] do known := known.insert atom
+  let selected := indices.eraseDups
+  if complete : projected.members.all (memberCovered keys units selected) = true then
+    some ⟨projected,selected,complete⟩ else none
+
+def bundleRecipe? (keys : Array String) (units : Array UnitPlan) (pieces : List CuePiece)
+    (p : SharedCoverage.Problem) (plan : BundlePlan keys units) : Option (ClosedCoverage.Recipe p) := do
+  let parts ← plan.indices.mapM fun index =>
+    if h : index.val < p.offers.size then some (⟨index.val,h⟩ : Fin p.offers.size) else none
+  let bonus ← (pieces.zipIdx.filter fun (piece,_) => piece.baseWeight < piece.weight &&
+    plan.indices.any fun index =>
+      let unit := units[index]
+      unit.family == piece.family && covers unit.ranges piece.first piece.last &&
+        plan.projected.members.any fun member => member.choices.any fun bound =>
+          keys[unit.family]? == some bound.owner && covers bound.spans piece.first piece.last).mapM fun (_,id) =>
+    if h : id*2+1 < p.weights.size then some (⟨id*2+1,h⟩ : Fin p.weights.size) else none
+  pure {parts,bonus}

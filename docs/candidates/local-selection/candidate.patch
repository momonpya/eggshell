@@ -6602,0 +6614,44 @@ def selectView (query : ServiceQuery) (units : Array ServiceUnit)
+/-- A generic-only query needs no service-owned original row. Its choice can
+select local units but carries a proof that no remote payload can be fetched. -/
+structure LocalChoice (query : ServiceQuery) where
+  choice : ServiceChoice
+  valid : query.valid = true
+  noFiles : query.files.isEmpty = true
+  noOriginals : choice.sourceKeys.isEmpty = true
+
+def genericDomain (query : ServiceQuery) : Array ServiceUnit × List CuePiece := Id.run do
+  let index := KeyPostings.prepare (fun entry : GenericUnit × Nat => entry.1.family) query.generic.zipIdx
+  let cueIndex := KeyPostings.prepare (fun piece : CuePiece => piece.family) query.pieces.toArray
+  let mut units := #[]
+  let mut pieces := []
+  for family in [:query.owners.size] do
+    pieces := pieces ++ (cueIndex.lookup family).toList
+    for (unit,ordinal) in index.lookup family do
+      units := units.push {
+        shape := {family,ranges := unit.ranges},generic := some ordinal,contextual := unit.contextual}
+  return (units,pieces)
+
+def selectLocal? (query : ServiceQuery) : Option (LocalChoice query) := do
+  if valid : query.valid = true then
+    if noFiles : query.files.isEmpty = true then do
+      let (units,pieces) := genericDomain query
+      let source ← (Synapses.PreparedSourceView.domain #[] {} query.frameCosts).toOption
+      let choice ← selectView query units pieces source
+      if empty : choice.sourceKeys.isEmpty = true then some ⟨choice,valid,noFiles,empty⟩ else none
+    else none
+  else none
+
+theorem local_choice_has_no_originals (selected : LocalChoice query) :
+    selected.choice.sourceKeys.isEmpty = true := selected.noOriginals
+
+theorem local_choice_validates_query (selected : LocalChoice query) :
+    query.valid = true := selected.valid
+
+theorem invalid_query_cannot_select_locally (query : ServiceQuery)
+    (invalid : query.valid = false) : selectLocal? query = none := by
+  simp [selectLocal?,invalid]
+
+theorem original_query_cannot_select_locally (query : ServiceQuery)
+    (hasFiles : query.files.isEmpty = false) : selectLocal? query = none := by
+  simp [selectLocal?,hasFiles]
+

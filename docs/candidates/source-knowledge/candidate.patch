+module
+public import Eggshell.SynapseIndex
+@[expose] public section
+
+namespace Eggshell.Synapses.StoredReadLookup
+open DB
+
+structure Entry where
+  head : PageMap.Head
+  subject : Subject
+  rows : Array Read
+
+structure State where
+  entries : Std.HashMap String Entry := {}
+  bytes : Nat := 0
+  rows : Nat := 0
+  hits : Nat := 0
+  misses : Nat := 0
+
+/-- Per-replay, bounded locator cache. These rows still require validation
+against each operation's pre-read source publication; they grant no authority. -/
+structure Cache where
+  state : IO.Ref State
+  maxBytes : Nat := 16777216
+  maxRows : Nat := 16384
+
+def create : IO Cache := do return ⟨← IO.mkRef {},16777216,16384⟩
+
+def Cache.lookup (cache : Cache) (index : Index.Reader) (subject : Subject)
+    (deadline : Nat) : IO (Array Read) := do
+  if (← IO.monoMsNow) ≥ deadline then throw (IO.userError "historical stored-read lookup deadline")
+  let key := Index.contentKey (index.index.head,subject)
+  if let some entry := (← cache.state.get).entries[key]? then
+    unless entry.head == index.index.head && entry.subject == subject do
+      throw (IO.userError "ambiguous stored-read locator cache key")
+    cache.state.modify fun state => {state with hits := state.hits+1}
+    return entry.rows
+  let found ← index.lookup (.subject subject) 100000 deadline
+  unless found.complete do throw (IO.userError "incomplete historical stored-read evidence")
+  let rows := found.facts.filterMap fun fact => match fact with
+    | .read row => some row
+    | _ => none
+  cache.state.modify fun state =>
+    let next := {state with misses := state.misses+1}
+    if state.bytes+found.payloadBytes ≤ cache.maxBytes && state.rows+rows.size ≤ cache.maxRows &&
+        state.entries.size < 128 then
+      {next with
+        entries := state.entries.insert key ⟨index.index.head,subject,rows⟩,
+        bytes := state.bytes+found.payloadBytes,rows := state.rows+rows.size}
+    else next
+  return rows
+
+end Eggshell.Synapses.StoredReadLookup

+module
+public import Eggshell.HashDistinct
+@[expose] public section
+
+namespace Eggshell.DistinctPostings
+
+variable [BEq α] [LawfulBEq α] [Hashable α]
+variable [BEq β] [LawfulBEq β] [Hashable β]
+
+abbrev Output (β : Type) [BEq β] [Hashable β] := Std.HashMap β Unit × List β
+
+theorem fold_contains (input : List β) (state : Output β) (query : β) :
+    (input.foldl HashDistinct.step state).1.contains query =
+      (state.1.contains query || input.contains query) := by
+  induction input generalizing state with
+  | nil => simp
+  | cons head tail ih =>
+    rw [List.foldl_cons, ih]
+    by_cases found : state.1.contains head = true
+    · by_cases same : query = head
+      · subst query
+        simp [HashDistinct.step, found]
+      · simp [HashDistinct.step, found, same]
+    · simp [HashDistinct.step, found, Std.HashMap.contains_insert,
+        BEq.comm, Bool.or_assoc, Bool.or_left_comm]
+
+omit [LawfulBEq β] in
+theorem fold_unchanged (input : List β) (state : Output β)
+    (known : ∀ item ∈ input, state.1.contains item = true) :
+    input.foldl HashDistinct.step state = state := by
+  induction input with
+  | nil => rfl
+  | cons head tail ih =>
+    simpa only [List.foldl_cons, HashDistinct.step, known head (by simp), ite_true]
+      using ih (fun item member => known item (by simp [member]))
+
+/-- Looking up a feature again cannot add an offer: its complete posting was
+already consumed. Both membership sets use full identities after hashing. -/
+def walk (lookup : α → List β) : List α → Std.HashMap α Unit → Output β → Output β
+  | [], _, output => output
+  | feature :: rest, seen, output =>
+    if seen.contains feature then walk lookup rest seen output
+    else walk lookup rest (seen.insert feature ()) ((lookup feature).foldl HashDistinct.step output)
+
+theorem walk_exact (lookup : α → List β) (input : List α)
+    (seen : Std.HashMap α Unit) (output : Output β)
+    (known : ∀ feature, seen.contains feature = true →
+      ∀ item ∈ lookup feature, output.1.contains item = true) :
+    walk lookup input seen output = (input.flatMap lookup).foldl HashDistinct.step output := by
+  induction input generalizing seen output with
+  | nil => rfl
+  | cons feature rest ih =>
+    simp only [walk, List.flatMap_cons, List.foldl_append]
+    split
+    · next found =>
+      rw [fold_unchanged _ _ (known feature found)]
+      exact ih seen output known
+    · rw [ih]
+      intro query present item member
+      rw [fold_contains]
+      by_cases same : query = feature
+      · subst query
+        have present : (lookup feature).contains item = true := List.contains_iff_mem.mpr member
+        simp only [present, Bool.or_true]
+      · have before : seen.contains query = true := by
+          have different : (feature == query) = false := beq_eq_false_iff_ne.mpr (Ne.symm same)
+          simpa only [Std.HashMap.contains_insert, different, Bool.false_or] using present
+        simp [known query before item member]
+
+def collect (lookup : α → List β) (input : List α) : List β :=
+  (walk lookup input {} ({},[])).2.reverse
+
+/-- First encounter order, including ties, is identical to flattening every
+posting and deduplicating only at the end. No rank or candidate is dropped. -/
+theorem collect_exact (lookup : α → List β) (input : List α) :
+    collect lookup input = hashDistinct (input.flatMap lookup) := by
+  unfold collect
+  rw [walk_exact lookup input {} ({},[]) (by simp)]
+  rw [HashDistinct.reference]
+  exact HashDistinct.loop_reference _ {} [] (by simp [HashDistinct.Seen])
+
+end Eggshell.DistinctPostings

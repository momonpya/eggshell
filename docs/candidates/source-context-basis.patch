@@ -0,0 +1,39 @@
+import Eggshell.Handoff
+open Eggshell Eggshell.Plugin
+
+private def require (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+
+private def outcome (work text : String) : OutcomeEdge :=
+  OutcomeEdge.make (.text work) (.text text) [] (by simp) (Nat.zero_le _)
+
+def main : IO Unit := do
+  let parent : Value := .text "question"
+  let a := outcome "read-a" "condition A"
+  let b := outcome "read-b" "result B"
+  let weak := outcome "unbounded-search" "possible names"
+  let graph := AllEdge.make parent [a.work,b.work,weak.work] (by decide) (by decide)
+  let answers := (List.range 6).map fun i => outcome s!"prior-question-{i}" s!"prior explanation {i}"
+  let record : SourceEvidence.Record := {
+    workspace := "sample"
+    files := [{relative := "pkg/a", content := some {bytes := 1,root := String.ofList (List.replicate 64 'a')}}]
+    complete := true
+    closed := false }
+  let absent : SourceEvidence.Record := {record with files := [{relative := "pkg/missing",content := none}]}
+  let ranked := answers.map (·, [record]) ++ [(weak,[absent]),(b,[record]),(a,[record])]
+  let nominated := answers.map (·.relation)
+  let some primary := answers.head? | throw (IO.userError "missing interpretation fixture")
+  let selected := contextEntryOwners [graph] ranked nominated (some primary)
+  require (selected == [b.relation,a.relation,primary.relation])
+    "Repeated interpretations displaced the ranked original conditions/results"
+  require ((contextDataCandidates [graph] ranked).map (·.1.relation) == [b.relation,a.relation])
+    "An interpretation or absent-file record became original file data"
+  require (!record.closed) "The test accidentally grants operation closure"
+  require (contextEntryOwners [] ranked nominated (some primary) == nominated)
+    "An interpretation-only graph lost its existing nomination basis"
+  require ((contextEntryOwners [graph] ranked [] none).isEmpty)
+    "An empty nomination budget invented a context entry"
+  let one := contextEntryOwners [graph] ranked [primary.relation] (some primary)
+  require (one == [b.relation,primary.relation])
+    "The original-data reservation exceeded the existing nomination allowance"
+  IO.println "source context basis: repeated interpretations, original graph data order, fingerprint presence, open-domain advice, text-only graph and existing allowance passed"

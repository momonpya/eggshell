+theorem Located.literal_is_original {source : Source} {text : String} (located : Located source text) :
+    source.slice located.first located.limit = text ∨
+      source.slice located.first located.limit = encoded text := located.literal
+
+theorem Located.context_contains_match {source : Source} {text : String} (located : Located source text) :
+    located.contextFirst ≤ located.first ∧ located.limit ≤ located.contextLimit :=
+  ⟨located.within.1,located.within.2.2.1⟩
+
+end Eggshell.Synapses.QuotationContext

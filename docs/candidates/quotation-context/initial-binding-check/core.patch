+        let start ← row? projection.lines first
+        let stop ← row? projection.lines (limit-1)
+        some (← projection.offsets[start.first]?,← projection.offsets[stop.limit]?)
+      else some (projection.first,projection.limit)
+    let quote := String.ofList (projection.characters.extract first limit).toList

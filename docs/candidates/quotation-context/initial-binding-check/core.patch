+  limit : Nat
+  contextFirst : Nat
+  contextLimit : Nat
+  within : contextFirst ≤ first ∧ first < limit ∧ limit ≤ contextLimit ∧
+    contextLimit ≤ source.characters.size
+  literal : source.slice first limit = quote ∨ source.slice first limit = encoded quote
+
+/-- The enclosing logical rows are already prepared. A multiline quote

+module
+public import Eggshell.CanonicalSourcePrepared
+@[expose] public section
+
+namespace Eggshell.Synapses.CanonicalSource.Leases
+open Lean DB Shared
+
+def capacity : Nat := 8*1024*1024
+def maxHandles : Nat := 512
+
+structure Held where
+  scope : String
+  source : PageMap.Head
+  loaded : Loaded
+  serial : Nat
+  deadline : Nat
+  charge : Nat
+  readers : Nat := 0
+  released : Bool := false
+
+def Held.accepts (held : Held) (scope : String) (source : PageMap.Head) (metadata : Cache.Manifest) : Bool :=
+  held.scope == scope && decide (held.source = source) && held.loaded.metadata == metadata
+
+theorem Held.same_source (held : Held) (scope : String) (source : PageMap.Head) (metadata : Cache.Manifest)
+    (accepted : held.accepts scope source metadata = true) : held.source = source := by
+  simp only [accepts,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.1.2
+
+structure State where
+  entries : Std.HashMap String Held := {}
+  budget : Budget capacity := {}
+  nextExpiry : Option Nat := none
+  closed : Bool := false
+  acquired : Nat := 0
+  released : Nat := 0
+  expired : Nat := 0
+
+def expiry (entries : Std.HashMap String Held) : Option Nat :=
+  entries.fold (fun found _ held => if held.readers > 0 then found else
+    some (found.map (min held.deadline) |>.getD held.deadline)) none
+
+theorem State.within_capacity (state : State) : state.budget.used ≤ capacity := state.budget.within
+
+structure Pool where
+  originals : Shared.Pool
+  state : Std.Mutex State
+
+def Pool.new (originals : Shared.Pool) : IO Pool := return ⟨originals,← Std.Mutex.new {}⟩
+
+/-- Release the original cache borrow outside this pool's short metadata lock. -/
+def Pool.dispose (pool : Pool) (held : Array Held) : IO Unit :=
+  held.forM fun entry => pool.originals.release entry.loaded.identity entry.serial
+
+def Pool.reap (pool : Pool) : IO Unit := do
+  let now ← IO.monoMsNow
+  let retired ← pool.state.atomically do
+    let state ← get
+    unless state.nextExpiry.any (· ≤ now) do return #[]
+    let retired := state.entries.toArray.filterMap fun (_,held) =>
+      if held.readers == 0 && (held.released || held.deadline ≤ now) then some held else none
+    let entries := state.entries.filter fun _ held =>
+      held.readers > 0 || (!held.released && now < held.deadline)
+    let amount := retired.foldl (fun total held => total+held.charge) 0
+    set {state with
+      entries,budget := state.budget.release amount,nextExpiry := expiry entries,
+      expired := state.expired+retired.size}
+    return retired
+  pool.dispose retired
+
+def Pool.retain (pool : Pool) (scope : String) (source : PageMap.Snapshot) (path : System.FilePath)
+    (metadata : Cache.Manifest) (deadline holdUntil : Nat) : IO (String × Loaded × Reuse) := do
+  pool.reap
+  let now ← IO.monoMsNow
+  unless now < deadline && deadline ≤ holdUntil && holdUntil ≤ now+29000 do
+    throw (IO.userError "invalid retained source lifetime")
+  let identityBytes := (toJson (scope,source.head,metadata)).compress.utf8ByteSize
+  unless identityBytes ≤ 32768 do throw (IO.userError "retained source identity exceeds its bound")
+  let charge := 65536+8*identityBytes
+  let (entry,reuse) ← pool.originals.acquire source path metadata deadline
+  let transferred ← IO.mkRef false
+  try
+    repeat
+      unless (← IO.monoMsNow) < deadline do throw (IO.userError "retained source acquisition expired")
+      if ← entry.promise.isResolved then break
+      IO.sleep 1
+    let some result := entry.promise.result?.get | throw (IO.userError "retained source acquisition disappeared")
+    let loaded ← IO.ofExcept result
+    let token ← pool.state.atomically do
+      let state ← get
+      unless !state.closed && state.entries.size < maxHandles do throw (IO.userError "retained source admission is full or stopped")
+      let some budget := state.budget.reserve? charge | throw (IO.userError "retained source byte admission is full")
+      let token := Blake3.hex (← IO.getRandomBytes 32)
+      unless !state.entries.contains token do throw (IO.userError "retained source token collision")
+      let held : Held := ⟨scope,source.head,loaded,entry.serial,holdUntil,charge,0,false⟩
+      let entries := state.entries.insert token held
+      set {state with entries,budget,nextExpiry := expiry entries,acquired := state.acquired+1}
+      return token
+    transferred.set true
+    return (token,loaded,reuse)
+  finally
+    unless ← transferred.get do pool.originals.release (Shared.key path metadata) entry.serial
+
+def Pool.finishRead (pool : Pool) (token : String) : IO Unit := do
+  let now ← IO.monoMsNow
+  let retired ← pool.state.atomically do
+    let state ← get
+    let some held := state.entries[token]? | return #[]
+    let held := {held with readers := held.readers-1}
+    if held.readers == 0 && (held.released || held.deadline ≤ now) then
+      let entries := state.entries.erase token
+      set {state with entries,budget := state.budget.release held.charge,nextExpiry := expiry entries}
+      return #[held]
+    let entries := state.entries.insert token held
+    set {state with entries,nextExpiry := expiry entries}
+    return #[]
+  pool.dispose retired
+
+/-- An active read keeps its original cache charge even after release/expiry. -/
+def Pool.withHeld (pool : Pool) (token scope : String) (source : PageMap.Head) (metadata : Cache.Manifest)
+    (deadline : Nat) (use : Loaded → Reuse → IO α) : IO α := do
+  pool.reap
+  let now ← IO.monoMsNow
+  let held ← pool.state.atomically do
+    let state ← get
+    let some held := state.entries[token]? | throw (IO.userError "retained source expired or released")
+    unless !state.closed && !held.released && now < held.deadline && now < deadline &&
+        held.accepts scope source metadata do throw (IO.userError "retained source changed its scope, root or lifetime")
+    let entries := state.entries.insert token {held with readers := held.readers+1}
+    set {state with entries,nextExpiry := expiry entries}
+    return held
+  try use held.loaded .hit
+  finally pool.finishRead token
+
+def Pool.release (pool : Pool) (token scope : String) : IO Unit := do
+  let retired ← pool.state.atomically do
+    let state ← get
+    let some held := state.entries[token]? | return #[]
+    unless held.scope == scope do throw (IO.userError "retained source release crossed its scope")
+    if held.released then return #[]
+    if held.readers > 0 then
+      let entries := state.entries.insert token {held with released := true}
+      set {state with entries,nextExpiry := expiry entries,released := state.released+1}
+      return #[]
+    let entries := state.entries.erase token
+    set {state with
+      entries,budget := state.budget.release held.charge,nextExpiry := expiry entries,
+      released := state.released+1}
+    return #[held]
+  pool.dispose retired
+
+def Pool.close (pool : Pool) : IO Unit := do
+  let retired ← pool.state.atomically do
+    let state ← get
+    let retired := state.entries.toArray.filterMap fun (_,held) => if held.readers == 0 then some held else none
+    let entries := state.entries.filterMap fun _ held =>
+      if held.readers == 0 then none else some {held with released := true}
+    let amount := retired.foldl (fun total held => total+held.charge) 0
+    set {state with closed := true,entries,budget := state.budget.release amount,nextExpiry := none}
+    return retired
+  pool.dispose retired
+
+def Pool.stats (pool : Pool) : IO Json := pool.state.atomically do
+  let state ← get
+  return Json.mkObj [("active",toJson state.entries.size),("chargedBytes",toJson state.budget.used),
+    ("capacity",toJson capacity),("acquired",toJson state.acquired),("released",toJson state.released),
+    ("expired",toJson state.expired),("closed",toJson state.closed),
+    ("readers",toJson (state.entries.fold (fun total _ held => total+held.readers) 0)),
+    ("accountedExact",toJson (state.budget.used == state.entries.fold (fun total _ held => total+held.charge) 0))]
+
+end Eggshell.Synapses.CanonicalSource.Leases

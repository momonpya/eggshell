+/-- Closure has a stable target taken from the captured context. Replaying a
+partial metadata write never uses the mutable closed flag as its progress log. -/
+def terminalCloseState (state : ThreadState) (observedEpoch : Nat) : ThreadState :=
+  {state with epoch := max state.epoch (observedEpoch+1),offers := []}
 
+theorem terminal_replay_does_not_advance_epoch (state : ThreadState) (observedEpoch : Nat) :
+    terminalCloseState (terminalCloseState state observedEpoch) observedEpoch =
+      terminalCloseState state observedEpoch := by
+  simp [terminalCloseState,Nat.max_assoc]
+
+theorem terminal_closure_keeps_newer_epoch (state : ThreadState) (observedEpoch : Nat)
+    (newer : observedEpoch+1 ≤ state.epoch) :
+    (terminalCloseState state observedEpoch).epoch = state.epoch := by
+  exact Nat.max_eq_left newer
+
+theorem terminal_closure_never_decreases_epoch (state : ThreadState) (observedEpoch : Nat) :
+    state.epoch ≤ (terminalCloseState state observedEpoch).epoch :=
+  Nat.le_max_left _ _
+
+theorem terminal_closure_finishes_observed_epoch (state : ThreadState) (observedEpoch : Nat) :
+    observedEpoch+1 ≤ (terminalCloseState state observedEpoch).epoch :=
+  Nat.le_max_right _ _
+

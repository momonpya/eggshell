+structure PreparedOwnerBinding where
+  id : Nat
+  originals : List PreparedOwners.Original
+
+/-- Retain the original membership/root checks while using publication-prepared
+integer coordinates. No structural Value is reverse-resolved here. -/
+def checkPreparedOriginals (sources : Array DB.PageMap.Snapshot)
+    (originals : List PreparedOwners.Original) : IO Unit := do
+  for original in originals do
+    let some source := sources[original.source]? | throw (IO.userError "prepared original escaped captured sources")
+    let some member ← source.get (Persistence.Store.key "member" original.node) |
+      throw (IO.userError "prepared original lost live membership")
+    unless (← IO.ofExcept (Persistence.Store.payloadSize (some member))) == original.ordinal &&
+        original.ordinal < (← Persistence.Store.getNat source.get "roots") &&
+        (← IO.ofExcept (Persistence.Store.payloadSize (← source.get (Persistence.Store.key "root" original.ordinal)))) == original.node do
+      throw (IO.userError "prepared original changed its source root position")
+
+def preparedOwnerBinding (view : OwnerViews.Reader) (id : Nat) : IO PreparedOwnerBinding := do
+  let originals ← view.base.originals id
+  unless !originals.isEmpty do throw (IO.userError "prepared owner lost all live originals")
+  checkPreparedOriginals (view.base.inputs.map (·.original)) originals
+  return ⟨id,originals⟩
+
+def knownOwner (bindings : Std.HashMap Value PreparedOwnerBinding) (value : Value)
+    (fallback : Value → IO (Option Nat)) : IO (Option Nat) :=
+  match bindings[value]? with
+  | some binding => pure (some binding.id)
+  | none => fallback value
+
+theorem known_owner_hit (bindings : Std.HashMap Value PreparedOwnerBinding) (value : Value)
+    (binding : PreparedOwnerBinding) (fallback : Value → IO (Option Nat))
+    (present : bindings[value]? = some binding) :
+    knownOwner bindings value fallback = pure (some binding.id) := by simp [knownOwner,present]
+
+theorem unknown_owner_fallback (bindings : Std.HashMap Value PreparedOwnerBinding) (value : Value)
+    (fallback : Value → IO (Option Nat)) (absent : bindings[value]? = none) :
+    knownOwner bindings value fallback = fallback value := by simp [knownOwner,absent]
+
+def originalPosition (frontiers : List AdvisoryFrontier) (original : PreparedOwners.Original) :
+    Except String AdvisoryPosition := do
+  let some frontier := frontiers[original.source]? | throw "prepared position omitted its captured source"
+  if bounded : original.ordinal < frontier.nextRoot then return ⟨frontier,original.ordinal,bounded⟩
+  else throw "prepared position exceeds its captured frontier"
+
+def originalPositions (frontiers : List AdvisoryFrontier) : List PreparedOwners.Original → Except String (List AdvisoryPosition)
+  | [] => .ok []
+  | original::rest =>
+    match originalPosition frontiers original with
+    | .error error => .error error
+    | .ok first => match originalPositions frontiers rest with
+      | .error error => .error error
+      | .ok tail => .ok (first::tail)
+
+theorem original_positions_complete (frontiers : List AdvisoryFrontier)
+    (originals : List PreparedOwners.Original) (positions : List AdvisoryPosition)
+    (accepted : originalPositions frontiers originals = .ok positions) : positions.length = originals.length := by
+  induction originals generalizing positions with
+  | nil =>
+    simp only [originalPositions,Except.ok.injEq] at accepted
+    subst positions
+    rfl
+  | cons first rest ih =>
+    cases head : originalPosition frontiers first with
+    | error error => simp [originalPositions,head] at accepted
+    | ok position =>
+      cases tail : originalPositions frontiers rest with
+      | error error => simp [originalPositions,head,tail] at accepted
+      | ok remaining =>
+        have same : position::remaining = positions := by
+          simpa [originalPositions,head,tail] using accepted
+        subst positions
+        simp [ih remaining tail]
+

+/-- Reopen exactly the boundary retained by a native turn. A newer source or
+changed inventory cannot replace any captured owner. -/
+structure Retained (selection : Selection) (images : Array ProjectInputs.Image) where
+  private mk ::
+  reads : ReadSet selection
+  exact : reads.images = images
+
+@[no_expose] def reopen (selection : Selection) (images : Array ProjectInputs.Image)
+    (deadline : Nat) : IO (Retained selection images) := do
+  unless images.size == selection.reads.size do
+    throw (IO.userError "captured project context omitted a configured project")
+  let views ← (selection.reads.zip images).mapM fun (project,image) => do
+    unless (← IO.monoMsNow) < deadline do throw (IO.userError "captured project context expired")
+    unless image.project == project.manifest.identity &&
+        image.inventory == manifestChecksum project.manifest do
+      throw (IO.userError "captured project context changed its original inventory")
+    ProjectStore.openView project image.cut
+  if complete : views.size = selection.reads.size then
+    if projects : views.map (·.project.directory) = selection.reads.map (·.directory) then
+      if manifests : views.map (·.project.manifest) = selection.reads.map (·.manifest) then
+        let reads : ReadSet selection := ⟨views,complete,projects,manifests⟩
+        if exact : reads.images = images then return ⟨reads,exact⟩
+        else throw (IO.userError "reopened project context changed a captured source head")
+      else throw (IO.userError "captured project context changed its complete manifests")
+    else throw (IO.userError "captured project context changed its configured paths")
+  else throw (IO.userError "captured project context omitted an original owner")
+

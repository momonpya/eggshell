+module
+
+public import Eggshell.PluginModel
+public import Eggshell.ProjectAccess
+
+@[expose] public section
+namespace Eggshell.Plugin.ProjectContext
+open Lean DB
+
+structure Context where
+  private mk ::
+  selection : ProjectAccess.Selection
+  reads : ProjectAccess.ReadSet selection
+  images : Array ProjectInputs.Image
+  retained : reads.images = images
+
+theorem Context.complete (context : Context) : context.images.size = context.selection.config.read.length := by
+  rw [← context.retained]
+  exact context.reads.image_count
+
+theorem Context.complete_sources (context : Context) :
+    (context.images.map fun image => image.cut.heads.size).sum = context.reads.sources.size := by
+  rw [← context.retained]
+  exact context.reads.image_source_count
+
+def projectConfigured (pending : PendingTurn) : IO Bool := do
+  for path in (pending.write.toList ++ pending.read).eraseDups do
+    if ← ((System.FilePath.mk path)/"project").pathExists then return true
+  return false
+
+def Context.requireWriter (context : Context) : IO Unit := do
+  if let some write := context.selection.write then
+    unless context.reads.views.any (fun view => view.project.directory == write.directory) do
+      throw (IO.userError "configured read scope omitted the selected write project")
+
+/-- This runs before lookup; subsequent hooks retain this boundary for the turn. -/
+@[no_expose] def capture (pending : PendingTurn) (deadline : Nat) : IO PendingTurn := do
+  unless pending.projectInputs.isNone do throw (IO.userError "native turn already captured its project context")
+  unless ← projectConfigured pending do return pending
+  let selection ← ProjectAccess.resolve pending.sessionId (pendingSelection pending)
+  let reads ← ProjectAccess.pin selection deadline
+  let context : Context := ⟨selection,reads,reads.images,rfl⟩
+  context.requireWriter
+  return {pending with projectInputs := some reads.images}
+
+@[no_expose] def open? (pending : PendingTurn) (deadline : Nat) : IO (Option Context) := do
+  let some images := pending.projectInputs | do
+    if ← projectConfigured pending then throw (IO.userError "native project turn has no captured read boundary")
+    return none
+  let selection ← ProjectAccess.resolve pending.sessionId (pendingSelection pending)
+  let saved ← ProjectAccess.reopen selection images deadline
+  let context : Context := ⟨selection,saved.reads,images,saved.exact⟩
+  context.requireWriter
+  return some context
+
+def Context.source (context : Context) : IO PageMap.Snapshot := do
+  if let some write := context.selection.write then
+    let some source := context.reads.sources.find? (·.head.identity == write.original.identity) |
+      throw (IO.userError "captured project context omitted its native write route")
+    return source
+  let some source := context.reads.sources[0]? |
+    throw (IO.userError "captured project context has no native ingress source")
+  return source
+
+def Context.archive (context : Context) : Option String :=
+  context.selection.write.map (·.sourceDirectory.toString)
+
+def Context.canPrepare (context : Context) (owner : Sidecar.Owner) : Bool :=
+  context.selection.write.any fun write =>
+    (List.range write.project.manifest.owners.size).any fun slot =>
+      (write.project.manifest.owners[slot]?.map (·.identity) == some owner.database) &&
+      write.project.sourceDirectory slot == (System.FilePath.mk owner.directory).normalize
+
+/-- Physical storage partitioning never changes the configured write project. -/
+def Context.physicalSelection (context : Context) : Config.Selection := {
+  context.selection.config with
+  read := context.reads.sources.toList.map fun source =>
+    {name := source.head.identity,path := source.directory}
+  write := context.selection.write.map fun write =>
+    {name := write.project.manifest.identity,path := write.sourceDirectory} }
+
+def Context.snapshots (context : Context) : List (Option PageMap.Snapshot) :=
+  context.reads.sources.toList.map some
+
+end Eggshell.Plugin.ProjectContext

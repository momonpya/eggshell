+module
+
+public import Eggshell.GraphStore
+public import Eggshell.Paths
+
+@[expose] public section
+namespace Eggshell.QueryMemoStore
+open DB
+
+def key (source : PageMap.Snapshot) (scope : Option String) := scope.getD source.head.identity
+def authority (scope : String) := "private-query-memo:"++scope
+
+def directory (scope : String) : IO System.FilePath := do
+  unless PageMap.validIdentity scope do throw (IO.userError "invalid private query cache scope")
+  return (← Paths.dataRoot)/"query-cache"/scope/"handoff"
+
+def open? (source : PageMap.Snapshot) (scope : Option String := none) : IO (Option PageMap.Snapshot) := do
+  let scope := key source scope
+  let path ← directory scope
+  if !(← (path/"head").pathExists) then return none
+  let snapshot ← PageMap.pin path
+  unless snapshot.head.authority == authority scope do throw (IO.userError "foreign private query cache")
+  return some snapshot
+
+/-- Optional query writes have their own private head and a fail-fast claim.
+They cannot advance the original project's owner frontier. -/
+def withWriter (source : PageMap.Snapshot) (scope : Option String)
+    (action : PageMap.Writer → IO α) : IO α := do
+  let scope := key source scope
+  let path ← directory scope
+  let parent := path.parent.get!
+  FileSystem.privateDirectory parent
+  let claim := parent/"handoff.guard"
+  FileSystem.immutableExistingBytes claim ByteArray.empty
+  let lease ← FileSystem.openRead claim.toString
+  unless ← FileSystem.tryReadLock lease true do throw (IO.userError "private query cache is busy")
+  try
+    let snapshot ← if ← (path/"head").pathExists then PageMap.pin path else PageMap.create path (authority scope)
+    unless snapshot.head.authority == authority scope do throw (IO.userError "foreign private query cache")
+    let (value,_,_) ← PageMap.withWriter snapshot action
+    return value
+  finally FileSystem.unlockRead lease
+
+end Eggshell.QueryMemoStore

+/-- Only the framed connection's owner processes progress,between reads.
+No other task mutates its absolute cutoff. -/
+def readyDeadline (expected actual : Identity) (finishReady : Bool) (cutoff arrived : Nat) : Nat :=
+  min expected.deadline (if finishReady && expected == actual && arrived < cutoff then
+    expected.deadline else cutoff)
+
+def Request.advance (request : Request) (actual : Identity) (cutoff arrived : Nat) : Except String Nat :=
+  match request.identity with
+  | none => .error "unexpected operation progress"
+  | some expected =>
+    if expected == actual && arrived < cutoff then
+      .ok (readyDeadline expected actual request.finishReady cutoff arrived)
+    else .error "foreign or expired operation progress"
+
+theorem Request.advance_bounded (request : Request) (expected actual : Identity) (cutoff arrived next : Nat)
+    (identity : request.identity = some expected) (accepted : request.advance actual cutoff arrived = .ok next) :
+    next ≤ expected.deadline := by
+  simp only [advance,identity] at accepted
+  split at accepted
+  · cases accepted
+    exact Nat.min_le_left _ _
+  · cases accepted
+
+theorem Request.advance_same (request : Request) (expected : Identity) (cutoff arrived : Nat)
+    (identity : request.identity = some expected) (timely : arrived < cutoff) :
+    request.advance expected cutoff arrived = .ok (readyDeadline expected expected request.finishReady cutoff arrived) := by
+  simp [advance,identity,timely]
+

["module\npublic import Eggshell.SynapseTransport\npublic import Eggshell.HashDistinct\npublic import Std.Data.HashMap.Lemmas\n@[expose] public section\n\nnamespace Eggshell.Synapses.Bundles\nopen Lean Persistence.Store Recommend Routing.Store\n\nabbrev Demand := Cause.Demand\n\ndef demands (plan : Transport.Plan) : Array Demand := Cause.demands plan.causeInputs\n\n/-- The original owner and every scalar row remain attached to their range.\nNo graph relation is sufficient to invent a source binding. -/\nstructure Bound (source : Range) where\n  original : OutcomeEdge\n  owner : String\n  ownerExact : owner = Persistence.selectionKey original.relation\n  rows : Array Read\n  valid : rows.all Read.valid = true\n  inside : rows.all (fun row => source.contains row.source) = true\n  owned : rows.all (fun row => row.binding.owner == owner) = true\n  complete : covered source (rows.map (·.source)) = true\n  spans : List (Nat × Nat)\n  spansExact : spans = (rows.toList.map fun row => (row.binding.first,row.binding.limit)).eraseDups\n\ntheorem Bound.spans_exact (bound : Bound source) :\n    bound.spans = (bound.rows.toList.map fun row => (row.binding.first,row.binding.limit)).eraseDups :=\n  bound.spansExact\n\nstructure Member where\n  source : Range\n  choices : Array (Bound source)\n  located : choices.isEmpty = false\n\nstructure Projected where\n  demand : Demand\n  members : Array Member\n  sourcesExact : members.map (·.source) = demand.sources\n\nstructure OwnerRows where\n  original : Transport.LocatedOwner\n  key : String\n  keyExact : key = Persistence.selectionKey original.owner.relation\n  directory : Std.HashMap Range (Array Read)\n  directoryExact : ∀ source, directory[source]?.getD #[] = original.located.filterMap\n    (fun located => if located.source == source then some located.row else none)\n\ndef rowDirectory (located : Array Routed.Located) : Std.HashMap Range (Array Read) :=\n  located.foldl (fun directory row => directory.insert row.source\n    ((directory[row.source]?.getD #[]).push row.row)) {}\n\ntheorem row_directory_exact (located : Array Routed.Located) (source : Range) :\n    (rowDirectory located)[source]?.getD #[] = located.filterMap\n      (fun row => if row.source == source then some row.row else none) := by\n  have go : ∀ reversed : List Routed.Located,\n      (rowDirectory reversed.reverse.toArray)[source]?.getD #[] =\n        reversed.reverse.toArray.filterMap (fun row =>\n          if row.source == source then some row.row else none) := by\n    intro reversed\n    induction reversed with\n    | nil => simp [rowDirectory]\n    | cons row previous ih =>\n      have step : (row :: previous).reverse.toArray = previous.reverse.toArray.push row := by simp\n      rw [step]\n      simp only [rowDirectory,Array.foldl_push,Std.HashMap.getElem?_insert]\n      by_cases same : row.source = source\n      · simpa [same,rowDirectory,Array.filterMap_push] using congrArg (fun rows => rows.push row.row) ih\n      · simpa [same,rowDirectory,Array.filterMap_push] using ih\n  simpa using go located.toList.reverse\n\ndef bindingRows (source : Range) (owner : OwnerRows) : Array Read :=\n  (hashDistinct (owner.directory[source]?.getD #[]).toList).toArray\n\ntheorem binding_rows_exact (source : Range) (owner : OwnerRows) :\n    bindingRows source owner = (owner.directory[source]?.getD #[]).toList.eraseDups.toArray := by\n  simp only [bindingRows,HashDistinct.reference]\n\ndef bind? (source : Range) (owner : OwnerRows) : Option (Bound source) :=\n  let rows := bindingRows source owner\n  if valid : rows.all Read.valid = true then\n    if inside : rows.all (fun row => source.contains row.source) = true then\n      if owned : rows.all (fun row => row.binding.owner == owner.key) = true then\n        if complete : covered source (rows.map (·.source)) = true then\n          let spans := hashDistinct (rows.toList.map fun row => (row.binding.first,row.binding.limit))\n          some ⟨owner.original.owner,owner.key,owner.keyExact,rows,valid,inside,owned,complete,\n            spans,HashDistinct.reference _⟩ else none\n      else none\n    else none\n  else none\n\ndef project? (owners : Array OwnerRows) (demand : Demand) : Option Projected := do\n  let members ← demand.sources.mapM fun source => do\n    let choices := owners.filterMap (bind? source)\n    if located : choices.isEmpty = false then some (Member.mk source choices located) else none\n  if sourcesExact : members.map (·.source) = demand.sources then\n    some ⟨demand,members,sourcesExact⟩ else none\n\ndef project (plan : Transport.Plan) : Array Projected :=\n  let owners := plan.owners.map fun original =>\n    (⟨original,Persistence.selectionKey original.owner.relation,rfl,\n      rowDirectory original.located,row_directory_exact original.located⟩ : OwnerRows)\n  ((demands plan).filter (·.reason.joint)).filterMap (project? owners)\n\ntheorem projected_sources_unchanged (projected : Projected) :\n    projected.members.map (·.source) = projected.demand.sources := projected.sourcesExact\n\ndef receipt (plan : Transport.Plan) (projected : Array Projected) (text : String) : Json :=\n  let shown := Extraction.presented text plan.documents plan.rows\n  (plan.receiptWith shown).setObjVal! \"bundles\" (toJson ((demands plan).map fun demand =>\n    Json.mkObj [(\"identity\",toJson demand.key), (\"kind\",toJson demand.kind),\n      (\"priority\",toJson demand.priority), (\"members\",toJson demand.sources),\n      (\"joint\",toJson demand.reason.joint),\n      (\"located\",if demand.reason.joint then toJson (projected.any (·.demand.key == demand.key)) else Json.null),\n      (\"bodyDelivered\",toJson (demand.sources.all fun source => covered source shown.ranges))]))\n\nend Eggshell.Synapses.Bundles\n",[]]
["module\n\npublic import Eggshell.SynapseIndex\npublic import Eggshell.SynapseUsage\npublic import Eggshell.ObservationContext\npublic import Eggshell.CanonicalSourceCache\npublic import Eggshell.CanonicalSourceDelivery\npublic import Eggshell.PublicationClient\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Recommend\nopen Lean DB\n\ndef implementation : String := Blake3.hex (Blake3.digest \"eggshell.observation-recommendation\".toUTF8 [\n  (include_str \"SynapseRecommend.lean\").toUTF8,(include_str \"ObservationContext.lean\").toUTF8,\n  (include_str \"SynapticCause.lean\").toUTF8,\n  (include_str \"JsonScalars.lean\").toUTF8,(include_str \"SynapseTransport.lean\").toUTF8,\n  (include_str \"SynapseUsage.lean\").toUTF8,(include_str \"SynapticTransport.lean\").toUTF8,\n  (include_str \"SynapticRoutingStore.lean\").toUTF8])\n\nstructure Offer where\n  target : Target\n  priority : Nat\n  fact : Fact\n  identity : String\n  identity_exact : identity = Index.contentKey fact\n  valid : fact.valid = true\n  witness : carries fact target = true\n\ndef Offer.check? (target : Target) (priority : Nat) (fact : Fact)\n    (identity : {value : String // value = Index.contentKey fact}) : Option Offer :=\n  if valid : fact.valid = true then\n    if witness : carries fact target = true then\n      some ⟨target, priority, fact, identity.val, identity.property, valid, witness⟩ else none\n  else none\n\ntheorem Offer.consumption_row (offer : Offer) (edge : Consumption) (kind : offer.fact = .consumed edge)\n    (source : Range) (target : offer.target = .range source) : source ∈ edge.rows := by\n  have witness := offer.witness\n  rw [kind,target] at witness\n  exact Array.mem_of_contains_eq_true witness\n\ntheorem Offer.usage_is_evidence (offer : Offer) (usage : Usage) (kind : offer.fact = .used usage) :\n    (usage.kind = .omittedThenRead ∨ usage.kind = .omittedThenConsumed) ∨ usage.kind = .deliveredThenCited := by\n  have witness := offer.witness\n  cases target : offer.target <;> simp_all [carries, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq]\n\ntheorem Offer.output_has_producer (offer : Offer) (producer : Occurrence)\n    (target : offer.target = .output producer) :\n    ∃ edge, offer.fact = .consumed edge ∧ edge.producer = producer := by\n  have witness := offer.witness\n  cases kind : offer.fact <;> simp_all [carries,beq_iff_eq]\n\ndef Offer.kind (offer : Offer) : String := match offer.fact with\n  | .supports _ => \"support\"\n  | .consumed _ => \"consumption\"\n  | .coquoted _ _ => \"coquotation\"\n  | .used usage => usage.kind.label\n  | .read _ => \"unavailable\"\n\ndef Offer.json (offer : Offer) : Json := Json.mkObj [\n  (\"target\", toJson offer.target), (\"source\", toJson offer.target.source?), (\"priority\", toJson offer.priority),\n  (\"kind\", toJson offer.kind), (\"evidence\", toJson offer.identity)]\n\nstructure Limits where\n  requests : Nat := 256\n  facts : Nat := 8192\n  bytes : Nat := 8*1024*1024\n\nstructure Task where\n  key : Index.Key\n  priority : Nat\n\nstructure Result where\n  offers : Array Offer := #[]\n  requests : Nat := 0\n  facts : Nat := 0\n  bytes : Nat := 0\n  complete : Bool := true\n  available : Bool := true\n  index : Option PageMap.Head := none\n  usage : Option PageMap.Head := none\n  failure : Option String := none\n\n/-- A partial walk never changes the original packet. Its receipt still\nreports incompleteness rather than presenting an empty successful search. -/\ndef Result.admitted (result : Result) : Array Offer :=\n  if result.complete && result.available && result.failure.isNone then result.offers else #[]\n\ntheorem Result.incomplete_not_admitted (result : Result) (incomplete : result.complete = false) :\n    result.admitted = #[] := by simp [admitted, incomplete]\n\ntheorem Result.failed_not_admitted (result : Result) (failed : result.failure.isSome = true) :\n    result.admitted = #[] := by\n  cases found : result.failure <;> simp_all [admitted]\n\ndef Result.receipt (result : Result) : Json := Json.mkObj [\n  (\"available\", toJson result.available), (\"complete\", toJson result.complete),\n  -- An exception can occur after successful reads. Do not report those\n  -- interrupted counters as zero observed operations.\n  (\"requests\", if result.failure.isSome then Json.null else toJson result.requests),\n  (\"facts\", if result.failure.isSome then Json.null else toJson result.facts),\n  (\"bytes\", if result.failure.isSome then Json.null else toJson result.bytes),\n  (\"failure\", toJson result.failure),\n  (\"index\", toJson result.index), (\"usage\", toJson result.usage),\n  (\"offers\", toJson (result.admitted.map Offer.json))]\n\ndef Result.stamp (result : Result) : String := Index.contentKey result.receipt\n\ndef addOffer (result : Result) (target : Target) (priority : Nat) (fact : Fact)\n    (identity : {value : String // value = Index.contentKey fact}) : Result :=\n  match Offer.check? target priority fact identity with\n  | none => result\n  | some offer => {result with offers := result.offers.push offer}\n\n/-- Priority is inherited from the original nomination. Coquotation expands\none incidence hop; only reverse consumption is recursive. No score fitting,\nwhole-producer fallback, graph mutation or certification occurs here. -/\ndef collect (shared : Index.Reader) (usage : Option Index.Reader)\n    (answers : Array (String × Nat)) (initial : Array Range) (query : String)\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\n  let database := shared.manifest.source.identity\n  let mut roots := answers.map fun (answer, priority) => ({key := .answer database answer, priority} : Task)\n  roots := roots ++ initial.map (fun source => ⟨.quoted source, 0⟩)\n  roots := roots ++ consumers.map (fun (consumer,priority) => ⟨.consumer consumer,priority⟩)\n  if usage.isSome && digest query then roots := roots.push ⟨.query query, 0⟩\n  roots := roots.qsort fun a b =>\n    if a.priority == b.priority then (toJson a.key).compress < (toJson b.key).compress\n    else a.priority < b.priority\n  let mut nextRoot := 0\n  let mut queue : Array Task := #[]\n  let mut position := 0\n  let mut seen : Array Index.Key := #[]\n  let mut result : Result := {index := some shared.index.head, usage := usage.map (·.index.head)}\n  -- Descendants inherit their root's priority. Exhaust each root's FIFO\n  -- closure before the next root, rather than repeatedly sorting a growing\n  -- fanout. First visitation therefore retains the best nominated priority.\n  repeat\n    if position == queue.size then\n      let some root := roots[nextRoot]? | break\n      nextRoot := nextRoot+1\n      queue := #[root]\n      position := 0\n    let some task := queue[position]? | break\n    position := position+1\n    if (← IO.monoMsNow) ≥ deadline then\n      result := {result with complete := false}\n      break\n    if seen.contains task.key then continue\n    if result.requests ≥ limits.requests || result.facts ≥ limits.facts || result.bytes ≥ limits.bytes ||\n        (← IO.monoMsNow) ≥ deadline then\n      result := {result with complete := false}\n      break\n    seen := seen.push task.key\n    let reader := match task.key with | .query _ => usage.getD shared | _ => shared\n    let found ← reader.lookup task.key (limits.facts-result.facts) deadline (some (limits.bytes-result.bytes))\n    result := {result with\n      requests := result.requests+1\n      facts := result.facts+found.checked.size\n      bytes := result.bytes+found.payloadBytes}\n    if !found.complete then result := {result with complete := false}; break\n    for checked in found.checked do\n      let fact := checked.fact\n      let identity : {value : String // value = Index.contentKey fact} := ⟨Index.contentKey fact, rfl⟩\n      match task.key, fact with\n      | .answer .., .supports support =>\n        result := addOffer result (.range support.source) task.priority fact identity\n        queue := queue.push ⟨.group (.claim support.claim), task.priority⟩\n        queue := queue.push ⟨.consumer support.read.occurrence, task.priority⟩\n        queue := queue.push ⟨.quoted support.source, task.priority⟩\n      | .consumer _, .consumed edge =>\n        if edge.rows.isEmpty then\n          result := addOffer result (.output edge.producer) task.priority fact identity\n        for source in edge.rows do\n          result := addOffer result (.range source) task.priority fact identity\n          queue := queue.push ⟨.quoted source, task.priority⟩\n        queue := queue.push ⟨.consumer edge.producer, task.priority⟩\n      | .quoted _, .coquoted group _ =>\n        queue := queue.push ⟨.group group, task.priority⟩\n      | .group _, .coquoted _ source =>\n        result := addOffer result (.range source) task.priority fact identity\n      | .query _, .used value =>\n        if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed || value.kind == .deliveredThenCited then\n          result := addOffer result (.range value.source) task.priority fact identity\n          queue := queue.push ⟨.quoted value.source, task.priority⟩\n      | _, _ => pure ()\n  -- A checked omission is the more direct observation. Positive citation\n  -- remains useful only where no omission of that same range was observed.\n  let missing := result.offers.foldl (fun ranges offer => match offer.fact with\n    | .used value => if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed then ranges.insert value.source else ranges\n    | _ => ranges) ({} : Std.HashSet Range)\n  return {result with offers := result.offers.filter fun offer => match offer.fact with\n    | .used value => value.kind != .deliveredThenCited || !missing.contains value.source\n    | _ => true}\n\n/-- Pin optional index publications once for both memo identity and planning.\nAn advancing background worker cannot silently change the input mid-request. -/\nstructure Prepared where\n  source : PageMap.Snapshot\n  shared : Option Index.Reader\n  usage : Option Index.Reader\n  failure : Option String := none\n  canonical : Option Plugin.Publication.Client.SourceReference := none\n  canonicalFailure : Option String := none\n\n/-- Read existing authenticated views without selecting a write destination.\nA read-only profile may reuse DB-owned preparation. Private views remain the\nfallback when the shared directory is absent or not readable. -/\ndef readablePrepared? (read : Sidecar.Storage → IO (Option α)) : IO (Option α) := do\n  for storage in [.database,.user] do\n    let found ← try read storage catch error => match error with\n      | .permissionDenied _ _ _ => pure none\n      | _ => throw error\n    if found.isSome then return found\n  return none\n\ndef prepare (source : PageMap.Snapshot) (deadline : Option Nat := none) : IO Prepared := do\n  try\n    let readDeadline := deadline.getD ((← IO.monoMsNow)+5000)\n    let (canonical,canonicalFailure) ← try\n      let prepared ← readablePrepared? fun storage => Plugin.Publication.Client.prepareSource source storage\n        readDeadline\n      pure (prepared,if prepared.isNone then some \"canonical-not-ready\" else none)\n      catch error => pure (none,some s!\"canonical-open: {error}\")\n    return {\n      source := source,shared := ← readablePrepared? fun storage => Index.open? source storage .shared\n      usage := ← Index.open? source .user .usage,canonical,canonicalFailure}\n  catch error => return {\n    source := source,shared := none,usage := none,failure := some s!\"index-open: {error}\"}\n\ndef Prepared.identity (prepared : Prepared) : Json :=\n  toJson (implementation,prepared.source.head.identity, prepared.source.head.authority,\n    prepared.shared.map (·.index.head), prepared.usage.map (·.index.head), prepared.failure,\n    prepared.canonical.map (·.identity),prepared.canonicalFailure,CanonicalSource.Delivery.implementation)\n\ndef Prepared.collect (prepared : Prepared) (answers : Array (String × Nat)) (query : String)\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\n  if prepared.failure.isSome then return {complete := false, available := false, failure := prepared.failure}\n  let some shared := prepared.shared | return {available := false}\n  try _root_.Eggshell.Synapses.Recommend.collect shared prepared.usage answers #[] query deadline limits consumers\n  catch error => return {\n    complete := false, index := some shared.index.head, usage := prepared.usage.map (·.index.head)\n    failure := some s!\"index-read: {error}\"}\n\n/-- Locate a recommendation only inside an already hydrated original owner.\nFingerprint/range matching never creates a new owner or a control Match. -/\nstructure Located where\n  offer : Offer\n  source : Range\n  target : offer.target = .range source\n  row : Read\n  within : source.contains row.source = true\n\ndef locate (offers : Array Offer) (rows : Array Read) : Array Located := Id.run do\n  let mut found := #[]\n  for offer in offers do\n    let .range source := offer.target | continue\n    if target : offer.target = .range source then\n      let matching := rows.filter (source.contains ·.source)\n      unless covered source (matching.map (·.source)) do continue\n      for row in matching do\n        if within : source.contains row.source = true then found := found.push ⟨offer,source,target,row,within⟩\n  return found\n\ntheorem Located.same_subject (located : Located) :\n    located.source.subject = located.row.source.subject := by\n  have within := located.within\n  simp only [Range.contains, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at within\n  exact within.1.1\n\nstructure LocatedOutput (doc : Extraction.Document) where\n  offer : Offer\n  fragment : ObservationContext.Fragment doc\n  target : offer.target = .output fragment.occurrence\n\ndef locateOutputsUsing (offers : Array Offer) (database : String)\n    (prepared : ObservationContext.Prepared doc) : Array (LocatedOutput doc) :=\n  offers.filterMap fun offer => do\n    let .output _ := offer.target | none\n    let .consumed edge := offer.fact | none\n    let fragment ← prepared.locate? database edge\n    if target : offer.target = .output fragment.occurrence then some ⟨offer,fragment,target⟩ else none\n\ndef locateOutputs (offers : Array Offer) (database : String) (doc : Extraction.Document) : Array (LocatedOutput doc) :=\n  (ObservationContext.prepare? doc).map (locateOutputsUsing offers database) |>.getD #[]\n\nend Eggshell.Synapses.Recommend\n",[["SynapseRecommend.lean","module\n\npublic import Eggshell.SynapseIndex\npublic import Eggshell.SynapseUsage\npublic import Eggshell.ObservationContext\npublic import Eggshell.CanonicalSourceCache\npublic import Eggshell.CanonicalSourceDelivery\npublic import Eggshell.PublicationClient\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Recommend\nopen Lean DB\n\ndef implementation : String := Blake3.hex (Blake3.digest \"eggshell.observation-recommendation\".toUTF8 [\n  (include_str \"SynapseRecommend.lean\").toUTF8,(include_str \"ObservationContext.lean\").toUTF8,\n  (include_str \"SynapticCause.lean\").toUTF8,\n  (include_str \"JsonScalars.lean\").toUTF8,(include_str \"SynapseTransport.lean\").toUTF8,\n  (include_str \"SynapseUsage.lean\").toUTF8,(include_str \"SynapticTransport.lean\").toUTF8,\n  (include_str \"SynapticRoutingStore.lean\").toUTF8])\n\nstructure Offer where\n  target : Target\n  priority : Nat\n  fact : Fact\n  identity : String\n  identity_exact : identity = Index.contentKey fact\n  valid : fact.valid = true\n  witness : carries fact target = true\n\ndef Offer.check? (target : Target) (priority : Nat) (fact : Fact)\n    (identity : {value : String // value = Index.contentKey fact}) : Option Offer :=\n  if valid : fact.valid = true then\n    if witness : carries fact target = true then\n      some ⟨target, priority, fact, identity.val, identity.property, valid, witness⟩ else none\n  else none\n\ntheorem Offer.consumption_row (offer : Offer) (edge : Consumption) (kind : offer.fact = .consumed edge)\n    (source : Range) (target : offer.target = .range source) : source ∈ edge.rows := by\n  have witness := offer.witness\n  rw [kind,target] at witness\n  exact Array.mem_of_contains_eq_true witness\n\ntheorem Offer.usage_is_evidence (offer : Offer) (usage : Usage) (kind : offer.fact = .used usage) :\n    (usage.kind = .omittedThenRead ∨ usage.kind = .omittedThenConsumed) ∨ usage.kind = .deliveredThenCited := by\n  have witness := offer.witness\n  cases target : offer.target <;> simp_all [carries, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq]\n\ntheorem Offer.output_has_producer (offer : Offer) (producer : Occurrence)\n    (target : offer.target = .output producer) :\n    ∃ edge, offer.fact = .consumed edge ∧ edge.producer = producer := by\n  have witness := offer.witness\n  cases kind : offer.fact <;> simp_all [carries,beq_iff_eq]\n\ndef Offer.kind (offer : Offer) : String := match offer.fact with\n  | .supports _ => \"support\"\n  | .consumed _ => \"consumption\"\n  | .coquoted _ _ => \"coquotation\"\n  | .used usage => usage.kind.label\n  | .read _ => \"unavailable\"\n\ndef Offer.json (offer : Offer) : Json := Json.mkObj [\n  (\"target\", toJson offer.target), (\"source\", toJson offer.target.source?), (\"priority\", toJson offer.priority),\n  (\"kind\", toJson offer.kind), (\"evidence\", toJson offer.identity)]\n\nstructure Limits where\n  requests : Nat := 256\n  facts : Nat := 8192\n  bytes : Nat := 8*1024*1024\n\nstructure Task where\n  key : Index.Key\n  priority : Nat\n\nstructure Result where\n  offers : Array Offer := #[]\n  requests : Nat := 0\n  facts : Nat := 0\n  bytes : Nat := 0\n  complete : Bool := true\n  available : Bool := true\n  index : Option PageMap.Head := none\n  usage : Option PageMap.Head := none\n  failure : Option String := none\n\n/-- A partial walk never changes the original packet. Its receipt still\nreports incompleteness rather than presenting an empty successful search. -/\ndef Result.admitted (result : Result) : Array Offer :=\n  if result.complete && result.available && result.failure.isNone then result.offers else #[]\n\ntheorem Result.incomplete_not_admitted (result : Result) (incomplete : result.complete = false) :\n    result.admitted = #[] := by simp [admitted, incomplete]\n\ntheorem Result.failed_not_admitted (result : Result) (failed : result.failure.isSome = true) :\n    result.admitted = #[] := by\n  cases found : result.failure <;> simp_all [admitted]\n\ndef Result.receipt (result : Result) : Json := Json.mkObj [\n  (\"available\", toJson result.available), (\"complete\", toJson result.complete),\n  -- An exception can occur after successful reads. Do not report those\n  -- interrupted counters as zero observed operations.\n  (\"requests\", if result.failure.isSome then Json.null else toJson result.requests),\n  (\"facts\", if result.failure.isSome then Json.null else toJson result.facts),\n  (\"bytes\", if result.failure.isSome then Json.null else toJson result.bytes),\n  (\"failure\", toJson result.failure),\n  (\"index\", toJson result.index), (\"usage\", toJson result.usage),\n  (\"offers\", toJson (result.admitted.map Offer.json))]\n\ndef Result.stamp (result : Result) : String := Index.contentKey result.receipt\n\ndef addOffer (result : Result) (target : Target) (priority : Nat) (fact : Fact)\n    (identity : {value : String // value = Index.contentKey fact}) : Result :=\n  match Offer.check? target priority fact identity with\n  | none => result\n  | some offer => {result with offers := result.offers.push offer}\n\n/-- Priority is inherited from the original nomination. Coquotation expands\none incidence hop; only reverse consumption is recursive. No score fitting,\nwhole-producer fallback, graph mutation or certification occurs here. -/\ndef collect (shared : Index.Reader) (usage : Option Index.Reader)\n    (answers : Array (String × Nat)) (initial : Array Range) (query : String)\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\n  let database := shared.manifest.source.identity\n  let mut roots := answers.map fun (answer, priority) => ({key := .answer database answer, priority} : Task)\n  roots := roots ++ initial.map (fun source => ⟨.quoted source, 0⟩)\n  roots := roots ++ consumers.map (fun (consumer,priority) => ⟨.consumer consumer,priority⟩)\n  if usage.isSome && digest query then roots := roots.push ⟨.query query, 0⟩\n  roots := roots.qsort fun a b =>\n    if a.priority == b.priority then (toJson a.key).compress < (toJson b.key).compress\n    else a.priority < b.priority\n  let mut nextRoot := 0\n  let mut queue : Array Task := #[]\n  let mut position := 0\n  let mut seen : Array Index.Key := #[]\n  let mut result : Result := {index := some shared.index.head, usage := usage.map (·.index.head)}\n  -- Descendants inherit their root's priority. Exhaust each root's FIFO\n  -- closure before the next root, rather than repeatedly sorting a growing\n  -- fanout. First visitation therefore retains the best nominated priority.\n  repeat\n    if position == queue.size then\n      let some root := roots[nextRoot]? | break\n      nextRoot := nextRoot+1\n      queue := #[root]\n      position := 0\n    let some task := queue[position]? | break\n    position := position+1\n    if (← IO.monoMsNow) ≥ deadline then\n      result := {result with complete := false}\n      break\n    if seen.contains task.key then continue\n    if result.requests ≥ limits.requests || result.facts ≥ limits.facts || result.bytes ≥ limits.bytes ||\n        (← IO.monoMsNow) ≥ deadline then\n      result := {result with complete := false}\n      break\n    seen := seen.push task.key\n    let reader := match task.key with | .query _ => usage.getD shared | _ => shared\n    let found ← reader.lookup task.key (limits.facts-result.facts) deadline (some (limits.bytes-result.bytes))\n    result := {result with\n      requests := result.requests+1\n      facts := result.facts+found.checked.size\n      bytes := result.bytes+found.payloadBytes}\n    if !found.complete then result := {result with complete := false}; break\n    for checked in found.checked do\n      let fact := checked.fact\n      let identity : {value : String // value = Index.contentKey fact} := ⟨Index.contentKey fact, rfl⟩\n      match task.key, fact with\n      | .answer .., .supports support =>\n        result := addOffer result (.range support.source) task.priority fact identity\n        queue := queue.push ⟨.group (.claim support.claim), task.priority⟩\n        queue := queue.push ⟨.consumer support.read.occurrence, task.priority⟩\n        queue := queue.push ⟨.quoted support.source, task.priority⟩\n      | .consumer _, .consumed edge =>\n        if edge.rows.isEmpty then\n          result := addOffer result (.output edge.producer) task.priority fact identity\n        for source in edge.rows do\n          result := addOffer result (.range source) task.priority fact identity\n          queue := queue.push ⟨.quoted source, task.priority⟩\n        queue := queue.push ⟨.consumer edge.producer, task.priority⟩\n      | .quoted _, .coquoted group _ =>\n        queue := queue.push ⟨.group group, task.priority⟩\n      | .group _, .coquoted _ source =>\n        result := addOffer result (.range source) task.priority fact identity\n      | .query _, .used value =>\n        if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed || value.kind == .deliveredThenCited then\n          result := addOffer result (.range value.source) task.priority fact identity\n          queue := queue.push ⟨.quoted value.source, task.priority⟩\n      | _, _ => pure ()\n  -- A checked omission is the more direct observation. Positive citation\n  -- remains useful only where no omission of that same range was observed.\n  let missing := result.offers.foldl (fun ranges offer => match offer.fact with\n    | .used value => if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed then ranges.insert value.source else ranges\n    | _ => ranges) ({} : Std.HashSet Range)\n  return {result with offers := result.offers.filter fun offer => match offer.fact with\n    | .used value => value.kind != .deliveredThenCited || !missing.contains value.source\n    | _ => true}\n\n/-- Pin optional index publications once for both memo identity and planning.\nAn advancing background worker cannot silently change the input mid-request. -/\nstructure Prepared where\n  source : PageMap.Snapshot\n  shared : Option Index.Reader\n  usage : Option Index.Reader\n  failure : Option String := none\n  canonical : Option Plugin.Publication.Client.SourceReference := none\n  canonicalFailure : Option String := none\n\n/-- Read existing authenticated views without selecting a write destination.\nA read-only profile may reuse DB-owned preparation. Private views remain the\nfallback when the shared directory is absent or not readable. -/\ndef readablePrepared? (read : Sidecar.Storage → IO (Option α)) : IO (Option α) := do\n  for storage in [.database,.user] do\n    let found ← try read storage catch error => match error with\n      | .permissionDenied _ _ _ => pure none\n      | _ => throw error\n    if found.isSome then return found\n  return none\n\ndef prepare (source : PageMap.Snapshot) (deadline : Option Nat := none) : IO Prepared := do\n  try\n    let readDeadline := deadline.getD ((← IO.monoMsNow)+5000)\n    let (canonical,canonicalFailure) ← try\n      let prepared ← readablePrepared? fun storage => Plugin.Publication.Client.prepareSource source storage\n        readDeadline\n      pure (prepared,if prepared.isNone then some \"canonical-not-ready\" else none)\n      catch error => pure (none,some s!\"canonical-open: {error}\")\n    return {\n      source := source,shared := ← readablePrepared? fun storage => Index.open? source storage .shared\n      usage := ← Index.open? source .user .usage,canonical,canonicalFailure}\n  catch error => return {\n    source := source,shared := none,usage := none,failure := some s!\"index-open: {error}\"}\n\ndef Prepared.identity (prepared : Prepared) : Json :=\n  toJson (implementation,prepared.source.head.identity, prepared.source.head.authority,\n    prepared.shared.map (·.index.head), prepared.usage.map (·.index.head), prepared.failure,\n    prepared.canonical.map (·.identity),prepared.canonicalFailure,CanonicalSource.Delivery.implementation)\n\ndef Prepared.collect (prepared : Prepared) (answers : Array (String × Nat)) (query : String)\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\n  if prepared.failure.isSome then return {complete := false, available := false, failure := prepared.failure}\n  let some shared := prepared.shared | return {available := false}\n  try _root_.Eggshell.Synapses.Recommend.collect shared prepared.usage answers #[] query deadline limits consumers\n  catch error => return {\n    complete := false, index := some shared.index.head, usage := prepared.usage.map (·.index.head)\n    failure := some s!\"index-read: {error}\"}\n\n/-- Locate a recommendation only inside an already hydrated original owner.\nFingerprint/range matching never creates a new owner or a control Match. -/\nstructure Located where\n  offer : Offer\n  source : Range\n  target : offer.target = .range source\n  row : Read\n  within : source.contains row.source = true\n\ndef locate (offers : Array Offer) (rows : Array Read) : Array Located := Id.run do\n  let mut found := #[]\n  for offer in offers do\n    let .range source := offer.target | continue\n    if target : offer.target = .range source then\n      let matching := rows.filter (source.contains ·.source)\n      unless covered source (matching.map (·.source)) do continue\n      for row in matching do\n        if within : source.contains row.source = true then found := found.push ⟨offer,source,target,row,within⟩\n  return found\n\ntheorem Located.same_subject (located : Located) :\n    located.source.subject = located.row.source.subject := by\n  have within := located.within\n  simp only [Range.contains, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at within\n  exact within.1.1\n\nstructure LocatedOutput (doc : Extraction.Document) where\n  offer : Offer\n  fragment : ObservationContext.Fragment doc\n  target : offer.target = .output fragment.occurrence\n\ndef locateOutputsUsing (offers : Array Offer) (database : String)\n    (prepared : ObservationContext.Prepared doc) : Array (LocatedOutput doc) :=\n  offers.filterMap fun offer => do\n    let .output _ := offer.target | none\n    let .consumed edge := offer.fact | none\n    let fragment ← prepared.locate? database edge\n    if target : offer.target = .output fragment.occurrence then some ⟨offer,fragment,target⟩ else none\n\ndef locateOutputs (offers : Array Offer) (database : String) (doc : Extraction.Document) : Array (LocatedOutput doc) :=\n  (ObservationContext.prepare? doc).map (locateOutputsUsing offers database) |>.getD #[]\n\nend Eggshell.Synapses.Recommend\n"],["ObservationContext.lean","module\n\npublic import Eggshell.SynapseSource\npublic import Eggshell.Sha256\npublic import Eggshell.SynapseQuotes\npublic import tools.LiteralSearch\npublic import Eggshell.QuotationContext\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.ObservationContext\nopen Lean Extraction\n\n/-- Plain text keeps its actual row. Structured data uses checked scalar\nmembers and ancestor paths, rather than copying the enclosing object. -/\ndef lineBounds (lines : Array TextLine) (first limit : Nat) : Nat × Nat := Id.run do\n  let mut lower := 0\n  let mut upper := lines.size\n  while lower < upper do\n    let middle := (lower+upper)/2\n    let some line := lines[middle]? | return (first,limit)\n    if line.limit < limit then lower := middle+1 else upper := middle\n  match lines[lower]? with\n  | some line => if line.first ≤ first && limit ≤ line.limit then (line.first,line.limit) else (first,limit)\n  | none => (first,limit)\n\ndef originalSubject (work raw : String) : Original := ⟨work,Sha256.hex raw.toUTF8,raw.length⟩\n\n/-- The original identity requires hashing once, not JSON/command parsing.\nThe same pinned native observation can then bind any valid stored interval. -/\nstructure OriginalOwner (doc : Document) where\n  raw : String\n  original : doc.source = some raw\n  identity : Original\n  identityExact : identity = originalSubject doc.work raw\n  native : doc.native = true\n\ndef OriginalOwner.prepare? (doc : Document) : Option (OriginalOwner doc) := do\n  let raw ← doc.source\n  if original : doc.source = some raw then\n    if native : doc.native = true then some ⟨raw,original,originalSubject doc.work raw,rfl,native⟩ else none\n  else none\n\nstructure OriginalOwner.Bound (owner : OriginalOwner doc) (database : String) (source : Range) where\n  read : Read\n  valid : read.valid = true\n  sourceExact : read.source = source\n  databaseExact : read.binding.database = database\n  ownerExact : read.binding.owner = doc.owner\n  workExact : read.binding.work = doc.work\n  nativeOrigin : doc.occurrences.contains read.occurrence = true\n  sourceIdentity : source.subject = .original owner.identity\n  withinOriginal : read.binding.limit ≤ owner.raw.length\n  firstExact : read.binding.first = source.first-1\n  limitExact : read.binding.limit = source.last\n\ndef OriginalOwner.bind (owner : OriginalOwner doc) (database : String) (source : Range) :\n    Array (owner.Bound database source) := Id.run do\n  if sourceIdentity : source.subject = .original owner.identity then\n    if sourceValid : source.valid = true then\n      have inBounds : source.last ≤ owner.raw.length := by\n        have checked := sourceValid\n        simp only [Range.valid,sourceIdentity,Bool.and_eq_true,decide_eq_true_eq] at checked\n        simpa [owner.identityExact,originalSubject] using checked.2\n      let mut result := #[]\n      for occurrence in doc.occurrences do\n        let read : Read := ⟨occurrence,source,⟨database,doc.owner,doc.work,source.first-1,source.last⟩,#[]⟩\n        if valid : read.valid = true then\n          if origin : doc.occurrences.contains occurrence = true then\n            result := result.push ⟨read,valid,rfl,rfl,rfl,rfl,origin,sourceIdentity,inBounds,rfl,rfl⟩\n      return result\n    else return #[]\n  else return #[]\n\ntheorem OriginalOwner.Bound.same_native_owner {doc : Document} {owner : OriginalOwner doc}\n    {database : String} {source : Range} (bound : owner.Bound database source) :\n    bound.read.binding.owner = doc.owner ∧ bound.read.binding.work = doc.work ∧\n      doc.occurrences.contains bound.read.occurrence = true :=\n  ⟨bound.ownerExact,bound.workExact,bound.nativeOrigin⟩\n\ntheorem OriginalOwner.Bound.same_requested_range {doc : Document} {owner : OriginalOwner doc}\n    {database : String} {source : Range} (bound : owner.Bound database source) :\n    bound.read.source = source ∧ bound.read.binding.first = source.first-1 ∧\n      bound.read.binding.limit = source.last := ⟨bound.sourceExact,bound.firstExact,bound.limitExact⟩\n\nstructure Prepared (doc : Document) where\n  raw : String\n  original : doc.source = some raw\n  view : Layout\n  mapped : layout raw = .ok view\n  rawChars : Array Char\n  rawCharsExact : rawChars = raw.toList.toArray\n  viewChars : Array Char\n  viewCharsExact : viewChars = view.text.toList.toArray\n  lines : Array TextLine\n  identity : Original\n  identityExact : identity = originalSubject doc.work raw\n  json : Option (JsonScalars.Index raw)\n\ndef prepare? (doc : Document) : Option (Prepared doc) := do\n  let raw ← doc.source\n  if original : doc.source = some raw then\n    match mapped : layout raw with\n    | .error _ => none\n    | .ok view => some ⟨raw,original,view,mapped,raw.toList.toArray,rfl,\n        view.text.toList.toArray,rfl,textLines view.text,originalSubject doc.work raw,rfl,JsonScalars.prepare? raw⟩\n  else none\n\ndef Prepared.rawBounds (prepared : Prepared doc) (edge : Consumption) :\n    Option (Nat × Nat × JsonScalars.Address prepared.raw) := do\n  let index ← prepared.json\n  let address ← index.witness? edge.outputFirst edge.outputLimit\n  let scalar := address.leaf.scalar\n  if edge.kind == .value then\n    if edge.outputFirst != scalar.first || edge.outputLimit != scalar.limit then none\n    else some (scalar.contextFirst,scalar.limit,address)\n  else if let some text := scalar.text then\n    if text.contains '\\n' then do\n      let first ← scalar.offsets.findIdx? (· == edge.outputFirst)\n      let limit ← scalar.offsets.findIdx? (· == edge.outputLimit)\n      let (first,limit) := lineBounds (textLines text) first limit\n      let first ← scalar.offsets[first]?\n      let limit ← scalar.offsets[limit]?\n      some (first,limit,address)\n    else some (scalar.contextFirst,scalar.limit,address)\n  else some (scalar.contextFirst,scalar.limit,address)\n\nstructure Fragment (doc : Document) where\n  occurrence : Occurrence\n  binding : Binding\n  raw : String\n  payload : String\n  address : Option (JsonScalars.Address raw)\n  native : doc.native = true\n  origin : doc.occurrences.contains occurrence = true\n  original : doc.source = some raw\n  owner : binding.owner = doc.owner\n  work : binding.work = doc.work\n  valid : binding.valid = true\n  within : binding.first < binding.limit ∧ binding.limit ≤ raw.length\n  exact : payload = String.ofList ((raw.toList.drop binding.first).take (binding.limit-binding.first))\n\n/-- Resolve only an actual producer and a literal saved output witness. Source\nfiles, shell syntax and line numbers are not prerequisites. -/\ndef Prepared.locate? (prepared : Prepared doc) (database : String) (edge : Consumption) : Option (Fragment doc) := do\n  if native : doc.native = true then\n    if origin : doc.occurrences.contains edge.producer = true then\n        let raw := prepared.raw\n        let view := if edge.outputFormat == .json then prepared.rawChars else prepared.viewChars\n        if !(literal view edge.outputFirst edge.outputLimit edge.term) then none else do\n          let (first,limit,address) ← if edge.outputFormat == .json then do\n              let (first,limit,address) ← prepared.rawBounds edge\n              if first ≤ edge.outputFirst && edge.outputLimit ≤ limit then some (first,limit,some address) else none\n            else do\n              let (first,limit) := lineBounds prepared.lines edge.outputFirst edge.outputLimit\n              if !(first ≤ edge.outputFirst && edge.outputLimit ≤ limit) then none else do\n                let first ← prepared.view.offsets[first]?\n                let limit ← prepared.view.offsets[limit]?\n                some (first,limit,prepared.json.bind (·.cover? first limit))\n          do\n            let binding : Binding := ⟨database,doc.owner,doc.work,first,limit⟩\n            if valid : binding.valid = true then\n              if bounded : binding.first < binding.limit ∧ binding.limit ≤ prepared.rawChars.size then\n                have size : prepared.rawChars.size = raw.length := by\n                  simp [prepared.rawCharsExact,raw,String.length_toList]\n                have within : binding.first < binding.limit ∧ binding.limit ≤ raw.length := by\n                  simpa only [size] using bounded\n                let payload := String.ofList (prepared.rawChars.extract binding.first binding.limit).toList\n                have exact : payload = String.ofList ((raw.toList.drop binding.first).take (binding.limit-binding.first)) := by\n                  simp [payload,prepared.rawCharsExact,raw]\n                some ⟨edge.producer,binding,raw,\n                  payload,address,native,origin,prepared.original,rfl,rfl,valid,within,exact⟩\n              else none\n            else none\n    else none\n  else none\n\ndef locate? (database : String) (doc : Document) (edge : Consumption) : Option (Fragment doc) := do\n  let prepared ← prepare? doc\n  prepared.locate? database edge\n\ntheorem fragment_is_original (fragment : Fragment doc) :\n    doc.source = some fragment.raw ∧\n    fragment.payload = String.ofList ((fragment.raw.toList.drop fragment.binding.first).take\n      (fragment.binding.limit-fragment.binding.first)) := ⟨fragment.original,fragment.exact⟩\n\ntheorem fragment_has_native_origin (fragment : Fragment doc) :\n    doc.native = true ∧ doc.occurrences.contains fragment.occurrence = true :=\n  ⟨fragment.native,fragment.origin⟩\n\n/-- Canonical data is independent of the occurrence that observed it. The\nactual origin remains in the binding and can never certify another Work. -/\ndef Fragment.read? (fragment : Fragment doc) : Option {read : Read // read.valid = true} :=\n  let source := Range.original (originalSubject fragment.binding.work fragment.raw)\n    fragment.binding.first fragment.binding.limit\n  let read : Read := {occurrence := fragment.occurrence,source,binding := fragment.binding}\n  if valid : read.valid = true then some ⟨read,valid⟩ else none\n\n/-- Resolve a stored canonical interval only against the same complete\nWork/output snapshot, then attach this observation's own native origin. -/\ndef Prepared.bindSource? (prepared : Prepared doc) (database : String) (source : Range) : Option Read := do\n  let .original original := source.subject | none\n  if !doc.native || original != prepared.identity || !source.valid then none else do\n    let occurrence ← doc.occurrences[0]?\n    let read : Read := {occurrence,source,binding := ⟨database,doc.owner,doc.work,source.first-1,source.last⟩}\n    if read.valid then some read else none\n\ndef bindSource? (database : String) (doc : Document) (source : Range) : Option Read := do\n  let prepared ← prepare? doc\n  prepared.bindSource? database source\n\n/-- Transient spellings are hydrated from the original owner. Only their\ndigests travel with a persisted Read; hash lookup alone never creates support. -/\nstructure Quotation where\n  read : Read\n  text : String\n  mapping : Option (Sigma fun source : QuotationContext.Source => QuotationContext.Projection source text) := none\n  anchor : Option (Nat × Nat) := none\n\ndef Prepared.quotationSource (prepared : Prepared doc) : QuotationContext.Source :=\n  ⟨prepared.raw,prepared.rawChars,prepared.rawCharsExact,prepared.identity.content,by\n    simpa [originalSubject] using congrArg Original.content prepared.identityExact⟩\n\ndef Quotation.prepare (source : QuotationContext.Source) (read : Read)\n    (first limit : Nat) (text : String) : Quotation :=\n  ⟨read,text,(QuotationContext.prepare? source first limit text).map (fun projection => ⟨source,projection⟩),none⟩\n\nstructure QuotationWitness (parent : Read) where\n  read : Read\n  first : Nat\n  limit : Nat\n  valid : read.valid = true\n  sourceWithin : parent.source.contains read.source = true\n  bindingWithin : parent.binding.first ≤ read.binding.first ∧ read.binding.limit ≤ parent.binding.limit\n  origin : read.occurrence = parent.occurrence ∧ read.binding.database = parent.binding.database ∧\n    read.binding.owner = parent.binding.owner ∧ read.binding.work = parent.binding.work\n\ndef Quotation.locate? (item : Quotation) (first limit : Nat) : Option (QuotationWitness item.read) := do\n  let ⟨source,projection⟩ ← item.mapping\n  let located ← projection.locate? first limit\n  let a := if projection.multiline then located.contextFirst else item.read.binding.first\n  let b := if projection.multiline then located.contextLimit else item.read.binding.limit\n  if !(a ≤ located.first && located.limit ≤ b && b ≤ source.characters.size) then none else do\n    let target ← match item.read.source.subject with\n      | .file _ => some item.read.source\n      | .original original =>\n        if original.content == source.fingerprint && original.chars == source.characters.size then\n          some (Range.original original a b) else none\n    let read : Read := {item.read with\n      source := target,binding := {item.read.binding with first := a,limit := b}\n      quotations := #[Quotes.digest (String.ofList (projection.characters.extract first limit).toList)]}\n    if valid : read.valid = true then\n      if inside : item.read.source.contains read.source = true then\n        if bounds : item.read.binding.first ≤ read.binding.first ∧ read.binding.limit ≤ item.read.binding.limit then\n          some ⟨read,located.first,located.limit,valid,inside,bounds,by exact ⟨rfl,rfl,rfl,rfl⟩⟩\n        else none\n      else none\n    else none\n\ntheorem quotation_witness_preserves_origin {read : Read} (witness : QuotationWitness read) :\n    witness.read.occurrence = read.occurrence ∧ witness.read.binding.database = read.binding.database ∧\n      witness.read.binding.owner = read.binding.owner ∧ witness.read.binding.work = read.binding.work := witness.origin\n\n/-- Scan the actual reachable record spellings for all of an answer's literal\nquotes together. A matching identifier may occur inside a row/member; it need\nnot equal the entire enclosing record. Duplicate aliases do not multiply a\nread's support. These are advisory citations, never execution certificates. -/\ndef quoteMatches (index : LiteralSearch.Index patterns) (spellings : Array Quotation) : Array Quotation := Id.run do\n  let mut seen : Std.HashMap (Occurrence × String × String × String × Nat × Nat × String) Nat := {}\n  let mut result := #[]\n  for item in spellings do\n    for hit in LiteralSearch.first index item.text do\n      let text := patterns[hit.pattern]\n      let witness := item.locate? hit.first hit.limit\n      let read := witness.map (·.read) |>.getD item.read\n      let anchor := witness.map (fun found => (found.first,found.limit))\n      let first := anchor.map Prod.fst |>.getD read.binding.first\n      let limit := anchor.map Prod.snd |>.getD read.binding.limit\n      let key := (read.occurrence,read.binding.database,read.binding.owner,read.binding.work,first,limit,text)\n      let next : Quotation := ⟨read,text,none,anchor⟩\n      if let some previous := seen[key]? then\n        let some prior := result[previous]? | continue\n        let width := read.binding.limit-read.binding.first\n        let oldWidth := prior.read.binding.limit-prior.read.binding.first\n        if width < oldWidth || (width == oldWidth && read.source.file?.isSome && prior.read.source.file?.isNone) then\n          result := result.set! previous next\n      else\n        seen := seen.insert key result.size\n        result := result.push next\n  return result\n\nstructure Catalog where\n  located : Array LocatedRead := #[]\n  quotations : Array Quotation := #[]\n\ndef Catalog.reads (catalog : Catalog) : Array Read := catalog.located.map (·.read)\n\n/-- Certified source rows have disjoint original intervals. Search their\nsorted limits once, instead of scanning the growing native catalog per row. -/\ndef fileCovers (rows : Array Read) (first limit : Nat) : Bool := Id.run do\n  let mut lower := 0\n  let mut upper := rows.size\n  while lower < upper do\n    let middle := (lower+upper)/2\n    let some row := rows[middle]? | return false\n    if row.binding.limit < limit then lower := middle+1 else upper := middle\n  return (rows[lower]?).any (fun row => row.binding.first ≤ first && limit ≤ row.binding.limit)\n\ndef Catalog.add (catalog : Catalog) (prepared : Prepared doc) (database : String)\n    (files : Array Read) (first limit : Nat) (spellings : Array String) : Catalog := Id.run do\n  if !doc.native || first ≥ limit || limit > prepared.rawChars.size then return catalog\n  -- Preserve an existing certified file row instead of giving it a second,\n  -- larger native identity. General data never requires such certification.\n  if fileCovers files first limit then return catalog\n  let some occurrence := doc.occurrences[0]? | return catalog\n  let spellings := spellings.filter (!·.isEmpty) |>.toList.eraseDups.toArray\n  let read : Read := {\n    occurrence,source := Range.original prepared.identity first limit\n    binding := ⟨database,doc.owner,doc.work,first,limit⟩\n    quotations := spellings.map Quotes.digest |>.toList.eraseDups.toArray}\n  if !read.valid then return catalog\n  let payload := String.ofList (prepared.rawChars.extract first limit).toList\n  return {\n    located := catalog.located.push ⟨read,#[⟨read.source,first,limit⟩],#[read],payload⟩\n    quotations := catalog.quotations ++ spellings.map (fun text =>\n      Quotation.prepare prepared.quotationSource read first limit text)}\n\n/-- Enumerate source members/rows once during indexing, independently of tool\nnames, command syntax and the presence of files. The immutable subject hash,\nJSON scan and character arrays are shared across all these spans. -/\ndef Prepared.catalog (prepared : Prepared doc) (database : String) : Catalog := Id.run do\n  let mut catalog : Catalog := {located := (recordedReads database doc).toOption.getD #[]}\n  let files := (catalog.located.flatMap (·.originalRows)).qsort (fun a b => a.binding.limit < b.binding.limit)\n  if let some index := prepared.json then\n    for leaf in index.leaves do\n      let scalar := leaf.scalar\n      let member := String.ofList (prepared.rawChars.extract scalar.contextFirst scalar.limit).toList\n      let aliases := #[scalar.literal,member] ++ scalar.text.toArray\n      catalog := catalog.add prepared database files scalar.contextFirst scalar.limit aliases\n      if let some text := scalar.text then\n        if text.contains '\\n' then\n          for line in textLines text do\n            let some first := scalar.offsets[line.first]? | continue\n            let some limit := scalar.offsets[line.limit]? | continue\n            let raw := String.ofList (prepared.rawChars.extract first limit).toList\n            catalog := catalog.add prepared database files first limit #[line.text,raw]\n    if index.leaves.isEmpty then\n      catalog := catalog.add prepared database files 0 prepared.rawChars.size #[prepared.raw]\n  else\n    for line in textLines prepared.raw do\n      let payload := String.ofList (prepared.rawChars.extract line.first line.limit).toList\n      catalog := catalog.add prepared database files line.first line.limit #[line.text,payload]\n  return catalog\n\ndef recorded (database : String) (doc : Document) : Option Catalog := do\n  return (← prepare? doc).catalog database\n\n/-- File certification remains optional. General rows are located only when\nthe actual completed call has the complete saved invocation and output. -/\ndef locateUsing (database : String) (doc : Document) (trace : Trace)\n    (catalog : Catalog) : Array LocatedRead := Id.run do\n  let mut result := (locateReads database doc trace).toOption.getD #[]\n  let some raw := doc.source | return result\n  let .ok (input,format) := invocationData (doc.workText.getD \"\") | return result\n  let native := catalog.located.filter (·.read.source.file?.isNone)\n  for occurrence in doc.occurrences do\n    let some started := trace.starts[occurrence]? | continue\n    if started.command != input || started.format != format || trace.finished[occurrence]? != some raw then continue\n    for located in native do\n      let read := {located.read with occurrence}\n      result := result.push {located with read,originalRows := #[read]}\n  return result\n\ndef locate (database : String) (doc : Document) (trace : Trace) : Array LocatedRead :=\n  locateUsing database doc trace ((recorded database doc).getD {})\n\n/-- Exact quoted spellings provide advisory support/coquotation. The caller\nrestricts the catalog to the answer's actual All-reachable source owners.\nThis records an observed citation, not the truth or causality of a claim. -/\ndef addQuotedAnswer (database : String) (doc : Document) (spellings : Array Quotation)\n    (graph : Graph) : Except String Graph := do\n  let decoded ← layout (doc.source.getD \"\")\n  let byText := spellings.foldl (fun (map : Std.HashMap String (Array Read)) item =>\n    map.insert item.text (map[item.text]?.getD #[] |>.push item.read)) {}\n  let mut graph := graph\n  let mut position := 0\n  for paragraph in decoded.text.splitOn \"\\n\\n\" do\n    let limit := position+paragraph.length\n    if position < limit then\n      let claim : Claim := ⟨database,doc.owner,decoded.offsets[position]!,decoded.offsets[limit]!⟩\n      for quote in Quotes.extract paragraph do\n        for read in byText[quote.text]?.getD #[] do\n          graph ← graph.insert (.read read)\n          let support ← Support.checked read read.source claim\n          graph ← graph.insert (.supports support)\n          graph ← graph.insert (.coquoted (.claim claim) read.source)\n          graph ← graph.insert (.coquoted (.answer database doc.owner) read.source)\n    position := limit+2\n  return graph\n\nend Eggshell.Synapses.ObservationContext\n"],["SynapticCause.lean","module\npublic import Eggshell.SynapticRoutingStore\n@[expose] public section\n\nnamespace Eggshell.Synapses.Cause\nopen Lean Recommend Routing.Store\n\n/-- Relation meaning survives coordinate projection. Coquotation associates\nrecords; it does not state that all coquoted records are prerequisites. -/\ninductive Role where\n  | support | consumption | association | omittedRead | omittedConsumed | cited\n  deriving Inhabited, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Role.joint : Role → Bool\n  | .support | .consumption => true\n  | _ => false\n\ndef Role.label : Role → String\n  | .support => \"support\" | .consumption => \"consumption\" | .association => \"coquotation\"\n  | .omittedRead => \"omitted_then_read\" | .omittedConsumed => \"omitted_then_consumed\"\n  | .cited => \"delivered_then_cited\"\n\ndef role? : Nat → Option Role\n  | 0 => some .support | 1 => some .consumption | 2 => some .association\n  | 3 => some .omittedRead | 4 => some .omittedConsumed | 5 => some .cited | _ => none\n\ninductive Origin where\n  | group (group : Group)\n  | fact (evidence : String)\n  deriving DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\nstructure Reason where\n  database : String\n  role : Role\n  origin : Origin\n  deriving DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\n/-- A dependency is grouped by its original reason; an association or use\nevent retains its own source. Neither key depends on its display binding. -/\nstructure Key where\n  reason : Reason\n  independentSource : Option Range\n  deriving DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef key? (database : String) (hint : Hint) : Option Key := do\n  let role ← role? hint.kind\n  if database.isEmpty || !digest hint.evidence then none else do\n    if role == .support then\n      let some (.claim claim) := hint.group | none\n      if claim.database != database then none else pure ()\n    if role == .association then\n      let some group := hint.group | none\n      let scope := match group with | .claim claim => claim.database | .answer scope _ => scope\n      if scope != database then none else pure ()\n    let source ← if role.joint then some none else hint.target.source?.map some\n    let origin := hint.group.map Origin.group |>.getD (.fact hint.evidence)\n    return ⟨⟨database,role,origin⟩,source⟩\n\ndef Key.identity (key : Key) : String := Index.contentKey key\ndef Key.joint (key : Key) : Bool := key.reason.role.joint\n\ndef outputKey (database evidence : String) : Key :=\n  ⟨⟨database,.consumption,.fact evidence⟩,none⟩\n\nstructure ScopedHint where\n  database : String\n  hint : Hint\n\nstructure Demand where\n  reason : Key\n  key : String\n  keyExact : key = reason.identity\n  sources : Array Range\n  priority : Nat\n  witnesses : Array String\n\ndef Demand.kind (demand : Demand) : String := demand.reason.reason.role.label\n\n/-- Output-only witnesses are bound separately to complete native fragments.\nRange requests include unavailable targets: binding cannot shrink a demand\nby silently discarding a source that failed to locate. -/\ndef demands (inputs : Array ScopedHint) : Array Demand := Id.run do\n  let mut groups : Std.HashMap Key (List (Range × Nat × String)) := {}\n  for input in inputs do\n    let some key := key? input.database input.hint | continue\n    let some source := input.hint.target.source? | continue\n    groups := groups.insert key ((source,input.hint.priority,input.hint.evidence) :: (groups[key]?.getD []))\n  return (groups.toArray.map fun (reason,backward) =>\n    let rows := backward.reverse\n    let sources := rows.map (·.1) |>.eraseDups.toArray\n    let priority := rows.foldl (fun best row => min best row.2.1) ((rows.head?.map (·.2.1)).getD 0)\n    ⟨reason,reason.identity,rfl,sources,priority,(rows.map (·.2.2)).eraseDups.toArray⟩).qsort fun a b =>\n      if a.priority == b.priority then a.key < b.key else a.priority < b.priority\n\n/-- A recorded reason is credited only with its complete requested evidence.\nThis is a recommendation contract, not a claim of semantic necessity. -/\ndef Demand.credited (demand : Demand) (covered : Range → Bool) : Bool :=\n  !demand.sources.isEmpty && demand.sources.all covered\n\ntheorem credited_requires_all (demand : Demand) (covered : Range → Bool)\n    (credit : demand.credited covered = true) (source : Range) (member : source ∈ demand.sources) :\n    covered source = true := by\n  exact (Array.all_eq_true'.mp (Bool.and_eq_true_iff.mp credit).2) source member\n\ntheorem credited_binding_invariant (demand : Demand) (raw file : Range → Bool)\n    (same : ∀ source ∈ demand.sources, raw source = file source) :\n    demand.credited raw = demand.credited file := by\n  have sameAll : demand.sources.all raw = demand.sources.all file := by\n    have truths : demand.sources.all raw = true ↔ demand.sources.all file = true := by\n      constructor\n      · intro accepted\n        apply Array.all_eq_true'.mpr\n        intro source member\n        rw [← same source member]\n        exact Array.all_eq_true'.mp accepted source member\n      · intro accepted\n        apply Array.all_eq_true'.mpr\n        intro source member\n        rw [same source member]\n        exact Array.all_eq_true'.mp accepted source member\n    cases rawResult : demand.sources.all raw <;>\n      cases fileResult : demand.sources.all file <;> simp_all\n  simp only [Demand.credited,sameAll]\n\ndef admits (causes : List Key) (reason : Key) (complete : Bool) : Bool :=\n  causes.contains reason && complete\n\ntheorem admitted_requires_same_reason (causes : List Key) (reason : Key) (complete : Bool)\n    (accepted : admits causes reason complete = true) : reason ∈ causes := by\n  exact List.contains_iff_mem.mp (Bool.and_eq_true_iff.mp accepted).1\n\ntheorem admitted_requires_completion (causes : List Key) (reason : Key) (complete : Bool)\n    (accepted : admits causes reason complete = true) : complete = true :=\n  (Bool.and_eq_true_iff.mp accepted).2\n\ntheorem association_is_independent : Role.joint .association = false := rfl\ntheorem omissions_do_not_imply_joint_dependencies :\n    Role.joint .omittedRead = false ∧ Role.joint .omittedConsumed = false := by decide\n\nstructure Projection where\n  cause : Key\n  first : Nat\n  limit : Nat\n\ndef Projection.rebind (projection : Projection) (first limit : Nat) : Projection :=\n  {projection with first,limit}\n\ntheorem projection_preserves_cause (projection : Projection) (first limit : Nat) :\n    (projection.rebind first limit).cause = projection.cause := rfl\n\nend Eggshell.Synapses.Cause\n"],["JsonScalars.lean","module\n\npublic import Lean.Data.Json.Parser\npublic import Lean.Data.Json.FromToJson\n\n@[expose] public section\n\nnamespace Eggshell.JsonScalars\nopen Lean\n\ninductive Segment where\n  | key (name : String)\n  | index (position : Nat)\n  deriving DecidableEq, BEq, ToJson, FromJson\n\ndef pathJson (path : List Segment) : Json :=\n  toJson (path.map fun part => match part with\n    | .key name => toJson name | .index position => toJson position)\n\ndef resolve (value : Json) : List Segment → Except String Json\n  | [] => .ok value\n  | .key name :: rest => do resolve (← value.getObjVal? name) rest\n  | .index position :: rest => do resolve (← value.getArrVal? position) rest\n\nstructure Scalar where\n  first : Nat\n  limit : Nat\n  literal : String\n  text : Option String\n  offsets : Array Nat\n  /-- Reversed paths share their ancestors instead of copying every prefix. -/\n  pathRev : List Segment\n  contextFirst : Nat\n\nstructure Frame where\n  object : Bool\n  pathRev : List Segment\n  next : Nat := 0\n  key : Option (String × Nat) := none\n\ndef place (frames : Array Frame) (first : Nat) :\n    Except String (List Segment × Nat × Array Frame) := do\n  let some frame := frames.back? | return ([],first,frames)\n  if frame.object then\n    let some (key,start) := frame.key | throw \"structured object has no pending key\"\n    return (.key key :: frame.pathRev,start,frames.pop.push {frame with key := none})\n  else\n    return (.index frame.next :: frame.pathRev,first,\n      frames.pop.push {frame with next := frame.next+1})\n\ndef primitive : Json → Bool\n  | .arr _ | .obj _ => false\n  | _ => true\n\ndef scalarLiteral (text : String) : Bool :=\n  (Json.parse text).toOption.any fun value => primitive value && value.compress == text\n\n/-- One canonical scan records literal coordinates, immediate member starts\nand shared ancestor paths. Keys provide context but never become witnesses. -/\ndef scan (json : Json) (raw : String) : Except String (Array Scalar) := do\n  unless json.compress == raw do throw \"noncanonical structured observation\"\n  let chars := raw.toList.toArray\n  let mut position := 0\n  let mut result := #[]\n  let mut frames : Array Frame := #[]\n  while position < chars.size do\n    let char := chars[position]!\n    if char == '{' || char == '[' then\n      let (path,_,next) ← place frames position\n      frames := next.push {object := char == '{',pathRev := path}\n      position := position+1\n    else if char == '}' || char == ']' then\n      frames := frames.pop\n      position := position+1\n    else if char.isWhitespace || \",:\".contains char then\n      position := position+1\n    else if char == '\"' then\n      let first := position\n      position := position+1\n      let mut escaped := false\n      let mut closed := false\n      while position < chars.size do\n        let char := chars[position]!\n        position := position+1\n        if escaped then escaped := false\n        else if char == '\\\\' then escaped := true\n        else if char == '\"' then closed := true; break\n      unless closed do throw \"unfinished structured string\"\n      let limit := position\n      let mut following := position\n      while following < chars.size && chars[following]!.isWhitespace do following := following+1\n      let literal := String.ofList (chars.extract first limit).toList\n      let text ← Json.parse literal >>= Json.getStr?\n      if chars[following]? == some ':' then\n        let some frame := frames.back? | throw \"structured key has no object\"\n        unless frame.object && frame.key.isNone do throw \"structured key outside an object\"\n        frames := frames.pop.push {frame with key := some (text,first)}\n        continue\n      let (path,contextFirst,next) ← place frames first\n      frames := next\n      let mut offsets := #[]\n      let mut original := first+1\n      for char in text.toList do\n        offsets := offsets.push original\n        original := original+(toJson (String.singleton char)).compress.length-2\n      offsets := offsets.push original\n      unless original+1 == limit do throw \"structured scalar coordinates differ\"\n      result := result.push ⟨first,limit,literal,some text,offsets,path,contextFirst⟩\n    else\n      let first := position\n      while position < chars.size && !chars[position]!.isWhitespace &&\n          !(\"{}[],:\".contains chars[position]!) do position := position+1\n      let literal := String.ofList (chars.extract first position).toList\n      unless scalarLiteral literal do throw \"invalid structured scalar\"\n      let (path,contextFirst,next) ← place frames first\n      frames := next\n      result := result.push ⟨first,position,literal,none,#[],path,contextFirst⟩\n  return result\n\ndef values (raw : String) : Except String (Array Scalar) := do scan (← Json.parse raw) raw\n\ndef Scalar.prefixExact (scalar : Scalar) (raw : Array Char) : Bool :=\n  match scalar.pathRev.head? with\n  | some (.key name) =>\n      String.ofList (raw.extract scalar.contextFirst scalar.first).toList ==\n        (toJson name).compress ++ \":\"\n  | _ => scalar.contextFirst == scalar.first\n\n/-- A displayed path is independently checked against the parsed original.\nIts member prefix and literal still refer to exact original characters. -/\nstructure Checked (root : Json) (raw : Array Char) where\n  scalar : Scalar\n  value : Json\n  resolved : resolve root scalar.pathRev.reverse = .ok value\n  primitive : primitive value = true\n  spelling : value.compress = scalar.literal\n  bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size\n  exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal\n  memberExact : scalar.prefixExact raw = true\n\ndef Checked.check? (root : Json) (raw : Array Char) (scalar : Scalar) : Option (Checked root raw) :=\n  match resolved : resolve root scalar.pathRev.reverse with\n  | .error _ => none\n  | .ok value =>\n    if primitive : JsonScalars.primitive value = true then\n      if spelling : value.compress = scalar.literal then\n        if bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size then\n          if exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal then\n            if memberExact : scalar.prefixExact raw = true then\n              some ⟨scalar,value,resolved,primitive,spelling,bounds,exact,memberExact⟩ else none\n          else none\n        else none\n      else none\n    else none\n\nstructure Address (raw : String) where\n  root : Json\n  characters : Array Char\n  parsed : Json.parse raw = .ok root\n  charactersExact : characters = raw.toList.toArray\n  leaf : Checked root characters\n\ndef Address.path (address : Address raw) : List Segment := address.leaf.scalar.pathRev.reverse\n\ndef Address.label (address : Address raw) : String := (pathJson address.path).compress\n\ntheorem address_resolves (address : Address raw) :\n    Json.parse raw = .ok address.root ∧ resolve address.root address.path = .ok address.leaf.value :=\n  ⟨address.parsed,address.leaf.resolved⟩\n\ntheorem address_literal_is_original (address : Address raw) :\n    String.ofList (raw.toList.toArray.extract address.leaf.scalar.first address.leaf.scalar.limit).toList =\n      address.leaf.value.compress := by\n  rw [← address.charactersExact,address.leaf.spelling]\n  exact address.leaf.exact\n\nstructure Index (raw : String) where\n  root : Json\n  characters : Array Char\n  parsed : Json.parse raw = .ok root\n  charactersExact : characters = raw.toList.toArray\n  leaves : Array (Checked root characters)\n\ndef prepare? (raw : String) : Option (Index raw) := do\n  match parsed : Json.parse raw with\n  | .error _ => none\n  | .ok root =>\n    let scalars ← (scan root raw).toOption\n    let characters := raw.toList.toArray\n    let leaves ← scalars.mapM (Checked.check? root characters)\n    return ⟨root,characters,parsed,rfl,leaves⟩\n\n/-- Scalar limits are in original serialization order. Search once by the\nlast position; ancestors and field names do not require a linear leaf scan. -/\ndef Index.cover? (index : Index raw) (first limit : Nat) : Option (Address raw) := Id.run do\n  let mut lower := 0\n  let mut upper := index.leaves.size\n  while lower < upper do\n    let middle := (lower+upper)/2\n    let some leaf := index.leaves[middle]? | return none\n    if leaf.scalar.limit < limit then lower := middle+1 else upper := middle\n  let some leaf := index.leaves[lower]? | return none\n  if leaf.scalar.contextFirst ≤ first && first < limit && limit ≤ leaf.scalar.limit then\n    return some ⟨index.root,index.characters,index.parsed,index.charactersExact,leaf⟩\n  return none\n\ndef Index.witness? (index : Index raw) (first limit : Nat) : Option (Address raw) := do\n  let address ← index.cover? first limit\n  if address.leaf.scalar.first ≤ first then some address else none\n\nend Eggshell.JsonScalars\n"],["SynapseTransport.lean","module\n\npublic import Eggshell.SynapticTransport\npublic import tools.KeyPostings\npublic import Eggshell.HashDistinct\npublic import Eggshell.SynapticBindings\npublic import Eggshell.SynapticCause\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Transport\nopen Lean Persistence.Store _root_.Eggshell.Synapses.Extraction Recommend\n\nstructure Owner where\n  database : String\n  original : OutcomeEdge\n  provenance : List SourceEvidence.Record\n\ndef Owner.document (owner : Owner) : Except String Document := do\n  return {\n    owner := Persistence.selectionKey owner.original.relation\n    work := Persistence.selectionKey owner.original.work\n    workText := text? owner.original.work\n    source := text? owner.original.outcome\n    native := owner.original.observations.any\n      (Relation.observesOutcomeWork owner.original.outcome owner.original.work)\n    occurrences := Provenance.identities owner.original\n    files := ← fileMap (owner.provenance.toArray.map toJson) }\n\nstructure LocatedOwner where\n  owner : OutcomeEdge\n  document : Document\n  located : Array Routed.Located\n  outputs : Array (LocatedOutput document)\n  database : String\n\n/-- Hydration and the original identity are prepared once per admitted owner.\nBinding a graph interval does not parse or hash the same body again. -/\nstructure AdmittedOwner where\n  owner : Owner\n  document : Document\n  original : Option (ObservationContext.OriginalOwner document)\n\nstructure Observation where\n  database : String\n  owner : String\n  work : String\n  occurrence : Occurrence\n  age : ObservationAge.Assessment\n  metadataFailure : Option String := none\n  deriving ToJson\n\nstructure Plan where\n  results : Array Routed.Result := #[]\n  causeInputs : Array Cause.ScopedHint := #[]\n  owners : Array LocatedOwner := #[]\n  documents : Array Document := #[]\n  rows : Array Read := #[]\n  unsupported : Nat := 0\n  unlocatedFileOwners : Nat := 0\n  observations : Array Observation := #[]\n  canonical : Std.HashMap String (Array CanonicalSource.StoredRow) := {}\n  canonicalReuse : Array (String × CanonicalSource.Shared.Reuse × CanonicalSource.Shared.Reuse) := #[]\n  canonicalFailure : Array (String × String) := #[]\n  originalStructures : Std.HashMap String ObservedRecordView.Geometry := {}\n  originalCache : Array Json := #[]\n  bindingComplete : Bool := true\n  bindingRequests : Nat := 0\n  bindingBytes : Nat := 0\n  bindingUnresolved : Nat := 0\n\ndef Plan.complete (plan : Plan) : Bool := plan.bindingComplete && plan.results.all (·.complete)\n\n/-- An exact source-posting origin can be attached only to this already\nadmitted owner. Stored offsets are still bounded by its original body and\nthe native occurrence; the index cannot nominate another Work here. -/\ndef boundTo (database : String) (document : Document) (identity : Original) (read : Read) : Bool :=\n  document.native && read.valid && read.binding.database == database &&\n    read.binding.owner == document.owner && read.binding.work == document.work &&\n    document.occurrences.contains read.occurrence && read.binding.limit ≤ identity.chars &&\n    match read.source.subject with\n    | .original original => original == identity\n    | .file file => document.files.contains file\n\ndef Plan.ranges (plan : Plan) : List (Value × List (Nat × Nat × Nat)) :=\n  plan.owners.toList.map fun owner =>\n    (owner.owner.relation, (owner.located.toList.filterMap fun located =>\n      if located.source.file?.isNone then none else some\n      (located.offer.priority, located.row.binding.first, located.row.binding.limit)).eraseDups)\n\nstructure OutputRange where\n  priority : Nat\n  first : Nat\n  limit : Nat\n  path : Option (List JsonScalars.Segment)\n  cause : Cause.Key\n  target : Target\n  deriving BEq\n\nstructure CausalRange where\n  priority : Nat\n  first : Nat\n  limit : Nat\n  cause : Cause.Key\n  deriving DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable\n\ndef Plan.causalRanges (plan : Plan) : List (Value × List CausalRange) :=\n  plan.owners.toList.map fun owner =>\n    let located := owner.located.toList.filterMap fun located => do\n      let cause ← Cause.key? owner.database located.offer\n      some ({\n        priority := located.offer.priority\n        first := located.row.binding.first\n        limit := located.row.binding.limit\n        cause} : CausalRange)\n    let outputs := owner.outputs.toList.map fun located => ({\n      priority := located.offer.priority\n      first := located.fragment.binding.first\n      limit := located.fragment.binding.limit\n      cause := Cause.outputKey owner.database located.offer.identity} : CausalRange)\n    (owner.owner.relation,hashDistinct (located ++ outputs))\n\ndef LocatedOwner.originalRanges (owner : LocatedOwner) : Array (Range × OutputRange) := Id.run do\n  let raw := owner.document.source.getD \"\"\n  let json := JsonScalars.prepare? raw\n  return owner.located.filterMap fun located => do\n    let .original _ := located.source.subject | none\n    let cause ← Cause.key? owner.database located.offer\n    some (located.source,{\n      priority := located.offer.priority\n      first := located.row.binding.first\n      limit := located.row.binding.limit\n      path := (json.bind (·.cover? located.row.binding.first located.row.binding.limit)).map (·.path)\n      cause,target := located.offer.target})\n\ndef Plan.outputRanges (plan : Plan) : List (Value × List OutputRange) := Id.run do\n  let mut originals : Std.HashMap Range (Value × OutputRange) := {}\n  for owner in plan.owners do\n    for (source,range) in owner.originalRanges do\n      if (originals[source]?).all (fun prior => range.priority < prior.2.priority) then\n        originals := originals.insert source (owner.owner.relation,range)\n  return plan.owners.toList.map fun owner =>\n    let shared := originals.toArray.filterMap fun (_,origin,range) =>\n      if origin == owner.owner.relation then some range else none\n    let shared := shared.qsort fun a b => if a.first == b.first then a.limit < b.limit else a.first < b.first\n    (owner.owner.relation, ((owner.outputs.toList.map fun located =>\n      ({priority := located.offer.priority,first := located.fragment.binding.first\n        limit := located.fragment.binding.limit,path := located.fragment.address.map (·.path)\n        cause := Cause.outputKey owner.database located.offer.identity\n        target := located.offer.target} : OutputRange)) ++\n      shared.toList).eraseDups)\n\n/-- Original intervals bind to their immutable native output identity; file\ncoordinates bind through the existing source postings. A graph hint cannot\nnominate a different Work, occurrence or out-of-body interval. -/\ndef build (prepared : Array Recommend.Prepared) (answers : Array (String × Nat))\n    (owners : Array Owner) (query : String) (deadline : Nat)\n    (graphDeadline : Option Nat := none) : IO Plan := do\n  let mut plan : Plan := {}\n  let mut outputWitnesses : Array (String × Array Offer) := #[]\n  let assessedUnixMs ← ObservationAge.now\n  for source in prepared do\n    let consumers := owners.flatMap fun owner =>\n      if owner.database != source.source.head.identity then #[] else\n      let priorities := answers.filterMap fun (key,priority) =>\n        if key == Persistence.selectionKey owner.original.relation then some priority else none\n      (Provenance.identities owner.original).flatMap fun occurrence =>\n        priorities.map fun priority => (occurrence,priority)\n    let result ← Routed.collect source answers query (min deadline (graphDeadline.getD deadline)) consumers\n    let (result,outputs) ← try pure (result,← Routed.outputOffers source result deadline)\n      catch error => pure ({result with complete := false,failure := some s!\"output-witness: {error}\"},#[])\n    outputWitnesses := outputWitnesses.push (source.source.head.identity,outputs)\n    plan := {plan with\n      results := plan.results.push result\n      causeInputs := plan.causeInputs ++ result.admitted.map (fun hint => ⟨source.source.head.identity,hint⟩)}\n  let offers := plan.results.flatMap (·.admitted)\n  let mut admitted : Array AdmittedOwner := #[]\n  let mut originals : Std.HashMap (String × Original) (List Nat) := {}\n  for owner in owners do\n    let .ok document := owner.document | plan := {plan with unsupported := plan.unsupported+1}; continue\n    let original := ObservationContext.OriginalOwner.prepare? document\n    if let some original := original then\n      let key := (owner.database,original.identity)\n      originals := originals.insert key (admitted.size :: (originals[key]?.getD []))\n    admitted := admitted.push ⟨owner,document,original⟩\n  -- Prepend in the directory. Appending to a shared array here repeatedly\n  -- copies a growing owner's complete row list.\n  let mut origins : Std.HashMap (String × String) (List Routed.Located) := {}\n  for (source,result) in prepared.zip plan.results do\n    let database := source.source.head.identity\n    let scopedOffers := result.admitted\n    let wanted := (hashDistinct (scopedOffers.toList.filterMap fun hint => do\n      let range ← hint.target.source?\n      let .file _ := range.subject | none\n      some range)).toArray\n    let allowed := admitted.foldl (fun allowed item =>\n      if item.owner.database == database && item.document.native then\n        allowed.insert item.document.owner else allowed) ({} : Std.HashSet String)\n    let resolved ← if wanted.isEmpty then pure ({} : IndexedBindings.Resolved)\n      else if let some index := source.shared then IndexedBindings.resolve index wanted allowed deadline\n      else pure {complete := false,unresolved := wanted.size}\n    plan := {plan with\n      bindingComplete := plan.bindingComplete && resolved.complete\n      bindingRequests := plan.bindingRequests+resolved.requests\n      bindingBytes := plan.bindingBytes+resolved.bytes\n      bindingUnresolved := plan.bindingUnresolved+resolved.unresolved}\n    let mut unresolved : Std.HashSet Range := {}\n    for offer in scopedOffers do\n      let .range target := offer.target | continue\n      if exact : offer.target = .range target then\n        let mut rows := #[]\n        match target.subject with\n        | .file _ => rows := resolved.rows[target]?.getD #[]\n        | .original identity =>\n          for index in originals[(database,identity)]?.getD [] do\n            let some item := admitted[index]? | continue\n            let some original := item.original | continue\n            rows := rows ++ (original.bind database target).map (·.read)\n          if rows.isEmpty then unresolved := unresolved.insert target\n        for row in rows do\n          if contained : target.contains row.source = true then\n            let located : Routed.Located := ⟨offer,target,exact,row,contained⟩\n            let key := (database,row.binding.owner)\n            origins := origins.insert key (located :: (origins[key]?.getD []))\n    plan := {plan with bindingUnresolved := plan.bindingUnresolved+unresolved.size}\n  -- Certified rows and compact prepared recipes cross this boundary. Original\n  -- payload blocks remain in the data-side service; no full view is decoded.\n  -- A graph resource limit cannot erase independently verified source rows.\n  for source in prepared do\n    if let some reference := source.canonical then\n      try\n        let ids := owners.filterMap fun owner =>\n          if owner.database == source.source.head.identity then\n            some (Persistence.selectionKey owner.original.relation) else none\n        let found ← Plugin.Publication.Client.sourceRows reference ids deadline\n        let reuse := (source.source.head.identity,reference.access.reuse,found.reuse)\n        plan := {plan with canonicalReuse := plan.canonicalReuse.push reuse}\n        for (owner,rows) in found.rows do\n          let merged ← IO.ofExcept (CanonicalSource.Delivery.merge ((plan.canonical[owner]?.getD #[]) ++ rows))\n          plan := {plan with canonical := if merged.isEmpty then plan.canonical.erase owner\n            else plan.canonical.insert owner merged}\n        let structures ← Plugin.Publication.Client.sourceRecords reference ids deadline\n        plan := {plan with originalCache := plan.originalCache.push structures.cache}\n        for (owner,found) in structures.rows do\n          let some geometry := found | continue\n          let some witness := admitted.find? (fun item => item.owner.database == source.source.head.identity &&\n            item.document.owner == owner) | throw (IO.userError \"original recipe has no admitted owner\")\n          let identity ← match witness.original with\n            | some original => pure original.identity\n            | none => do\n              let some raw := witness.document.source | throw (IO.userError \"original recipe has no stored text\")\n              pure (ObservationContext.originalSubject witness.document.work raw)\n          unless geometry.header.work == witness.document.work && geometry.header.original == identity &&\n              geometry.header.characters == identity.chars &&\n              geometry.header.occurrences == witness.document.occurrences &&\n              geometry.spans.all (fun span => span.first < span.limit &&\n                span.limit ≤ geometry.header.characters && span.limit-span.first ≤ 2048) do\n            throw (IO.userError \"original recipe crossed its stored content or occurrence\")\n          plan := {plan with originalStructures := plan.originalStructures.insert owner geometry}\n      catch error =>\n        let failure := (source.source.head.identity,error.toString)\n        plan := {plan with canonicalFailure := plan.canonicalFailure.push failure}\n  if offers.isEmpty then return plan\n  -- Query-invariant across owners. Computing this same ordered set inside\n  -- each owner was quadratic work repeated for every hydrated observation.\n  for item in admitted do\n    if (← IO.monoMsNow) ≥ deadline then\n      return {plan with results := plan.results.map fun result =>\n        {result with complete := false,failure := some \"binding-deadline\"}}\n    let owner := item.owner\n    let document := item.document\n    let located := (origins[(owner.database,document.owner)]?.getD []).reverse.toArray.filter fun located =>\n      item.original.any (fun original => boundTo owner.database document original.identity located.row)\n    let rows := (hashDistinct (located.toList.map (·.row))).toArray\n    let witnesses := outputWitnesses.flatMap fun (database,offers) =>\n      if database == owner.database then offers else #[]\n    let context := if witnesses.isEmpty then none else ObservationContext.prepare? document\n    let outputs := context.map (Recommend.locateOutputsUsing witnesses owner.database) |>.getD #[]\n    -- Metadata is fetched only for offered native origins, once per occurrence,\n    -- with a fixed cap and the existing request deadline. It cannot block or\n    -- filter the historical body when unavailable, expired, or clock-skewed.\n    if !located.isEmpty || !outputs.isEmpty then\n      for occurrence in document.occurrences do\n        if plan.observations.any (fun prior => prior.database == owner.database &&\n            prior.owner == document.owner && prior.occurrence == occurrence) then continue\n        let (receivedUnixMs,metadataFailure) ←\n          if plan.observations.size ≥ 256 || (← IO.monoMsNow) ≥ deadline then\n            pure (none,some \"metadata-budget\")\n          else if let some source := prepared.find? (·.source.head.identity == owner.database) then\n            try\n              let origin ← Provenance.lookup? source.source owner.original occurrence\n              pure (origin.bind (·.receivedUnixMs),if origin.isNone then some \"unrecorded\" else none)\n            catch _ => pure (none,some \"metadata-unverified\")\n          else pure (none,some \"source-unavailable\")\n        plan := {plan with observations := plan.observations.push {\n          database := owner.database,owner := document.owner,work := document.work,occurrence\n          age := ObservationAge.assess assessedUnixMs receivedUnixMs,metadataFailure}}\n    plan := {plan with\n      documents := plan.documents.push document\n      rows := plan.rows ++ rows\n      unlocatedFileOwners := plan.unlocatedFileOwners +\n        if !document.files.isEmpty && located.isEmpty then 1 else 0\n      owners := plan.owners.push ⟨owner.original,document,located,outputs,owner.database⟩}\n  return plan\n\ndef Plan.receiptWith (plan : Plan) (delivery : Extraction.Presentation) : Json :=\n  let bindings := KeyPostings.prepare (·.source) (plan.owners.flatMap (·.located))\n  let originals := ((plan.results.flatMap (·.admitted)).toList.filterMap fun offer => do\n    let source ← offer.target.source?\n    let .original _ := source.subject | none\n    some source) |> hashDistinct |>.toArray\n  Json.mkObj [\n    (\"complete\", toJson plan.complete), (\"unsupportedOwners\", toJson plan.unsupported),\n    (\"bindingComplete\",toJson plan.bindingComplete),(\"bindingRequests\",toJson plan.bindingRequests),\n    (\"bindingBytes\",toJson plan.bindingBytes),(\"bindingUnresolved\",toJson plan.bindingUnresolved),\n    (\"unlocatedFileOwners\",toJson plan.unlocatedFileOwners),\n    (\"observationAges\",toJson plan.observations),\n    (\"originalRecipeCache\",toJson plan.originalCache),\n    (\"originalRecipeOwners\",toJson plan.originalStructures.size),\n    (\"inputs\", toJson (plan.results.map Routed.Result.receipt)),\n    (\"originalReferences\",toJson (originals.map fun source =>\n      let bindings := (bindings.lookup source).map (·.row.binding)\n      let origins := bindings.foldl (fun known binding => known.insert binding) ({} : Std.HashSet Binding)\n      let origins := origins.toArray.qsort fun a b => (toJson a).compress < (toJson b).compress\n      Json.mkObj [\n      (\"source\",toJson source), (\"bodyDelivered\",toJson (covered source delivery.ranges)),\n      (\"origins\",toJson origins)])),\n    (\"originalOutputs\",toJson (plan.owners.flatMap fun owner => owner.outputs.map fun located =>\n      Json.mkObj [\n        (\"evidence\",toJson located.offer.identity), (\"binding\",toJson located.fragment.binding),\n        (\"path\",toJson (located.fragment.address.map (fun address => JsonScalars.pathJson address.path))),\n        (\"bodyDelivered\",toJson (delivery.coversBinding located.fragment.binding)),\n        (\"addressDelivered\",toJson (located.fragment.address.map (fun address =>\n          delivery.coversAddress located.fragment.binding address.path)))])),\n    (\"offers\", toJson (plan.results.flatMap fun result => result.admitted.map fun offer =>\n      let delivered := match offer.target with\n        | .range source => covered source delivery.ranges\n        | .output _ => plan.owners.any fun owner => owner.outputs.any fun located =>\n            located.offer.identity == offer.evidence && delivery.coversBinding located.fragment.binding\n      Json.mkObj [(\"offer\", offer.json), (\"bodyDelivered\", toJson delivered)]))]\n\ndef Plan.receipt (plan : Plan) (text : String) : Json :=\n  plan.receiptWith (Extraction.presented text plan.documents plan.rows)\n\nend Eggshell.Synapses.Transport\n"],["SynapseUsage.lean","module\n\npublic import Eggshell.SynapseSource\npublic import tools.SpanPostings\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Extraction\nopen Lean\n\nstructure Presentation where\n  ranges : Array Range := #[]\n  uncertain : Std.HashSet File := {}\n  bindings : Array (String × Nat × Nat) := #[]\n  uncertainOwners : Std.HashSet String := {}\n  addressed : Array (String × Nat × Nat × List JsonScalars.Segment) := #[]\n\ndef caption (text : String) : Option (Nat × Nat × Bool) := do\n  if !text.startsWith \"  ORIGINAL CHARS [\" && !text.startsWith \"  CHARS [\" then none else do\n    let parts := text.splitOn \"CHARS [\"\n    let rest ← parts[1]?\n    let bounds ← (rest.splitOn \")\").head?\n    let [first, limit] := bounds.splitOn \",\" | none\n    let first ← first.toNat?\n    let limit ← limit.toNat?\n    if first < limit then some (first, limit, text.endsWith \" decoded\") else none\n\ndef scalarSlice (raw : String) (first limit : Nat) : Option String :=\n  if first < limit && limit ≤ raw.length then\n    some (String.ofList ((raw.toList.drop first).take (limit-first))) else none\n\nstructure SharedSpelling where\n  file : File\n  number : Nat\n  code : String\n  origins : Array (String × String × String × Occurrence)\n\n/-- Decode only complete shared frames. This grants no original-byte status;\ncallers must bind each spelling to their saved original rows. -/\ndef sharedSpellings (body : String) : Array SharedSpelling := Id.run do\n  let wrapper := \"EGGSHELL SHARED SOURCE DATA\\nOriginal recorded file data; advisory, not a completed operation.\\n\"\n  let mut found : Array SharedSpelling := #[]\n  for packet in (body.splitOn wrapper).tail do\n    let parts := packet.splitOn \"END EGGSHELL SHARED SOURCE DATA\\n\"\n    if parts.length < 2 then continue\n    for block in ((\"\\n\" ++ parts.head!).splitOn \"\\nSOURCE \").tail do\n      let parts := block.splitOn \"\\nEND SOURCE\"\n      if parts.length < 2 then continue\n      let suffix := parts[1]!\n      if !suffix.isEmpty && !suffix.startsWith \"\\n\" then continue\n      let fileLine :: originsLine :: \"CODE\" :: codeLines := parts.head!.splitOn \"\\n\" | continue\n      let some file := (Json.parse fileLine >>= fromJson? (α := File)).toOption | continue\n      if !file.valid || !originsLine.startsWith \"ORIGINAL READS \" then continue\n      let encoded := String.ofList (originsLine.toList.drop \"ORIGINAL READS \".length)\n      let some origins := (Json.parse encoded >>= fromJson? (α := Array String)).toOption | continue\n      let origins := origins.filterMap fun origin =>\n        (Json.parse origin >>= fromJson? (α := String × String × String × Occurrence)).toOption\n      for line in codeLines do\n        let some (number,code) := numbered line | continue\n        found := found.push ⟨file,number,code,origins⟩\n  return found\n\n/-- A shared spelling can report only a range belonging to an original saved\nrow. Sharing the payload never manufactures another execution witness. -/\nstructure SharedWitness (reads : Array Read) where\n  row : Read\n  original : row ∈ reads\n  file : File\n  number : Nat\n  code : String\n  sourceExact : row.source = ⟨file,number,number⟩\n\ntheorem SharedWitness.original_range (witness : SharedWitness reads) :\n    ∃ row ∈ reads, row.source = ⟨witness.file,witness.number,witness.number⟩ :=\n  ⟨witness.row,witness.original,witness.sourceExact⟩\n\n/-- A file alias can cover just its original code bytes, without a numbered\nprefix. JSON escaping changes representation, never the saved code spelling. -/\nstructure SharedCode (original : String) where\n  text : String\n  exact : text = original ∨\n    String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original\n\ndef sharedCodes (original : String) : Array (SharedCode original) := Id.run do\n  let mut result := #[⟨original,Or.inl rfl⟩]\n  if let some text := (Json.parse (\"\\\"\" ++ original ++ \"\\\"\") >>= Json.getStr?).toOption then\n    if same : String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original then\n      if text != original then result := result.push ⟨text,Or.inr same⟩\n  return result\n\ntheorem SharedCode.original_spelling (code : SharedCode original) :\n    code.text = original ∨\n      String.ofList ((toJson code.text).compress.toList.drop 1 |>.dropLast) = original := code.exact\n\n/-- Recognize the producer's shared file frame, then compare every displayed\ncode row with its raw scalar coordinates and declared DB/owner/Work/occurrence.\nLocation-only notices and arbitrary matching prose cannot label delivery. -/\ndef sharedPresented (body : String) (docs : Array Document) (reads : Array Read) :\n    Array (SharedWitness reads) := Id.run do\n  let displayed := sharedSpellings body\n  if displayed.isEmpty || reads.isEmpty then return #[]\n  let mut index : Std.HashMap (File × Nat × String) (Array (SharedWitness reads)) := {}\n  let byOwner := reads.attach.foldl (fun found saved =>\n    found.insert saved.val.binding.owner\n      ((found.getD saved.val.binding.owner #[]).push saved))\n    ({} : Std.HashMap String (Array {row // row ∈ reads}))\n  for doc in docs do\n    if !doc.native then continue\n    let some raw := doc.source | continue\n    let characters := raw.toList.toArray\n    for saved in byOwner.getD doc.owner #[] do\n      let row := saved.val\n      if !row.valid || row.binding.work != doc.work || !doc.occurrences.contains row.occurrence then continue\n      let .file file := row.source.subject | continue\n      if row.source.first != row.source.last then continue\n      if !(row.binding.first < row.binding.limit && row.binding.limit ≤ characters.size) then continue\n      let original := String.ofList (characters.extract row.binding.first row.binding.limit).toList\n      for code in sharedCodes original do\n        if code.text.isEmpty || code.text.contains '\\n' || code.text.contains '\\r' then continue\n        if same : row.source = ⟨file,row.source.first,row.source.first⟩ then\n          let witness : SharedWitness reads := ⟨row,saved.property,file,row.source.first,code.text,same⟩\n          let key := (file,row.source.first,code.text)\n          index := index.insert key ((index.getD key #[]).push witness)\n    let .ok decoded := layout raw | continue\n    let spanOf := fun (saved : {row // row ∈ reads}) =>\n      if saved.val.valid && saved.val.binding.work == doc.work then\n        some (saved.val.binding.first,saved.val.binding.limit) else none\n    let spans := SpanPostings.prepare spanOf (byOwner.getD doc.owner #[]).toList\n    for line in textLines decoded.text do\n      let some (number,code) := numbered line.text | continue\n      for saved in spans.lookup (decoded.offsets[line.first]!,decoded.offsets[line.limit]!) do\n        let row := saved.val\n        let .file file := row.source.subject | continue\n        if same : row.source = ⟨file,number,number⟩ then\n          let witness : SharedWitness reads := ⟨row,saved.property,file,number,code,same⟩\n          let key := (file,number,code)\n          index := index.insert key ((index.getD key #[]).push witness)\n  let mut found := #[]\n  for spelling in displayed do\n    for witness in index.getD (spelling.file,spelling.number,spelling.code) #[] do\n      let row := witness.row\n      if spelling.origins.contains (row.binding.database,row.binding.owner,row.binding.work,row.occurrence) then\n        found := found.push witness\n  return found\n\n/-- Verify actual packet bytes against immutable raw coordinates before labelling. -/\ndef presented (body : String) (docs : Array Document) (reads : Array Read) : Presentation := Id.run do\n  let mut result : Presentation := {}\n  for part in body.splitOn \"\\nWORK GRAPH \" do\n    let some owner := (part.splitOn \"\\n\").head? | continue\n    let some doc := docs.find? (·.owner == owner) | continue\n    let some raw := doc.source | continue\n    let blocks := part.splitOn \"  GROUNDED OUTCOME\\n\"\n    let some evidence := blocks[1]? | continue\n    let evidence := (evidence.splitOn \"  TRACE\\n\").head!\n    let json := JsonScalars.prepare? raw\n    let rawChars := match json with | some index => index.characters | none => raw.toList.toArray\n    let evidenceChars := evidence.toList.toArray\n    let mut spans := #[]\n    let mut addressed := #[]\n    let mut path : Option String := none\n    let mut bad := false\n    for line in textLines evidence do\n      if line.text.startsWith \"  JSON PATH \" then\n        path := some (String.ofList (line.text.toList.drop \"  JSON PATH \".length))\n        continue\n      let some (first, limit, decoded) := caption line.text | continue\n      let location := json.bind (·.cover? first limit)\n      let declared := path\n      path := none\n      if declared.isSome && !location.any (fun address => declared == some address.label) then\n        bad := true\n        continue\n      if !(first < limit && limit ≤ rawChars.size) then bad := true; continue\n      let segment := String.ofList (rawChars.extract first limit).toList\n      let marker := \"  DECODED JSON STRING DATA\\n\"\n      let marked := literal evidenceChars line.limit (line.limit+marker.length) marker\n      let expected := if decoded || marked then\n          (Json.parse (\"\\\"\" ++ segment ++ \"\\\"\") >>= Json.getStr?).toOption\n        else some segment\n      let some expected := expected | bad := true; continue\n      let dataStart := line.limit + if marked then marker.length else 0\n      if dataStart+expected.length > evidenceChars.size ||\n          String.ofList (evidenceChars.extract dataStart (dataStart+expected.length)).toList != expected then\n        bad := true\n        continue\n      spans := spans.push (first, limit)\n      if let some address := location then\n        if declared == some address.label then addressed := addressed.push (owner,first,limit,address.path)\n    if spans.isEmpty then\n      let decoded := (layout raw).toOption.map (·.text)\n      if !raw.isEmpty && ((evidence.splitOn raw).length > 1 ||\n          decoded.any (fun text => !text.isEmpty && (evidence.splitOn text).length > 1)) then\n        spans := #[(0, raw.length)]\n      else bad := true\n    if bad then\n      result := {result with uncertainOwners := result.uncertainOwners.insert owner}\n      for file in doc.files do result := {result with uncertain := result.uncertain.insert file}\n    else\n      result := {result with\n        bindings := result.bindings ++ spans.map (fun (a,b) => (owner,a,b))\n        addressed := result.addressed ++ addressed}\n    for row in reads do\n      if row.binding.owner == owner && spans.any (fun (first, limit) =>\n          first ≤ row.binding.first && row.binding.limit ≤ limit) then\n        result := {result with ranges := result.ranges.push row.source}\n  for witness in sharedPresented body docs reads do\n    result := {result with\n      ranges := result.ranges.push witness.row.source\n      bindings := result.bindings.push\n        (witness.row.binding.owner,witness.row.binding.first,witness.row.binding.limit)}\n  return result\n\ndef Presentation.coversBinding (shown : Presentation) (binding : Binding) : Bool := Id.run do\n  if shown.uncertainOwners.contains binding.owner then return false\n  let spans := shown.bindings.filterMap fun (owner,first,limit) =>\n    if owner == binding.owner then some (first,limit) else none\n  let spans := spans.qsort fun a b => a.1 < b.1\n  let covered := spans.foldl (fun position (first,limit) =>\n    if first ≤ position then max position limit else position) binding.first\n  return binding.first < binding.limit && binding.limit ≤ covered\n\ndef Presentation.coversAddress (shown : Presentation) (binding : Binding) (path : List JsonScalars.Segment) : Bool :=\n  let bindings := shown.addressed.filterMap fun (owner,first,limit,actual) =>\n    if actual == path then some (owner,first,limit) else none\n  {shown with bindings}.coversBinding binding\n\ndef compactRanges (ranges : Array Range) : Array Range := Id.run do\n  let mut files : Std.HashMap Subject (Array Range) := {}\n  for range in ranges do files := files.insert range.subject (files[range.subject]?.getD #[] |>.push range)\n  let mut result := #[]\n  for (_, spans) in files do\n    let mut merged : Array Range := #[]\n    for span in spans.qsort (fun a b => a.first < b.first || (a.first == b.first && a.last < b.last)) do\n      if let some previous := merged.back? then\n        if span.first ≤ previous.last+1 then\n          merged := merged.pop.push {previous with last := max previous.last span.last}\n          continue\n      merged := merged.push span\n    result := result ++ merged\n  return result\n\n/-- Stored overlap minus verified delivery; does not expand a citation's line count. -/\ndef omittedRanges (requested : Range) (stored delivered : Array Range) : Array Range := Id.run do\n  let mut result : Std.HashSet Range := {}\n  for saved in compactRanges stored do\n    if saved.subject != requested.subject then continue\n    let first := max saved.first requested.first\n    let last := min saved.last requested.last\n    if last < first then continue\n    let relevant := (delivered.filter (·.subject == requested.subject)).toList.mergeSort\n      (fun a b => a.first ≤ b.first)\n    let mut position := first\n    for shown in relevant do\n      if position > last then break\n      if shown.last < position then continue\n      if position < shown.first then\n        result := result.insert {requested with first := position, last := min last (shown.first-1)}\n      position := max position (shown.last+1)\n    if position ≤ last then result := result.insert {requested with first := position, last}\n  return result.toArray\n\nstructure Feedback where\n  graph : Graph := .empty\n  delivered : Presentation := {}\n  atStart : Std.HashMap Occurrence Presentation := {}\n\ndef Feedback.present (feedback : Feedback) (packet : Presentation) : Feedback :=\n  {feedback with delivered := {\n    ranges := feedback.delivered.ranges ++ packet.ranges\n    uncertain := feedback.delivered.uncertain.union packet.uncertain\n    bindings := feedback.delivered.bindings ++ packet.bindings\n    addressed := feedback.delivered.addressed ++ packet.addressed\n    uncertainOwners := feedback.delivered.uncertainOwners.union packet.uncertainOwners }}\n\n/-- A PreToolUse packet arriving after proposal cannot rewrite what was known. -/\ndef Feedback.start (feedback : Feedback) (occurrence : Occurrence) : Feedback :=\n  if feedback.atStart.contains occurrence then feedback else\n    {feedback with atStart := feedback.atStart.insert occurrence feedback.delivered}\n\ndef Feedback.completedRead (feedback : Feedback) (occurrence : Occurrence) (query : String)\n    (requested stored : Array Range) : Except String Feedback := do\n  let some earlier := feedback.atStart[occurrence]? | throw \"read has no observed start\"\n  let mut graph := feedback.graph\n  let mut ordinal := 0\n  for source in compactRanges requested do\n    let checked := match source.subject with\n      | .file file => !earlier.uncertain.contains file\n      | .original _ => earlier.uncertainOwners.isEmpty\n    let gaps := if checked then omittedRanges source stored earlier.ranges else #[]\n    for gap in if gaps.isEmpty then #[source] else gaps do\n      graph ← graph.recordRead ⟨occurrence, ordinal, none⟩ query gap stored earlier.ranges checked\n      ordinal := ordinal+1\n  return {feedback with graph}\n\ndef Feedback.answer (feedback : Feedback) (occurrence : Occurrence) (query text : String) :\n    Except String Feedback := do\n  let files := feedback.delivered.ranges.foldl (fun files range =>\n    (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\n  let cited := paragraphCitations text files.toArray\n  let mut graph := feedback.graph\n  for index in [:cited.size] do\n    graph ← graph.recordCitation ⟨occurrence, index, none⟩ query cited[index]! feedback.delivered.ranges\n  return {feedback with graph}\n\n/-- A native usage label may cover only an actual located consumption witness.\nThe native row remains tied to its original Work and response digest. -/\nstructure ConsumedSource (edge : Consumption) where\n  source : Range\n  valid : edge.valid = true\n  native : source.file?.isNone = true\n  consumed : edge.rows.any (·.contains source) = true\n\ndef consumedSource? (edge : Consumption) (source : Range) : Option (ConsumedSource edge) :=\n  if valid : edge.valid = true then\n    if native : source.file?.isNone = true then\n      if consumed : edge.rows.any (·.contains source) = true then\n        some ⟨source,valid,native,consumed⟩ else none\n    else none\n  else none\n\ntheorem consumed_source_has_witness (checked : ConsumedSource edge) :\n    ∃ row ∈ edge.rows, row.contains checked.source = true := by\n  obtain ⟨index,bound,present⟩ := Array.any_eq_true.mp checked.consumed\n  exact ⟨edge.rows[index],by simp,present⟩\n\ntheorem consumed_source_is_later (checked : ConsumedSource edge) :\n    edge.producerFinish < edge.consumerStart := by\n  exact Consumption.checked_before (edge := edge) (accepted := edge)\n    (by simp [Consumption.checked,checked.valid])\n\n/-- Literal reuse is advisory evidence, not proof of semantic necessity. The\ncaller supplies immutable pre-read stored and ACK ranges; no returned sibling\nfield is labelled merely because it was present in the tool's response. -/\ndef consumedUsage? (checked : ConsumedSource edge) (query : String)\n    (stored delivered : Array Range) : Option Usage :=\n  if covered checked.source stored && !covered checked.source delivered then some {\n    event := {occurrence := edge.producer,ordinal := 0,consumption := some ⟨edge.consumer,checked.source⟩}\n    query,source := checked.source,kind := .omittedThenConsumed}\n  else none\n\ntheorem consumed_omission_requires_stored (checked : ConsumedSource edge)\n    (observed : consumedUsage? checked query stored delivered = some usage) :\n    covered checked.source stored = true ∧ covered checked.source delivered = false := by\n  unfold consumedUsage? at observed\n  split at observed\n  next present => simpa only [Bool.and_eq_true,Bool.not_eq_true'] using present\n  next => contradiction\n\ndef recordConsumed (graph : Graph) (checked : ConsumedSource edge) (query : String)\n    (stored delivered : Array Range) : Except String Graph :=\n  match consumedUsage? checked query stored delivered with\n  | some usage => graph.insert (.used usage)\n  | none => .ok graph\n\nend Eggshell.Synapses.Extraction\n"],["SynapticTransport.lean","module\n\npublic import Eggshell.SynapticRoutingStore\n\n@[expose] public section\nnamespace Eggshell.Synapses.Routed\nopen Lean DB Recommend Routing.Store\n\ndef graphDeadline (now deadline : Nat) : Nat :=\n  min deadline (now+(deadline-now)/4)\n\ntheorem graph_deadline_preserves_upstream (now deadline : Nat) :\n    graphDeadline now deadline ≤ deadline := Nat.min_le_left _ _\n\ntheorem graph_deadline_reserves_binding (now deadline : Nat) :\n    graphDeadline now deadline ≤ now+(deadline-now)/4 := Nat.min_le_right _ _\n\nstructure Result where\n  hints : Array Hint := #[]\n  nodes : Nat := 0\n  arcs : Nat := 0\n  bytes : Nat := 0\n  complete : Bool := true\n  available : Bool := true\n  index : Option PageMap.Head := none\n  usage : Option PageMap.Head := none\n  routing : Option PageMap.Head := none\n  usageRouting : Option PageMap.Head := none\n  failure : Option String := none\n\ndef Result.admitted (result : Result) : Array Hint :=\n  if result.complete && result.available && result.failure.isNone then result.hints else #[]\n\ntheorem Result.incomplete_not_admitted (result : Result) (incomplete : result.complete = false) :\n    result.admitted = #[] := by simp [Result.admitted,incomplete]\n\ndef Result.receipt (result : Result) : Json := Json.mkObj [\n  (\"available\",toJson result.available),(\"complete\",toJson result.complete),\n  (\"requests\",toJson result.nodes),(\"facts\",toJson result.arcs),(\"bytes\",toJson result.bytes),\n  (\"index\",toJson result.index),(\"usage\",toJson result.usage),\n  (\"routing\",toJson result.routing),(\"usageRouting\",toJson result.usageRouting),\n  (\"failure\",toJson result.failure),(\"offers\",toJson (result.admitted.map Hint.json))]\n\ndef preferOmissions (hints : Array Hint) : Array Hint := Id.run do\n  let missing := hints.foldl (fun sources hint =>\n    if hint.kind == 3 || hint.kind == 4 then\n      hint.target.source?.map sources.insert |>.getD sources else sources) ({} : Std.HashSet Range)\n  return hints.filter fun hint =>\n    hint.kind != 5 || hint.target.source?.all (fun source => !missing.contains source)\n\n/-- Views are opened read-only and must match the already pinned original\nindex. Missing or stale preparation is explicit; a hook never rebuilds it. -/\ndef collect (prepared : Recommend.Prepared) (answers : Array (String × Nat))\n    (query : String) (deadline : Nat) (consumers : Array (Occurrence × Nat)) : IO Result := do\n  let initial : Result := {index := prepared.shared.map (·.index.head),usage := prepared.usage.map (·.index.head)}\n  if prepared.failure.isSome then return {initial with complete := false,available := false,failure := prepared.failure}\n  let some shared := prepared.shared | return {initial with complete := false,available := false,failure := some \"source-index-unavailable\"}\n  try\n    let some routing ← Routing.Store.open? shared |\n      return {initial with complete := false,available := false,failure := some \"routing-unprepared\"}\n    let usage ← prepared.usage.mapM fun original => do\n      let some view ← Routing.Store.open? original |\n        throw (IO.userError \"private usage routing is unprepared\")\n      pure view\n    let mut roots := answers.map fun (owner,priority) =>\n      (Index.Key.answer shared.manifest.source.identity owner,priority)\n    roots := roots ++ consumers.map (fun (consumer,priority) => (Index.Key.consumer consumer,priority))\n    if usage.isSome && digest query then roots := roots.push (.query query,0)\n    let walked ← Routing.Store.walk routing usage roots deadline\n    return {initial with\n      hints := preferOmissions walked.hints,nodes := walked.nodes,arcs := walked.arcs,bytes := walked.bytes\n      complete := walked.complete,routing := some routing.snapshot.head,usageRouting := usage.map (·.snapshot.head)}\n  catch error => return {initial with complete := false,failure := some s!\"routing-read: {error}\"}\n\n/-- A hint cannot supply coordinates. Original rows independently establish\nthe range, owner and bytes even if the advisory projection is malformed. -/\nstructure Located where\n  offer : Hint\n  source : Range\n  target : offer.target = .range source\n  row : Read\n  within : source.contains row.source = true\n\ndef locate (hints : Array Hint) (rows : Array Read) : Array Located := Id.run do\n  let mut found := #[]\n  for hint in hints do\n    let .range source := hint.target | continue\n    if target : hint.target = .range source then\n      let matching := rows.filter (source.contains ·.source)\n      unless covered source (matching.map (·.source)) do continue\n      for row in matching do\n        if within : source.contains row.source = true then found := found.push ⟨hint,source,target,row,within⟩\n  return found\n\ntheorem Located.same_subject (located : Located) :\n    located.source.subject = located.row.source.subject := by\n  have within := located.within\n  simp only [Range.contains,Bool.and_eq_true,beq_iff_eq,decide_eq_true_eq] at within\n  exact within.1.1\n\n/-- Only arbitrary-output transport needs a full consumption witness. Decode\neach such fact once, retain its checked Offer and leave range hints compact. -/\ndef outputOffers (prepared : Recommend.Prepared) (result : Result) (deadline : Nat) : IO (Array Offer) := do\n  let some shared := prepared.shared | return #[]\n  let mut facts : Std.HashMap String Fact := {}\n  let mut offers := #[]\n  for hint in result.admitted do\n    let .output _ := hint.target | continue\n    if (← IO.monoMsNow) ≥ deadline then throw (IO.userError \"output-witness deadline\")\n    let fact ← match facts[hint.evidence]? with\n      | some fact => pure fact\n      | none => do\n        let some bytes ← shared.index.get (\"fact:\" ++ hint.evidence) |\n          throw (IO.userError \"missing original output witness\")\n        let fact ← Index.decode (α := Fact) bytes\n        unless shared.manifest.scope.accepts fact && Index.belongs shared.manifest.source.identity fact do\n          throw (IO.userError \"foreign original output witness\")\n        pure fact\n    let identity := Index.contentKey fact\n    unless identity == hint.evidence do throw (IO.userError \"output witness differs from its digest\")\n    let some offer := Offer.check? hint.target hint.priority fact ⟨identity,rfl⟩ |\n      throw (IO.userError \"output hint is not supported by its original witness\")\n    unless offer.kind == Routing.Store.kindName hint.kind do\n      throw (IO.userError \"output hint changed its relation kind\")\n    facts := facts.insert hint.evidence fact\n    offers := offers.push offer\n  return offers\n\nend Eggshell.Synapses.Routed\n"],["SynapticRoutingStore.lean","module\npublic import Eggshell.SynapticRouting\npublic import Eggshell.SynapticTopologyStore\n@[expose] public section\nnamespace Eggshell.Synapses.Routing.Store\nopen Lean DB Recommend\nstructure Manifest where\n  basis : PageMap.Head\n  source : PageMap.Head\n  scope : Index.Scope\n  implementation : String\n  counts : Counts\n  deriving ToJson, FromJson\n\nstructure Reader where\n  snapshot : PageMap.Snapshot\n  manifest : Manifest\n\n/-- Facts, inverse postings and integer incidences are one pinned snapshot.\nOpening does no preparation and cannot observe a half-published projection. -/\ndef open? (basis : Index.Reader) : IO (Option Reader) := do\n  let some bytes ← basis.index.get \"route:implementation\" | return none\n  unless (← Index.decode (α := String) bytes) == implementation do return none\n  let some bytes ← basis.index.get \"route:counts\" | return none\n  let total ← Index.decode (α := Counts) bytes\n  unless total.facts == basis.manifest.facts do return none\n  let manifest : Manifest := {\n    basis := basis.index.head\n    source := basis.manifest.source\n    scope := basis.manifest.scope\n    implementation\n    counts := total}\n  return some ⟨basis.index,manifest⟩\n\n\nstructure Scan where\n  arcs : Array Arc := #[]\n  bytes : Nat := 0\n  pages : Nat := 0\n  complete : Bool := true\n\ndef scanAt (reader : Reader) (ref : PageMap.Ref) (node : Nat)\n    (limit byteLimit deadline : Nat) (initial : Scan) : IO Scan := do\n  if !initial.complete then return initial\n  if initial.arcs.size ≥ limit || initial.bytes ≥ byteLimit || (← IO.monoMsNow) ≥ deadline then\n    return {initial with complete := false}\n  let loaded ← reader.snapshot.load ref\n  let range : PageMap.KeyRange := ⟨arcPrefix node,s!\"route:arc:{node};\"⟩\n  let mut result := {initial with pages := initial.pages+1}\n  match loaded.page with\n  | .leaf rows =>\n    for (name,payload) in range.select rows do\n      let some payload := payload | continue\n      if result.arcs.size ≥ limit || result.bytes+payload.size > byteLimit ||\n          (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\n      let arc ← decode payload\n      unless name == arcName node arc.evidence && arc.targets.all (· < reader.manifest.counts.targets) &&\n          arc.next.all (· < reader.manifest.counts.nodes) &&\n          arc.group.all (· < reader.manifest.counts.nodes) do throw (IO.userError \"foreign routing incidence\")\n      result := {result with arcs := result.arcs.push arc,bytes := result.bytes+payload.size}\n    return result\n  | .branch children =>\n    for child in children do\n      if range.overlaps child then\n        if _smaller : child.height < ref.height then\n          result ← scanAt reader child node limit byteLimit deadline result\n        else throw (IO.userError \"routing page height did not decrease\")\n        if !result.complete then return result\n    return result\ntermination_by ref.height\n\nstructure RawHint where\n  target : Nat\n  priority : Nat\n  evidence : String\n  kind : Nat\n  group : Option Nat\n  lane : Nat\n\n/-- A projection hint is intentionally a different type from checked Offer\nand from every e-graph certification type. -/\nstructure Hint where\n  target : Target\n  priority : Nat\n  evidence : String\n  kind : Nat\n  group : Option Group\n\ninductive QuotedCause where\n  | quoted (group : Group)\n  deriving ToJson\n\ndef Hint.reasonKey (hint : Hint) : String := match hint.group with\n  | some group => Index.contentKey (QuotedCause.quoted group)\n  | none => hint.evidence\n\ndef Hint.json (hint : Hint) : Json := Json.mkObj [\n  (\"target\",toJson hint.target),(\"source\",toJson hint.target.source?),\n  (\"priority\",toJson hint.priority),(\"kind\",toJson (kindName hint.kind)),\n  (\"evidence\",toJson hint.evidence)]\n\nstructure Walk where\n  hints : Array Hint := #[]\n  nodes : Nat := 0\n  arcs : Nat := 0\n  bytes : Nat := 0\n  complete : Bool := true\n\nstructure Limits where\n  nodes : Nat := 65536\n  arcs : Nat := 262144\n  hints : Nat := 262144\n  queue : Nat := 524288\n  bytes : Nat := 32*1024*1024\n\ndef Reader.destination (reader : Reader) (id : Nat) : IO (Target × Nat) := do\n  let some bytes ← reader.snapshot.get (targetName id) |\n    throw (IO.userError \"missing routing destination\")\n  let destination ← Index.decode (α := Destination) bytes\n  unless destination.id == id do throw (IO.userError \"routing destination moved\")\n  return (destination.target,bytes.size)\n\ndef Reader.group (reader : Reader) (id : Nat) : IO (Group × Nat) := do\n  let some bytes ← reader.snapshot.get (nodeName id) |\n    throw (IO.userError \"missing routing group\")\n  let node ← Index.decode (α := Node) bytes\n  unless node.id == id do throw (IO.userError \"routing group moved\")\n  let .group group := node.key | throw (IO.userError \"routing cause is not a group\")\n  return (group,bytes.size)\n\ndef Reader.locate (reader : Reader) (key : Index.Key) : IO (Option Nat × Nat) := do\n  let some bytes ← reader.snapshot.get (\"route:key:\" ++ Index.contentKey key) | return (none,0)\n  let root ← Index.decode (α := Node) bytes\n  unless root.key == key && root.id < reader.manifest.counts.nodes do\n    throw (IO.userError \"routing root differs from its address\")\n  return (some root.id,bytes.size)\n\n/-- Private usage supplies query roots. Its descendants return to the shared\nrelation, exactly as the original reader dispatch does for non-query keys. -/\ndef walk (shared : Reader) (usage : Option Reader) (roots : Array (Index.Key × Nat))\n    (deadline : Nat) (limits : Limits := {}) : IO Walk := do\n  if let some usage := usage then\n    unless shared.manifest.scope == .shared && usage.manifest.scope == .usage &&\n        shared.manifest.source.identity == usage.manifest.source.identity &&\n        shared.manifest.source.authority == usage.manifest.source.authority do\n      throw (IO.userError \"routing overlay has a different source or privacy scope\")\n  let readerFor := fun (lane : Nat) => if lane == 0 then shared else usage.getD shared\n  let locate := fun (key : Index.Key) => do\n    let lane := match key with | .query _ => if usage.isSome then 1 else 0 | _ => 0\n    let (id,bytes) ← (readerFor lane).locate key\n    pure (id.map (lane,·),bytes)\n  let roots := roots.qsort fun a b =>\n    if a.2 == b.2 then (toJson a.1).compress < (toJson b.1).compress else a.2 < b.2\n  let mut seen : Std.HashSet (Nat × Nat) := {}\n  let mut result : Walk := {}\n  let mut pending : Array RawHint := #[]\n  for (key,priority) in roots do\n    if (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\n    let (root,bytes) ← locate key\n    if result.bytes+bytes > limits.bytes then return {result with complete := false}\n    result := {result with bytes := result.bytes+bytes}\n    let some root := root | continue\n    let mut queue := #[root]\n    let mut position := 0\n    while position < queue.size do\n      let (lane,node) := queue[position]!\n      position := position+1\n      if seen.contains (lane,node) then continue\n      if result.nodes ≥ limits.nodes || result.arcs ≥ limits.arcs ||\n          result.bytes ≥ limits.bytes || (← IO.monoMsNow) ≥ deadline then\n        return {result with complete := false}\n      seen := seen.insert (lane,node)\n      let reader := readerFor lane\n      let scanned ← match reader.snapshot.head.root with\n        | none => pure ({} : Scan)\n        | some ref => scanAt reader ref node (limits.arcs-result.arcs) (limits.bytes-result.bytes) deadline {}\n      result := {result with\n        nodes := result.nodes+1\n        arcs := result.arcs+scanned.arcs.size\n        bytes := result.bytes+scanned.bytes}\n      unless scanned.complete do return {result with complete := false}\n      for arc in scanned.arcs do\n        if pending.size+arc.targets.size > limits.hints || queue.size+arc.next.size > limits.queue then\n          return {result with complete := false}\n        pending := pending ++ arc.targets.map (fun target => ⟨target,priority,arc.evidence,arc.kind,arc.group,lane⟩)\n        if lane == 0 then queue := queue ++ arc.next.map (0,·)\n        else\n          for next in arc.next do\n            let some bytes ← reader.snapshot.get (nodeName next) |\n              throw (IO.userError \"missing private routing descendant\")\n            let node ← Index.decode (α := Node) bytes\n            unless node.id == next do throw (IO.userError \"private routing descendant moved\")\n            let (destination,cost) ← locate node.key\n            if result.bytes+bytes.size+cost > limits.bytes then return {result with complete := false}\n            result := {result with bytes := result.bytes+bytes.size+cost}\n            if let some destination := destination then queue := queue.push destination\n  -- Group by target before materializing, so repeated evidence for one\n  -- range does not trigger repeated metadata reads or unbounded caches.\n  let ordered := (pending.mapIdx (fun ordinal hint => (ordinal,hint))).qsort fun a b =>\n    if a.2.lane == b.2.lane then a.2.target < b.2.target else a.2.lane < b.2.lane\n  let mut previous : Option ((Nat × Nat) × Target) := none\n  let mut groups : Std.HashMap (Nat × Nat) Group := {}\n  let mut displayed : Array (Nat × Hint) := #[]\n  for (ordinal,hint) in ordered do\n    if (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\n    let reader := readerFor hint.lane\n    let (target,bytes) ← match previous with\n      | some (id,target) => if id == (hint.lane,hint.target) then pure (target,0) else reader.destination hint.target\n      | none => reader.destination hint.target\n    if result.bytes+bytes > limits.bytes then return {result with complete := false}\n    result := {result with bytes := result.bytes+bytes}\n    let (group,groupBytes) ← match hint.group with\n      | none => pure (none,0)\n      | some id =>\n        if let some group := groups[(hint.lane,id)]? then pure (some group,0)\n        else do\n          let (group,bytes) ← reader.group id\n          pure (some group,bytes)\n    if result.bytes+groupBytes > limits.bytes then return {result with complete := false}\n    result := {result with bytes := result.bytes+groupBytes}\n    if groupBytes > 0 then\n      if let some id := hint.group then\n        if let some group := group then groups := groups.insert (hint.lane,id) group\n    previous := some ((hint.lane,hint.target),target)\n    displayed := displayed.push (ordinal,⟨target,hint.priority,hint.evidence,hint.kind,group⟩)\n  return {result with hints := (displayed.qsort (fun a b => a.1 < b.1)).map Prod.snd}\n\ndef Reader.walk (reader : Reader) (roots : Array (Index.Key × Nat))\n    (deadline : Nat) (limits : Limits := {}) : IO Walk :=\n  _root_.Eggshell.Synapses.Routing.Store.walk reader none roots deadline limits\n\nend Eggshell.Synapses.Routing.Store\n"]]]
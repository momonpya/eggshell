@@ -101,0 +102,24 @@ structure Ready where
+/-- Original projection and recommendation use the same shared index root.
+The source check remains the normal authenticated original-source check. -/
+structure BoundIndex (source : PageMap.Snapshot) (metadata : Manifest) where
+  reader : Index.Reader
+  exactRoot : metadata.bindings = some reader.index.head
+
+theorem BoundIndex.original_basis (view : BoundIndex source metadata) :
+    some view.reader.index.head = metadata.bindings := view.exactRoot.symm
+
+/-- No latest-root substitution. An absent required extent is unavailable,
+while an explicitly absent binding root is the empty optional input. -/
+def boundIndex? (source : PageMap.Snapshot) (path : System.FilePath) (metadata : Manifest) :
+    IO (Option (BoundIndex source metadata)) := do
+  let some root := metadata.bindings | return none
+  let some current ← PageMap.open? (path.parent.get! / "synapses" / Index.Scope.directory .shared) |
+    throw (IO.userError "canonical binding index is missing")
+  let some retained ← PageMap.HistoryReader.make? current root |
+    throw (IO.userError "canonical binding index extent is unavailable")
+  let some reader ← Index.atSource? source retained.snapshot .shared |
+    throw (IO.userError "canonical binding index has a different source or implementation")
+  if same : metadata.bindings = some reader.index.head then
+    return some ⟨reader,same⟩
+  else throw (IO.userError "canonical binding index changed its exact root")
+
@@ -110,2 +134,2 @@ def open? (source : PageMap.Snapshot) (storage : Sidecar.Storage) : IO (Option R
-  let prepared ← Index.open? source storage .shared
-  unless metadata.supplements == (← prepared.bindM fun prepared => ContentMetadata.supplementStamp prepared.index) do return none
+  let prepared ← boundIndex? source path metadata
+  unless metadata.supplements == (← prepared.bindM fun prepared => ContentMetadata.supplementStamp prepared.reader.index) do return none
@@ -120 +144,4 @@ def ready (source : PageMap.Snapshot) : IO Bool := do
-    try if (← open? source storage).isSome then return true
+    try
+      if let some prepared ← open? source storage then
+        let current ← Index.open? source storage .shared
+        if prepared.metadata.bindings == current.map (·.index.head) then return true
@@ -192,2 +218,0 @@ def refresh (source : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Result
-  if let some ready ← open? source storage then
-    return {mode := "warm",metadata := ready.metadata,elapsedMs := (← IO.monoMsNow)-started}
@@ -196,0 +222,3 @@ def refresh (source : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Result
+  if let some ready ← open? source storage then
+    if ready.metadata.bindings == bindings.map (·.index.head) && ready.metadata.supplements == stamp then
+      return {mode := "warm",metadata := ready.metadata,elapsedMs := (← IO.monoMsNow)-started}

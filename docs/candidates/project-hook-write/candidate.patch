+module
+public import Lean
+@[expose] public section
+namespace Eggshell.ProcessGroup
+/-- The caller owns a child started with setsid. Other requests never close
+its handle or signal a replacement process through a reused registry name. -/
+def kill {cfg : IO.Process.StdioConfig} (child : IO.Process.Child cfg) : IO Unit := do
+  let killer ← IO.Process.spawn {
+    cmd := "/bin/kill",args := #["-KILL","--","-"++toString child.pid]
+    stdin := .null,stdout := .null,stderr := .null }
+  discard <| killer.wait
+  try child.kill catch _ => pure ()
+end Eggshell.ProcessGroup

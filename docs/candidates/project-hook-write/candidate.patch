+module
+public import Eggshell.ProjectGateway
+@[expose] public section
+namespace Eggshell.Plugin.ProjectIngress
+open Lean DB Publication Publication.Gateway
+def writer (pending : PendingTurn) : Except String (Captured × NamedManifest) := do
+  let some service := pending.service | throw "project writer has no captured service"
+  let some name := pending.projectWrite | throw "turn has no selected project writer"
+  unless pending.localWrite.isNone && service.write == some name do throw "ambiguous project writer"
+  let some envelope := pending.remoteFrame | throw "project writer has no captured read boundary"
+  let frame ← fromJson? (α := Captured) envelope.payload
+  unless frame.accepts service do throw "project writer changed its captured inventory"
+  let some project := frame.descriptor.projects.find? (·.name == name) | throw "captured writer is absent from its inventory"
+  return (frame,project)
+def directory (pending : PendingTurn) : IO (System.FilePath × String) := do
+  let (frame,project) ← IO.ofExcept (writer pending)
+  let occurrence := Blake3.hex (Blake3.digest "eggshell.private-native-ingress".toUTF8
+    [(toJson (frame.boundary.scope,pending.sessionId,pending.turnId)).compress.toUTF8])
+  let root := (← Paths.dataRoot)/"native-ingress"/project.manifest.identity/occurrence
+  return (root,"private-project-ingress:"++project.manifest.identity++":"++occurrence)
+/-- This source is an empty private anchor for one turn's native journal, not
+a local mirror or cache of the shared work graph. Atomic directory creation
+arbitrates first creation without a lock shared by other chats. -/
+def source (pending : PendingTurn) (create : Bool) : IO (Option PageMap.Snapshot) := do
+  let (directory,authority) ← directory pending
+  FileSystem.rejectSymlinkAncestors directory
+  let found ← PageMap.open? directory
+  let found ← match found with
+    | some source => pure (some source)
+    | none =>
+      if !create then pure none else do
+        FileSystem.privateDirectory (directory.parent.getD ".")
+        try some <$> PageMap.create directory authority
+        catch error =>
+          let some concurrent ← PageMap.open? directory | throw error
+          pure (some concurrent)
+  for source in found do
+    unless source.head.authority == authority && source.head.root.isNone do
+      throw (IO.userError "private ingress anchor is a foreign or nonempty original graph")
+  return found
+/-- A final answer may travel through the checkpoint queue. Its publication
+must still compile the complete turn, just as the local publication path does. -/
+def observationsOnly (pending : PendingTurn) (checkpoint : Bool) : Bool :=
+  checkpoint && pending.finalMessage.isNone
+theorem final_compiles_turn (pending : PendingTurn) (answer : String)
+    (final : pending.finalMessage = some answer) (checkpoint : Bool) :
+    observationsOnly pending checkpoint = false := by
+  simp [observationsOnly,final]
+def capsule (pending : PendingTurn) (checkpoint : Bool) : IO Capsule := do
+  discard <| IO.ofExcept (writer pending)
+  let anchor ← source pending false
+  let journal ← match anchor with
+    | none => pure none
+    | some anchor => Synapses.Journal.open? anchor
+  let items ← NativePublication.planUsing pending none journal
+  if matching : NativePublication.matchesPending pending items = true then
+    return Capsule.ofItems pending (observationsOnly pending checkpoint) items matching
+  else throw (IO.userError "remote publication changed its captured native observations")
+end Eggshell.Plugin.ProjectIngress

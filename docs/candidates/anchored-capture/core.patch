+/-- A separately prepared supplement is bound to the unchanged original
+capture. It contributes advisory coordinates, never a replacement producer. -/
+def catalogSupplement (database : String) (doc : Document) (captured : ContentCapture.Captured)
+    (supplement : ContentCapture.Supplement) : Except String ObservationContext.Catalog := do
+  let some raw := doc.source | throw "supplement lost original body"
+  unless supplement.sealed && supplement.boundTo captured raw &&
+      supplement.aliases.all (validAlias captured.inputs raw.toList.toArray) do
+    throw "unbound or unsealed content supplement"
+  catalog database doc {
+    implementation := supplement.implementation
+    inputs := captured.inputs
+    complete := true
+    aliases := supplement.aliases}
+
+/-- A prepared supplement lives with the synaptic publication that used it.
+Its original owner header is never rewritten. -/
+structure SupplementHeader where
+  original : Header
+  parent : String
+  parentProducer : String
+  deriving ToJson, FromJson
+
+def supplementKey (id : Nat) := "memo:content-supplement:owner:" ++ toString id
+def supplementStampKey := "memo:content-supplement:stamp"
+
+def supplementStamp (prepared : PageMap.Snapshot) : IO (Option String) := do
+  let some bytes ← prepared.get supplementStampKey | return none
+  let some stamp := String.fromUTF8? bytes | throw (IO.userError "invalid supplement stamp")
+  unless Synapses.digest stamp do throw (IO.userError "invalid supplement address")
+  return some stamp
+
+/-- Only explicit preparation supplies additions. The same transaction owns
+their chunks, directory, stamp, source postings and original read views. -/
+def stageSupplement (writer : PageMap.Writer) (database : String) (id : Nat) (doc : Document)
+    (captured : ContentCapture.Captured) (supplement : ContentCapture.Supplement) : IO Unit := do
+  let _ ← IO.ofExcept (catalogSupplement database doc captured supplement)
+  let mut chunks := #[]
+  for index in [: (supplement.aliases.size+chunkCount-1)/chunkCount] do
+    let aliases := supplement.aliases.extract (index*chunkCount) ((index+1)*chunkCount)
+    let bytes := (toJson aliases).compress.toUTF8
+    let digest := Sha256.hex bytes
+    let _ ← MetadataBytes.put writer (chunkKey digest) (← IO.ofExcept (MetadataBytes.checked bytes)) true
+    chunks := chunks.push digest
+  let header : SupplementHeader := {
+    original := ⟨database,doc.owner,doc.work,supplement.original,supplement.implementation,
+      captured.inputs,true,none,supplement.aliases.size,chunks⟩
+    parent := supplement.parent
+    parentProducer := supplement.parentProducer}
+  let bytes := (toJson header).compress.toUTF8
+  if ← MetadataBytes.put writer (supplementKey id) (← IO.ofExcept (MetadataBytes.checked bytes)) then
+    let previous ← writer.get supplementStampKey
+    let stamp := Sha256.hex (((previous.getD ByteArray.empty) ++ (toJson id).compress.toUTF8) ++ bytes)
+    writer.put supplementStampKey (some stamp.toUTF8)
+
+/-- Read committed coordinates only. No filesystem correspondence scan is
+reachable from this loader. The original DB/owner/Work/body/producer all bind it. -/
+def loadSupplement? (prepared : PageMap.Snapshot) (database : String) (id : Nat) (doc : Document)
+    (captured : ContentCapture.Captured) : IO (Option ContentCapture.Supplement) := do
+  let some payload ← MetadataBytes.get? prepared (supplementKey id) | return none
+  let header ← ObservedRecords.decode (α := SupplementHeader) payload.bytes
+  let some raw := doc.source | throw (IO.userError "supplement lost original native output")
+  unless header.original.boundTo database doc raw && header.original.inputs == captured.inputs do
+    throw (IO.userError "supplement belongs to another original")
+  let mut aliases := #[]
+  for digest in header.original.chunks do
+    unless Synapses.digest digest do throw (IO.userError "invalid supplement block address")
+    let some payload ← MetadataBytes.get? prepared (chunkKey digest) | throw (IO.userError "missing supplement block")
+    unless Sha256.hex payload.bytes == digest do throw (IO.userError "changed supplement block")
+    let rows ← ObservedRecords.decode (α := Array ContentCapture.Alias) payload.bytes
+    unless rows.size ≤ chunkCount do throw (IO.userError "foreign supplement block extent")
+    aliases := aliases ++ rows
+  unless aliases.size == header.original.aliases do throw (IO.userError "incomplete supplement directory")
+  let supplement : ContentCapture.Supplement := {
+    parent := header.parent
+    parentProducer := header.parentProducer
+    original := header.original.original
+    implementation := header.original.implementation
+    aliases
+    sealed := true}
+  let _ ← IO.ofExcept (catalogSupplement database doc captured supplement)
+  return some supplement
+
+def supplemented (prepared : Option PageMap.Snapshot) (database : String) (id : Nat)
+    (doc : Document) (captured : ContentCapture.Captured) : IO ContentCapture.Captured := do
+  let some prepared := prepared | return captured
+  let some extra ← loadSupplement? prepared database id doc captured | return captured
+  return {captured with aliases := captured.aliases ++ extra.aliases}
+
 end Eggshell.ContentMetadata

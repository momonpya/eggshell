+    (checked : supplement.boundTo captured raw = true) :
+    supplement.parent = captured.digest ∧ supplement.original = Sha256.hex raw.toUTF8 := by
+  unfold Supplement.boundTo at checked
+  have binding := of_decide_eq_true checked
+  exact ⟨binding.1,binding.2.1⟩

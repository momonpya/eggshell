+/-- Recorded coordinates are fixed anchors. An input export can omit files,
+so rescanning that export must never create a new globally unique anchor. -/
+def recordedAnchors (aliases : Array Alias) : Std.HashMap Synapses.ObservedRecords.Spelling (Option Alias) :=
+  aliases.foldl (fun directory alias => directory.insert alias.spelling
+    (match directory[alias.spelling]? with
+      | none => some alias
+      | some previous => previous.bind fun old => if old == alias then some old else none)) {}
+
+def correlate (workspace : System.FilePath) (inputs : Array SourceEvidence.File) (raw : String)
+    (recorded : Option (Array Alias)) (deadline : Nat) : IO (Option (Array Alias × Option String)) := do
+  let rows := outputs raw
+  let trie := Trie.prepare rows
+  let characters := raw.toList.toArray
+  let mut state := trie.start
+  for fileIndex in [:inputs.size] do
+    let some file := inputs[fileIndex]? | return none
+    let result ← try scan workspace file fileIndex trie state deadline catch _ => pure none
+    let some next := result | return none
+    state := next
+  let classified := rows.map (trie.matched? state)
+  let known := recordedAnchors (recorded.getD #[])
+  let lines := rows.mapIdx fun index row =>
+    let matched := classified[index]?.join
+    let previous := known[row.spelling]?.join
+    let count := (previous.map (·.chars)).or (matched.map Prod.snd)
+    let code := if row.text.isEmpty then some "" else count.map (suffix row.text)
+    let anchor := if recorded.isSome then previous.bind fun alias => do
+        let file ← inputs.findIdx? fun input => input.relative == alias.file.relative &&
+          input.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩
+        some (file,alias.line)
+      else matched.bind fun (candidate,_) => match candidate with
+        | .one position => some position
+        | _ => none
+    ({spelling := row.spelling,code,anchor} : ContentRuns.Line)
+  let probes := ContentRuns.probes characters lines
+  let requests := ContentRuns.wanted lines probes
+  let requestedFiles := Std.HashSet.ofList (requests.keys.map Prod.fst)
+  let mut samples : ContentRuns.Samples := {}
+  let mut refinement := Array.replicate rows.size Candidate.absent
+  let mut refinementFailure := none
+  if !probes.isEmpty then
+    let maxLine := rows.foldl (fun size row => max size row.text.utf8ByteSize) 0
+    let mut sealed := true
+    for fileIndex in [:inputs.size] do
+      let some file := inputs[fileIndex]? | do
+        sealed := false
+        break
+      if !requestedFiles.contains fileIndex then continue
+      let next ← try
+        scanUsing workspace file fileIndex maxLine (ContentRuns.observe requests) samples deadline
+      catch _ => pure none
+      let some next := next | do
+        sealed := false
+        break
+      samples := next
+    if sealed then refinement := ContentRuns.refine lines probes samples
+    else refinementFailure := some "run-refinement-unsealed"
+  let mut aliases := #[]
+  for index in [:rows.size] do
+    let some row := rows[index]? | continue
+    if recorded.isSome && known.contains row.spelling then continue
+    let matched := classified[index]?.join
+    let position := if recorded.isSome then none else matched.bind (fun (candidate,_) => match candidate with
+      | .one position => some position
+      | _ => none)
+    let some position := position.or (match refinement[index]? with
+      | some (.one position) => some position
+      | _ => none) | continue
+    let chars := if row.text.isEmpty then 0 else (matched.map Prod.snd).getD 0
+    if let some alias := alias? inputs characters row position chars then
+      aliases := aliases.push alias
+  return some (aliases,refinementFailure)
+
+def finish (workspace : System.FilePath) (captured : SourceEvidence.Capture)
+    (raw : String) (deadline : Nat) : IO Captured := do
+  let inputs := captured.record.files.toArray
+  let failed := fun reason => ({implementation,inputs := #[],complete := false,aliases := #[],failure := some reason} : Captured)
+  unless captured.record.valid && captured.record.files == captured.probes.map (·.file) do
+    return failed "input-not-captured"
+  unless raw.utf8ByteSize ≤ 2*1024*1024 do return failed "output-budget"
+  let some (aliases,failure) ← correlate workspace inputs raw none deadline | return failed "input-not-sealed"
+  let referenced := inputs.filter fun input => aliases.any fun alias =>
+    input.relative == alias.file.relative && input.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩
+  return ⟨implementation,referenced,true,aliases,failure⟩
+
+def refineSaved (workspace : System.FilePath) (captured : Captured) (raw : String)
+    (deadline : Nat) : IO Supplement := do
+  let result : Supplement := {
+    parent := captured.digest
+    parentProducer := captured.implementation
+    original := Sha256.hex raw.toUTF8
+    implementation}
+  let characters := raw.toList.toArray
+  unless captured.complete && raw.utf8ByteSize ≤ 2*1024*1024 && captured.aliases.all (fun alias =>
+      alias.file.valid && 0 < alias.line && (code? characters alias).isSome && captured.inputs.any (fun input =>
+        input.relative == alias.file.relative && input.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩)) do
+    return {result with failure := some "unbound-recorded-anchors"}
+  let some (aliases,failure) ← correlate workspace captured.inputs raw (some captured.aliases) deadline |
+    return {result with failure := some "recorded-input-not-sealed"}
+  return {result with aliases,sealed := failure.isNone,failure}
+

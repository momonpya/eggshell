+module
+public import Eggshell.ObservedRecords
+public import tools.ContentCorrespondence
+@[expose] public section
+
+namespace Eggshell.ContentRuns
+open Synapses.ObservedRecords ContentCorrespondence
+
+structure Line where
+  spelling : Spelling
+  code : Option String
+  anchor : Option Position
+
+structure Probe (size : Nat) where
+  file : Nat
+  first : Nat
+  rows : Array (Fin size)
+  backwards : Bool
+
+/-- Only neighboring records in one literal representation can extend an
+anchor. JSON punctuation, missing output, and unmatched records break runs. -/
+def adjacent (characters : Array Char) (left right : Line) : Bool := Id.run do
+  unless left.code.isSome && right.code.isSome && left.spelling.limit == right.spelling.first &&
+      left.spelling.projection == right.spelling.projection do return false
+  let projection ← match left.spelling.projection with
+    | .rawLine => pure Projection.raw
+    | .stringBodyLine => pure Projection.stringBody
+    | _ => return false
+  return ((project characters {left.spelling with projection}).map (·.endsWith "\n")).getD false
+
+/-- Each ambiguous gap is visited only from its immediate unique neighbors.
+No whole input file, pairwise alignment table or guessed line number is used. -/
+def probes (characters : Array Char) (lines : Array Line) : Array (Probe lines.size) := Id.run do
+  let mut result := #[]
+  for projection in [Projection.rawLine,Projection.stringBodyLine] do
+    let order := (((List.finRange lines.size).filter fun index =>
+      lines[index].spelling.projection == projection).mergeSort fun a b =>
+        lines[a].spelling.first ≤ lines[b].spelling.first).toArray
+    for place in [:order.size] do
+      let some center := order[place]? | continue
+      let some position := lines[center].anchor | continue
+      let mut first := place
+      while 0 < first do
+        let some previous := order[first-1]? | break
+        let some next := order[first]? | break
+        unless lines[previous].anchor.isNone && adjacent characters lines[previous] lines[next] do break
+        first := first-1
+      first := max first (place+1-position.2)
+      if first < place then
+        result := result.push ⟨position.1,position.2-(place-first),order.extract first (place+1),true⟩
+      let mut last := place+1
+      while last < order.size do
+        let some previous := order[last-1]? | break
+        let some next := order[last]? | break
+        unless lines[next].anchor.isNone && adjacent characters lines[previous] lines[next] do break
+        last := last+1
+      if place+1 < last then
+        result := result.push ⟨position.1,position.2,order.extract place last,false⟩
+  return result
+
+abbrev Wanted := Std.HashMap Position (Std.HashSet String)
+abbrev Samples := Std.HashMap Position String
+
+def wanted (lines : Array Line) (probes : Array (Probe lines.size)) : Wanted := Id.run do
+  let mut requests : Wanted := {}
+  for probe in probes do
+    for (index,offset) in probe.rows.zipIdx do
+      let some code := lines[index].code | continue
+      let position := (probe.file,probe.first+offset)
+      requests := requests.insert position ((requests[position]?.getD {}).insert code)
+  return requests
+
+/-- Keep only acquired rows equal to a requested output row. Retained input
+bytes are bounded by the output runs, even if unrelated input rows are huge. -/
+def observe (wanted : Wanted) (samples : Samples) (position : Position) (text : String) : Samples :=
+  if (wanted[position]?.getD {}).contains text then samples.insert position text else samples
+
+/-- Reuse the checked anchored-run kernel on the bounded acquired segment.
+The adapter supplies the globally unique anchor and absolute file position. -/
+def checkedRun? (source output : Array String) (anchorIndex : Nat) :
+    Option (Run #[source] output 0 0 0 output.size) := do
+  if within : anchorIndex < output.size then
+    let index ← ContentCorrespondence.prepare? #[source]
+    let anchor ← index.unique? output[anchorIndex]
+    if position : anchor.position = (0,anchorIndex) then
+      let checked ← anchoredRun? index output ⟨anchorIndex,within⟩ anchor 0 output.size
+      pure (by simpa only [position,Prod.fst,Prod.snd,Nat.sub_zero,Nat.sub_self] using checked.original)
+    else none
+  else none
+
+theorem checked_run_original (run : Run #[source] output 0 0 0 output.size)
+    (offset : Fin output.size) :
+    source[offset.val]? = some output[offset] := by
+  have bound : output.size ≤ source.size := by simpa using run.sourceEnd
+  have within : offset.val < source.size := Nat.lt_of_lt_of_le offset.isLt bound
+  have same : source[offset.val] = output[offset] := by simpa using run.original offset
+  simp only [Array.getElem?_eq_getElem within,same]
+
+/-- A mismatch ends an anchored prefix; matches beyond that gap cannot be
+borrowed. Conflicting verified anchors remain ambiguous rather than win by order. -/
+def refine (lines : Array Line) (probes : Array (Probe lines.size)) (samples : Samples) : Array Candidate := Id.run do
+  let mut result := Array.replicate lines.size Candidate.absent
+  for probe in probes do
+    let mut count := 0
+    for step in [:probe.rows.size] do
+      let offset := if probe.backwards then probe.rows.size-1-step else step
+      let some index := probe.rows[offset]? | break
+      let some expected := lines[index].code | break
+      unless samples[(probe.file,probe.first+offset)]? == some expected do break
+      count := count+1
+    if count < 2 then continue
+    let start := if probe.backwards then probe.rows.size-count else 0
+    let selected := probe.rows.extract start (start+count)
+    let some expected := selected.mapM (fun index => lines[index].code) | continue
+    let some original := selected.mapIdxM (fun offset _ => samples[(probe.file,probe.first+start+offset)]?) | continue
+    let anchorIndex := if probe.backwards then expected.size-1 else 0
+    let some _ := checkedRun? original expected anchorIndex | continue
+    for (index,offset) in selected.zipIdx do
+      if lines[index].anchor.isSome then continue
+      result := result.modify index.val (fun previous =>
+        previous.join (.one (probe.file,probe.first+start+offset)))
+  return result
+
+end Eggshell.ContentRuns

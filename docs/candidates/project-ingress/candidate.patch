+def Entry.forSource (entry : Entry) (database : String) : Option Entry :=
+  match entry.payload with
+  | .start occurrence work query known => (known.forSource database).map fun selected =>
+      {entry with payload := .start occurrence work query selected}
+  | .answer occurrence query text known => (known.forSource database).map fun selected =>
+      {entry with payload := .answer occurrence query text selected}
+  | .finish .. => some entry
+
+theorem Entry.forSource_clock (entry selected : Entry) (database : String)
+    (accepted : entry.forSource database = some selected) :
+    selected.clock = entry.clock ∧ selected.receivedUnixMs = entry.receivedUnixMs := by
+  cases entry with | mk clock payload received =>
+    cases payload with
+    | start occurrence work query known =>
+      simp only [forSource] at accepted
+      cases found : known.forSource database with
+      | none => simp [found] at accepted
+      | some selectedKnown =>
+        simp only [found,Option.map_some,Option.some.injEq] at accepted
+        rw [← accepted]
+        exact ⟨rfl,rfl⟩
+    | answer occurrence query text known =>
+      simp only [forSource] at accepted
+      cases found : known.forSource database with
+      | none => simp [found] at accepted
+      | some selectedKnown =>
+        simp only [found,Option.map_some,Option.some.injEq] at accepted
+        rw [← accepted]
+        exact ⟨rfl,rfl⟩
+    | finish occurrence name input response archive =>
+      simp only [forSource,Option.some.injEq] at accepted
+      rw [← accepted]
+      exact ⟨rfl,rfl⟩
+

+structure ImportCursor where
+  journal : PageMap.Head
+  next : Nat
+  deriving BEq, ToJson, FromJson
+
+structure ImportResult where
+  examined : Nat := 0
+  added : Nat := 0
+  unrelated : Nat := 0
+  indirect : Nat := 0
+  complete : Bool := false
+  deriving ToJson, FromJson
+
+def importKey (owner : Sidecar.Owner) := "ingress:"++Index.contentKey owner
+def importEnd (start count limit : Nat) := min count (start+limit)
+
+theorem importEnd_bounded (start count limit : Nat) : importEnd start count limit ≤ start+limit :=
+  Nat.min_le_right _ _
+
+theorem importEnd_not_backwards (start count limit : Nat) (within : start ≤ count) :
+    start ≤ importEnd start count limit := by simp only [importEnd]; omega
+
+/-- Validate a native event against its committed per-turn append receipt,
+including late insertion floors and the original observation clock. -/
+def checkOriginalEntry (journal : PageMap.Snapshot) (ordinal : Nat) (value : Entry) : IO Unit := do
+  let some raw ← journal.get (key "event-sequence" ordinal) |
+    throw (IO.userError "native ingress has no inverse sequence receipt")
+  let sequence ← IO.ofExcept (payloadSize (some raw))
+  let found ← receipt journal value.turn sequence
+  let before ← if sequence == 0 then pure (Frontier.initial journal value.turn)
+    else pure (← receipt journal value.turn (sequence-1)).next
+  unless found.ordinal == ordinal && found.previous == before.chain &&
+      found.next == before.step ordinal value do
+    throw (IO.userError "native ingress entry changed its committed append chain")

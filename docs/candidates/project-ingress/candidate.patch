+/-- Private one-hop references retain the original journal's exact immutable
+head. They are never placed in shared source publication or a model prompt. -/
+structure EntryReference where
+  owner : Sidecar.Owner
+  journal : PageMap.Head
+  ordinal : Nat
+  target : String
+  original : String
+  projected : String
+  deriving BEq, ToJson, FromJson
+
+def referenceKey (ordinal : Nat) := key "entry-reference" ordinal
+
+def loadReference (journal : PageMap.Snapshot) (reference : EntryReference) : IO Entry := do
+  unless journal.head.authority == "private-synaptic-events:"++reference.target &&
+      reference.journal.authority == "private-synaptic-events:"++reference.owner.database &&
+      reference.journal.identity != journal.head.identity && digest reference.original && digest reference.projected do
+    throw (IO.userError "private event reference crossed its original or target scope")
+  let owner ← reference.owner.pin
+  let some current ← open? owner | throw (IO.userError "referenced private ingress is unavailable")
+  let some retained ← PageMap.HistoryReader.make? current reference.journal |
+    throw (IO.userError "referenced private ingress head is unavailable")
+  let original := retained.snapshot
+  unless reference.ordinal < (← getNat original.get "count") &&
+      (← original.get (referenceKey reference.ordinal)).isNone do
+    throw (IO.userError "private event reference is not one original hop")
+  let value ← rawEntry original reference.ordinal
+  unless Index.contentKey value == reference.original do throw (IO.userError "private event original digest changed")
+  let some projected := value.forSource reference.target |
+    throw (IO.userError "private event did not observe the requested source")
+  unless Index.contentKey projected == reference.projected do throw (IO.userError "private event source projection changed")
+  return projected
+
+def entry (journal : PageMap.Snapshot) (ordinal : Nat) : IO Entry := do
+  let some bytes ← journal.get (referenceKey ordinal) | return ← rawEntry journal ordinal
+  unless bytes.size ≤ 16384 do throw (IO.userError "oversized private event reference")
+  let reference ← Index.decode (α := EntryReference) bytes
+  unless (toJson reference).compress.toUTF8 == bytes do throw (IO.userError "noncanonical private event reference")
+  let projected ← loadReference journal reference
+  unless (toJson projected).compress.utf8ByteSize == (← getNat journal.get (key "entry" ordinal)) do
+    throw (IO.userError "private event reference changed its original byte accounting")
+  return projected
+
+/-- A bounded importer may stage several events under the same private commit.
+The receipt chain is computed from the decoded event, never its alias encoding. -/
+def stageEntry (journal : PageMap.Snapshot) (writer : PageMap.Writer) (value : Entry)
+    (store : Nat → IO Unit) : IO Bool := do
+  let name := "event:"++value.name
+  if let some previous ← writer.get name then
+    let ordinal ← IO.ofExcept (payloadSize (some previous))
+    unless ordinal < (← getNat journal.get "count") do
+      throw (IO.userError "one ingress batch repeated a native event identity")
+    let saved ← entry journal ordinal
+    unless saved.name == value.name do throw (IO.userError "ambiguous event digest")
+    let _ ← IO.ofExcept (retainFirst saved value)
+    return false
+  let ordinal ← getNat writer.get "count"
+  let turn := value.turn
+  let previous ← match ← frontierUsing? writer.get turn with
+    | some previous => pure previous
+    | none => do
+        if (← writer.get ("turn:"++turn.name)).isSome then throw (IO.userError "active turn has no canonical append feed")
+        pure (Frontier.initial journal turn)
+  let next := previous.step ordinal value
+  store ordinal
+  putNat writer name ordinal
+  putNat writer "count" (ordinal+1)
+  writer.put ("turn:"++turn.name) (some (toJson turn).compress.toUTF8)
+  putNat writer (key ("posting:"++turn.name) ordinal) ordinal
+  putNat writer ("latest:"++turn.name) (ordinal+1)
+  writer.put (receiptKey turn previous.count) (some (toJson ({previous := previous.chain,ordinal,next} : Receipt)).compress.toUTF8)
+  putNat writer (key "event-sequence" ordinal) previous.count
+  writer.put (frontierKey turn) (some (toJson next).compress.toUTF8)
+  for storage in [Sidecar.Storage.database,.user] do
+    let base := workBase storage
+    if (← writer.get (base++":bootstrap")).isSome then ReplayWork.enqueue writer base turn.name
+  return true

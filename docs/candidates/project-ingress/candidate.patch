+def Knowledge.forSource (known : Knowledge) (database : String) : Option Knowledge :=
+  if known.source.identity == database then some {known with related := #[]}
+  else (known.related.find? (·.source.identity == database)).map fun saved =>
+    {known with source := saved.source,indexed := saved.indexed,related := #[]}
+
+theorem Knowledge.forSource_identity (known : Knowledge) (database : String) (selected : Knowledge)
+    (accepted : known.forSource database = some selected) : selected.source.identity = database := by
+  unfold forSource at accepted
+  split at accepted
+  · rename_i present
+    simp only [Option.some.injEq] at accepted
+    rw [← accepted]
+    simpa only [beq_iff_eq] using present
+  · cases found : known.related.find? (·.source.identity == database) with
+    | none => simp [found] at accepted
+    | some saved =>
+      have member := Array.find?_some found
+      simp only [found,Option.map_some,Option.some.injEq] at accepted
+      cases accepted
+      simpa using member
+
+theorem Knowledge.forSource_context (known : Knowledge) (database : String) (selected : Knowledge)
+    (accepted : known.forSource database = some selected) :
+    selected.acknowledged = known.acknowledged ∧ selected.uncertain = known.uncertain ∧
+    selected.archive = known.archive ∧ selected.archived = known.archived ∧ selected.delivery = known.delivery := by
+  unfold forSource at accepted
+  split at accepted
+  · simp only [Option.some.injEq] at accepted
+    rw [← accepted]
+    exact ⟨rfl,rfl,rfl,rfl,rfl⟩
+  · cases found : known.related.find? (·.source.identity == database) with
+    | none => simp [found] at accepted
+    | some saved =>
+      simp only [found,Option.map_some,Option.some.injEq] at accepted
+      rw [← accepted]
+      exact ⟨rfl,rfl,rfl,rfl,rfl⟩
+

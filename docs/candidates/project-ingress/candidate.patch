+/-- Import only one bounded metadata slice. Original bodies stay in the one
+native journal; aliases and their exact original cursor commit together. -/
+def importFeed (source : PageMap.Snapshot) (owner : Sidecar.Owner) (deadline : Nat)
+    (limit : Nat := 32) : IO ImportResult := do
+  unless source.head.identity != owner.database do
+    throw (IO.userError "an ingress source cannot alias its own journal")
+  let originalSource ← owner.pin
+  let some original ← open? originalSource | return {complete := false}
+  let count ← getNat original.get "count"
+  withPublication source fun target => do
+    let old ← (← target.get (importKey owner)).mapM (Index.decode (α := ImportCursor))
+    if let some old := old then
+      unless old.next ≤ count && old.journal.identity == original.head.identity &&
+          old.journal.authority == original.head.authority &&
+          (← PageMap.HistoryReader.make? original old.journal).isSome do
+        throw (IO.userError "private ingress import lost its exact original prefix")
+    let start := old.map (·.next) |>.getD 0
+    let finish := importEnd start count (min 256 limit)
+    if start == count then return {complete := true}
+    let mut prepared : Array (Entry × EntryReference) := #[]
+    let mut result : ImportResult := {}
+    let mut next := start
+    let mut bytes := 0
+    for ordinal in [start:finish] do
+      if (← IO.monoMsNow) ≥ deadline then break
+      if (← original.get (referenceKey ordinal)).isSome then
+        result := {result with examined := result.examined+1,indirect := result.indirect+1}
+        next := ordinal+1
+        continue
+      let size ← getNat original.get (key "entry" ordinal)
+      unless size ≤ maxBytes do throw (IO.userError "native ingress entry exceeds its original byte budget")
+      if bytes+size > 16*1024*1024 then break
+      let value ← rawEntry original ordinal
+      checkOriginalEntry original ordinal value
+      let related ← match value.payload with
+        | .finish occurrence .. => do
+          match ← lookup? original "start" occurrence with
+          | some first => pure ((first.forSource source.head.identity).isSome)
+          | none => pure true -- Preserve an early Post as unknown until Pre arrives.
+        | _ => pure true
+      let projected := if related then value.forSource source.head.identity else none
+      if let some projected := projected then
+        unless projected.payload.valid source.head.identity do
+          throw (IO.userError "projected ingress changed its original source knowledge")
+        let reference : EntryReference := ⟨owner,original.head,ordinal,source.head.identity,
+          Index.contentKey value,Index.contentKey projected⟩
+        prepared := prepared.push (projected,reference)
+      else result := {result with unrelated := result.unrelated+1}
+      result := {result with examined := result.examined+1}
+      bytes := bytes+size
+      next := ordinal+1
+    if next == start then return result
+    let cursor : ImportCursor := ⟨original.head,next⟩
+    let (added,_,_) ← PageMap.withWriter target fun writer => do
+      let mut added := 0
+      for (value,reference) in prepared do
+        let referenceBytes := (toJson reference).compress.toUTF8
+        unless referenceBytes.size ≤ 16384 do throw (IO.userError "oversized private ingress alias")
+        let found ← stageEntry target writer value fun ordinal => do
+          putNat writer (key "entry" ordinal) (toJson value).compress.utf8ByteSize
+          writer.put (referenceKey ordinal) (some referenceBytes)
+        if found then added := added+1
+      writer.put (importKey owner) (some (toJson cursor).compress.toUTF8)
+      return added
+    return {result with added,complete := next == count}
+

+module
+
+public import Eggshell.PreparationPlan
+public import Eggshell.Warm
+
+@[expose] public section
+namespace Eggshell.Plugin.PreparationRegistry
+open Lean DB Synapses
+
+def indexTarget (job : PreparationPlan.Job) : IO IndexTarget :=
+  IO.ofExcept (job.payload.getObjVal? "target" >>= fromJson? (α := IndexTarget))
+
+def synapticTarget (job : PreparationPlan.Job) : IO Journal.Target :=
+  IO.ofExcept (job.payload.getObjVal? "target" >>= fromJson? (α := Journal.Target))
+
+def synaptic (job : PreparationPlan.Job) : Bool :=
+  (job.payload.getObjValAs? String "kind").toOption == some "synapses"
+
+/-- Only authenticated local administration can request these private registry
+records. No caller-supplied command, original payload or arbitrary path is used. -/
+def request (kind key : String) : IO PreparationPlan.Job := do
+  unless Receipt.validId key do throw (IO.userError "invalid preparation registry key")
+  let (payload,source,storage,numerical) ← if kind == "index" then do
+      let path := (← indexRegistry)/(key++".json")
+      FileSystem.rejectSymlinkAncestors path
+      let target ← (readBoundedJson path 65536 : IO IndexTarget)
+      unless target.key == key do throw (IO.userError "preparation index registry identity changed")
+      let source ← target.owner.pin
+      pure (Json.mkObj [("target",toJson target)],source,target.storage,!Warm.lexicalOnly target.command)
+    else if kind == "synapses" then do
+      let path := (← Journal.registry)/(key++".json")
+      FileSystem.rejectSymlinkAncestors path
+      let target ← (readBoundedJson path 65536 : IO Journal.Target)
+      unless Index.contentKey target == key do throw (IO.userError "preparation synaptic registry identity changed")
+      let source ← target.owner.pin
+      pure (Json.mkObj [("kind",toJson "synapses"),("target",toJson target)],source,target.storage,false)
+    else throw (IO.userError "unknown preparation registry")
+  let sidecar ← Sidecar.locate source storage
+  let semantic := if numerical then some sidecar.semantic.toString else none
+  let identity := kind++":"++key
+  let bytes := (toJson (identity,source.head.identity,semantic,payload)).compress.utf8ByteSize
+  unless bytes ≤ 65536 do throw (IO.userError "preparation metadata exceeds its bound")
+  return ⟨identity,source.head.identity,semantic,payload,bytes,0,0⟩
+
+def indexPaths (target : IndexTarget) (source : PageMap.Snapshot) : IO (List System.FilePath) := do
+  let path ← target.indexes source
+  if !(← path.pathExists) then return []
+  let entries ← path.readDir
+  return ((entries.toList.filter (·.fileName.endsWith ".json")).mergeSort
+    (fun a b => a.fileName ≤ b.fileName)).take 8 |>.map (·.path)
+
+def complete (job : PreparationPlan.Job) : IO Bool := do
+  if synaptic job then
+    let target ← synapticTarget job
+    let source ← target.owner.pin
+    let feed ← target.ingress.mapM (Journal.feedRequired source)
+    return !feed.getD false && !(← Journal.required source target.storage)
+  let target ← indexTarget job
+  let source ← target.owner.pin
+  if !(← indexPaths target source).isEmpty then return false
+  if ← Warm.required target source then return false
+  return !(← Build.required source target.storage) && !(← Journal.required source target.storage)
+
+def explain (job : PreparationPlan.Job) : IO Json := do
+  if synaptic job then
+    let target ← synapticTarget job
+    let source ← target.owner.pin
+    let feed ← target.ingress.mapM (Journal.feedRequired source)
+    let journal ← Journal.open? source
+    let checkpoint ← journal.bindM fun journal => Journal.checkpoint? journal ("checkpoint:"++Journal.lane target.storage)
+    return Json.mkObj [("journal",toJson (← Journal.required source target.storage)),
+      ("checkpointCurrent",toJson (← Journal.checkpointCurrent source target.storage)),
+      ("external",toJson (checkpoint.map (·.external))),
+      ("feed",toJson feed),("source",toJson source.head.identity),("storage",toJson target.storage)]
+  let target ← indexTarget job
+  let source ← target.owner.pin
+  return Json.mkObj [("tickets",toJson (← indexPaths target source).length),
+    ("warm",toJson (← Warm.required target source)),("synapses",toJson (← Build.required source target.storage)),
+    ("journal",toJson (← Journal.required source target.storage)),("source",toJson source.head.identity),
+    ("storage",toJson target.storage)]
+
+/-- Called only after a completed replay attempt, not instead of external
+dependency validation. `complete` remains the conservative scheduling probe. -/
+def drained (job : PreparationPlan.Job) : IO Bool := do
+  if synaptic job then
+    let target ← synapticTarget job
+    let source ← target.owner.pin
+    let feed ← target.ingress.mapM (Journal.feedRequired source)
+    return !feed.getD false && (← Journal.checkpointCurrent source target.storage)
+  let target ← indexTarget job
+  let source ← target.owner.pin
+  if !(← indexPaths target source).isEmpty then return false
+  return !(← Warm.required target source) && !(← Build.required source target.storage) &&
+    (← Journal.checkpointCurrent source target.storage)
+
+/-- Discovery of current debt is service-side. A source change after completion
+does not acknowledge preparation of that new source; it remains durable debt. -/
+def workerPayload (job : PreparationPlan.Job) : IO (Option Json) := do
+  if ← complete job then return none
+  if synaptic job then return some job.payload
+  let target ← indexTarget job
+  let source ← target.owner.pin
+  let paths ← indexPaths target source
+  let warm := (← Warm.required target source) || (← Build.required source target.storage) ||
+    (← Journal.required source target.storage)
+  return some (job.payload.setObjVal! "warm" (toJson warm)
+    |>.setObjVal! "paths" (toJson (paths.map (·.toString))))
+

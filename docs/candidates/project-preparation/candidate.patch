+module
+
+public import Eggshell.PreparationRegistry
+public import Eggshell.Worker
+
+@[expose] public section
+namespace Eggshell.Plugin.PreparationService
+open Lean
+
+structure Pool where
+  state : Std.Mutex PreparationPlan.State
+  lastRetry : Std.Mutex (Option Json)
+
+def Pool.new : IO Pool := return ⟨← Std.Mutex.new PreparationPlan.initial,← Std.Mutex.new none⟩
+
+def Pool.notify (pool : Pool) (kind key : String) : IO Bool := do
+  let job ← PreparationRegistry.request kind key
+  pool.state.atomically do
+    let (next,admitted) := PreparationPlan.notify (← get) job
+    set next
+    return admitted
+
+def Pool.take (pool : Pool) (lane : PreparationPlan.Lane) : IO (Option PreparationPlan.Active) := do
+  let now ← IO.monoMsNow
+  pool.state.atomically do
+    let (next,job) := PreparationPlan.take (← get) lane now
+    set next
+    return job
+
+/-- Long IO is outside the scheduling gate. Three stable lane identities own
+three worker pipes for the service, independent of chat count. -/
+def Pool.run (pool : Pool) (lane : PreparationPlan.Lane) (active : PreparationPlan.Active) : IO Unit := do
+  let complete ← try
+    let payload ← IO.ofExcept (PreparationRegistry.invocation active.job)
+    let response ← Worker.exchange s!"project-preparation-{lane.val}" "index" payload ((← IO.monoMsNow)+60000)
+    let complete := response.any (fun reply => (fromJson? reply : Except String Bool).toOption == some true)
+    if !complete then
+      let reason := response.map (fun reply => (reply.compress.take 512).toString) |>.getD "worker unavailable"
+      pool.lastRetry.atomically (set (some (Json.mkObj [("key",toJson active.job.key),("reason",toJson reason)])))
+    pure complete
+    catch _ =>
+      pool.lastRetry.atomically (set (some (Json.mkObj [("key",toJson active.job.key),("reason",toJson "preparation invocation failed")])) )
+      pure false
+  let now ← IO.monoMsNow
+  pool.state.atomically do
+    modify fun state => PreparationPlan.finish state lane active.token now complete
+
+def Pool.close (pool : Pool) : IO Unit :=
+  pool.state.atomically (modify PreparationPlan.close)
+
+def Pool.stats (pool : Pool) : IO Json := do
+  let state ← pool.state.atomically do return PreparationPlan.stats (← get)
+  return state.setObjVal! "lastRetry" (toJson (← pool.lastRetry.atomically get))
+
+end Eggshell.Plugin.PreparationService

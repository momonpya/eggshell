+module
+
+public import Lean.Data.Json.FromToJson
+public import Init.Data.Vector.Basic
+
+@[expose] public section
+namespace Eggshell.PreparationPlan
+open Lean
+
+def workers : Nat := 3
+def maxRequests : Nat := 1024
+def maxBytes : Nat := 8*1024*1024
+abbrev Lane := Fin workers
+
+def Wake.needed (observed : String) (acknowledged : Option String) : Bool := acknowledged != some observed
+def Wake.record (observed : String) (before : Option String) (accepted : Bool) : Option String :=
+  if accepted then some observed else before
+
+theorem Wake.failed_is_pending (observed : String) (before : Option String) :
+    Wake.record observed before false = before := rfl
+
+theorem Wake.newer_is_pending (observed newer : String) (before : Option String)
+    (different : newer ≠ observed) : Wake.needed newer (Wake.record observed before true) = true := by
+  simp [Wake.needed,Wake.record,Ne.symm different]
+
+/-- Registry metadata only. Its worker payload contains no original output. -/
+structure Job where
+  key : String
+  source : String
+  semantic : Option String
+  payload : Json
+  bytes : Nat
+  notBefore : Nat := 0
+  attempts : Nat := 0
+
+def Job.same (left right : Job) : Bool :=
+  left.key == right.key && left.source == right.source && left.semantic == right.semantic &&
+    left.payload == right.payload && left.bytes == right.bytes
+
+def Job.independent (left right : Job) : Bool :=
+  left.source != right.source &&
+    (left.semantic.isNone || right.semantic.isNone || left.semantic != right.semantic)
+
+structure Active where
+  job : Job
+  token : Nat
+
+structure Contents where
+  pending : Array Job := #[]
+  running : Vector (Option Active) workers := Vector.replicate workers none
+  nextToken : Nat := 0
+  closed : Bool := false
+  accepted : Nat := 0
+  coalesced : Nat := 0
+  rejected : Nat := 0
+  finished : Nat := 0
+  retried : Nat := 0
+  peakActive : Nat := 0
+
+def Contents.active (state : Contents) : Array Active := state.running.toArray.filterMap id
+def Contents.count (state : Contents) := state.pending.size+state.active.size
+def Contents.charge (state : Contents) :=
+  state.pending.foldl (fun total job => total+job.bytes) 0+
+    state.active.foldl (fun total running => total+running.job.bytes) 0
+
+/-- These bounds cover resident scheduling metadata, not arbitrary worker IO. -/
+structure State where
+  contents : Contents
+  countBound : contents.count ≤ maxRequests
+  byteBound : contents.charge ≤ maxBytes
+
+@[no_expose] def initial : State := ⟨{},by decide,by decide⟩
+
+private def checkedState (contents : Contents) : Option State :=
+  if countBound : contents.count ≤ maxRequests then
+    if byteBound : contents.charge ≤ maxBytes then some ⟨contents,countBound,byteBound⟩ else none
+  else none
+
+theorem requests_bounded (state : State) : state.contents.count ≤ maxRequests := state.countBound
+theorem metadata_bounded (state : State) : state.contents.charge ≤ maxBytes := state.byteBound
+theorem worker_slots_bounded (state : State) : state.contents.running.size = workers := rfl
+
+theorem active_workers_bounded (state : State) : state.contents.active.size ≤ workers := by
+  simpa [Contents.active] using
+    (Array.size_filterMap_le (f := id) (xs := state.contents.running.toArray))
+
+/-- An active request is not pending: another wake during execution must survive.
+If admission is full, the caller retains its durable registry/ticket work. -/
+@[no_expose] def notify (state : State) (job : Job) : State × Bool := Id.run do
+  let before := state.contents
+  if before.closed then return (state,false)
+  if let some old := before.pending.find? (·.key == job.key) then
+    if !old.same job then return (state,false)
+    let next := {before with coalesced := before.coalesced+1}
+    let some next := checkedState next | return (state,false)
+    return (next,true)
+  let next := {before with pending := before.pending.push job,accepted := before.accepted+1}
+  if let some next := checkedState next then return (next,true)
+  let some next := checkedState {before with rejected := before.rejected+1} | return (state,false)
+  return (next,false)
+
+@[no_expose] def take (state : State) (lane : Lane) (now : Nat) : State × Option Active := Id.run do
+  let before := state.contents
+  if before.closed || before.running[lane].isSome then return (state,none)
+  let active := before.active
+  let some position := before.pending.findIdx? (fun job =>
+      job.notBefore ≤ now && active.all (fun running => job.independent running.job)) |
+    return (state,none)
+  let some job := before.pending[position]? | return (state,none)
+  let running : Active := ⟨job,before.nextToken⟩
+  let next := {
+    before with
+    pending := before.pending.extract 0 position ++ before.pending.extract (position+1) before.pending.size
+    running := before.running.set lane (some running)
+    nextToken := before.nextToken+1
+    peakActive := max before.peakActive (active.size+1)}
+  let some next := checkedState next | return (state,none)
+  return (next,some running)
+
+/-- A matching lane token is the only completion capability. A closed queue
+never retries. Clearing an active slot leaves room to requeue its own charge. -/
+@[no_expose] def finish (state : State) (lane : Lane) (token now : Nat) (complete : Bool) : State := Id.run do
+  let before := state.contents
+  let some active := before.running[lane] | return state
+  if active.token != token then return state
+  let next := {
+    before with
+    running := before.running.set lane none
+    finished := before.finished+(if complete then 1 else 0)
+    retried := before.retried+(if !complete && !before.closed then 1 else 0)}
+  let next := if complete || next.closed || next.pending.any (·.key == active.job.key) then next else
+    let job := {active.job with
+      attempts := active.job.attempts+1
+      notBefore := now+min 5000 (50*2^(min active.job.attempts 7))}
+    {next with pending := next.pending.push job}
+  let some next := checkedState next | return state
+  return next
+
+def close (state : State) : State := by
+  let next := {state.contents with pending := #[],closed := true}
+  refine ⟨next,?_,?_⟩
+  · have small : state.contents.active.size ≤ maxRequests := by
+      have bound := state.countBound
+      change state.contents.pending.size+state.contents.active.size ≤ maxRequests at bound
+      omega
+    simpa [next,Contents.count,Contents.active] using small
+  · have small : state.contents.active.foldl (fun total running => total+running.job.bytes) 0 ≤ maxBytes := by
+      have bound := state.byteBound
+      unfold Contents.charge at bound
+      omega
+    simpa [next,Contents.charge,Contents.active] using small
+
+theorem close_is_terminal (state : State) : (close state).contents.closed = true := rfl
+
+theorem closed_refuses_notification (state : State) (job : Job) (closed : state.contents.closed = true) :
+    (notify state job).2 = false := by simp [notify,closed]
+
+theorem closed_starts_no_work (state : State) (lane : Lane) (now : Nat) :
+    (take (close state) lane now).2 = none := by simp [take,close]
+
+def stats (state : State) : Json :=
+  let value := state.contents
+  Json.mkObj [("pending",toJson value.pending.size),("active",toJson value.active.size),
+    ("residentBytes",toJson value.charge),("maxRequests",toJson maxRequests),("maxBytes",toJson maxBytes),
+    ("workers",toJson workers),("accepted",toJson value.accepted),("coalesced",toJson value.coalesced),
+    ("rejected",toJson value.rejected),("finishedAttempts",toJson value.finished),
+    ("retries",toJson value.retried),("peakActive",toJson value.peakActive),("closed",toJson value.closed)]
+
+end Eggshell.PreparationPlan

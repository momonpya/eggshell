diff --git a/Eggshell/ContractAudit.lean b/Eggshell/ContractAudit.lean
index 5340949a..1401df45 100644
--- a/Eggshell/ContractAudit.lean
+++ b/Eggshell/ContractAudit.lean
@@ -12,0 +13 @@ import all Eggshell.PreparationService
+import all Eggshell.PublicationService
@@ -18,0 +20,21 @@ open Lean
+run_meta do
+  let environment ← getEnv
+  for caller in #[``Eggshell.Plugin.Publication.Service.retain,
+      ``Eggshell.Plugin.Publication.Service.executeOperation,
+      ``Eggshell.Plugin.OperationPool.Pool.runSearch] do
+    let some body := (environment.find? caller).bind (·.value?) |
+      throwError "Missing owned completion bookkeeping: {caller}"
+    unless body.getUsedConstants.contains ``Eggshell.TaskDeadline.Watched.finished do
+      throwError "Live task bookkeeping bypasses its registered completion: {caller}"
+    for forbidden in #[``IO.hasFinished,``IO.getTaskState] do
+      if body.getUsedConstants.contains forbidden then
+        throwError "Live bookkeeping polls the global task-state table: {caller}"
+    if caller == ``Eggshell.Plugin.Publication.Service.executeOperation &&
+        body.getUsedConstants.contains ``IO.Promise.isResolved then
+      throwError "Operation waiting polls the global promise-state table"
+  let some body := (environment.find? ``Eggshell.TaskDeadline.Watched.finished).bind (·.value?) |
+    throwError "Missing registered completion observation"
+  for forbidden in #[``IO.hasFinished,``IO.getTaskState] do
+    if body.getUsedConstants.contains forbidden then
+      throwError "Completion observation re-enters the global task-state table"
+

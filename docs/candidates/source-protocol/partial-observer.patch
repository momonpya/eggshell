diff --git a/Eggshell/TaskDeadline.lean b/Eggshell/TaskDeadline.lean
index dce647a1..4635e6e6 100644
--- a/Eggshell/TaskDeadline.lean
+++ b/Eggshell/TaskDeadline.lean
@@ -43,0 +44,21 @@ def event (task : AsyncTask α) : IO (Selector α) := do
+/-- Observe completion once. Repeated owner bookkeeping reads this task-local
+event instead of taking the runtime's global task-state lock for every live
+task on every service tick. The original task still owns wait/cancellation. -/
+structure Watched (α : Type) where
+  private mk ::
+  task : AsyncTask α
+  complete : IO.Ref Bool
+
+@[no_expose] def watch (task : AsyncTask α) : IO (Watched α) := do
+  let complete ← IO.mkRef false
+  -- One writer, one transition, no read/modify/write race. Registering after
+  -- completion is handled by the runtime's synchronous mapTask contract.
+  discard <| IO.mapTask (t := task) (sync := true) fun _ => complete.set true
+  return ⟨task,complete⟩
+
+def Watched.finished (watched : Watched α) : IO Bool := watched.complete.get
+
+def Watched.wait (watched : Watched α) : IO (Except IO.Error α) := IO.wait watched.task
+
+def Watched.cancel (watched : Watched α) : IO Unit := IO.cancel watched.task
+

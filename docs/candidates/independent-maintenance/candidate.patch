+/-- Source admission depends only on source owners. Derived work retains its
+existing independent bound; no native worker, writer or query pool is enlarged. -/
+def OwnedTasks.canSave (owned : OwnedTasks) (session : String) : Bool :=
+  owned.saves.size < HookBudget.maintenance &&
+    HookBudget.canStart (owned.saves.toList.map (·.session)) session
+
+def OwnedTasks.addSave (owned : OwnedTasks) (work : Maintenance) : OwnedTasks :=
+  {owned with saves := owned.saves.push work}
 
+def OwnedTasks.startSave (owned : OwnedTasks) (entry : Session) : IO OwnedTasks := do
+  unless owned.canSave entry.name do return owned
+  let task ← IO.asTask entry.refreshSave .dedicated
+  return owned.addSave ⟨entry.name,entry.revision,task⟩
+
+theorem OwnedTasks.preparation_cannot_block_source (owned : OwnedTasks) (work : Maintenance) (session : String) :
+    (owned.addMaintenance work).canSave session = owned.canSave session := rfl
+
+theorem OwnedTasks.source_preserves_preparation (owned : OwnedTasks) (work : Maintenance) :
+    (owned.addSave work).maintenance = owned.maintenance := rfl
+
+theorem OwnedTasks.duplicate_source_refused (owned : OwnedTasks) (work : Maintenance) :
+    (owned.addSave work).canSave work.session = false := by
+  simp [addSave,canSave,HookBudget.canStart]
+

+/-- The observation is immutable. Its verified coordinate directory may grow
+without changing that observation or the positions already published. -/
+def Header.identity (header : Header) : String × String × String × String × Original × Array Occurrence :=
+  (header.database,header.authority,header.owner,header.work,header.original,header.occurrences)
+
+theorem Header.identity_original (a b : Header) (same : a.identity = b.identity) :
+    a.original = b.original :=
+  congrArg (fun identity => identity.2.2.2.2.1) same
+
+def addedRows (previous incoming : Array Read) : Array Read :=
+  let known : Std.HashSet Read := .ofList previous.toList
+  incoming.filter fun row => !known.contains row
+
+def extendRows (previous incoming : Array Read) : Array Read :=
+  previous ++ addedRows previous incoming
+
+theorem extendRows_position (previous incoming : Array Read) (i : Nat) (within : i < previous.size) :
+    (extendRows previous incoming)[i]'(by simp only [extendRows,Array.size_append]; omega) = previous[i] := by
+  exact Array.getElem_append_left within
+
+theorem extendRows_incoming (previous incoming : Array Read) (row : Read) (member : row ∈ incoming) :
+    row ∈ extendRows previous incoming := by
+  by_cases old : row ∈ previous
+  · simp [extendRows,old]
+  · simp [extendRows,addedRows,Std.HashSet.contains_ofList,old,member]
+

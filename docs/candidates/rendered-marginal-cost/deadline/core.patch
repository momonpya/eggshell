+    grouped := grouped.insert piece.family ((grouped[piece.family]?).getD #[] |>.push (piece,id))
+  let rows := families.zipIdx.map fun (family,index) => Id.run do
+    let direct := rankCoefficients scale index (rankedCues {family with
+      references := [],referenceRanks := [],synapticRanges := [],outputRanges := []})
+    let reference := rankCoefficients scale index (rankedCues {family with
+      windows := [],synapticRanges := [],outputRanges := []})
+    let graph := rankCoefficients scale index (rankedCues {family with
+      windows := [],references := [],referenceRanks := []})

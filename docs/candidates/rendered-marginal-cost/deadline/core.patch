+      let some cue := directory.1[id]? | continue
+      let base := cue*2
+      let bonus := base+1
+      if 0 < compiled.weights[base]! then bases := bases.insert base
+      if 0 < compiled.weights[bonus]! then bonuses := bonuses.insert bonus
+      let paid := (if credited.contains base then compiled.weights[base]! else 0) +
+        (if credited.contains bonus then compiled.weights[bonus]! else 0)
+      if paid < piece.weight || piece.weight == 0 then continue
+      if evaluateCoefficients piece.first piece.last direct == piece.weight then directBest := directBest+1
+      if evaluateCoefficients piece.first piece.last reference == piece.weight then referenceBest := referenceBest+1
+      if evaluateCoefficients piece.first piece.last graph == piece.weight then graphBest := graphBest+1
+    let total := fun (nodes : Std.HashSet Nat) => nodes.toArray.foldl (fun sum id => sum+compiled.weights[id]!) 0

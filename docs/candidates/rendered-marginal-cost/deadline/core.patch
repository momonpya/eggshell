+def quote (layout : Layout) (state : State) (index : Nat) :
+    Option (MeasuredCoverage.Delta × Array (Nat × Raw)) := do
+  let offer ← layout.offers[index]?
+  let mut body := (0,0)
+  for node in offer.nodes do
+    if !state.nodes.contains node then body := add body layout.costs[node]!
+  let mut raw := state.raw
+  let mut changed := #[]
+  let mut slices := if !state.nodes.contains 0 && offer.nodes.contains 0 then 1 else 0
+  for id in offer.raw do
+    let unit ← layout.units[id]?
+    let (next,extra,additional) ← rawNext raw[unit.family]! unit.slice
+    raw := raw.set! unit.family (some next)
+    changed := changed.push (unit.family,next)
+    body := add body extra
+    slices := slices+additional
+  return (⟨body,slices⟩,changed)
+
+def advance (layout : Layout) (state : State) (index : Nat) : Option State := do
+  let (delta,changed) ← quote layout state index
+  let offer ← layout.offers[index]?
+  let nodes := offer.nodes.foldl (fun found node => found.insert node) state.nodes
+  let raw := changed.foldl (fun found (family,value) => found.set! family (some value)) state.raw
+  return {state with
+    nodes,raw
+    body := add state.body delta.body
+    slices := state.slices+delta.slices
+    mask := state.mask ||| offer.mask}
+
+def layout (shape : PacketMeasure) (families : Nat) (units : Array UnitPlan)
+    (parts : Array (List Nat)) : Option Layout := do
+  let mut costs := #[textCost (Synapses.CanonicalSource.Packet.wrapper ++ Synapses.CanonicalSource.Packet.footer)]
+  let mut files : Std.HashMap Synapses.File Nat := {}
+  let mut rows : Std.HashMap Synapses.CanonicalSource.Key Nat := {}
+  let mut origins : Std.HashMap (Synapses.File × String) Nat := {}
+  let mut unitNodes := #[]
+  for unit in units do
+    let mut nodes := #[]
+    if let some shared := unit.slice.shared then
+      nodes := nodes.push 0
+      for row in shared.rows do
+        let file := row.key.file
+        let frameId := files[file]?.getD costs.size
+        if frameId == costs.size then
+          let frame := Synapses.CanonicalSource.Packet.fileFrame file #[]
+          let frameCost := textCost (frame.leading ++ frame.trailing)
+          unless 0 < frameCost.1 && 0 < frameCost.2 do none
+          costs := costs.push (frameCost.1-1,frameCost.2-1)
+          files := files.insert file frameId
+        nodes := nodes.push frameId
+        let rowId := rows[row.key]?.getD costs.size
+        if rowId == costs.size then
+          costs := costs.push (textCost (Synapses.CanonicalSource.Packet.rowText row))
+          rows := rows.insert row.key rowId
+        nodes := nodes.push rowId
+        if row.origins.isEmpty then none else do
+          for origin in row.origins do
+            let reference := (toJson (origin.binding.database,origin.binding.owner,origin.binding.work,origin.occurrence)).compress
+            let key := (file,reference)
+            let id := origins[key]?.getD costs.size
+            if id == costs.size then
+              let cost := textCost ((toJson reference).compress)
+              costs := costs.push (cost.1+1,cost.2+1)
+              origins := origins.insert key id
+            nodes := nodes.push id
+    unitNodes := unitNodes.push (hashDistinct nodes.toList).toArray
+  let mut offers := #[]
+  let mut features := #[]
+  for recipe in parts do
+    let mut nodes := []
+    let mut raw := #[]
+    let mut mask := 0
+    let mut owners := []
+    for id in recipe.eraseDups do
+      let unit ← units[id]?
+      mask := mask ||| shape.marks unit.slice
+      nodes := nodes ++ unitNodes[id]!.toList
+      if unit.slice.shared.isNone then
+        raw := raw.push id
+        owners := (costs.size+unit.family) :: owners
+    let distinctNodes := (hashDistinct nodes).toArray
+    offers := offers.push ⟨distinctNodes,raw,mask⟩
+    features := features.push (hashDistinct (distinctNodes.toList ++ owners)).toArray
+  let mut posting := Array.replicate (costs.size+families) #[]
+  for id in [:features.size] do
+    for feature in features[id]! do posting := posting.modify feature (·.push id)
+  return ⟨costs,offers,posting,units,parts,families⟩
+
+def affected (layout : Layout) (state : State) (index : Nat) : Array Nat := Id.run do
+  let some offer := layout.offers[index]? | return #[]
+  let mut features := offer.nodes.toList.filter (fun node => !state.nodes.contains node)
+  for id in offer.raw do
+    if let some unit := layout.units[id]? then features := (layout.costs.size+unit.family) :: features
+  let mut seen : Std.HashSet Nat := {}
+  let mut result := #[]
+  for feature in hashDistinct features do
+    for id in layout.postings[feature]! do
+      if !seen.contains id then
+        seen := seen.insert id
+        result := result.push id
+  return result
+
+def choose (shape : PacketMeasure) (cost : List TransportSlice → Cost) (families : Nat)
+    (units : Array UnitPlan) (parts : Array (List Nat)) (compiled : SharedCoverage.Problem)
+    (mandatory : List TransportSlice) : Option (List Nat × Json) := do
+  let layout ← layout shape families units parts
+  let initial : State := {
+    raw := Array.replicate families none
+    body := mandatory.foldl (fun sum slice => add sum (textCost slice.text)) (0,0)
+    slices := mandatory.length,mask := shape.baseMarks}
+  let meter : MeasuredCoverage.Meter State := {
+    initial,prepare := prepare shape layout
+    cost := fun state => total state (state.headerCache[state.mask]!.1,state.headerCache[state.mask]!.2)
+    quote := fun state index => (quote layout state index).map Prod.fst
+    afterCost := fun state index delta =>
+      add state.headers[index]! (add (add state.body delta.body)
+        (state.slices+delta.slices-1,state.slices+delta.slices-1))
+    advance := advance layout
+    affected := fun before _next index => affected layout before index
+    verify := fun state selected =>
+      let expanded := hashDistinct (selected.flatMap fun id => parts[id]!)
+      match materialize units expanded with
+      | none => false
+      | some slices => total state state.headerCache[state.mask]! == cost (mandatory ++ slices)}
+  let problem : MeasuredCoverage.Problem := {
+    weights := compiled.weights,cues := compiled.offers.map fun offer => (hashDistinct (offer.covers.map (·.val))).toArray
+    limit := compiled.limit}
+  let result ← MeasuredCoverage.choose? problem meter
+  let expanded := hashDistinct (result.selected.flatMap fun id => parts[id]!)
+  pure (expanded,Json.mkObj [("measured",toJson result),("wireNodes",toJson layout.costs.size),
+    ("compiledOffers",toJson compiled.offers.size),("causeRulesChanged",toJson false)])
+end WireMeasure

+
+/- The following meter is an isolated counterfactual. Whole original offers
+and recipes are unchanged. Its basis accounts for selected origin references
+and actual raw interval subtraction, without rendering losing proposals. -/
+structure PacketMeasure where
+  marks : TransportSlice → Nat
+  baseMarks : Nat
+  overhead : Nat → Nat × Nat
+
+namespace WireMeasure
+abbrev Cost := Nat × Nat
+def add (a b : Cost) : Cost := (a.1+b.1,a.2+b.2)
+def textCost (text : String) : Cost := (text.length,text.utf8ByteSize)
+
+structure Raw where
+  context : Option ContextDelivery
+  text : String
+  cost : Cost
+
+structure Offer where
+  nodes : Array Nat := #[]
+  raw : Array Nat := #[]
+  mask : Nat := 0
+
+structure Layout where
+  costs : Array Cost
+  offers : Array Offer
+  postings : Array (Array Nat)
+  units : Array UnitPlan
+  parts : Array (List Nat)
+  families : Nat
+
+structure State where
+  nodes : Std.HashSet Nat := {}
+  raw : Array (Option Raw)
+  body : Cost
+  slices : Nat
+  mask : Nat
+  headerMask : Option Nat := none
+  headers : Array Cost := #[]
+  headerCache : Std.HashMap Nat Cost := {}
+
+def total (state : State) (overhead : Cost) : Cost :=
+  add overhead (add state.body (state.slices-1,state.slices-1))
+
+def prepare (shape : PacketMeasure) (layout : Layout) (state : State) : State := Id.run do
+  if state.headerMask == some state.mask then return state
+  let mut cache := state.headerCache
+  let mut headers := #[]
+  for offer in layout.offers do
+    let mask := state.mask ||| offer.mask
+    let measured := match cache[mask]? with
+      | some value => value
+      | none => shape.overhead mask
+    cache := cache.insert mask measured
+    headers := headers.push measured
+  if !cache.contains state.mask then cache := cache.insert state.mask (shape.overhead state.mask)
+  return {state with headerMask := some state.mask,headers,headerCache := cache}
+
+def rawNext (prior : Option Raw) (slice : TransportSlice) : Option (Raw × Cost × Nat) := do
+  match prior with
+  | none =>
+    if let some context := slice.context then
+      let count := context.fragments.length
+      let cost := add (textCost (context.leading ++ context.sourceNotice ++ context.trailing))
+        (add (context.fragments.foldl (fun sum fragment => add sum (textCost (fragment.render context.compactCaptions))) (0,0))
+          (count-1,count-1))
+      if cost != textCost slice.text then none else
+        some (⟨some context,"",cost⟩,cost,1)
+    else some (⟨none,slice.text,textCost slice.text⟩,textCost slice.text,1)
+  | some old =>
+    match old.context,slice.context with
+    | none,none => if old.text == slice.text then some (old,(0,0),0) else none
+    | some context,some offered =>
+      if !(decide (offered.sameEnvelope context)) || !(context.fragments.all (fun fragment =>
+        offered.fragments.all (fun next => decide (next.agrees fragment)))) then none else do
+        let covered := context.fragments.filterMap fun fragment =>
+          if ordered : 0 < fragment.original.length then
+            some (⟨fragment.first,fragment.first+fragment.original.length,by omega⟩ : DeliveryInterval)
+          else none
+        let additional := offered.fragments.flatMap (·.remaining covered)
+        let count := context.fragments.length
+        let separators := (count+additional.length-1)-(count-1)
+        let extra := add (additional.foldl (fun sum fragment =>
+          add sum (textCost (fragment.render context.compactCaptions))) (0,0)) (separators,separators)
+        let context := {context with
+          planKey := offered.planKey,cues := context.cues ++ offered.cues
+          fragments := (context.fragments ++ additional).mergeSort (fun a b => a.first ≤ b.first)}
+        some (⟨some context,"",add old.cost extra⟩,extra,0)
+    | _,_ => none

@@ -0,0 +1,208 @@
+module
+
+public import Eggshell.ProjectStore
+public import Init.System.Promise
+
+@[expose] public section
+namespace Eggshell.ProjectViews
+open Lean DB ProjectStore
+
+def maxImages : Nat := 32
+def maxHandles : Nat := 512
+
+def scope (project : Project) : String := project.directory.toString++"#"++project.manifest.identity
+
+structure Image where
+  id : Nat
+  project : Project
+  cut : Cut
+  done : IO.Promise (Except String View)
+  borrowers : Std.HashSet Nat
+  touched : Nat
+
+def handleCount (images : Array Image) : Nat := images.foldl (fun n image => n+image.cut.heads.size) 0
+
+/-- These bounds describe the actual resident image catalogue, including
+builders and images retained by borrowers. They do not claim a total RSS bound. -/
+structure Catalogue where
+  private mk ::
+  images : Array Image
+  boundedImages : images.size ≤ maxImages
+  boundedHandles : handleCount images ≤ maxHandles
+
+@[no_expose] def Catalogue.empty : Catalogue := ⟨#[],by decide,by decide⟩
+
+@[no_expose] def Catalogue.check (images : Array Image) : Except String Catalogue :=
+  if boundedImages : images.size ≤ maxImages then
+    if boundedHandles : handleCount images ≤ maxHandles then return ⟨images,boundedImages,boundedHandles⟩
+    else throw "project image source-handle budget exceeded"
+  else throw "project image catalogue budget exceeded"
+
+theorem Catalogue.image_bound (catalogue : Catalogue) : catalogue.images.size ≤ 32 := catalogue.boundedImages
+theorem Catalogue.handle_bound (catalogue : Catalogue) : handleCount catalogue.images ≤ 512 := catalogue.boundedHandles
+
+structure State where
+  catalogue : Catalogue := .empty
+  next : Nat := 0
+  closed : Bool := false
+  builds : Nat := 0
+  completed : Nat := 0
+  failed : Nat := 0
+  reused : Nat := 0
+  evicted : Nat := 0
+  expired : Nat := 0
+  peakImages : Nat := 0
+  peakHandles : Nat := 0
+
+structure Pool where
+  private state : Std.Mutex State
+  pages : PageMap.PagePool
+
+@[no_expose] def Pool.new : IO Pool := return ⟨← Std.Mutex.new ({} : State),← PageMap.PagePool.new⟩
+
+structure Claim where
+  private mk ::
+  image : Nat
+  ticket : Nat
+  done : IO.Promise (Except String View)
+  build : Bool
+
+structure Borrow where
+  private mk ::
+  private pool : Pool
+  private image : Nat
+  private ticket : Nat
+  cut : Cut
+
+@[no_expose] def Pool.releaseTicket (pool : Pool) (image ticket : Nat) : IO Unit := pool.state.atomically do
+  let state ← get
+  let images := state.catalogue.images.map fun before =>
+    if before.id == image then {before with borrowers := before.borrowers.erase ticket} else before
+  let catalogue ← IO.ofExcept (Catalogue.check images)
+  set {state with catalogue}
+
+@[no_expose] def Borrow.release (borrow : Borrow) : IO Unit := borrow.pool.releaseTicket borrow.image borrow.ticket
+
+/-- Only resolved idle images can be evicted. An active builder and every
+live borrower remain charged against both catalogue bounds. -/
+@[no_expose] def Pool.reserve (pool : Pool) (project : Project) (cut : Cut) : IO (Option Claim) := pool.state.atomically do
+  let state : State ← get
+  unless !state.closed do throw (IO.userError "project image admission is closed")
+  if let some index := state.catalogue.images.findIdx? (fun image =>
+      image.project.directory == project.directory && image.project.manifest == project.manifest && image.cut == cut) then
+    let some image := state.catalogue.images[index]? | throw (IO.userError "project image disappeared")
+    let images := state.catalogue.images.modify index fun before =>
+      {before with borrowers := before.borrowers.insert state.next,touched := state.next}
+    let catalogue ← IO.ofExcept (Catalogue.check images)
+    set {state with catalogue,next := state.next+1,reused := state.reused+1}
+    return some ⟨image.id,state.next,image.done,false⟩
+  let mut images := state.catalogue.images
+  let mut evicted := 0
+  while images.size ≥ maxImages || handleCount images+cut.heads.size > maxHandles do
+    let mut oldest : Option (Nat × Nat) := none
+    for index in [:images.size] do
+      let some image := images[index]? | continue
+      if image.borrowers.isEmpty && (← image.done.isResolved) then
+        if oldest.isNone || image.touched < oldest.get!.2 then oldest := some (index,image.touched)
+    let some (index,_) := oldest | return none
+    images := images.extract 0 index ++ images.extract (index+1) images.size
+    evicted := evicted+1
+  let done ← IO.Promise.new
+  let image : Image := ⟨state.next,project,cut,done,({} : Std.HashSet Nat).insert state.next,state.next⟩
+  let catalogue ← IO.ofExcept (Catalogue.check (images.push image))
+  set {state with
+    catalogue,next := state.next+1,builds := state.builds+1,evicted := state.evicted+evicted
+    peakImages := max state.peakImages catalogue.images.size
+    peakHandles := max state.peakHandles (handleCount catalogue.images)}
+  return some ⟨image.id,state.next,done,true⟩
+
+@[no_expose] def Pool.acquire (pool : Pool) (project : Project) (cut : Cut) (deadline : Nat) : IO Borrow := do
+  unless cut.inScope project.manifest && (toJson cut).compress.utf8ByteSize ≤ maxMetadataBytes do
+    throw (IO.userError "project image has a foreign, missing or oversized original inventory")
+  let mut reserved : Option Claim := none
+  repeat
+    unless (← IO.monoMsNow) < deadline do throw (IO.userError "project image admission expired")
+    if let some claim ← pool.reserve project cut then
+      reserved := some claim
+      break
+    IO.sleep 2
+  let some claim := reserved | throw (IO.userError "project image reservation disappeared")
+  try
+    if claim.build then
+      let result ← try
+        pure (.ok (← openView project cut (some ⟨pool.pages,scope project⟩)) : Except String View)
+      catch error => pure (.error error.toString)
+      pool.state.atomically do
+        let state ← get
+        match result with
+        | .ok _ => set {state with completed := state.completed+1}
+        | .error _ =>
+          let catalogue ← IO.ofExcept (Catalogue.check (state.catalogue.images.filter (·.id != claim.image)))
+          set {state with catalogue,failed := state.failed+1}
+      claim.done.resolve result
+    repeat
+      unless (← IO.monoMsNow) < deadline do
+        pool.state.atomically (modify fun state => {state with expired := state.expired+1})
+        throw (IO.userError "project image borrower expired")
+      if ← claim.done.isResolved then
+        let some result := claim.done.result?.get | throw (IO.userError "project image result disappeared")
+        let _ ← IO.ofExcept result
+        return ⟨pool,claim.image,claim.ticket,cut⟩
+      IO.sleep 1
+  catch error =>
+    pool.releaseTicket claim.image claim.ticket
+    throw error
+
+/-- An operation has its own borrower ticket. Releasing the outer borrow in
+another task cannot evict its image while this callback still uses a reader. -/
+@[no_expose] def Borrow.withReader (borrow : Borrow) (use : View → IO α) : IO α := do
+  let (ticket,done) ← borrow.pool.state.atomically do
+    let state ← get
+    let some index := state.catalogue.images.findIdx? (·.id == borrow.image) |
+      throw (IO.userError "project image borrow has been released")
+    let some image := state.catalogue.images[index]? | throw (IO.userError "project image disappeared")
+    unless image.cut == borrow.cut && image.borrowers.contains borrow.ticket do
+      throw (IO.userError "project image borrow has expired or changed")
+    let images := state.catalogue.images.modify index fun before =>
+      {before with borrowers := before.borrowers.insert state.next,touched := state.next}
+    let catalogue ← IO.ofExcept (Catalogue.check images)
+    set {state with catalogue,next := state.next+1}
+    return (state.next,image.done)
+  try
+    unless ← done.isResolved do throw (IO.userError "project image is not validated")
+    let some result := done.result?.get | throw (IO.userError "project image result disappeared")
+    let view ← IO.ofExcept result
+    use (← view.fork)
+  finally borrow.pool.releaseTicket borrow.image ticket
+
+@[no_expose] def withReaders (borrows : List Borrow) (use : Array View → IO α)
+    (views : Array View := #[]) : IO α :=
+  match borrows with
+  | [] => use views
+  | borrow::rest => borrow.withReader fun view => withReaders rest use (views.push view)
+
+@[no_expose] def Pool.stop (pool : Pool) : IO Unit := pool.state.atomically do
+  modify fun state => {state with closed := true}
+
+@[no_expose] def Pool.drain (pool : Pool) : IO Unit := do
+  pool.state.atomically do
+    let state : State ← get
+    unless state.closed && state.catalogue.images.all (·.borrowers.isEmpty) do
+      throw (IO.userError "project images still have live borrowers")
+    for image in state.catalogue.images do
+      unless ← image.done.isResolved do throw (IO.userError "project image builder has not drained")
+    set {state with catalogue := .empty}
+  pool.pages.state.atomically (set ({} : PageMap.SharedPages))
+
+@[no_expose] def Pool.stats (pool : Pool) : IO Json := pool.state.atomically do
+  let state ← get
+  return Json.mkObj [("images",toJson state.catalogue.images.size),
+    ("handles",toJson (handleCount state.catalogue.images)),
+    ("borrowers",toJson (state.catalogue.images.foldl (fun n image => n+image.borrowers.size) 0)),
+    ("builds",toJson state.builds),("completed",toJson state.completed),("failed",toJson state.failed),
+    ("reused",toJson state.reused),("evicted",toJson state.evicted),("expired",toJson state.expired),
+    ("peakImages",toJson state.peakImages),("peakHandles",toJson state.peakHandles),
+    ("maxImages",toJson maxImages),("maxHandles",toJson maxHandles),("closed",toJson state.closed),
+    ("pages",← pool.pages.stats)]
+
+end Eggshell.ProjectViews

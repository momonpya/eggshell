+/-- An independently requested cut is accepted in full or rejected. Warm
+status is not an input, and an older closed cut is never substituted. -/
+@[no_expose] def openView (project : Project) (cut : Cut)
+    (shared : Option PageMap.SharedReader := none) : IO View := do
+  unless cut.inScope project.manifest do throw (IO.userError "requested project cut has a foreign or missing owner")
+  let sources ← (List.range cut.heads.size).toArray.mapM fun owner => do
+    historical project owner (← headAt cut.heads owner) shared
+  checkedSources project cut sources
+
+/-- Readers retain the same immutable heads and handles. Mutable read counts,
+trace capture and private caches belong to the borrower, not the shared image. -/
+@[no_expose] def View.fork (view : View) : IO View := do
+  let sources ← view.sources.mapM fun source => do
+    return {source with
+      reads := ← IO.mkRef 0,readBytes := ← IO.mkRef 0
+      trace := ← IO.mkRef none,cache := ← IO.mkRef {}}
+  if complete : sources.size = view.project.manifest.owners.size then
+    if exact : sources.map (·.head) = view.cut.heads then
+      return ⟨view.project,view.cut,sources,complete,exact⟩
+    else throw (IO.userError "borrow changed a pinned original head")
+  else throw (IO.userError "borrow changed the complete owner inventory")
+
+/-- Join already retained images without opening another set of source files.
+Every input head must be an ancestor of the selected head, not merely have a
+smaller revision. Dependencies are checked on the complete selected inventory. -/
+@[no_expose] def View.joinMany (first : View) (others : Array View) : IO View := do
+  unless others.all (fun v => v.project.directory == first.project.directory &&
+      v.project.manifest == first.project.manifest) do throw (IO.userError "joined images mixed project scopes")
+  if others.all (·.cut == first.cut) then return first
+  let views := #[first]++others
+  let mut cut := first.cut
+  for view in others do cut ← IO.ofExcept (cut.join view.cut)
+  let sources ← (List.range cut.heads.size).toArray.mapM fun owner => do
+    let head ← headAt cut.heads owner
+    let some source := views.findSome? (fun view => view.sources[owner]?.filter (·.head == head)) |
+      throw (IO.userError "joined original head has no retained reader")
+    for view in views do
+      unless ← sourceContains source (← headAt view.cut.heads owner) do
+        throw (IO.userError "joined original images have divergent ancestry")
+    return source
+  checkedSources first.project cut sources

+/-- The thunk starts after the clock read. No source bytes or capabilities
+enter these aggregate timings; overlapping worker sums are not wall time. -/
+@[noinline] def Pool.measured (pool : Pool) (label : String) (action : Unit → IO α) : IO α := do
+  let started ← IO.monoMsNow
+  try action ()
+  finally
+    let elapsed := (← IO.monoMsNow)-started
+    pool.timings.atomically do
+      let stages ← get
+      let before := stages[label]?.getD {}
+      set (stages.insert label ⟨before.count+1,before.totalMs+elapsed,max before.maxMs elapsed⟩)
+

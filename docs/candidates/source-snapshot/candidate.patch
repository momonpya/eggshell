+def captureCount (committed offset : Nat) : Nat := min 4096 (committed-offset)
+theorem capture_step_bounded (committed offset : Nat) (remaining : offset < committed) :
+    0 < captureCount committed offset ∧ offset+captureCount committed offset ≤ committed := by
+  unfold captureCount
+  omega
+
+/-- Capture through the pinned file descriptor, not its later pathname.
+Only the immutable committed prefix is copied. No graph or historical input
+is reconstructed, and no writer lock or source write is acquired. -/
+def capturePinned (source : PageMap.Snapshot) (destination : System.FilePath) : IO Project := do
+  let destination ← PageMap.absolute destination
+  unless !(← destination.pathExists) && destination != source.directory &&
+      !destination.toString.startsWith (source.directory.toString++"/") do
+    throw (IO.userError "snapshot destination must be a fresh location outside the source DB")
+  FileSystem.rejectSymlinkAncestors destination
+  if let some root := source.head.root then discard <| source.load root
+  let identity := Blake3.hex (← IO.getRandomBytes 32)
+  let staging := destination.withFileName (".snapshot-"++identity)
+  FileSystem.durableDirectory (destination.parent.getD "/")
+  IO.FS.createDir staging
+  try
+    FileSystem.privateDirectory staging
+    let owners ← Sidecar.childDirectory staging "owners"
+    let slot ← Sidecar.childDirectory owners "0"
+    let folder ← Sidecar.childDirectory slot "source.egg"
+    let data := PageMap.dataPath folder source.head
+    FileSystem.immutableExistingBytes data ByteArray.empty
+    let output ← FileSystem.openAppend data.toString
+    try
+      let mut offset := 0
+      while offset < source.head.bytes do
+        if ← IO.checkCanceled then throw (IO.userError "source snapshot cancelled")
+        let count := captureCount source.head.bytes offset
+        let bytes ← FileSystem.readPage source.handle offset.toUInt64 ⟨count,Nat.min_le_left _ _⟩
+        unless bytes.size == count do throw (IO.userError "source committed prefix was truncated")
+        FileSystem.appendAt output offset.toUInt64 bytes
+        offset := offset+count
+      FileSystem.syncAppend output
+    finally FileSystem.closeAppend output
+    FileSystem.immutableExistingBytes (folder/"head") (toJson source.head).compress.toUTF8
+    FileSystem.immutableExistingBytes (folder/"writer") ByteArray.empty
+    let captured ← PageMap.pin folder
+    unless captured.head == source.head do throw (IO.userError "snapshot changed its original source head")
+    if let some root := source.head.root then discard <| captured.load root
+    let manifest : Manifest := ⟨identity,source.head.authority,#[source.head],.snapshot⟩
+    unless decide manifest.Valid do throw (IO.userError "invalid captured source inventory")
+    let bytes := (toJson (StoredManifest.mk manifest (manifestChecksum manifest))).compress.toUTF8
+    unless bytes.size ≤ maxMetadataBytes do throw (IO.userError "captured source metadata exceeds its bound")
+    FileSystem.immutableExistingBytes (staging/"project") bytes
+    FileSystem.publishDirectory staging.toString destination.toString
+  finally
+    if ← staging.pathExists then IO.FS.removeDirAll staging
+  openProject destination
+
+def capture (original destination : System.FilePath) : IO Project := do
+  capturePinned (← PageMap.pin original) destination
+

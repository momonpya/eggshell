+/-- Only tokens with no active reader may be retired. The final borrower owns
+the one original-cache release, performed outside the metadata lock. -/
+def State.retire (state : State) (tokens : Array String) : State × Array Descriptor := Id.run do
+  let mut state := state
+  let mut retired := #[]
+  for token in tokens do
+    let some held := state.entries[token]? | continue
+    if held.readers > 0 then continue
+    let entries := state.entries.erase token
+    state := {state with entries,budget := state.budget.release handleCharge}
+    let some descriptor := state.descriptors[held.descriptor]? | continue
+    if descriptor.borrowers ≤ 1 then
+      state := {state with
+        descriptors := state.descriptors.erase held.descriptor,
+        budget := state.budget.release descriptor.charge}
+      retired := retired.push descriptor
+    else
+      let descriptor := {descriptor with borrowers := descriptor.borrowers-1}
+      state := {state with descriptors := state.descriptors.insert held.descriptor descriptor}
+  return (state,retired)

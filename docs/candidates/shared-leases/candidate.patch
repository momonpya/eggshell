+/-- Admission charges a checked immutable descriptor once, and a small token per
+borrower. Neither the full source identity nor the loaded arena is copied per chat. -/
+def State.admit? (state : State) (token : String) (candidate : Descriptor)
+    (holdUntil : Nat) : Option (State × Descriptor × Bool) := do
+  if state.closed || state.entries.contains token || state.entries.size ≥ maxHandles then none else do

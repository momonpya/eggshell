@@ -20,0 +21,26 @@ initialize ownedServer : Std.Mutex (Option Numerical.Service) ← Std.Mutex.new
+/-- Only the service process may install its own immutable endpoint. Search
+actors in that process need no ping, startup lock or self-connection preflight. -/
+initialize hostedOwner : Std.Mutex (Option Daemon.Endpoint) ← Std.Mutex.new none
+
+def hostedAccepts (endpoint : Daemon.Endpoint) (pid : Nat) (implementation : String) : Bool :=
+  endpoint.session == "publisher" && endpoint.pid == pid && endpoint.compatible implementation
+
+theorem hosted_same_owner (endpoint : Daemon.Endpoint) (pid : Nat) (implementation : String)
+    (accepted : hostedAccepts endpoint pid implementation = true) : endpoint.pid = pid := by
+  simp only [hostedAccepts,Bool.and_eq_true,beq_iff_eq] at accepted
+  exact accepted.1.2
+
+def registerHosted (endpoint : Daemon.Endpoint) : IO Unit := do
+  unless hostedAccepts endpoint (← IO.Process.getPID).toNat (← generation) do
+    throw (IO.userError "hosted publisher is not this process and implementation")
+  hostedOwner.atomically do
+    unless (← get).isNone do throw (IO.userError "hosted publisher already installed")
+    set (some endpoint)
+
+def unregisterHosted (endpoint : Daemon.Endpoint) : IO Unit := hostedOwner.atomically do
+  let some current ← get | return
+  unless current.pid == endpoint.pid && current.port == endpoint.port &&
+      current.generation == endpoint.generation && current.secret == endpoint.secret do
+    throw (IO.userError "foreign publisher cannot retire the hosted owner")
+  set (none : Option Daemon.Endpoint)
+

diff --git a/Eggshell/SearchReaders.lean b/Eggshell/SearchReaders.lean
new file mode 100644
index 00000000..946bb146
--- /dev/null
+++ b/Eggshell/SearchReaders.lean
@@ -0,0 +1,66 @@
+module
+public import Eggshell.PreparedReaders
+public import Eggshell.TaskDeadline
+public import Std.Sync.Channel
+
+@[expose] public section
+namespace Eggshell.SearchReaders
+open Lean
+
+structure Request where
+  frame : PreparedReaders.Frame
+  deadline : Nat
+  cancelled : IO.Ref Bool
+  reply : IO.Promise (Except IO.Error PreparedReaders.Session)
+
+/-- One owner updates the public catalogue. Source/encoder IO remains outside
+the publication service's accept loop and never owns another chat's state. -/
+partial def serve (queue : Std.CloseableChannel Request) (stats : IO.Ref Json) : IO Unit := do
+  let pool ← PreparedReaders.Pool.new
+  try
+    repeat
+      let some request ← IO.wait (← queue.recv) | break
+      let result ← try
+        TaskDeadline.ensureLive request.deadline
+        unless !(← request.cancelled.get) do throw (IO.userError "reader request cancelled")
+        let session ← pool.forkFrame request.frame
+        stats.set (← pool.stats)
+        pure (.ok session)
+        catch error => pure (.error error)
+      unless ← request.reply.isResolved do request.reply.resolve result
+  finally
+    repeat
+      let some request ← queue.tryRecv | break
+      unless ← request.reply.isResolved do request.reply.resolve (.error (IO.userError "reader coordinator closed"))
+
+structure Coordinator where
+  private mk ::
+  queue : Std.CloseableChannel Request
+  task : Task (Except IO.Error Unit)
+  statistics : IO.Ref Json
+
+@[no_expose] def Coordinator.new : IO Coordinator := do
+  let queue ← Std.CloseableChannel.new (some 160)
+  let stats ← IO.mkRef Json.null
+  return ⟨queue,← IO.asTask (serve queue stats) .dedicated,stats⟩
+
+def Coordinator.borrow (coordinator : Coordinator) (frame : PreparedReaders.Frame)
+    (deadline : Nat) (cancelled : IO.Ref Bool) : IO PreparedReaders.Session := do
+  let reply ← IO.Promise.new
+  unless ← coordinator.queue.trySend ⟨frame,deadline,cancelled,reply⟩ do
+    throw (IO.userError "reader coordinator stopped or full")
+  repeat
+    TaskDeadline.ensureLive deadline
+    unless !(← cancelled.get) do throw (IO.userError "reader wait cancelled")
+    if ← reply.isResolved then
+      let some result := reply.result?.get | throw (IO.userError "reader coordinator lost its result")
+      return ← IO.ofExcept result
+    IO.sleep 2
+  throw (IO.userError "unreachable reader wait")
+
+def Coordinator.close (coordinator : Coordinator) : IO Unit := do
+  try coordinator.queue.close catch _ => pure ()
+  IO.cancel coordinator.task
+  discard <| IO.wait coordinator.task
+
+end Eggshell.SearchReaders

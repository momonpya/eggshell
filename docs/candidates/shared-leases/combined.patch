+    (inputs : Array PreparedInputs.Reference) (reference : Option OwnerViews.Reference) : IO Frozen := do
+  let borrow ← pool.acquire sources inputs reference
+  let _ ← IO.ofExcept (Catalogue.check #[borrow.image])
+  return ⟨borrow.image,pool.pages⟩

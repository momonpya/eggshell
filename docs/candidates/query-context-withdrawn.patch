+module
+public import Eggshell.SearchRank
+public import tools.IdentifierParts
+@[expose] public section
+
+namespace Eggshell.QueryLiterals
+
+def nameChar (c : Char) : Bool := RetrievalResearch.Unicode.letterNumber c || c == '_'
+
+/-- Option-shaped text from the current question is a retrieval hint. Negative
+numbers, prose-internal hyphens and standalone list markers supply no hint. -/
+def query (text : String) : List (List String) := Id.run do
+  let chars := text.toList.toArray
+  let mut result := []
+  for i in [:chars.size] do
+    if chars[i]! != '-' || (i > 0 && (nameChar chars[i-1]! || chars[i-1]! == '-')) then continue
+    let mut first := i
+    while first < chars.size && chars[first]! == '-' do first := first + 1
+    if first == chars.size || !RetrievalResearch.Unicode.letterNumber chars[first]! || chars[first]!.isDigit then continue
+    let mut last := first
+    while last < chars.size && (nameChar chars[last]! || chars[last]! == '-') do last := last + 1
+    let parts := IdentifierParts.parts (fun _ => false) (String.ofList ((chars.toList.drop first).take (last-first)))
+    if !parts.isEmpty && !result.contains parts then result := result ++ [parts]
+  return result
+
+def identifiers (text : String) : List (List String) := Id.run do
+  let mut result : Array (List String) := #[]
+  let mut current : List Char := []
+  for c in text.toList do
+    if nameChar c then current := c :: current
+    else if !current.isEmpty then
+      result := result.push (IdentifierParts.parts (fun _ => false) (String.ofList current.reverse))
+      current := []
+  if !current.isEmpty then
+    result := result.push (IdentifierParts.parts (fun _ => false) (String.ofList current.reverse))
+  return result.toList
+
+/-- Match complete trailing identifier components, preserving component order.
+This is advice only; no prefix vocabulary, option alias table or Work identity
+is inferred from a spelling resemblance. -/
+def suffix (literal identifier : List String) : Bool :=
+  literal.length ≤ identifier.length && identifier.drop (identifier.length-literal.length) == literal
+
+def windows (question : String) (documents : List String) (ranked : List Nat) : List Nat :=
+  let literals := query question
+  let words := if literals.isEmpty then [] else documents.map identifiers
+  let channel := fun (literal : List String) (structured : Bool) =>
+    let matching := (words.zipIdx.filter fun (names,_) => names.any fun identifier =>
+      (!structured || literal.length < identifier.length) && suffix literal identifier).map Prod.snd
+    (ranked.filter matching.contains ++ matching.filter (fun index => !ranked.contains index)).toArray
+  let primary := literals.map fun literal => channel literal true
+  let channels := literals.map fun literal => channel literal false
+  let weave := fun (rows : List (Array Nat)) =>
+    (List.range documents.length).flatMap fun rank => rows.filterMap (·[rank]?)
+  let hints := weave primary ++ weave channels
+  SearchRank.select documents.length ranked.length [] (hints ++ ranked)
+
+theorem window_is_original (question : String) (documents : List String) (ranked : List Nat)
+    (index : Nat) (present : index ∈ windows question documents ranked) : index < documents.length :=
+  SearchRank.selected_is_existing _ _ _ _ _ present
+
+theorem window_count_bounded (question : String) (documents : List String) (ranked : List Nat) :
+    (windows question documents ranked).length ≤ ranked.length :=
+  SearchRank.selected_within_budget _ _ _ _
+
+theorem windows_distinct (question : String) (documents : List String) (ranked : List Nat) :
+    (windows question documents ranked).Nodup := SearchRank.selected_no_duplicates _ _ _ _
+
+end Eggshell.QueryLiterals

@@ -0,0 +1,23 @@
+import tools.QueryLiterals
+open Eggshell
+
+def main : IO Unit := do
+  unless QueryLiterals.query "Compare --alpha-beta, -z and --gamma. A tool-chain, -1 and - list are prose." ==
+      [["alpha","beta"],["z"],["gamma"]] do
+    throw (IO.userError "Option-shaped question hints lost boundaries or invented prose/numeric hints")
+  unless QueryLiterals.suffix ["alpha","beta"] ["prefix","alpha","beta"] &&
+      !QueryLiterals.suffix ["alpha","beta"] ["alpha","beta","tail"] &&
+      !QueryLiterals.suffix ["alpha","beta"] ["beta","alpha"] do
+    throw (IO.userError "Identifier hint suffix changed order or accepted a partial trailing component")
+  let selected := QueryLiterals.windows "Compare --alpha and --beta" [
+    "common surrounding prose", "PREFIX_alpha", "PREFIX_beta", "more prose"] [0,1,2]
+  unless selected == [1,2,0] do
+    throw (IO.userError "Different explicit literals were displaced by generic prose")
+  unless QueryLiterals.windows "ordinary question" ["first","second"] [1,0] == [1,0] do
+    throw (IO.userError "A question without literal hints changed a valid existing order")
+  unless QueryLiterals.windows "--alpha" ["PREFIX_alpha"] [] == [] do
+    throw (IO.userError "Literal hints manufactured a cue budget")
+  unless QueryLiterals.windows "--alpha --beta" [
+      "alpha appears in prose", "PREFIX_alpha", "PREFIX_beta", "beta in prose"] [0,3,1] == [1,2,0] do
+    throw (IO.userError "Incidental prose displaced an explicit structured identifier hint")
+  IO.println "query literals: option boundaries, ordered identifier suffixes, multi-literal coverage, ordinary ranking and unchanged cue budget passed"

+/-- The floor estimator reserves these same two independent original
+contexts. Offer them before other cues so the promised floor transports the
+actual nominated observations, including their nearby conditions/results. -/
+def prepareMinimumCueViews (records : List (ContextSpan source))
+    (heads : List (Nat × Option Nat)) (decoded : Option (DecodedLayout source))
+    (ranked : List (EvidenceRange source)) : List (EvidenceView source) :=
+  match ranked.head? with
+  | none => []
+  | some first =>
+      let independent := ranked.find? fun other =>
+        other.stop ≤ first.start || first.stop ≤ other.start
+      (first :: independent.toList).filterMap fun cue =>
+        let context := preferredCueContext records heads cue
+        match decoded with
+        | none => some (.original context)
+        | some layout => (decodedEvidenceUsing? layout context).map EvidenceView.decoded
+
+/-- Keep the original cue and its controlling section together. Nearby
+consequences are separate budget proposals, not part of every cue's floor. -/
+def scopedCueMinimum (records : List (ContextSpan source))
+    (heads : List (Nat × Option Nat)) (cue complete : EvidenceRange source) : EvidenceRange source :=
+  let scope := prerequisiteContextRange records heads cue
+  if bounds : scope.start < complete.start ∧ complete.stop - scope.start ≤ 2048 then
+    ⟨scope.start, complete.stop, Nat.lt_trans bounds.1 complete.ordered,
+      complete.within, bounds.2⟩
+  else complete
+
+theorem scoped_cue_minimum_retains_complete
+    (records : List (ContextSpan source)) (heads : List (Nat × Option Nat))
+    (cue complete : EvidenceRange source) (position : Nat)
+    (covered : complete.covers position) :
+    (scopedCueMinimum records heads cue complete).covers position := by
+  unfold scopedCueMinimum
+  dsimp only
+  split
+  · rename_i bounds
+    simp only [EvidenceRange.covers] at *
+    omega
+  · exact covered
+

-      unless !(← backend.stopping.get) && (← IO.monoMsNow) < deadline do
+      unless admissionLive (← backend.stopping.get) (← waiting) (← IO.monoMsNow) deadline do
@@ -324 +335 @@ def Backend.encode (backend : Backend) (config : Config) (client : Socket.Client
-    unless ← peerWaiting client do throw (IO.userError "numerical requester disconnected before admission")
+    IO.sleep 5
@@ -330 +341 @@ def exchangeRaw (child : Kernel) (frame : BlockScore.Frame) (deadline : Nat)
-    (cancelled : IO Bool) (mark : String → IO Unit := fun _ => pure ()) : IO String := do
+    (cancelled : IO Bool) (retire : IO Unit) (mark : String → IO Unit := fun _ => pure ()) : IO String := do
@@ -342,11 +353,18 @@ def exchangeRaw (child : Kernel) (frame : BlockScore.Frame) (deadline : Nat)
-  repeat
-    if (← cancelled) || (← IO.monoMsNow) ≥ deadline then
-      stopRaw child
-      let _ ← IO.wait running
-      throw (IO.userError "raw numerical frame expired or was cancelled")
-    if ← IO.hasFinished running then
-      mark "raw-pipe-task-ready"
-      let result ← IO.ofExcept ((← IO.wait running).mapError IO.Error.toString)
-      unless !result.isEmpty do throw (IO.userError "raw numerical kernel closed its response")
-      return result
-    IO.sleep 5
+  let ready ← TaskDeadline.event running
+  try
+    repeat
+      let now ← IO.monoMsNow
+      if (← cancelled) || now ≥ deadline then
+        throw (IO.userError "raw numerical frame expired or was cancelled")
+      let result ← TaskDeadline.awaitEvent (do
+        let timer ← Selector.sleep (.ofNat (min 5 (deadline-now)))
+        Selectable.one #[.case ready (fun value => pure (some value)),.case timer (fun _ => pure none)])
+      if let some value := result then
+        discard <| IO.wait running
+        mark "raw-pipe-task-ready"
+        unless !value.isEmpty do throw (IO.userError "raw numerical kernel closed its response")
+        return value
+    throw (IO.userError "unreachable raw numerical wait")
+  catch error =>
+    try retire finally discard <| IO.wait running
+    throw error

--- a/Eggshell/Numerical.lean
+++ b/Eggshell/Numerical.lean
@@ -252,7 +252,18 @@ def awaitLine (child : Kernel) (deadline : Nat) (cancelled : IO Bool := pure fal
-/-- A disconnected request waiting for the numerical gate cannot start work.
-No mutex action is queued for later execution after this check returns. -/
-def peerWaiting (client : Socket.Client) : IO Bool :=
-  TaskDeadline.awaitEvent (do
-    let timer ← Selector.sleep (.ofNat 5)
-    Selectable.one #[.case (client.recvSelector 1) (fun _ => pure false),
-      .case timer (fun _ => pure true)])
+/-- One pending native read owns disconnect observation for this numerical
+request. Gate retries never cancel and re-register socket/timer selectors. -/
+def withPeerWaiting (client : Socket.Client) (action : IO Bool → IO α) : IO α := do
+  let peer ← client.native.recv? 1
+  try action (do return !(← peer.isResolved))
+  finally client.native.cancelRecv
+
+def admissionLive (stopping waiting : Bool) (now deadline : Nat) : Bool :=
+  !stopping && waiting && decide (now < deadline)
+
+theorem disconnected_admission_refused (stopping : Bool) (now deadline : Nat) :
+    admissionLive stopping false now deadline = false := by simp [admissionLive]
+
+theorem stopped_admission_refused (waiting : Bool) (now deadline : Nat) :
+    admissionLive true waiting now deadline = false := by simp [admissionLive]
+
+theorem expired_admission_refused (stopping waiting : Bool) (now deadline : Nat) (expired : deadline ≤ now) :
+    admissionLive stopping waiting now deadline = false := by simp [admissionLive,Nat.not_lt_of_ge expired]
@@ -292 +303 @@ def Backend.encode (backend : Backend) (config : Config) (client : Socket.Client
-    (body : String) (deadline : Nat) (mark : String → IO Unit := fun _ => pure ()) : IO String := do
+    (body : String) (deadline : Nat) (mark : String → IO Unit := fun _ => pure ()) : IO String := withPeerWaiting client fun waiting => do
@@ -298 +309 @@ def Backend.encode (backend : Backend) (config : Config) (client : Socket.Client

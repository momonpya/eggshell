@@ -362 +380 @@ def Backend.scoreBlocks (backend : Backend) (config : Config) (client : Socket.C
-      unless !(← backend.stopping.get) && (← IO.monoMsNow) < deadline do
+      unless admissionLive (← backend.stopping.get) (← waiting) (← IO.monoMsNow) deadline do
@@ -381 +399,6 @@ def Backend.scoreBlocks (backend : Backend) (config : Config) (client : Socket.C
-        let result ← IO.ofExcept (Json.parse (← exchangeRaw child frame deadline backend.stopping.get mark))
+        -- The backend owns retirement. Clearing its reference after reaping

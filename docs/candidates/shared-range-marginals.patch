+def numericalCues (family : Family) : List RankedCue :=
+  match Matcher.atomText? family.owner.outcome,Matcher.atomText? family.owner.work with
+  | some source,some work => family.windows.zipIdx.filterMap fun (position,priority) =>
+      (meaningContext? source (work.length+1) position priority).map fun context =>
+        {priority,first := context.span.start,last := context.span.stop}
+  | _,_ => []
+
+def coveringCue? (cues : List RankedCue) (first last : Nat) : Option RankedCue :=
+  cues.find? fun cue => cue.first ≤ first && last ≤ cue.last

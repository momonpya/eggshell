@@ -36 +34,0 @@ run_meta do
-      (``Eggshell.Warm.runTarget, ``Eggshell.Warm.refreshSource),
@@ -44,0 +43,36 @@ run_meta do
+run_meta do
+  let environment ← getEnv
+  for (caller,required) in #[
+      (``Eggshell.Synapses.Build.refresh,``Eggshell.Synapses.Build.stagePreparation),
+      (``Eggshell.Synapses.Build.refresh,``Eggshell.Synapses.Provenance.deriveRecords),
+      (``Eggshell.Synapses.Build.required,``Eggshell.Synapses.Build.preparedFor),
+      (``Eggshell.Synapses.Index.publishDelta,``Eggshell.Synapses.Index.sourcePreparationKey),
+      (``Eggshell.Synapses.Index.replace,``Eggshell.Synapses.Index.sourcePreparationKey),
+      (``Eggshell.Synapses.Journal.publish,``Eggshell.Synapses.Journal.Replay.privateUsage),
+      (``Eggshell.Synapses.Journal.publish,``Eggshell.Synapses.UsageCache.publish)] do
+    let some body := (environment.find? caller).bind (·.value?) | throwError "Missing preparation ownership implementation"
+    unless body.getUsedConstants.contains required do
+      throwError "Preparation ownership is not connected: {caller}, {required}"
+  for (name,declaration) in environment.constants.toList do
+    let domain := name.toString
+    unless domain.startsWith "Eggshell.Synapses." do continue
+    if domain.startsWith "Eggshell.Synapses.Index." || domain.startsWith "Eggshell.Synapses.Build." then continue
+    let some body := declaration.value? | continue
+    for forbidden in #[``Eggshell.Synapses.Index.publishDelta,``Eggshell.Synapses.Index.replace,
+        ``Eggshell.Synapses.Build.stagePreparation] do
+      if body.getUsedConstants.contains forbidden then
+        throwError "Only source derivation can publish the shared graph: {name}, {forbidden}"
+  let some publicKey := (environment.find? ``Eggshell.PreparedInputs.implementation).bind (·.value?) |
+    throwError "Missing public prepared-frame identity"
+  if publicKey.getUsedConstants.contains ``Eggshell.Synapses.UsageCache.implementation then
+    throwError "Private classifier identity invalidates public prepared frames"
+  for (caller,forbidden) in #[
+      (``Eggshell.Warm.runTarget, #[``Eggshell.Warm.refreshSource,``Eggshell.Synapses.Journal.refresh]),
+      (``Eggshell.Plugin.Worker.indexQueued, #[``Eggshell.Warm.refreshSource,``Eggshell.Synapses.Journal.refresh]),
+      (``Eggshell.Synapses.Journal.publish, #[``Eggshell.Synapses.Index.publishDelta,
+        ``Eggshell.Synapses.Index.Reader.lookup,``Eggshell.Synapses.Index.open?])] do
+    let some body := (environment.find? caller).bind (·.value?) | throwError "Missing separated preparation caller"
+    for name in forbidden do
+      if body.getUsedConstants.contains name then
+        throwError "Public/private preparation ownership crossed: {caller}, {name}"
+

diff --git a/Eggshell/CandidateDomain.lean b/Eggshell/CandidateDomain.lean
--- a/Eggshell/CandidateDomain.lean
+++ b/Eggshell/CandidateDomain.lean
@@ -0,0 +1,212 @@
+module
+
+public import Eggshell.GraphStore
+public import Eggshell.Receipt
+
+@[expose] public section
+
+namespace Eggshell.CandidateDomain
+open Lean DB Persistence.Store
+
+/-- Nomination metadata only. Original owners must still be read and checked
+before Match can receive their original Work, Outcome and occurrence authority. -/
+structure Row where
+  owner : Nat
+  ordinal : Nat
+  work : Nat
+  text : String
+  native : Bool
+  windows : List String
+  deriving BEq, ToJson, FromJson
+
+def boolCodec : Wire.Codec Bool := Wire.natural.iso
+  (fun value => if value then 1 else 0) (· != 0) (by intro value; cases value <;> rfl)
+
+def rowCodec : Wire.Codec Row :=
+  (Wire.natural.product (Wire.natural.product (Wire.natural.product
+    (Wire.text.product (boolCodec.product (Wire.list Wire.text)))))).iso
+    (fun row => (row.owner,row.ordinal,row.work,row.text,row.native,row.windows))
+    (fun (owner,ordinal,work,text,native,windows) => ⟨owner,ordinal,work,text,native,windows⟩)
+    (by intro row; cases row; rfl)
+
+structure Data where
+  rows : List Row
+  links : List (Nat × List Nat)
+  deriving BEq
+
+def dataCodec : Wire.Codec Data :=
+  ((Wire.list rowCodec).product (Wire.list (Wire.natural.product (Wire.list Wire.natural)))).iso
+    (fun data => (data.rows,data.links)) (fun (rows,links) => ⟨rows,links⟩)
+    (by intro data; cases data; rfl)
+
+theorem packed_roundtrip (data : Data) (tail : List UInt8) :
+    dataCodec.decode (dataCodec.encode data ++ tail) = .ok (data,tail) :=
+  dataCodec.roundtrip data tail
+
+structure Stamp where
+  database : String
+  authority : String
+  change : Nat
+  roots : Nat
+  candidates : Nat
+  deriving BEq, ToJson, FromJson
+
+def stamp (source : Snapshot) : IO Stamp := do
+  return ⟨source.head.identity,Sha256.hex source.head.authority.toUTF8,
+    ← getNat source.get "sourceChange",← getNat source.get "roots",← getNat source.get "candidates"⟩
+
+def implementation : String := Sha256.hex (
+  (include_str "CandidateDomain.lean").toUTF8 ++
+  (include_str "GraphStore.lean").toUTF8 ++
+  (include_str "SearchRank.lean").toUTF8)
+
+structure Manifest where
+  source : PageMap.Head
+  stamp : Stamp
+  implementation : String
+  digest : String
+  bytes : Nat
+  windows : Nat
+  deriving ToJson, FromJson
+
+def maxBytes : Nat := 64*1024*1024
+
+def directory (source : Snapshot) (storage : Sidecar.Storage) : IO System.FilePath := do
+  return (← Sidecar.locate source storage).directory / "candidate-domain"
+
+def manifest? (source : Snapshot) (storage : Sidecar.Storage) : IO (Option Manifest) := do
+  let path ← directory source storage
+  let bytes ← FileSystem.boundedBytes (path / "ready.json") 65536
+  let some text := String.fromUTF8? bytes | throw (IO.userError "invalid candidate readiness UTF-8")
+  let record ← IO.ofExcept (Json.parse text >>= fromJson? (α := Manifest))
+  unless record.stamp == (← stamp source) && record.implementation == implementation &&
+      record.bytes ≤ maxBytes && record.source.identity == source.head.identity &&
+      record.source.authority == source.head.authority do return none
+  return some record
+
+def Row.document (row : Row) (source : Snapshot) : SearchDocument :=
+  ⟨row.owner,row.work,row.windows,some (Sidecar.Owner.ofSnapshot source)⟩
+
+def Row.origin (row : Row) : WorkOrigin := ⟨.text row.text,row.native⟩
+
+structure Ready where
+  metadata : Manifest
+  data : Data
+  owners : Std.HashMap Nat Row
+  documents : List SearchDocument
+  workIds : Std.HashSet Nat
+
+/-- Stable directory order, unique owner/ordinal identities and all window
+keys are checked once. Cached native flags remain nomination hints. -/
+def prepare (source : Snapshot) (metadata : Manifest) (data : Data) : Except String Ready := do
+  unless data.rows.length == metadata.stamp.candidates do throw "candidate count disagrees"
+  let mut previous : Option Nat := none
+  let mut owners : Std.HashMap Nat Row := {}
+  let mut windows := 0
+  let mut workIds : Std.HashSet Nat := {}
+  for row in data.rows do
+    if owners.contains row.owner || previous.any (· ≥ row.ordinal) then throw "candidate order is not unique"
+    unless !row.windows.isEmpty && row.windows.all (fun value =>
+        value.length == 64 && value.toList.all (fun c =>
+          ('0' ≤ c && c ≤ '9') || ('a' ≤ c && c ≤ 'f'))) do throw "invalid candidate window key"
+    windows := windows+row.windows.length
+    previous := some row.ordinal
+    owners := owners.insert row.owner row
+    workIds := workIds.insert row.work
+  unless windows == metadata.windows do throw "candidate window count disagrees"
+  return ⟨metadata,data,owners,data.rows.map (·.document source),workIds⟩
+
+/-- One bounded payload read, checksum and decode. No source body or owner
+membership is scanned here, and a cold/invalid domain is never repaired. -/
+def open? (source : Snapshot) (storage : Sidecar.Storage) : IO (Option Ready) := do
+  let some metadata ← manifest? source storage | return none
+  let bytes ← FileSystem.boundedBytes ((← directory source storage) / "domain") maxBytes
+  unless bytes.size == metadata.bytes && Sha256.hex bytes == metadata.digest do
+    throw (IO.userError "candidate domain digest disagrees")
+  let (data,tail) ← IO.ofExcept (dataCodec.decode bytes.toList)
+  unless tail.isEmpty do throw (IO.userError "trailing candidate domain bytes")
+  some <$> IO.ofExcept (prepare source metadata data)
+
+def openShared? (source : Snapshot) (receipt : Option String := none) : IO (Option Ready) := do
+  let started ← IO.monoMsNow
+  for storage in [.database,.user] do
+    try
+      if let some ready ← open? source storage then
+        Receipt.observe receipt ("candidate-domain-" ++ source.head.identity) (Json.mkObj [
+          ("status",toJson "ready"),("storage",toJson storage),
+          ("rows",toJson ready.data.rows.length),("windows",toJson ready.metadata.windows),
+          ("bytes",toJson ready.metadata.bytes),("digest",toJson ready.metadata.digest),
+          ("elapsedMs",toJson ((← IO.monoMsNow)-started))])
+        return some ready
+    catch error =>
+      Receipt.observe receipt ("candidate-domain-" ++ source.head.identity) (Json.mkObj [
+        ("status",toJson "unavailable"),("storage",toJson storage),("error",toJson error.toString)])
+  return none
+
+/-- Maintenance hint only. Actual hook reads always verify the packed payload. -/
+def ready (source : Snapshot) : IO Bool := do
+  for storage in [.database,.user] do
+    try
+      if let some _ ← manifest? source storage then return true
+    catch _ => pure ()
+  return false
+
+/-- The same parent membership rule as the complete original-header path.
+Staged Work may extend the parent domain without reopening saved All frames. -/
+def Ready.children (ready : Ready) (parents : Std.HashSet Nat) : Std.HashSet Nat :=
+  ready.data.links.foldl (fun children (parent,values) =>
+    if parents.contains parent then values.foldl (·.insert ·) children else children) {}
+
+structure Result where
+  mode : String
+  metadata : Manifest
+  elapsedMs : Nat
+  deriving ToJson
+
+/-- Explicit/background maintenance only. Original catalogue and Work reads
+happen here once, outside the hook. Two atomically replaced files keep storage
+bounded across source changes; a racing reader can miss but cannot accept a
+mismatching payload. Original graph membership is never written. -/
+def refresh (source : Snapshot) (storage : Sidecar.Storage) : IO Result := do
+  let started ← IO.monoMsNow
+  if let some known ← try open? source storage catch _ => pure none then
+    return ⟨"warm",known.metadata,(← IO.monoMsNow)-started⟩
+  let expected ← stamp source
+  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun sidecar => do
+    unless (← stamp (← (Sidecar.Owner.ofSnapshot source).pin)) == expected do
+      throw (IO.userError "source changed before candidate preparation")
+    let reader ← NodeReader.new source
+    let mut rows := []
+    let mut windows := 0
+    for document in ← searchDocuments source do
+      let origin ← reader.workOrigin (← reader.locateOutcome document.owner)
+      let some text := text? origin.work | throw (IO.userError "candidate Work is not textual")
+      let ordinal ← getNat source.get (key "member" document.owner)
+      let row : Row := {
+        owner := document.owner
+        ordinal := ordinal
+        work := document.work
+        text := text
+        native := origin.native
+        windows := document.windows }
+      rows := row :: rows
+      windows := windows+document.windows.length
+    let mut links := []
+    for entry in ← allHeaders source do
+      let some located := entry.2.atHead? source.head | throw (IO.userError "foreign candidate topology")
+      links := (located.val.header.parent,located.val.header.children) :: links
+    let data : Data := ⟨rows.reverse,links.reverse⟩
+    let bytes := (dataCodec.encode data).toByteArray
+    unless bytes.size ≤ maxBytes do throw (IO.userError "candidate domain exceeds byte budget")
+    let metadata : Manifest := ⟨source.head,expected,implementation,Sha256.hex bytes,bytes.size,windows⟩
+    let _ ← IO.ofExcept (prepare source metadata data)
+    unless (← stamp (← (Sidecar.Owner.ofSnapshot source).pin)) == expected do
+      throw (IO.userError "source changed during candidate preparation")
+    let path ← Sidecar.childDirectory sidecar.directory "candidate-domain"
+    if let some previous ← try manifest? source storage catch _ => pure none then
+      if previous.source.revision > source.head.revision then throw (IO.userError "newer candidate domain already exists")
+    FileSystem.atomicExistingBytes (path / "domain") bytes
+    FileSystem.atomicExistingBytes (path / "ready.json") (toJson metadata).compress.toUTF8
+    return ⟨"prepared",metadata,(← IO.monoMsNow)-started⟩) storage
+
+end Eggshell.CandidateDomain
diff --git a/tests/CandidateDomainTests.lean b/tests/CandidateDomainTests.lean
--- a/tests/CandidateDomainTests.lean
+++ b/tests/CandidateDomainTests.lean
@@ -0,0 +1,124 @@
+import Eggshell.CandidateDomain
+import Eggshell.PluginModel
+
+open Lean Eggshell Eggshell.CandidateDomain Eggshell.Persistence.Store
+
+private def check (value : Bool) (message : String) : IO Unit :=
+  unless value do throw (IO.userError message)
+
+private def native (id : String) : Value :=
+  let tool : Plugin.ToolEvent := {
+    name := "catalog"
+    useId := id
+    input := (Json.mkObj [("item",toJson id)]).compress
+    response := (Json.mkObj [("id",toJson id),("status",toJson "open")]).compress }
+  (Plugin.compileOperationOutcomes (.text "seed") (.text "turn") tool).2
+
+private def publish (source : Snapshot) (values : List Value) : IO Snapshot := do
+  let _ ← DB.PageMap.withWriter source fun writer => do
+    let intern : Intern := ⟨writer,← IO.mkRef {}⟩
+    let ids ← values.mapM intern.root
+    writeChange writer ⟨ids,[],false⟩
+  DB.PageMap.pin source.directory
+
+private def summary (documents : List SearchDocument) : List (Nat × Nat × List String) :=
+  documents.map fun row => (row.owner,row.work,row.windows)
+
+private def scenario (root : System.FilePath) : IO Unit := do
+  let initial ← DB.PageMap.create (root / "source.egg") (Persistence.valueToJson (.text "authority")).compress
+  let a := native "one"
+  let b := native "two"
+  let plain ← IO.ofExcept (Plugin.relation? .outcome [.semantic (.text "通常のWork"),.semantic (.text "plain result")])
+  let some ownerA := OutcomeEdge.fromValue? a | throw (IO.userError "missing fixture owner")
+  let some ownerB := OutcomeEdge.fromValue? b | throw (IO.userError "missing fixture owner")
+  let all ← IO.ofExcept (Plugin.relation? .all [.semantic ownerA.work,.semantic ownerB.work])
+  let source ← publish initial [a,b,plain,all]
+  check ((← openShared? source).isNone) "cold read constructed a domain"
+  check (!(← (source.directory / "derived").pathExists)) "cold read created source files"
+  let sourceHead := source.head
+  let sourceBytes ← IO.FS.readBinFile (DB.PageMap.dataPath source.directory source.head)
+  let expected ← searchDocuments source
+  let built ← refresh source .database
+  check (built.mode == "prepared" && built.metadata.stamp.change > 0) "source change was not stamped"
+  check ((← DB.PageMap.pin source.directory).head == sourceHead &&
+    (← IO.FS.readBinFile (DB.PageMap.dataPath source.directory source.head)) == sourceBytes) "derived preparation changed source DB"
+  let source ← DB.PageMap.pin source.directory
+  source.trace.set (some {})
+  let some prepared ← openShared? source | throw (IO.userError "prepared domain missing")
+  let trace ← source.trace.get
+  check (trace.any fun trace => trace.complete && trace.operations.all (fun operation => match operation with
+    | .point key _ => ["sourceChange","roots","candidates"].contains key
+    | _ => false)) "prepared open read owner directories or original bodies"
+  check (summary prepared.documents == summary expected) "candidate order/windows changed"
+  let reader ← NodeReader.new source
+  for row in prepared.data.rows do
+    let origin ← reader.workOrigin (← reader.locateOutcome row.owner)
+    check (row.origin.work == origin.work && row.origin.native == origin.native &&
+      row.ordinal == (← getNat source.get (key "member" row.owner))) "cached Work/native view changed"
+  let mut originalLinks := []
+  for entry in ← allHeaders source do
+    originalLinks := originalLinks ++ [(entry.2.header.parent,entry.2.header.children)]
+  check (prepared.data.links == originalLinks) "candidate topology changed"
+  let again ← refresh source .database
+  check (again.mode == "warm" && again.metadata.digest == built.metadata.digest) "unchanged warm rebuilt domain"
+  let mut current := source
+  for index in [:20] do
+    let _ ← DB.PageMap.withWriter current fun writer => do
+      writer.put ("memo:domain-test:" ++ toString index) (some "derived".toUTF8)
+      writeChange writer ⟨[],[],false⟩
+    current ← DB.PageMap.pin current.directory
+  let some afterMemos ← openShared? current | throw (IO.userError "memo-only publication invalidated source domain")
+  check (afterMemos.metadata.digest == built.metadata.digest && (← stamp current) == (← stamp source))
+    "derived commits advanced source marker"
+  let appended ← publish current [native "three"]
+  check ((← openShared? appended).isNone && (← stamp appended).change > (← stamp current).change)
+    "new graph reused a stale domain"
+  let _ ← refresh appended .database
+  let some newDomain ← openShared? appended | throw (IO.userError "new publication domain missing")
+  let some id ← findNode? appended b | throw (IO.userError "missing retired owner")
+  let _ ← DB.PageMap.withWriter appended fun writer => do
+    removeRoot writer id
+    writeChange writer ⟨[],[id],false⟩
+  let retracted ← DB.PageMap.pin appended.directory
+  check ((← openShared? retracted).isNone) "retraction retained a ready domain"
+  let _ ← refresh retracted .database
+  let some retained ← openShared? retracted | throw (IO.userError "retracted domain missing")
+  check (retained.data.rows.length+1 == newDomain.data.rows.length && !retained.owners.contains id)
+    "retired owner remained in candidate domain"
+  let folder ← directory retracted .database
+  let good ← IO.FS.readBinFile (folder / "domain")
+  FileSystem.atomicExistingBytes (folder / "domain") (good ++ "damage".toUTF8)
+  check ((← openShared? retracted).isNone) "corrupt packed domain was accepted"
+  let repaired ← refresh retracted .database
+  check (repaired.mode == "prepared" && (← openShared? retracted).isSome) "explicit warm did not repair damaged cache"
+  let copied := root / "copied.egg"
+  IO.FS.createDir copied
+  IO.FS.writeBinFile (copied / "head") (← IO.FS.readBinFile (retracted.directory / "head"))
+  let copiedPages := DB.PageMap.dataPath copied retracted.head
+  IO.FS.writeBinFile copiedPages (← IO.FS.readBinFile (DB.PageMap.dataPath retracted.directory retracted.head))
+  for path in [copied / "head",copiedPages] do
+    IO.setAccessRights path {user := {read := true},group := {},other := {}}
+  IO.setAccessRights copied {user := {read := true,execution := true},group := {},other := {}}
+  let beforeHead ← IO.FS.readBinFile (copied / "head")
+  let beforePages ← IO.FS.readBinFile copiedPages
+  let readOnly ← DB.PageMap.pin copied
+  check ((← openShared? readOnly).isNone) "DB-only copy inherited a hidden sidecar"
+  let privateDomain ← refresh readOnly .user
+  let some portable ← openShared? readOnly | throw (IO.userError "private read-only domain missing")
+  check (summary portable.documents == summary retained.documents &&
+    privateDomain.metadata.digest == retained.metadata.digest && !(← (copied / "derived").pathExists) &&
+    (← IO.FS.readBinFile (copied / "head")) == beforeHead &&
+    (← IO.FS.readBinFile copiedPages) == beforePages) "read-only private preparation changed source/order"
+  IO.FS.writeFile (root / "domain.json") (Json.mkObj [
+    ("rows",toJson retained.data.rows.length),("bytes",toJson retained.metadata.bytes),
+    ("windows",toJson retained.metadata.windows),("sourceMarker",toJson retained.metadata.stamp.change),
+    ("memoPublications",toJson (20 : Nat)),("portableDigest",toJson portable.metadata.digest),
+    ("openSourceObservations",toJson ((trace.map (·.operations.length)).getD 0))]).pretty
+  IO.println "candidate domain checks passed: ordered original Work/native/windows/topology, no catalogue/body reads on open, memo stability, append/retract, corruption, explicit repair and DB-only read-only private reconstruction"
+
+def main (args : List String) : IO Unit := do
+  let [path] := args | throw (IO.userError "CandidateDomainTests NEW-DIRECTORY")
+  let root := System.FilePath.mk path
+  unless root.isAbsolute && !(← root.pathExists) do throw (IO.userError "new absolute test directory required")
+  IO.FS.createDirAll root
+  scenario root
diff --git a/tools/research/CandidateDomainAudit.lean b/tools/research/CandidateDomainAudit.lean
--- a/tools/research/CandidateDomainAudit.lean
+++ b/tools/research/CandidateDomainAudit.lean
@@ -0,0 +1,116 @@
+import Eggshell.Handoff
+import Eggshell.CandidateDomain
+
+open Lean Eggshell Eggshell.Persistence.Store
+
+private def check (value : Bool) (message : String) : IO Unit :=
+  unless value do throw (IO.userError message)
+
+private def catalogue (database report : System.FilePath) : IO Unit := do
+  let source ← DB.PageMap.pin database
+  let started ← IO.monoMsNow
+  let reader ← NodeReader.new source
+  let mut rows : List CandidateDomain.Row := []
+  for document in ← searchDocuments source do
+    let original ← reader.workOrigin (← reader.locateOutcome document.owner)
+    let some text := text? original.work | throw (IO.userError "nontextual candidate")
+    let ordinal ← getNat source.get (key "member" document.owner)
+    rows := ⟨document.owner,ordinal,document.work,text,original.native,document.windows⟩ :: rows
+  rows := rows.reverse
+  let originalMs := (← IO.monoMsNow)-started
+  let originalReads ← source.reads.get
+  let built ← CandidateDomain.refresh source .user
+  let mut samples := #[]
+  for _ in [:10] do
+    let pinned ← DB.PageMap.pin database
+    pinned.trace.set (some {})
+    let started ← IO.monoMsNow
+    let some ready ← CandidateDomain.openShared? pinned | throw (IO.userError "prepared catalogue missing")
+    check (ready.data.rows == rows) "original candidate order/view changed"
+    let elapsed := (← IO.monoMsNow)-started
+    let some trace ← pinned.trace.get | throw (IO.userError "missing read trace")
+    check (trace.complete && trace.operations.all (fun operation => match operation with
+      | .point key _ => ["sourceChange","roots","candidates"].contains key
+      | _ => false)) "prepared catalogue read original owners/bodies"
+    samples := samples.push (Json.mkObj [("elapsedMs",toJson elapsed),
+      ("dbPageReads",toJson (← pinned.reads.get)),("sourceObservations",toJson trace.operations.length)])
+  check ((← DB.PageMap.pin database).head == source.head) "catalogue audit changed DB head"
+  IO.FS.writeFile report (Json.mkObj [
+    ("scope",toJson "real DB catalogue and Work/native views only; not full hook latency"),
+    ("source",toJson source.head),("rows",toJson rows.length),("windows",toJson built.metadata.windows),
+    ("bytes",toJson built.metadata.bytes),("originalMs",toJson originalMs),
+    ("originalDbPageReads",toJson originalReads),("warm",toJson built),("samples",toJson samples)]).pretty
+
+private def delivery (database output : System.FilePath) : IO Unit := do
+  IO.FS.createDirAll output
+  let source ← DB.PageMap.pin database
+  check (!(← CandidateDomain.ready source)) "delivery reference must begin without prepared metadata"
+  let _ ← RetrievalResearch.Index.warm source .user
+  let selection : Config.Selection := {
+    label := "candidate-domain-regression"
+    read := [⟨"fixture",database⟩]
+    write := none
+    semanticMatcher := none
+    handoffChars := 120000 }
+  let queries := ["通常のWork","Inspect catalog item one status","unrelated missing subject"]
+  let mut before : Array (Option Plugin.Handoff) := #[]
+  for (query,index) in queries.zipIdx do
+    let handoff ← Plugin.computeAutomaticHandoff selection [some source] query [] false
+    before := before.push handoff
+    IO.FS.writeFile (output / s!"reference-{index}.json") (toJson handoff).compress
+    IO.FS.writeFile (output / s!"reference-{index}.txt") ((handoff.map (·.text)).getD "")
+  check (before.any (·.isSome)) "all reference packets were empty"
+  let _ ← CandidateDomain.refresh source .user
+  let mut cases := #[]
+  for (query,index) in queries.zipIdx do
+    let handoff ← Plugin.computeAutomaticHandoff selection [some source] query [] false
+    let previous := before[index]!
+    IO.FS.writeFile (output / s!"prepared-{index}.json") (toJson handoff).compress
+    IO.FS.writeFile (output / s!"prepared-{index}.txt") ((handoff.map (·.text)).getD "")
+    check ((previous.map (·.text)) == (handoff.map (·.text)) &&
+      (previous.map (·.completed)) == (handoff.map (·.completed)) &&
+      (previous.map (·.advisory)) == (handoff.map (·.advisory)) &&
+      (previous.map (·.blocksCurrent)) == (handoff.map (·.blocksCurrent)) &&
+      (previous.map (·.localUnions)) == (handoff.map (·.localUnions))) "prepared domain changed delivery/control"
+    cases := cases.push (Json.mkObj [("query",toJson query),("present",toJson handoff.isSome),
+      ("bodyBytes",toJson (((handoff.map (·.text)).getD "").utf8ByteSize)),("byteEqual",toJson true)])
+  check ((← DB.PageMap.pin database).head == source.head) "delivery audit changed original DB"
+  IO.FS.writeFile (output / "delivery.json") (Json.mkObj [
+    ("scope",toJson "fixed-snapshot discovery and packet regression; no daemon, model or token comparison"),
+    ("cases",toJson cases)]).pretty
+
+private def packed (database report : System.FilePath) : IO Unit := do
+  let source ← DB.PageMap.pin database
+  let key := Sha256.hex "original-window".toUTF8
+  let rows := (List.range 10000).map fun index =>
+    (⟨index+1,index,index+10001,s!"catalogue item {index}",true,List.replicate 5 key⟩ : CandidateDomain.Row)
+  let data : CandidateDomain.Data := ⟨rows,[]⟩
+  let bytes := (CandidateDomain.dataCodec.encode data).toByteArray
+  let checksum := Sha256.hex bytes
+  let expected : CandidateDomain.Stamp := ⟨source.head.identity,Sha256.hex source.head.authority.toUTF8,0,10000,10000⟩
+  let metadata : CandidateDomain.Manifest := ⟨source.head,expected,CandidateDomain.implementation,checksum,bytes.size,50000⟩
+  let mut timings : Array Nat := #[]
+  for _ in [:50] do
+    let started ← IO.monoMsNow
+    check (Sha256.hex bytes == checksum) "packed checksum changed"
+    let (decoded,tail) ← IO.ofExcept (CandidateDomain.dataCodec.decode bytes.toList)
+    check (tail.isEmpty && decoded == data) "packed domain roundtrip changed"
+    let prepared ← IO.ofExcept (CandidateDomain.prepare source metadata decoded)
+    check (prepared.documents.length == 10000 && prepared.metadata.windows == 50000) "packed population changed"
+    timings := timings.push ((← IO.monoMsNow)-started)
+  let ordered := timings.qsort (· < ·)
+  IO.FS.writeFile report (Json.mkObj [
+    ("scope",toJson "synthetic packed metadata microbenchmark only; not a 50000-window DB or full hook"),
+    ("rows",toJson (10000 : Nat)),("windows",toJson (50000 : Nat)),("bytes",toJson bytes.size),
+    ("samplesMs",toJson timings),("p95Ms",toJson ordered[47]!),
+    ("sourceWritten",toJson false),("answeringModelCalls",toJson (0 : Nat))]).pretty
+
+def main (args : List String) : IO Unit := do
+  let [mode,database,output] := args | throw (IO.userError "CandidateDomainAudit MODE DB NEW-OUTPUT")
+  let output := System.FilePath.mk output
+  check (!(← output.pathExists)) "keep existing audit evidence"
+  match mode with
+  | "catalogue" => catalogue (.mk database) output
+  | "delivery" => delivery (.mk database) output
+  | "packed" => packed (.mk database) output
+  | _ => throw (IO.userError "unknown audit mode")

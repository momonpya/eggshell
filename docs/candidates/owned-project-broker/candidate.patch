+/-- Local administration grants a complete logical project inventory. Physical
+paths and private journals are not delegated to publication clients. -/
+structure ProjectGrant where
+  manifest : ProjectStore.Manifest
+  capability : String
+  deriving ToJson, FromJson
+
+/-- A session always reaches the same source owner in this immutable inventory.
+The service derives the route; clients cannot choose a different owner on retry. -/
+def ownerSlot (session : String) (owners : Nat) : Nat := (hash session).toNat % owners
+
+theorem ownerSlot_bounded (session : String) (owners : Nat) (nonempty : 0 < owners) :
+    ownerSlot session owners < owners := Nat.mod_lt _ nonempty

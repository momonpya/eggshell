+  let response ← Daemon.exchange peer "project-pin" (Json.mkObj [
+    ("database",toJson granted.manifest.identity),("budgetMs",toJson budget)]) (budget := budget)
+  let cut ← IO.ofExcept (Json.parse response >>= fromJson? (α := ProjectStore.Cut))
+  unless cut.inScope granted.manifest do throw (IO.userError "publisher pin omitted or mixed original owners")
+  return cut
+
+def submitProject (endpoint : Daemon.Endpoint) (granted : ProjectGrant) (cut : ProjectStore.Cut)
+    (capsule : Capsule) (deadline : Nat) : IO NativePublication.SourceReceipt := do
+  unless cut.inScope granted.manifest do throw (IO.userError "publication cut omitted or mixed original owners")
+  let budget ← liveBudget deadline
+  let peer := {endpoint with secret := granted.capability}
+  let response ← Daemon.exchange peer "project-publish" (Json.mkObj [
+    ("database",toJson granted.manifest.identity),("capsule",toJson capsule),
+    ("cut",toJson cut),("budgetMs",toJson budget)]) (budget := budget)
+  let receipt ← IO.ofExcept (Json.parse response >>= fromJson? (α := NativePublication.SourceReceipt))
+  let slot := ownerSlot capsule.session granted.manifest.owners.size
+  let some original := granted.manifest.owners[slot]? | throw (IO.userError "publisher original route is missing")
+  unless receipt.accounted && receipt.head.identity == original.identity &&
+      receipt.head.authority == original.authority do throw (IO.userError "publisher returned another original ACK")
+  let request ← IO.ofExcept (capsule.prepare (.mk ".") original.identity)
+  let expected := NativePublication.receipt request.items receipt.head
+  unless toJson expected == toJson receipt do throw (IO.userError "project source ACK changed observation coverage")
+  return receipt
+

+/-- A service retains its source-owner capability for its entire lifetime.
+Closing drains admitted IO before releasing the lease. The closed lifecycle
+also rejects an escaped capability after another service acquires the slot. -/
+@[no_expose] def Owner.close (owner : Owner) : IO Unit := do
+  owner.lifecycle.atomically (modify fun state => {state with live := false})
+  while (← owner.lifecycle.atomically do return (← get).busy) do IO.sleep 1
+  FileSystem.unlockRead owner.lease
+
+@[no_expose] def withOwner (project : Project) (slot : Nat) (action : Owner → IO α) : IO α := do

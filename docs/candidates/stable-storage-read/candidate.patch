+  let before ← version
   if before.bytes > limit then throw (IO.userError "storage object exceeds byte budget")
   let mut bytes := ByteArray.empty
   while bytes.size < before.bytes do
     let count := min 4096 (before.bytes - bytes.size)
-    let part ← readPage handle bytes.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩
+    let part ← page bytes.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩
     unless part.size == count do throw (IO.userError "truncated storage object")
     bytes := bytes ++ part
-  unless (← readVersion handle) == before do throw (IO.userError "storage object mutated during read")
-  pure bytes
+  return checkedStorageImage? limit before (← version) bytes
 
+/-- Retry the same pinned descriptor, without reopening the current path,
+waiting, or weakening version equality. A retired immutable image stabilizes;
+a continuously changing image exhausts the fixed attempt budget. -/
+def boundedStorageImageWith (attempts limit : Nat) (version : IO ReadVersion)
+    (page : UInt64 → ReadSize → IO ByteArray) : IO (StorageImage limit) :=
+  let rec attempt : Nat → IO (StorageImage limit)
+    | 0 => throw (IO.userError "storage object did not stabilize during read")
+    | remaining+1 => do
+        match ← storageReadAttempt limit version page with
+        | some image => pure image
+        | none => attempt remaining
+  attempt attempts
+
+def boundedRead (handle : ReadHandle) (limit : Nat) : IO ByteArray := do
+  return (← boundedStorageImageWith 3 limit (readVersion handle) (readPage handle)).bytes
+
+def boundedBytes (path : System.FilePath) (limit : Nat) : IO ByteArray := do
+  boundedRead (← openRead path.toString) limit
+
 theorem bounded_read_original (path : System.FilePath) (limit : Nat) :
     boundedBytes path limit = (do boundedRead (← openRead path.toString) limit) := by
   rfl

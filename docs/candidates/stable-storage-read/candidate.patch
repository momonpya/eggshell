+/-- An accepted storage image is complete, bounded, and has the full OS
+version unchanged throughout its own read. It need not still occupy its path:
+an atomic publisher may have retired this pinned immutable descriptor. -/
+structure StorageImage (limit : Nat) where
+  before : ReadVersion
+  after : ReadVersion
+  bytes : ByteArray
+  unchanged : before = after
+  complete : bytes.size = before.bytes
+  bounded : bytes.size ≤ limit
 
-def boundedRead (handle : ReadHandle) (limit : Nat) : IO ByteArray := do
-  let before ← readVersion handle
+def checkedStorageImage? (limit : Nat) (before after : ReadVersion)
+    (bytes : ByteArray) : Option (StorageImage limit) :=
+  if unchanged : before = after then
+    if complete : bytes.size = before.bytes then
+      if bounded : bytes.size ≤ limit then
+        some ⟨before,after,bytes,unchanged,complete,bounded⟩
+      else none
+    else none
+  else none
+
+theorem storage_image_unchanged (image : StorageImage limit) :
+    image.before = image.after := image.unchanged
+
+theorem storage_image_complete (image : StorageImage limit) :
+    image.bytes.size = image.before.bytes := image.complete
+
+theorem storage_image_bounded (image : StorageImage limit) :
+    image.bytes.size ≤ limit := image.bounded
+
+theorem mutated_storage_image_rejected (limit : Nat) (before after : ReadVersion)
+    (bytes : ByteArray) (changed : before ≠ after) :
+    checkedStorageImage? limit before after bytes = none := by
+  simp [checkedStorageImage?,changed]
+
+theorem incomplete_storage_image_rejected (limit : Nat) (before after : ReadVersion)
+    (bytes : ByteArray) (incomplete : bytes.size ≠ before.bytes) :
+    checkedStorageImage? limit before after bytes = none := by
+  simp [checkedStorageImage?,incomplete]
+
+theorem oversized_storage_image_rejected (limit : Nat) (before after : ReadVersion)
+    (bytes : ByteArray) (oversized : ¬ bytes.size ≤ limit) :
+    checkedStorageImage? limit before after bytes = none := by
+  simp [checkedStorageImage?,oversized]
+

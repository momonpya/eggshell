 def anchor (term : String) : Bool := RetrievalResearch.anchor term
 
+/-- Explicit identifier/path spellings are advisory locators. A sentence-final
+dot/colon alone does not turn an ordinary word into a structured locator. -/
+def literalUnits (characters : List Char) : Bool :=
+  (RetrievalResearch.boundaryWord characters).any fun c =>
+    "_/:.".contains c || SearchUnicode.isDigit c
+
+def literalTerm (term : String) : Bool := literalUnits term.toList
+
+theorem literalUnits_period (characters : List Char) :
+    literalUnits (characters++['.']) = literalUnits characters := by
+  simp only [literalUnits,RetrievalResearch.boundaryWord_period]
+
+theorem literalUnits_colon (characters : List Char) :
+    literalUnits (characters++[':']) = literalUnits characters := by
+  simp only [literalUnits,RetrievalResearch.boundaryWord_colon]
+
+/-- Stable routing within the existing nomination domain. Scores and relative
+order inside each lane are unchanged; this grants no reuse authority. -/
+def preferLiteralMatches (ranked : List Nat) (named : Nat → Bool) : List Nat :=
+  ranked.filter named ++ ranked.filter (fun index => !named index)
+
+theorem preferLiteralMatches_members (ranked : List Nat) (named : Nat → Bool) (id : Nat) :
+    id ∈ preferLiteralMatches ranked named ↔ id ∈ ranked := by
+  cases h : named id <;> simp [preferLiteralMatches,h]
+
+theorem preferLiteralMatches_order (ranked : List Nat) (named : Nat → Bool) :
+    (preferLiteralMatches ranked named).filter named = ranked.filter named := by
+  simp only [preferLiteralMatches,List.filter_append,List.filter_filter]
+  simp
+
 def scoreOrder (a b : Float × Nat) : Bool :=
   a.1 > b.1 || (a.1 == b.1 && a.2 ≤ b.2)
 

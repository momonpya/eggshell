+def sentenceEnd (c : Char) : Bool := c == '.' || c == ':'
+
+def boundaryWord (characters : List Char) : List Char :=
+  (characters.reverse.dropWhile sentenceEnd).reverse
+
+private theorem dropWhile_stable (predicate : Char → Bool) (characters : List Char) :
+    (characters.dropWhile predicate).dropWhile predicate = characters.dropWhile predicate := by
+  induction characters with
+  | nil => rfl
+  | cons head tail ih =>
+    cases h : predicate head <;> simp [h,ih]
+
+theorem boundaryWord_idempotent (characters : List Char) :
+    boundaryWord (boundaryWord characters) = boundaryWord characters := by
+  simp [boundaryWord,dropWhile_stable]
+
+theorem boundaryWord_period (characters : List Char) :
+    boundaryWord (characters++['.']) = boundaryWord characters := by
+  simp [boundaryWord,sentenceEnd,List.reverse_append]
+
+theorem boundaryWord_colon (characters : List Char) :
+    boundaryWord (characters++[':']) = boundaryWord characters := by
+  simp [boundaryWord,sentenceEnd,List.reverse_append]
+
+/-- Preserve each literal path/identifier and add a punctuation-boundary alias.
+The fast suffix check avoids reversing ordinary words. A meaningful trailing
+dot/colon remains searchable by its original form; no identity uses this alias. -/
+def wordForms (characters : List Char) : List String :=
+  if characters.isEmpty then [] else
+  let literal := String.ofList characters
+  if literal.endsWith "." || literal.endsWith ":" then
+    let boundary := boundaryWord characters
+    if boundary.isEmpty then [literal] else [literal,String.ofList boundary]
+  else [literal]
+
+theorem wordForms_literal (characters : List Char) (nonempty : characters.isEmpty = false) :
+    String.ofList characters ∈ wordForms characters := by
+  simp only [wordForms,nonempty,Bool.false_eq_true,↓reduceIte]
+  split
+  · split <;> simp
+  · simp
+
+theorem wordForms_bounded (characters : List Char) : (wordForms characters).length ≤ 2 := by
+  unfold wordForms
+  split
+  · simp
+  · dsimp only
+    split
+    · split <;> simp
+    · simp
+
+def StableTerms.addWord (state : StableTerms) (characters : List Char) : StableTerms :=
+  (wordForms characters).foldl StableTerms.add state
+

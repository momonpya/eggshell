+
+/-- Complete cited regions in the best actually nominated parent form the
+first advisory tier. One region has one vote, independent of byte length.
+Ordinary units may fulfill a region only when they carry every required
+original range. Closures/costs are exactly the ordinary immutable problem. -/
+def referenceProblem (p : SharedCoverage.Problem) (units : List UnitPlan) :
+    Option SharedCoverage.Problem := do
+  if units.length != p.offers.size then none else do
+    let candidates := units.filterMap fun unit => unit.referencePriority.map (unit,·)
+    let ranked : List (UnitPlan × Nat) := candidates.foldl (fun known row =>
+      match known.find? (fun prior => prior.1.family == row.1.family && prior.1.ranges == row.1.ranges) with
+      | none => known ++ [row]
+      | some prior => known.map fun old =>
+          if old.1.family == row.1.family && old.1.ranges == row.1.ranges then
+            (old.1,min prior.2 row.2) else old) []
+    let initial ← ranked.head?
+    let first := ranked.foldl (fun value row => min value row.2) initial.2
+    let demands := (ranked.filter (·.2 == first)).map Prod.fst
+    let weights := (demands.map fun _ => 1).toArray
+    let offers ← units.zipIdx.mapM fun (unit,index) => do
+      let original ← p.offers[index]?
+      let covered ← demands.zipIdx.filterMapM fun (demand,index) =>
+        if unit.family == demand.family &&
+            demand.ranges.all (fun (a,b) => covers unit.ranges a b) then
+          if valid : index < weights.size then some (some (⟨index,valid⟩ : Fin weights.size)) else none
+        else some none
+      pure ({closure := original.closure,covers := covered} : SharedCoverage.Offer p.costs.size weights.size)
+    pure {costs := p.costs,weights,offers := offers.toArray,fixed := p.fixed,limit := p.limit}
+
+/-- Replay the selected first-tier indices through the ordinary checked
+extension, then spend the remaining shared budget on current-question focus.
+This tier carries no native control and never relaxes a wire limit. -/
+def choose (p : SharedCoverage.Problem) (units : List UnitPlan) :
+    Option (SharedCoverage.Selection p) := do
+  if !units.any (·.referencePriority.isSome) then SharedCoverage.choose? p else do
+    let references ← referenceProblem p units
+    let selected ← SharedCoverage.choose? references
+    let mut prior ← SharedCoverage.empty? p
+    for index in selected.selected do
+      if valid : index.val < p.offers.size then
+        prior ← SharedCoverage.extend? prior ⟨index.val,valid⟩
+      else none
+    pure (SharedCoverage.fill p.offers.size prior)


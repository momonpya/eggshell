+/-- A citation is an entire finite stored range, not a byte-valued collection
+of independently rewarded fragments. Join existing minimal local closures;
+this never hydrates extra data or invents a Match. Identical closed payloads
+receive only their best producer rank. -/
+def closeReferenceGroups (familyIndex : Nat) (family : Family)
+    (units : List UnitPlan) : List UnitPlan := Id.run do
+  let mut bundled : List UnitPlan := []
+  for (priority,positions) in family.referenceGroups do
+    if positions.isEmpty then continue
+    let parts := positions.filterMap fun position =>
+      (units.filter (fun unit => unit.positions.contains position)).foldl
+        (fun found unit => match found with
+          | none => some unit
+          | some before => if unit.slice.text.utf8ByteSize < before.slice.text.utf8ByteSize then
+              some unit else found) none
+    if parts.length != positions.length then continue
+    let some first := parts.head? | continue
+    let joined := parts.tail.foldl (fun found unit =>
+      found.bind fun prior => join prior unit.slice) (some first.slice)
+    let some slice := joined | continue
+    let some context := slice.context | continue
+    let ranges := fragmentRanges context.fragments
+    if let some previous := bundled.find? (·.ranges == ranges) then
+      let best := min priority (previous.referencePriority.getD priority)
+      bundled := bundled.map fun unit => if unit.ranges == ranges then
+        {unit with referencePriority := some best} else unit
+    else
+      let costFragments := parts.flatMap fun unit =>
+        unit.costFragments.getD (unit.slice.context.map (·.fragments) |>.getD [])
+      bundled := bundled ++ [{family := familyIndex,slice,ranges,positions,referencePriority := some priority,costFragments := some costFragments}]
+  return units ++ bundled


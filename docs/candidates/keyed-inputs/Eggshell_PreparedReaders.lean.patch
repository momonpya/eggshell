+/-- The full authorized cut and captured producer/model/encoder are checked
+before using an image. All resulting mutable readers belong to this actor. -/
+@[no_expose] def Borrow.keyed (borrow : Borrow) (request : KeyedProtocol.Request)
+    (model encoder : String) (numeric : Bool) : IO (Array Snapshot × Array (Option KeyedSource)) := do
+  unless toJson request.sources == toJson (borrow.sources.map KeyedProtocol.Scope.ofSnapshot) do
+    throw (IO.userError "keyed reader changed its complete authorized source cut")
+  let some inputs := request.prepared | throw (IO.userError "keyed reader omitted captured inputs")
+  unless toJson (publicInputs inputs) == toJson borrow.image.inputs &&
+      inputs.size == borrow.sources.size && borrow.image.keyed.size == inputs.size &&
+      borrow.image.keyedReads.size == inputs.size do
+    throw (IO.userError "keyed reader changed its prepared public inputs")
+  let mut sources := #[]
+  let mut views := #[]
+  for index in [:inputs.size] do
+    let some input := inputs[index]? | throw (IO.userError "keyed image omitted an input")
+    let some original := borrow.sources[index]? | throw (IO.userError "keyed image omitted an original")
+    unless input.accepts original model encoder do
+      throw (IO.userError "keyed reader changed its source, producer, model or encoder")
+    let some scope := borrow.image.scopes[index]? | throw (IO.userError "keyed image omitted a scope")
+    let some originalImage := borrow.image.originals[index]? | throw (IO.userError "keyed image omitted a source frame")
+    let some reads := borrow.image.keyedReads[index]? | throw (IO.userError "keyed image omitted read dependencies")
+    let some image := borrow.image.keyed[index]? | throw (IO.userError "keyed image omitted a public input frame")
+    let source ← originalImage.borrow borrow.pages scope
+    reads.replay original
+    let view ← image.mapM fun image => image.borrow borrow.pages scope source numeric
+    unless view.isSome == decide (input.population > 0) do
+      throw (IO.userError "keyed reader changed the captured nonempty population")
+    sources := sources.push source
+    views := views.push view
+  return (sources,views)
+

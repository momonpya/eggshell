+
+/-- Decoded query-independent metadata only. No request counter, mutable
+page front, trace or query vector is retained in this image. -/
+structure KeyedNumeric where
+  partition : SnapshotImage
+  header : VectorPartition.Header
+  matrix : SnapshotImage
+  metadata : VectorMatrix.Manifest
+  storage : Sidecar.Storage
+  sameMatrix : header.basis.matrix = matrix.head
+
+structure KeyedSource where
+  source : Snapshot
+  windows : WindowOwners.Ready
+  lexical : RetrievalResearch.Index.Reader source
+  numeric : Option (PartitionBuild.ReadView source × Sidecar.Storage)
+
+structure KeyedImage where
+  windows : SnapshotImage
+  windowManifest : WindowOwners.Manifest
+  lexical : SnapshotImage
+  lexicalStamp : RetrievalResearch.Index.Stamp
+  numeric : Option KeyedNumeric
+
+def KeyedImage.restore (image : KeyedImage) (source windows lexical : Snapshot)
+    (numeric : Option (PartitionBuild.ReadView source × Sidecar.Storage)) : KeyedSource :=
+  ⟨source,⟨windows,image.windowManifest⟩,⟨lexical,image.lexicalStamp⟩,numeric⟩
+
+theorem KeyedImage.restore_source (image : KeyedImage) (source windows lexical numeric) :
+    (image.restore source windows lexical numeric).source = source := rfl
+
+theorem KeyedImage.restore_manifest (image : KeyedImage) (source windows lexical numeric) :
+    (image.restore source windows lexical numeric).windows.manifest = image.windowManifest := rfl
+
+theorem KeyedImage.restore_population (image : KeyedImage) (source windows lexical numeric) :
+    (image.restore source windows lexical numeric).lexical.expected = image.lexicalStamp := rfl
+
+def KeyedImage.capture (pages : PageMap.PagePool) (scope : String) (source : Snapshot)
+    (input : PreparedInputs.Reference) : IO (Option KeyedImage) := do
+  unless input.population == (← getNat source.get "candidates") do
+    throw (IO.userError "keyed image changed its original population")
+  if input.population == 0 then return none
+  let windows ← PreparedInputs.windows input source
+  let lexical ← PreparedInputs.lexical input source
+  let numeric ← input.numeric.mapM fun _ => do
+    let (numeric,storage) ← PreparedInputs.numerical input source
+    let partition ← SnapshotImage.capture pages scope numeric.partition.snapshot
+    let matrix ← SnapshotImage.capture pages scope numeric.matrix.snapshot
+    if bound : numeric.partition.header.basis.matrix = matrix.head then
+      pure (⟨partition,numeric.partition.header,matrix,numeric.matrix.metadata,storage,bound⟩ : KeyedNumeric)
+    else throw (IO.userError "captured keyed matrix changed its routing basis")
+  return some ⟨← SnapshotImage.capture pages scope windows.snapshot,windows.manifest,
+    ← SnapshotImage.capture pages scope lexical.index,lexical.expected,numeric⟩
+
+def KeyedImage.borrow (image : KeyedImage) (pages : PageMap.PagePool) (scope : String)
+    (source : Snapshot) (wantNumeric : Bool) : IO KeyedSource := do
+  let windows ← image.windows.borrow pages scope
+  let lexical ← image.lexical.borrow pages scope
+  let numeric : Option (PartitionBuild.ReadView source × Sidecar.Storage) ← if !wantNumeric then pure none else do
+    let some numeric := image.numeric | throw (IO.userError "keyed image has no captured numeric input")
+    let partition ← numeric.partition.borrow pages scope
+    let matrix ← numeric.matrix.borrow pages scope
+    if bound : numeric.header.basis.matrix = matrix.head then
+      let view : PartitionBuild.ReadView source := ⟨⟨partition,numeric.header⟩,⟨numeric.metadata,matrix⟩,bound⟩
+      pure (some (view,numeric.storage))
+    else throw (IO.userError "keyed image changed its exact numeric matrix")
+  return image.restore source windows lexical numeric

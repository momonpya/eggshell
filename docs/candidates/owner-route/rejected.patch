+@[expose] public section
+namespace Eggshell.OwnerViews
+open Lean DB Persistence.Store
+
+def implementation : String := Sha256.hex ((include_str "OwnerViews.lean").toUTF8 ++ PreparedOwners.implementation.toUTF8)
+
+structure Location where
+  directory : String
+  identity : String
+  deriving ToJson, FromJson, BEq
+
+structure Group where
+  sources : Array Location
+  deriving ToJson, FromJson, BEq
+
+def Group.key (group : Group) : String := Sha256.hex ((toJson group).compress.toUTF8 ++ implementation.toUTF8)
+def Group.ofSources (sources : Array Snapshot) : Group :=
+  ⟨sources.map fun source => ⟨source.directory.normalize.toString,source.head.identity⟩⟩
+
+def root : IO System.FilePath := return (← Plugin.dataRoot)/"owner-views"/implementation
+def folder (group : Group) : IO System.FilePath := return (← root)/group.key
+def cutKey (sources : Array Snapshot) : String := Sha256.hex (toJson (sources.map (·.head))).compress.toUTF8
+
+structure Reference where
+  producer : String
+  group : Group
+  head : PageMap.Head
+  sources : Array PageMap.Head
+  deriving ToJson, FromJson, BEq
+
+def Group.pin (group : Group) : IO (Array Snapshot) := group.sources.mapM fun location => do
+  let source ← PageMap.pin (.mk location.directory)
+  unless source.head.identity == location.identity do throw (IO.userError "owner-view source incarnation changed")
+  return source
+
+/-- Read-only admission. A configured cut without a completed view remains
+unavailable; it cannot select latest or trigger bootstrap from a hook. -/
+def load? (sources : Array Snapshot) : IO (Option Reference) := do
+  let group := Group.ofSources sources
+  let path ← folder group
+  let some book ← PageMap.open? (path/"ready.egg") | return none
+  let record ← PreparedOwners.readJson (α := Reference) book book.get ("cut-"++cutKey sources)
+  let some record := record | return none
+  unless record.producer == implementation && record.group == group &&
+      record.sources == sources.map (·.head) do
+    throw (IO.userError "owner-view completion directory changed its exact source cut")
+  return some record
+
+def restore (reference : Reference) (sources : Array Snapshot) : IO PreparedOwners.Reader := do
+  unless reference.producer == implementation && reference.group == Group.ofSources sources &&
+      reference.sources == sources.map (·.head) do
+    throw (IO.userError "captured owner view omitted or substituted a source")
+  let path ← folder reference.group
+  let current ← PageMap.pin (path/"view.egg")
+  let some history ← PageMap.HistoryReader.make? current reference.head |
+    throw (IO.userError "captured owner-view extent is unavailable")
+  let some reader ← PreparedOwners.open? history.snapshot sources reference.group.key PreparedOwners.implementation |
+    throw (IO.userError "captured owner view disagrees with its original boundary")
+  return reader
+
+def register (sources : Array Snapshot) : IO Group := do
+  let group := Group.ofSources sources
+  let directory ← root
+  FileSystem.privateDirectory directory
+  let bytes := (toJson group).compress.toUTF8
+  unless bytes.size ≤ 1024*1024 do throw (IO.userError "owner-view source inventory exceeds its registry budget")
+  let path := directory/(group.key++".json")
+  FileSystem.immutableExistingBytes path bytes
+  for source in sources do Plugin.registerTargetSource directory source.head.identity group.key
+  return group
+
+def openIndex (path : System.FilePath) (authority : String) : IO Snapshot := do
+  if let some source ← PageMap.open? path then return source
+  try PageMap.create path authority
+  catch error =>
+    if let some source ← PageMap.open? path then return source
+    throw error
+
+/-- Outside retrieval only. Every descriptor is published after the entire
+declared cut has been compiled. Original writers own different physical files.
+Busy/stale derived writers fail the attempt and leave normal preparation debt. -/
+def prepare (sources : Array Snapshot) : IO Reference := do
+  if let some reference ← load? sources then return reference
+  let group ← register sources
+  let directory ← folder group
+  FileSystem.privateDirectory directory
+  let index ← openIndex (directory/"view.egg") group.key
+  let (head,_) ← PreparedOwners.prepare index sources group.key PreparedOwners.implementation
+  let reference : Reference := ⟨implementation,group,head,sources.map (·.head)⟩
+  let book ← openIndex (directory/"ready.egg") group.key
+  let _ ← PageMap.withWriter book fun writer => do
+    let name := "cut-"++cutKey sources
+    if (← writer.get (key name 0)).isSome then return
+    let count ← getNat writer.get "count"
+    let slot := key "slot" (count%64)
+    if let some old ← writer.get slot then
+      let some old := String.fromUTF8? old | throw (IO.userError "invalid owner-view retirement slot")
+      writer.put (key old 0) none
+    PreparedOwners.writeJson writer name reference
+    writer.put slot (some name.toUTF8)
+    putNat writer "count" (count+1)
+  return reference
+
+def groups (source : Snapshot) : IO (Array Group) := do
+  let directory ← root
+  let paths ← Plugin.targetReferences directory (some #[source.head.identity])
+  paths.mapM fun path => do
+    let group ← (Plugin.readBoundedJson path (1024*1024) : IO Group)
+    unless path.fileName == some (group.key++".json") &&
+        group.sources.any (·.identity == source.head.identity) do
+      throw (IO.userError "owner-view registry source binding changed")
+    return group
+
+def requiredFor (source : Snapshot) : IO Bool := do
+  for group in ← groups source do
+    if (← load? (← group.pin)).isNone then return true
+  return false
+
+def refreshFor (source : Snapshot) : IO Unit := do
+  for group in ← groups source do
+    let _ ← prepare (← group.pin)
+
+def canonical (reader : PreparedOwners.Reader) (source node : Nat) : IO Nat := do
+  let some bytes ← reader.index.get (PreparedOwners.alias source node) |
+    throw (IO.userError "nominated original is absent from the prepared complete owner view")
+  IO.ofExcept (payloadSize (some bytes))
+
+def entry (reader : PreparedOwners.Reader) (id : Nat) : IO PreparedOwners.Entry := do
+  let entry ← PreparedOwners.readEntry reader.index reader.index.get id
+  if entry.originals.isEmpty then throw (IO.userError "prepared owner has no live original in this cut")
+  return entry
+
+def ordinal (reader : PreparedOwners.Reader) (id : Nat) : IO Nat := do
+  let entry ← entry reader id
+  let some original := entry.originals.head? | throw (IO.userError "prepared owner lost its original order")
+  return original.rank reader.manifest.stride
+
+end Eggshell.OwnerViews

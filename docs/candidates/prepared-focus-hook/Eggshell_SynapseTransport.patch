@@ -153,0 +154,18 @@
+def sourceViews (prepared : Array Recommend.Prepared) (owners : Array Owner) :
+    Array (Plugin.Publication.Client.SourceReference × Array String) :=
+  prepared.filterMap fun source => do
+    let reference ← source.canonical
+    let ids := owners.filterMap fun owner =>
+      if owner.database == source.source.head.identity then
+        some (Persistence.selectionKey owner.original.relation) else none
+    if ids.isEmpty then none else some (reference,ids)
+
+/-- The same admitted immutable batch supplies focus ranks and later original
+selection. Capture/charge metadata once, not once again after refocusing. -/
+def prepareBatch (prepared : Array Recommend.Prepared) (owners : Array Owner) (deadline : Nat)
+    (focus : Option (String × Array SourceViewBatch.FocusRow) := none) :
+    IO (Option Plugin.Publication.Client.SourceBatch) := do
+  let sources := sourceViews prepared owners
+  if sources.isEmpty then return none
+  return some (← Plugin.Publication.Client.sourcePalettes sources deadline focus)
+

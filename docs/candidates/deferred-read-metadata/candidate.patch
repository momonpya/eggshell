+module
+public import tools.research.PreparedPlanMetadata
+
+@[expose] public section
+namespace DeferredReadMetadata
+open Eggshell.Synapses
+
+private theorem list_mapM_present (rows : List α) (read : α → Option β) :
+    (rows.mapM read).isSome = rows.all (fun row => (read row).isSome) := by
+  induction rows with
+  | nil => rfl
+  | cons row rest ih =>
+    cases found : read row <;> cases tail : rest.mapM read <;>
+      simp [List.mapM_cons,found,tail,← ih]
+
+private theorem bind_pure_present (value : Option α) (f : α → β) :
+    (value.bind fun value => some (f value)).isSome = value.isSome := by
+  cases value <;> rfl
+
+theorem array_mapM_present (rows : Array α) (read : α → Option β) :
+    (rows.mapM read).isSome = rows.all (fun row => (read row).isSome) := by
+  rw [Array.mapM_eq_mapM_toList]
+  simp [list_mapM_present]
+
+/-- Check only addressability. This is exactly the failure condition of the
+existing expansion, but allocates no Read or per-row provenance arrays. -/
+def readable (descriptor : OwnerPalette.Descriptor) : Bool :=
+  descriptor.rows.all fun row =>
+    (descriptor.files[row.file]?).isSome &&
+    row.origins.all (fun origin => (descriptor.origin? origin).isSome)
+
+theorem readable_exact (descriptor : OwnerPalette.Descriptor) :
+    (PreparedPlanMetadata.reads descriptor).isSome = readable descriptor := by
+  let emit := fun (row : OwnerPalette.Row) => (do
+    let file ← descriptor.files[row.file]?
+    let origins ← row.origins.mapM descriptor.origin?
+    return origins.map fun origin =>
+      (⟨origin.occurrence,⟨.file file,row.line,row.line⟩,origin.binding,#[]⟩ : Read) : Option (Array Read))
+  change ((descriptor.rows.mapM emit).bind fun rows => some rows.flatten).isSome = _
+  rw [bind_pure_present,array_mapM_present]
+  unfold readable
+  apply congrArg (Array.all descriptor.rows)
+  funext row
+  cases file : descriptor.files[row.file]? <;>
+    cases origins : row.origins.mapM descriptor.origin? <;>
+      simp [emit,file,origins,← array_mapM_present]
+
+structure Checked where
+  descriptor : OwnerPalette.Descriptor
+  present : readable descriptor = true
+
+def prepare? (descriptor : OwnerPalette.Descriptor) : Option Checked :=
+  if accepted : readable descriptor = true then some ⟨descriptor,accepted⟩ else none
+
+theorem prepare_present (descriptor : OwnerPalette.Descriptor) :
+    (prepare? descriptor).isSome = (PreparedPlanMetadata.reads descriptor).isSome := by
+  rw [readable_exact]
+  by_cases accepted : readable descriptor = true <;> simp [prepare?,accepted]
+
+def Checked.expand (checked : Checked) : Array Read :=
+  (PreparedPlanMetadata.reads checked.descriptor).get (by
+    rw [readable_exact]
+    exact checked.present)
+
+theorem Checked.expand_exact (checked : Checked) :
+    PreparedPlanMetadata.reads checked.descriptor = some checked.expand := by
+  simp [expand]
+
+def expand (sources : Array Checked) : Array Read := sources.flatMap Checked.expand
+
+theorem expand_empty : expand #[] = #[] := rfl
+
+theorem expand_push (sources : Array Checked) (source : Checked) :
+    expand (sources.push source) = expand sources ++ source.expand := by
+  simp [expand]
+
+end DeferredReadMetadata

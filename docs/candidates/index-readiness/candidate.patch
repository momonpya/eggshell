+  let some metadata ← manifest? index | return .unavailable (.missingManifest index.head)
+  unless metadata.implementation == implementation do
+    return .unavailable (.implementationMismatch metadata.implementation)
+  unless metadata.scope == scope do return .unavailable (.scopeMismatch metadata.scope)

+/-- Absence, preparation debt and rejected metadata are different states.
+The observed metadata is diagnostic data, never authority for a Read. -/
+inductive Unavailability where
+  | privateDestination
+  | missingIndex
+  | missingManifest (head : PageMap.Head)
+  | implementationMismatch (producer : String)
+  | scopeMismatch (actual : Scope)
+  | provenanceMismatch
+  | sourceNotCovered (indexed : PageMap.Head)
+  deriving BEq, ToJson, FromJson
+
+inductive Opening where
+  | ready (reader : Reader)
+  | unavailable (reason : Unavailability)
+
+def Opening.reader? : Opening → Option Reader
+  | .ready reader => some reader
+  | .unavailable _ => none
+
+def Opening.reason? : Opening → Option Unavailability
+  | .ready _ => none
+  | .unavailable reason => some reason
+
+theorem Opening.available_iff_no_reason (opening : Opening) :
+    opening.reader?.isSome = !opening.reason?.isSome := by
+  cases opening <;> rfl
+
+/-- One validation pass returns either the usable pin or its rejection reason.

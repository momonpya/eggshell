+/-- A durable input/receipt binding is metadata of the Outcomes it publishes,
+even when those graph roots already exist. Report these exact owners rather
+than disguising an authoritative binding as a neutral memo-only commit. -/
+def bindMetadata (original extra : Persistence.Store.MetadataChange) (owners : List Nat) :
+    Persistence.Store.MetadataChange := {
+  changed := original.changed || extra.changed
+  affected := hashDistinct (original.affected ++ extra.affected ++ if extra.changed then owners else []) }
+
+theorem bound_affected_exact (original extra : Persistence.Store.MetadataChange)
+    (owners : List Nat) (owner : Nat) :
+    owner ∈ (bindMetadata original extra owners).affected ↔
+      owner ∈ original.affected ∨ owner ∈ extra.affected ∨
+        (extra.changed = true ∧ owner ∈ owners) := by
+  cases changed : extra.changed <;>
+    simp [bindMetadata,HashDistinct.mem,changed,List.mem_append]
+
+theorem bound_owner_has_delta (original extra : Persistence.Store.MetadataChange)
+    (owners : List Nat) (owner : Nat) (changed : extra.changed = true) (member : owner ∈ owners) :
+    (Persistence.Store.Change.mk [] [] false (bindMetadata original extra owners).affected).neutral = false := by
+  have present := (bound_affected_exact original extra owners owner).mpr (Or.inr (Or.inr ⟨changed,member⟩))
+  cases found : (bindMetadata original extra owners).affected with
+  | nil => simp [found] at present
+  | cons first rest => simp [Persistence.Store.Change.neutral]
+
+def promotedOwners (intern : Persistence.Store.Intern) (promotions : Array Promotion) : IO (List Nat) := do
+  let mut owners := []
+  for owner in hashDistinct (promotions.toList.flatMap (·.outcomeRelations)) do
+    let id ← intern.value owner
+    unless (← intern.writer.get (Persistence.Store.key "member" id)).isSome do
+      throw (IO.userError "publication metadata refers to an unpublished Outcome")
+    owners := id :: owners
+  return owners.reverse
+

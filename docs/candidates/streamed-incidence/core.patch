+/-- Append to persistent arrays repeatedly copies their shared prefixes.
+Collect immutable cons cells, then materialize each ordered array once. -/
+def reversedDirectory (keyOf : α → κ) (values : Array α) : Std.HashMap κ (List α) :=
+  values.foldl (fun found value => found.insert (keyOf value)
+    (value :: found[keyOf value]?.getD [])) {}
+
+theorem reversedDirectory_exact (keyOf : α → κ) (values : Array α) (key : κ) :
+    (reversedDirectory keyOf values)[key]?.getD [] =
+      (values.filterMap (fun value => if keyOf value == key then some value else none)).toList.reverse := by
+  have go : ∀ reversed : List α,
+      (reversedDirectory keyOf reversed.reverse.toArray)[key]?.getD [] =
+        (reversed.reverse.toArray.filterMap (fun value => if keyOf value == key then some value else none)).toList.reverse := by
+    intro reversed
+    induction reversed with
+    | nil => simp [reversedDirectory]
+    | cons value previous ih =>
+      have step : (value :: previous).reverse.toArray = previous.reverse.toArray.push value := by simp
+      rw [step]
+      simp only [reversedDirectory,Array.foldl_push,Std.HashMap.getElem?_insert]
+      by_cases same : keyOf value = key
+      · simpa [same,reversedDirectory,Array.filterMap_push] using congrArg (List.cons value) ih
+      · simpa [same,reversedDirectory,Array.filterMap_push] using ih
+  simpa using go values.toList.reverse
+
+def compactDirectory (keyOf : α → κ) (values : Array α) : Std.HashMap κ (Array α) :=
+  (reversedDirectory keyOf values).map (fun _ rows => rows.reverse.toArray)
+
+theorem compactDirectory_exact (keyOf : α → κ) (values : Array α) (key : κ) :
+    (compactDirectory keyOf values)[key]?.getD #[] = values.filterMap
+      (fun value => if keyOf value == key then some value else none) := by
+  have exact := reversedDirectory_exact keyOf values key
+  unfold compactDirectory
+  simp only [Std.HashMap.getElem?_map]
+  cases found : (reversedDirectory keyOf values)[key]? with
+  | none => simpa [found] using congrArg (fun rows => rows.reverse.toArray) exact
+  | some rows =>
+    simp only [found,Option.getD_some] at exact
+    simp only [Option.map_some,Option.getD_some]
+    rw [exact,List.reverse_reverse,Array.toArray_toList]
+
@@ -37 +77 @@

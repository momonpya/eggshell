+/-- Stream postings into one membership set. Do not build a large list of
+duplicate affected offers merely to throw the duplicates away afterwards. -/
+def Incidence.changedStreaming {features : Fin n → List (Fin d)} (layout : Incidence features)
+    (seen : Std.HashMap (Fin d) Unit) (added : List (Fin d)) : List (Fin n) :=
+  let input := added.filter fun feature => !seen.contains feature
+  let result := input.foldl (fun state feature => (layout.lookup feature).foldl HashDistinct.step state) ({},[])
+  result.2.reverse

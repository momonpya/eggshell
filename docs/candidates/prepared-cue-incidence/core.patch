+def bonusPieceAccept (keys : Array String) (units : Array UnitPlan)
+    (plan : BundlePlan keys units) (entry : CuePiece × Nat) : Bool :=
+  entry.1.baseWeight < entry.1.weight &&
+    plan.indices.any fun index =>
+      let unit := units[index]
+      unit.family == entry.1.family && unit.coversPrepared entry.1.first entry.1.last &&
+        plan.projected.members.any fun member => member.choices.any fun bound =>
+          keys[unit.family]? == some bound.owner && covers bound.spans entry.1.first entry.1.last
+
+def bonusPiecesPrepared (keys : Array String) (units : Array UnitPlan)

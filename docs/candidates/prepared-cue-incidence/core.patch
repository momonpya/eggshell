+module
+public import tools.OwnerUnitPostings
+public import Init.Data.Array.OfFn
+@[expose] public section
+
+namespace Eggshell.PreparedCueIndex
+
+/-- An ordered posting index into one shared array. Every returned value is
+an original input; duplicates and input order survive narrowing. -/
+structure Prepared (keyOf : α → String) (values : Array α) where
+  index : OwnerUnitPostings.Index (fun i : Fin values.size => some (keyOf values[i.val]))
+
+def prepare (keyOf : α → String) (values : Array α) : Prepared keyOf values :=
+  ⟨OwnerUnitPostings.prepare (fun i => some (keyOf values[i.val]))⟩
+
+variable {α : Type} {keyOf : α → String} {values : Array α}
+
+private theorem filtered_values (values : Array α) (accept : α → Bool) :
+    ((List.finRange values.size).filter (fun i => accept values[i.val])).map (fun i => values[i.val]) =
+      values.toList.filter accept := by
+  change ((List.finRange values.size).filter (accept ∘ (fun i => values[i.val]))).map
+    (fun i => values[i.val]) = _
+  rw [← List.filter_map]
+  have rows : (List.finRange values.size).map (fun i => values[i.val]) = values.toList := by
+    simp only [List.finRange,List.map_ofFn,Function.comp_def]
+    rw [← Array.toList_ofFn,Array.ofFn_getElem]
+  rw [rows]
+
+def Prepared.one (prepared : Prepared keyOf values) (key : String) (accept : α → Bool) : List α :=
+  ((prepared.index.postings[key]?.getD []).filter (fun i => accept values[i.val])).map (fun i => values[i.val])
+
+theorem Prepared.one_exact (prepared : Prepared keyOf values) (key : String) (accept : α → Bool)
+    (necessary : ∀ value, accept value = true → keyOf value = key) :
+    prepared.one key accept = values.toList.filter accept := by
+  unfold Prepared.one
+  rw [prepared.index.exact,List.filter_filter]
+  have same : (fun i : Fin values.size => accept values[i.val] &&
+      (some (keyOf values[i.val]) == some key)) = (fun i => accept values[i.val]) := by
+    funext i
+    apply Bool.eq_iff_iff.mpr
+    simp only [Bool.and_eq_true,beq_iff_eq,Option.some.injEq]
+    exact ⟨And.left,fun accepted => ⟨accepted,necessary _ accepted⟩⟩
+  rw [same]
+  exact filtered_values values accept
+
+def Prepared.many (prepared : Prepared keyOf values) (keys : List String) (accept : α → Bool) : List α :=
+  (prepared.index.select keys.eraseDups (fun i => accept values[i.val])).map (fun i => values[i.val])
+
+theorem Prepared.many_exact (prepared : Prepared keyOf values) (keys : List String) (accept : α → Bool)
+    (necessary : ∀ value, accept value = true → keyOf value ∈ keys) :
+    prepared.many keys accept = values.toList.filter accept := by
+  unfold Prepared.many
+  rw [prepared.index.select_exact keys.eraseDups (fun i => accept values[i.val]) (by
+    intro i accepted
+    exact ⟨keyOf values[i.val],List.mem_eraseDups.mpr (necessary values[i.val] accepted),rfl⟩)]
+  exact filtered_values values accept
+
+end Eggshell.PreparedCueIndex

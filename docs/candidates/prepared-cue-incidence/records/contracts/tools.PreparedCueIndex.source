["module\npublic import tools.OwnerUnitPostings\npublic import Init.Data.Array.OfFn\n@[expose] public section\n\nnamespace Eggshell.PreparedCueIndex\n\n/-- An ordered posting index into one shared array. Every returned value is\nan original input; duplicates and input order survive narrowing. -/\nstructure Prepared (keyOf : α → String) (values : Array α) where\n  index : OwnerUnitPostings.Index (fun i : Fin values.size => some (keyOf values[i.val]))\n\ndef prepare (keyOf : α → String) (values : Array α) : Prepared keyOf values :=\n  ⟨OwnerUnitPostings.prepare (fun i => some (keyOf values[i.val]))⟩\n\nvariable {α : Type} {keyOf : α → String} {values : Array α}\n\nprivate theorem filtered_values (values : Array α) (accept : α → Bool) :\n    ((List.finRange values.size).filter (fun i => accept values[i.val])).map (fun i => values[i.val]) =\n      values.toList.filter accept := by\n  change ((List.finRange values.size).filter (accept ∘ (fun i => values[i.val]))).map\n    (fun i => values[i.val]) = _\n  rw [← List.filter_map]\n  have rows : (List.finRange values.size).map (fun i => values[i.val]) = values.toList := by\n    simp only [List.finRange,List.map_ofFn,Function.comp_def]\n    rw [← Array.toList_ofFn,Array.ofFn_getElem]\n  rw [rows]\n\ndef Prepared.one (prepared : Prepared keyOf values) (key : String) (accept : α → Bool) : List α :=\n  ((prepared.index.postings[key]?.getD []).filter (fun i => accept values[i.val])).map (fun i => values[i.val])\n\ntheorem Prepared.one_exact (prepared : Prepared keyOf values) (key : String) (accept : α → Bool)\n    (necessary : ∀ value, accept value = true → keyOf value = key) :\n    prepared.one key accept = values.toList.filter accept := by\n  unfold Prepared.one\n  rw [prepared.index.exact,List.filter_filter]\n  have same : (fun i : Fin values.size => accept values[i.val] &&\n      (some (keyOf values[i.val]) == some key)) = (fun i => accept values[i.val]) := by\n    funext i\n    apply Bool.eq_iff_iff.mpr\n    simp only [Bool.and_eq_true,beq_iff_eq,Option.some.injEq]\n    exact ⟨And.left,fun accepted => ⟨accepted,necessary _ accepted⟩⟩\n  rw [same]\n  exact filtered_values values accept\n\ndef Prepared.many (prepared : Prepared keyOf values) (keys : List String) (accept : α → Bool) : List α :=\n  (prepared.index.select keys (fun i => accept values[i.val])).map (fun i => values[i.val])\n\ntheorem Prepared.many_exact (prepared : Prepared keyOf values) (keys : List String) (accept : α → Bool)\n    (necessary : ∀ value, accept value = true → keyOf value ∈ keys) :\n    prepared.many keys accept = values.toList.filter accept := by\n  unfold Prepared.many\n  rw [prepared.index.select_exact keys (fun i => accept values[i.val]) (by\n    intro i accepted\n    exact ⟨keyOf values[i.val],necessary values[i.val] accepted,rfl⟩)]\n  exact filtered_values values accept\n\nend Eggshell.PreparedCueIndex\n",[]]
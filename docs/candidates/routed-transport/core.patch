+def DeliveryInterval.connected (left right : DeliveryInterval) : Prop :=
+  left.start ≤ right.stop ∧ right.start ≤ left.stop
+
+instance (left right : DeliveryInterval) : Decidable (left.connected right) :=
+  inferInstanceAs (Decidable (_ ∧ _))
+
+def DeliveryInterval.join (left right : DeliveryInterval)
+    (_ : left.connected right) : DeliveryInterval :=

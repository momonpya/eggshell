+    by have := left.ordered; have := right.ordered; omega⟩
+
+theorem DeliveryInterval.join_covers (left right : DeliveryInterval)
+    (connected : left.connected right) (position : Nat) :
+    (left.join right connected).covers position ↔ left.covers position ∨ right.covers position := by
+  simp only [join,covers]
+  unfold DeliveryInterval.connected at connected
+  omega
+
+def DeliveryInterval.coalesceFrom (current : DeliveryInterval) : List DeliveryInterval → List DeliveryInterval
+  | [] => [current]

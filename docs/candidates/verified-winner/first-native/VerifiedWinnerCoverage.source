["module\npublic import tools.WinnerSearch\npublic import tools.WinnerUpdates\n@[expose] public section\n\nnamespace SharedCoverage.Deferred.VerifiedWinner\nvariable {p : Problem}\n\ndef depth (p : Problem) : Nat := p.offers.size.log2+1\n\ndef fill (layout : Sparse.Layout p) (fuel : Nat) (prior : Selection p) (stored : Sparse.Values prior)\n    (state : State prior stored (depth p)) : Selection p :=\n  match fuel with\n  | 0 => prior\n  | fuel+1 =>\n      let resolved := state.resolve\n      match resolved.score with\n      | none => prior\n      | some score =>\n          let next := score.proposal.result\n          fill layout fuel next (stored.advance layout next score.index rfl)\n            (resolved.state.advance layout next score.index rfl)\n\ntheorem fill_exact (layout : Sparse.Layout p) (fuel : Nat) (prior : Selection p)\n    (stored : Sparse.Values prior) (state : State prior stored (depth p)) :\n    fill layout fuel prior stored state = SharedCoverage.fill fuel prior := by\n  induction fuel generalizing prior with\n  | zero => rfl\n  | succ fuel ih =>\n      rw [SharedCoverage.fill,← Sparse.best_exact stored,← state.resolve.exact]\n      cases found : state.resolve.score with\n      | none => simp only [fill,found,Option.map_none]\n      | some score =>\n          simpa only [fill,found,Option.map_some] using\n            (ih score.proposal.result (stored.advance layout _ score.index rfl)\n              (state.resolve.state.advance layout _ score.index rfl))\n\n/-- The cached implementation retains exactly the full scan's ordered result.\nThe state certificates and termination measure disappear during compilation. -/\ndef choose? (p : Problem) : Option (Selection p) := do\n  let initial ← empty? p\n  let layout := Sparse.layout p\n  let stored := Sparse.values initial\n  let state := State.initial initial stored (depth p) (Nat.le_of_lt Nat.lt_log2_self)\n  pure (SharedCoverage.prefer (fill layout p.offers.size initial stored state) (SharedCoverage.bestSingleton initial))\n\n@[csimp] theorem choose_exact : @SharedCoverage.choose? = @choose? := by\n  rw [Sparse.choose_exact]\n  funext p\n  simp only [choose?,Sparse.choose?,fill_exact,Sparse.fill_exact]\n\nend SharedCoverage.Deferred.VerifiedWinner\n\n",[]]
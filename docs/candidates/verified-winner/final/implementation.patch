+module
+public import tools.WinnerRatings
+@[expose] public section
+
+namespace SharedCoverage.Deferred.VerifiedWinner
+variable {p : Problem} {prior : Selection p}
+
+def marginalKey (stored : Sparse.Values prior) (index : Fin p.offers.size) : Rating.Key p.offers.size :=
+  ⟨index,stored.gains[index],max (stored.costs[index].1*p.limit.2) (stored.costs[index].2*p.limit.1)⟩
+
+theorem rating_fin_iff (stored : Sparse.Values prior) (seen : Known prior)
+    (index : Fin p.offers.size) (value : Rating.Key p.offers.size) :
+    (Sparse.score? prior stored seen index).map key = some value ↔
+      index ∉ prior.selected ∧
+      ((stored.afterCost index).1 ≤ p.limit.1 ∧ (stored.afterCost index).2 ≤ p.limit.2) ∧
+      0 < stored.gains[index] ∧ marginalKey stored index = value := by
+  unfold Sparse.score?
+  dsimp only
+  split
+  · rename_i fresh
+    split
+    · rename_i fits
+      split
+      · rename_i positive
+        have positiveNat : 0 < stored.gains[index.val] := positive
+        have fitsNat : stored.base.beforeCost.1+stored.costs[index.val].1 ≤ p.limit.1 ∧
+            stored.base.beforeCost.2+stored.costs[index.val].2 ≤ p.limit.2 := fits
+        simp only [Option.map_some,Option.some.injEq]
+        simp [fresh,fitsNat,positiveNat,key,marginalKey,Sparse.Values.afterCost]
+      · rename_i positive
+        have notPositiveNat : ¬0 < stored.gains[index.val] := positive
+        simp [fresh,fits,notPositiveNat]
+    · rename_i fits
+      simp [fresh,fits]
+  · rename_i fresh
+    simp [fresh]
+
+theorem rating_at_index (stored : Sparse.Values prior) (seen : Known prior)
+    (index : Nat) (value : Rating.Key p.offers.size)
+    (found : ratingAt prior stored seen index = some value) : value.index.val = index := by
+  unfold ratingAt at found
+  split at found
+  · have data := (rating_fin_iff stored seen _ value).mp found
+    exact (congrArg (fun entry : Rating.Key p.offers.size => entry.index.val) data.2.2.2).symm
+  · contradiction
+
+theorem unchanged_valid_rating (stored : Sparse.Values prior) (next : Selection p)
+    (updated : Sparse.Values next) (winner index : Fin p.offers.size)
+    (extension : next.selected = prior.selected++[winner])
+    (sameCost : updated.costs[index] = stored.costs[index])
+    (sameGain : updated.gains[index] = stored.gains[index])
+    (value : Rating.Key p.offers.size)
+    (found : ratingAt next updated (known next) index.val = some value) :
+    ratingAt prior stored (known prior) index.val = some value := by
+  have current : (Sparse.score? next updated (known next) index).map key = some value := by
+    simpa only [ratingAt,dif_pos index.isLt] using found
+  have valid := (rating_fin_iff updated (known next) index value).mp current
+  have fresh : index ∉ prior.selected := by
+    intro member
+    apply valid.1
+    rw [extension]
+    exact List.mem_append_left _ member
+  have afterFits : (cost p (next.selected++[index])).1 ≤ p.limit.1 ∧
+      (cost p (next.selected++[index])).2 ≤ p.limit.2 := by
+    simpa only [updated.afterCost_exact,Evaluation.afterCost_exact] using valid.2.1
+  have beforeFits : (stored.afterCost index).1 ≤ p.limit.1 ∧
+      (stored.afterCost index).2 ≤ p.limit.2 := by
+    simp only [stored.afterCost_exact,Evaluation.afterCost_exact]
+    by_cases before : (cost p (prior.selected++[index])).1 ≤ p.limit.1 ∧
+        (cost p (prior.selected++[index])).2 ≤ p.limit.2
+    · exact before
+    · exact False.elim (Budget.no_reactivation p prior.selected index winner before
+        (by simpa only [extension] using afterFits))
+  have original : (Sparse.score? prior stored (known prior) index).map key = some value := by
+    apply (rating_fin_iff stored (known prior) index value).mpr
+    refine ⟨fresh,beforeFits,?_,?_⟩
+    · simpa only [sameGain] using valid.2.2.1
+    · simpa only [marginalKey,sameCost,sameGain] using valid.2.2.2
+  simpa only [ratingAt,dif_pos index.isLt] using original
+
+def affected (layout : Sparse.Layout p) (stored : Sparse.Values prior) (winner : Fin p.offers.size) :
+    List (Fin p.offers.size) :=
+  Eggshell.hashDistinct (winner ::
+    layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure ++
+      layout.cues.changed stored.base.cueIndex p.offers[winner].covers)
+
+theorem unaffected_values (layout : Sparse.Layout p) (stored : Sparse.Values prior)
+    (next : Selection p) (winner index : Fin p.offers.size)
+    (extension : next.selected = prior.selected++[winner])
+    (absent : index ∉ affected layout stored winner) :
+    (stored.advance layout next winner extension).costs[index] = stored.costs[index] ∧
+    (stored.advance layout next winner extension).gains[index] = stored.gains[index] := by
+  have original : index ∉ winner ::
+      layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure ++
+        layout.cues.changed stored.base.cueIndex p.offers[winner].covers := by
+    intro member
+    exact absent ((Eggshell.HashDistinct.mem _ _).mpr member)
+  have parts :
+      index ∉ layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure ∧
+      index ∉ layout.cues.changed stored.base.cueIndex p.offers[winner].covers := by
+    have resolved : (index ≠ winner ∧
+        index ∉ layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure) ∧
+        index ∉ layout.cues.changed stored.base.cueIndex p.offers[winner].covers := by
+      simpa only [List.mem_cons,List.mem_append,not_or] using original
+    exact ⟨resolved.1.2,resolved.2⟩
+  change (Sparse.patch stored.costs _ _)[index] = stored.costs[index] ∧
+    (Sparse.patch stored.gains _ _)[index] = stored.gains[index]
+  constructor
+  · rw [Sparse.patch_exact,if_neg parts.1]
+  · rw [Sparse.patch_exact,if_neg parts.2]
+
+end SharedCoverage.Deferred.VerifiedWinner

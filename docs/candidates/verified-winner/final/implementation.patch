+module
+public import tools.WinnerSearch
+public import tools.WinnerUpdates
+@[expose] public section
+
+namespace SharedCoverage.Deferred.VerifiedWinner
+variable {p : Problem}
+
+def depth (p : Problem) : Nat := p.offers.size.log2+1
+
+def fill (layout : Sparse.Layout p) (fuel : Nat) (prior : Selection p) (stored : Sparse.Values prior)
+    (state : State prior stored (depth p)) : Selection p :=
+  match fuel with
+  | 0 => prior
+  | fuel+1 =>
+      let resolved := state.resolve
+      match resolved.score with
+      | none => prior
+      | some score =>
+          let next := score.proposal.result
+          let updated := stored.advance layout next score.index rfl
+          fill layout fuel next updated
+            (resolved.state.advance layout next score.index rfl updated rfl)
+
+theorem fill_exact (layout : Sparse.Layout p) (fuel : Nat) (prior : Selection p)
+    (stored : Sparse.Values prior) (state : State prior stored (depth p)) :
+    fill layout fuel prior stored state = SharedCoverage.fill fuel prior := by
+  induction fuel generalizing prior with
+  | zero => rfl
+  | succ fuel ih =>
+      rw [SharedCoverage.fill,← Sparse.best_exact stored,← state.resolve.exact]
+      cases found : state.resolve.score with
+      | none => simp only [fill,found,Option.map_none]
+      | some score =>
+          simpa only [fill,found,Option.map_some] using
+            (ih score.proposal.result (stored.advance layout _ score.index rfl)
+              (state.resolve.state.advance layout _ score.index rfl
+                (stored.advance layout _ score.index rfl) rfl))
+
+/-- The cached implementation retains exactly the full scan's ordered result.
+The state certificates and termination measure disappear during compilation. -/
+def choose? (p : Problem) : Option (Selection p) := do
+  let initial ← empty? p
+  let layout := Sparse.layout p
+  let stored := Sparse.values initial
+  let state := State.initial initial stored (depth p) (Nat.le_of_lt Nat.lt_log2_self)
+  pure (SharedCoverage.prefer (fill layout p.offers.size initial stored state) (SharedCoverage.bestSingleton initial))
+
+@[csimp] theorem choose_exact : @SharedCoverage.choose? = @choose? := by
+  rw [Sparse.choose_exact]
+  funext p
+  simp only [choose?,Sparse.choose?,fill_exact,Sparse.fill_exact]
+
+end SharedCoverage.Deferred.VerifiedWinner
+

+module
+public import tools.WinnerCache
+@[expose] public section
+
+namespace SharedCoverage.Deferred.VerifiedWinner
+variable {p : Problem} {prior : Selection p} {stored : Sparse.Values prior} {depth : Nat}
+
+/-- The returned candidate is the complete scan's exact result. The retained
+state may have removed newly infeasible leaves, without losing any live one. -/
+structure Resolution (prior : Selection p) (stored : Sparse.Values prior) (depth : Nat) where
+  score : Option (Score prior (evaluation prior))
+  state : State prior stored depth
+  exact : score = Sparse.best prior stored
+
+/-- Invalid roots are removed one at a time. The count in the termination
+proof is erased; no runtime list of every leaf is built to drive recursion. -/
+private theorem same_seen (left right : Known prior) (index : Fin p.offers.size) :
+    Sparse.score? prior stored left index = Sparse.score? prior stored right index := by
+  rw [Sparse.score_exact,Sparse.score_exact]
+  simp only [Deferred.score?]
+
+def State.resolveWith (state : State prior stored depth) (seen : Known prior) : Resolution prior stored depth :=
+  match found : state.cache.best with
+  | none => ⟨none,state,(state.empty_exact found).symm⟩
+  | some value =>
+    match current : Sparse.score? prior stored seen value.index with
+    | some score => ⟨some score,state,(state.best_exact value found score
+        (by rw [← same_seen seen (known prior) value.index]; exact current)).symm⟩
+    | none =>
+      have absent : ratingAt prior stored (known prior) value.index.val = none := by
+        simp only [ratingAt,dif_pos value.index.isLt,← same_seen seen (known prior) value.index,current,Option.map_none]
+      (state.clear value absent).resolveWith seen
+termination_by state.cache.tree.values.countP Option.isSome
+decreasing_by exact state.clear_decreases value found absent
+
+/-- Construct selected membership once, including when several now-infeasible
+roots must be removed during the same choice. -/
+def State.resolve (state : State prior stored depth) : Resolution prior stored depth :=
+  state.resolveWith (known prior)
+
+end SharedCoverage.Deferred.VerifiedWinner

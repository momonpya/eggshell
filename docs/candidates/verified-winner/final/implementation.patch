+module
+public import tools.WinnerCache
+@[expose] public section
+
+namespace SharedCoverage.Deferred.VerifiedWinner
+open StableWinnerIndex
+variable {p : Problem} {prior : Selection p} {stored : Sparse.Values prior} {depth : Nat}
+
+def updateMany (_capacity : p.offers.size ≤ 2^depth)
+    (cache : Cache (Rating.preference p.offers.size) depth) (indices : List (Fin p.offers.size))
+    (replacement : Nat → Option (Rating.Key p.offers.size)) : Cache (Rating.preference p.offers.size) depth :=
+  indices.foldl (fun cache index => cache.tree.updated index.val (replacement index.val)) cache
+
+theorem updateMany_lookup (capacity : p.offers.size ≤ 2^depth)
+    (cache : Cache (Rating.preference p.offers.size) depth) (indices : List (Fin p.offers.size))
+    (replacement : Nat → Option (Rating.Key p.offers.size)) (query : Nat) :
+    (updateMany capacity cache indices replacement).tree.values[query]? =
+      if ∃ index ∈ indices, index.val = query then some (replacement query) else cache.tree.values[query]? := by
+  induction indices generalizing cache with
+  | nil => simp [updateMany]
+  | cons head tail ih =>
+      simp only [updateMany,List.foldl_cons] at *
+      rw [ih]
+      by_cases later : ∃ index ∈ tail, index.val = query
+      · simp [later]
+      · rw [if_neg later,Tree.updated_values _ _ _ (Nat.lt_of_lt_of_le head.isLt capacity)]
+        by_cases same : head.val = query
+        · subst query
+          have bound : head.val < cache.tree.values.length := by
+            simpa only [Tree.values_length] using Nat.lt_of_lt_of_le head.isLt capacity
+          simp [List.getElem?_set_self bound]
+        · simp [List.getElem?_set_ne same,later,same]
+
+def State.advance (state : State prior stored depth) (layout : Sparse.Layout p)
+    (next : Selection p) (winner : Fin p.offers.size) (extension : next.selected = prior.selected++[winner])
+    (updated : Sparse.Values next) (same : updated = stored.advance layout next winner extension) :
+    State next updated depth :=
+  let changed := affected layout stored winner
+  let seen := known next
+  let replacement := ratingAt next updated seen
+  let cache := updateMany state.capacity state.cache changed replacement
+  {capacity := state.capacity
+   cache
+   identity := by
+    intro position value found
+    rw [updateMany_lookup] at found
+    split at found
+    · have current := Option.some.inj found
+      exact rating_at_index updated (known next) position value current
+    · exact state.identity position value found
+   complete := by
+    intro position value current
+    rw [updateMany_lookup]
+    by_cases present : ∃ index ∈ changed, index.val = position
+    · rw [if_pos present]
+      exact congrArg some current
+    · rw [if_neg present]
+      have bound : position < p.offers.size := by
+        have identity := rating_at_index updated (known next) position value current
+        simpa only [← identity] using value.index.isLt
+      let query : Fin p.offers.size := ⟨position,bound⟩
+      have absent : query ∉ changed := by
+        intro member
+        exact present ⟨query,member,rfl⟩
+      have values : updated.costs[query] = stored.costs[query] ∧ updated.gains[query] = stored.gains[query] := by
+        rw [same]
+        exact unaffected_values layout stored next winner query extension absent
+      have original := unchanged_valid_rating stored next updated winner query extension values.1 values.2 value current
+      exact state.complete position value original}
+
+def State.initial (prior : Selection p) (stored : Sparse.Values prior) (depth : Nat)
+    (capacity : p.offers.size ≤ 2^depth) : State prior stored depth :=
+  let keys := ((List.range p.offers.size).map (ratingAt prior stored (known prior))).toArray
+  let cache := StableWinnerIndex.build (Rating.preference p.offers.size) depth keys
+  {capacity,cache
+   identity := by
+    intro position value found
+    by_cases inside : position < 2^depth
+    · by_cases real : position < p.offers.size
+      · have current : ratingAt prior stored (known prior) position = some value := by
+          simpa [cache,keys,build_values,List.getElem?_map,List.getElem?_range,inside,real] using found
+        exact rating_at_index stored (known prior) position value current
+      · simp [cache,keys,build_values,List.getElem?_map,inside,real] at found
+    · simp [cache,keys,build_values,List.getElem?_map,inside] at found
+   complete := by
+    intro position value current
+    have real : position < p.offers.size := by
+      have identity := rating_at_index stored (known prior) position value current
+      simpa only [← identity] using value.index.isLt
+    have inside := Nat.lt_of_lt_of_le real capacity
+    simp [cache,keys,build_values,List.getElem?_map,inside,real,current]}
+
+end SharedCoverage.Deferred.VerifiedWinner

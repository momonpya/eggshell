+module
+public import tools.SelectionRating
+@[expose] public section
+
+namespace StableWinnerIndex
+variable {α : Type} {order : Preference α}
+
+theorem winner_cons (head : Option α) (tail : List (Option α)) :
+    winner order (head::tail) = merge order head (winner order tail) := by
+  rw [winner,List.foldl_cons,fold_from]
+  rfl
+
+theorem merge_none_iff (left right : Option α) :
+    merge order left right = none ↔ left = none ∧ right = none := by
+  cases left <;> cases right <;> simp [merge]
+  split <;> simp
+
+theorem winner_none_iff (values : List (Option α)) :
+    winner order values = none ↔ ∀ value ∈ values, value = none := by
+  induction values with
+  | nil => simp [winner]
+  | cons head tail ih =>
+      rw [winner_cons,merge_none_iff,ih]
+      simp
+
+theorem asymmetric (irrefl : ∀ a, order.better a a = false) (a b : α)
+    (ab : order.better a b = true) : order.better b a ≠ true := by
+  intro ba
+  have impossible := order.trans a b a ab ba
+  rw [irrefl] at impossible
+  contradiction
+
+theorem merge_left_bound (irrefl : ∀ a, order.better a a = false)
+    (a result : α) (right : Option α) (found : merge order (some a) right = some result) :
+    order.better a result ≠ true := by
+  cases right with
+  | none => simp only [merge,Option.some.injEq] at found; subst result; simp [irrefl]
+  | some b =>
+      by_cases ba : order.better b a = true
+      · simp [merge,ba] at found
+        subst result
+        exact asymmetric irrefl b a ba
+      · simp [merge,ba] at found
+        subst result
+        simp [irrefl]
+
+theorem merge_right_bound (irrefl : ∀ a, order.better a a = false)
+    (b result : α) (left : Option α) (found : merge order left (some b) = some result) :
+    order.better b result ≠ true := by
+  cases left with
+  | none => simp only [merge,Option.some.injEq] at found; subst result; simp [irrefl]
+  | some a =>
+      by_cases ba : order.better b a = true
+      · simp [merge,ba] at found
+        subst result
+        simp [irrefl]
+      · simp [merge,ba] at found
+        subst result
+        exact ba
+
+theorem winner_bound (irrefl : ∀ a, order.better a a = false)
+    (values : List (Option α)) (result : α) (found : winner order values = some result)
+    (value : α) (present : some value ∈ values) : order.better value result ≠ true := by
+  induction values generalizing result with
+  | nil => simp at present
+  | cons head tail ih =>
+      rw [winner_cons] at found
+      rcases List.mem_cons.mp present with same | rest
+      · subst head
+        exact merge_left_bound irrefl value result _ found
+      · cases final : winner order tail with
+        | none =>
+            have absent := (winner_none_iff tail).mp final (some value) rest
+            contradiction
+        | some best =>
+            have below := ih best final rest
+            have after := merge_right_bound irrefl best result head (by simpa only [final] using found)
+            exact order.negTrans value best result below after
+
+def mask (accept : α → Bool) : Option α → Option α
+  | none => none
+  | some value => if accept value then some value else none
+
+theorem mask_some (accept : α → Bool) (entry : Option α) (value : α)
+    (found : mask accept entry = some value) : entry = some value ∧ accept value = true := by
+  cases entry with
+  | none => simp [mask] at found
+  | some original =>
+      cases accepted : accept original with
+      | false => simp [mask,accepted] at found
+      | true =>
+          have same : original = value := by simpa [mask,accepted] using found
+          subst original
+          exact ⟨rfl,accepted⟩
+
+theorem winner_mask_none (accept : α → Bool) (values : List (Option α))
+    (empty : winner order values = none) : winner order (values.map (mask accept)) = none := by
+  apply (winner_none_iff _).mpr
+  intro entry present
+  obtain ⟨original,member,rfl⟩ := List.mem_map.mp present
+  have absent := (winner_none_iff _).mp empty original member
+  simp [absent,mask]
+
+theorem winner_mask_preserved (irrefl : ∀ a, order.better a a = false)
+    (accept : α → Bool) (values : List (Option α)) (result : α)
+    (found : winner order values = some result) (kept : accept result = true) :
+    winner order (values.map (mask accept)) = some result := by
+  induction values with
+  | nil => simp [winner] at found
+  | cons head tail ih =>
+      rw [winner_cons] at found
+      simp only [List.map_cons,winner_cons]
+      cases head with
+      | none =>
+          simp only [merge] at found
+          simpa only [mask,merge] using ih found
+      | some a =>
+          cases last : winner order tail with
+          | none =>
+              simp only [last,merge,Option.some.injEq] at found
+              subst result
+              rw [winner_mask_none accept tail last]
+              simp [mask,kept,merge]
+          | some b =>
+              by_cases ba : order.better b a = true
+              · simp only [last,merge,ba,↓reduceIte,Option.some.injEq] at found
+                subst result
+                rw [ih last]
+                cases accepted : accept a <;> simp [mask,merge,accepted,ba]
+              · simp [last,merge,ba] at found
+                subst result
+                cases filtered : winner order (tail.map (mask accept)) with
+                | none => simp [mask,kept,merge]
+                | some c =>
+                    obtain ⟨entry,present,matched⟩ := List.mem_map.mp (winner_mem order _ c filtered)
+                    have original := (mask_some accept entry c matched).1
+                    rw [original] at present
+                    have lower := winner_bound irrefl tail b last c present
+                    have below := order.negTrans c b a lower ba
+                    simp [mask,kept,merge,below]
+
+end StableWinnerIndex
+
+namespace SharedCoverage.Rating
+theorem better_irrefl (value : Key n) : better value value = false := by
+  by_cases zero : value.charge = 0 <;> simp [better,zero]
+end SharedCoverage.Rating

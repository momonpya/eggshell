+module
+public import tools.WinnerEntries
+@[expose] public section
+
+namespace SharedCoverage.Deferred.VerifiedWinner
+open StableWinnerIndex
+variable {p : Problem} {prior : Selection p} {stored : Sparse.Values prior} {depth : Nat}
+
+/-- Stale, now-infeasible leaves are permitted. Every currently eligible
+candidate must be present with its current key at its original position. -/
+structure State (prior : Selection p) (stored : Sparse.Values prior) (depth : Nat) where
+  capacity : p.offers.size ≤ 2^depth
+  cache : Cache (Rating.preference p.offers.size) depth
+  identity : ∀ (position : Nat) (value : Rating.Key p.offers.size),
+    cache.tree.values[position]? = some (some value) → value.index.val = position
+  complete : ∀ (position : Nat) (value : Rating.Key p.offers.size), ratingAt prior stored (known prior) position = some value →
+    cache.tree.values[position]? = some (some value)
+
+def State.live (_state : State prior stored depth) (value : Rating.Key p.offers.size) : Bool :=
+  (ratingAt prior stored (known prior) value.index.val).isSome
+
+theorem State.masked_values (state : State prior stored depth) :
+    state.cache.tree.values.map (mask state.live) =
+      (List.range (2^depth)).map (ratingAt prior stored (known prior)) := by
+  apply List.ext_getElem?
+  intro position
+  by_cases bound : position < 2^depth
+  · have inside : position < state.cache.tree.values.length := by simpa only [Tree.values_length] using bound
+    let entry := state.cache.tree.values[position]'inside
+    have located : state.cache.tree.values[position]? = some entry := List.getElem?_eq_getElem inside
+    have pointwise : mask state.live entry = ratingAt prior stored (known prior) position := by
+      cases original : entry with
+      | none =>
+          cases current : ratingAt prior stored (known prior) position with
+          | none => rfl
+          | some value =>
+              have covered := state.complete position value current
+              rw [located,original] at covered
+              simp at covered
+      | some value =>
+          have identity := state.identity position value (by simpa only [original] using located)
+          cases current : ratingAt prior stored (known prior) position with
+          | none => simp [mask,State.live,identity,current]
+          | some wanted =>
+              have covered := state.complete position wanted current
+              rw [located,original] at covered
+              have same := Option.some.inj (Option.some.inj covered)
+              subst wanted
+              simp [mask,State.live,identity,current]
+    simp only [List.getElem?_map,located,Option.map_some,List.getElem?_range,bound]
+    exact congrArg some pointwise
+  · have outside : state.cache.tree.values.length ≤ position := by simpa only [Tree.values_length] using Nat.le_of_not_gt bound
+    simp [List.getElem?_map,List.getElem?_eq_none outside,bound]
+
+theorem State.best_lookup (state : State prior stored depth) (value : Rating.Key p.offers.size)
+    (found : state.cache.best = some value) : state.cache.tree.values[value.index.val]? = some (some value) := by
+  have member := winner_mem (Rating.preference p.offers.size) state.cache.tree.values value
+    (state.cache.tree.best_exact.trans found)
+  obtain ⟨position,located⟩ := List.mem_iff_getElem?.mp member
+  have identity := state.identity position value located
+  simpa only [identity] using located
+
+theorem key_injective (a b : Score prior (evaluation prior)) (same : key a = key b) : a = b := by
+  cases a
+  cases b
+  simp only [key,Rating.Key.mk.injEq] at same
+  rcases same with ⟨rfl,rfl,rfl⟩
+  rfl
+
+theorem State.current_key (state : State prior stored depth) (value : Rating.Key p.offers.size)
+    (found : state.cache.best = some value) (score : Score prior (evaluation prior))
+    (current : Sparse.score? prior stored (known prior) value.index = some score) : key score = value := by
+  have rated : ratingAt prior stored (known prior) value.index.val = some (key score) := by
+    simp only [ratingAt,dif_pos value.index.isLt,current,Option.map_some]
+  have covered := state.complete value.index.val (key score) rated
+  have located := state.best_lookup value found
+  exact Option.some.inj (Option.some.inj (covered.symm.trans located))
+
+theorem State.best_exact (state : State prior stored depth) (value : Rating.Key p.offers.size)
+    (found : state.cache.best = some value) (score : Score prior (evaluation prior))
+    (current : Sparse.score? prior stored (known prior) value.index = some score) :
+    Sparse.best prior stored = some score := by
+  have agreement := state.current_key value found score current
+  have kept : state.live value = true := by
+    simp only [State.live,ratingAt,dif_pos value.index.isLt,current,Option.map_some,Option.isSome_some]
+  have masked := winner_mask_preserved Rating.better_irrefl state.live state.cache.tree.values value
+    (state.cache.tree.best_exact.trans found) kept
+  rw [state.masked_values,rating_winner stored _ state.capacity] at masked
+  cases original : Sparse.best prior stored with
+  | none => simp only [original,Option.map_none] at masked; contradiction
+  | some previous =>
+      simp only [original,Option.map_some,Option.some.injEq] at masked
+      rw [key_injective previous score (masked.trans agreement.symm)]
+
+theorem State.empty_exact (state : State prior stored depth) (empty : state.cache.best = none) :
+    Sparse.best prior stored = none := by
+  have masked := winner_mask_none state.live state.cache.tree.values (state.cache.tree.best_exact.trans empty)
+  rw [state.masked_values,rating_winner stored _ state.capacity] at masked
+  cases original : Sparse.best prior stored with
+  | none => rfl
+  | some value => simp only [original,Option.map_some] at masked; contradiction
+
+def State.clear (state : State prior stored depth) (value : Rating.Key p.offers.size)
+    (absent : ratingAt prior stored (known prior) value.index.val = none) : State prior stored depth :=
+  let bound := Nat.lt_of_lt_of_le value.index.isLt state.capacity
+  let updated := state.cache.tree.updated value.index.val none
+  {capacity := state.capacity
+   cache := updated
+   identity := by
+    intro position entry found
+    rw [Tree.updated_values _ _ _ bound] at found
+    by_cases same : value.index.val = position
+    · subst position
+      have length : value.index.val < state.cache.tree.values.length := by simpa only [Tree.values_length] using bound
+      simp [List.getElem?_set_self length] at found
+    · rw [List.getElem?_set_ne same] at found
+      exact state.identity position entry found
+   complete := by
+    intro position entry current
+    rw [Tree.updated_values _ _ _ bound]
+    by_cases same : value.index.val = position
+    · rw [← same,absent] at current
+      contradiction
+    · rw [List.getElem?_set_ne same]
+      exact state.complete position entry current}
+
+private theorem count_clear (values : List (Option α)) (position : Nat) (value : α)
+    (present : values[position]? = some (some value)) :
+    (values.set position none).countP Option.isSome + 1 = values.countP Option.isSome := by
+  induction values generalizing position with
+  | nil => simp at present
+  | cons head tail ih =>
+      cases position with
+      | zero =>
+          simp only [List.getElem?_cons_zero,Option.some.injEq] at present
+          subst head
+          simp
+      | succ position =>
+          have next := ih position (by simpa only [List.getElem?_cons_succ] using present)
+          cases head <;> simp_all [List.set] <;> omega
+
+theorem State.clear_decreases (state : State prior stored depth) (value : Rating.Key p.offers.size)
+    (found : state.cache.best = some value) (absent : ratingAt prior stored (known prior) value.index.val = none) :
+    (state.clear value absent).cache.tree.values.countP Option.isSome < state.cache.tree.values.countP Option.isSome := by
+  rw [State.clear,Tree.updated_values _ _ _ (Nat.lt_of_lt_of_le value.index.isLt state.capacity)]
+  have changed := count_clear state.cache.tree.values value.index.val value (state.best_lookup value found)
+  omega
+
+end SharedCoverage.Deferred.VerifiedWinner

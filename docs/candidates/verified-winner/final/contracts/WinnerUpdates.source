["module\npublic import tools.WinnerCache\n@[expose] public section\n\nnamespace SharedCoverage.Deferred.VerifiedWinner\nopen StableWinnerIndex\nvariable {p : Problem} {prior : Selection p} {stored : Sparse.Values prior} {depth : Nat}\n\ndef updateMany (_capacity : p.offers.size ≤ 2^depth)\n    (cache : Cache (Rating.preference p.offers.size) depth) (indices : List (Fin p.offers.size))\n    (replacement : Nat → Option (Rating.Key p.offers.size)) : Cache (Rating.preference p.offers.size) depth :=\n  indices.foldl (fun cache index => cache.tree.updated index.val (replacement index.val)) cache\n\ntheorem updateMany_lookup (capacity : p.offers.size ≤ 2^depth)\n    (cache : Cache (Rating.preference p.offers.size) depth) (indices : List (Fin p.offers.size))\n    (replacement : Nat → Option (Rating.Key p.offers.size)) (query : Nat) :\n    (updateMany capacity cache indices replacement).tree.values[query]? =\n      if ∃ index ∈ indices, index.val = query then some (replacement query) else cache.tree.values[query]? := by\n  induction indices generalizing cache with\n  | nil => simp [updateMany]\n  | cons head tail ih =>\n      simp only [updateMany,List.foldl_cons] at *\n      rw [ih]\n      by_cases later : ∃ index ∈ tail, index.val = query\n      · simp [later]\n      · rw [if_neg later,Tree.updated_values _ _ _ (Nat.lt_of_lt_of_le head.isLt capacity)]\n        by_cases same : head.val = query\n        · subst query\n          have bound : head.val < cache.tree.values.length := by\n            simpa only [Tree.values_length] using Nat.lt_of_lt_of_le head.isLt capacity\n          simp [List.getElem?_set_self bound]\n        · simp [List.getElem?_set_ne same,later,same]\n\ndef State.advance (state : State prior stored depth) (layout : Sparse.Layout p)\n    (next : Selection p) (winner : Fin p.offers.size) (extension : next.selected = prior.selected++[winner])\n    (updated : Sparse.Values next) (same : updated = stored.advance layout next winner extension) :\n    State next updated depth :=\n  let changed := affected layout stored winner\n  let seen := known next\n  let replacement := ratingAt next updated seen\n  let cache := updateMany state.capacity state.cache changed replacement\n  {capacity := state.capacity\n   cache\n   identity := by\n    intro position value found\n    rw [updateMany_lookup] at found\n    split at found\n    · have current := Option.some.inj found\n      exact rating_at_index updated (known next) position value current\n    · exact state.identity position value found\n   complete := by\n    intro position value current\n    rw [updateMany_lookup]\n    by_cases present : ∃ index ∈ changed, index.val = position\n    · rw [if_pos present]\n      exact congrArg some current\n    · rw [if_neg present]\n      have bound : position < p.offers.size := by\n        have identity := rating_at_index updated (known next) position value current\n        simpa only [← identity] using value.index.isLt\n      let query : Fin p.offers.size := ⟨position,bound⟩\n      have absent : query ∉ changed := by\n        intro member\n        exact present ⟨query,member,rfl⟩\n      have values : updated.costs[query] = stored.costs[query] ∧ updated.gains[query] = stored.gains[query] := by\n        rw [same]\n        exact unaffected_values layout stored next winner query extension absent\n      have original := unchanged_valid_rating stored next updated winner query extension values.1 values.2 value current\n      exact state.complete position value original}\n\ndef State.initial (prior : Selection p) (stored : Sparse.Values prior) (depth : Nat)\n    (capacity : p.offers.size ≤ 2^depth) : State prior stored depth :=\n  let keys := ((List.range p.offers.size).map (ratingAt prior stored (known prior))).toArray\n  let cache := StableWinnerIndex.build (Rating.preference p.offers.size) depth keys\n  {capacity,cache\n   identity := by\n    intro position value found\n    by_cases inside : position < 2^depth\n    · by_cases real : position < p.offers.size\n      · have current : ratingAt prior stored (known prior) position = some value := by\n          simpa [cache,keys,build_values,List.getElem?_map,List.getElem?_range,inside,real] using found\n        exact rating_at_index stored (known prior) position value current\n      · simp [cache,keys,build_values,List.getElem?_map,inside,real] at found\n    · simp [cache,keys,build_values,List.getElem?_map,inside] at found\n   complete := by\n    intro position value current\n    have real : position < p.offers.size := by\n      have identity := rating_at_index stored (known prior) position value current\n      simpa only [← identity] using value.index.isLt\n    have inside := Nat.lt_of_lt_of_le real capacity\n    simp [cache,keys,build_values,List.getElem?_map,inside,real,current]}\n\nend SharedCoverage.Deferred.VerifiedWinner\n",[]]
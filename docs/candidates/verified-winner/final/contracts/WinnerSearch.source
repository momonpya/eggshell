["module\npublic import tools.WinnerCache\n@[expose] public section\n\nnamespace SharedCoverage.Deferred.VerifiedWinner\nvariable {p : Problem} {prior : Selection p} {stored : Sparse.Values prior} {depth : Nat}\n\n/-- The returned candidate is the complete scan's exact result. The retained\nstate may have removed newly infeasible leaves, without losing any live one. -/\nstructure Resolution (prior : Selection p) (stored : Sparse.Values prior) (depth : Nat) where\n  score : Option (Score prior (evaluation prior))\n  state : State prior stored depth\n  exact : score = Sparse.best prior stored\n\n/-- Invalid roots are removed one at a time. The count in the termination\nproof is erased; no runtime list of every leaf is built to drive recursion. -/\nprivate theorem same_seen (left right : Known prior) (index : Fin p.offers.size) :\n    Sparse.score? prior stored left index = Sparse.score? prior stored right index := by\n  rw [Sparse.score_exact,Sparse.score_exact]\n  simp only [Deferred.score?]\n\ndef State.resolveWith (state : State prior stored depth) (seen : Known prior) : Resolution prior stored depth :=\n  match found : state.cache.best with\n  | none => ⟨none,state,(state.empty_exact found).symm⟩\n  | some value =>\n    match current : Sparse.score? prior stored seen value.index with\n    | some score => ⟨some score,state,(state.best_exact value found score\n        (by rw [← same_seen seen (known prior) value.index]; exact current)).symm⟩\n    | none =>\n      have absent : ratingAt prior stored (known prior) value.index.val = none := by\n        simp only [ratingAt,dif_pos value.index.isLt,← same_seen seen (known prior) value.index,current,Option.map_none]\n      (state.clear value absent).resolveWith seen\ntermination_by state.cache.tree.values.countP Option.isSome\ndecreasing_by exact state.clear_decreases value found absent\n\n/-- Construct selected membership once, including when several now-infeasible\nroots must be removed during the same choice. -/\ndef State.resolve (state : State prior stored depth) : Resolution prior stored depth :=\n  state.resolveWith (known prior)\n\nend SharedCoverage.Deferred.VerifiedWinner\n",[]]
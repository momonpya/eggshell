["module\npublic import tools.SharedCoverage\npublic import tools.KeyPostings\n@[expose] public section\n\nnamespace SharedCoverage.Deferred\nopen Eggshell\nvariable {p : Problem} {prior : Selection p}\n\n/-- Fuse mapping and natural-number accumulation. This remains exact for\narbitrarily large weights; no floating-point arithmetic enters selection. -/\ndef weighted (measure : α → Nat) (values : List α) : Nat :=\n  values.foldl (fun total value => total+measure value) 0\n\ntheorem weighted_exact (measure : α → Nat) (values : List α) :\n    weighted measure values = (values.map measure).sum := by\n  simp only [weighted,List.sum_eq_foldl_nat,List.foldl_map]\n\ndef benefitFold (p : Problem) (selected : List (Fin p.offers.size)) : Nat :=\n  weighted (fun cue => p.weights[cue]) (cues p selected)\n\n@[csimp] theorem benefit_fold_compiled : @benefit = @benefitFold := by\n  funext p selected\n  exact (weighted_exact (fun cue => p.weights[cue]) (cues p selected)).symm\n\ndef afterBenefitFold (cached : Evaluation prior) (index : Fin p.offers.size) : Nat :=\n  let fresh := hashDistinct (p.offers[index].covers.filter fun cue => !cached.cueIndex.contains cue)\n  cached.beforeBenefit + weighted (fun cue => p.weights[cue]) fresh\n\n@[csimp] theorem after_benefit_fold_compiled : @Evaluation.afterBenefit = @afterBenefitFold := by\n  funext p prior cached index\n  simp only [Evaluation.afterBenefit,afterBenefitFold,weighted_exact]\n\n/-- Membership is fixed for one scan. Every lookup is tied to the actual\nselected list; no unchecked cached membership can reject an offer. -/\nstructure Known (prior : Selection p) where\n  selected : Std.HashMap (Fin p.offers.size) Unit\n  exact : ∀ index, selected.contains index = prior.selected.contains index\n\ndef known (prior : Selection p) : Known prior := {\n  selected := prior.selected.foldl (fun found index => found.insert index ()) {}\n  exact := by intro index; simp [HashDistinct.fold_contains]}\n\ndef Known.fresh (seen : Known prior) (index : Fin p.offers.size) : Decidable (index ∉ prior.selected) :=\n  if present : seen.selected.contains index = true then\n    isFalse (by\n      have member : index ∈ prior.selected := List.contains_iff_mem.mp (by rwa [seen.exact] at present)\n      exact fun absent => absent member)\n  else isTrue (by\n    intro member\n    apply present\n    rw [seen.exact]\n    exact List.contains_iff_mem.mpr member)\n\ntheorem Known.fresh_exact (seen : Known prior) (index : Fin p.offers.size) :\n    seen.fresh index = (inferInstance : Decidable (index ∉ prior.selected)) := Subsingleton.elim _ _\n\n/-- Losing candidates carry only an index and scalar score. Construct the\nextended selected list once, after choosing the winner. -/\nstructure Score (prior : Selection p) (cached : Evaluation prior) where\n  index : Fin p.offers.size\n  fresh : index ∉ prior.selected\n  fits : (cached.afterCost index).1 ≤ p.limit.1 ∧ (cached.afterCost index).2 ≤ p.limit.2\n  gain : Nat\n  positive : 0 < gain\n  charge : Nat\n\ndef Score.proposal (score : Score prior cached) : Proposal prior := {\n  result := {\n    selected := prior.selected ++ [score.index]\n    unique := by\n      apply List.nodup_append.mpr\n      refine ⟨prior.unique,by simp,?_⟩\n      intro a present b singleton same\n      have last : b = score.index := List.mem_singleton.mp singleton\n      exact score.fresh ((same.trans last) ▸ present)\n    charsFit := by rw [← cached.afterCost_exact score.index]; exact score.fits.1\n    bytesFit := by rw [← cached.afterCost_exact score.index]; exact score.fits.2}\n  gain := score.gain,positive := score.positive,charge := score.charge}\n\ndef score? (prior : Selection p) (cached : Evaluation prior) (seen : Known prior)\n    (index : Fin p.offers.size) : Option (Score prior cached) :=\n  letI : Decidable (index ∉ prior.selected) := seen.fresh index\n  if fresh : index ∉ prior.selected then\n    let after := cached.afterCost index\n    if fits : after.1 ≤ p.limit.1 ∧ after.2 ≤ p.limit.2 then\n      let gain := cached.afterBenefit index-cached.beforeBenefit\n      if positive : 0 < gain then\n        some ⟨index,fresh,fits,gain,positive,\n          max ((after.1-cached.beforeCost.1)*p.limit.2) ((after.2-cached.beforeCost.2)*p.limit.1)⟩\n      else none\n    else none\n  else none\n\ntheorem score_exact (cached : Evaluation prior) (seen : Known prior) (index : Fin p.offers.size) :\n    (score? prior cached seen index).map Score.proposal = proposalCached? prior cached index := by\n  unfold score? proposalCached? extendCached?\n  by_cases fresh : index ∉ prior.selected\n  · by_cases fits : (cached.afterCost index).1 ≤ p.limit.1 ∧ (cached.afterCost index).2 ≤ p.limit.2\n    · by_cases positive : 0 < cached.afterBenefit index-cached.beforeBenefit\n      · simp [fresh,fits,positive,Score.proposal]\n      · simp [fresh,fits,positive]\n    · simp [fresh,fits]\n  · simp [fresh]\n\ndef betterScore (next previous : Score prior cached) : Bool :=\n  if next.charge == 0 then previous.charge != 0 || previous.gain < next.gain\n  else if previous.charge == 0 then false\n  else previous.gain*next.charge < next.gain*previous.charge\n\ntheorem betterScore_exact (next previous : Score prior cached) :\n    betterScore next previous = better next.proposal previous.proposal := rfl\n\ndef step (prior : Selection p) (cached : Evaluation prior) (seen : Known prior)\n    (found : Option (Score prior cached)) (index : Fin p.offers.size) : Option (Score prior cached) :=\n  match score? prior cached seen index,found with\n  | none,_ => found\n  | some next,none => some next\n  | some next,some previous => if betterScore next previous then some next else found\n\ndef referenceStep (prior : Selection p) (cached : Evaluation prior)\n    (found : Option (Proposal prior)) (index : Fin p.offers.size) : Option (Proposal prior) :=\n  match proposalCached? prior cached index,found with\n  | none,_ => found\n  | some next,none => some next\n  | some next,some previous => if better next previous then some next else found\n\ntheorem step_exact (cached : Evaluation prior) (seen : Known prior)\n    (found : Option (Score prior cached)) (index : Fin p.offers.size) :\n    (step prior cached seen found index).map Score.proposal =\n      referenceStep prior cached (found.map Score.proposal) index := by\n  unfold step referenceStep\n  rw [← score_exact cached seen index]\n  cases current : score? prior cached seen index with\n  | none => cases found <;> rfl\n  | some next =>\n      cases found with\n      | none => rfl\n      | some previous =>\n          cases selected : betterScore next previous <;>\n            simp [selected, ← betterScore_exact]\n\ntheorem scan_exact (cached : Evaluation prior) (seen : Known prior)\n    (pending : List (Fin p.offers.size)) (found : Option (Score prior cached)) :\n    (pending.foldl (step prior cached seen) found).map Score.proposal =\n      pending.foldl (referenceStep prior cached) (found.map Score.proposal) := by\n  induction pending generalizing found with\n  | nil => rfl\n  | cons head tail ih =>\n      simp only [List.foldl_cons,ih,step_exact]\n\ndef bestDeferred (prior : Selection p) : Option (Proposal prior) :=\n  let cached := evaluation prior\n  let seen := known prior\n  ((List.finRange p.offers.size).foldl (step prior cached seen) none).map Score.proposal\n\ntheorem bestDeferred_exact (prior : Selection p) : bestDeferred prior = best prior := by\n  rw [best_cached_compiled]\n  unfold bestDeferred bestCached\n  rw [scan_exact]\n  rfl\n\ndef fillDeferred (fuel : Nat) (prior : Selection p) : Selection p :=\n  match fuel with\n  | 0 => prior\n  | fuel+1 => match bestDeferred prior with\n    | none => prior\n    | some next => fillDeferred fuel next.result\n\ntheorem fillDeferred_exact (fuel : Nat) (prior : Selection p) :\n    fillDeferred fuel prior = fill fuel prior := by\n  induction fuel generalizing prior with\n  | zero => rfl\n  | succ fuel ih =>\n      simp only [fillDeferred,fill,bestDeferred_exact]\n      cases best prior with\n      | none => rfl\n      | some next => exact ih next.result\n\ndef chooseDeferred? (p : Problem) : Option (Selection p) := do\n  let initial ← empty? p\n  pure (prefer (fillDeferred p.offers.size initial) (bestSingleton initial))\n\ntheorem choose_deferred_compiled : @choose? = @chooseDeferred? := by\n  funext p\n  simp only [choose?,chooseFrom,chooseDeferred?,fillDeferred_exact]\n\nnamespace Sparse\n\n/-- The reverse incidence contains all full feature/offer identities. Hashes\nnominate buckets only. Duplicate features remain harmless during updates. -/\ndef pairs (features : Fin n → List (Fin d)) : Array (Fin d × Fin n) :=\n  ((List.finRange n).flatMap fun index => (features index).map (·,index)).toArray\n\nstructure Incidence (features : Fin n → List (Fin d)) where\n  index : KeyPostings.Index Prod.fst (pairs features)\n\ndef incidence (features : Fin n → List (Fin d)) : Incidence features :=\n  ⟨KeyPostings.prepare Prod.fst (pairs features)⟩\n\ndef Incidence.lookup {features : Fin n → List (Fin d)}\n    (layout : Incidence features) (feature : Fin d) : List (Fin n) :=\n  ((layout.index.lookup feature).map Prod.snd).toList\n\ntheorem Incidence.lookup_exact {features : Fin n → List (Fin d)}\n    (layout : Incidence features) (feature : Fin d) (offer : Fin n) :\n    offer ∈ layout.lookup feature ↔ feature ∈ features offer := by\n  unfold Incidence.lookup\n  rw [layout.index.lookup_exact]\n  simp only [Array.toList_map,Array.toList_filterMap,\n    pairs,List.mem_filterMap,List.mem_flatMap,\n    List.mem_map,List.mem_finRange,true_and]\n  constructor\n  · rintro ⟨pair,⟨_,⟨i,value,member,rfl⟩,kept⟩,last⟩\n    by_cases equal : value = feature\n    · simp only [equal,BEq.rfl,ite_true,Option.some.injEq] at kept\n      subst pair\n      simpa only [Prod.snd] using last ▸ equal ▸ member\n    · simp [equal] at kept\n  · intro member\n    exact ⟨(feature,offer),⟨(feature,offer),⟨offer,feature,member,rfl⟩,by simp⟩,rfl⟩\n\ndef Incidence.touched {features : Fin n → List (Fin d)}\n    (layout : Incidence features) (added : List (Fin d)) : List (Fin n) :=\n  added.flatMap layout.lookup\n\ntheorem Incidence.touched_complete {features : Fin n → List (Fin d)}\n    (layout : Incidence features) (added : List (Fin d)) (offer : Fin n)\n    (feature : Fin d) (present : feature ∈ features offer) (new : feature ∈ added) :\n    offer ∈ layout.touched added :=\n  List.mem_flatMap.mpr ⟨feature,new,(layout.lookup_exact feature offer).mpr present⟩\n\ndef patch (values : Vector α n) (replacement : Fin n → α) (indices : List (Fin n)) : Vector α n :=\n  indices.foldl (fun current (index : Fin n) => current.set index.val (replacement index) index.isLt) values\n\ntheorem patch_exact (values : Vector α n) (replacement : Fin n → α)\n    (indices : List (Fin n)) (query : Fin n) :\n    (patch values replacement indices)[query] =\n      if query ∈ indices then replacement query else values[query] := by\n  induction indices generalizing values with\n  | nil => simp [patch]\n  | cons head tail ih =>\n    change (patch (values.set head.val (replacement head) head.isLt) replacement tail)[query] = _\n    rw [ih]\n    by_cases member : query ∈ tail\n    · simp [member]\n    · by_cases same : query = head\n      · subst query; simp [member]\n      · have different : head.val ≠ query.val := by\n          intro equal; exact same (Fin.ext equal.symm)\n        simp [member,same,different]\n\ndef rawCost (cached : Evaluation prior) (index : Fin p.offers.size) : Nat × Nat :=\n  (hashDistinct (p.offers[index].closure.filter fun node => !cached.nodeIndex.contains node)).foldl\n    (fun total node => (total.1+p.costs[node].1,total.2+p.costs[node].2)) (0,0)\n\ndef rawGain (cached : Evaluation prior) (index : Fin p.offers.size) : Nat :=\n  weighted (fun cue => p.weights[cue])\n    (hashDistinct (p.offers[index].covers.filter fun cue => !cached.cueIndex.contains cue))\n\ntheorem fold_cost_base (p : Problem) (items : List (Fin p.costs.size)) (base : Nat × Nat) :\n    items.foldl (fun total node => (total.1+p.costs[node].1,total.2+p.costs[node].2)) base =\n    let zero := items.foldl (fun total node => (total.1+p.costs[node].1,total.2+p.costs[node].2)) (0,0)\n    (base.1+zero.1,base.2+zero.2) := by\n  induction items generalizing base with\n  | nil => simp\n  | cons head tail ih =>\n    simp only [List.foldl_cons]\n    simp only [Nat.zero_add]\n    rw [ih _ , ih (p.costs[head].1,p.costs[head].2)]\n    simp [Nat.add_assoc]\n\ntheorem rawCost_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\n    cached.afterCost index =\n      (cached.beforeCost.1+(rawCost cached index).1,cached.beforeCost.2+(rawCost cached index).2) := by\n  exact fold_cost_base _ _ _\n\ntheorem rawGain_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\n    cached.afterBenefit index = cached.beforeBenefit+rawGain cached index := by\n  simp only [Evaluation.afterBenefit,rawGain,weighted_exact]\n\ndef marginal (prior : Selection p) (index : Fin p.offers.size) : (Nat × Nat) × Nat :=\n  let cached := evaluation prior\n  (rawCost cached index,rawGain cached index)\n\nstructure Values (prior : Selection p) where\n  base : Evaluation prior\n  baseExact : base = evaluation prior\n  costs : Vector (Nat × Nat) p.offers.size\n  gains : Vector Nat p.offers.size\n  costsExact : ∀ index, costs[index] = rawCost (evaluation prior) index\n  gainsExact : ∀ index, gains[index] = rawGain (evaluation prior) index\n\ndef values (prior : Selection p) : Values prior :=\n  let cached := evaluation prior\n  ⟨cached,rfl,Vector.ofFn (rawCost cached),Vector.ofFn (rawGain cached),\n    by intro index; simp [cached],by intro index; simp [cached]⟩\n\ntheorem features_unchanged (features : Fin n → List (Fin d)) (selected : List (Fin n))\n    (winner offer : Fin n)\n    (covered : ∀ feature ∈ features offer, feature ∈ features winner → feature ∈ selected.flatMap features)\n    (feature : Fin d) (present : feature ∈ features offer) :\n    ((selected++[winner]).flatMap features).contains feature =\n      (selected.flatMap features).contains feature := by\n  by_cases already : feature ∈ selected.flatMap features\n  · simp [List.flatMap_append,List.contains_eq_mem,already]\n  · have absent : feature ∉ features winner := fun member => already (covered feature present member)\n    simp [List.flatMap_append,List.contains_eq_mem,already,absent]\n\ntheorem nodeFilter_unchanged (prior next : Selection p) (winner offer : Fin p.offers.size)\n    (extension : next.selected = prior.selected++[winner])\n    (covered : ∀ node ∈ p.offers[offer].closure, node ∈ p.offers[winner].closure →\n      (evaluation prior).nodeIndex.contains node = true) :\n    p.offers[offer].closure.filter (fun node => !(evaluation prior).nodeIndex.contains node) =\n      p.offers[offer].closure.filter (fun node => !(evaluation next).nodeIndex.contains node) := by\n    apply List.filter_congr\n    intro node present\n    rw [(evaluation prior).nodesExact,(evaluation next).nodesExact]\n    simp only [nodes,List.contains_eq_mem,List.mem_eraseDups,extension]\n    simpa only [List.contains_eq_mem] using congrArg (! ·)\n      (features_unchanged (fun i => p.offers[i].closure)\n        prior.selected winner offer (by\n          intro value member included\n          have seen := covered value member included\n          rw [(evaluation prior).nodesExact] at seen\n          simpa [nodes] using List.contains_iff_mem.mp seen) node present).symm\n\ntheorem cueFilter_unchanged (prior next : Selection p) (winner offer : Fin p.offers.size)\n    (extension : next.selected = prior.selected++[winner])\n    (covered : ∀ cue ∈ p.offers[offer].covers, cue ∈ p.offers[winner].covers →\n      (evaluation prior).cueIndex.contains cue = true) :\n    p.offers[offer].covers.filter (fun cue => !(evaluation prior).cueIndex.contains cue) =\n      p.offers[offer].covers.filter (fun cue => !(evaluation next).cueIndex.contains cue) := by\n    apply List.filter_congr\n    intro cue present\n    rw [(evaluation prior).cuesExact,(evaluation next).cuesExact]\n    simp only [cues,List.contains_eq_mem,List.mem_eraseDups,extension]\n    simpa only [List.contains_eq_mem] using congrArg (! ·)\n      (features_unchanged (fun i => p.offers[i].covers)\n        prior.selected winner offer (by\n          intro value member included\n          have seen := covered value member included\n          rw [(evaluation prior).cuesExact] at seen\n          simpa [cues] using List.contains_iff_mem.mp seen) cue present).symm\n\ndef Incidence.changed {features : Fin n → List (Fin d)} (layout : Incidence features)\n    (seen : Std.HashMap (Fin d) Unit) (added : List (Fin d)) : List (Fin n) :=\n  hashDistinct (layout.touched (added.filter fun feature => !seen.contains feature))\n\n/-- Stream postings into one membership set. Do not build a large list of\nduplicate affected offers merely to throw the duplicates away afterwards. -/\ndef Incidence.changedStreaming {features : Fin n → List (Fin d)} (layout : Incidence features)\n    (seen : Std.HashMap (Fin d) Unit) (added : List (Fin d)) : List (Fin n) :=\n  let input := added.filter fun feature => !seen.contains feature\n  let result := input.foldl (fun state feature => (layout.lookup feature).foldl HashDistinct.step state) ({},[])\n  result.2.reverse\n\n@[csimp] theorem Incidence.changed_streaming_exact : @Incidence.changed = @Incidence.changedStreaming := by\n  funext n d features layout seen added\n  unfold changed changedStreaming Incidence.touched hashDistinct\n  rw [List.foldl_flatMap]\n  rfl\n\ntheorem Incidence.unchanged {features : Fin n → List (Fin d)} (layout : Incidence features)\n    (seen : Std.HashMap (Fin d) Unit) (added : List (Fin d)) (offer : Fin n)\n    (absent : offer ∉ layout.changed seen added) (feature : Fin d)\n    (present : feature ∈ features offer) (included : feature ∈ added) :\n    seen.contains feature = true := by\n  cases found : seen.contains feature with\n  | true => rfl\n  | false =>\n    apply False.elim\n    apply absent\n    exact (HashDistinct.mem _ _).mpr (layout.touched_complete _ _ feature present\n      (List.mem_filter.mpr ⟨included,by simp [found]⟩))\n\nstructure Layout (p : Problem) where\n  nodes : Incidence (fun i : Fin p.offers.size => p.offers[i].closure)\n  cues : Incidence (fun i : Fin p.offers.size => p.offers[i].covers)\n\ndef layout (p : Problem) : Layout p := ⟨incidence _,incidence _⟩\n\ndef Values.advance (stored : Values prior) (layout : Layout p) (next : Selection p)\n    (winner : Fin p.offers.size) (extension : next.selected = prior.selected++[winner]) : Values next :=\n  let before := stored.base\n  let after := evaluation next\n  {base := after\n   baseExact := rfl\n   costs := patch stored.costs (rawCost after) (layout.nodes.changed before.nodeIndex p.offers[winner].closure)\n   gains := patch stored.gains (rawGain after) (layout.cues.changed before.cueIndex p.offers[winner].covers)\n   costsExact := by\n    intro query\n    rw [patch_exact]\n    split\n    · rfl\n    · rename_i absent\n      rw [stored.costsExact]\n      simp only [before,stored.baseExact] at absent\n      unfold rawCost\n      rw [nodeFilter_unchanged prior next winner query extension\n        (layout.nodes.unchanged _ _ _ absent)]\n   gainsExact := by\n    intro query\n    rw [patch_exact]\n    split\n    · rfl\n    · rename_i absent\n      rw [stored.gainsExact]\n      simp only [before,stored.baseExact] at absent\n      unfold rawGain\n      rw [cueFilter_unchanged prior next winner query extension\n        (layout.cues.unchanged _ _ _ absent)]}\n\ndef Values.afterCost (stored : Values prior) (index : Fin p.offers.size) : Nat × Nat :=\n  let before := stored.base.beforeCost\n  (before.1+stored.costs[index].1,before.2+stored.costs[index].2)\n\ntheorem Values.afterCost_exact (stored : Values prior) (index : Fin p.offers.size) :\n    stored.afterCost index = (evaluation prior).afterCost index := by\n  simp only [Values.afterCost,stored.costsExact,stored.baseExact,rawCost_exact]\n\ntheorem Values.gain_exact (stored : Values prior) (index : Fin p.offers.size) :\n    stored.gains[index] = (evaluation prior).afterBenefit index-(evaluation prior).beforeBenefit := by\n  simp only [stored.gainsExact,rawGain_exact,Nat.add_sub_cancel_left]\n\ndef score? (prior : Selection p) (stored : Values prior) (seen : Known prior)\n    (index : Fin p.offers.size) : Option (Score prior (evaluation prior)) :=\n  letI : Decidable (index ∉ prior.selected) := seen.fresh index\n  if fresh : index ∉ prior.selected then\n    let after := stored.afterCost index\n    if fits : after.1 ≤ p.limit.1 ∧ after.2 ≤ p.limit.2 then\n      let gain := stored.gains[index]\n      if positive : 0 < gain then\n        some ⟨index,fresh,by\n          dsimp only [after] at fits\n          rwa [stored.afterCost_exact] at fits,gain,positive,\n          max ((after.1-stored.base.beforeCost.1)*p.limit.2)\n            ((after.2-stored.base.beforeCost.2)*p.limit.1)⟩\n      else none\n    else none\n  else none\n\ntheorem score_exact (stored : Values prior) (seen : Known prior) (index : Fin p.offers.size) :\n    score? prior stored seen index = Deferred.score? prior (evaluation prior) seen index := by\n  simp only [score?,Deferred.score?,stored.afterCost_exact,stored.gain_exact,stored.baseExact]\n\ndef step (prior : Selection p) (stored : Values prior) (seen : Known prior)\n    (found : Option (Score prior (evaluation prior))) (index : Fin p.offers.size) :=\n  match score? prior stored seen index,found with\n  | none,_ => found\n  | some next,none => some next\n  | some next,some previous => if betterScore next previous then some next else found\n\ntheorem step_exact (stored : Values prior) (seen : Known prior)\n    (found : Option (Score prior (evaluation prior))) (index : Fin p.offers.size) :\n    step prior stored seen found index = Deferred.step prior (evaluation prior) seen found index := by\n  simp only [step,Deferred.step,score_exact]\n  cases current : Deferred.score? prior (evaluation prior) seen index <;> cases found <;> rfl\n\ndef best (prior : Selection p) (stored : Values prior) : Option (Score prior (evaluation prior)) :=\n  (List.finRange p.offers.size).foldl (step prior stored (known prior)) none\n\ntheorem best_exact (stored : Values prior) :\n    (best prior stored).map Score.proposal = SharedCoverage.best prior := by\n  have same : step prior stored (known prior) = Deferred.step prior (evaluation prior) (known prior) := by\n    funext found index\n    exact step_exact stored _ found index\n  rw [← bestDeferred_exact]\n  simp only [best,bestDeferred,same]\n\ndef fill (layout : Layout p) (fuel : Nat) (prior : Selection p) (stored : Values prior) : Selection p :=\n  match fuel with\n  | 0 => prior\n  | fuel+1 => match best prior stored with\n    | none => prior\n    | some score =>\n      let next := score.proposal.result\n      fill layout fuel next (stored.advance layout next score.index rfl)\n\ntheorem fill_exact (layout : Layout p) (fuel : Nat) (prior : Selection p) (stored : Values prior) :\n    fill layout fuel prior stored = SharedCoverage.fill fuel prior := by\n  induction fuel generalizing prior with\n  | zero => rfl\n  | succ fuel ih =>\n    rw [SharedCoverage.fill,← best_exact stored]\n    cases found : best prior stored with\n    | none => simp [fill,found]\n    | some score =>\n      simpa only [fill,found,Option.map_some] using\n        (ih score.proposal.result (stored.advance layout _ score.index rfl))\n\ndef choose? (p : Problem) : Option (Selection p) := do\n  let initial ← empty? p\n  let prepared := layout p\n  pure (prefer (fill prepared p.offers.size initial (values initial)) (bestSingleton initial))\n\ntheorem choose_exact : @SharedCoverage.choose? = @choose? := by\n  rw [choose_deferred_compiled]\n  funext p\n  simp only [chooseDeferred?,choose?,fill_exact,fillDeferred_exact]\n\nend Sparse\nend SharedCoverage.Deferred\n",[]]
["module\npublic import tools.WinnerRatings\n@[expose] public section\n\nnamespace SharedCoverage.Deferred.VerifiedWinner\nvariable {p : Problem} {prior : Selection p}\n\ndef marginalKey (stored : Sparse.Values prior) (index : Fin p.offers.size) : Rating.Key p.offers.size :=\n  ⟨index,stored.gains[index],max (stored.costs[index].1*p.limit.2) (stored.costs[index].2*p.limit.1)⟩\n\ntheorem rating_fin_iff (stored : Sparse.Values prior) (seen : Known prior)\n    (index : Fin p.offers.size) (value : Rating.Key p.offers.size) :\n    (Sparse.score? prior stored seen index).map key = some value ↔\n      index ∉ prior.selected ∧\n      ((stored.afterCost index).1 ≤ p.limit.1 ∧ (stored.afterCost index).2 ≤ p.limit.2) ∧\n      0 < stored.gains[index] ∧ marginalKey stored index = value := by\n  unfold Sparse.score?\n  dsimp only\n  split\n  · rename_i fresh\n    split\n    · rename_i fits\n      split\n      · rename_i positive\n        have positiveNat : 0 < stored.gains[index.val] := positive\n        have fitsNat : stored.base.beforeCost.1+stored.costs[index.val].1 ≤ p.limit.1 ∧\n            stored.base.beforeCost.2+stored.costs[index.val].2 ≤ p.limit.2 := fits\n        simp only [Option.map_some,Option.some.injEq]\n        simp [fresh,fitsNat,positiveNat,key,marginalKey,Sparse.Values.afterCost]\n      · rename_i positive\n        have notPositiveNat : ¬0 < stored.gains[index.val] := positive\n        simp [fresh,fits,notPositiveNat]\n    · rename_i fits\n      simp [fresh,fits]\n  · rename_i fresh\n    simp [fresh]\n\ntheorem rating_at_index (stored : Sparse.Values prior) (seen : Known prior)\n    (index : Nat) (value : Rating.Key p.offers.size)\n    (found : ratingAt prior stored seen index = some value) : value.index.val = index := by\n  unfold ratingAt at found\n  split at found\n  · have data := (rating_fin_iff stored seen _ value).mp found\n    exact (congrArg (fun entry : Rating.Key p.offers.size => entry.index.val) data.2.2.2).symm\n  · contradiction\n\ntheorem unchanged_valid_rating (stored : Sparse.Values prior) (next : Selection p)\n    (updated : Sparse.Values next) (winner index : Fin p.offers.size)\n    (extension : next.selected = prior.selected++[winner])\n    (sameCost : updated.costs[index] = stored.costs[index])\n    (sameGain : updated.gains[index] = stored.gains[index])\n    (value : Rating.Key p.offers.size)\n    (found : ratingAt next updated (known next) index.val = some value) :\n    ratingAt prior stored (known prior) index.val = some value := by\n  have current : (Sparse.score? next updated (known next) index).map key = some value := by\n    simpa only [ratingAt,dif_pos index.isLt] using found\n  have valid := (rating_fin_iff updated (known next) index value).mp current\n  have fresh : index ∉ prior.selected := by\n    intro member\n    apply valid.1\n    rw [extension]\n    exact List.mem_append_left _ member\n  have afterFits : (cost p (next.selected++[index])).1 ≤ p.limit.1 ∧\n      (cost p (next.selected++[index])).2 ≤ p.limit.2 := by\n    simpa only [updated.afterCost_exact,Evaluation.afterCost_exact] using valid.2.1\n  have beforeFits : (stored.afterCost index).1 ≤ p.limit.1 ∧\n      (stored.afterCost index).2 ≤ p.limit.2 := by\n    simp only [stored.afterCost_exact,Evaluation.afterCost_exact]\n    by_cases before : (cost p (prior.selected++[index])).1 ≤ p.limit.1 ∧\n        (cost p (prior.selected++[index])).2 ≤ p.limit.2\n    · exact before\n    · exact False.elim (Budget.no_reactivation p prior.selected index winner before\n        (by simpa only [extension] using afterFits))\n  have original : (Sparse.score? prior stored (known prior) index).map key = some value := by\n    apply (rating_fin_iff stored (known prior) index value).mpr\n    refine ⟨fresh,beforeFits,?_,?_⟩\n    · simpa only [sameGain] using valid.2.2.1\n    · simpa only [marginalKey,sameCost,sameGain] using valid.2.2.2\n  simpa only [ratingAt,dif_pos index.isLt] using original\n\ndef affected (layout : Sparse.Layout p) (stored : Sparse.Values prior) (winner : Fin p.offers.size) :\n    List (Fin p.offers.size) :=\n  Eggshell.hashDistinct (winner ::\n    layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure ++\n      layout.cues.changed stored.base.cueIndex p.offers[winner].covers)\n\ntheorem unaffected_values (layout : Sparse.Layout p) (stored : Sparse.Values prior)\n    (next : Selection p) (winner index : Fin p.offers.size)\n    (extension : next.selected = prior.selected++[winner])\n    (absent : index ∉ affected layout stored winner) :\n    (stored.advance layout next winner extension).costs[index] = stored.costs[index] ∧\n    (stored.advance layout next winner extension).gains[index] = stored.gains[index] := by\n  have original : index ∉ winner ::\n      layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure ++\n        layout.cues.changed stored.base.cueIndex p.offers[winner].covers := by\n    intro member\n    exact absent ((Eggshell.HashDistinct.mem _ _).mpr member)\n  have parts :\n      index ∉ layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure ∧\n      index ∉ layout.cues.changed stored.base.cueIndex p.offers[winner].covers := by\n    have resolved : (index ≠ winner ∧\n        index ∉ layout.nodes.changed stored.base.nodeIndex p.offers[winner].closure) ∧\n        index ∉ layout.cues.changed stored.base.cueIndex p.offers[winner].covers := by\n      simpa only [List.mem_cons,List.mem_append,not_or] using original\n    exact ⟨resolved.1.2,resolved.2⟩\n  change (Sparse.patch stored.costs _ _)[index] = stored.costs[index] ∧\n    (Sparse.patch stored.gains _ _)[index] = stored.gains[index]\n  constructor\n  · rw [Sparse.patch_exact,if_neg parts.1]\n  · rw [Sparse.patch_exact,if_neg parts.2]\n\nend SharedCoverage.Deferred.VerifiedWinner\n",[]]
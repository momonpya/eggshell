["module\npublic import tools.WinnerEntries\n@[expose] public section\n\nnamespace SharedCoverage.Deferred.VerifiedWinner\nopen StableWinnerIndex\nvariable {p : Problem} {prior : Selection p} {stored : Sparse.Values prior} {depth : Nat}\n\n/-- Stale, now-infeasible leaves are permitted. Every currently eligible\ncandidate must be present with its current key at its original position. -/\nstructure State (prior : Selection p) (stored : Sparse.Values prior) (depth : Nat) where\n  capacity : p.offers.size ≤ 2^depth\n  cache : Cache (Rating.preference p.offers.size) depth\n  identity : ∀ (position : Nat) (value : Rating.Key p.offers.size),\n    cache.tree.values[position]? = some (some value) → value.index.val = position\n  complete : ∀ (position : Nat) (value : Rating.Key p.offers.size), ratingAt prior stored (known prior) position = some value →\n    cache.tree.values[position]? = some (some value)\n\ndef State.live (_state : State prior stored depth) (value : Rating.Key p.offers.size) : Bool :=\n  (ratingAt prior stored (known prior) value.index.val).isSome\n\ntheorem State.masked_values (state : State prior stored depth) :\n    state.cache.tree.values.map (mask state.live) =\n      (List.range (2^depth)).map (ratingAt prior stored (known prior)) := by\n  apply List.ext_getElem?\n  intro position\n  by_cases bound : position < 2^depth\n  · have inside : position < state.cache.tree.values.length := by simpa only [Tree.values_length] using bound\n    let entry := state.cache.tree.values[position]'inside\n    have located : state.cache.tree.values[position]? = some entry := List.getElem?_eq_getElem inside\n    have pointwise : mask state.live entry = ratingAt prior stored (known prior) position := by\n      cases original : entry with\n      | none =>\n          cases current : ratingAt prior stored (known prior) position with\n          | none => rfl\n          | some value =>\n              have covered := state.complete position value current\n              rw [located,original] at covered\n              simp at covered\n      | some value =>\n          have identity := state.identity position value (by simpa only [original] using located)\n          cases current : ratingAt prior stored (known prior) position with\n          | none => simp [mask,State.live,identity,current]\n          | some wanted =>\n              have covered := state.complete position wanted current\n              rw [located,original] at covered\n              have same := Option.some.inj (Option.some.inj covered)\n              subst wanted\n              simp [mask,State.live,identity,current]\n    simp only [List.getElem?_map,located,Option.map_some,List.getElem?_range,bound]\n    exact congrArg some pointwise\n  · have outside : state.cache.tree.values.length ≤ position := by simpa only [Tree.values_length] using Nat.le_of_not_gt bound\n    simp [List.getElem?_map,List.getElem?_eq_none outside,bound]\n\ntheorem State.best_lookup (state : State prior stored depth) (value : Rating.Key p.offers.size)\n    (found : state.cache.best = some value) : state.cache.tree.values[value.index.val]? = some (some value) := by\n  have member := winner_mem (Rating.preference p.offers.size) state.cache.tree.values value\n    (state.cache.tree.best_exact.trans found)\n  obtain ⟨position,located⟩ := List.mem_iff_getElem?.mp member\n  have identity := state.identity position value located\n  simpa only [identity] using located\n\ntheorem key_injective (a b : Score prior (evaluation prior)) (same : key a = key b) : a = b := by\n  cases a\n  cases b\n  simp only [key,Rating.Key.mk.injEq] at same\n  rcases same with ⟨rfl,rfl,rfl⟩\n  rfl\n\ntheorem State.current_key (state : State prior stored depth) (value : Rating.Key p.offers.size)\n    (found : state.cache.best = some value) (score : Score prior (evaluation prior))\n    (current : Sparse.score? prior stored (known prior) value.index = some score) : key score = value := by\n  have rated : ratingAt prior stored (known prior) value.index.val = some (key score) := by\n    simp only [ratingAt,dif_pos value.index.isLt,current,Option.map_some]\n  have covered := state.complete value.index.val (key score) rated\n  have located := state.best_lookup value found\n  exact Option.some.inj (Option.some.inj (covered.symm.trans located))\n\ntheorem State.best_exact (state : State prior stored depth) (value : Rating.Key p.offers.size)\n    (found : state.cache.best = some value) (score : Score prior (evaluation prior))\n    (current : Sparse.score? prior stored (known prior) value.index = some score) :\n    Sparse.best prior stored = some score := by\n  have agreement := state.current_key value found score current\n  have kept : state.live value = true := by\n    simp only [State.live,ratingAt,dif_pos value.index.isLt,current,Option.map_some,Option.isSome_some]\n  have masked := winner_mask_preserved Rating.better_irrefl state.live state.cache.tree.values value\n    (state.cache.tree.best_exact.trans found) kept\n  rw [state.masked_values,rating_winner stored _ state.capacity] at masked\n  cases original : Sparse.best prior stored with\n  | none => simp only [original,Option.map_none] at masked; contradiction\n  | some previous =>\n      simp only [original,Option.map_some,Option.some.injEq] at masked\n      rw [key_injective previous score (masked.trans agreement.symm)]\n\ntheorem State.empty_exact (state : State prior stored depth) (empty : state.cache.best = none) :\n    Sparse.best prior stored = none := by\n  have masked := winner_mask_none state.live state.cache.tree.values (state.cache.tree.best_exact.trans empty)\n  rw [state.masked_values,rating_winner stored _ state.capacity] at masked\n  cases original : Sparse.best prior stored with\n  | none => rfl\n  | some value => simp only [original,Option.map_some] at masked; contradiction\n\ndef State.clear (state : State prior stored depth) (value : Rating.Key p.offers.size)\n    (absent : ratingAt prior stored (known prior) value.index.val = none) : State prior stored depth :=\n  let bound := Nat.lt_of_lt_of_le value.index.isLt state.capacity\n  let updated := state.cache.tree.updated value.index.val none\n  {capacity := state.capacity\n   cache := updated\n   identity := by\n    intro position entry found\n    rw [Tree.updated_values _ _ _ bound] at found\n    by_cases same : value.index.val = position\n    · subst position\n      have length : value.index.val < state.cache.tree.values.length := by simpa only [Tree.values_length] using bound\n      simp [List.getElem?_set_self length] at found\n    · rw [List.getElem?_set_ne same] at found\n      exact state.identity position entry found\n   complete := by\n    intro position entry current\n    rw [Tree.updated_values _ _ _ bound]\n    by_cases same : value.index.val = position\n    · rw [← same,absent] at current\n      contradiction\n    · rw [List.getElem?_set_ne same]\n      exact state.complete position entry current}\n\nprivate theorem count_clear (values : List (Option α)) (position : Nat) (value : α)\n    (present : values[position]? = some (some value)) :\n    (values.set position none).countP Option.isSome + 1 = values.countP Option.isSome := by\n  induction values generalizing position with\n  | nil => simp at present\n  | cons head tail ih =>\n      cases position with\n      | zero =>\n          simp only [List.getElem?_cons_zero,Option.some.injEq] at present\n          subst head\n          simp\n      | succ position =>\n          have next := ih position (by simpa only [List.getElem?_cons_succ] using present)\n          cases head <;> simp_all [List.set] <;> omega\n\ntheorem State.clear_decreases (state : State prior stored depth) (value : Rating.Key p.offers.size)\n    (found : state.cache.best = some value) (absent : ratingAt prior stored (known prior) value.index.val = none) :\n    (state.clear value absent).cache.tree.values.countP Option.isSome < state.cache.tree.values.countP Option.isSome := by\n  rw [State.clear,Tree.updated_values _ _ _ (Nat.lt_of_lt_of_le value.index.isLt state.capacity)]\n  have changed := count_clear state.cache.tree.values value.index.val value (state.best_lookup value found)\n  omega\n\nend SharedCoverage.Deferred.VerifiedWinner\n",[]]
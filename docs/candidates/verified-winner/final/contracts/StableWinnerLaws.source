["module\npublic import tools.SelectionRating\n@[expose] public section\n\nnamespace StableWinnerIndex\nvariable {α : Type} {order : Preference α}\n\ntheorem winner_cons (head : Option α) (tail : List (Option α)) :\n    winner order (head::tail) = merge order head (winner order tail) := by\n  rw [winner,List.foldl_cons,fold_from]\n  rfl\n\ntheorem merge_none_iff (left right : Option α) :\n    merge order left right = none ↔ left = none ∧ right = none := by\n  cases left <;> cases right <;> simp [merge]\n  split <;> simp\n\ntheorem winner_none_iff (values : List (Option α)) :\n    winner order values = none ↔ ∀ value ∈ values, value = none := by\n  induction values with\n  | nil => simp [winner]\n  | cons head tail ih =>\n      rw [winner_cons,merge_none_iff,ih]\n      simp\n\ntheorem asymmetric (irrefl : ∀ a, order.better a a = false) (a b : α)\n    (ab : order.better a b = true) : order.better b a ≠ true := by\n  intro ba\n  have impossible := order.trans a b a ab ba\n  rw [irrefl] at impossible\n  contradiction\n\ntheorem merge_left_bound (irrefl : ∀ a, order.better a a = false)\n    (a result : α) (right : Option α) (found : merge order (some a) right = some result) :\n    order.better a result ≠ true := by\n  cases right with\n  | none => simp only [merge,Option.some.injEq] at found; subst result; simp [irrefl]\n  | some b =>\n      by_cases ba : order.better b a = true\n      · simp [merge,ba] at found\n        subst result\n        exact asymmetric irrefl b a ba\n      · simp [merge,ba] at found\n        subst result\n        simp [irrefl]\n\ntheorem merge_right_bound (irrefl : ∀ a, order.better a a = false)\n    (b result : α) (left : Option α) (found : merge order left (some b) = some result) :\n    order.better b result ≠ true := by\n  cases left with\n  | none => simp only [merge,Option.some.injEq] at found; subst result; simp [irrefl]\n  | some a =>\n      by_cases ba : order.better b a = true\n      · simp [merge,ba] at found\n        subst result\n        simp [irrefl]\n      · simp [merge,ba] at found\n        subst result\n        exact ba\n\ntheorem winner_bound (irrefl : ∀ a, order.better a a = false)\n    (values : List (Option α)) (result : α) (found : winner order values = some result)\n    (value : α) (present : some value ∈ values) : order.better value result ≠ true := by\n  induction values generalizing result with\n  | nil => simp at present\n  | cons head tail ih =>\n      rw [winner_cons] at found\n      rcases List.mem_cons.mp present with same | rest\n      · subst head\n        exact merge_left_bound irrefl value result _ found\n      · cases final : winner order tail with\n        | none =>\n            have absent := (winner_none_iff tail).mp final (some value) rest\n            contradiction\n        | some best =>\n            have below := ih best final rest\n            have after := merge_right_bound irrefl best result head (by simpa only [final] using found)\n            exact order.negTrans value best result below after\n\ndef mask (accept : α → Bool) : Option α → Option α\n  | none => none\n  | some value => if accept value then some value else none\n\ntheorem mask_some (accept : α → Bool) (entry : Option α) (value : α)\n    (found : mask accept entry = some value) : entry = some value ∧ accept value = true := by\n  cases entry with\n  | none => simp [mask] at found\n  | some original =>\n      cases accepted : accept original with\n      | false => simp [mask,accepted] at found\n      | true =>\n          have same : original = value := by simpa [mask,accepted] using found\n          subst original\n          exact ⟨rfl,accepted⟩\n\ntheorem winner_mask_none (accept : α → Bool) (values : List (Option α))\n    (empty : winner order values = none) : winner order (values.map (mask accept)) = none := by\n  apply (winner_none_iff _).mpr\n  intro entry present\n  obtain ⟨original,member,rfl⟩ := List.mem_map.mp present\n  have absent := (winner_none_iff _).mp empty original member\n  simp [absent,mask]\n\ntheorem winner_mask_preserved (irrefl : ∀ a, order.better a a = false)\n    (accept : α → Bool) (values : List (Option α)) (result : α)\n    (found : winner order values = some result) (kept : accept result = true) :\n    winner order (values.map (mask accept)) = some result := by\n  induction values with\n  | nil => simp [winner] at found\n  | cons head tail ih =>\n      rw [winner_cons] at found\n      simp only [List.map_cons,winner_cons]\n      cases head with\n      | none =>\n          simp only [merge] at found\n          simpa only [mask,merge] using ih found\n      | some a =>\n          cases last : winner order tail with\n          | none =>\n              simp only [last,merge,Option.some.injEq] at found\n              subst result\n              rw [winner_mask_none accept tail last]\n              simp [mask,kept,merge]\n          | some b =>\n              by_cases ba : order.better b a = true\n              · simp only [last,merge,ba,↓reduceIte,Option.some.injEq] at found\n                subst result\n                rw [ih last]\n                cases accepted : accept a <;> simp [mask,merge,accepted,ba]\n              · simp [last,merge,ba] at found\n                subst result\n                cases filtered : winner order (tail.map (mask accept)) with\n                | none => simp [mask,kept,merge]\n                | some c =>\n                    obtain ⟨entry,present,matched⟩ := List.mem_map.mp (winner_mem order _ c filtered)\n                    have original := (mask_some accept entry c matched).1\n                    rw [original] at present\n                    have lower := winner_bound irrefl tail b last c present\n                    have below := order.negTrans c b a lower ba\n                    simp [mask,kept,merge,below]\n\nend StableWinnerIndex\n\nnamespace SharedCoverage.Rating\ntheorem better_irrefl (value : Key n) : better value value = false := by\n  by_cases zero : value.charge = 0 <;> simp [better,zero]\nend SharedCoverage.Rating\n",[]]
[["Std","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std\"]"],["tools.RangeReach","[\"module\\npublic import Std\\n@[expose] public section\\n\\nnamespace Eggshell.RangeReach\\n\\n/-- Original intervals with opaque payload identities. No source equivalence\\nor completion authority is inferred by this recommendation index. -/\\nstructure Entry (α : Type) where\\n  first : Nat\\n  limit : Nat\\n  value : α\\n\\nstructure Prepared (α : Type) where\\n  starts : Array Nat\\n  farthest : Array (Entry α)\\n\\n/-- The prefix maximum answers a furthest-reaching interval query with one\\nbinary search. Preparation happens once per owner, not once per citation. -/\\ndef prepare (entries : Array (Entry α)) : Prepared α := Id.run do\\n  let ordered := (entries.filter (fun entry => entry.first < entry.limit)).qsort\\n    (fun left right => if left.first == right.first then left.limit > right.limit else left.first < right.first)\\n  let mut starts := #[]\\n  let mut farthest := #[]\\n  let mut best := none\\n  for entry in ordered do\\n    let current := match best with\\n      | none => entry\\n      | some prior => if prior.limit < entry.limit then entry else prior\\n    starts := starts.push entry.first\\n    farthest := farthest.push current\\n    best := some current\\n  return ⟨starts,farthest⟩\\n\\ndef Prepared.lookup? (prepared : Prepared α) (point : Nat) : Option (Entry α) := Id.run do\\n  let mut lower := 0\\n  let mut upper := prepared.starts.size\\n  while lower < upper do\\n    let middle := (lower+upper)/2\\n    let some start := prepared.starts[middle]? | return none\\n    if start ≤ point then lower := middle+1 else upper := middle\\n  if lower == 0 then return none\\n  let some found := prepared.farthest[lower-1]? | return none\\n  if found.first ≤ point && point < found.limit then return some found else return none\\n\\ndef Prepared.coverFuel (prepared : Prepared α) : Nat → Nat → Nat → Option (List α)\\n  | 0,first,last => if last ≤ first then some [] else none\\n  | fuel+1,first,last => do\\n    if last ≤ first then return []\\n    let found ← prepared.lookup? first\\n    if first < found.limit then\\n      let rest ← prepared.coverFuel fuel (min last found.limit) last\\n      return found.value :: rest\\n    else none\\n\\ndef Prepared.cover? (prepared : Prepared α) (first last : Nat) : Option (List α) :=\\n  if first < last then prepared.coverFuel prepared.farthest.size first last else none\\n\\nend Eggshell.RangeReach\\n\",[]]"]]
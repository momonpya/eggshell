+theorem covers_position (ranges : List (Nat × Nat)) (first last position : Nat)
+    (covered : covers ranges first last = true) (inside : first ≤ position ∧ position < last) :
+    ∃ range ∈ ranges, range.1 ≤ position ∧ position < range.2 := by
+  classical
+  unfold covers at covered
+  split at covered
+  · rename_i ordered
+    change (DeliveryInterval.subtractAll ⟨first,last,ordered⟩ (validCoverage ranges)).isEmpty = true at covered
+    apply Classical.byContradiction
+    intro missing
+    have fresh : ∀ prior ∈ validCoverage ranges, ¬prior.covers position := by
+      intro prior present contains
+      obtain ⟨⟨a,b⟩,member,found⟩ := List.mem_filterMap.mp present
+      by_cases valid : a < b
+      · simp only [valid,↓reduceDIte,Option.some.injEq] at found
+        subst prior
+        exact missing ⟨(a,b),member,contains⟩
+      · simp [valid] at found
+    have remaining := (DeliveryInterval.subtractAll_covers ⟨first,last,ordered⟩
+      (validCoverage ranges) position).mpr ⟨inside,fresh⟩
+    have empty : DeliveryInterval.subtractAll ⟨first,last,ordered⟩ (validCoverage ranges) = [] :=
+      List.isEmpty_iff.mp covered
+    simp [empty] at remaining
+  · simp at covered
+

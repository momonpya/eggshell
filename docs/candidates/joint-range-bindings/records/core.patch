@@ -0,0 +1,59 @@
+module
+public import Std
+@[expose] public section
+
+namespace Eggshell.RangeReach
+
+/-- Original intervals with opaque payload identities. No source equivalence
+or completion authority is inferred by this recommendation index. -/
+structure Entry (α : Type) where
+  first : Nat
+  limit : Nat
+  value : α
+
+structure Prepared (α : Type) where
+  starts : Array Nat
+  farthest : Array (Entry α)
+
+/-- The prefix maximum answers a furthest-reaching interval query with one
+binary search. Preparation happens once per owner, not once per citation. -/
+def prepare (entries : Array (Entry α)) : Prepared α := Id.run do
+  let ordered := (entries.filter (fun entry => entry.first < entry.limit)).qsort
+    (fun left right => if left.first == right.first then left.limit > right.limit else left.first < right.first)
+  let mut starts := #[]
+  let mut farthest := #[]
+  let mut best := none
+  for entry in ordered do
+    let current := match best with
+      | none => entry
+      | some prior => if prior.limit < entry.limit then entry else prior
+    starts := starts.push entry.first
+    farthest := farthest.push current
+    best := some current
+  return ⟨starts,farthest⟩
+
+def Prepared.lookup? (prepared : Prepared α) (point : Nat) : Option (Entry α) := Id.run do
+  let mut lower := 0
+  let mut upper := prepared.starts.size
+  while lower < upper do
+    let middle := (lower+upper)/2
+    let some start := prepared.starts[middle]? | return none
+    if start ≤ point then lower := middle+1 else upper := middle
+  if lower == 0 then return none
+  let some found := prepared.farthest[lower-1]? | return none
+  if found.first ≤ point && point < found.limit then return some found else return none
+
+def Prepared.coverFuel (prepared : Prepared α) : Nat → Nat → Nat → Option (List α)
+  | 0,first,last => if last ≤ first then some [] else none
+  | fuel+1,first,last => do
+    if last ≤ first then return []
+    let found ← prepared.lookup? first
+    if first < found.limit then
+      let rest ← prepared.coverFuel fuel (min last found.limit) last
+      return found.value :: rest
+    else none
+
+def Prepared.cover? (prepared : Prepared α) (first last : Nat) : Option (List α) :=
+  if first < last then prepared.coverFuel prepared.farthest.size first last else none
+
+end Eggshell.RangeReach

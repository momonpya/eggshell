shell.SynapseProvenance","[\"module\\n\\npublic import Eggshell.GraphStore\\npublic import Eggshell.ObservationContext\\npublic import Eggshell.ObservedRecords\\npublic import Eggshell.ContentMetadata\\npublic import Eggshell.ObservationAge\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Provenance\\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\\n\\n/-- Native observation identity, with semantic positions checked independently\\nof the Exact session/turn/tool identifiers. -/\\ndef identities (edge : OutcomeEdge) : Array Occurrence :=\\n  edge.observations.toArray.filterMap fun observation => do\\n    let .apply .occurrence references := observation | none\\n    let [(.semantic, result), (.semantic, work), (.exact, session),\\n        (.exact, turn), (.exact, useId)] := references.toList | none\\n    if result != edge.outcome || work != edge.work then none else\\n      some ⟨← text? session, ← text? turn, ← text? useId⟩\\n\\ndef document (reader : NodeReader snapshot) (id : Nat) : IO Document := do\\n  let edge ← reader.outcome (← reader.locateOutcome id)\\n  let owner := Persistence.selectionKey edge.relation\\n  let candidates ← getIds snapshot.get (\\\"owner:\\\" ++ toString (hash edge.relation).toNat)\\n  let live ← candidates.filterM fun id => return (← snapshot.get (key \\\"member\\\" id)).isSome\\n  unless live == [id] do throw (IO.userError \\\"ambiguous synaptic source owner\\\")\\n  return {\\n    owner, work := Persistence.selectionKey edge.work\\n    workText := text? edge.work, source := text? edge.outcome\\n    native := edge.observations.any (Relation.observesOutcomeWork edge.outcome edge.work)\\n    occurrences := identities edge\\n    files := ← IO.ofExcept (fileMap ((← reader.sources id).toArray.map toJson)) }\\n\\n/-- Query-free provenance. The body stays in its original native Outcome. -/\\nstructure Origin where\\n  owner : Nat\\n  occurrence : Occurrence\\n  domain : String\\n  started : Nat\\n  finished : Nat\\n  receivedUnixMs : Option Nat := none\\n  deriving BEq, FromJson\\n\\n/-- Absence stays absent, including in original records without a wall clock. -/\\ninstance : ToJson Origin where\\n  toJson origin := Json.mkObj ([\\n    (\\\"owner\\\", toJson origin.owner), (\\\"occurrence\\\", toJson origin.occurrence),\\n    (\\\"domain\\\", toJson origin.domain), (\\\"started\\\", toJson origin.started),\\n    (\\\"finished\\\", toJson origin.finished)] ++\\n    origin.receivedUnixMs.toList.map (fun time => (\\\"receivedUnixMs\\\", toJson time)))\\n\\ndef Origin.valid (origin : Origin) : Bool :=\\n  origin.occurrence.valid && digest origin.domain && origin.started < origin.finished\\n\\nstructure Checked where\\n  origin : Origin\\n  valid : origin.valid = true\\n\\ndef Origin.check? (origin : Origin) : Option Checked :=\\n  if valid : origin.valid = true then some ⟨origin, valid⟩ else none\\n\\ntheorem Checked.time_order (checked : Checked) : checked.origin.started < checked.origin.finished := by\\n  have := checked.valid\\n  simp only [Origin.valid, Bool.and_eq_true, decide_eq_true_eq] at this\\n  exact this.2\\n\\ndef originPrefix : String := \\\"memo:synaptic-origin:\\\"\\ndef stateKey : String := \\\"memo:synaptic-state\\\"\\n\\ndef contentKey [ToJson α] (value : α) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.synaptic-provenance\\\".toUTF8 [(toJson value).compress.toUTF8])\\n\\ndef name (occurrence : Occurrence) : String := originPrefix ++ contentKey occurrence\\n\\ndef originRow (occurrence : Occurrence) (encoded : ByteArray) : PageMap.Row :=\\n  (name occurrence, some encoded)\\n\\ndef stateRow (encoded : ByteArray) : PageMap.Row := (stateKey, some encoded)\\n\\n/-- The actual metadata row constructors preserve all graph and authority\\nkeys. The publication journal is managed separately by the checked writer. -/\\ntheorem metadata_preserves_authority (occurrence : Occurrence) (encoded root : ByteArray)\\n    (before : String → Option ByteArray) (key : String) (outside : PageMap.derivedKey key = false) :\\n    PageMap.applyRows [originRow occurrence encoded, stateRow root] before key = before key := by\\n  apply PageMap.derived_rows_preserve _ _ _ key outside\\n  simp [originRow, stateRow, name, originPrefix, stateKey, PageMap.derivedKey]\\n\\nstructure State where\\n  count : Nat := 0\\n  digest : String := contentKey (\\\"empty\\\" : String)\\n  deriving BEq, ToJson, FromJson\\n\\nstructure Stored where\\n  ordinal : Nat\\n  previous : String\\n  origin : Origin\\n  deriving BEq, ToJson, FromJson\\n\\ndef bytes [ToJson α] (value : α) : IO ByteArray := do\\n  let encoded := (toJson value).compress.toUTF8\\n  unless encoded.size ≤ 65536 do throw (IO.userError \\\"synaptic provenance exceeds its metadata bound\\\")\\n  return encoded\\n\\ndef decode [ToJson α] [FromJson α] (encoded : ByteArray) : IO α := do\\n  unless encoded.size ≤ 65536 do throw (IO.userError \\\"synaptic provenance exceeds its metadata bound\\\")\\n  let some text := String.fromUTF8? encoded | throw (IO.userError \\\"invalid provenance UTF-8\\\")\\n  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))\\n  unless (toJson value).compress.toUTF8 == encoded do throw (IO.userError \\\"noncanonical synaptic provenance\\\")\\n  return value\\n\\ndef state (source : PageMap.Snapshot) : IO State := do\\n  let result ← match ← source.get stateKey with\\n    | none => pure ({} : State)\\n    | some encoded => decode encoded\\n  unless Synapses.digest result.digest do throw (IO.userError \\\"invalid synaptic provenance root\\\")\\n  return result\\n\\ndef stamp (source : PageMap.Snapshot) : IO String := do\\n  return contentKey (← state source)\\n\\ndef records (source : PageMap.Snapshot) : IO (Array Stored) := do\\n  let values ← source.foldRange ⟨originPrefix, \\\"memo:synaptic-origin;\\\"⟩ (fun values row => do\\n    let some encoded := row.2 | return values\\n    let value ← decode (α := Stored) encoded\\n    unless row.1 == name value.origin.occurrence && value.origin.valid do\\n      throw (IO.userError \\\"provenance record is not bound to its original identity\\\")\\n    return values.push value) #[]\\n  let values := values.qsort (fun a b => a.ordinal < b.ordinal)\\n  let mut previous : State := {}\\n  for value in values do\\n    unless value.ordinal == previous.count && value.previous == previous.digest do\\n      throw (IO.userError \\\"incomplete or reordered provenance chain\\\")\\n    previous := ⟨previous.count+1, contentKey value⟩\\n  unless previous == (← state source) do throw (IO.userError \\\"provenance records disagree with their published root\\\")\\n  return values\\n\\ndef checkedDocument (reader : NodeReader source) (origin : Origin) : IO Document := do\\n  unless origin.valid do throw (IO.userError \\\"invalid native provenance interval\\\")\\n  let doc ← document reader origin.owner\\n  unless doc.native && doc.occurrences.contains origin.occurrence do\\n    throw (IO.userError \\\"provenance does not belong to its original native observation\\\")\\n  return doc\\n\\n/-- A single immutable metadata lookup against a pinned source, not a scan of\\nthe origin log. The caller's native owner and occurrence must both agree. -/\\ndef lookup? (source : PageMap.Snapshot) (owner : OutcomeEdge)\\n    (occurrence : Occurrence) : IO (Option Origin) := do\\n  unless (identities owner).contains occurrence do return none\\n  let some encoded ← source.get (name occurrence) | return none\\n  let stored ← decode (α := Stored) encoded\\n  unless stored.origin.valid && stored.origin.occurrence == occurrence &&\\n      stored.ordinal < (← state source).count do\\n    throw (IO.userError \\\"invalid native observation metadata\\\")\\n  unless (← findNode? source owner.relation) == some stored.origin.owner &&\\n      (← source.get (key \\\"member\\\" stored.origin.owner)).isSome do\\n    throw (IO.userError \\\"native observation metadata has another owner\\\")\\n  return some stored.origin\\n\\n/-- One checked native observation, still bound to its complete original edge. -/\\nstructure Binding where\\n  edge : OutcomeEdge\\n  checked : Checked\\n  observed : (identities edge).contains checked.origin.occurrence = true\\n\\ndef Binding.check? (edge : OutcomeEdge) (origin : Origin) : Option Binding := do\\n  let checked ← origin.check?\\n  if observed : (identities edge).contains checked.origin.occurrence = true then\\n    some ⟨edge,checked,observed⟩ else none\\n\\ntheorem binding_has_observed_interval (binding : Binding) :\\n    binding.checked.origin.valid = true ∧\\n      (identities binding.edge).contains binding.checked.origin.occurrence = true :=\\n  ⟨binding.checked.valid,binding.observed⟩\\n\\ndef appendRows (writer : PageMap.Writer) (origins : Array Origin) : IO Bool := do\\n  let initial ← match ← writer.get stateKey with\\n    | none => pure ({} : State)\\n    | some encoded => decode encoded\\n  unless Synapses.digest initial.digest do throw (IO.userError \\\"invalid synaptic provenance root\\\")\\n  let mut current := initial\\n  for origin in origins do\\n    let key := name origin.occurrence\\n    unless PageMap.derivedKey key do throw (IO.userError \\\"provenance key escaped the non-authoritative namespace\\\")\\n    if let some encoded ← writer.get key then\\n      let old ← decode (α := Stored) encoded\\n      unless old.origin == origin && old.ordinal < current.count do\\n        throw (IO.userError \\\"conflicting immutable native provenance\\\")\\n    else\\n      let value : Stored := ⟨current.count,current.digest,origin⟩\\n      let row := originRow origin.occurrence (← bytes value)\\n      writer.put row.1 row.2\\n      current := ⟨current.count+1,contentKey value⟩\\n  if current == initial then return false\\n  let row := stateRow (← bytes current)\\n  writer.put row.1 row.2\\n  return true\\n\\n/-- Stage after the same transaction's original roots. No source ACK can be\\nreturned between body publication and this metadata publication. -/\\ndef stage (intern : Persistence.Store.Intern) (bindings : Array Binding) : IO Bool := do\\n  for binding in bindings do\\n    let id ← intern.value binding.edge.relation\\n    unless id == binding.checked.origin.owner &&\\n        (← intern.writer.get (key \\\"member\\\" id)).isSome do\\n      throw (IO.userError \\\"native interval is not bound to its live original root\\\")\\n  appendRows intern.writer (bindings.map (·.checked.origin))\\n\\n/-- Background preparation consumes source-published originals. It never\\nrepublishes source metadata, even when every proposed row is already present.\\nMissing intervals remain source-publication debt; only `stage` may create them. -/\\ndef requirePublished (source : PageMap.Snapshot) (origins : Array Origin) : IO Unit := do\\n  if origins.isEmpty then return\\n  let some encoded ← source.get stateKey |\\n    throw (IO.userError \\\"original intervals have not been source-published\\\")\\n  let state ← decode (α := State) encoded\\n  unless digest state.digest do throw (IO.userError \\\"invalid native provenance root\\\")\\n  let reader ← NodeReader.new source\\n  for origin in origins do\\n    let _ ← checkedDocument reader origin\\n    let some encoded ← source.get (name origin.occurrence) |\\n      throw (IO.userError \\\"original interval awaits its source publication\\\")\\n    let stored ← decode (α := Stored) encoded\\n    unless stored.origin == origin && stored.ordinal < state.count do\\n      throw (IO.userError \\\"source-published original interval disagrees with native replay\\\")\\n\\nstructure Event where\\n  origin : Origin\\n  start : Bool\\n\\ndef Event.time (event : Event) : Nat := if event.start then event.origin.started else event.origin.finished\\n\\ndef Event.group (event : Event) : String :=\\n  (toJson (event.origin.domain, event.origin.occurrence.session, event.origin.occurrence.turn)).compress\\n\\nstructure Derived where\\n  graph : Graph := .empty\\n  originals : Nat := 0\\n  ignored : Nat := 0\\n\\n/-- Reconstruct only from DB-owned original bodies and observed intervals.\\nAllocation ordinals validate storage; only actual times determine consumption. -/\\ndef derive (source : PageMap.Snapshot) : IO Derived := do\\n  let stored ← records source\\n  if stored.isEmpty then return {}\\n  let reader ← NodeReader.new source\\n  let mut docs : Std.HashMap Nat Document := {}\\n  let mut events : Array Event := #[]\\n  let mut ignored := 0\\n  for value in stored do\\n    let origin := value.origin\\n    if (← source.get (key \\\"member\\\" origin.owner)).isNone then ignored := ignored+1; continue\\n    let doc ← checkedDocument reader origin\\n    let some work := doc.workText | ignored := ignored+1; continue\\n    if doc.source.isNone || (invocationData work).toOption.isNone then ignored := ignored+1; continue\\n    docs := docs.insert origin.owner doc\\n    events := events.push ⟨origin, true⟩ |>.push ⟨origin, false⟩\\n  events := events.qsort fun a b =>\\n    if a.group == b.group then\\n      if a.time == b.time then name a.origin.occurrence < name b.origin.occurrence else a.time < b.time\\n    else a.group < b.group\\n  let mut result : Derived := {ignored, originals := events.size/2}\\n  let mut trace : Trace := {}\\n  let mut group := \\\"\\\"\\n  let mut locations : Std.HashMap Occurrence (Array OutputRow) := {}\\n  for event in events do\\n    if group != event.group then\\n      let located ← IO.ofExcept (trace.locate locations)\\n      result := {result with graph := ← IO.ofExcept (result.graph.merge located.graph)}\\n      trace := {}; locations := {}; group := event.group\\n    let some doc := docs[event.origin.owner]? | throw (IO.userError \\\"missing original provenance body\\\")\\n    if event.start then\\n      let (input,format) ← IO.ofExcept (invocationData (doc.workText.getD \\\"\\\"))\\n      trace ← IO.ofExcept (trace.start event.origin.occurrence event.time input format)\\n    else\\n      let raw := doc.source.getD \\\"\\\"\\n      let format := if (Json.parse raw).isOk then DataFormat.json else .text\\n      trace ← IO.ofExcept (trace.finish event.origin.occurrence event.time raw format)\\n      let catalog ← match ← ObservedRecords.load? source event.origin.owner doc with\\n        | some catalog => pure catalog\\n        | none => do\\n            let prepared ← IO.ofExcept (ObservedRecords.prepare raw)\\n            IO.ofExcept (ObservedRecords.catalog source.head.identity doc prepared.records)\\n      let reads := ObservationContext.locateUsing source.head.identity doc trace catalog\\n      let rows := reads.filter (·.read.occurrence == event.origin.occurrence) |>.flatMap (·.rows)\\n      locations := locations.insert event.origin.occurrence rows\\n  let located ← IO.ofExcept (trace.locate locations)\\n  return {result with graph := ← IO.ofExcept (result.graph.merge located.graph)}\\n\\nend Eggshell.Synapses.Provenance\\n\",[]]"],["Eggshell.SynapseQuotes","[\"module\\n\\npublic import Eggshell.Sha256\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Quotes\\n\\n/-- Only opaque keys of already stored source spellings enter the index. A\\nkey selects candidates; the original spelling is checked again before use. -/\\ndef digest (text : String) : String :=\\n  Sha256.hex (\\\"eggshell.literal-quotation\\\\n\\\" ++ text).toUTF8\\n\\nstructure Quote (original : String) where\\n  first : Nat\\n  limit : Nat\\n  text : String\\n  within : first < limit ∧ limit ≤ original.length\\n  exact : text = String.ofList (original.toList.toArray.extract first limit).toList\\n\\ntheorem quote_is_original (quote : Quote original) :\\n    quote.text = String.ofList (original.toList.toArray.extract quote.first quote.limit).toList :=\\n  quote.exact\\n\\n/-- Literal backtick spans only, with equally sized closing delimiters. No\\nnormalization or semantic attribution is inferred from ordinary prose. The\\ncursor never rewinds, including on unfinished or mismatched delimiters. -/\\ndef extract (original : String) : Array (Quote original) := Id.run do\\n  let chars := original.toList.toArray\\n  let size := original.length\\n  let mut position := 0\\n  let mut result := #[]\\n  while position < chars.size do\\n    if chars[position]! != '`' then position := position+1; continue\\n    let start := position\\n    while position < chars.size && chars[position]! == '`' do position := position+1\\n    let width := position-start\\n    let first := position\\n    while position < chars.size do\\n      if chars[position]! != '`' then position := position+1; continue\\n      let limit := position\\n      while position < chars.size && chars[position]! == '`' do position := position+1\\n      if position-limit != width then continue\\n      if within : first < limit ∧ limit ≤ size then\\n        result := result.push ⟨first,limit,String.ofList (chars.extract first limit).toList,within,rfl⟩\\n      break\\n  return result\\n\\nend Eggshell.Synapses.Quotes\\n\",[]]"],["Eggshell.SynapseRecommend","[\"module\\n\\npublic import Eggshell.SynapseIndex\\npublic import Eggshell.SynapseUsage\\npublic import Eggshell.ObservationContext\\npublic import Eggshell.CanonicalSourceCache\\npublic import Eggshell.CanonicalSourceDelivery\\npublic import Eggshell.PublicationClient\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Recommend\\nopen Lean DB\\n\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.observation-recommendation\\\".toUTF8 [\\n  (include_str \\\"SynapseRecommend.lean\\\").toUTF8,(include_str \\\"ObservationContext.lean\\\").toUTF8,\\n  (include_str \\\"JsonScalars.lean\\\").toUTF8,(include_str \\\"SynapseTransport.lean\\\").toUTF8,\\n  (include_str \\\"SynapseUsage.lean\\\").toUTF8,(include_str \\\"SynapticTransport.lean\\\").toUTF8,\\n  (include_str \\\"SynapticRoutingStore.lean\\\").toUTF8])\\n\\nstructure Offer where\\n  target : Target\\n  priority : Nat\\n  fact : Fact\\n  identity : String\\n  identity_exact : identity = Index.contentKey fact\\n  valid : fact.valid = true\\n  witness : carries fact target = true\\n\\ndef Offer.check? (target : Target) (priority : Nat) (fact : Fact)\\n    (identity : {value : String // value = Index.contentKey fact}) : Option Offer :=\\n  if valid : fact.valid = true then\\n    if witness : carries fact target = true then\\n      some ⟨target, priority, fact, identity.val, identity.property, valid, witness⟩ else none\\n  else none\\n\\ntheorem Offer.consumption_row (offer : Offer) (edge : Consumption) (kind : offer.fact = .consumed edge)\\n    (source : Range) (target : offer.target = .range source) : source ∈ edge.rows := by\\n  have witness := offer.witness\\n  rw [kind,target] at witness\\n  exact Array.mem_of_contains_eq_true witness\\n\\ntheorem Offer.usage_is_evidence (offer : Offer) (usage : Usage) (kind : offer.fact = .used usage) :\\n    (usage.kind = .omittedThenRead ∨ usage.kind = .omittedThenConsumed) ∨ usage.kind = .deliveredThenCited := by\\n  have witness := offer.witness\\n  cases target : offer.target <;> simp_all [carries, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq]\\n\\ntheorem Offer.output_has_producer (offer : Offer) (producer : Occurrence)\\n    (target : offer.target = .output producer) :\\n    ∃ edge, offer.fact = .consumed edge ∧ edge.producer = producer := by\\n  have witness := offer.witness\\n  cases kind : offer.fact <;> simp_all [carries,beq_iff_eq]\\n\\ndef Offer.kind (offer : Offer) : String := match offer.fact with\\n  | .supports _ => \\\"support\\\"\\n  | .consumed _ => \\\"consumption\\\"\\n  | .coquoted _ _ => \\\"coquotation\\\"\\n  | .used usage => usage.kind.label\\n  | .read _ => \\\"unavailable\\\"\\n\\ndef Offer.json (offer : Offer) : Json := Json.mkObj [\\n  (\\\"target\\\", toJson offer.target), (\\\"source\\\", toJson offer.target.source?), (\\\"priority\\\", toJson offer.priority),\\n  (\\\"kind\\\", toJson offer.kind), (\\\"evidence\\\", toJson offer.identity)]\\n\\nstructure Limits where\\n  requests : Nat := 256\\n  facts : Nat := 8192\\n  bytes : Nat := 8*1024*1024\\n\\nstructure Task where\\n  key : Index.Key\\n  priority : Nat\\n\\nstructure Result where\\n  offers : Array Offer := #[]\\n  requests : Nat := 0\\n  facts : Nat := 0\\n  bytes : Nat := 0\\n  complete : Bool := true\\n  available : Bool := true\\n  index : Option PageMap.Head := none\\n  usage : Option PageMap.Head := none\\n  failure : Option String := none\\n\\n/-- A partial walk never changes the original packet. Its receipt still\\nreports incompleteness rather than presenting an empty successful search. -/\\ndef Result.admitted (result : Result) : Array Offer :=\\n  if result.complete && result.available && result.failure.isNone then result.offers else #[]\\n\\ntheorem Result.incomplete_not_admitted (result : Result) (incomplete : result.complete = false) :\\n    result.admitted = #[] := by simp [admitted, incomplete]\\n\\ntheorem Result.failed_not_admitted (result : Result) (failed : result.failure.isSome = true) :\\n    result.admitted = #[] := by\\n  cases found : result.failure <;> simp_all [admitted]\\n\\ndef Result.receipt (result : Result) : Json := Json.mkObj [\\n  (\\\"available\\\", toJson result.available), (\\\"complete\\\", toJson result.complete),\\n  -- An exception can occur after successful reads. Do not report those\\n  -- interrupted counters as zero observed operations.\\n  (\\\"requests\\\", if result.failure.isSome then Json.null else toJson result.requests),\\n  (\\\"facts\\\", if result.failure.isSome then Json.null else toJson result.facts),\\n  (\\\"bytes\\\", if result.failure.isSome then Json.null else toJson result.bytes),\\n  (\\\"failure\\\", toJson result.failure),\\n  (\\\"index\\\", toJson result.index), (\\\"usage\\\", toJson result.usage),\\n  (\\\"offers\\\", toJson (result.admitted.map Offer.json))]\\n\\ndef Result.stamp (result : Result) : String := Index.contentKey result.receipt\\n\\ndef addOffer (result : Result) (target : Target) (priority : Nat) (fact : Fact)\\n    (identity : {value : String // value = Index.contentKey fact}) : Result :=\\n  match Offer.check? target priority fact identity with\\n  | none => result\\n  | some offer => {result with offers := result.offers.push offer}\\n\\n/-- Priority is inherited from the original nomination. Coquotation expands\\none incidence hop; only reverse consumption is recursive. No score fitting,\\nwhole-producer fallback, graph mutation or certification occurs here. -/\\ndef collect (shared : Index.Reader) (usage : Option Index.Reader)\\n    (answers : Array (String × Nat)) (initial : Array Range) (query : String)\\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\\n  let database := shared.manifest.source.identity\\n  let mut roots := answers.map fun (answer, priority) => ({key := .answer database answer, priority} : Task)\\n  roots := roots ++ initial.map (fun source => ⟨.quoted source, 0⟩)\\n  roots := roots ++ consumers.map (fun (consumer,priority) => ⟨.consumer consumer,priority⟩)\\n  if usage.isSome && digest query then roots := roots.push ⟨.query query, 0⟩\\n  roots := roots.qsort fun a b =>\\n    if a.priority == b.priority then (toJson a.key).compress < (toJson b.key).compress\\n    else a.priority < b.priority\\n  let mut nextRoot := 0\\n  let mut queue : Array Task := #[]\\n  let mut position := 0\\n  let mut seen : Array Index.Key := #[]\\n  let mut result : Result := {index := some shared.index.head, usage := usage.map (·.index.head)}\\n  -- Descendants inherit their root's priority. Exhaust each root's FIFO\\n  -- closure before the next root, rather than repeatedly sorting a growing\\n  -- fanout. First visitation therefore retains the best nominated priority.\\n  repeat\\n    if position == queue.size then\\n      let some root := roots[nextRoot]? | break\\n      nextRoot := nextRoot+1\\n      queue := #[root]\\n      position := 0\\n    let some task := queue[position]? | break\\n    position := position+1\\n    if (← IO.monoMsNow) ≥ deadline then\\n      result := {result with complete := false}\\n      break\\n    if seen.contains task.key then continue\\n    if result.requests ≥ limits.requests || result.facts ≥ limits.facts || result.bytes ≥ limits.bytes ||\\n        (← IO.monoMsNow) ≥ deadline then\\n      result := {result with complete := false}\\n      break\\n    seen := seen.push task.key\\n    let reader := match task.key with | .query _ => usage.getD shared | _ => shared\\n    let found ← reader.lookup task.key (limits.facts-result.facts) deadline (some (limits.bytes-result.bytes))\\n    result := {result with\\n      requests := result.requests+1\\n      facts := result.facts+found.checked.size\\n      bytes := result.bytes+found.payloadBytes}\\n    if !found.complete then result := {result with complete := false}; break\\n    for checked in found.checked do\\n      let fact := checked.fact\\n      let identity : {value : String // value = Index.contentKey fact} := ⟨Index.contentKey fact, rfl⟩\\n      match task.key, fact with\\n      | .answer .., .supports support =>\\n        result := addOffer result (.range support.source) task.priority fact identity\\n        queue := queue.push ⟨.group (.claim support.claim), task.priority⟩\\n        queue := queue.push ⟨.consumer support.read.occurrence, task.priority⟩\\n        queue := queue.push ⟨.quoted support.source, task.priority⟩\\n      | .consumer _, .consumed edge =>\\n        if edge.rows.isEmpty then\\n          result := addOffer result (.output edge.producer) task.priority fact identity\\n        for source in edge.rows do\\n          result := addOffer result (.range source) task.priority fact identity\\n          queue := queue.push ⟨.quoted source, task.priority⟩\\n        queue := queue.push ⟨.consumer edge.producer, task.priority⟩\\n      | .quoted _, .coquoted group _ =>\\n        queue := queue.push ⟨.group group, task.priority⟩\\n      | .group _, .coquoted _ source =>\\n        result := addOffer result (.range source) task.priority fact identity\\n      | .query _, .used value =>\\n        if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed || value.kind == .deliveredThenCited then\\n          result := addOffer result (.range value.source) task.priority fact identity\\n          queue := queue.push ⟨.quoted value.source, task.priority⟩\\n      | _, _ => pure ()\\n  -- A checked omission is the more direct observation. Positive citation\\n  -- remains useful only where no omission of that same range was observed.\\n  let missing := result.offers.foldl (fun ranges offer => match offer.fact with\\n    | .used value => if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed then ranges.insert value.source else ranges\\n    | _ => ranges) ({} : Std.HashSet Range)\\n  return {result with offers := result.offers.filter fun offer => match offer.fact with\\n    | .used value => value.kind != .deliveredThenCited || !missing.contains value.source\\n    | _ => true}\\n\\n/-- Pin optional index publications once for both memo identity and planning.\\nAn advancing background worker cannot silently change the input mid-request. -/\\nstructure Prepared where\\n  source : PageMap.Snapshot\\n  shared : Option Index.Reader\\n  usage : Option Index.Reader\\n  failure : Option String := none\\n  canonical : Option Plugin.Publication.Client.SourceReference := none\\n  canonicalFailure : Option String := none\\n\\n/-- Read existing authenticated views without selecting a write destination.\\nA read-only profile may reuse DB-owned preparation. Private views remain the\\nfallback when the shared directory is absent or not readable. -/\\ndef readablePrepared? (read : Sidecar.Storage → IO (Option α)) : IO (Option α) := do\\n  for storage in [.database,.user] do\\n    let found ← try read storage catch error => match error with\\n      | .permissionDenied _ _ _ => pure none\\n      | _ => throw error\\n    if found.isSome then return found\\n  return none\\n\\ndef prepare (source : PageMap.Snapshot) (deadline : Option Nat := none) : IO Prepared := do\\n  try\\n    let readDeadline := deadline.getD ((← IO.monoMsNow)+5000)\\n    let (canonical,canonicalFailure) ← try\\n      let prepared ← readablePrepared? fun storage => Plugin.Publication.Client.prepareSource source storage\\n        readDeadline\\n      pure (prepared,if prepared.isNone then some \\\"canonical-not-ready\\\" else none)\\n      catch error => pure (none,some s!\\\"canonical-open: {error}\\\")\\n    return {\\n      source := source,shared := ← readablePrepared? fun storage => Index.open? source storage .shared\\n      usage := ← Index.open? source .user .usage,canonical,canonicalFailure}\\n  catch error => return {\\n    source := source,shared := none,usage := none,failure := some s!\\\"index-open: {error}\\\"}\\n\\ndef Prepared.identity (prepared : Prepared) : Json :=\\n  toJson (implementation,prepared.source.head.identity, prepared.source.head.authority,\\n    prepared.shared.map (·.index.head), prepared.usage.map (·.index.head), prepared.failure,\\n    prepared.canonical.map (·.identity),prepared.canonicalFailure,CanonicalSource.Delivery.implementation)\\n\\ndef Prepared.collect (prepared : Prepared) (answers : Array (String × Nat)) (query : String)\\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\\n  if prepared.failure.isSome then return {complete := false, available := false, failure := prepared.failure}\\n  let some shared := prepared.shared | return {available := false}\\n  try _root_.Eggshell.Synapses.Recommend.collect shared prepared.usage answers #[] query deadline limits consumers\\n  catch error => return {\\n    complete := false, index := some shared.index.head, usage := prepared.usage.map (·.index.head)\\n    failure := some s!\\\"index-read: {error}\\\"}\\n\\n/-- Locate a recommendation only inside an already hydrated original owner.\\nFingerprint/range matching never creates a new owner or a control Match. -/\\nstructure Located where\\n  offer : Offer\\n  source : Range\\n  target : offer.target = .range source\\n  row : Read\\n  within : source.contains row.source = true\\n\\ndef locate (offers : Array Offer) (rows : Array Read) : Array Located := Id.run do\\n  let mut found := #[]\\n  for offer in offers do\\n    let .range source := offer.target | continue\\n    if target : offer.target = .range source then\\n      let matching := rows.filter (source.contains ·.source)\\n      unless covered source (matching.map (·.source)) do continue\\n      for row in matching do\\n        if within : source.contains row.source = true then found := found.push ⟨offer,source,target,row,within⟩\\n  return found\\n\\ntheorem Located.same_subject (located : Located) :\\n    located.source.subject = located.row.source.subject := by\\n  have within := located.within\\n  simp only [Range.contains, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at within\\n  exact within.1.1\\n\\nstructure LocatedOutput (doc : Extraction.Document) where\\n  offer : Offer\\n  fragment : ObservationContext.Fragment doc\\n  target : offer.target = .output fragment.occurrence\\n\\ndef locateOutputsUsing (offers : Array Offer) (database : String)\\n    (prepared : ObservationContext.Prepared doc) : Array (LocatedOutput doc) :=\\n  offers.filterMap fun offer => do\\n    let .output _ := offer.target | none\\n    let .consumed edge := offer.fact | none\\n    let fragment ← prepared.locate? database edge\\n    if target : offer.target = .output fragment.occurrence then some ⟨offer,fragment,target⟩ else none\\n\\ndef locateOutputs (offers : Array Offer) (database : String) (doc : Extraction.Document) : Array (LocatedOutput doc) :=\\n  (ObservationContext.prepare? doc).map (locateOutputsUsing offers database) |>.getD #[]\\n\\nend Eggshell.Synapses.Recommend\\n\",[[\"SynapseRecommend.lean\",\"module\\n\\npublic import Eggshell.SynapseIndex\\npublic import Eggshell.SynapseUsage\\npublic import Eggshell.ObservationContext\\npublic import Eggshell.CanonicalSourceCache\\npublic import Eggshell.CanonicalSourceDelivery\\npublic import Eggshell.PublicationClient\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Recommend\\nopen Lean DB\\n\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.observation-recommendation\\\".toUTF8 [\\n  (include_str \\\"SynapseRecommend.lean\\\").toUTF8,(include_str \\\"ObservationContext.lean\\\").toUTF8,\\n  (include_str \\\"JsonScalars.lean\\\").toUTF8,(include_str \\\"SynapseTransport.lean\\\").toUTF8,\\n  (include_str \\\"SynapseUsage.lean\\\").toUTF8,(include_str \\\"SynapticTransport.lean\\\").toUTF8,\\n  (include_str \\\"SynapticRoutingStore.lean\\\").toUTF8])\\n\\nstructure Offer where\\n  target : Target\\n  priority : Nat\\n  fact : Fact\\n  identity : String\\n  identity_exact : identity = Index.contentKey fact\\n  valid : fact.valid = true\\n  witness : carries fact target = true\\n\\ndef Offer.check? (target : Target) (priority : Nat) (fact : Fact)\\n    (identity : {value : String // value = Index.contentKey fact}) : Option Offer :=\\n  if valid : fact.valid = true then\\n    if witness : carries fact target = true then\\n      some ⟨target, priority, fact, identity.val, identity.property, valid, witness⟩ else none\\n  else none\\n\\ntheorem Offer.consumption_row (offer : Offer) (edge : Consumption) (kind : offer.fact = .consumed edge)\\n    (source : Range) (target : offer.target = .range source) : source ∈ edge.rows := by\\n  have witness := offer.witness\\n  rw [kind,target] at witness\\n  exact Array.mem_of_contains_eq_true witness\\n\\ntheorem Offer.usage_is_evidence (offer : Offer) (usage : Usage) (kind : offer.fact = .used usage) :\\n    (usage.kind = .omittedThenRead ∨ usage.kind = .omittedThenConsumed) ∨ usage.kind = .deliveredThenCited := by\\n  have witness := offer.witness\\n  cases target : offer.target <;> simp_all [carries, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq]\\n\\ntheorem Offer.output_has_producer (offer : Offer) (producer : Occurrence)\\n    (target : offer.target = .output producer) :\\n    ∃ edge, offer.fact = .consumed edge ∧ edge.producer = producer := by\\n  have witness := offer.witness\\n  cases kind : offer.fact <;> simp_all [carries,beq_iff_eq]\\n\\ndef Offer.kind (offer : Offer) : String := match offer.fact with\\n  | .supports _ => \\\"support\\\"\\n  | .consumed _ => \\\"consumption\\\"\\n  | .coquoted _ _ => \\\"coquotation\\\"\\n  | .used usage => usage.kind.label\\n  | .read _ => \\\"unavailable\\\"\\n\\ndef Offer.json (offer : Offer) : Json := Json.mkObj [\\n  (\\\"target\\\", toJson offer.target), (\\\"source\\\", toJson offer.target.source?), (\\\"priority\\\", toJson offer.priority),\\n  (\\\"kind\\\", toJson offer.kind), (\\\"evidence\\\", toJson offer.identity)]\\n\\nstructure Limits where\\n  requests : Nat := 256\\n  facts : Nat := 8192\\n  bytes : Nat := 8*1024*1024\\n\\nstructure Task where\\n  key : Index.Key\\n  priority : Nat\\n\\nstructure Result where\\n  offers : Array Offer := #[]\\n  requests : Nat := 0\\n  facts : Nat := 0\\n  bytes : Nat := 0\\n  complete : Bool := true\\n  available : Bool := true\\n  index : Option PageMap.Head := none\\n  usage : Option PageMap.Head := none\\n  failure : Option String := none\\n\\n/-- A partial walk never changes the original packet. Its receipt still\\nreports incompleteness rather than presenting an empty successful search. -/\\ndef Result.admitted (result : Result) : Array Offer :=\\n  if result.complete && result.available && result.failure.isNone then result.offers else #[]\\n\\ntheorem Result.incomplete_not_admitted (result : Result) (incomplete : result.complete = false) :\\n    result.admitted = #[] := by simp [admitted, incomplete]\\n\\ntheorem Result.failed_not_admitted (result : Result) (failed : result.failure.isSome = true) :\\n    result.admitted = #[] := by\\n  cases found : result.failure <;> simp_all [admitted]\\n\\ndef Result.receipt (result : Result) : Json := Json.mkObj [\\n  (\\\"available\\\", toJson result.available), (\\\"complete\\\", toJson result.complete),\\n  -- An exception can occur after successful reads. Do not report those\\n  -- interrupted counters as zero observed operations.\\n  (\\\"requests\\\", if result.failure.isSome then Json.null else toJson result.requests),\\n  (\\\"facts\\\", if result.failure.isSome then Json.null else toJson result.facts),\\n  (\\\"bytes\\\", if result.failure.isSome then Json.null else toJson result.bytes),\\n  (\\\"failure\\\", toJson result.failure),\\n  (\\\"index\\\", toJson result.index), (\\\"usage\\\", toJson result.usage),\\n  (\\\"offers\\\", toJson (result.admitted.map Offer.json))]\\n\\ndef Result.stamp (result : Result) : String := Index.contentKey result.receipt\\n\\ndef addOffer (result : Result) (target : Target) (priority : Nat) (fact : Fact)\\n    (identity : {value : String // value = Index.contentKey fact}) : Result :=\\n  match Offer.check? target priority fact identity with\\n  | none => result\\n  | some offer => {result with offers := result.offers.push offer}\\n\\n/-- Priority is inherited from the original nomination. Coquotation expands\\none incidence hop; only reverse consumption is recursive. No score fitting,\\nwhole-producer fallback, graph mutation or certification occurs here. -/\\ndef collect (shared : Index.Reader) (usage : Option Index.Reader)\\n    (answers : Array (String × Nat)) (initial : Array Range) (query : String)\\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\\n  let database := shared.manifest.source.identity\\n  let mut roots := answers.map fun (answer, priority) => ({key := .answer database answer, priority} : Task)\\n  roots := roots ++ initial.map (fun source => ⟨.quoted source, 0⟩)\\n  roots := roots ++ consumers.map (fun (consumer,priority) => ⟨.consumer consumer,priority⟩)\\n  if usage.isSome && digest query then roots := roots.push ⟨.query query, 0⟩\\n  roots := roots.qsort fun a b =>\\n    if a.priority == b.priority then (toJson a.key).compress < (toJson b.key).compress\\n    else a.priority < b.priority\\n  let mut nextRoot := 0\\n  let mut queue : Array Task := #[]\\n  let mut position := 0\\n  let mut seen : Array Index.Key := #[]\\n  let mut result : Result := {index := some shared.index.head, usage := usage.map (·.index.head)}\\n  -- Descendants inherit their root's priority. Exhaust each root's FIFO\\n  -- closure before the next root, rather than repeatedly sorting a growing\\n  -- fanout. First visitation therefore retains the best nominated priority.\\n  repeat\\n    if position == queue.size then\\n      let some root := roots[nextRoot]? | break\\n      nextRoot := nextRoot+1\\n      queue := #[root]\\n      position := 0\\n    let some task := queue[position]? | break\\n    position := position+1\\n    if (← IO.monoMsNow) ≥ deadline then\\n      result := {result with complete := false}\\n      break\\n    if seen.contains task.key then continue\\n    if result.requests ≥ limits.requests || result.facts ≥ limits.facts || result.bytes ≥ limits.bytes ||\\n        (← IO.monoMsNow) ≥ deadline then\\n      result := {result with complete := false}\\n      break\\n    seen := seen.push task.key\\n    let reader := match task.key with | .query _ => usage.getD shared | _ => shared\\n    let found ← reader.lookup task.key (limits.facts-result.facts) deadline (some (limits.bytes-result.bytes))\\n    result := {result with\\n      requests := result.requests+1\\n      facts := result.facts+found.checked.size\\n      bytes := result.bytes+found.payloadBytes}\\n    if !found.complete then result := {result with complete := false}; break\\n    for checked in found.checked do\\n      let fact := checked.fact\\n      let identity : {value : String // value = Index.contentKey fact} := ⟨Index.contentKey fact, rfl⟩\\n      match task.key, fact with\\n      | .answer .., .supports support =>\\n        result := addOffer result (.range support.source) task.priority fact identity\\n        queue := queue.push ⟨.group (.claim support.claim), task.priority⟩\\n        queue := queue.push ⟨.consumer support.read.occurrence, task.priority⟩\\n        queue := queue.push ⟨.quoted support.source, task.priority⟩\\n      | .consumer _, .consumed edge =>\\n        if edge.rows.isEmpty then\\n          result := addOffer result (.output edge.producer) task.priority fact identity\\n        for source in edge.rows do\\n          result := addOffer result (.range source) task.priority fact identity\\n          queue := queue.push ⟨.quoted source, task.priority⟩\\n        queue := queue.push ⟨.consumer edge.producer, task.priority⟩\\n      | .quoted _, .coquoted group _ =>\\n        queue := queue.push ⟨.group group, task.priority⟩\\n      | .group _, .coquoted _ source =>\\n        result := addOffer result (.range source) task.priority fact identity\\n      | .query _, .used value =>\\n        if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed || value.kind == .deliveredThenCited then\\n          result := addOffer result (.range value.source) task.priority fact identity\\n          queue := queue.push ⟨.quoted value.source, task.priority⟩\\n      | _, _ => pure ()\\n  -- A checked omission is the more direct observation. Positive citation\\n  -- remains useful only where no omission of that same range was observed.\\n  let missing := result.offers.foldl (fun ranges offer => match offer.fact with\\n    | .used value => if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed then ranges.insert value.source else ranges\\n    | _ => ranges) ({} : Std.HashSet Range)\\n  return {result with offers := result.offers.filter fun offer => match offer.fact with\\n    | .used value => value.kind != .deliveredThenCited || !missing.contains value.source\\n    | _ => true}\\n\\n/-- Pin optional index publications once for both memo identity and planning.\\nAn advancing background worker cannot silently change the input mid-request. -/\\nstructure Prepared where\\n  source : PageMap.Snapshot\\n  shared : Option Index.Reader\\n  usage : Option Index.Reader\\n  failure : Option String := none\\n  canonical : Option Plugin.Publication.Client.SourceReference := none\\n  canonicalFailure : Option String := none\\n\\n/-- Read existing authenticated views without selecting a write destination.\\nA read-only profile may reuse DB-owned preparation. Private views remain the\\nfallback when the shared directory is absent or not readable. -/\\ndef readablePrepared? (read : Sidecar.Storage → IO (Option α)) : IO (Option α) := do\\n  for storage in [.database,.user] do\\n    let found ← try read storage catch error => match error with\\n      | .permissionDenied _ _ _ => pure none\\n      | _ => throw error\\n    if found.isSome then return found\\n  return none\\n\\ndef prepare (source : PageMap.Snapshot) (deadline : Option Nat := none) : IO Prepared := do\\n  try\\n    let readDeadline := deadline.getD ((← IO.monoMsNow)+5000)\\n    let (canonical,canonicalFailure) ← try\\n      let prepared ← readablePrepared? fun storage => Plugin.Publication.Client.prepareSource source storage\\n        readDeadline\\n      pure (prepared,if prepared.isNone then some \\\"canonical-not-ready\\\" else none)\\n      catch error => pure (none,some s!\\\"canonical-open: {error}\\\")\\n    return {\\n      source := source,shared := ← readablePrepared? fun storage => Index.open? source storage .shared\\n      usage := ← Index.open? source .user .usage,canonical,canonicalFailure}\\n  catch error => return {\\n    source := source,shared := none,usage := none,failure := some s!\\\"index-open: {error}\\\"}\\n\\ndef Prepared.identity (prepared : Prepared) : Json :=\\n  toJson (implementation,prepared.source.head.identity, prepared.source.head.authority,\\n    prepared.shared.map (·.index.head), prepared.usage.map (·.index.head), prepared.failure,\\n    prepared.canonical.map (·.identity),prepared.canonicalFailure,CanonicalSource.Delivery.implementation)\\n\\ndef Prepared.collect (prepared : Prepared) (answers : Array (String × Nat)) (query : String)\\n    (deadline : Nat) (limits : Limits := {}) (consumers : Array (Occurrence × Nat) := #[]) : IO Result := do\\n  if prepared.failure.isSome then return {complete := false, available := false, failure := prepared.failure}\\n  let some shared := prepared.shared | return {available := false}\\n  try _root_.Eggshell.Synapses.Recommend.collect shared prepared.usage answers #[] query deadline limits consumers\\n  catch error => return {\\n    complete := false, index := some shared.index.head, usage := prepared.usage.map (·.index.head)\\n    failure := some s!\\\"index-read: {error}\\\"}\\n\\n/-- Locate a recommendation only inside an already hydrated original owner.\\nFingerprint/range matching never creates a new owner or a control Match. -/\\nstructure Located where\\n  offer : Offer\\n  source : Range\\n  target : offer.target = .range source\\n  row : Read\\n  within : source.contains row.source = true\\n\\ndef locate (offers : Array Offer) (rows : Array Read) : Array Located := Id.run do\\n  let mut found := #[]\\n  for offer in offers do\\n    let .range source := offer.target | continue\\n    if target : offer.target = .range source then\\n      let matching := rows.filter (source.contains ·.source)\\n      unless covered source (matching.map (·.source)) do continue\\n      for row in matching do\\n        if within : source.contains row.source = true then found := found.push ⟨offer,source,target,row,within⟩\\n  return found\\n\\ntheorem Located.same_subject (located : Located) :\\n    located.source.subject = located.row.source.subject := by\\n  have within := located.within\\n  simp only [Range.contains, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at within\\n  exact within.1.1\\n\\nstructure LocatedOutput (doc : Extraction.Document) where\\n  offer : Offer\\n  fragment : ObservationContext.Fragment doc\\n  target : offer.target = .output fragment.occurrence\\n\\ndef locateOutputsUsing (offers : Array Offer) (database : String)\\n    (prepared : ObservationContext.Prepared doc) : Array (LocatedOutput doc) :=\\n  offers.filterMap fun offer => do\\n    let .output _ := offer.target | none\\n    let .consumed edge := offer.fact | none\\n    let fragment ← prepared.locate? database edge\\n    if target : offer.target = .output fragment.occurrence then some ⟨offer,fragment,target⟩ else none\\n\\ndef locateOutputs (offers : Array Offer) (database : String) (doc : Extraction.Document) : Array (LocatedOutput doc) :=\\n  (ObservationContext.prepare? doc).map (locateOutputsUsing offers database) |>.getD #[]\\n\\nend Eggshell.Synapses.Recommend\\n\"],[\"ObservationContext.lean\",\"module\\n\\npublic import Eggshell.SynapseSource\\npublic import Eggshell.Sha256\\npublic import Eggshell.SynapseQuotes\\npublic import tools.LiteralSearch\\npublic import Eggshell.QuotationContext\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.ObservationContext\\nopen Lean Extraction\\n\\n/-- Plain text keeps its actual row. Structured data uses checked scalar\\nmembers and ancestor paths, rather than copying the enclosing object. -/\\ndef lineBounds (lines : Array TextLine) (first limit : Nat) : Nat × Nat := Id.run do\\n  let mut lower := 0\\n  let mut upper := lines.size\\n  while lower < upper do\\n    let middle := (lower+upper)/2\\n    let some line := lines[middle]? | return (first,limit)\\n    if line.limit < limit then lower := middle+1 else upper := middle\\n  match lines[lower]? with\\n  | some line => if line.first ≤ first && limit ≤ line.limit then (line.first,line.limit) else (first,limit)\\n  | none => (first,limit)\\n\\ndef originalSubject (work raw : String) : Original := ⟨work,Sha256.hex raw.toUTF8,raw.length⟩\\n\\n/-- The original identity requires hashing once, not JSON/command parsing.\\nThe same pinned native observation can then bind any valid stored interval. -/\\nstructure OriginalOwner (doc : Document) where\\n  raw : String\\n  original : doc.source = some raw\\n  identity : Original\\n  identityExact : identity = originalSubject doc.work raw\\n  native : doc.native = true\\n\\ndef OriginalOwner.prepare? (doc : Document) : Option (OriginalOwner doc) := do\\n  let raw ← doc.source\\n  if original : doc.source = some raw then\\n    if native : doc.native = true then some ⟨raw,original,originalSubject doc.work raw,rfl,native⟩ else none\\n  else none\\n\\nstructure OriginalOwner.Bound (owner : OriginalOwner doc) (database : String) (source : Range) where\\n  read : Read\\n  valid : read.valid = true\\n  sourceExact : read.source = source\\n  databaseExact : read.binding.database = database\\n  ownerExact : read.binding.owner = doc.owner\\n  workExact : read.binding.work = doc.work\\n  nativeOrigin : doc.occurrences.contains read.occurrence = true\\n  sourceIdentity : source.subject = .original owner.identity\\n  withinOriginal : read.binding.limit ≤ owner.raw.length\\n  firstExact : read.binding.first = source.first-1\\n  limitExact : read.binding.limit = source.last\\n\\ndef OriginalOwner.bind (owner : OriginalOwner doc) (database : String) (source : Range) :\\n    Array (owner.Bound database source) := Id.run do\\n  if sourceIdentity : source.subject = .original owner.identity then\\n    if sourceValid : source.valid = true then\\n      have inBounds : source.last ≤ owner.raw.length := by\\n        have checked := sourceValid\\n        simp only [Range.valid,sourceIdentity,Bool.and_eq_true,decide_eq_true_eq] at checked\\n        simpa [owner.identityExact,originalSubject] using checked.2\\n      let mut result := #[]\\n      for occurrence in doc.occurrences do\\n        let read : Read := ⟨occurrence,source,⟨database,doc.owner,doc.work,source.first-1,source.last⟩,#[]⟩\\n        if valid : read.valid = true then\\n          if origin : doc.occurrences.contains occurrence = true then\\n            result := result.push ⟨read,valid,rfl,rfl,rfl,rfl,origin,sourceIdentity,inBounds,rfl,rfl⟩\\n      return result\\n    else return #[]\\n  else return #[]\\n\\ntheorem OriginalOwner.Bound.same_native_owner {doc : Document} {owner : OriginalOwner doc}\\n    {database : String} {source : Range} (bound : owner.Bound database source) :\\n    bound.read.binding.owner = doc.owner ∧ bound.read.binding.work = doc.work ∧\\n      doc.occurrences.contains bound.read.occurrence = true :=\\n  ⟨bound.ownerExact,bound.workExact,bound.nativeOrigin⟩\\n\\ntheorem OriginalOwner.Bound.same_requested_range {doc : Document} {owner : OriginalOwner doc}\\n    {database : String} {source : Range} (bound : owner.Bound database source) :\\n    bound.read.source = source ∧ bound.read.binding.first = source.first-1 ∧\\n      bound.read.binding.limit = source.last := ⟨bound.sourceExact,bound.firstExact,bound.limitExact⟩\\n\\nstructure Prepared (doc : Document) where\\n  raw : String\\n  original : doc.source = some raw\\n  view : Layout\\n  mapped : layout raw = .ok view\\n  rawChars : Array Char\\n  rawCharsExact : rawChars = raw.toList.toArray\\n  viewChars : Array Char\\n  viewCharsExact : viewChars = view.text.toList.toArray\\n  lines : Array TextLine\\n  identity : Original\\n  identityExact : identity = originalSubject doc.work raw\\n  json : Option (JsonScalars.Index raw)\\n\\ndef prepare? (doc : Document) : Option (Prepared doc) := do\\n  let raw ← doc.source\\n  if original : doc.source = some raw then\\n    match mapped : layout raw with\\n    | .error _ => none\\n    | .ok view => some ⟨raw,original,view,mapped,raw.toList.toArray,rfl,\\n        view.text.toList.toArray,rfl,textLines view.text,originalSubject doc.work raw,rfl,JsonScalars.prepare? raw⟩\\n  else none\\n\\ndef Prepared.rawBounds (prepared : Prepared doc) (edge : Consumption) :\\n    Option (Nat × Nat × JsonScalars.Address prepared.raw) := do\\n  let index ← prepared.json\\n  let address ← index.witness? edge.outputFirst edge.outputLimit\\n  let scalar := address.leaf.scalar\\n  if edge.kind == .value then\\n    if edge.outputFirst != scalar.first || edge.outputLimit != scalar.limit then none\\n    else some (scalar.contextFirst,scalar.limit,address)\\n  else if let some text := scalar.text then\\n    if text.contains '\\\\n' then do\\n      let first ← scalar.offsets.findIdx? (· == edge.outputFirst)\\n      let limit ← scalar.offsets.findIdx? (· == edge.outputLimit)\\n      let (first,limit) := lineBounds (textLines text) first limit\\n      let first ← scalar.offsets[first]?\\n      let limit ← scalar.offsets[limit]?\\n      some (first,limit,address)\\n    else some (scalar.contextFirst,scalar.limit,address)\\n  else some (scalar.contextFirst,scalar.limit,address)\\n\\nstructure Fragment (doc : Document) where\\n  occurrence : Occurrence\\n  binding : Binding\\n  raw : String\\n  payload : String\\n  address : Option (JsonScalars.Address raw)\\n  native : doc.native = true\\n  origin : doc.occurrences.contains occurrence = true\\n  original : doc.source = some raw\\n  owner : binding.owner = doc.owner\\n  work : binding.work = doc.work\\n  valid : binding.valid = true\\n  within : binding.first < binding.limit ∧ binding.limit ≤ raw.length\\n  exact : payload = String.ofList ((raw.toList.drop binding.first).take (binding.limit-binding.first))\\n\\n/-- Resolve only an actual producer and a literal saved output witness. Source\\nfiles, shell syntax and line numbers are not prerequisites. -/\\ndef Prepared.locate? (prepared : Prepared doc) (database : String) (edge : Consumption) : Option (Fragment doc) := do\\n  if native : doc.native = true then\\n    if origin : doc.occurrences.contains edge.producer = true then\\n        let raw := prepared.raw\\n        let view := if edge.outputFormat == .json then prepared.rawChars else prepared.viewChars\\n        if !(literal view edge.outputFirst edge.outputLimit edge.term) then none else do\\n          let (first,limit,address) ← if edge.outputFormat == .json then do\\n              let (first,limit,address) ← prepared.rawBounds edge\\n              if first ≤ edge.outputFirst && edge.outputLimit ≤ limit then some (first,limit,some address) else none\\n            else do\\n              let (first,limit) := lineBounds prepared.lines edge.outputFirst edge.outputLimit\\n              if !(first ≤ edge.outputFirst && edge.outputLimit ≤ limit) then none else do\\n                let first ← prepared.view.offsets[first]?\\n                let limit ← prepared.view.offsets[limit]?\\n                some (first,limit,prepared.json.bind (·.cover? first limit))\\n          do\\n            let binding : Binding := ⟨database,doc.owner,doc.work,first,limit⟩\\n            if valid : binding.valid = true then\\n              if bounded : binding.first < binding.limit ∧ binding.limit ≤ prepared.rawChars.size then\\n                have size : prepared.rawChars.size = raw.length := by\\n                  simp [prepared.rawCharsExact,raw,String.length_toList]\\n                have within : binding.first < binding.limit ∧ binding.limit ≤ raw.length := by\\n                  simpa only [size] using bounded\\n                let payload := String.ofList (prepared.rawChars.extract binding.first binding.limit).toList\\n                have exact : payload = String.ofList ((raw.toList.drop binding.first).take (binding.limit-binding.first)) := by\\n                  simp [payload,prepared.rawCharsExact,raw]\\n                some ⟨edge.producer,binding,raw,\\n                  payload,address,native,origin,prepared.original,rfl,rfl,valid,within,exact⟩\\n              else none\\n            else none\\n    else none\\n  else none\\n\\ndef locate? (database : String) (doc : Document) (edge : Consumption) : Option (Fragment doc) := do\\n  let prepared ← prepare? doc\\n  prepared.locate? database edge\\n\\ntheorem fragment_is_original (fragment : Fragment doc) :\\n    doc.source = some fragment.raw ∧\\n    fragment.payload = String.ofList ((fragment.raw.toList.drop fragment.binding.first).take\\n      (fragment.binding.limit-fragment.binding.first)) := ⟨fragment.original,fragment.exact⟩\\n\\ntheorem fragment_has_native_origin (fragment : Fragment doc) :\\n    doc.native = true ∧ doc.occurrences.contains fragment.occurrence = true :=\\n  ⟨fragment.native,fragment.origin⟩\\n\\n/-- Canonical data is independent of the occurrence that observed it. The\\nactual origin remains in the binding and can never certify another Work. -/\\ndef Fragment.read? (fragment : Fragment doc) : Option {read : Read // read.valid = true} :=\\n  let source := Range.original (originalSubject fragment.binding.work fragment.raw)\\n    fragment.binding.first fragment.binding.limit\\n  let read : Read := {occurrence := fragment.occurrence,source,binding := fragment.binding}\\n  if valid : read.valid = true then some ⟨read,valid⟩ else none\\n\\n/-- Resolve a stored canonical interval only against the same complete\\nWork/output snapshot, then attach this observation's own native origin. -/\\ndef Prepared.bindSource? (prepared : Prepared doc) (database : String) (source : Range) : Option Read := do\\n  let .original original := source.subject | none\\n  if !doc.native || original != prepared.identity || !source.valid then none else do\\n    let occurrence ← doc.occurrences[0]?\\n    let read : Read := {occurrence,source,binding := ⟨database,doc.owner,doc.work,source.first-1,source.last⟩}\\n    if read.valid then some read else none\\n\\ndef bindSource? (database : String) (doc : Document) (source : Range) : Option Read := do\\n  let prepared ← prepare? doc\\n  prepared.bindSource? database source\\n\\n/-- Transient spellings are hydrated from the original owner. Only their\\ndigests travel with a persisted Read; hash lookup alone never creates support. -/\\nstructure Quotation where\\n  read : Read\\n  text : String\\n  mapping : Option (Sigma fun source : QuotationContext.Source => QuotationContext.Projection source text) := none\\n  anchor : Option (Nat × Nat) := none\\n\\ndef Prepared.quotationSource (prepared : Prepared doc) : QuotationContext.Source :=\\n  ⟨prepared.raw,prepared.rawChars,prepared.rawCharsExact,prepared.identity.content,by\\n    simpa [originalSubject] using congrArg Original.content prepared.identityExact⟩\\n\\ndef Quotation.prepare (source : QuotationContext.Source) (read : Read)\\n    (first limit : Nat) (text : String) : Quotation :=\\n  ⟨read,text,(QuotationContext.prepare? source first limit text).map (fun projection => ⟨source,projection⟩),none⟩\\n\\nstructure QuotationWitness (parent : Read) where\\n  read : Read\\n  first : Nat\\n  limit : Nat\\n  valid : read.valid = true\\n  sourceWithin : parent.source.contains read.source = true\\n  bindingWithin : parent.binding.first ≤ read.binding.first ∧ read.binding.limit ≤ parent.binding.limit\\n  origin : read.occurrence = parent.occurrence ∧ read.binding.database = parent.binding.database ∧\\n    read.binding.owner = parent.binding.owner ∧ read.binding.work = parent.binding.work\\n\\ndef Quotation.locate? (item : Quotation) (first limit : Nat) : Option (QuotationWitness item.read) := do\\n  let ⟨source,projection⟩ ← item.mapping\\n  let located ← projection.locate? first limit\\n  let a := if projection.multiline then located.contextFirst else item.read.binding.first\\n  let b := if projection.multiline then located.contextLimit else item.read.binding.limit\\n  if !(a ≤ located.first && located.limit ≤ b && b ≤ source.characters.size) then none else do\\n    let target ← match item.read.source.subject with\\n      | .file _ => some item.read.source\\n      | .original original =>\\n        if original.content == source.fingerprint && original.chars == source.characters.size then\\n          some (Range.original original a b) else none\\n    let read : Read := {item.read with\\n      source := target,binding := {item.read.binding with first := a,limit := b}\\n      quotations := #[Quotes.digest (String.ofList (projection.characters.extract first limit).toList)]}\\n    if valid : read.valid = true then\\n      if inside : item.read.source.contains read.source = true then\\n        if bounds : item.read.binding.first ≤ read.binding.first ∧ read.binding.limit ≤ item.read.binding.limit then\\n          some ⟨read,located.first,located.limit,valid,inside,bounds,by exact ⟨rfl,rfl,rfl,rfl⟩⟩\\n        else none\\n      else none\\n    else none\\n\\ntheorem quotation_witness_preserves_origin {read : Read} (witness : QuotationWitness read) :\\n    witness.read.occurrence = read.occurrence ∧ witness.read.binding.database = read.binding.database ∧\\n      witness.read.binding.owner = read.binding.owner ∧ witness.read.binding.work = read.binding.work := witness.origin\\n\\n/-- Scan the actual reachable record spellings for all of an answer's literal\\nquotes together. A matching identifier may occur inside a row/member; it need\\nnot equal the entire enclosing record. Duplicate aliases do not multiply a\\nread's support. These are advisory citations, never execution certificates. -/\\ndef quoteMatches (index : LiteralSearch.Index patterns) (spellings : Array Quotation) : Array Quotation := Id.run do\\n  let mut seen : Std.HashMap (Occurrence × String × String × String × Nat × Nat × String) Nat := {}\\n  let mut result := #[]\\n  for item in spellings do\\n    for hit in LiteralSearch.first index item.text do\\n      let text := patterns[hit.pattern]\\n      let witness := item.locate? hit.first hit.limit\\n      let read := witness.map (·.read) |>.getD item.read\\n      let anchor := witness.map (fun found => (found.first,found.limit))\\n      let first := anchor.map Prod.fst |>.getD read.binding.first\\n      let limit := anchor.map Prod.snd |>.getD read.binding.limit\\n      let key := (read.occurrence,read.binding.database,read.binding.owner,read.binding.work,first,limit,text)\\n      let next : Quotation := ⟨read,text,none,anchor⟩\\n      if let some previous := seen[key]? then\\n        let some prior := result[previous]? | continue\\n        let width := read.binding.limit-read.binding.first\\n        let oldWidth := prior.read.binding.limit-prior.read.binding.first\\n        if width < oldWidth || (width == oldWidth && read.source.file?.isSome && prior.read.source.file?.isNone) then\\n          result := result.set! previous next\\n      else\\n        seen := seen.insert key result.size\\n        result := result.push next\\n  return result\\n\\nstructure Catalog where\\n  located : Array LocatedRead := #[]\\n  quotations : Array Quotation := #[]\\n\\ndef Catalog.reads (catalog : Catalog) : Array Read := catalog.located.map (·.read)\\n\\n/-- Certified source rows have disjoint original intervals. Search their\\nsorted limits once, instead of scanning the growing native catalog per row. -/\\ndef fileCovers (rows : Array Read) (first limit : Nat) : Bool := Id.run do\\n  let mut lower := 0\\n  let mut upper := rows.size\\n  while lower < upper do\\n    let middle := (lower+upper)/2\\n    let some row := rows[middle]? | return false\\n    if row.binding.limit < limit then lower := middle+1 else upper := middle\\n  return (rows[lower]?).any (fun row => row.binding.first ≤ first && limit ≤ row.binding.limit)\\n\\ndef Catalog.add (catalog : Catalog) (prepared : Prepared doc) (database : String)\\n    (files : Array Read) (first limit : Nat) (spellings : Array String) : Catalog := Id.run do\\n  if !doc.native || first ≥ limit || limit > prepared.rawChars.size then return catalog\\n  -- Preserve an existing certified file row instead of giving it a second,\\n  -- larger native identity. General data never requires such certification.\\n  if fileCovers files first limit then return catalog\\n  let some occurrence := doc.occurrences[0]? | return catalog\\n  let spellings := spellings.filter (!·.isEmpty) |>.toList.eraseDups.toArray\\n  let read : Read := {\\n    occurrence,source := Range.original prepared.identity first limit\\n    binding := ⟨database,doc.owner,doc.work,first,limit⟩\\n    quotations := spellings.map Quotes.digest |>.toList.eraseDups.toArray}\\n  if !read.valid then return catalog\\n  let payload := String.ofList (prepared.rawChars.extract first limit).toList\\n  return {\\n    located := catalog.located.push ⟨read,#[⟨read.source,first,limit⟩],#[read],payload⟩\\n    quotations := catalog.quotations ++ spellings.map (fun text =>\\n      Quotation.prepare prepared.quotationSource read first limit text)}\\n\\n/-- Enumerate source members/rows once during indexing, independently of tool\\nnames, command syntax and the presence of files. The immutable subject hash,\\nJSON scan and character arrays are shared across all these spans. -/\\ndef Prepared.catalog (prepared : Prepared doc) (database : String) : Catalog := Id.run do\\n  let mut catalog : Catalog := {located := (recordedReads database doc).toOption.getD #[]}\\n  let files := (catalog.located.flatMap (·.originalRows)).qsort (fun a b => a.binding.limit < b.binding.limit)\\n  if let some index := prepared.json then\\n    for leaf in index.leaves do\\n      let scalar := leaf.scalar\\n      let member := String.ofList (prepared.rawChars.extract scalar.contextFirst scalar.limit).toList\\n      let aliases := #[scalar.literal,member] ++ scalar.text.toArray\\n      catalog := catalog.add prepared database files scalar.contextFirst scalar.limit aliases\\n      if let some text := scalar.text then\\n        if text.contains '\\\\n' then\\n          for line in textLines text do\\n            let some first := scalar.offsets[line.first]? | continue\\n            let some limit := scalar.offsets[line.limit]? | continue\\n            let raw := String.ofList (prepared.rawChars.extract first limit).toList\\n            catalog := catalog.add prepared database files first limit #[line.text,raw]\\n    if index.leaves.isEmpty then\\n      catalog := catalog.add prepared database files 0 prepared.rawChars.size #[prepared.raw]\\n  else\\n    for line in textLines prepared.raw do\\n      let payload := String.ofList (prepared.rawChars.extract line.first line.limit).toList\\n      catalog := catalog.add prepared database files line.first line.limit #[line.text,payload]\\n  return catalog\\n\\ndef recorded (database : String) (doc : Document) : Option Catalog := do\\n  return (← prepare? doc).catalog database\\n\\n/-- File certification remains optional. General rows are located only when\\nthe actual completed call has the complete saved invocation and output. -/\\ndef locateUsing (database : String) (doc : Document) (trace : Trace)\\n    (catalog : Catalog) : Array LocatedRead := Id.run do\\n  let mut result := (locateReads database doc trace).toOption.getD #[]\\n  let some raw := doc.source | return result\\n  let .ok (input,format) := invocationData (doc.workText.getD \\\"\\\") | return result\\n  let native := catalog.located.filter (·.read.source.file?.isNone)\\n  for occurrence in doc.occurrences do\\n    let some started := trace.starts[occurrence]? | continue\\n    if started.command != input || started.format != format || trace.finished[occurrence]? != some raw then continue\\n    for located in native do\\n      let read := {located.read with occurrence}\\n      result := result.push {located with read,originalRows := #[read]}\\n  return result\\n\\ndef locate (database : String) (doc : Document) (trace : Trace) : Array LocatedRead :=\\n  locateUsing database doc trace ((recorded database doc).getD {})\\n\\n/-- Exact quoted spellings provide advisory support/coquotation. The caller\\nrestricts the catalog to the answer's actual All-reachable source owners.\\nThis records an observed citation, not the truth or causality of a claim. -/\\ndef addQuotedAnswer (database : String) (doc : Document) (spellings : Array Quotation)\\n    (graph : Graph) : Except String Graph := do\\n  let decoded ← layout (doc.source.getD \\\"\\\")\\n  let byText := spellings.foldl (fun (map : Std.HashMap String (Array Read)) item =>\\n    map.insert item.text (map[item.text]?.getD #[] |>.push item.read)) {}\\n  let mut graph := graph\\n  let mut position := 0\\n  for paragraph in decoded.text.splitOn \\\"\\\\n\\\\n\\\" do\\n    let limit := position+paragraph.length\\n    if position < limit then\\n      let claim : Claim := ⟨database,doc.owner,decoded.offsets[position]!,decoded.offsets[limit]!⟩\\n      for quote in Quotes.extract paragraph do\\n        for read in byText[quote.text]?.getD #[] do\\n          graph ← graph.insert (.read read)\\n          let support ← Support.checked read read.source claim\\n          graph ← graph.insert (.supports support)\\n          graph ← graph.insert (.coquoted (.claim claim) read.source)\\n          graph ← graph.insert (.coquoted (.answer database doc.owner) read.source)\\n    position := limit+2\\n  return graph\\n\\nend Eggshell.Synapses.ObservationContext\\n\"],[\"JsonScalars.lean\",\"module\\n\\npublic import Lean.Data.Json.Parser\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.JsonScalars\\nopen Lean\\n\\ninductive Segment where\\n  | key (name : String)\\n  | index (position : Nat)\\n  deriving DecidableEq, BEq, ToJson, FromJson\\n\\ndef pathJson (path : List Segment) : Json :=\\n  toJson (path.map fun part => match part with\\n    | .key name => toJson name | .index position => toJson position)\\n\\ndef resolve (value : Json) : List Segment → Except String Json\\n  | [] => .ok value\\n  | .key name :: rest => do resolve (← value.getObjVal? name) rest\\n  | .index position :: rest => do resolve (← value.getArrVal? position) rest\\n\\nstructure Scalar where\\n  first : Nat\\n  limit : Nat\\n  literal : String\\n  text : Option String\\n  offsets : Array Nat\\n  /-- Reversed paths share their ancestors instead of copying every prefix. -/\\n  pathRev : List Segment\\n  contextFirst : Nat\\n\\nstructure Frame where\\n  object : Bool\\n  pathRev : List Segment\\n  next : Nat := 0\\n  key : Option (String × Nat) := none\\n\\ndef place (frames : Array Frame) (first : Nat) :\\n    Except String (List Segment × Nat × Array Frame) := do\\n  let some frame := frames.back? | return ([],first,frames)\\n  if frame.object then\\n    let some (key,start) := frame.key | throw \\\"structured object has no pending key\\\"\\n    return (.key key :: frame.pathRev,start,frames.pop.push {frame with key := none})\\n  else\\n    return (.index frame.next :: frame.pathRev,first,\\n      frames.pop.push {frame with next := frame.next+1})\\n\\ndef primitive : Json → Bool\\n  | .arr _ | .obj _ => false\\n  | _ => true\\n\\ndef scalarLiteral (text : String) : Bool :=\\n  (Json.parse text).toOption.any fun value => primitive value && value.compress == text\\n\\n/-- One canonical scan records literal coordinates, immediate member starts\\nand shared ancestor paths. Keys provide context but never become witnesses. -/\\ndef scan (json : Json) (raw : String) : Except String (Array Scalar) := do\\n  unless json.compress == raw do throw \\\"noncanonical structured observation\\\"\\n  let chars := raw.toList.toArray\\n  let mut position := 0\\n  let mut result := #[]\\n  let mut frames : Array Frame := #[]\\n  while position < chars.size do\\n    let char := chars[position]!\\n    if char == '{' || char == '[' then\\n      let (path,_,next) ← place frames position\\n      frames := next.push {object := char == '{',pathRev := path}\\n      position := position+1\\n    else if char == '}' || char == ']' then\\n      frames := frames.pop\\n      position := position+1\\n    else if char.isWhitespace || \\\",:\\\".contains char then\\n      position := position+1\\n    else if char == '\\\"' then\\n      let first := position\\n      position := position+1\\n      let mut escaped := false\\n      let mut closed := false\\n      while position < chars.size do\\n        let char := chars[position]!\\n        position := position+1\\n        if escaped then escaped := false\\n        else if char == '\\\\\\\\' then escaped := true\\n        else if char == '\\\"' then closed := true; break\\n      unless closed do throw \\\"unfinished structured string\\\"\\n      let limit := position\\n      let mut following := position\\n      while following < chars.size && chars[following]!.isWhitespace do following := following+1\\n      let literal := String.ofList (chars.extract first limit).toList\\n      let text ← Json.parse literal >>= Json.getStr?\\n      if chars[following]? == some ':' then\\n        let some frame := frames.back? | throw \\\"structured key has no object\\\"\\n        unless frame.object && frame.key.isNone do throw \\\"structured key outside an object\\\"\\n        frames := frames.pop.push {frame with key := some (text,first)}\\n        continue\\n      let (path,contextFirst,next) ← place frames first\\n      frames := next\\n      let mut offsets := #[]\\n      let mut original := first+1\\n      for char in text.toList do\\n        offsets := offsets.push original\\n        original := original+(toJson (String.singleton char)).compress.length-2\\n      offsets := offsets.push original\\n      unless original+1 == limit do throw \\\"structured scalar coordinates differ\\\"\\n      result := result.push ⟨first,limit,literal,some text,offsets,path,contextFirst⟩\\n    else\\n      let first := position\\n      while position < chars.size && !chars[position]!.isWhitespace &&\\n          !(\\\"{}[],:\\\".contains chars[position]!) do position := position+1\\n      let literal := String.ofList (chars.extract first position).toList\\n      unless scalarLiteral literal do throw \\\"invalid structured scalar\\\"\\n      let (path,contextFirst,next) ← place frames first\\n      frames := next\\n      result := result.push ⟨first,position,literal,none,#[],path,contextFirst⟩\\n  return result\\n\\ndef values (raw : String) : Except String (Array Scalar) := do scan (← Json.parse raw) raw\\n\\ndef Scalar.prefixExact (scalar : Scalar) (raw : Array Char) : Bool :=\\n  match scalar.pathRev.head? with\\n  | some (.key name) =>\\n      String.ofList (raw.extract scalar.contextFirst scalar.first).toList ==\\n        (toJson name).compress ++ \\\":\\\"\\n  | _ => scalar.contextFirst == scalar.first\\n\\n/-- A displayed path is independently checked against the parsed original.\\nIts member prefix and literal still refer to exact original characters. -/\\nstructure Checked (root : Json) (raw : Array Char) where\\n  scalar : Scalar\\n  value : Json\\n  resolved : resolve root scalar.pathRev.reverse = .ok value\\n  primitive : primitive value = true\\n  spelling : value.compress = scalar.literal\\n  bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size\\n  exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal\\n  memberExact : scalar.prefixExact raw = true\\n\\ndef Checked.check? (root : Json) (raw : Array Char) (scalar : Scalar) : Option (Checked root raw) :=\\n  match resolved : resolve root scalar.pathRev.reverse with\\n  | .error _ => none\\n  | .ok value =>\\n    if primitive : JsonScalars.primitive value = true then\\n      if spelling : value.compress = scalar.literal then\\n        if bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size then\\n          if exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal then\\n            if memberExact : scalar.prefixExact raw = true then\\n              some ⟨scalar,value,resolved,primitive,spelling,bounds,exact,memberExact⟩ else none\\n          else none\\n        else none\\n      else none\\n    else none\\n\\nstructure Address (raw : String) where\\n  root : Json\\n  characters : Array Char\\n  parsed : Json.parse raw = .ok root\\n  charactersExact : characters = raw.toList.toArray\\n  leaf : Checked root characters\\n\\ndef Address.path (address : Address raw) : List Segment := address.leaf.scalar.pathRev.reverse\\n\\ndef Address.label (address : Address raw) : String := (pathJson address.path).compress\\n\\ntheorem address_resolves (address : Address raw) :\\n    Json.parse raw = .ok address.root ∧ resolve address.root address.path = .ok address.leaf.value :=\\n  ⟨address.parsed,address.leaf.resolved⟩\\n\\ntheorem address_literal_is_original (address : Address raw) :\\n    String.ofList (raw.toList.toArray.extract address.leaf.scalar.first address.leaf.scalar.limit).toList =\\n      address.leaf.value.compress := by\\n  rw [← address.charactersExact,address.leaf.spelling]\\n  exact address.leaf.exact\\n\\nstructure Index (raw : String) where\\n  root : Json\\n  characters : Array Char\\n  parsed : Json.parse raw = .ok root\\n  charactersExact : characters = raw.toList.toArray\\n  leaves : Array (Checked root characters)\\n\\ndef prepare? (raw : String) : Option (Index raw) := do\\n  match parsed : Json.parse raw with\\n  | .error _ => none\\n  | .ok root =>\\n    let scalars ← (scan root raw).toOption\\n    let characters := raw.toList.toArray\\n    let leaves ← scalars.mapM (Checked.check? root characters)\\n    return ⟨root,characters,parsed,rfl,leaves⟩\\n\\n/-- Scalar limits are in original serialization order. Search once by the\\nlast position; ancestors and field names do not require a linear leaf scan. -/\\ndef Index.cover? (index : Index raw) (first limit : Nat) : Option (Address raw) := Id.run do\\n  let mut lower := 0\\n  let mut upper := index.leaves.size\\n  while lower < upper do\\n    let middle := (lower+upper)/2\\n    let some leaf := index.leaves[middle]? | return none\\n    if leaf.scalar.limit < limit then lower := middle+1 else upper := middle\\n  let some leaf := index.leaves[lower]? | return none\\n  if leaf.scalar.contextFirst ≤ first && first < limit && limit ≤ leaf.scalar.limit then\\n    return some ⟨index.root,index.characters,index.parsed,index.charactersExact,leaf⟩\\n  return none\\n\\ndef Index.witness? (index : Index raw) (first limit : Nat) : Option (Address raw) := do\\n  let address ← index.cover? first limit\\n  if address.leaf.scalar.first ≤ first then some address else none\\n\\nend Eggshell.JsonScalars\\n\"],[\"SynapseTransport.lean\",\"module\\n\\npublic import Eggshell.SynapticTransport\\npublic import tools.KeyPostings\\npublic import Eggshell.HashDistinct\\npublic import Eggshell.SynapticBindings\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Transport\\nopen Lean Persistence.Store _root_.Eggshell.Synapses.Extraction Recommend\\n\\nstructure Owner where\\n  database : String\\n  original : OutcomeEdge\\n  provenance : List SourceEvidence.Record\\n\\ndef Owner.document (owner : Owner) : Except String Document := do\\n  return {\\n    owner := Persistence.selectionKey owner.original.relation\\n    work := Persistence.selectionKey owner.original.work\\n    workText := text? owner.original.work\\n    source := text? owner.original.outcome\\n    native := owner.original.observations.any\\n      (Relation.observesOutcomeWork owner.original.outcome owner.original.work)\\n    occurrences := Provenance.identities owner.original\\n    files := ← fileMap (owner.provenance.toArray.map toJson) }\\n\\nstructure LocatedOwner where\\n  owner : OutcomeEdge\\n  document : Document\\n  located : Array Routed.Located\\n  outputs : Array (LocatedOutput document)\\n\\n/-- Hydration and the original identity are prepared once per admitted owner.\\nBinding a graph interval does not parse or hash the same body again. -/\\nstructure AdmittedOwner where\\n  owner : Owner\\n  document : Document\\n  original : Option (ObservationContext.OriginalOwner document)\\n\\nstructure Observation where\\n  database : String\\n  owner : String\\n  work : String\\n  occurrence : Occurrence\\n  age : ObservationAge.Assessment\\n  metadataFailure : Option String := none\\n  deriving ToJson\\n\\nstructure Plan where\\n  results : Array Routed.Result := #[]\\n  owners : Array LocatedOwner := #[]\\n  documents : Array Document := #[]\\n  rows : Array Read := #[]\\n  unsupported : Nat := 0\\n  unlocatedFileOwners : Nat := 0\\n  observations : Array Observation := #[]\\n  canonical : Std.HashMap String (Array CanonicalSource.StoredRow) := {}\\n  canonicalReuse : Array (String × CanonicalSource.Shared.Reuse × CanonicalSource.Shared.Reuse) := #[]\\n  canonicalFailure : Array (String × String) := #[]\\n  originalViews : Std.HashMap String ObservedRecordView.View := {}\\n  bindingComplete : Bool := true\\n  bindingRequests : Nat := 0\\n  bindingBytes : Nat := 0\\n  bindingUnresolved : Nat := 0\\n\\ndef Plan.complete (plan : Plan) : Bool := plan.bindingComplete && plan.results.all (·.complete)\\n\\n/-- An exact source-posting origin can be attached only to this already\\nadmitted owner. Stored offsets are still bounded by its original body and\\nthe native occurrence; the index cannot nominate another Work here. -/\\ndef boundTo (database : String) (document : Document) (identity : Original) (read : Read) : Bool :=\\n  document.native && read.valid && read.binding.database == database &&\\n    read.binding.owner == document.owner && read.binding.work == document.work &&\\n    document.occurrences.contains read.occurrence && read.binding.limit ≤ identity.chars &&\\n    match read.source.subject with\\n    | .original original => original == identity\\n    | .file file => document.files.contains file\\n\\ndef Plan.ranges (plan : Plan) : List (Value × List (Nat × Nat × Nat)) :=\\n  plan.owners.toList.map fun owner =>\\n    (owner.owner.relation, (owner.located.toList.filterMap fun located =>\\n      if located.source.file?.isNone then none else some\\n      (located.offer.priority, located.row.binding.first, located.row.binding.limit)).eraseDups)\\n\\nstructure OutputRange where\\n  priority : Nat\\n  first : Nat\\n  limit : Nat\\n  path : Option (List JsonScalars.Segment)\\n  deriving BEq\\n\\ndef LocatedOwner.originalRanges (owner : LocatedOwner) : Array (Range × OutputRange) := Id.run do\\n  let raw := owner.document.source.getD \\\"\\\"\\n  let json := JsonScalars.prepare? raw\\n  return owner.located.filterMap fun located => do\\n    let .original _ := located.source.subject | none\\n    some (located.source,{\\n      priority := located.offer.priority\\n      first := located.row.binding.first\\n      limit := located.row.binding.limit\\n      path := (json.bind (·.cover? located.row.binding.first located.row.binding.limit)).map (·.path)})\\n\\ndef Plan.outputRanges (plan : Plan) : List (Value × List OutputRange) := Id.run do\\n  let mut originals : Std.HashMap Range (Value × OutputRange) := {}\\n  for owner in plan.owners do\\n    for (source,range) in owner.originalRanges do\\n      if (originals[source]?).all (fun prior => range.priority < prior.2.priority) then\\n        originals := originals.insert source (owner.owner.relation,range)\\n  return plan.owners.toList.map fun owner =>\\n    let shared := originals.toArray.filterMap fun (_,origin,range) =>\\n      if origin == owner.owner.relation then some range else none\\n    let shared := shared.qsort fun a b => if a.first == b.first then a.limit < b.limit else a.first < b.first\\n    (owner.owner.relation, ((owner.outputs.toList.map fun located =>\\n      ({priority := located.offer.priority,first := located.fragment.binding.first\\n        limit := located.fragment.binding.limit,path := located.fragment.address.map (·.path)} : OutputRange)) ++\\n      shared.toList).eraseDups)\\n\\n/-- Original intervals bind to their immutable native output identity; file\\ncoordinates bind through the existing source postings. A graph hint cannot\\nnominate a different Work, occurrence or out-of-body interval. -/\\ndef build (prepared : Array Recommend.Prepared) (answers : Array (String × Nat))\\n    (owners : Array Owner) (query : String) (deadline : Nat)\\n    (graphDeadline : Option Nat := none) : IO Plan := do\\n  let mut plan : Plan := {}\\n  let mut outputWitnesses : Array (String × Array Offer) := #[]\\n  let assessedUnixMs ← ObservationAge.now\\n  for source in prepared do\\n    let consumers := owners.flatMap fun owner =>\\n      if owner.database != source.source.head.identity then #[] else\\n      let priorities := answers.filterMap fun (key,priority) =>\\n        if key == Persistence.selectionKey owner.original.relation then some priority else none\\n      (Provenance.identities owner.original).flatMap fun occurrence =>\\n        priorities.map fun priority => (occurrence,priority)\\n    let result ← Routed.collect source answers query (min deadline (graphDeadline.getD deadline)) consumers\\n    let (result,outputs) ← try pure (result,← Routed.outputOffers source result deadline)\\n      catch error => pure ({result with complete := false,failure := some s!\\\"output-witness: {error}\\\"},#[])\\n    outputWitnesses := outputWitnesses.push (source.source.head.identity,outputs)\\n    plan := {plan with results := plan.results.push result}\\n  let offers := plan.results.flatMap (·.admitted)\\n  let mut admitted : Array AdmittedOwner := #[]\\n  let mut originals : Std.HashMap (String × Original) (List Nat) := {}\\n  for owner in owners do\\n    let .ok document := owner.document | plan := {plan with unsupported := plan.unsupported+1}; continue\\n    let original := ObservationContext.OriginalOwner.prepare? document\\n    if let some original := original then\\n      let key := (owner.database,original.identity)\\n      originals := originals.insert key (admitted.size :: (originals[key]?.getD []))\\n    admitted := admitted.push ⟨owner,document,original⟩\\n  -- Prepend in the directory. Appending to a shared array here repeatedly\\n  -- copies a growing owner's complete row list.\\n  let mut origins : Std.HashMap (String × String) (List Routed.Located) := {}\\n  for (source,result) in prepared.zip plan.results do\\n    let database := source.source.head.identity\\n    let scopedOffers := result.admitted\\n    let wanted := (hashDistinct (scopedOffers.toList.filterMap fun hint => do\\n      let range ← hint.target.source?\\n      let .file _ := range.subject | none\\n      some range)).toArray\\n    let allowed := admitted.foldl (fun allowed item =>\\n      if item.owner.database == database && item.document.native then\\n        allowed.insert item.document.owner else allowed) ({} : Std.HashSet String)\\n    let resolved ← if wanted.isEmpty then pure ({} : IndexedBindings.Resolved)\\n      else if let some index := source.shared then IndexedBindings.resolve index wanted allowed deadline\\n      else pure {complete := false,unresolved := wanted.size}\\n    plan := {plan with\\n      bindingComplete := plan.bindingComplete && resolved.complete\\n      bindingRequests := plan.bindingRequests+resolved.requests\\n      bindingBytes := plan.bindingBytes+resolved.bytes\\n      bindingUnresolved := plan.bindingUnresolved+resolved.unresolved}\\n    let mut unresolved : Std.HashSet Range := {}\\n    for offer in scopedOffers do\\n      let .range target := offer.target | continue\\n      if exact : offer.target = .range target then\\n        let mut rows := #[]\\n        match target.subject with\\n        | .file _ => rows := resolved.rows[target]?.getD #[]\\n        | .original identity =>\\n          for index in originals[(database,identity)]?.getD [] do\\n            let some item := admitted[index]? | continue\\n            let some original := item.original | continue\\n            rows := rows ++ (original.bind database target).map (·.read)\\n          if rows.isEmpty then unresolved := unresolved.insert target\\n        for row in rows do\\n          if contained : target.contains row.source = true then\\n            let located : Routed.Located := ⟨offer,target,exact,row,contained⟩\\n            let key := (database,row.binding.owner)\\n            origins := origins.insert key (located :: (origins[key]?.getD []))\\n    plan := {plan with bindingUnresolved := plan.bindingUnresolved+unresolved.size}\\n  -- One scoped acquisition serves graph binding and the final renderer.\\n  -- A graph resource limit cannot erase independently verified source rows.\\n  for source in prepared do\\n    if let some reference := source.canonical then\\n      try\\n        let ids := owners.filterMap fun owner =>\\n          if owner.database == source.source.head.identity then\\n            some (Persistence.selectionKey owner.original.relation) else none\\n        let found ← Plugin.Publication.Client.sourceRows reference ids deadline\\n        let reuse := (source.source.head.identity,reference.access.reuse,found.reuse)\\n        plan := {plan with canonicalReuse := plan.canonicalReuse.push reuse}\\n        for (owner,rows) in found.rows do\\n          let merged ← IO.ofExcept (CanonicalSource.Delivery.merge ((plan.canonical[owner]?.getD #[]) ++ rows))\\n          plan := {plan with canonical := if merged.isEmpty then plan.canonical.erase owner\\n            else plan.canonical.insert owner merged}\\n        let storedOriginals ← Plugin.Publication.Client.sourceRecords reference ids deadline\\n        for (owner,view) in storedOriginals do\\n          if let some view := view then\\n            plan := {plan with originalViews := plan.originalViews.insert owner view}\\n      catch error =>\\n        let failure := (source.source.head.identity,error.toString)\\n        plan := {plan with canonicalFailure := plan.canonicalFailure.push failure}\\n  if offers.isEmpty then return plan\\n  -- Query-invariant across owners. Computing this same ordered set inside\\n  -- each owner was quadratic work repeated for every hydrated observation.\\n  for item in admitted do\\n    if (← IO.monoMsNow) ≥ deadline then\\n      return {plan with results := plan.results.map fun result =>\\n        {result with complete := false,failure := some \\\"binding-deadline\\\"}}\\n    let owner := item.owner\\n    let document := item.document\\n    let located := (origins[(owner.database,document.owner)]?.getD []).reverse.toArray.filter fun located =>\\n      item.original.any (fun original => boundTo owner.database document original.identity located.row)\\n    let rows := (hashDistinct (located.toList.map (·.row))).toArray\\n    let witnesses := outputWitnesses.flatMap fun (database,offers) =>\\n      if database == owner.database then offers else #[]\\n    let context := if witnesses.isEmpty then none else ObservationContext.prepare? document\\n    let outputs := context.map (Recommend.locateOutputsUsing witnesses owner.database) |>.getD #[]\\n    -- Metadata is fetched only for offered native origins, once per occurrence,\\n    -- with a fixed cap and the existing request deadline. It cannot block or\\n    -- filter the historical body when unavailable, expired, or clock-skewed.\\n    if !located.isEmpty || !outputs.isEmpty then\\n      for occurrence in document.occurrences do\\n        if plan.observations.any (fun prior => prior.database == owner.database &&\\n            prior.owner == document.owner && prior.occurrence == occurrence) then continue\\n        let (receivedUnixMs,metadataFailure) ←\\n          if plan.observations.size ≥ 256 || (← IO.monoMsNow) ≥ deadline then\\n            pure (none,some \\\"metadata-budget\\\")\\n          else if let some source := prepared.find? (·.source.head.identity == owner.database) then\\n            try\\n              let origin ← Provenance.lookup? source.source owner.original occurrence\\n              pure (origin.bind (·.receivedUnixMs),if origin.isNone then some \\\"unrecorded\\\" else none)\\n            catch _ => pure (none,some \\\"metadata-unverified\\\")\\n          else pure (none,some \\\"source-unavailable\\\")\\n        plan := {plan with observations := plan.observations.push {\\n          database := owner.database,owner := document.owner,work := document.work,occurrence\\n          age := ObservationAge.assess assessedUnixMs receivedUnixMs,metadataFailure}}\\n    plan := {plan with\\n      documents := plan.documents.push document\\n      rows := plan.rows ++ rows\\n      unlocatedFileOwners := plan.unlocatedFileOwners +\\n        if !document.files.isEmpty && located.isEmpty then 1 else 0\\n      owners := plan.owners.push ⟨owner.original,document,located,outputs⟩}\\n  return plan\\n\\ndef Plan.receiptWith (plan : Plan) (delivery : Extraction.Presentation) : Json :=\\n  let bindings := KeyPostings.prepare (·.source) (plan.owners.flatMap (·.located))\\n  let originals := ((plan.results.flatMap (·.admitted)).toList.filterMap fun offer => do\\n    let source ← offer.target.source?\\n    let .original _ := source.subject | none\\n    some source) |> hashDistinct |>.toArray\\n  Json.mkObj [\\n    (\\\"complete\\\", toJson plan.complete), (\\\"unsupportedOwners\\\", toJson plan.unsupported),\\n    (\\\"bindingComplete\\\",toJson plan.bindingComplete),(\\\"bindingRequests\\\",toJson plan.bindingRequests),\\n    (\\\"bindingBytes\\\",toJson plan.bindingBytes),(\\\"bindingUnresolved\\\",toJson plan.bindingUnresolved),\\n    (\\\"unlocatedFileOwners\\\",toJson plan.unlocatedFileOwners),\\n    (\\\"observationAges\\\",toJson plan.observations),\\n    (\\\"inputs\\\", toJson (plan.results.map Routed.Result.receipt)),\\n    (\\\"originalReferences\\\",toJson (originals.map fun source =>\\n      let bindings := (bindings.lookup source).map (·.row.binding)\\n      let origins := bindings.foldl (fun known binding => known.insert binding) ({} : Std.HashSet Binding)\\n      let origins := origins.toArray.qsort fun a b => (toJson a).compress < (toJson b).compress\\n      Json.mkObj [\\n      (\\\"source\\\",toJson source), (\\\"bodyDelivered\\\",toJson (covered source delivery.ranges)),\\n      (\\\"origins\\\",toJson origins)])),\\n    (\\\"originalOutputs\\\",toJson (plan.owners.flatMap fun owner => owner.outputs.map fun located =>\\n      Json.mkObj [\\n        (\\\"evidence\\\",toJson located.offer.identity), (\\\"binding\\\",toJson located.fragment.binding),\\n        (\\\"path\\\",toJson (located.fragment.address.map (fun address => JsonScalars.pathJson address.path))),\\n        (\\\"bodyDelivered\\\",toJson (delivery.coversBinding located.fragment.binding)),\\n        (\\\"addressDelivered\\\",toJson (located.fragment.address.map (fun address =>\\n          delivery.coversAddress located.fragment.binding address.path)))])),\\n    (\\\"offers\\\", toJson (plan.results.flatMap fun result => result.admitted.map fun offer =>\\n      let delivered := match offer.target with\\n        | .range source => covered source delivery.ranges\\n        | .output _ => plan.owners.any fun owner => owner.outputs.any fun located =>\\n            located.offer.identity == offer.evidence && delivery.coversBinding located.fragment.binding\\n      Json.mkObj [(\\\"offer\\\", offer.json), (\\\"bodyDelivered\\\", toJson delivered)]))]\\n\\ndef Plan.receipt (plan : Plan) (text : String) : Json :=\\n  plan.receiptWith (Extraction.presented text plan.documents plan.rows)\\n\\nend Eggshell.Synapses.Transport\\n\"],[\"SynapseUsage.lean\",\"module\\n\\npublic import Eggshell.SynapseSource\\npublic import tools.SpanPostings\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Extraction\\nopen Lean\\n\\nstructure Presentation where\\n  ranges : Array Range := #[]\\n  uncertain : Std.HashSet File := {}\\n  bindings : Array (String × Nat × Nat) := #[]\\n  uncertainOwners : Std.HashSet String := {}\\n  addressed : Array (String × Nat × Nat × List JsonScalars.Segment) := #[]\\n\\ndef caption (text : String) : Option (Nat × Nat × Bool) := do\\n  if !text.startsWith \\\"  ORIGINAL CHARS [\\\" && !text.startsWith \\\"  CHARS [\\\" then none else do\\n    let parts := text.splitOn \\\"CHARS [\\\"\\n    let rest ← parts[1]?\\n    let bounds ← (rest.splitOn \\\")\\\").head?\\n    let [first, limit] := bounds.splitOn \\\",\\\" | none\\n    let first ← first.toNat?\\n    let limit ← limit.toNat?\\n    if first < limit then some (first, limit, text.endsWith \\\" decoded\\\") else none\\n\\ndef scalarSlice (raw : String) (first limit : Nat) : Option String :=\\n  if first < limit && limit ≤ raw.length then\\n    some (String.ofList ((raw.toList.drop first).take (limit-first))) else none\\n\\nstructure SharedSpelling where\\n  file : File\\n  number : Nat\\n  code : String\\n  origins : Array (String × String × String × Occurrence)\\n\\n/-- Decode only complete shared frames. This grants no original-byte status;\\ncallers must bind each spelling to their saved original rows. -/\\ndef sharedSpellings (body : String) : Array SharedSpelling := Id.run do\\n  let wrapper := \\\"EGGSHELL SHARED SOURCE DATA\\\\nOriginal recorded file data; advisory, not a completed operation.\\\\n\\\"\\n  let mut found : Array SharedSpelling := #[]\\n  for packet in (body.splitOn wrapper).tail do\\n    let parts := packet.splitOn \\\"END EGGSHELL SHARED SOURCE DATA\\\\n\\\"\\n    if parts.length < 2 then continue\\n    for block in ((\\\"\\\\n\\\" ++ parts.head!).splitOn \\\"\\\\nSOURCE \\\").tail do\\n      let parts := block.splitOn \\\"\\\\nEND SOURCE\\\"\\n      if parts.length < 2 then continue\\n      let suffix := parts[1]!\\n      if !suffix.isEmpty && !suffix.startsWith \\\"\\\\n\\\" then continue\\n      let fileLine :: originsLine :: \\\"CODE\\\" :: codeLines := parts.head!.splitOn \\\"\\\\n\\\" | continue\\n      let some file := (Json.parse fileLine >>= fromJson? (α := File)).toOption | continue\\n      if !file.valid || !originsLine.startsWith \\\"ORIGINAL READS \\\" then continue\\n      let encoded := String.ofList (originsLine.toList.drop \\\"ORIGINAL READS \\\".length)\\n      let some origins := (Json.parse encoded >>= fromJson? (α := Array String)).toOption | continue\\n      let origins := origins.filterMap fun origin =>\\n        (Json.parse origin >>= fromJson? (α := String × String × String × Occurrence)).toOption\\n      for line in codeLines do\\n        let some (number,code) := numbered line | continue\\n        found := found.push ⟨file,number,code,origins⟩\\n  return found\\n\\n/-- A shared spelling can report only a range belonging to an original saved\\nrow. Sharing the payload never manufactures another execution witness. -/\\nstructure SharedWitness (reads : Array Read) where\\n  row : Read\\n  original : row ∈ reads\\n  file : File\\n  number : Nat\\n  code : String\\n  sourceExact : row.source = ⟨file,number,number⟩\\n\\ntheorem SharedWitness.original_range (witness : SharedWitness reads) :\\n    ∃ row ∈ reads, row.source = ⟨witness.file,witness.number,witness.number⟩ :=\\n  ⟨witness.row,witness.original,witness.sourceExact⟩\\n\\n/-- A file alias can cover just its original code bytes, without a numbered\\nprefix. JSON escaping changes representation, never the saved code spelling. -/\\nstructure SharedCode (original : String) where\\n  text : String\\n  exact : text = original ∨\\n    String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original\\n\\ndef sharedCodes (original : String) : Array (SharedCode original) := Id.run do\\n  let mut result := #[⟨original,Or.inl rfl⟩]\\n  if let some text := (Json.parse (\\\"\\\\\\\"\\\" ++ original ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption then\\n    if same : String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original then\\n      if text != original then result := result.push ⟨text,Or.inr same⟩\\n  return result\\n\\ntheorem SharedCode.original_spelling (code : SharedCode original) :\\n    code.text = original ∨\\n      String.ofList ((toJson code.text).compress.toList.drop 1 |>.dropLast) = original := code.exact\\n\\n/-- Recognize the producer's shared file frame, then compare every displayed\\ncode row with its raw scalar coordinates and declared DB/owner/Work/occurrence.\\nLocation-only notices and arbitrary matching prose cannot label delivery. -/\\ndef sharedPresented (body : String) (docs : Array Document) (reads : Array Read) :\\n    Array (SharedWitness reads) := Id.run do\\n  let displayed := sharedSpellings body\\n  if displayed.isEmpty || reads.isEmpty then return #[]\\n  let mut index : Std.HashMap (File × Nat × String) (Array (SharedWitness reads)) := {}\\n  let byOwner := reads.attach.foldl (fun found saved =>\\n    found.insert saved.val.binding.owner\\n      ((found.getD saved.val.binding.owner #[]).push saved))\\n    ({} : Std.HashMap String (Array {row // row ∈ reads}))\\n  for doc in docs do\\n    if !doc.native then continue\\n    let some raw := doc.source | continue\\n    let characters := raw.toList.toArray\\n    for saved in byOwner.getD doc.owner #[] do\\n      let row := saved.val\\n      if !row.valid || row.binding.work != doc.work || !doc.occurrences.contains row.occurrence then continue\\n      let .file file := row.source.subject | continue\\n      if row.source.first != row.source.last then continue\\n      if !(row.binding.first < row.binding.limit && row.binding.limit ≤ characters.size) then continue\\n      let original := String.ofList (characters.extract row.binding.first row.binding.limit).toList\\n      for code in sharedCodes original do\\n        if code.text.isEmpty || code.text.contains '\\\\n' || code.text.contains '\\\\r' then continue\\n        if same : row.source = ⟨file,row.source.first,row.source.first⟩ then\\n          let witness : SharedWitness reads := ⟨row,saved.property,file,row.source.first,code.text,same⟩\\n          let key := (file,row.source.first,code.text)\\n          index := index.insert key ((index.getD key #[]).push witness)\\n    let .ok decoded := layout raw | continue\\n    let spanOf := fun (saved : {row // row ∈ reads}) =>\\n      if saved.val.valid && saved.val.binding.work == doc.work then\\n        some (saved.val.binding.first,saved.val.binding.limit) else none\\n    let spans := SpanPostings.prepare spanOf (byOwner.getD doc.owner #[]).toList\\n    for line in textLines decoded.text do\\n      let some (number,code) := numbered line.text | continue\\n      for saved in spans.lookup (decoded.offsets[line.first]!,decoded.offsets[line.limit]!) do\\n        let row := saved.val\\n        let .file file := row.source.subject | continue\\n        if same : row.source = ⟨file,number,number⟩ then\\n          let witness : SharedWitness reads := ⟨row,saved.property,file,number,code,same⟩\\n          let key := (file,number,code)\\n          index := index.insert key ((index.getD key #[]).push witness)\\n  let mut found := #[]\\n  for spelling in displayed do\\n    for witness in index.getD (spelling.file,spelling.number,spelling.code) #[] do\\n      let row := witness.row\\n      if spelling.origins.contains (row.binding.database,row.binding.owner,row.binding.work,row.occurrence) then\\n        found := found.push witness\\n  return found\\n\\n/-- Verify actual packet bytes against immutable raw coordinates before labelling. -/\\ndef presented (body : String) (docs : Array Document) (reads : Array Read) : Presentation := Id.run do\\n  let mut result : Presentation := {}\\n  for part in body.splitOn \\\"\\\\nWORK GRAPH \\\" do\\n    let some owner := (part.splitOn \\\"\\\\n\\\").head? | continue\\n    let some doc := docs.find? (·.owner == owner) | continue\\n    let some raw := doc.source | continue\\n    let blocks := part.splitOn \\\"  GROUNDED OUTCOME\\\\n\\\"\\n    let some evidence := blocks[1]? | continue\\n    let evidence := (evidence.splitOn \\\"  TRACE\\\\n\\\").head!\\n    let json := JsonScalars.prepare? raw\\n    let rawChars := match json with | some index => index.characters | none => raw.toList.toArray\\n    let evidenceChars := evidence.toList.toArray\\n    let mut spans := #[]\\n    let mut addressed := #[]\\n    let mut path : Option String := none\\n    let mut bad := false\\n    for line in textLines evidence do\\n      if line.text.startsWith \\\"  JSON PATH \\\" then\\n        path := some (String.ofList (line.text.toList.drop \\\"  JSON PATH \\\".length))\\n        continue\\n      let some (first, limit, decoded) := caption line.text | continue\\n      let location := json.bind (·.cover? first limit)\\n      let declared := path\\n      path := none\\n      if declared.isSome && !location.any (fun address => declared == some address.label) then\\n        bad := true\\n        continue\\n      if !(first < limit && limit ≤ rawChars.size) then bad := true; continue\\n      let segment := String.ofList (rawChars.extract first limit).toList\\n      let marker := \\\"  DECODED JSON STRING DATA\\\\n\\\"\\n      let marked := literal evidenceChars line.limit (line.limit+marker.length) marker\\n      let expected := if decoded || marked then\\n          (Json.parse (\\\"\\\\\\\"\\\" ++ segment ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption\\n        else some segment\\n      let some expected := expected | bad := true; continue\\n      let dataStart := line.limit + if marked then marker.length else 0\\n      if dataStart+expected.length > evidenceChars.size ||\\n          String.ofList (evidenceChars.extract dataStart (dataStart+expected.length)).toList != expected then\\n        bad := true\\n        continue\\n      spans := spans.push (first, limit)\\n      if let some address := location then\\n        if declared == some address.label then addressed := addressed.push (owner,first,limit,address.path)\\n    if spans.isEmpty then\\n      let decoded := (layout raw).toOption.map (·.text)\\n      if !raw.isEmpty && ((evidence.splitOn raw).length > 1 ||\\n          decoded.any (fun text => !text.isEmpty && (evidence.splitOn text).length > 1)) then\\n        spans := #[(0, raw.length)]\\n      else bad := true\\n    if bad then\\n      result := {result with uncertainOwners := result.uncertainOwners.insert owner}\\n      for file in doc.files do result := {result with uncertain := result.uncertain.insert file}\\n    else\\n      result := {result with\\n        bindings := result.bindings ++ spans.map (fun (a,b) => (owner,a,b))\\n        addressed := result.addressed ++ addressed}\\n    for row in reads do\\n      if row.binding.owner == owner && spans.any (fun (first, limit) =>\\n          first ≤ row.binding.first && row.binding.limit ≤ limit) then\\n        result := {result with ranges := result.ranges.push row.source}\\n  for witness in sharedPresented body docs reads do\\n    result := {result with\\n      ranges := result.ranges.push witness.row.source\\n      bindings := result.bindings.push\\n        (witness.row.binding.owner,witness.row.binding.first,witness.row.binding.limit)}\\n  return result\\n\\ndef Presentation.coversBinding (shown : Presentation) (binding : Binding) : Bool := Id.run do\\n  if shown.uncertainOwners.contains binding.owner then return false\\n  let spans := shown.bindings.filterMap fun (owner,first,limit) =>\\n    if owner == binding.owner then some (first,limit) else none\\n  let spans := spans.qsort fun a b => a.1 < b.1\\n  let covered := spans.foldl (fun position (first,limit) =>\\n    if first ≤ position then max position limit else position) binding.first\\n  return binding.first < binding.limit && binding.limit ≤ covered\\n\\ndef Presentation.coversAddress (shown : Presentation) (binding : Binding) (path : List JsonScalars.Segment) : Bool :=\\n  let bindings := shown.addressed.filterMap fun (owner,first,limit,actual) =>\\n    if actual == path then some (owner,first,limit) else none\\n  {shown with bindings}.coversBinding binding\\n\\ndef compactRanges (ranges : Array Range) : Array Range := Id.run do\\n  let mut files : Std.HashMap Subject (Array Range) := {}\\n  for range in ranges do files := files.insert range.subject (files[range.subject]?.getD #[] |>.push range)\\n  let mut result := #[]\\n  for (_, spans) in files do\\n    let mut merged : Array Range := #[]\\n    for span in spans.qsort (fun a b => a.first < b.first || (a.first == b.first && a.last < b.last)) do\\n      if let some previous := merged.back? then\\n        if span.first ≤ previous.last+1 then\\n          merged := merged.pop.push {previous with last := max previous.last span.last}\\n          continue\\n      merged := merged.push span\\n    result := result ++ merged\\n  return result\\n\\n/-- Stored overlap minus verified delivery; does not expand a citation's line count. -/\\ndef omittedRanges (requested : Range) (stored delivered : Array Range) : Array Range := Id.run do\\n  let mut result : Std.HashSet Range := {}\\n  for saved in compactRanges stored do\\n    if saved.subject != requested.subject then continue\\n    let first := max saved.first requested.first\\n    let last := min saved.last requested.last\\n    if last < first then continue\\n    let relevant := (delivered.filter (·.subject == requested.subject)).toList.mergeSort\\n      (fun a b => a.first ≤ b.first)\\n    let mut position := first\\n    for shown in relevant do\\n      if position > last then break\\n      if shown.last < position then continue\\n      if position < shown.first then\\n        result := result.insert {requested with first := position, last := min last (shown.first-1)}\\n      position := max position (shown.last+1)\\n    if position ≤ last then result := result.insert {requested with first := position, last}\\n  return result.toArray\\n\\nstructure Feedback where\\n  graph : Graph := .empty\\n  delivered : Presentation := {}\\n  atStart : Std.HashMap Occurrence Presentation := {}\\n\\ndef Feedback.present (feedback : Feedback) (packet : Presentation) : Feedback :=\\n  {feedback with delivered := {\\n    ranges := feedback.delivered.ranges ++ packet.ranges\\n    uncertain := feedback.delivered.uncertain.union packet.uncertain\\n    bindings := feedback.delivered.bindings ++ packet.bindings\\n    addressed := feedback.delivered.addressed ++ packet.addressed\\n    uncertainOwners := feedback.delivered.uncertainOwners.union packet.uncertainOwners }}\\n\\n/-- A PreToolUse packet arriving after proposal cannot rewrite what was known. -/\\ndef Feedback.start (feedback : Feedback) (occurrence : Occurrence) : Feedback :=\\n  if feedback.atStart.contains occurrence then feedback else\\n    {feedback with atStart := feedback.atStart.insert occurrence feedback.delivered}\\n\\ndef Feedback.completedRead (feedback : Feedback) (occurrence : Occurrence) (query : String)\\n    (requested stored : Array Range) : Except String Feedback := do\\n  let some earlier := feedback.atStart[occurrence]? | throw \\\"read has no observed start\\\"\\n  let mut graph := feedback.graph\\n  let mut ordinal := 0\\n  for source in compactRanges requested do\\n    let checked := match source.subject with\\n      | .file file => !earlier.uncertain.contains file\\n      | .original _ => earlier.uncertainOwners.isEmpty\\n    let gaps := if checked then omittedRanges source stored earlier.ranges else #[]\\n    for gap in if gaps.isEmpty then #[source] else gaps do\\n      graph ← graph.recordRead ⟨occurrence, ordinal, none⟩ query gap stored earlier.ranges checked\\n      ordinal := ordinal+1\\n  return {feedback with graph}\\n\\ndef Feedback.answer (feedback : Feedback) (occurrence : Occurrence) (query text : String) :\\n    Except String Feedback := do\\n  let files := feedback.delivered.ranges.foldl (fun files range =>\\n    (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n  let cited := paragraphCitations text files.toArray\\n  let mut graph := feedback.graph\\n  for index in [:cited.size] do\\n    graph ← graph.recordCitation ⟨occurrence, index, none⟩ query cited[index]! feedback.delivered.ranges\\n  return {feedback with graph}\\n\\n/-- A native usage label may cover only an actual located consumption witness.\\nThe native row remains tied to its original Work and response digest. -/\\nstructure ConsumedSource (edge : Consumption) where\\n  source : Range\\n  valid : edge.valid = true\\n  native : source.file?.isNone = true\\n  consumed : edge.rows.any (·.contains source) = true\\n\\ndef consumedSource? (edge : Consumption) (source : Range) : Option (ConsumedSource edge) :=\\n  if valid : edge.valid = true then\\n    if native : source.file?.isNone = true then\\n      if consumed : edge.rows.any (·.contains source) = true then\\n        some ⟨source,valid,native,consumed⟩ else none\\n    else none\\n  else none\\n\\ntheorem consumed_source_has_witness (checked : ConsumedSource edge) :\\n    ∃ row ∈ edge.rows, row.contains checked.source = true := by\\n  obtain ⟨index,bound,present⟩ := Array.any_eq_true.mp checked.consumed\\n  exact ⟨edge.rows[index],by simp,present⟩\\n\\ntheorem consumed_source_is_later (checked : ConsumedSource edge) :\\n    edge.producerFinish < edge.consumerStart := by\\n  exact Consumption.checked_before (edge := edge) (accepted := edge)\\n    (by simp [Consumption.checked,checked.valid])\\n\\n/-- Literal reuse is advisory evidence, not proof of semantic necessity. The\\ncaller supplies immutable pre-read stored and ACK ranges; no returned sibling\\nfield is labelled merely because it was present in the tool's response. -/\\ndef consumedUsage? (checked : ConsumedSource edge) (query : String)\\n    (stored delivered : Array Range) : Option Usage :=\\n  if covered checked.source stored && !covered checked.source delivered then some {\\n    event := {occurrence := edge.producer,ordinal := 0,consumption := some ⟨edge.consumer,checked.source⟩}\\n    query,source := checked.source,kind := .omittedThenConsumed}\\n  else none\\n\\ntheorem consumed_omission_requires_stored (checked : ConsumedSource edge)\\n    (observed : consumedUsage? checked query stored delivered = some usage) :\\n    covered checked.source stored = true ∧ covered checked.source delivered = false := by\\n  unfold consumedUsage? at observed\\n  split at observed\\n  next present => simpa only [Bool.and_eq_true,Bool.not_eq_true'] using present\\n  next => contradiction\\n\\ndef recordConsumed (graph : Graph) (checked : ConsumedSource edge) (query : String)\\n    (stored delivered : Array Range) : Except String Graph :=\\n  match consumedUsage? checked query stored delivered with\\n  | some usage => graph.insert (.used usage)\\n  | none => .ok graph\\n\\nend Eggshell.Synapses.Extraction\\n\"],[\"SynapticTransport.lean\",\"module\\n\\npublic import Eggshell.SynapticRoutingStore\\n\\n@[expose] public section\\nnamespace Eggshell.Synapses.Routed\\nopen Lean DB Recommend Routing.Store\\n\\ndef graphDeadline (now deadline : Nat) : Nat :=\\n  min deadline (now+(deadline-now)/4)\\n\\ntheorem graph_deadline_preserves_upstream (now deadline : Nat) :\\n    graphDeadline now deadline ≤ deadline := Nat.min_le_left _ _\\n\\ntheorem graph_deadline_reserves_binding (now deadline : Nat) :\\n    graphDeadline now deadline ≤ now+(deadline-now)/4 := Nat.min_le_right _ _\\n\\nstructure Result where\\n  hints : Array Hint := #[]\\n  nodes : Nat := 0\\n  arcs : Nat := 0\\n  bytes : Nat := 0\\n  complete : Bool := true\\n  available : Bool := true\\n  index : Option PageMap.Head := none\\n  usage : Option PageMap.Head := none\\n  routing : Option PageMap.Head := none\\n  usageRouting : Option PageMap.Head := none\\n  failure : Option String := none\\n\\ndef Result.admitted (result : Result) : Array Hint :=\\n  if result.complete && result.available && result.failure.isNone then result.hints else #[]\\n\\ntheorem Result.incomplete_not_admitted (result : Result) (incomplete : result.complete = false) :\\n    result.admitted = #[] := by simp [Result.admitted,incomplete]\\n\\ndef Result.receipt (result : Result) : Json := Json.mkObj [\\n  (\\\"available\\\",toJson result.available),(\\\"complete\\\",toJson result.complete),\\n  (\\\"requests\\\",toJson result.nodes),(\\\"facts\\\",toJson result.arcs),(\\\"bytes\\\",toJson result.bytes),\\n  (\\\"index\\\",toJson result.index),(\\\"usage\\\",toJson result.usage),\\n  (\\\"routing\\\",toJson result.routing),(\\\"usageRouting\\\",toJson result.usageRouting),\\n  (\\\"failure\\\",toJson result.failure),(\\\"offers\\\",toJson (result.admitted.map Hint.json))]\\n\\ndef preferOmissions (hints : Array Hint) : Array Hint := Id.run do\\n  let missing := hints.foldl (fun sources hint =>\\n    if hint.kind == 3 || hint.kind == 4 then\\n      hint.target.source?.map sources.insert |>.getD sources else sources) ({} : Std.HashSet Range)\\n  return hints.filter fun hint =>\\n    hint.kind != 5 || hint.target.source?.all (fun source => !missing.contains source)\\n\\n/-- Views are opened read-only and must match the already pinned original\\nindex. Missing or stale preparation is explicit; a hook never rebuilds it. -/\\ndef collect (prepared : Recommend.Prepared) (answers : Array (String × Nat))\\n    (query : String) (deadline : Nat) (consumers : Array (Occurrence × Nat)) : IO Result := do\\n  let initial : Result := {index := prepared.shared.map (·.index.head),usage := prepared.usage.map (·.index.head)}\\n  if prepared.failure.isSome then return {initial with complete := false,available := false,failure := prepared.failure}\\n  let some shared := prepared.shared | return {initial with complete := false,available := false,failure := some \\\"source-index-unavailable\\\"}\\n  try\\n    let some routing ← Routing.Store.open? shared |\\n      return {initial with complete := false,available := false,failure := some \\\"routing-unprepared\\\"}\\n    let usage ← prepared.usage.mapM fun original => do\\n      let some view ← Routing.Store.open? original |\\n        throw (IO.userError \\\"private usage routing is unprepared\\\")\\n      pure view\\n    let mut roots := answers.map fun (owner,priority) =>\\n      (Index.Key.answer shared.manifest.source.identity owner,priority)\\n    roots := roots ++ consumers.map (fun (consumer,priority) => (Index.Key.consumer consumer,priority))\\n    if usage.isSome && digest query then roots := roots.push (.query query,0)\\n    let walked ← Routing.Store.walk routing usage roots deadline\\n    return {initial with\\n      hints := preferOmissions walked.hints,nodes := walked.nodes,arcs := walked.arcs,bytes := walked.bytes\\n      complete := walked.complete,routing := some routing.snapshot.head,usageRouting := usage.map (·.snapshot.head)}\\n  catch error => return {initial with complete := false,failure := some s!\\\"routing-read: {error}\\\"}\\n\\n/-- A hint cannot supply coordinates. Original rows independently establish\\nthe range, owner and bytes even if the advisory projection is malformed. -/\\nstructure Located where\\n  offer : Hint\\n  source : Range\\n  target : offer.target = .range source\\n  row : Read\\n  within : source.contains row.source = true\\n\\ndef locate (hints : Array Hint) (rows : Array Read) : Array Located := Id.run do\\n  let mut found := #[]\\n  for hint in hints do\\n    let .range source := hint.target | continue\\n    if target : hint.target = .range source then\\n      let matching := rows.filter (source.contains ·.source)\\n      unless covered source (matching.map (·.source)) do continue\\n      for row in matching do\\n        if within : source.contains row.source = true then found := found.push ⟨hint,source,target,row,within⟩\\n  return found\\n\\ntheorem Located.same_subject (located : Located) :\\n    located.source.subject = located.row.source.subject := by\\n  have within := located.within\\n  simp only [Range.contains,Bool.and_eq_true,beq_iff_eq,decide_eq_true_eq] at within\\n  exact within.1.1\\n\\n/-- Only arbitrary-output transport needs a full consumption witness. Decode\\neach such fact once, retain its checked Offer and leave range hints compact. -/\\ndef outputOffers (prepared : Recommend.Prepared) (result : Result) (deadline : Nat) : IO (Array Offer) := do\\n  let some shared := prepared.shared | return #[]\\n  let mut facts : Std.HashMap String Fact := {}\\n  let mut offers := #[]\\n  for hint in result.admitted do\\n    let .output _ := hint.target | continue\\n    if (← IO.monoMsNow) ≥ deadline then throw (IO.userError \\\"output-witness deadline\\\")\\n    let fact ← match facts[hint.evidence]? with\\n      | some fact => pure fact\\n      | none => do\\n        let some bytes ← shared.index.get (\\\"fact:\\\" ++ hint.evidence) |\\n          throw (IO.userError \\\"missing original output witness\\\")\\n        let fact ← Index.decode (α := Fact) bytes\\n        unless shared.manifest.scope.accepts fact && Index.belongs shared.manifest.source.identity fact do\\n          throw (IO.userError \\\"foreign original output witness\\\")\\n        pure fact\\n    let identity := Index.contentKey fact\\n    unless identity == hint.evidence do throw (IO.userError \\\"output witness differs from its digest\\\")\\n    let some offer := Offer.check? hint.target hint.priority fact ⟨identity,rfl⟩ |\\n      throw (IO.userError \\\"output hint is not supported by its original witness\\\")\\n    unless offer.kind == Routing.Store.kindName hint.kind do\\n      throw (IO.userError \\\"output hint changed its relation kind\\\")\\n    facts := facts.insert hint.evidence fact\\n    offers := offers.push offer\\n  return offers\\n\\nend Eggshell.Synapses.Routed\\n\"],[\"SynapticRoutingStore.lean\",\"module\\npublic import Eggshell.SynapticRouting\\npublic import Eggshell.SynapticTopologyStore\\n@[expose] public section\\nnamespace Eggshell.Synapses.Routing.Store\\nopen Lean DB Recommend\\nstructure Manifest where\\n  basis : PageMap.Head\\n  source : PageMap.Head\\n  scope : Index.Scope\\n  implementation : String\\n  counts : Counts\\n  deriving ToJson, FromJson\\n\\nstructure Reader where\\n  snapshot : PageMap.Snapshot\\n  manifest : Manifest\\n\\n/-- Facts, inverse postings and integer incidences are one pinned snapshot.\\nOpening does no preparation and cannot observe a half-published projection. -/\\ndef open? (basis : Index.Reader) : IO (Option Reader) := do\\n  let some bytes ← basis.index.get \\\"route:implementation\\\" | return none\\n  unless (← Index.decode (α := String) bytes) == implementation do return none\\n  let some bytes ← basis.index.get \\\"route:counts\\\" | return none\\n  let total ← Index.decode (α := Counts) bytes\\n  unless total.facts == basis.manifest.facts do return none\\n  let manifest : Manifest := {\\n    basis := basis.index.head\\n    source := basis.manifest.source\\n    scope := basis.manifest.scope\\n    implementation\\n    counts := total}\\n  return some ⟨basis.index,manifest⟩\\n\\n\\nstructure Scan where\\n  arcs : Array Arc := #[]\\n  bytes : Nat := 0\\n  pages : Nat := 0\\n  complete : Bool := true\\n\\ndef scanAt (reader : Reader) (ref : PageMap.Ref) (node : Nat)\\n    (limit byteLimit deadline : Nat) (initial : Scan) : IO Scan := do\\n  if !initial.complete then return initial\\n  if initial.arcs.size ≥ limit || initial.bytes ≥ byteLimit || (← IO.monoMsNow) ≥ deadline then\\n    return {initial with complete := false}\\n  let loaded ← reader.snapshot.load ref\\n  let range : PageMap.KeyRange := ⟨arcPrefix node,s!\\\"route:arc:{node};\\\"⟩\\n  let mut result := {initial with pages := initial.pages+1}\\n  match loaded.page with\\n  | .leaf rows =>\\n    for (name,payload) in range.select rows do\\n      let some payload := payload | continue\\n      if result.arcs.size ≥ limit || result.bytes+payload.size > byteLimit ||\\n          (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\\n      let arc ← decode payload\\n      unless name == arcName node arc.evidence && arc.targets.all (· < reader.manifest.counts.targets) &&\\n          arc.next.all (· < reader.manifest.counts.nodes) &&\\n          arc.group.all (· < reader.manifest.counts.nodes) do throw (IO.userError \\\"foreign routing incidence\\\")\\n      result := {result with arcs := result.arcs.push arc,bytes := result.bytes+payload.size}\\n    return result\\n  | .branch children =>\\n    for child in children do\\n      if range.overlaps child then\\n        if _smaller : child.height < ref.height then\\n          result ← scanAt reader child node limit byteLimit deadline result\\n        else throw (IO.userError \\\"routing page height did not decrease\\\")\\n        if !result.complete then return result\\n    return result\\ntermination_by ref.height\\n\\nstructure RawHint where\\n  target : Nat\\n  priority : Nat\\n  evidence : String\\n  kind : Nat\\n  group : Option Nat\\n  lane : Nat\\n\\n/-- A projection hint is intentionally a different type from checked Offer\\nand from every e-graph certification type. -/\\nstructure Hint where\\n  target : Target\\n  priority : Nat\\n  evidence : String\\n  kind : Nat\\n  group : Option Group\\n\\ninductive QuotedCause where\\n  | quoted (group : Group)\\n  deriving ToJson\\n\\ndef Hint.reasonKey (hint : Hint) : String := match hint.group with\\n  | some group => Index.contentKey (QuotedCause.quoted group)\\n  | none => hint.evidence\\n\\ndef Hint.json (hint : Hint) : Json := Json.mkObj [\\n  (\\\"target\\\",toJson hint.target),(\\\"source\\\",toJson hint.target.source?),\\n  (\\\"priority\\\",toJson hint.priority),(\\\"kind\\\",toJson (kindName hint.kind)),\\n  (\\\"evidence\\\",toJson hint.evidence)]\\n\\nstructure Walk where\\n  hints : Array Hint := #[]\\n  nodes : Nat := 0\\n  arcs : Nat := 0\\n  bytes : Nat := 0\\n  complete : Bool := true\\n\\nstructure Limits where\\n  nodes : Nat := 65536\\n  arcs : Nat := 262144\\n  hints : Nat := 262144\\n  queue : Nat := 524288\\n  bytes : Nat := 32*1024*1024\\n\\ndef Reader.destination (reader : Reader) (id : Nat) : IO (Target × Nat) := do\\n  let some bytes ← reader.snapshot.get (targetName id) |\\n    throw (IO.userError \\\"missing routing destination\\\")\\n  let destination ← Index.decode (α := Destination) bytes\\n  unless destination.id == id do throw (IO.userError \\\"routing destination moved\\\")\\n  return (destination.target,bytes.size)\\n\\ndef Reader.group (reader : Reader) (id : Nat) : IO (Group × Nat) := do\\n  let some bytes ← reader.snapshot.get (nodeName id) |\\n    throw (IO.userError \\\"missing routing group\\\")\\n  let node ← Index.decode (α := Node) bytes\\n  unless node.id == id do throw (IO.userError \\\"routing group moved\\\")\\n  let .group group := node.key | throw (IO.userError \\\"routing cause is not a group\\\")\\n  return (group,bytes.size)\\n\\ndef Reader.locate (reader : Reader) (key : Index.Key) : IO (Option Nat × Nat) := do\\n  let some bytes ← reader.snapshot.get (\\\"route:key:\\\" ++ Index.contentKey key) | return (none,0)\\n  let root ← Index.decode (α := Node) bytes\\n  unless root.key == key && root.id < reader.manifest.counts.nodes do\\n    throw (IO.userError \\\"routing root differs from its address\\\")\\n  return (some root.id,bytes.size)\\n\\n/-- Private usage supplies query roots. Its descendants return to the shared\\nrelation, exactly as the original reader dispatch does for non-query keys. -/\\ndef walk (shared : Reader) (usage : Option Reader) (roots : Array (Index.Key × Nat))\\n    (deadline : Nat) (limits : Limits := {}) : IO Walk := do\\n  if let some usage := usage then\\n    unless shared.manifest.scope == .shared && usage.manifest.scope == .usage &&\\n        shared.manifest.source.identity == usage.manifest.source.identity &&\\n        shared.manifest.source.authority == usage.manifest.source.authority do\\n      throw (IO.userError \\\"routing overlay has a different source or privacy scope\\\")\\n  let readerFor := fun (lane : Nat) => if lane == 0 then shared else usage.getD shared\\n  let locate := fun (key : Index.Key) => do\\n    let lane := match key with | .query _ => if usage.isSome then 1 else 0 | _ => 0\\n    let (id,bytes) ← (readerFor lane).locate key\\n    pure (id.map (lane,·),bytes)\\n  let roots := roots.qsort fun a b =>\\n    if a.2 == b.2 then (toJson a.1).compress < (toJson b.1).compress else a.2 < b.2\\n  let mut seen : Std.HashSet (Nat × Nat) := {}\\n  let mut result : Walk := {}\\n  let mut pending : Array RawHint := #[]\\n  for (key,priority) in roots do\\n    if (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\\n    let (root,bytes) ← locate key\\n    if result.bytes+bytes > limits.bytes then return {result with complete := false}\\n    result := {result with bytes := result.bytes+bytes}\\n    let some root := root | continue\\n    let mut queue := #[root]\\n    let mut position := 0\\n    while position < queue.size do\\n      let (lane,node) := queue[position]!\\n      position := position+1\\n      if seen.contains (lane,node) then continue\\n      if result.nodes ≥ limits.nodes || result.arcs ≥ limits.arcs ||\\n          result.bytes ≥ limits.bytes || (← IO.monoMsNow) ≥ deadline then\\n        return {result with complete := false}\\n      seen := seen.insert (lane,node)\\n      let reader := readerFor lane\\n      let scanned ← match reader.snapshot.head.root with\\n        | none => pure ({} : Scan)\\n        | some ref => scanAt reader ref node (limits.arcs-result.arcs) (limits.bytes-result.bytes) deadline {}\\n      result := {result with\\n        nodes := result.nodes+1\\n        arcs := result.arcs+scanned.arcs.size\\n        bytes := result.bytes+scanned.bytes}\\n      unless scanned.complete do return {result with complete := false}\\n      for arc in scanned.arcs do\\n        if pending.size+arc.targets.size > limits.hints || queue.size+arc.next.size > limits.queue then\\n          return {result with complete := false}\\n        pending := pending ++ arc.targets.map (fun target => ⟨target,priority,arc.evidence,arc.kind,arc.group,lane⟩)\\n        if lane == 0 then queue := queue ++ arc.next.map (0,·)\\n        else\\n          for next in arc.next do\\n            let some bytes ← reader.snapshot.get (nodeName next) |\\n              throw (IO.userError \\\"missing private routing descendant\\\")\\n            let node ← Index.decode (α := Node) bytes\\n            unless node.id == next do throw (IO.userError \\\"private routing descendant moved\\\")\\n            let (destination,cost) ← locate node.key\\n            if result.bytes+bytes.size+cost > limits.bytes then return {result with complete := false}\\n            result := {result with bytes := result.bytes+bytes.size+cost}\\n            if let some destination := destination then queue := queue.push destination\\n  -- Group by target before materializing, so repeated evidence for one\\n  -- range does not trigger repeated metadata reads or unbounded caches.\\n  let ordered := (pending.mapIdx (fun ordinal hint => (ordinal,hint))).qsort fun a b =>\\n    if a.2.lane == b.2.lane then a.2.target < b.2.target else a.2.lane < b.2.lane\\n  let mut previous : Option ((Nat × Nat) × Target) := none\\n  let mut groups : Std.HashMap (Nat × Nat) Group := {}\\n  let mut displayed : Array (Nat × Hint) := #[]\\n  for (ordinal,hint) in ordered do\\n    if (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\\n    let reader := readerFor hint.lane\\n    let (target,bytes) ← match previous with\\n      | some (id,target) => if id == (hint.lane,hint.target) then pure (target,0) else reader.destination hint.target\\n      | none => reader.destination hint.target\\n    if result.bytes+bytes > limits.bytes then return {result with complete := false}\\n    result := {result with bytes := result.bytes+bytes}\\n    let (group,groupBytes) ← match hint.group with\\n      | none => pure (none,0)\\n      | some id =>\\n        if let some group := groups[(hint.lane,id)]? then pure (some group,0)\\n        else do\\n          let (group,bytes) ← reader.group id\\n          pure (some group,bytes)\\n    if result.bytes+groupBytes > limits.bytes then return {result with complete := false}\\n    result := {result with bytes := result.bytes+groupBytes}\\n    if groupBytes > 0 then\\n      if let some id := hint.group then\\n        if let some group := group then groups := groups.insert (hint.lane,id) group\\n    previous := some ((hint.lane,hint.target),target)\\n    displayed := displayed.push (ordinal,⟨target,hint.priority,hint.evidence,hint.kind,group⟩)\\n  return {result with hints := (displayed.qsort (fun a b => a.1 < b.1)).map Prod.snd}\\n\\ndef Reader.walk (reader : Reader) (roots : Array (Index.Key × Nat))\\n    (deadline : Nat) (limits : Limits := {}) : IO Walk :=\\n  _root_.Eggshell.Synapses.Routing.Store.walk reader none roots deadline limits\\n\\nend Eggshell.Synapses.Routing.Store\\n\"]]]"],["Eggshell.SynapseSource","[\"module\\n\\npublic import Eggshell.SynapseExtraction\\npublic import Eggshell.SourceEvidence\\npublic import Lean.Data.Json.Parser\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Extraction\\nopen Lean\\n\\nstructure Layout where\\n  text : String\\n  original : String\\n  offsets : Array Nat\\n\\n/-- Canonical JSON is checked once; coordinates name original scalar characters. -/\\ndef canonicalLayout (raw : String) : Except String Layout := do\\n  let projected ← if raw.startsWith \\\"\\\\\\\"\\\" then pure (some (raw, 0)) else\\n    match Json.parse raw with\\n    | .ok (.obj value) => do\\n      let json := Json.obj value\\n      unless json.compress == raw do throw \\\"noncanonical native response\\\"\\n      let outputs := ([\\\"output\\\", \\\"aggregatedOutput\\\", \\\"stdout\\\"].filterMap fun key =>\\n        (json.getObjValAs? String key).toOption).eraseDups\\n      match outputs with\\n      | [text] =>\\n        let fragment := (toJson text).compress\\n        match raw.splitOn fragment with\\n        | [before, _] => pure (some (fragment, before.length))\\n        | _ => pure none\\n      | _ => pure none\\n    | _ => pure none\\n  let encoded := projected.isSome\\n  let fragment := projected.map (·.1) |>.getD raw\\n  let base := projected.map (·.2) |>.getD 0\\n  let text ← if encoded then Json.parse fragment >>= Json.getStr? else pure raw\\n  if encoded && (toJson text).compress != fragment then throw \\\"noncanonical saved scalar\\\"\\n  let mut offsets := #[]\\n  let mut position := base + if encoded then 1 else 0\\n  for char in text.toList do\\n    offsets := offsets.push position\\n    position := position + if encoded then (toJson (String.singleton char)).compress.length - 2 else 1\\n  offsets := offsets.push position\\n  unless position + (if encoded then 1 else 0) == base + fragment.length do throw \\\"scalar layout mismatch\\\"\\n  return ⟨text, raw, offsets⟩\\n\\n/-- A failed optional JSON projection never discards an observed body. The\\nliteral view has a coordinate for every original character, including malformed\\nor noncanonical JSON and arbitrary provider text. -/\\ndef layoutView (raw : String) : Layout :=\\n  match canonicalLayout raw with\\n  | .ok view => {view with original := raw}\\n  | .error _ => ⟨raw,raw,Array.range (raw.length+1)⟩\\n\\ndef layout (raw : String) : Except String Layout := .ok (layoutView raw)\\n\\ntheorem layout_total (raw : String) :\\n    ∃ view, layout raw = .ok view ∧ view.original = raw := by\\n  refine ⟨layoutView raw,rfl,?_⟩\\n  simp only [layoutView]\\n  split <;> rfl\\n\\nstructure TextLine where\\n  text : String\\n  first : Nat\\n  limit : Nat\\n  deriving Repr, BEq\\n\\ndef textLines (text : String) : Array TextLine := Id.run do\\n  let mut lines := #[]\\n  let mut position := 0\\n  let size := text.length\\n  for line in text.splitOn \\\"\\\\n\\\" do\\n    let limit := min size (position + line.length + 1)\\n    if position < limit then lines := lines.push ⟨line, position, limit⟩\\n    position := limit\\n  return lines\\n\\n/-- Terminal elision joins unrelated source fragments. Such a display row\\nhas original observation bytes, but no complete file-line payload. -/\\ndef outputElision (text : String) : Bool :=\\n  [\\\"…\\\", \\\"...\\\"].any fun delimiter =>\\n    ((text.splitOn delimiter).drop 1 |>.dropLast).any fun payload =>\\n      match (payload.trimAscii.toString.splitOn \\\" \\\").filter (!·.isEmpty) with\\n      | [count,unit,\\\"truncated\\\"] => count.toNat?.any (0 < ·) &&\\n          [\\\"tokens\\\",\\\"chars\\\",\\\"bytes\\\",\\\"lines\\\"].contains unit\\n      | _ => false\\n\\ndef numbered (text : String) : Option (Nat × String) := do\\n  if outputElision text then none else do\\n    let parts := text.splitOn \\\"\\\\t\\\"\\n    let first ← parts.head?\\n    let number ← first.trimAscii.copy.toNat?\\n    if number == 0 || parts.length < 2 then none\\n    else some (number, \\\"\\\\t\\\".intercalate parts.tail)\\n\\ntheorem elided_row_not_numbered (text : String) (elided : outputElision text = true) :\\n    numbered text = none := by\\n  simp [numbered,elided]\\n\\n/-- Literal shell lexer; unsupported syntax stays unsupported and is never run. -/\\ndef shellWords (text : String) : Except String (Array String) := do\\n  let mut words := #[]\\n  let mut token : Array Char := #[]\\n  let mut quote : Option Char := none\\n  let mut escaped := false\\n  for char in text.toList ++ [' '] do\\n    if escaped then\\n      token := token.push char\\n      escaped := false\\n    else if quote == some '\\\\'' then\\n      if char == '\\\\'' then quote := none else token := token.push char\\n    else if char == '\\\\\\\\' then escaped := true\\n    else if let some delimiter := quote then\\n      if char == delimiter then quote := none else token := token.push char\\n    else if char == '\\\\'' || char == '\\\"' then quote := some char\\n    else if char.isWhitespace || char == ';' || char == '|' then\\n      if !token.isEmpty then words := words.push (String.ofList token.toList)\\n      token := #[]\\n      if char == ';' || char == '|' || char == '\\\\n' then words := words.push (String.singleton char)\\n    else token := token.push char\\n  if quote.isSome || escaped then throw \\\"unfinished shell quote\\\"\\n  return words\\n\\ndef unwrap (command : String) : String :=\\n  match shellWords command with\\n  | .ok words =>\\n    match words.toList with\\n    | [shell, flag, inner] =>\\n      if ([\\\"sh\\\", \\\"bash\\\", \\\"zsh\\\"].contains (shell.splitOn \\\"/\\\" |>.getLast!)) &&\\n          (flag == \\\"-c\\\" || flag == \\\"-lc\\\") then inner else command\\n    | _ => command\\n  | .error _ => command\\n\\ndef workInput (work : String) : Except String Json := do\\n  let parts := work.splitOn \\\"\\\\n\\\"\\n  unless 2 ≤ parts.length do throw \\\"no native work command\\\"\\n  Json.parse (\\\"\\\\n\\\".intercalate parts.tail)\\n\\n/-- All fields of the original native invocation participate. Field names\\ncannot identify the tool's semantics or discard the other argument values. -/\\ndef invocationData (work : String) : Except String (String × DataFormat) := do\\n  let parts := work.splitOn \\\"\\\\n\\\"\\n  unless 2 ≤ parts.length do throw \\\"no native invocation payload\\\"\\n  let raw := \\\"\\\\n\\\".intercalate parts.tail\\n  match Json.parse raw with\\n  | .ok payload => return (payload.compress,.json)\\n  | .error _ => return (raw,.text)\\n\\ndef invocationInput (work : String) : Except String String := (invocationData work).map (·.1)\\n\\n/-- A source-reader decoder, never a gate for recording or general data flow. -/\\ndef workCommand (work : String) : Except String String := do\\n  let payload ← workInput work\\n  match payload.getObjValAs? String \\\"command\\\" with\\n  | .ok value => return unwrap value\\n  | .error _ => return unwrap (← payload.getObjValAs? String \\\"cmd\\\")\\n\\ndef fileMap (records : Array Json) : Except String (Array File) := do\\n  let mut candidates : Std.HashMap String (Std.HashSet File) := {}\\n  for record in records do\\n    if !(← record.getObjValAs? Bool \\\"complete\\\") then continue\\n    if !(← record.getObjValAs? (Array Json) \\\"uris\\\").isEmpty then continue\\n    for value in ← record.getObjValAs? (Array Json) \\\"files\\\" do\\n      let content ← value.getObjVal? \\\"content\\\"\\n      if content == .null then continue\\n      let file : File := ⟨← value.getObjValAs? String \\\"relative\\\",\\n        ← content.getObjValAs? String \\\"root\\\", ← content.getObjValAs? Nat \\\"bytes\\\"⟩\\n      if !file.valid then continue\\n      candidates := add candidates file.relative file\\n  return candidates.fold (fun result _ files =>\\n    if files.size == 1 then result ++ files.toArray else result) #[]\\n\\ndef parseBounds (text : String) : Option (Nat × Nat) := do\\n  let normalized := (text.replace \\\"–\\\" \\\"-\\\").replace \\\"—\\\" \\\"-\\\"\\n  let parts := normalized.splitOn \\\"-\\\"\\n  let first ← (← parts.head?).toNat?\\n  let last ← if parts.length == 1 then some first else if parts.length == 2 then\\n      ((parts[1]!).dropWhile (· == 'L')).toString.toNat? else none\\n  if 0 < first && first ≤ last then some (first, last) else none\\n\\ndef readPlans (command : String) (files : Array File) : Except String (Array Range) := do\\n  let some segments := SourceEvidence.sequenceSegments? command | throw \\\"unsupported read sequence\\\"\\n  let mut plans := #[]\\n  for segment in segments do\\n    let [\\\"nl\\\", \\\"-ba\\\", path, \\\"|\\\", \\\"sed\\\", \\\"-n\\\", program] := (← shellWords segment).toList |\\n      throw \\\"unsupported literal read sequence\\\"\\n    if path.toList.any (fun c => \\\"$\\\\x60*?{}\\\".contains c) then throw \\\"nonliteral read path\\\"\\n    let candidates := files.filter (fun f => path == f.relative || path.endsWith (\\\"/\\\" ++ f.relative))\\n    unless candidates.size == 1 do throw \\\"ambiguous read path\\\"\\n    for statement in program.splitOn \\\";\\\" do\\n      let statement := statement.trimAscii.toString\\n      unless statement.endsWith \\\"p\\\" do throw \\\"unsupported read program\\\"\\n      let bounds := ((statement.dropEnd 1).copy.replace \\\",\\\" \\\"-\\\")\\n      let some (first, last) := parseBounds bounds | throw \\\"invalid read interval\\\"\\n      plans := plans.push ⟨candidates[0]!, first, last⟩\\n  if plans.isEmpty then throw \\\"no numbered read\\\"\\n  return plans\\n\\nstructure Document where\\n  owner : String\\n  work : String\\n  workText : Option String\\n  source : Option String\\n  native : Bool\\n  occurrences : Array Occurrence\\n  files : Array File\\n\\ndef document (value : Json) : Except String Document := do\\n  return {\\n    owner := ← value.getObjValAs? String \\\"owner\\\"\\n    work := ← value.getObjValAs? String \\\"workKey\\\"\\n    workText := ← value.getObjValAs? (Option String) \\\"work\\\"\\n    source := ← value.getObjValAs? (Option String) \\\"source\\\"\\n    native := ← value.getObjValAs? Bool \\\"native\\\"\\n    occurrences := ← value.getObjValAs? (Array Occurrence) \\\"occurrences\\\"\\n    files := ← fileMap (← value.getObjValAs? (Array Json) \\\"records\\\") }\\n\\nstructure LocatedRead where\\n  read : Read\\n  rows : Array OutputRow\\n  originalRows : Array Read\\n  text : String\\n\\n/-- Presence in a pinned source archive, without inventing an execution order. -/\\ndef recordedRows (database : String) (doc : Document) : Except String (Array Read) := do\\n  let some raw := doc.source | throw \\\"no original observation\\\"\\n  let some work := doc.workText | throw \\\"no original work\\\"\\n  let some occurrence := doc.occurrences[0]? | throw \\\"missing native occurrence identity\\\"\\n  let plans ← readPlans (← workCommand work) doc.files\\n  let decoded ← layout raw\\n  let mut rows := #[]\\n  for line in textLines decoded.text do\\n    let some (number, _) := numbered line.text | continue\\n    let files := plans.foldl (fun files range =>\\n      if range.first ≤ number && number ≤ range.last then\\n        (range.file?.map files.insert).getD files else files)\\n      ({} : Std.HashSet File)\\n    if files.size != 1 then continue\\n    let source : Range := ⟨files.toArray[0]!, number, number⟩\\n    let binding : Binding := ⟨database, doc.owner, doc.work,\\n      decoded.offsets[line.first]!, decoded.offsets[line.limit]!⟩\\n    rows := rows.push {occurrence,source,binding}\\n  return rows\\n\\ndef recordedReads (database : String) (doc : Document) : Except String (Array LocatedRead) := do\\n  let rows ← recordedRows database doc\\n  let mut chunks : Array LocatedRead := #[]\\n  for row in rows do\\n    if let some previous := chunks.back? then\\n      if previous.read.source.subject == row.source.subject &&\\n          previous.read.source.last + 1 == row.source.first &&\\n          previous.read.binding.limit == row.binding.first then\\n        let merged := {previous with\\n          read := {previous.read with\\n            source := {previous.read.source with last := row.source.last}\\n            binding := {previous.read.binding with limit := row.binding.limit}}\\n          originalRows := previous.originalRows.push row}\\n        chunks := chunks.pop.push merged\\n        continue\\n    chunks := chunks.push ⟨row, #[], #[row], \\\"\\\"⟩\\n  return chunks\\n\\ndef locateReads (database : String) (doc : Document) (trace : Trace) : Except String (Array LocatedRead) := do\\n  let some raw := doc.source | throw \\\"no original observation\\\"\\n  let some work := doc.workText | throw \\\"no original work\\\"\\n  let command ← workCommand work\\n  let (input,format) ← invocationData work\\n  let plans ← readPlans command doc.files\\n  let decoded ← layout raw\\n  let original := (textLines decoded.text).filterMap fun line => do\\n    let (number, body) ← numbered line.text\\n    let files := plans.filter (fun range => range.first ≤ number && number ≤ range.last)\\n    let unique := files.foldl (fun files range => (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n    if unique.size != 1 then none else\\n      some (line, number, body, unique.toArray[0]!)\\n  if original.isEmpty then throw \\\"no unambiguous original numbered rows\\\"\\n  let mut result := #[]\\n  for occurrence in doc.occurrences do\\n    let some start := trace.starts[occurrence]? | continue\\n    let some output := trace.finished[occurrence]? | continue\\n    let sameInput := match start.format with\\n      | .json => start.command == input && start.format == format\\n      | .text => unwrap start.command == command\\n    if !sameInput then continue\\n    let actualLayout ← layout output\\n    let actual := (textLines actualLayout.text).filterMap fun line => do\\n      let (number, body) ← numbered line.text\\n      some (line, number, body)\\n    if !original.all (fun (_, number, body, _) => actual.any (fun (_, n, b) => n == number && b == body)) then continue\\n    let mut chunks : Array LocatedRead := #[]\\n    for (line, number, body, file) in original do\\n      let source : Range := ⟨file, number, number⟩\\n      let first := decoded.offsets[line.first]!\\n      let limit := decoded.offsets[line.limit]!\\n      let binding : Binding := ⟨database, doc.owner, doc.work, first, limit⟩\\n      let rows := actual.filterMap fun (actualLine, n, b) =>\\n        if n == number && b == body then\\n          some (OutputRow.mk source actualLayout.offsets[actualLine.first]! actualLayout.offsets[actualLine.limit]!)\\n        else none\\n      let recorded : Read := {occurrence,source,binding}\\n      let located : LocatedRead := ⟨recorded, rows, #[recorded], line.text⟩\\n      if let some previous := chunks.back? then\\n        if previous.read.source.subject == .file file && previous.read.source.last + 1 == number &&\\n            previous.read.binding.limit == first then\\n          let merged : LocatedRead := {\\n            read := {previous.read with\\n              source := {previous.read.source with last := number}\\n              binding := {previous.read.binding with limit}}\\n            rows := previous.rows ++ rows\\n            originalRows := previous.originalRows.push recorded\\n            text := previous.text ++ \\\"\\\\n\\\" ++ line.text }\\n          chunks := chunks.pop.push merged\\n          continue\\n      chunks := chunks.push located\\n    result := result ++ chunks\\n  if result.isEmpty then throw \\\"saved observation has no exact matching completed call\\\"\\n  return result\\n\\ndef hexDigit (char : Char) : Option Nat :=\\n  if '0' ≤ char && char ≤ '9' then some (char.toNat - '0'.toNat)\\n  else if 'a' ≤ char && char ≤ 'f' then some (char.toNat - 'a'.toNat + 10)\\n  else if 'A' ≤ char && char ≤ 'F' then some (char.toNat - 'A'.toNat + 10)\\n  else none\\n\\ndef percentDecode (text : String) : Option String := do\\n  let chars := text.toList.toArray\\n  let mut bytes := ByteArray.empty\\n  let mut position := 0\\n  while position < chars.size do\\n    let char := chars[position]!\\n    if char == '%' then\\n      let a ← chars[position+1]? >>= hexDigit\\n      let b ← chars[position+2]? >>= hexDigit\\n      bytes := bytes.push (UInt8.ofNat (16*a+b))\\n      position := position+3\\n    else\\n      bytes := bytes ++ (String.singleton char).toUTF8\\n      position := position+1\\n  String.fromUTF8? bytes\\n\\n/-- Only declared paths and literal line intervals; destinations are never opened. -/\\ndef citation (label destination : String) (files : Array File) : Option Range := do\\n  let destination ← percentDecode destination\\n  let destination := destination.trimAscii.copy |>.replace \\\"<\\\" \\\"\\\" |>.replace \\\">\\\" \\\"\\\"\\n  let mut candidates := #[]\\n  for file in files do\\n    for separator in [\\\":\\\", \\\"#L\\\"] do\\n      let marker := file.relative ++ separator\\n      let parts := destination.splitOn marker\\n      if parts.length != 2 then continue\\n      let leading := parts[0]!\\n      if !leading.isEmpty && !leading.endsWith \\\"/\\\" then continue\\n      let some (first, last) := parseBounds parts[1]! | continue\\n      let filename := file.relative.splitOn \\\"/\\\" |>.getLast!\\n      let displayed := label.splitOn (filename ++ \\\":\\\")\\n      let mut last := last\\n      if displayed.length == 2 then\\n        let bounds := String.ofList ((displayed[1]!).toList.takeWhile\\n          (fun c => c.isDigit || c == '-' || c == '–' || c == '—'))\\n        let (a, b) ← parseBounds bounds\\n        if a != first || (first != last && b != last) then return ← none\\n        last := b\\n      candidates := candidates.push (Range.mk file first last)\\n  if candidates.size == 1 then some candidates[0]! else none\\n\\ndef paragraphCitations (text : String) (files : Array File) : Array Range := Id.run do\\n  let mut result : Std.HashSet Range := {}\\n  for part in (text.splitOn \\\"](\\\").dropLast.zip ((text.splitOn \\\"](\\\").tail) do\\n    let some label := (part.1.splitOn \\\"[\\\").getLast? | continue\\n    let some destination := (part.2.splitOn \\\")\\\").head? | continue\\n    if let some range := citation label destination files then result := result.insert range\\n  return result.toArray\\n\\ndef addAnswer (database : String) (doc : Document) (reads : Array LocatedRead) (graph : Graph) :\\n    Except String Graph := do\\n  let some raw := doc.source | throw \\\"answer has no original scalar\\\"\\n  let decoded ← layout raw\\n  let files := reads.foldl (fun files located =>\\n    (located.read.source.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n  let mut graph := graph\\n  let mut position := 0\\n  for paragraph in decoded.text.splitOn \\\"\\\\n\\\\n\\\" do\\n    let limit := position + paragraph.length\\n    if position < limit then\\n      let claim : Claim := ⟨database, doc.owner, decoded.offsets[position]!, decoded.offsets[limit]!⟩\\n      graph ← supportCitations graph claim (paragraphCitations paragraph files.toArray)\\n        (reads.map (·.read)) (reads.flatMap (·.originalRows))\\n    position := limit + 2\\n  return graph\\n\\nend Eggshell.Synapses.Extraction\\n\",[]]"],["Eggshell.SynapseTransport","[\"module\\n\\npublic import Eggshell.SynapticTransport\\npublic import tools.KeyPostings\\npublic import Eggshell.HashDistinct\\npublic import Eggshell.SynapticBindings\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Transport\\nopen Lean Persistence.Store _root_.Eggshell.Synapses.Extraction Recommend\\n\\nstructure Owner where\\n  database : String\\n  original : OutcomeEdge\\n  provenance : List SourceEvidence.Record\\n\\ndef Owner.document (owner : Owner) : Except String Document := do\\n  return {\\n    owner := Persistence.selectionKey owner.original.relation\\n    work := Persistence.selectionKey owner.original.work\\n    workText := text? owner.original.work\\n    source := text? owner.original.outcome\\n    native := owner.original.observations.any\\n      (Relation.observesOutcomeWork owner.original.outcome owner.original.work)\\n    occurrences := Provenance.identities owner.original\\n    files := ← fileMap (owner.provenance.toArray.map toJson) }\\n\\nstructure LocatedOwner where\\n  owner : OutcomeEdge\\n  document : Document\\n  located : Array Routed.Located\\n  outputs : Array (LocatedOutput document)\\n\\n/-- Hydration and the original identity are prepared once per admitted owner.\\nBinding a graph interval does not parse or hash the same body again. -/\\nstructure AdmittedOwner where\\n  owner : Owner\\n  document : Document\\n  original : Option (ObservationContext.OriginalOwner document)\\n\\nstructure Observation where\\n  database : String\\n  owner : String\\n  work : String\\n  occurrence : Occurrence\\n  age : ObservationAge.Assessment\\n  metadataFailure : Option String := none\\n  deriving ToJson\\n\\nstructure Plan where\\n  results : Array Routed.Result := #[]\\n  owners : Array LocatedOwner := #[]\\n  documents : Array Document := #[]\\n  rows : Array Read := #[]\\n  unsupported : Nat := 0\\n  unlocatedFileOwners : Nat := 0\\n  observations : Array Observation := #[]\\n  canonical : Std.HashMap String (Array CanonicalSource.StoredRow) := {}\\n  canonicalReuse : Array (String × CanonicalSource.Shared.Reuse × CanonicalSource.Shared.Reuse) := #[]\\n  canonicalFailure : Array (String × String) := #[]\\n  originalViews : Std.HashMap String ObservedRecordView.View := {}\\n  bindingComplete : Bool := true\\n  bindingRequests : Nat := 0\\n  bindingBytes : Nat := 0\\n  bindingUnresolved : Nat := 0\\n\\ndef Plan.complete (plan : Plan) : Bool := plan.bindingComplete && plan.results.all (·.complete)\\n\\n/-- An exact source-posting origin can be attached only to this already\\nadmitted owner. Stored offsets are still bounded by its original body and\\nthe native occurrence; the index cannot nominate another Work here. -/\\ndef boundTo (database : String) (document : Document) (identity : Original) (read : Read) : Bool :=\\n  document.native && read.valid && read.binding.database == database &&\\n    read.binding.owner == document.owner && read.binding.work == document.work &&\\n    document.occurrences.contains read.occurrence && read.binding.limit ≤ identity.chars &&\\n    match read.source.subject with\\n    | .original original => original == identity\\n    | .file file => document.files.contains file\\n\\ndef Plan.ranges (plan : Plan) : List (Value × List (Nat × Nat × Nat)) :=\\n  plan.owners.toList.map fun owner =>\\n    (owner.owner.relation, (owner.located.toList.filterMap fun located =>\\n      if located.source.file?.isNone then none else some\\n      (located.offer.priority, located.row.binding.first, located.row.binding.limit)).eraseDups)\\n\\nstructure OutputRange where\\n  priority : Nat\\n  first : Nat\\n  limit : Nat\\n  path : Option (List JsonScalars.Segment)\\n  deriving BEq\\n\\ndef LocatedOwner.originalRanges (owner : LocatedOwner) : Array (Range × OutputRange) := Id.run do\\n  let raw := owner.document.source.getD \\\"\\\"\\n  let json := JsonScalars.prepare? raw\\n  return owner.located.filterMap fun located => do\\n    let .original _ := located.source.subject | none\\n    some (located.source,{\\n      priority := located.offer.priority\\n      first := located.row.binding.first\\n      limit := located.row.binding.limit\\n      path := (json.bind (·.cover? located.row.binding.first located.row.binding.limit)).map (·.path)})\\n\\ndef Plan.outputRanges (plan : Plan) : List (Value × List OutputRange) := Id.run do\\n  let mut originals : Std.HashMap Range (Value × OutputRange) := {}\\n  for owner in plan.owners do\\n    for (source,range) in owner.originalRanges do\\n      if (originals[source]?).all (fun prior => range.priority < prior.2.priority) then\\n        originals := originals.insert source (owner.owner.relation,range)\\n  return plan.owners.toList.map fun owner =>\\n    let shared := originals.toArray.filterMap fun (_,origin,range) =>\\n      if origin == owner.owner.relation then some range else none\\n    let shared := shared.qsort fun a b => if a.first == b.first then a.limit < b.limit else a.first < b.first\\n    (owner.owner.relation, ((owner.outputs.toList.map fun located =>\\n      ({priority := located.offer.priority,first := located.fragment.binding.first\\n        limit := located.fragment.binding.limit,path := located.fragment.address.map (·.path)} : OutputRange)) ++\\n      shared.toList).eraseDups)\\n\\n/-- Original intervals bind to their immutable native output identity; file\\ncoordinates bind through the existing source postings. A graph hint cannot\\nnominate a different Work, occurrence or out-of-body interval. -/\\ndef build (prepared : Array Recommend.Prepared) (answers : Array (String × Nat))\\n    (owners : Array Owner) (query : String) (deadline : Nat)\\n    (graphDeadline : Option Nat := none) : IO Plan := do\\n  let mut plan : Plan := {}\\n  let mut outputWitnesses : Array (String × Array Offer) := #[]\\n  let assessedUnixMs ← ObservationAge.now\\n  for source in prepared do\\n    let consumers := owners.flatMap fun owner =>\\n      if owner.database != source.source.head.identity then #[] else\\n      let priorities := answers.filterMap fun (key,priority) =>\\n        if key == Persistence.selectionKey owner.original.relation then some priority else none\\n      (Provenance.identities owner.original).flatMap fun occurrence =>\\n        priorities.map fun priority => (occurrence,priority)\\n    let result ← Routed.collect source answers query (min deadline (graphDeadline.getD deadline)) consumers\\n    let (result,outputs) ← try pure (result,← Routed.outputOffers source result deadline)\\n      catch error => pure ({result with complete := false,failure := some s!\\\"output-witness: {error}\\\"},#[])\\n    outputWitnesses := outputWitnesses.push (source.source.head.identity,outputs)\\n    plan := {plan with results := plan.results.push result}\\n  let offers := plan.results.flatMap (·.admitted)\\n  let mut admitted : Array AdmittedOwner := #[]\\n  let mut originals : Std.HashMap (String × Original) (List Nat) := {}\\n  for owner in owners do\\n    let .ok document := owner.document | plan := {plan with unsupported := plan.unsupported+1}; continue\\n    let original := ObservationContext.OriginalOwner.prepare? document\\n    if let some original := original then\\n      let key := (owner.database,original.identity)\\n      originals := originals.insert key (admitted.size :: (originals[key]?.getD []))\\n    admitted := admitted.push ⟨owner,document,original⟩\\n  -- Prepend in the directory. Appending to a shared array here repeatedly\\n  -- copies a growing owner's complete row list.\\n  let mut origins : Std.HashMap (String × String) (List Routed.Located) := {}\\n  for (source,result) in prepared.zip plan.results do\\n    let database := source.source.head.identity\\n    let scopedOffers := result.admitted\\n    let wanted := (hashDistinct (scopedOffers.toList.filterMap fun hint => do\\n      let range ← hint.target.source?\\n      let .file _ := range.subject | none\\n      some range)).toArray\\n    let allowed := admitted.foldl (fun allowed item =>\\n      if item.owner.database == database && item.document.native then\\n        allowed.insert item.document.owner else allowed) ({} : Std.HashSet String)\\n    let resolved ← if wanted.isEmpty then pure ({} : IndexedBindings.Resolved)\\n      else if let some index := source.shared then IndexedBindings.resolve index wanted allowed deadline\\n      else pure {complete := false,unresolved := wanted.size}\\n    plan := {plan with\\n      bindingComplete := plan.bindingComplete && resolved.complete\\n      bindingRequests := plan.bindingRequests+resolved.requests\\n      bindingBytes := plan.bindingBytes+resolved.bytes\\n      bindingUnresolved := plan.bindingUnresolved+resolved.unresolved}\\n    let mut unresolved : Std.HashSet Range := {}\\n    for offer in scopedOffers do\\n      let .range target := offer.target | continue\\n      if exact : offer.target = .range target then\\n        let mut rows := #[]\\n        match target.subject with\\n        | .file _ => rows := resolved.rows[target]?.getD #[]\\n        | .original identity =>\\n          for index in originals[(database,identity)]?.getD [] do\\n            let some item := admitted[index]? | continue\\n            let some original := item.original | continue\\n            rows := rows ++ (original.bind database target).map (·.read)\\n          if rows.isEmpty then unresolved := unresolved.insert target\\n        for row in rows do\\n          if contained : target.contains row.source = true then\\n            let located : Routed.Located := ⟨offer,target,exact,row,contained⟩\\n            let key := (database,row.binding.owner)\\n            origins := origins.insert key (located :: (origins[key]?.getD []))\\n    plan := {plan with bindingUnresolved := plan.bindingUnresolved+unresolved.size}\\n  -- One scoped acquisition serves graph binding and the final renderer.\\n  -- A graph resource limit cannot erase independently verified source rows.\\n  for source in prepared do\\n    if let some reference := source.canonical then\\n      try\\n        let ids := owners.filterMap fun owner =>\\n          if owner.database == source.source.head.identity then\\n            some (Persistence.selectionKey owner.original.relation) else none\\n        let found ← Plugin.Publication.Client.sourceRows reference ids deadline\\n        let reuse := (source.source.head.identity,reference.access.reuse,found.reuse)\\n        plan := {plan with canonicalReuse := plan.canonicalReuse.push reuse}\\n        for (owner,rows) in found.rows do\\n          let merged ← IO.ofExcept (CanonicalSource.Delivery.merge ((plan.canonical[owner]?.getD #[]) ++ rows))\\n          plan := {plan with canonical := if merged.isEmpty then plan.canonical.erase owner\\n            else plan.canonical.insert owner merged}\\n        let storedOriginals ← Plugin.Publication.Client.sourceRecords reference ids deadline\\n        for (owner,view) in storedOriginals do\\n          if let some view := view then\\n            plan := {plan with originalViews := plan.originalViews.insert owner view}\\n      catch error =>\\n        let failure := (source.source.head.identity,error.toString)\\n        plan := {plan with canonicalFailure := plan.canonicalFailure.push failure}\\n  if offers.isEmpty then return plan\\n  -- Query-invariant across owners. Computing this same ordered set inside\\n  -- each owner was quadratic work repeated for every hydrated observation.\\n  for item in admitted do\\n    if (← IO.monoMsNow) ≥ deadline then\\n      return {plan with results := plan.results.map fun result =>\\n        {result with complete := false,failure := some \\\"binding-deadline\\\"}}\\n    let owner := item.owner\\n    let document := item.document\\n    let located := (origins[(owner.database,document.owner)]?.getD []).reverse.toArray.filter fun located =>\\n      item.original.any (fun original => boundTo owner.database document original.identity located.row)\\n    let rows := (hashDistinct (located.toList.map (·.row))).toArray\\n    let witnesses := outputWitnesses.flatMap fun (database,offers) =>\\n      if database == owner.database then offers else #[]\\n    let context := if witnesses.isEmpty then none else ObservationContext.prepare? document\\n    let outputs := context.map (Recommend.locateOutputsUsing witnesses owner.database) |>.getD #[]\\n    -- Metadata is fetched only for offered native origins, once per occurrence,\\n    -- with a fixed cap and the existing request deadline. It cannot block or\\n    -- filter the historical body when unavailable, expired, or clock-skewed.\\n    if !located.isEmpty || !outputs.isEmpty then\\n      for occurrence in document.occurrences do\\n        if plan.observations.any (fun prior => prior.database == owner.database &&\\n            prior.owner == document.owner && prior.occurrence == occurrence) then continue\\n        let (receivedUnixMs,metadataFailure) ←\\n          if plan.observations.size ≥ 256 || (← IO.monoMsNow) ≥ deadline then\\n            pure (none,some \\\"metadata-budget\\\")\\n          else if let some source := prepared.find? (·.source.head.identity == owner.database) then\\n            try\\n              let origin ← Provenance.lookup? source.source owner.original occurrence\\n              pure (origin.bind (·.receivedUnixMs),if origin.isNone then some \\\"unrecorded\\\" else none)\\n            catch _ => pure (none,some \\\"metadata-unverified\\\")\\n          else pure (none,some \\\"source-unavailable\\\")\\n        plan := {plan with observations := plan.observations.push {\\n          database := owner.database,owner := document.owner,work := document.work,occurrence\\n          age := ObservationAge.assess assessedUnixMs receivedUnixMs,metadataFailure}}\\n    plan := {plan with\\n      documents := plan.documents.push document\\n      rows := plan.rows ++ rows\\n      unlocatedFileOwners := plan.unlocatedFileOwners +\\n        if !document.files.isEmpty && located.isEmpty then 1 else 0\\n      owners := plan.owners.push ⟨owner.original,document,located,outputs⟩}\\n  return plan\\n\\ndef Plan.receiptWith (plan : Plan) (delivery : Extraction.Presentation) : Json :=\\n  let bindings := KeyPostings.prepare (·.source) (plan.owners.flatMap (·.located))\\n  let originals := ((plan.results.flatMap (·.admitted)).toList.filterMap fun offer => do\\n    let source ← offer.target.source?\\n    let .original _ := source.subject | none\\n    some source) |> hashDistinct |>.toArray\\n  Json.mkObj [\\n    (\\\"complete\\\", toJson plan.complete), (\\\"unsupportedOwners\\\", toJson plan.unsupported),\\n    (\\\"bindingComplete\\\",toJson plan.bindingComplete),(\\\"bindingRequests\\\",toJson plan.bindingRequests),\\n    (\\\"bindingBytes\\\",toJson plan.bindingBytes),(\\\"bindingUnresolved\\\",toJson plan.bindingUnresolved),\\n    (\\\"unlocatedFileOwners\\\",toJson plan.unlocatedFileOwners),\\n    (\\\"observationAges\\\",toJson plan.observations),\\n    (\\\"inputs\\\", toJson (plan.results.map Routed.Result.receipt)),\\n    (\\\"originalReferences\\\",toJson (originals.map fun source =>\\n      let bindings := (bindings.lookup source).map (·.row.binding)\\n      let origins := bindings.foldl (fun known binding => known.insert binding) ({} : Std.HashSet Binding)\\n      let origins := origins.toArray.qsort fun a b => (toJson a).compress < (toJson b).compress\\n      Json.mkObj [\\n      (\\\"source\\\",toJson source), (\\\"bodyDelivered\\\",toJson (covered source delivery.ranges)),\\n      (\\\"origins\\\",toJson origins)])),\\n    (\\\"originalOutputs\\\",toJson (plan.owners.flatMap fun owner => owner.outputs.map fun located =>\\n      Json.mkObj [\\n        (\\\"evidence\\\",toJson located.offer.identity), (\\\"binding\\\",toJson located.fragment.binding),\\n        (\\\"path\\\",toJson (located.fragment.address.map (fun address => JsonScalars.pathJson address.path))),\\n        (\\\"bodyDelivered\\\",toJson (delivery.coversBinding located.fragment.binding)),\\n        (\\\"addressDelivered\\\",toJson (located.fragment.address.map (fun address =>\\n          delivery.coversAddress located.fragment.binding address.path)))])),\\n    (\\\"offers\\\", toJson (plan.results.flatMap fun result => result.admitted.map fun offer =>\\n      let delivered := match offer.target with\\n        | .range source => covered source delivery.ranges\\n        | .output _ => plan.owners.any fun owner => owner.outputs.any fun located =>\\n            located.offer.identity == offer.evidence && delivery.coversBinding located.fragment.binding\\n      Json.mkObj [(\\\"offer\\\", offer.json), (\\\"bodyDelivered\\\", toJson delivered)]))]\\n\\ndef Plan.receipt (plan : Plan) (text : String) : Json :=\\n  plan.receiptWith (Extraction.presented text plan.documents plan.rows)\\n\\nend Eggshell.Synapses.Transport\\n\",[]]"],["Eggshell.SynapseUsage","[\"module\\n\\npublic import Eggshell.SynapseSource\\npublic import tools.SpanPostings\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Extraction\\nopen Lean\\n\\nstructure Presentation where\\n  ranges : Array Range := #[]\\n  uncertain : Std.HashSet File := {}\\n  bindings : Array (String × Nat × Nat) := #[]\\n  uncertainOwners : Std.HashSet String := {}\\n  addressed : Array (String × Nat × Nat × List JsonScalars.Segment) := #[]\\n\\ndef caption (text : String) : Option (Nat × Nat × Bool) := do\\n  if !text.startsWith \\\"  ORIGINAL CHARS [\\\" && !text.startsWith \\\"  CHARS [\\\" then none else do\\n    let parts := text.splitOn \\\"CHARS [\\\"\\n    let rest ← parts[1]?\\n    let bounds ← (rest.splitOn \\\")\\\").head?\\n    let [first, limit] := bounds.splitOn \\\",\\\" | none\\n    let first ← first.toNat?\\n    let limit ← limit.toNat?\\n    if first < limit then some (first, limit, text.endsWith \\\" decoded\\\") else none\\n\\ndef scalarSlice (raw : String) (first limit : Nat) : Option String :=\\n  if first < limit && limit ≤ raw.length then\\n    some (String.ofList ((raw.toList.drop first).take (limit-first))) else none\\n\\nstructure SharedSpelling where\\n  file : File\\n  number : Nat\\n  code : String\\n  origins : Array (String × String × String × Occurrence)\\n\\n/-- Decode only complete shared frames. This grants no original-byte status;\\ncallers must bind each spelling to their saved original rows. -/\\ndef sharedSpellings (body : String) : Array SharedSpelling := Id.run do\\n  let wrapper := \\\"EGGSHELL SHARED SOURCE DATA\\\\nOriginal recorded file data; advisory, not a completed operation.\\\\n\\\"\\n  let mut found : Array SharedSpelling := #[]\\n  for packet in (body.splitOn wrapper).tail do\\n    let parts := packet.splitOn \\\"END EGGSHELL SHARED SOURCE DATA\\\\n\\\"\\n    if parts.length < 2 then continue\\n    for block in ((\\\"\\\\n\\\" ++ parts.head!).splitOn \\\"\\\\nSOURCE \\\").tail do\\n      let parts := block.splitOn \\\"\\\\nEND SOURCE\\\"\\n      if parts.length < 2 then continue\\n      let suffix := parts[1]!\\n      if !suffix.isEmpty && !suffix.startsWith \\\"\\\\n\\\" then continue\\n      let fileLine :: originsLine :: \\\"CODE\\\" :: codeLines := parts.head!.splitOn \\\"\\\\n\\\" | continue\\n      let some file := (Json.parse fileLine >>= fromJson? (α := File)).toOption | continue\\n      if !file.valid || !originsLine.startsWith \\\"ORIGINAL READS \\\" then continue\\n      let encoded := String.ofList (originsLine.toList.drop \\\"ORIGINAL READS \\\".length)\\n      let some origins := (Json.parse encoded >>= fromJson? (α := Array String)).toOption | continue\\n      let origins := origins.filterMap fun origin =>\\n        (Json.parse origin >>= fromJson? (α := String × String × String × Occurrence)).toOption\\n      for line in codeLines do\\n        let some (number,code) := numbered line | continue\\n        found := found.push ⟨file,number,code,origins⟩\\n  return found\\n\\n/-- A shared spelling can report only a range belonging to an original saved\\nrow. Sharing the payload never manufactures another execution witness. -/\\nstructure SharedWitness (reads : Array Read) where\\n  row : Read\\n  original : row ∈ reads\\n  file : File\\n  number : Nat\\n  code : String\\n  sourceExact : row.source = ⟨file,number,number⟩\\n\\ntheorem SharedWitness.original_range (witness : SharedWitness reads) :\\n    ∃ row ∈ reads, row.source = ⟨witness.file,witness.number,witness.number⟩ :=\\n  ⟨witness.row,witness.original,witness.sourceExact⟩\\n\\n/-- A file alias can cover just its original code bytes, without a numbered\\nprefix. JSON escaping changes representation, never the saved code spelling. -/\\nstructure SharedCode (original : String) where\\n  text : String\\n  exact : text = original ∨\\n    String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original\\n\\ndef sharedCodes (original : String) : Array (SharedCode original) := Id.run do\\n  let mut result := #[⟨original,Or.inl rfl⟩]\\n  if let some text := (Json.parse (\\\"\\\\\\\"\\\" ++ original ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption then\\n    if same : String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original then\\n      if text != original then result := result.push ⟨text,Or.inr same⟩\\n  return result\\n\\ntheorem SharedCode.original_spelling (code : SharedCode original) :\\n    code.text = original ∨\\n      String.ofList ((toJson code.text).compress.toList.drop 1 |>.dropLast) = original := code.exact\\n\\n/-- Recognize the producer's shared file frame, then compare every displayed\\ncode row with its raw scalar coordinates and declared DB/owner/Work/occurrence.\\nLocation-only notices and arbitrary matching prose cannot label delivery. -/\\ndef sharedPresented (body : String) (docs : Array Document) (reads : Array Read) :\\n    Array (SharedWitness reads) := Id.run do\\n  let displayed := sharedSpellings body\\n  if displayed.isEmpty || reads.isEmpty then return #[]\\n  let mut index : Std.HashMap (File × Nat × String) (Array (SharedWitness reads)) := {}\\n  let byOwner := reads.attach.foldl (fun found saved =>\\n    found.insert saved.val.binding.owner\\n      ((found.getD saved.val.binding.owner #[]).push saved))\\n    ({} : Std.HashMap String (Array {row // row ∈ reads}))\\n  for doc in docs do\\n    if !doc.native then continue\\n    let some raw := doc.source | continue\\n    let characters := raw.toList.toArray\\n    for saved in byOwner.getD doc.owner #[] do\\n      let row := saved.val\\n      if !row.valid || row.binding.work != doc.work || !doc.occurrences.contains row.occurrence then continue\\n      let .file file := row.source.subject | continue\\n      if row.source.first != row.source.last then continue\\n      if !(row.binding.first < row.binding.limit && row.binding.limit ≤ characters.size) then continue\\n      let original := String.ofList (characters.extract row.binding.first row.binding.limit).toList\\n      for code in sharedCodes original do\\n        if code.text.isEmpty || code.text.contains '\\\\n' || code.text.contains '\\\\r' then continue\\n        if same : row.source = ⟨file,row.source.first,row.source.first⟩ then\\n          let witness : SharedWitness reads := ⟨row,saved.property,file,row.source.first,code.text,same⟩\\n          let key := (file,row.source.first,code.text)\\n          index := index.insert key ((index.getD key #[]).push witness)\\n    let .ok decoded := layout raw | continue\\n    let spanOf := fun (saved : {row // row ∈ reads}) =>\\n      if saved.val.valid && saved.val.binding.work == doc.work then\\n        some (saved.val.binding.first,saved.val.binding.limit) else none\\n    let spans := SpanPostings.prepare spanOf (byOwner.getD doc.owner #[]).toList\\n    for line in textLines decoded.text do\\n      let some (number,code) := numbered line.text | continue\\n      for saved in spans.lookup (decoded.offsets[line.first]!,decoded.offsets[line.limit]!) do\\n        let row := saved.val\\n        let .file file := row.source.subject | continue\\n        if same : row.source = ⟨file,number,number⟩ then\\n          let witness : SharedWitness reads := ⟨row,saved.property,file,number,code,same⟩\\n          let key := (file,number,code)\\n          index := index.insert key ((index.getD key #[]).push witness)\\n  let mut found := #[]\\n  for spelling in displayed do\\n    for witness in index.getD (spelling.file,spelling.number,spelling.code) #[] do\\n      let row := witness.row\\n      if spelling.origins.contains (row.binding.database,row.binding.owner,row.binding.work,row.occurrence) then\\n        found := found.push witness\\n  return found\\n\\n/-- Verify actual packet bytes against immutable raw coordinates before labelling. -/\\ndef presented (body : String) (docs : Array Document) (reads : Array Read) : Presentation := Id.run do\\n  let mut result : Presentation := {}\\n  for part in body.splitOn \\\"\\\\nWORK GRAPH \\\" do\\n    let some owner := (part.splitOn \\\"\\\\n\\\").head? | continue\\n    let some doc := docs.find? (·.owner == owner) | continue\\n    let some raw := doc.source | continue\\n    let blocks := part.splitOn \\\"  GROUNDED OUTCOME\\\\n\\\"\\n    let some evidence := blocks[1]? | continue\\n    let evidence := (evidence.splitOn \\\"  TRACE\\\\n\\\").head!\\n    let json := JsonScalars.prepare? raw\\n    let rawChars := match json with | some index => index.characters | none => raw.toList.toArray\\n    let evidenceChars := evidence.toList.toArray\\n    let mut spans := #[]\\n    let mut addressed := #[]\\n    let mut path : Option String := none\\n    let mut bad := false\\n    for line in textLines evidence do\\n      if line.text.startsWith \\\"  JSON PATH \\\" then\\n        path := some (String.ofList (line.text.toList.drop \\\"  JSON PATH \\\".length))\\n        continue\\n      let some (first, limit, decoded) := caption line.text | continue\\n      let location := json.bind (·.cover? first limit)\\n      let declared := path\\n      path := none\\n      if declared.isSome && !location.any (fun address => declared == some address.label) then\\n        bad := true\\n        continue\\n      if !(first < limit && limit ≤ rawChars.size) then bad := true; continue\\n      let segment := String.ofList (rawChars.extract first limit).toList\\n      let marker := \\\"  DECODED JSON STRING DATA\\\\n\\\"\\n      let marked := literal evidenceChars line.limit (line.limit+marker.length) marker\\n      let expected := if decoded || marked then\\n          (Json.parse (\\\"\\\\\\\"\\\" ++ segment ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption\\n        else some segment\\n      let some expected := expected | bad := true; continue\\n      let dataStart := line.limit + if marked then marker.length else 0\\n      if dataStart+expected.length > evidenceChars.size ||\\n          String.ofList (evidenceChars.extract dataStart (dataStart+expected.length)).toList != expected then\\n        bad := true\\n        continue\\n      spans := spans.push (first, limit)\\n      if let some address := location then\\n        if declared == some address.label then addressed := addressed.push (owner,first,limit,address.path)\\n    if spans.isEmpty then\\n      let decoded := (layout raw).toOption.map (·.text)\\n      if !raw.isEmpty && ((evidence.splitOn raw).length > 1 ||\\n          decoded.any (fun text => !text.isEmpty && (evidence.splitOn text).length > 1)) then\\n        spans := #[(0, raw.length)]\\n      else bad := true\\n    if bad then\\n      result := {result with uncertainOwners := result.uncertainOwners.insert owner}\\n      for file in doc.files do result := {result with uncertain := result.uncertain.insert file}\\n    else\\n      result := {result with\\n        bindings := result.bindings ++ spans.map (fun (a,b) => (owner,a,b))\\n        addressed := result.addressed ++ addressed}\\n    for row in reads do\\n      if row.binding.owner == owner && spans.any (fun (first, limit) =>\\n          first ≤ row.binding.first && row.binding.limit ≤ limit) then\\n        result := {result with ranges := result.ranges.push row.source}\\n  for witness in sharedPresented body docs reads do\\n    result := {result with\\n      ranges := result.ranges.push witness.row.source\\n      bindings := result.bindings.push\\n        (witness.row.binding.owner,witness.row.binding.first,witness.row.binding.limit)}\\n  return result\\n\\ndef Presentation.coversBinding (shown : Presentation) (binding : Binding) : Bool := Id.run do\\n  if shown.uncertainOwners.contains binding.owner then return false\\n  let spans := shown.bindings.filterMap fun (owner,first,limit) =>\\n    if owner == binding.owner then some (first,limit) else none\\n  let spans := spans.qsort fun a b => a.1 < b.1\\n  let covered := spans.foldl (fun position (first,limit) =>\\n    if first ≤ position then max position limit else position) binding.first\\n  return binding.first < binding.limit && binding.limit ≤ covered\\n\\ndef Presentation.coversAddress (shown : Presentation) (binding : Binding) (path : List JsonScalars.Segment) : Bool :=\\n  let bindings := shown.addressed.filterMap fun (owner,first,limit,actual) =>\\n    if actual == path then some (owner,first,limit) else none\\n  {shown with bindings}.coversBinding binding\\n\\ndef compactRanges (ranges : Array Range) : Array Range := Id.run do\\n  let mut files : Std.HashMap Subject (Array Range) := {}\\n  for range in ranges do files := files.insert range.subject (files[range.subject]?.getD #[] |>.push range)\\n  let mut result := #[]\\n  for (_, spans) in files do\\n    let mut merged : Array Range := #[]\\n    for span in spans.qsort (fun a b => a.first < b.first || (a.first == b.first && a.last < b.last)) do\\n      if let some previous := merged.back? then\\n        if span.first ≤ previous.last+1 then\\n          merged := merged.pop.push {previous with last := max previous.last span.last}\\n          continue\\n      merged := merged.push span\\n    result := result ++ merged\\n  return result\\n\\n/-- Stored overlap minus verified delivery; does not expand a citation's line count. -/\\ndef omittedRanges (requested : Range) (stored delivered : Array Range) : Array Range := Id.run do\\n  let mut result : Std.HashSet Range := {}\\n  for saved in compactRanges stored do\\n    if saved.subject != requested.subject then continue\\n    let first := max saved.first requested.first\\n    let last := min saved.last requested.last\\n    if last < first then continue\\n    let relevant := (delivered.filter (·.subject == requested.subject)).toList.mergeSort\\n      (fun a b => a.first ≤ b.first)\\n    let mut position := first\\n    for shown in relevant do\\n      if position > last then break\\n      if shown.last < position then continue\\n      if position < shown.first then\\n        result := result.insert {requested with first := position, last := min last (shown.first-1)}\\n      position := max position (shown.last+1)\\n    if position ≤ last then result := result.insert {requested with first := position, last}\\n  return result.toArray\\n\\nstructure Feedback where\\n  graph : Graph := .empty\\n  delivered : Presentation := {}\\n  atStart : Std.HashMap Occurrence Presentation := {}\\n\\ndef Feedback.present (feedback : Feedback) (packet : Presentation) : Feedback :=\\n  {feedback with delivered := {\\n    ranges := feedback.delivered.ranges ++ packet.ranges\\n    uncertain := feedback.delivered.uncertain.union packet.uncertain\\n    bindings := feedback.delivered.bindings ++ packet.bindings\\n    addressed := feedback.delivered.addressed ++ packet.addressed\\n    uncertainOwners := feedback.delivered.uncertainOwners.union packet.uncertainOwners }}\\n\\n/-- A PreToolUse packet arriving after proposal cannot rewrite what was known. -/\\ndef Feedback.start (feedback : Feedback) (occurrence : Occurrence) : Feedback :=\\n  if feedback.atStart.contains occurrence then feedback else\\n    {feedback with atStart := feedback.atStart.insert occurrence feedback.delivered}\\n\\ndef Feedback.completedRead (feedback : Feedback) (occurrence : Occurrence) (query : String)\\n    (requested stored : Array Range) : Except String Feedback := do\\n  let some earlier := feedback.atStart[occurrence]? | throw \\\"read has no observed start\\\"\\n  let mut graph := feedback.graph\\n  let mut ordinal := 0\\n  for source in compactRanges requested do\\n    let checked := match source.subject with\\n      | .file file => !earlier.uncertain.contains file\\n      | .original _ => earlier.uncertainOwners.isEmpty\\n    let gaps := if checked then omittedRanges source stored earlier.ranges else #[]\\n    for gap in if gaps.isEmpty then #[source] else gaps do\\n      graph ← graph.recordRead ⟨occurrence, ordinal, none⟩ query gap stored earlier.ranges checked\\n      ordinal := ordinal+1\\n  return {feedback with graph}\\n\\ndef Feedback.answer (feedback : Feedback) (occurrence : Occurrence) (query text : String) :\\n    Except String Feedback := do\\n  let files := feedback.delivered.ranges.foldl (fun files range =>\\n    (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n  let cited := paragraphCitations text files.toArray\\n  let mut graph := feedback.graph\\n  for index in [:cited.size] do\\n    graph ← graph.recordCitation ⟨occurrence, index, none⟩ query cited[index]! feedback.delivered.ranges\\n  return {feedback with graph}\\n\\n/-- A native usage label may cover only an actual located consumption witness.\\nThe native row remains tied to its original Work and response digest. -/\\nstructure ConsumedSource (edge : Consumption) where\\n  source : Range\\n  valid : edge.valid = true\\n  native : source.file?.isNone = true\\n  consumed : edge.rows.any (·.contains source) = true\\n\\ndef consumedSource? (edge : Consumption) (source : Range) : Option (ConsumedSource edge) :=\\n  if valid : edge.valid = true then\\n    if native : source.file?.isNone = true then\\n      if consumed : edge.rows.any (·.contains source) = true then\\n        some ⟨source,valid,native,consumed⟩ else none\\n    else none\\n  else none\\n\\ntheorem consumed_source_has_witness (checked : ConsumedSource edge) :\\n    ∃ row ∈ edge.rows, row.contains checked.source = true := by\\n  obtain ⟨index,bound,present⟩ := Array.any_eq_true.mp checked.consumed\\n  exact ⟨edge.rows[index],by simp,present⟩\\n\\ntheorem consumed_source_is_later (checked : ConsumedSource edge) :\\n    edge.producerFinish < edge.consumerStart := by\\n  exact Consumption.checked_before (edge := edge) (accepted := edge)\\n    (by simp [Consumption.checked,checked.valid])\\n\\n/-- Literal reuse is advisory evidence, not proof of semantic necessity. The\\ncaller supplies immutable pre-read stored and ACK ranges; no returned sibling\\nfield is labelled merely because it was present in the tool's response. -/\\ndef consumedUsage? (checked : ConsumedSource edge) (query : String)\\n    (stored delivered : Array Range) : Option Usage :=\\n  if covered checked.source stored && !covered checked.source delivered then some {\\n    event := {occurrence := edge.producer,ordinal := 0,consumption := some ⟨edge.consumer,checked.source⟩}\\n    query,source := checked.source,kind := .omittedThenConsumed}\\n  else none\\n\\ntheorem consumed_omission_requires_stored (checked : ConsumedSource edge)\\n    (observed : consumedUsage? checked query stored delivered = some usage) :\\n    covered checked.source stored = true ∧ covered checked.source delivered = false := by\\n  unfold consumedUsage? at observed\\n  split at observed\\n  next present => simpa only [Bool.and_eq_true,Bool.not_eq_true'] using present\\n  next => contradiction\\n\\ndef recordConsumed (graph : Graph) (checked : ConsumedSource edge) (query : String)\\n    (stored delivered : Array Range) : Except String Graph :=\\n  match consumedUsage? checked query stored delivered with\\n  | some usage => graph.insert (.used usage)\\n  | none => .ok graph\\n\\nend Eggshell.Synapses.Extraction\\n\",[]]"],["Eggshell.Synapses","[\"module\\n\\npublic import Std.Data.HashSet.Lemmas\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses\\nopen Lean\\n\\n/-- Recommendation evidence has no import of Value, Match or Union authority. -/\\nstructure File where\\n  relative : String\\n  fingerprint : String\\n  bytes : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef safeRelative (path : String) : Bool :=\\n  !path.isEmpty && !path.startsWith \\\"/\\\" && !path.contains '\\\\x00' &&\\n    (path.splitOn \\\"/\\\").all (fun part => !part.isEmpty && part != \\\".\\\" && part != \\\"..\\\")\\n\\ndef digest (text : String) : Bool :=\\n  text.length == 64 && text.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f'))\\n\\ndef File.valid (file : File) : Bool := safeRelative file.relative && digest file.fingerprint\\n\\n/-- Exact immutable output identity. A Work hash and its entire saved payload\\nidentify data across sessions without equating operations or their authority. -/\\nstructure Original where\\n  work : String\\n  content : String\\n  chars : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Original.valid (original : Original) : Bool :=\\n  !original.work.isEmpty && digest original.content\\n\\ninductive Subject where\\n  | file (file : File)\\n  | original (original : Original)\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ninstance : Coe File Subject := ⟨Subject.file⟩\\n\\ndef Subject.valid : Subject → Bool\\n  | .file data => data.valid\\n  | .original data => data.valid\\n\\ndef Subject.file? : Subject → Option File\\n  | .file data => some data\\n  | .original _ => none\\n\\ndef Subject.sameLocation (left right : Subject) : Bool := match left,right with\\n  | .file a,.file b => a.relative == b.relative\\n  | .original a,.original b => a.work == b.work\\n  | _,_ => false\\n\\n/-- Closed intervals over immutable subjects. File coordinates are line\\nnumbers; original-output coordinates are one-based character positions. -/\\nstructure Range where\\n  subject : Subject\\n  first : Nat\\n  last : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Range.valid (range : Range) : Bool :=\\n  range.subject.valid && 0 < range.first && range.first ≤ range.last &&\\n    match range.subject with | .file _ => true | .original original => range.last ≤ original.chars\\n\\ndef Range.file? (range : Range) : Option File := range.subject.file?\\n\\ndef Range.original (original : Original) (first limit : Nat) : Range :=\\n  ⟨.original original,first+1,limit⟩\\n\\ndef Range.contains (outer inner : Range) : Bool :=\\n  outer.subject == inner.subject && outer.first ≤ inner.first && inner.last ≤ outer.last\\n\\ntheorem Range.contains_self (range : Range) : range.contains range = true := by\\n  simp [Range.contains]\\n\\n/-- A saved part of a citation must lie in both original intervals. The\\nfingerprint is part of equality; a path match alone cannot make an overlap. -/\\ndef Range.intersection? (left right : Range) : Option Range :=\\n  let source := {left with first := max left.first right.first, last := min left.last right.last}\\n  if source.valid && left.contains source && right.contains source then some source else none\\n\\ntheorem Range.intersection_within {left right source : Range}\\n    (found : left.intersection? right = some source) :\\n    source.valid = true ∧ left.contains source = true ∧ right.contains source = true := by\\n  unfold intersection? at found\\n  dsimp only at found\\n  split at found\\n  · rename_i valid\\n    simp only [Option.some.injEq] at found\\n    subst source\\n    simpa only [Bool.and_eq_true, and_assoc] using valid\\n  · contradiction\\n\\nstructure Occurrence where\\n  session : String\\n  turn : String\\n  useId : String\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Occurrence.valid (occurrence : Occurrence) : Bool :=\\n  !occurrence.session.isEmpty && !occurrence.turn.isEmpty && !occurrence.useId.isEmpty\\n\\nstructure Binding where\\n  database : String\\n  owner : String\\n  work : String\\n  first : Nat\\n  limit : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Binding.valid (binding : Binding) : Bool :=\\n  !binding.database.isEmpty && !binding.owner.isEmpty && !binding.work.isEmpty &&\\n    binding.first < binding.limit\\n\\nstructure Read where\\n  occurrence : Occurrence\\n  source : Range\\n  binding : Binding\\n  /-- Selector keys only. Rebuild rechecks the original quoted spelling. -/\\n  quotations : Array String := #[]\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Read.valid (read : Read) : Bool :=\\n  read.occurrence.valid && read.source.valid && read.binding.valid && read.quotations.all digest &&\\n    match read.source.subject with\\n    | .file _ => true\\n    | .original original => original.work == read.binding.work &&\\n        read.source.first == read.binding.first+1 && read.source.last == read.binding.limit\\n\\ntheorem original_read_binding (read : Read) (original : Original)\\n    (kind : read.source.subject = .original original) (valid : read.valid = true) :\\n    original.work = read.binding.work ∧ read.source.first = read.binding.first+1 ∧\\n      read.source.last = read.binding.limit := by\\n  have checked := valid\\n  simp only [Read.valid,kind,Bool.and_eq_true,beq_iff_eq] at checked\\n  simpa only [and_assoc] using checked.2\\n\\nstructure Claim where\\n  database : String\\n  answer : String\\n  first : Nat\\n  limit : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Claim.valid (claim : Claim) : Bool :=\\n  !claim.database.isEmpty && !claim.answer.isEmpty && claim.first < claim.limit\\n\\nstructure Support where\\n  read : Read\\n  source : Range\\n  claim : Claim\\n  binding : Binding\\n  /-- The original citation can be wider than the part present in this read. -/\\n  cited : Range := source\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Support.valid (support : Support) : Bool :=\\n  support.read.valid && support.source.valid && support.claim.valid &&\\n    support.binding.valid && support.binding.database == support.read.binding.database &&\\n    support.binding.owner == support.read.binding.owner && support.binding.work == support.read.binding.work &&\\n    support.read.binding.first ≤ support.binding.first && support.binding.limit ≤ support.read.binding.limit &&\\n    support.cited.valid && support.cited.contains support.source &&\\n    support.read.source.contains support.source\\n\\n/-- The constructor checks the exact saved read covers the cited source range. -/\\ndef Support.checked (read : Read) (source : Range) (claim : Claim)\\n    (binding : Binding := read.binding) (cited : Range := source) : Except String Support :=\\n  let support := Support.mk read source claim binding cited\\n  if support.valid then .ok support else .error \\\"citation is not covered by its recorded read\\\"\\n\\ntheorem Support.checked_covers {read : Read} {source : Range} {claim : Claim}\\n    {binding : Binding} {cited : Range} {support : Support}\\n    (checked : Support.checked read source claim binding cited = .ok support) :\\n    read.source.contains source = true := by\\n  unfold Support.checked at checked\\n  dsimp only at checked\\n  split at checked\\n  next valid =>\\n    simp only [Support.valid, Bool.and_eq_true] at valid\\n    exact valid.2\\n  next => contradiction\\n\\ntheorem Support.checked_within_citation {read : Read} {source : Range} {claim : Claim}\\n    {binding : Binding} {cited : Range} {support : Support}\\n    (checked : Support.checked read source claim binding cited = .ok support) :\\n    cited.contains source = true := by\\n  unfold Support.checked at checked\\n  dsimp only at checked\\n  split at checked\\n  next valid =>\\n    simp only [Support.valid, Bool.and_eq_true] at valid\\n    exact valid.1.2\\n  next => contradiction\\n\\ninductive WitnessKind where\\n  | value | pathLine | path | identifier\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ninductive DataFormat where\\n  | text | json\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\nstructure Consumption where\\n  producer : Occurrence\\n  consumer : Occurrence\\n  producerFinish : Nat\\n  consumerStart : Nat\\n  kind : WitnessKind\\n  term : String\\n  inputFirst : Nat\\n  inputLimit : Nat\\n  outputFirst : Nat\\n  outputLimit : Nat\\n  inputFormat : DataFormat := .text\\n  outputFormat : DataFormat := .text\\n  /-- Only rows located in the actual producer output, never its entire read. -/\\n  rows : Array Range := #[]\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Consumption.valid (edge : Consumption) : Bool :=\\n  edge.producer.valid && edge.consumer.valid && edge.producer != edge.consumer &&\\n    edge.producerFinish < edge.consumerStart && !edge.term.isEmpty &&\\n    edge.inputFirst < edge.inputLimit && edge.outputFirst < edge.outputLimit &&\\n    edge.rows.all Range.valid\\n\\ndef Consumption.checked (edge : Consumption) : Except String Consumption :=\\n  if edge.valid then .ok edge else .error \\\"unavailable or invalid producer output\\\"\\n\\ntheorem Consumption.checked_before {edge accepted : Consumption}\\n    (checked : edge.checked = .ok accepted) : edge.producerFinish < edge.consumerStart := by\\n  unfold Consumption.checked at checked\\n  split at checked\\n  next valid =>\\n    simp only [Consumption.valid, Bool.and_eq_true, decide_eq_true_eq] at valid\\n    exact valid.1.1.1.1.2\\n  next => contradiction\\n\\ninductive Group where\\n  | answer (database owner : String)\\n  | claim (claim : Claim)\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Group.valid : Group → Bool\\n  | .answer database owner => !database.isEmpty && !owner.isEmpty\\n  | .claim value => value.valid\\n\\ninductive UsageKind where\\n  | omittedThenRead | omittedThenConsumed | deliveredThenCited | reread | sourceChanged\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef UsageKind.label : UsageKind → String\\n  | .omittedThenRead => \\\"omitted_then_read\\\"\\n  | .omittedThenConsumed => \\\"omitted_then_consumed\\\"\\n  | .deliveredThenCited => \\\"delivered_then_cited\\\"\\n  | .reread => \\\"reread\\\"\\n  | .sourceChanged => \\\"source_changed\\\"\\n\\nstructure ConsumptionUse where\\n  consumer : Occurrence\\n  source : Range\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\nstructure Event where\\n  occurrence : Occurrence\\n  ordinal : Nat\\n  consumption : Option ConsumptionUse := none\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, FromJson\\n\\n/-- A consumed range is keyed by its actual downstream use, independently of\\nwhich other ranges become used later. Ordinary observed ordinals stay distinct. -/\\ninstance : ToJson Event where\\n  toJson event := Json.mkObj ([\\n    (\\\"occurrence\\\",toJson event.occurrence),(\\\"ordinal\\\",toJson event.ordinal)] ++\\n    event.consumption.toList.map (fun value => (\\\"consumption\\\",toJson value)))\\n\\nstructure Usage where\\n  event : Event\\n  /-- Opaque digest, never a plaintext question in a shared DB. -/\\n  query : String\\n  source : Range\\n  kind : UsageKind\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Usage.valid (usage : Usage) : Bool :=\\n  usage.event.occurrence.valid && digest usage.query && usage.source.valid &&\\n    usage.event.consumption.all (fun cause => usage.event.ordinal == 0 && cause.consumer.valid &&\\n      cause.consumer != usage.event.occurrence && cause.source == usage.source)\\n\\ninductive Fact where\\n  | read (read : Read)\\n  | consumed (edge : Consumption)\\n  | supports (support : Support)\\n  | coquoted (group : Group) (source : Range)\\n  | used (usage : Usage)\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Fact.valid : Fact → Bool\\n  | .read value => value.valid\\n  | .consumed edge => edge.valid\\n  | .supports support => support.valid\\n  | .coquoted group source => group.valid && source.valid\\n  | .used usage => usage.valid\\n\\n/-- Evidence union is the lattice operation; counts are derived after union. -/\\ndef evidenceJoin [BEq α] [Hashable α] (left right : Std.HashSet α) : Std.HashSet α :=\\n  left.union right\\n\\ndef SameEvidence [BEq α] [Hashable α] (left right : Std.HashSet α) : Prop :=\\n  ∀ fact, left.contains fact = right.contains fact\\n\\ntheorem evidenceJoin_idempotent [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\\n    (evidence : Std.HashSet α) : SameEvidence (evidenceJoin evidence evidence) evidence := by\\n  intro fact\\n  simp [evidenceJoin, Std.HashSet.contains_union]\\n\\ntheorem evidenceJoin_commutative [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\\n    (left right : Std.HashSet α) : SameEvidence (evidenceJoin left right) (evidenceJoin right left) := by\\n  intro fact\\n  simp [evidenceJoin, Std.HashSet.contains_union, Bool.or_comm]\\n\\ntheorem evidenceJoin_associative [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\\n    (a b c : Std.HashSet α) :\\n    SameEvidence (evidenceJoin (evidenceJoin a b) c) (evidenceJoin a (evidenceJoin b c)) := by\\n  intro fact\\n  simp [evidenceJoin, Std.HashSet.contains_union, Bool.or_assoc]\\n\\ndef add [BEq α] [Hashable α] [BEq β] [Hashable β]\\n    (map : Std.HashMap α (Std.HashSet β)) (key : α) (value : β) :=\\n  map.insert key ((map[key]?.getD {}).insert value)\\n\\nstructure Graph where\\n  facts : Std.HashSet Fact := {}\\n  bindings : Std.HashMap Range (Std.HashSet Binding) := {}\\n  incoming : Std.HashMap Occurrence (Std.HashSet Consumption) := {}\\n  supported : Std.HashMap Claim (Std.HashSet Support) := {}\\n  groups : Std.HashMap Group (Std.HashSet Range) := {}\\n  quotedBy : Std.HashMap Range (Std.HashSet Group) := {}\\n  events : Std.HashMap Event Usage := {}\\n  usages : Std.HashMap Range (Std.HashSet Usage) := {}\\n\\ndef Graph.empty : Graph := {}\\n\\ndef Graph.bind (graph : Graph) (source : Range) (binding : Binding) : Graph :=\\n  {graph with bindings := add graph.bindings source binding}\\n\\n/-- Insertion is transactional. A repeated event cannot acquire a new label. -/\\ndef Graph.insert (graph : Graph) (fact : Fact) : Except String Graph := do\\n  unless fact.valid do throw \\\"invalid advisory evidence\\\"\\n  if graph.facts.contains fact then return graph\\n  let graph := {graph with facts := graph.facts.insert fact}\\n  match fact with\\n  | .read value => return graph.bind value.source value.binding\\n  | .consumed edge =>\\n    return {graph with incoming := add graph.incoming edge.consumer edge}\\n  | .supports support =>\\n    let graph := (graph.bind support.source support.binding).bind support.read.source support.read.binding\\n    return {graph with supported := add graph.supported support.claim support}\\n  | .coquoted group source =>\\n    return {graph with\\n      groups := add graph.groups group source\\n      quotedBy := add graph.quotedBy source group}\\n  | .used usage =>\\n    if let some previous := graph.events[usage.event]? then\\n      unless previous == usage do throw \\\"conflicting immutable usage event\\\"\\n    return {graph with\\n      events := graph.events.insert usage.event usage\\n      usages := add graph.usages usage.source usage}\\n\\ndef Graph.ofFacts (facts : Array Fact) : Except String Graph :=\\n  facts.foldlM Graph.insert Graph.empty\\n\\n/-- Canonical interchange is separate from hash-table iteration order. -/\\ndef Graph.snapshot (graph : Graph) : Array Fact :=\\n  graph.facts.toArray.qsort (fun a b => (toJson a).compress < (toJson b).compress)\\n\\ndef Graph.merge (left right : Graph) : Except String Graph :=\\n  Graph.ofFacts (evidenceJoin left.facts right.facts).toArray\\n\\ndef Graph.evidenceCount (graph : Graph) : Nat := graph.facts.size\\n\\ndef Graph.rangeCount (graph : Graph) : Nat :=\\n  let ranges := graph.facts.fold (fun ranges fact =>\\n    match fact with\\n    | .read value => ranges.insert value.source\\n    | .supports support => (ranges.insert support.source).insert support.read.source\\n    | .consumed edge => edge.rows.foldl (·.insert ·) ranges\\n    | .coquoted _ source => ranges.insert source\\n    | .used usage => ranges.insert usage.source) ({} : Std.HashSet Range)\\n  ranges.size\\n\\ndef Graph.sourceBindings (graph : Graph) (source : Range) : Array Binding :=\\n  (graph.bindings[source]?.getD {}).toArray\\n\\n/-- Closed interval union, bounded by observed intervals rather than line numbers. -/\\ndef covered (wanted : Range) (observed : Array Range) : Bool := Id.run do\\n  let rows := (observed.filter (·.subject == wanted.subject)).toList.mergeSort (fun a b => a.first ≤ b.first)\\n  let mut position := wanted.first\\n  for row in rows do\\n    if position < row.first then return false\\n    if position ≤ row.last then position := row.last + 1\\n    if wanted.last < position then return true\\n  return false\\n\\ndef readKind (requested : Range) (stored delivered : Array Range) (fingerprintChecked : Bool) : UsageKind :=\\n  if !fingerprintChecked then .reread\\n  else if covered requested stored then\\n    if covered requested delivered then .reread else .omittedThenRead\\n  else if stored.any (fun range => range.subject.sameLocation requested.subject && range.subject != requested.subject)\\n    then .sourceChanged\\n  else .reread\\n\\ntheorem omitted_requires_checked (requested : Range) (stored delivered : Array Range)\\n    (checked : Bool) (omitted : readKind requested stored delivered checked = .omittedThenRead) :\\n    checked = true := by\\n  cases checked <;> simp_all [readKind]\\n\\ntheorem omitted_requires_stored (requested : Range) (stored delivered : Array Range)\\n    (checked : Bool) (omitted : readKind requested stored delivered checked = .omittedThenRead) :\\n    covered requested stored = true ∧ covered requested delivered = false := by\\n  unfold readKind at omitted\\n  split at omitted\\n  next => contradiction\\n  next =>\\n    split at omitted\\n    next stored =>\\n      split at omitted\\n      next => contradiction\\n      next delivered => exact ⟨by simpa using stored, by simpa using delivered⟩\\n    next => split at omitted <;> contradiction\\n\\ndef Graph.recordRead (graph : Graph) (event : Event) (query : String) (requested : Range)\\n    (stored delivered : Array Range) (checked : Bool) : Except String Graph :=\\n  graph.insert (.used {\\n    event := event\\n    query := query\\n    source := requested\\n    kind := readKind requested stored delivered checked})\\n\\ndef Graph.recordCitation (graph : Graph) (event : Event) (query : String) (source : Range)\\n    (delivered : Array Range) : Except String Graph :=\\n  if covered source delivered then\\n    graph.insert (.used {event, query, source, kind := .deliveredThenCited})\\n  else .ok graph\\n\\nstructure UsageCounts where\\n  omittedThenRead : Nat := 0\\n  omittedThenConsumed : Nat := 0\\n  deliveredThenCited : Nat := 0\\n  reread : Nat := 0\\n  sourceChanged : Nat := 0\\n  deriving Repr, BEq, ToJson\\n\\ndef Graph.usageCounts (graph : Graph) (source : Range) (query : Option String := none) : UsageCounts :=\\n  (graph.usages[source]?.getD {}).fold (fun counts usage =>\\n    if query.any (· != usage.query) then counts else\\n    match usage.kind with\\n    | .omittedThenRead => {counts with omittedThenRead := counts.omittedThenRead + 1}\\n    | .omittedThenConsumed => {counts with omittedThenConsumed := counts.omittedThenConsumed + 1}\\n    | .deliveredThenCited => {counts with deliveredThenCited := counts.deliveredThenCited + 1}\\n    | .reread => {counts with reread := counts.reread + 1}\\n    | .sourceChanged => {counts with sourceChanged := counts.sourceChanged + 1}) {}\\n\\n/-- Incidence traversal visits each shared answer once, without building cliques. -/\\ndef Graph.companions (graph : Graph) (sources : Array Range) : Std.HashMap Range Nat := Id.run do\\n  let mut groups : Std.HashSet Group := {}\\n  for source in sources do\\n    for group in graph.quotedBy[source]?.getD {} do\\n      if let .answer .. := group then groups := groups.insert group\\n  let mut counts : Std.HashMap Range Nat := {}\\n  for group in groups do\\n    for source in graph.groups[group]?.getD {} do\\n      counts := counts.insert source (counts[source]?.getD 0 + 1)\\n  return counts\\n\\nstructure Relevant where\\n  ranges : Std.HashSet Range := {}\\n  occurrences : Std.HashSet Occurrence := {}\\n  unlocated : Array Consumption := #[]\\n\\n/-- Supports seed reverse consumption. Only located witness rows add body ranges. -/\\ndef Graph.relevant (graph : Graph) (claims : Array Claim) : Relevant := Id.run do\\n  let mut result : Relevant := {}\\n  let mut queue : Array Occurrence := #[]\\n  for claim in claims do\\n    for support in graph.supported[claim]?.getD {} do\\n      result := {result with ranges := result.ranges.insert support.source}\\n      queue := queue.push support.read.occurrence\\n  let mut position := 0\\n  while position < queue.size do\\n    let some occurrence := queue[position]? | break\\n    position := position + 1\\n    if result.occurrences.contains occurrence then continue\\n    result := {result with occurrences := result.occurrences.insert occurrence}\\n    for edge in graph.incoming[occurrence]?.getD {} do\\n      result := {result with ranges := edge.rows.foldl (·.insert ·) result.ranges}\\n      if edge.rows.isEmpty then result := {result with unlocated := result.unlocated.push edge}\\n      queue := queue.push edge.producer\\n  return result\\n\\nend Eggshell.Synapses\\n\",[]]"],["Eggshell.SynapticBindings","[\"module\\npublic import Eggshell.SynapseIndex\\npublic import Eggshell.HashDistinct\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.IndexedBindings\\nopen Lean DB\\n\\n/-- Source bindings already exist in source postings. Quotation selector keys\\ndo not distinguish original observations or duplicate their payload. -/\\ndef candidate? : Fact → Option Read\\n  | .read read => some {read with quotations := #[]}\\n  | .supports support => some {\\n      occurrence := support.read.occurrence\\n      source := support.source\\n      binding := support.binding\\n      quotations := #[]}\\n  | _ => none\\n\\nstructure Origin (database : String) (allowed : Std.HashSet String) (source : Range) where\\n  fact : Fact\\n  factValid : fact.valid = true\\n  read : Read\\n  projection : candidate? fact = some read\\n  valid : read.valid = true\\n  sourceExact : read.source = source\\n  databaseExact : read.binding.database = database\\n  admitted : allowed.contains read.binding.owner = true\\n\\ndef check? (database : String) (allowed : Std.HashSet String) (source : Range) (fact : Fact) :\\n    Option (Origin database allowed source) := do\\n  if factValid : fact.valid = true then\\n    match projection : candidate? fact with\\n    | none => none\\n    | some read =>\\n      if valid : read.valid = true then\\n        if same : read.source = source then\\n          if sameDatabase : read.binding.database = database then\\n            if admitted : allowed.contains read.binding.owner = true then\\n              some ⟨fact,factValid,read,projection,valid,same,sameDatabase,admitted⟩ else none\\n          else none\\n        else none\\n      else none\\n  else none\\n\\ntheorem Origin.only_admitted_owner (origin : Origin database allowed source) :\\n    allowed.contains origin.read.binding.owner = true := origin.admitted\\n\\ntheorem Origin.same_source (origin : Origin database allowed source) :\\n    origin.read.source = source := origin.sourceExact\\n\\ntheorem Origin.same_database (origin : Origin database allowed source) :\\n    origin.read.binding.database = database := origin.databaseExact\\n\\nstructure Lookup (database : String) (allowed : Std.HashSet String) (source : Range) where\\n  origins : Array (Origin database allowed source)\\n  complete : Bool\\n  index : PageMap.Head\\n  inspected : Nat\\n  bytes : Nat\\n  unusable : Nat\\n\\n/-- One exact source-posting lookup, no Work/body restoration or source\\nparser. This returns advisory metadata, never a Match or completion proof. -/\\ndef lookup (reader : Index.Reader) (source : Range) (allowed : Std.HashSet String)\\n    (deadline : Nat) (byteLimit : Nat := 8*1024*1024) :\\n    IO (Lookup reader.manifest.source.identity allowed source) := do\\n  let found ← reader.lookup (.source source) 32768 deadline (some byteLimit)\\n  let mut origins := #[]\\n  let mut seen : Std.HashSet Read := {}\\n  let mut unusable := 0\\n  for checked in found.checked do\\n    if (candidate? checked.fact).any (fun read => !read.valid) then unusable := unusable+1\\n    let some origin := check? reader.manifest.source.identity allowed source checked.fact | continue\\n    if seen.contains origin.read then continue\\n    seen := seen.insert origin.read\\n    origins := origins.push origin\\n  return ⟨origins,found.complete && unusable == 0,found.index,found.checked.size,found.payloadBytes,unusable⟩\\n\\nstructure Resolved where\\n  rows : Std.HashMap Range (Array Read) := {}\\n  complete : Bool := true\\n  requests : Nat := 0\\n  inspected : Nat := 0\\n  bytes : Nat := 0\\n  unresolved : Nat := 0\\n  unusable : Nat := 0\\n\\ndef resolve (reader : Index.Reader) (wanted : Array Range) (allowed : Std.HashSet String)\\n    (deadline : Nat) : IO Resolved := do\\n  let mut result : Resolved := {}\\n  for source in (hashDistinct wanted.toList).toArray do\\n    if (← IO.monoMsNow) ≥ deadline || result.bytes ≥ 32*1024*1024 then\\n      return {result with complete := false}\\n    let found ← lookup reader source allowed deadline (32*1024*1024-result.bytes)\\n    let rows := found.origins.map (·.read)\\n    result := {\\n      rows := result.rows.insert source rows\\n      complete := result.complete && found.complete\\n      requests := result.requests+1\\n      inspected := result.inspected+found.inspected\\n      bytes := result.bytes+found.bytes\\n      unusable := result.unusable+found.unusable\\n      unresolved := result.unresolved + if rows.isEmpty then 1 else 0}\\n  return result\\n\\nend Eggshell.Synapses.IndexedBindings\\n\",[]]"],["Eggshell.SynapticRouting","[\"module\\n\\npublic import Eggshell.SynapseRecommend\\n\\n@[expose] public section\\nnamespace Eggshell.Synapses.Routing\\nopen Lean Recommend\\n\\n/-- The serialized digest is computed once when preparing the arena. Multiple\\nadjacency entries share this checked original fact rather than reparsing it. -/\\nstructure Evidence where\\n  fact : Fact\\n  identity : String\\n  exact : identity = Index.contentKey fact\\n  valid : fact.valid = true\\n\\nstructure Arc where\\n  evidence : Nat\\n  targets : Array Nat\\n  next : Array Nat\\n\\nstructure Arena where\\n  keys : Array Index.Key := #[]\\n  keyIds : Std.HashMap String Nat := {}\\n  targets : Array Target := #[]\\n  targetIds : Std.HashMap String Nat := {}\\n  evidence : Array Evidence := #[]\\n  adjacency : Array (Array Arc) := #[]\\n\\ndef internKey (arena : Arena) (key : Index.Key) : Arena × Nat :=\\n  let spelling := (toJson key).compress\\n  match arena.keyIds[spelling]? with\\n  | some id => (arena,id)\\n  | none => ({arena with\\n      keys := arena.keys.push key\\n      keyIds := arena.keyIds.insert spelling arena.keys.size\\n      adjacency := arena.adjacency.push #[]},arena.keys.size)\\n\\ndef internTarget (arena : Arena) (target : Target) : Arena × Nat :=\\n  let spelling := (toJson target).compress\\n  match arena.targetIds[spelling]? with\\n  | some id => (arena,id)\\n  | none => ({arena with\\n      targets := arena.targets.push target\\n      targetIds := arena.targetIds.insert spelling arena.targets.size},arena.targets.size)\\n\\n/-- Facts must arrive in canonical digest order, as in the source fact tree.\\nAn absent or corrupt fact is rejected before any route becomes available. -/\\ndef Arena.add (arena : Arena) (fact : Fact) : Except String Arena := do\\n  if valid : fact.valid = true then\\n    let identity := Index.contentKey fact\\n    let evidence := arena.evidence.size\\n    let mut arena := {arena with evidence := arena.evidence.push ⟨fact,identity,rfl,valid⟩}\\n    for key in Index.addresses fact do\\n      let step := project key fact\\n      if step.targets.isEmpty && step.next.isEmpty then continue\\n      let (updated,id) := internKey arena key\\n      arena := updated\\n      let mut targets := #[]\\n      for target in step.targets do\\n        let (updated,targetId) := internTarget arena target\\n        arena := updated\\n        targets := targets.push targetId\\n      let mut next := #[]\\n      for successor in step.next do\\n        let (updated,successorId) := internKey arena successor\\n        arena := updated\\n        next := next.push successorId\\n      arena := {arena with\\n        adjacency := arena.adjacency.modify id (·.push ⟨evidence,targets,next⟩)}\\n    return arena\\n  else throw \\\"invalid routing evidence\\\"\\n\\ndef Arena.prepare (facts : Array Fact) : Except String Arena :=\\n  facts.foldlM Arena.add {}\\n\\nstructure Walk where\\n  offers : Array Offer := #[]\\n  nodes : Nat := 0\\n  arcs : Nat := 0\\n  complete : Bool := true\\n\\n/-- The query loop uses integer nodes and shared checked facts. The arena is\\nimmutable and disposable; this prototype is not a whole-DB resident service. -/\\ndef Arena.walk (arena : Arena) (roots : Array (Index.Key × Nat))\\n    (deadline : Nat) (arcLimit : Nat) : IO Walk := do\\n  let roots := roots.qsort fun a b =>\\n    if a.2 == b.2 then (toJson a.1).compress < (toJson b.1).compress else a.2 < b.2\\n  let mut visited : Std.HashSet Nat := {}\\n  let mut result : Walk := {}\\n  for (root,priority) in roots do\\n    let some rootId := arena.keyIds[(toJson root).compress]? | continue\\n    let mut queue := #[rootId]\\n    let mut position := 0\\n    while position < qu
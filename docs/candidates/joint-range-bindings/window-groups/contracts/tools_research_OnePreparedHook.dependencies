ws[first].code\\n    let indented := 1 < indices.length &&\\n      indices.tail.all (fun index => level < indentation rows[index].code) &&\\n      (rows[after].code.trimAscii.isEmpty || indentation rows[after].code ≤ level)\\n    adjacent && (paragraph || indented) && file.valid &&\\n      (indices.zipIdx.all fun (index,offset) => rows[index].key.file == file &&\\n        rows[index].key.line == start+offset && !rows[index].code.trimAscii.isEmpty) &&\\n      rows[after].key.file == file && rows[after].key.line == start+indices.length &&\\n      (indices.map fun index => rows[index].code.length+1).sum ≤ 2048\\n\\nstructure Record (rows : Array StoredRow) where\\n  indices : List (Fin rows.size)\\n  before : Option (Fin rows.size)\\n  after : Fin rows.size\\n  checked : valid rows indices before after = true\\n\\ndef check? (rows : Array StoredRow) (indices : List (Fin rows.size))\\n    (before : Option (Fin rows.size)) (after : Fin rows.size) : Option (Record rows) :=\\n  if checked : valid rows indices before after = true then some ⟨indices,before,after,checked⟩ else none\\n\\ndef prepare (rows : Array StoredRow) : List (Record rows) := Id.run do\\n  let order := (List.finRange rows.size).mergeSort fun a b =>\\n    if rows[a].key.file == rows[b].key.file then rows[a].key.line ≤ rows[b].key.line\\n    else (toJson rows[a].key.file).compress ≤ (toJson rows[b].key.file).compress\\n  let mut result := []\\n  let mut previous : Option (Fin rows.size) := none\\n  let mut before : Option (Fin rows.size) := none\\n  let mut pending := []\\n  for index in order do\\n    let row := rows[index]\\n    let adjacent := previous.any fun prior => rows[prior].key.file == row.key.file &&\\n      rows[prior].key.line+1 == row.key.line\\n    if !adjacent then\\n      before := none\\n      pending := []\\n    if row.code.trimAscii.isEmpty then\\n      if let some record := check? rows pending before index then result := result ++ [record]\\n      pending := []\\n      before := some index\\n    else pending := pending ++ [index]\\n    previous := some index\\n  -- A condition can span several numbered lines without a blank separator.\\n  -- Consider only an observed entry followed by more-indented original rows;\\n  -- its next same-or-less-indented row is the observed closing boundary.\\n  -- Bound the scan by the same source-record limit, not by a line heuristic.\\n  let ordered := order.toArray\\n  for position in List.finRange ordered.size do\\n    let index := ordered[position]\\n    if rows[index].code.trimAscii.isEmpty then continue\\n    let level := indentation rows[index].code\\n    let mut indices := [index]\\n    let mut chars := rows[index].code.length+1\\n    let mut cursor := position.val+1\\n    let mut priorIndex := index\\n    while cursor < ordered.size && chars ≤ 2048 do\\n      let some next := ordered[cursor]? | break\\n      if rows[next].key.file != rows[index].key.file ||\\n          rows[priorIndex].key.line+1 != rows[next].key.line then break\\n      if rows[next].code.trimAscii.isEmpty || indentation rows[next].code ≤ level then\\n        let entryBefore := if position.val == 0 then none else ordered[position.val-1]?\\n        if let some record := check? rows indices entryBefore next then result := result ++ [record]\\n        break\\n      indices := indices ++ [next]\\n      chars := chars+rows[next].code.length+1\\n      priorIndex := next\\n      cursor := cursor+1\\n  return result\\n\\n/-- Selection cannot purchase a proper prefix of an admitted bounded record.\\nUnobserved lines, read gaps, a different fingerprint and unbounded paragraphs\\nsupply no additional row. The original requested rows are always retained. -/\\ndef closeIndices (records : List (Record rows)) (requested : List (Fin rows.size)) : List (Fin rows.size) :=\\n  hashDistinct (requested ++ (records.filter fun record =>\\n    record.indices.any requested.contains).flatMap (·.indices))\\n\\ntheorem requested_retained (records : List (Record rows)) (requested : List (Fin rows.size))\\n    (index : Fin rows.size) (present : index ∈ requested) : index ∈ closeIndices records requested := by\\n  rw [closeIndices,HashDistinct.reference]\\n  exact List.mem_eraseDups.mpr (List.mem_append_left _ present)\\n\\ntheorem complete_record_retained (records : List (Record rows)) (requested : List (Fin rows.size))\\n    (record : Record rows) (admitted : record ∈ records)\\n    (witness : Fin rows.size) (hint : witness ∈ requested) (inside : witness ∈ record.indices)\\n    (index : Fin rows.size) (member : index ∈ record.indices) : index ∈ closeIndices records requested := by\\n  rw [closeIndices,HashDistinct.reference]\\n  apply List.mem_eraseDups.mpr\\n  apply List.mem_append_right\\n  apply List.mem_flatMap.mpr\\n  refine ⟨record,List.mem_filter.mpr ⟨admitted,?_⟩,member⟩\\n  exact List.any_eq_true.mpr ⟨witness,inside,by simpa using hint⟩\\n\\ndef close (rows : Array StoredRow) (records : List (Record rows))\\n    (requested : List (Fin rows.size)) : Array StoredRow :=\\n  ((closeIndices records requested).map fun index => rows[index]).toArray\\n\\n/-- Query-independent original domain. Bounded records remain whole; a row\\nwithout such a record gets its own original unit. Relevance never determines\\nwhich stored row can be purchased. The set is prepared once, not per hint. -/\\ndef catalogue (rows : Array StoredRow) (records : List (Record rows)) :\\n    List (List (Fin rows.size)) :=\\n  let entries := records.map (·.indices)\\n  let covered := Std.HashSet.ofList entries.flatten\\n  entries ++ ((List.finRange rows.size).filter fun index => !covered.contains index).map (fun index => [index])\\n\\ntheorem catalogue_complete (rows : Array StoredRow) (records : List (Record rows))\\n    (index : Fin rows.size) : index ∈ (catalogue rows records).flatten := by\\n  simp only [catalogue,List.flatten_append]\\n  by_cases present : index ∈ (records.map (·.indices)).flatten\\n  · exact List.mem_append_left _ present\\n  · apply List.mem_append_right\\n    apply List.mem_flatten.mpr\\n    refine ⟨[index],?_,by simp⟩\\n    apply List.mem_map.mpr\\n    refine ⟨index,?_,rfl⟩\\n    simpa [Std.HashSet.contains_ofList] using present\\n\\ntheorem catalogue_payload_original (rows : Array StoredRow) (records : List (Record rows))\\n    (indices : List (Fin rows.size)) (_member : indices ∈ catalogue rows records)\\n    (index : Fin rows.size) (_inside : index ∈ indices) : rows[index] ∈ rows :=\\n  Array.getElem_mem index.isLt\\n\\ntheorem closed_row_is_original (rows : Array StoredRow) (records : List (Record rows))\\n    (requested : List (Fin rows.size)) (row : StoredRow) (member : row ∈ close rows records requested) :\\n    row ∈ rows := by\\n  simp only [close,List.mem_toArray,List.mem_map] at member\\n  obtain ⟨index,_,equal⟩ := member\\n  subst row\\n  exact Array.getElem_mem index.isLt\\n\\nend Eggshell.Synapses.CanonicalSource.Records\\n\"]]]"],["Eggshell.CanonicalSourcePacket","[\"module\\npublic import Eggshell.CanonicalSource\\npublic import tools.SharedCoverage\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.CanonicalSource.Packet\\nopen Lean\\n\\n/-- The producer supplies its existing cue identity and weight. This adapter\\nchanges the payload basis, not relevance, thresholds or certification. A\\nmulti-range input is one indivisible dependency closure. -/\\nstructure Input where\\n  cue : String\\n  weight : Nat\\n  sources : Array Range\\n\\nstructure FileFrame where\\n  file : File\\n  leading : String\\n  trailing : String\\n\\ndef rowText (row : StoredRow) : String := toString row.key.line ++ \\\"\\\\t\\\" ++ row.code ++ \\\"\\\\n\\\"\\n\\ndef wrapper : String := \\\"EGGSHELL SHARED SOURCE DATA\\\\nOriginal recorded file data; advisory, not a completed operation.\\\\n\\\"\\ndef footer : String := \\\"END EGGSHELL SHARED SOURCE DATA\\\\n\\\"\\n\\ndef fileFrame (file : File) (rows : Array StoredRow) : FileFrame :=\\n  let origins := rows.foldl (fun found row => row.origins.foldl (fun found origin =>\\n    found.insert (origin.binding.database,origin.binding.owner,origin.binding.work,origin.occurrence)) found)\\n    ({} : Std.HashSet (String × String × String × Occurrence))\\n  let references := origins.toArray.map (fun origin => (toJson origin).compress) |>.qsort (· < ·)\\n  ⟨file,\\\"SOURCE \\\" ++ (toJson file).compress ++ \\\"\\\\nORIGINAL READS \\\" ++\\n    (toJson references).compress ++ \\\"\\\\nCODE\\\\n\\\",\\\"END SOURCE\\\\n\\\"⟩\\n\\nstructure Prepared where\\n  registry : Registry\\n  rows : Array StoredRow\\n  original : rows.all (fun row => (registry.atoms[row.key]?).any (fun atom => atom.code == row.code)) = true\\n  keysUnique : (rows.toList.map (·.key)).Nodup\\n  frames : Array FileFrame\\n  problem : SharedCoverage.Problem\\n  unlocated : Array String\\n\\ndef prepare (registry : Registry) (inputs : Array Input) (limit : Nat × Nat) : Except String Prepared := do\\n  let rows := registry.store.qsort fun a b =>\\n    if a.key.file == b.key.file then a.key.line < b.key.line\\n    else (toJson a.key.file).compress < (toJson b.key.file).compress\\n  let files := rows.foldl (fun files row => files.insert row.key.file) ({} : Std.HashSet File)\\n  let files := files.toArray.qsort fun a b => (toJson a).compress < (toJson b).compress\\n  let frames := files.map fun file => fileFrame file (rows.filter (·.key.file == file))\\n  let costs := frames.map (fun frame => (frame.leading.length+frame.trailing.length,\\n    frame.leading.utf8ByteSize+frame.trailing.utf8ByteSize)) ++ rows.map (fun row =>\\n      let text := rowText row\\n      (text.length,text.utf8ByteSize))\\n  let mut rowIds : Std.HashMap Key Nat := {}\\n  for index in List.finRange rows.size do rowIds := rowIds.insert rows[index].key index.val\\n  let mut fileIds : Std.HashMap File Nat := {}\\n  for index in [:files.size] do fileIds := fileIds.insert files[index]! index\\n  let mut cueIds : Std.HashMap String Nat := {}\\n  let mut weights := #[]\\n  for input in inputs do\\n    if let some index := cueIds[input.cue]? then\\n      unless weights[index]? == some input.weight do throw \\\"inconsistent canonical cue weight\\\"\\n    else\\n      cueIds := cueIds.insert input.cue weights.size\\n      weights := weights.push input.weight\\n  let mut offers : Array (SharedCoverage.Offer costs.size weights.size) := #[]\\n  let mut unlocated := #[]\\n  for input in inputs do\\n    let resolved := input.sources.mapM fun source => (registry.resolve? source).map (·.rows)\\n    let some parts := resolved | unlocated := unlocated.push input.cue; continue\\n    if parts.isEmpty then unlocated := unlocated.push input.cue; continue\\n    let closure : Option (List (Fin costs.size)) := parts.flatten.toList.flatMapM fun row => do\\n      let index ← rowIds[row.key]?\\n      let file ← fileIds[row.key.file]?\\n      if rowBound : frames.size+index < costs.size then\\n        if fileBound : file < costs.size then\\n          some [⟨file,fileBound⟩,⟨frames.size+index,rowBound⟩]\\n        else none\\n      else none\\n    let some closure := closure | throw \\\"canonical payload directory lost an original row\\\"\\n    let some cue := cueIds[input.cue]? | throw \\\"canonical cue directory lost an input\\\"\\n    if cueBound : cue < weights.size then offers := offers.push ⟨closure,[⟨cue,cueBound⟩]⟩\\n    else throw \\\"canonical cue directory is out of bounds\\\"\\n  let problem : SharedCoverage.Problem := {\\n    costs,weights,offers,limit\\n    fixed := (wrapper.length+footer.length,wrapper.utf8ByteSize+footer.utf8ByteSize)}\\n  if original : rows.all (fun row => (registry.atoms[row.key]?).any (fun atom => atom.code == row.code)) = true then\\n    if unique : HashDistinct.unique (rows.toList.map (·.key)) = true then\\n      return ⟨registry,rows,original,(HashDistinct.unique_exact _).mp unique,frames,problem,unlocated⟩\\n    else throw \\\"canonical packet has duplicate source keys\\\"\\n  else throw \\\"canonical packet differs from its original source registry\\\"\\n\\ntheorem source_key_identifies_one_payload (prepared : Prepared) (left right : Fin prepared.rows.size)\\n    (same : prepared.rows[left].key = prepared.rows[right].key) : left = right := by\\n  have first : left.val < (prepared.rows.toList.map (·.key)).length := by simp\\n  have second : right.val < (prepared.rows.toList.map (·.key)).length := by simp\\n  have equal : (prepared.rows.toList.map (·.key))[left.val] =\\n      (prepared.rows.toList.map (·.key))[right.val] := by simpa using same\\n  exact Fin.ext ((List.getElem_inj prepared.keysUnique).mp equal)\\n\\ndef selectedRows (prepared : Prepared) (selection : SharedCoverage.Selection prepared.problem) : Array StoredRow :=\\n  let included := SharedCoverage.nodes prepared.problem selection.selected\\n  prepared.rows.zipIdx.filterMap fun (row,index) =>\\n    if included.any (·.val == prepared.frames.size+index) then some row else none\\n\\ntheorem selected_row_is_original (prepared : Prepared) (selection : SharedCoverage.Selection prepared.problem)\\n    (row : StoredRow) (member : row ∈ selectedRows prepared selection) :\\n    ∃ atom, prepared.registry.atoms[row.key]? = some atom ∧ atom.code = row.code := by\\n  simp only [selectedRows,Array.mem_filterMap] at member\\n  obtain ⟨pair,present,accepted⟩ := member\\n  split at accepted\\n  · simp only [Option.some.injEq] at accepted\\n    have original := (Array.all_eq_true'.mp prepared.original) pair.1\\n      (Array.mem_of_getElem? (Array.mem_zipIdx_iff_getElem?.mp present))\\n    simpa only [accepted,Option.any_eq_true,beq_iff_eq] using original\\n  · contradiction\\n\\ndef render (prepared : Prepared) (selection : SharedCoverage.Selection prepared.problem) : String :=\\n  let rows := selectedRows prepared selection\\n  wrapper ++ \\\"\\\".intercalate (prepared.frames.toList.filterMap fun frame =>\\n    let included := rows.filter (·.key.file == frame.file)\\n    if included.isEmpty then none else some (frame.leading ++\\n      \\\"\\\".intercalate (included.toList.map rowText) ++ frame.trailing)) ++ footer\\n\\nstructure Output (prepared : Prepared) where\\n  selection : SharedCoverage.Selection prepared.problem\\n  text : String\\n  original : text = render prepared selection\\n  charsFit : text.length ≤ prepared.problem.limit.1\\n  bytesFit : text.utf8ByteSize ≤ prepared.problem.limit.2\\n\\n/-- The wire body and the shared-closure costs are independently bounded.\\nNo truncated range or unlocated member can become a credited input. -/\\ndef fit? (prepared : Prepared) : Option (Output prepared) := do\\n  let selection ← SharedCoverage.choose? prepared.problem\\n  let text := render prepared selection\\n  if fits : text.length ≤ prepared.problem.limit.1 ∧ text.utf8ByteSize ≤ prepared.problem.limit.2 then\\n    some ⟨selection,text,rfl,fits.1,fits.2⟩\\n  else none\\n\\ntheorem output_within_wire_limits (output : Output prepared) :\\n    output.text.length ≤ prepared.problem.limit.1 ∧ output.text.utf8ByteSize ≤ prepared.problem.limit.2 :=\\n  ⟨output.charsFit,output.bytesFit⟩\\n\\ntheorem physical_payload_charged_once (prepared : Prepared) (output : Output prepared) :\\n    (SharedCoverage.nodes prepared.problem output.selection.selected).Nodup :=\\n  SharedCoverage.duplicate_payload_charged_once _ _\\n\\nend Eggshell.Synapses.CanonicalSource.Packet\\n\",[]]"],["Eggshell.CanonicalSourcePrepared","[\"module\\n\\npublic import Eggshell.CanonicalSourceCache\\npublic import Eggshell.CanonicalSourceDelivery\\npublic import Std.Sync.Mutex\\npublic import Init.System.Promise\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.CanonicalSource.Shared\\nopen Lean DB\\n\\ndef allOwners (registry : Registry) : Std.HashSet (String × String) := Id.run do\\n  let mut allowed : Std.HashSet (String × String) := {}\\n  for (_,atom) in registry.atoms do\\n    for origin in atom.origins do\\n      allowed := allowed.insert (origin.binding.database,origin.binding.owner)\\n  return allowed\\n\\nstructure Loaded where\\n  ready : Cache.Ready\\n  owners : Std.HashMap String (Array StoredRow)\\n  exact : owners = Delivery.byOwner ready.registry (allOwners ready.registry)\\n  /-- Opened once for the pinned preparation, sharing the bounded PageMap\\n  -- block cache across sessions. No per-session original record rebuild. -/\\n  originals : Option Index.Reader := none\\n\\n/-- All owners are projected once. Filtering the request then performs point\\nlookups; neither a full registry nor another customer's state crosses the wire. -/\\ndef Loaded.make (ready : Cache.Ready) : Loaded :=\\n  ⟨ready,Delivery.byOwner ready.registry (allOwners ready.registry),rfl,none⟩\\n\\ntheorem Loaded.lookup_exact (loaded : Loaded) (owner : String) :\\n    loaded.owners[owner]? =\\n      (Delivery.byOwner loaded.ready.registry (allOwners loaded.ready.registry))[owner]? := by\\n  rw [loaded.exact]\\n\\ndef Loaded.rows (loaded : Loaded) (owners : Array String) : Array (String × Array StoredRow) :=\\n  owners.map fun owner => (owner,loaded.owners[owner]?.getD #[])\\n\\ntheorem Loaded.requested_domain (loaded : Loaded) (owners : Array String) :\\n    (loaded.rows owners).map Prod.fst = owners := by\\n  simp [Loaded.rows,Array.map_map,Function.comp_def]\\n\\nstructure Budget (capacity : Nat) where\\n  used : Nat := 0\\n  within : used ≤ capacity := by omega\\n\\ndef Budget.reserve? (budget : Budget capacity) (amount : Nat) : Option (Budget capacity) :=\\n  if fits : budget.used+amount ≤ capacity then some ⟨budget.used+amount,fits⟩ else none\\n\\ndef Budget.release (budget : Budget capacity) (amount : Nat) : Budget capacity :=\\n  ⟨budget.used-amount,Nat.le_trans (Nat.sub_le ..) budget.within⟩\\n\\ntheorem Budget.reserved_within (budget next : Budget capacity) (amount : Nat)\\n    (_reserved : budget.reserve? amount = some next) : next.used ≤ capacity := next.within\\n\\ndef capacity : Nat := 512*1024*1024\\ndef maxLoads : Nat := 2\\ndef maxEntries : Nat := 128\\n\\nstructure Entry where\\n  promise : IO.Promise (Except String Loaded)\\n  charge : Nat\\n  borrowers : Nat\\n  stamp : Nat\\n  serial : Nat\\n  loading : Bool := true\\n\\nstructure State where\\n  entries : Std.HashMap String Entry := {}\\n  budget : Budget capacity := {}\\n  active : Nat := 0\\n  clock : Nat := 0\\n  closed : Bool := false\\n  loads : Nat := 0\\n  hits : Nat := 0\\n  joins : Nat := 0\\n  evictions : Nat := 0\\n  readBytes : Nat := 0\\n\\nstructure Pool where\\n  state : Std.Mutex State\\n  tasks : Std.Mutex (Array (Task (Except IO.Error Unit)))\\n\\ndef Pool.new : IO Pool := return ⟨← Std.Mutex.new {},← Std.Mutex.new #[]⟩\\n\\ninductive Admission where\\n  | borrowed (entry : Entry)\\n  | start (entry : Entry)\\n  | busy\\n\\ndef evict (state : State) : Option State := do\\n  let idle := state.entries.toArray.filter fun (_,entry) => !entry.loading && entry.borrowers == 0\\n  let (key,entry) ← (idle.qsort fun a b => a.2.stamp < b.2.stamp)[0]?\\n  return {state with\\n    entries := state.entries.erase key\\n    budget := state.budget.release entry.charge\\n    evictions := state.evictions+1}\\n\\ndef reclaim (state : State) (charge : Nat) : Nat → State\\n  | 0 => state\\n  | fuel+1 =>\\n      if state.budget.used+charge ≤ capacity && state.entries.size < maxEntries then state else\\n      match evict state with\\n      | none => state\\n      | some next => reclaim next charge fuel\\n\\ndef State.borrow? (state : State) (key : String) : Option (State × Entry) := do\\n  let entry ← state.entries[key]?\\n  let entry := {entry with borrowers := entry.borrowers+1,stamp := state.clock+1}\\n  return ({state with\\n    entries := state.entries.insert key entry\\n    clock := state.clock+1\\n    hits := state.hits + (if entry.loading then 0 else 1)\\n    joins := state.joins + (if entry.loading then 1 else 0)},entry)\\n\\ndef Pool.borrow? (pool : Pool) (key : String) : IO (Option Entry) := pool.state.atomically do\\n  let state ← get\\n  unless !state.closed do throw (IO.userError \\\"prepared source service is closed\\\")\\n  let some (next,entry) := state.borrow? key | return none\\n  set next\\n  return some entry\\n\\ndef Pool.admit (pool : Pool) (key : String) (charge : Nat) : IO Admission := pool.state.atomically do\\n  let state ← get\\n  unless !state.closed do throw (IO.userError \\\"prepared source service is closed\\\")\\n  if let some (state,entry) := state.borrow? key then\\n    set state\\n    return .borrowed entry\\n  if state.active ≥ maxLoads then return .busy\\n  let state := reclaim state charge maxEntries\\n  if state.active ≥ maxLoads || state.entries.size ≥ maxEntries then\\n    set state\\n    return .busy\\n  let some budget := state.budget.reserve? charge | set state; return .busy\\n  let entry : Entry := ⟨← IO.Promise.new,charge,1,state.clock+1,state.clock+1,true⟩\\n  set {state with\\n    entries := state.entries.insert key entry\\n    budget\\n    clock := state.clock+1\\n    active := state.active+1\\n    loads := state.loads+1}\\n  return .start entry\\n\\ndef Pool.release (pool : Pool) (key : String) (serial : Nat) : IO Unit := pool.state.atomically do\\n  modify fun state => match state.entries[key]? with\\n    | none => state\\n    | some entry => if entry.serial != serial then state else\\n        {state with entries := state.entries.insert key {entry with borrowers := entry.borrowers-1}}\\n\\ndef Pool.finish (pool : Pool) (key : String) (entry : Entry)\\n    (bytes : Nat) (result : Except String Loaded) : IO Unit := pool.state.atomically do\\n  let state ← get\\n  if !state.closed then\\n    match state.entries[key]? with\\n    | none => pure ()\\n    | some current =>\\n        if current.serial != entry.serial then pure () else match result with\\n        | .ok _ => set {state with\\n            active := state.active-1\\n            readBytes := state.readBytes+bytes\\n            entries := state.entries.insert key {current with loading := false}}\\n        | .error _ => set {state with\\n            active := state.active-1\\n            entries := state.entries.erase key\\n            budget := state.budget.release current.charge}\\n  unless ← entry.promise.isResolved do entry.promise.resolve result\\n\\n/-- Closing and launching share the same short ownership lock. A requester\\ncannot spawn a preparation after close has retired its task registry. -/\\ndef Pool.launch (pool : Pool) (identity : String) (entry : Entry) (bytes : Nat)\\n    (load : IO Loaded) : IO Unit := pool.state.atomically do\\n  let state ← get\\n  if state.closed then\\n    unless ← entry.promise.isResolved do entry.promise.resolve (.error \\\"prepared source service stopped\\\")\\n    return\\n  let task ← IO.asTask (do\\n    let result ← try pure (.ok (← load) : Except String Loaded)\\n      catch error => pure (.error error.toString)\\n    pool.finish identity entry bytes result) .dedicated\\n  pool.tasks.atomically do\\n    let live ← (← get).filterM fun task => return !(← IO.hasFinished task)\\n    set (live.push task)\\n\\ndef key (path : System.FilePath) (metadata : Cache.Manifest) : String :=\\n  (toJson (path.normalize.toString,metadata)).compress\\n\\ninductive Reuse where\\n  | loaded | joined | hit\\n  deriving BEq, ToJson, FromJson\\n\\n/-- A read capability names one source scope and immutable preparation.\\nOnly its non-secret identity belongs in a delivery/memo receipt. -/\\nstructure Access where\\n  database : String\\n  scope : String\\n  capability : String\\n  source : PageMap.Head\\n  metadata : Cache.Manifest\\n  reuse : Reuse\\n  deriving ToJson, FromJson\\n\\ndef Access.identity (access : Access) : Json :=\\n  toJson (access.database,access.scope,access.source,access.metadata)\\n\\ntheorem Access.capability_not_identity (access : Access) (secret : String) :\\n    ({access with capability := secret}).identity = access.identity := rfl\\n\\nstructure Projection where\\n  identity : Json\\n  rows : Array (String × Array StoredRow)\\n  reuse : Reuse\\n  deriving ToJson, FromJson\\n\\n/-- Payload bytes are verified only by the preparation owner. Admission\\ncharges a conservative footprint including decoder and origin-index overhead;\\nthe process RSS limit is measured independently of this accounting. -/\\ndef Pool.acquire (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)\\n    (metadata : Cache.Manifest) (deadline : Nat) : IO (Entry × Reuse) := do\\n  unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"prepared source request expired\\\")\\n  let identity := key path metadata\\n  if let some entry ← pool.borrow? identity then\\n    return (entry,if entry.loading then .joined else .hit)\\n  let payload := path / (metadata.payload ++ \\\".json\\\")\\n  let bytes := (← payload.metadata).byteSize.toNat\\n  unless bytes ≤ 32*1024*1024 do throw (IO.userError \\\"prepared source payload exceeds its bound\\\")\\n  -- Include the original view's bounded page cache in service admission.\\n  let charge := bytes*8+metadata.rows*1024+65536+256*1024*1024\\n  unless charge ≤ capacity do throw (IO.userError \\\"prepared source footprint exceeds service capacity\\\")\\n  repeat\\n    unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"prepared source admission expired\\\")\\n    match ← pool.admit identity charge with\\n    | .busy => IO.sleep 1\\n    | .borrowed entry => return (entry,if entry.loading then .joined else .hit)\\n    | .start entry =>\\n        try\\n          pool.launch identity entry bytes do\\n            let some ready ← Cache.atSource? source path metadata |\\n              throw (IO.userError \\\"prepared source no longer matches its publication\\\")\\n            return {Loaded.make ready with originals := ← Index.openShared? source}\\n        catch error => pool.finish identity entry 0 (.error error.toString)\\n        return (entry,.loaded)\\n  throw (IO.userError \\\"unreachable prepared source admission\\\")\\n\\ndef Pool.withReady (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)\\n    (metadata : Cache.Manifest) (deadline : Nat) (use : Loaded → Reuse → IO α) : IO α := do\\n  let identity := key path metadata\\n  let (entry,reuse) ← pool.acquire source path metadata deadline\\n  try\\n    repeat\\n      unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"prepared source wait expired\\\")\\n      if ← entry.promise.isResolved then\\n        let some result := entry.promise.result?.get | throw (IO.userError \\\"prepared source reply missing\\\")\\n        return ← use (← IO.ofExcept result) reuse\\n      IO.sleep 1\\n    throw (IO.userError \\\"unreachable prepared source wait\\\")\\n  finally pool.release identity entry.serial\\n\\ndef Pool.close (pool : Pool) : IO Unit := do\\n  pool.state.atomically do\\n    let state ← get\\n    set {state with closed := true,entries := {},budget := {},active := 0}\\n    for (_,entry) in state.entries do\\n      unless ← entry.promise.isResolved do entry.promise.resolve (.error \\\"prepared source service stopped\\\")\\n  for task in ← pool.tasks.atomically get do IO.cancel task\\n\\ndef Pool.stats (pool : Pool) : IO Json := pool.state.atomically do\\n  let state ← get\\n  return Json.mkObj [(\\\"entries\\\",toJson state.entries.size),(\\\"chargedBytes\\\",toJson state.budget.used),\\n    (\\\"capacity\\\",toJson capacity),(\\\"active\\\",toJson state.active),(\\\"loads\\\",toJson state.loads),\\n    (\\\"hits\\\",toJson state.hits),(\\\"joins\\\",toJson state.joins),(\\\"evictions\\\",toJson state.evictions),\\n    (\\\"verifiedPayloadBytes\\\",toJson state.readBytes),(\\\"closed\\\",toJson state.closed),\\n    (\\\"accountedExact\\\",toJson (state.budget.used ==\\n      state.entries.fold (fun total _ entry => total+entry.charge) 0))]\\n\\nend Eggshell.Synapses.CanonicalSource.Shared\\n\",[]]"],["Eggshell.CanonicalSourceRecords","[\"module\\npublic import Eggshell.CanonicalSource\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.CanonicalSource.Records\\nopen Lean\\n\\ndef indentation (text : String) : Nat :=\\n  (text.toList.takeWhile fun char => char == ' ' || char == '\\\\t').length\\n\\n/-- A source record has contiguous original line numbers in one fingerprint\\nand observed boundaries: a paragraph or an entry followed by indented data.\\nThis is a bounded layout closure, not a parser or a semantic judgment. -/\\ndef valid (rows : Array StoredRow) (indices : List (Fin rows.size))\\n    (before : Option (Fin rows.size)) (after : Fin rows.size) : Bool :=\\n  match indices.head? with\\n  | none => false\\n  | some first =>\\n    let file := rows[first].key.file\\n    let start := rows[first].key.line\\n    let adjacent := match before with\\n      | none => start == 1\\n      | some previous => rows[previous].key.file == file &&\\n          rows[previous].key.line+1 == start\\n    let paragraph := before.all (fun previous => rows[previous].code.trimAscii.isEmpty) &&\\n      rows[after].code.trimAscii.isEmpty\\n    let level := indentation rows[first].code\\n    let indented := 1 < indices.length &&\\n      indices.tail.all (fun index => level < indentation rows[index].code) &&\\n      (rows[after].code.trimAscii.isEmpty || indentation rows[after].code ≤ level)\\n    adjacent && (paragraph || indented) && file.valid &&\\n      (indices.zipIdx.all fun (index,offset) => rows[index].key.file == file &&\\n        rows[index].key.line == start+offset && !rows[index].code.trimAscii.isEmpty) &&\\n      rows[after].key.file == file && rows[after].key.line == start+indices.length &&\\n      (indices.map fun index => rows[index].code.length+1).sum ≤ 2048\\n\\nstructure Record (rows : Array StoredRow) where\\n  indices : List (Fin rows.size)\\n  before : Option (Fin rows.size)\\n  after : Fin rows.size\\n  checked : valid rows indices before after = true\\n\\ndef check? (rows : Array StoredRow) (indices : List (Fin rows.size))\\n    (before : Option (Fin rows.size)) (after : Fin rows.size) : Option (Record rows) :=\\n  if checked : valid rows indices before after = true then some ⟨indices,before,after,checked⟩ else none\\n\\ndef prepare (rows : Array StoredRow) : List (Record rows) := Id.run do\\n  let order := (List.finRange rows.size).mergeSort fun a b =>\\n    if rows[a].key.file == rows[b].key.file then rows[a].key.line ≤ rows[b].key.line\\n    else (toJson rows[a].key.file).compress ≤ (toJson rows[b].key.file).compress\\n  let mut result := []\\n  let mut previous : Option (Fin rows.size) := none\\n  let mut before : Option (Fin rows.size) := none\\n  let mut pending := []\\n  for index in order do\\n    let row := rows[index]\\n    let adjacent := previous.any fun prior => rows[prior].key.file == row.key.file &&\\n      rows[prior].key.line+1 == row.key.line\\n    if !adjacent then\\n      before := none\\n      pending := []\\n    if row.code.trimAscii.isEmpty then\\n      if let some record := check? rows pending before index then result := result ++ [record]\\n      pending := []\\n      before := some index\\n    else pending := pending ++ [index]\\n    previous := some index\\n  -- A condition can span several numbered lines without a blank separator.\\n  -- Consider only an observed entry followed by more-indented original rows;\\n  -- its next same-or-less-indented row is the observed closing boundary.\\n  -- Bound the scan by the same source-record limit, not by a line heuristic.\\n  let ordered := order.toArray\\n  for position in List.finRange ordered.size do\\n    let index := ordered[position]\\n    if rows[index].code.trimAscii.isEmpty then continue\\n    let level := indentation rows[index].code\\n    let mut indices := [index]\\n    let mut chars := rows[index].code.length+1\\n    let mut cursor := position.val+1\\n    let mut priorIndex := index\\n    while cursor < ordered.size && chars ≤ 2048 do\\n      let some next := ordered[cursor]? | break\\n      if rows[next].key.file != rows[index].key.file ||\\n          rows[priorIndex].key.line+1 != rows[next].key.line then break\\n      if rows[next].code.trimAscii.isEmpty || indentation rows[next].code ≤ level then\\n        let entryBefore := if position.val == 0 then none else ordered[position.val-1]?\\n        if let some record := check? rows indices entryBefore next then result := result ++ [record]\\n        break\\n      indices := indices ++ [next]\\n      chars := chars+rows[next].code.length+1\\n      priorIndex := next\\n      cursor := cursor+1\\n  return result\\n\\n/-- Selection cannot purchase a proper prefix of an admitted bounded record.\\nUnobserved lines, read gaps, a different fingerprint and unbounded paragraphs\\nsupply no additional row. The original requested rows are always retained. -/\\ndef closeIndices (records : List (Record rows)) (requested : List (Fin rows.size)) : List (Fin rows.size) :=\\n  hashDistinct (requested ++ (records.filter fun record =>\\n    record.indices.any requested.contains).flatMap (·.indices))\\n\\ntheorem requested_retained (records : List (Record rows)) (requested : List (Fin rows.size))\\n    (index : Fin rows.size) (present : index ∈ requested) : index ∈ closeIndices records requested := by\\n  rw [closeIndices,HashDistinct.reference]\\n  exact List.mem_eraseDups.mpr (List.mem_append_left _ present)\\n\\ntheorem complete_record_retained (records : List (Record rows)) (requested : List (Fin rows.size))\\n    (record : Record rows) (admitted : record ∈ records)\\n    (witness : Fin rows.size) (hint : witness ∈ requested) (inside : witness ∈ record.indices)\\n    (index : Fin rows.size) (member : index ∈ record.indices) : index ∈ closeIndices records requested := by\\n  rw [closeIndices,HashDistinct.reference]\\n  apply List.mem_eraseDups.mpr\\n  apply List.mem_append_right\\n  apply List.mem_flatMap.mpr\\n  refine ⟨record,List.mem_filter.mpr ⟨admitted,?_⟩,member⟩\\n  exact List.any_eq_true.mpr ⟨witness,inside,by simpa using hint⟩\\n\\ndef close (rows : Array StoredRow) (records : List (Record rows))\\n    (requested : List (Fin rows.size)) : Array StoredRow :=\\n  ((closeIndices records requested).map fun index => rows[index]).toArray\\n\\n/-- Query-independent original domain. Bounded records remain whole; a row\\nwithout such a record gets its own original unit. Relevance never determines\\nwhich stored row can be purchased. The set is prepared once, not per hint. -/\\ndef catalogue (rows : Array StoredRow) (records : List (Record rows)) :\\n    List (List (Fin rows.size)) :=\\n  let entries := records.map (·.indices)\\n  let covered := Std.HashSet.ofList entries.flatten\\n  entries ++ ((List.finRange rows.size).filter fun index => !covered.contains index).map (fun index => [index])\\n\\ntheorem catalogue_complete (rows : Array StoredRow) (records : List (Record rows))\\n    (index : Fin rows.size) : index ∈ (catalogue rows records).flatten := by\\n  simp only [catalogue,List.flatten_append]\\n  by_cases present : index ∈ (records.map (·.indices)).flatten\\n  · exact List.mem_append_left _ present\\n  · apply List.mem_append_right\\n    apply List.mem_flatten.mpr\\n    refine ⟨[index],?_,by simp⟩\\n    apply List.mem_map.mpr\\n    refine ⟨index,?_,rfl⟩\\n    simpa [Std.HashSet.contains_ofList] using present\\n\\ntheorem catalogue_payload_original (rows : Array StoredRow) (records : List (Record rows))\\n    (indices : List (Fin rows.size)) (_member : indices ∈ catalogue rows records)\\n    (index : Fin rows.size) (_inside : index ∈ indices) : rows[index] ∈ rows :=\\n  Array.getElem_mem index.isLt\\n\\ntheorem closed_row_is_original (rows : Array StoredRow) (records : List (Record rows))\\n    (requested : List (Fin rows.size)) (row : StoredRow) (member : row ∈ close rows records requested) :\\n    row ∈ rows := by\\n  simp only [close,List.mem_toArray,List.mem_map] at member\\n  obtain ⟨index,_,equal⟩ := member\\n  subst row\\n  exact Array.getElem_mem index.isLt\\n\\nend Eggshell.Synapses.CanonicalSource.Records\\n\",[]]"],["Eggshell.CompletedAuthority","[\"module\\n\\npublic import Eggshell.Matcher\\npublic import Eggshell.SelectionDependency\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Matcher\\n\\ntheorem completed_not_retrieved {matched : Match}\\n    (completed : matched.judgment.delivery = .completed) : matched.retrieved = false := by\\n  cases retrieved : matched.retrieved with\\n  | false => rfl\\n  | true => simp [Match.judgment, retrieved, ApplicabilityJudgment.delivery] at completed\\n\\n/-- Every selected equality premise follows from this run's current generators,\\nincluding decomposition and child deduplication, and preserves Exact authority. -/\\ntheorem extraction_comparisons_generated (discovery : Discovery)\\n    (comparison : SelectionDependency.Comparison)\\n    (used : comparison ∈ SelectionDependency.comparisons discovery.view.quotient.toEquality\\n      discovery.current (extraction discovery).selection) :\\n    Equivalent (discovery.persistentUnions ++ discovery.view.localUnions)\\n      comparison.left comparison.right ∧\\n    Value.SameExactFootprint comparison.left comparison.right := by\\n  have positive := SelectionDependency.comparisons_positive _ _ _ _ _\\n    (extraction_sound discovery) comparison used\\n  have generated := discovery.generated comparison.left comparison.right positive\\n  exact ⟨generated, generated.exactAuthority⟩\\n\\n/-- Completed authorization is generated equality plus an intrinsic automatic\\nMatch and original-owner provenance. This is not semantic correctness of an\\nOutcome. Source binding/freshness and transport are explicit IO boundaries. -/\\ntheorem completed_authority {discovery : Discovery} {demand : Value} {edge : OutcomeEdge}\\n    (used : (demand, edge) ∈ (extraction discovery).selection.completedUses) :\\n    ∃ matched ∈ discovery.hits,\\n      matched.retrieved = false ∧ matched.automatic = true ∧\\n      matched.projectionWork = demand ∧ matched.projectedEdge.relation = edge.relation ∧\\n      matched.judgment.direction = .pastWorkInsideCurrentDemand ∧\\n      matched.judgment.reusableOutcome = true ∧\\n      matched.work.fragmentIdentity = true ∧ matched.work.subwork = true ∧\\n      (matched.projectedEdge = matched.edge ∨\\n        matched.edge.relation ∈ matched.projectedEdge.observations) ∧\\n      edge.outcome ∈ (extraction discovery).priorOutcomes ∧\\n      Equivalent (discovery.persistentUnions ++ discovery.view.localUnions) edge.work demand ∧\\n      Value.SameExactFootprint edge.work demand := by\\n  obtain ⟨matched, member, automatic, projection, relation, forward, reusable,\\n    identity, subwork, coverage, origin, prior⟩ := extraction_completed_has_match used\\n  have completed : matched.judgment.delivery = .completed := by\\n    simp [ApplicabilityJudgment.delivery, forward, reusable]\\n  have sound := Selection.completedUse_sound (extraction_sound discovery) used\\n  have generated := discovery.generated edge.work demand sound.2.1\\n  exact ⟨matched, member, completed_not_retrieved completed, automatic, projection, relation,\\n    forward, reusable, identity, subwork, origin, prior, generated, generated.exactAuthority⟩\\n\\n/-- The source boundary supplies ownership in the pinned original publication.\\nThe predicate supports sparse IO; it does not materialize the whole DB. -/\\ntheorem completed_original_authority {discovery : Discovery} {demand : Value} {edge : OutcomeEdge}\\n    (original : OutcomeEdge → Prop)\\n    (owned : ∀ matched ∈ discovery.hits, original matched.edge)\\n    (used : (demand, edge) ∈ (extraction discovery).selection.completedUses) :\\n    ∃ matched ∈ discovery.hits,\\n      original matched.edge ∧\\n      matched.retrieved = false ∧ matched.automatic = true ∧\\n      matched.projectionWork = demand ∧ matched.projectedEdge.relation = edge.relation ∧\\n      matched.judgment.direction = .pastWorkInsideCurrentDemand ∧\\n      matched.judgment.reusableOutcome = true ∧\\n      matched.work.fragmentIdentity = true ∧ matched.work.subwork = true ∧\\n      (matched.projectedEdge = matched.edge ∨\\n        matched.edge.relation ∈ matched.projectedEdge.observations) ∧\\n      edge.outcome ∈ (extraction discovery).priorOutcomes ∧\\n      Equivalent (discovery.persistentUnions ++ discovery.view.localUnions) edge.work demand ∧\\n      Value.SameExactFootprint edge.work demand := by\\n  obtain ⟨matched, member, supported⟩ := completed_authority used\\n  exact ⟨matched, member, owned matched member, supported⟩\\n\\n/-- This premise is retained by both real producers at generation time. It is\\nnot supplied as a hypothetical ancestry assumption by the completion caller. -/\\ntheorem discovery_local_unions_not_retrieved (discovery : Discovery)\\n    (edge : UnionEdge) (present : edge ∈ discovery.view.localUnions) :\\n    ∃ quotient inquiry matched,\\n      localUnion? quotient inquiry matched = some edge ∧\\n      matched.retrieved = false ∧ edge.scope = .run inquiry := by\\n  obtain ⟨quotient, inquiry, matched, created, intrinsic⟩ := discovery.localOrigins edge present\\n  exact ⟨quotient, inquiry, matched, created, intrinsic, localUnion_is_run_scoped created⟩\\n\\n/-- Every current generator is either an explicit persistent input, or has\\nan actual non-retrieved Match constructor witness. No ancestry premise is\\nrequired for the current run's local edges. -/\\ntheorem discovery_generators_have_origin (discovery : Discovery)\\n    (edge : UnionEdge) (present : edge ∈ discovery.persistentUnions ++ discovery.view.localUnions) :\\n    edge ∈ discovery.persistentUnions ∨\\n      ∃ quotient inquiry matched, localUnion? quotient inquiry matched = some edge ∧\\n        matched.retrieved = false ∧ edge.scope = .run inquiry := by\\n  rcases List.mem_append.mp present with durable | recent\\n  · exact Or.inl durable\\n  · exact Or.inr (discovery_local_unions_not_retrieved discovery edge recent)\\n\\ntheorem completed_generator_origins {discovery : Discovery} {demand : Value} {edge : OutcomeEdge}\\n    (used : (demand, edge) ∈ (extraction discovery).selection.completedUses) :\\n    Equivalent (discovery.persistentUnions ++ discovery.view.localUnions) edge.work demand ∧\\n    Value.SameExactFootprint edge.work demand ∧\\n    ∀ generator ∈ discovery.persistentUnions ++ discovery.view.localUnions,\\n      generator ∈ discovery.persistentUnions ∨\\n        ∃ quotient inquiry matched, localUnion? quotient inquiry matched = some generator ∧\\n          matched.retrieved = false ∧ generator.scope = .run inquiry := by\\n  have selected := Selection.completedUse_sound (extraction_sound discovery) used\\n  have equality := discovery.generated edge.work demand selected.2.1\\n  exact ⟨equality, equality.exactAuthority, discovery_generators_have_origin discovery⟩\\n\\nend Eggshell.Matcher\\n\",[]]"],["Eggshell.Config","[\"module\\n\\npublic import Eggshell.Matcher\\npublic import Eggshell.Paths\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Config\\n\\n/-- Configured native transport ceiling. The source-driven packet target may\\nbe smaller; this is not a quota or an immutable platform restriction. -/\\ndef nativeHandoffBytes : Nat := 128000\\n\\nstructure Egg where\\n  name : String\\n  path : System.FilePath\\n  deriving Repr, DecidableEq\\n\\nstructure Profile where\\n  name : String\\n  read : List String := []\\n  write : Option String := none\\n  handoffChars : Nat := 120000\\n  /-- False retains advisory retrieval while disabling automatic operation reuse. -/\\n  localUnion : Bool := true\\n  deriving Repr, DecidableEq\\n\\nstructure Config where\\n  source : System.FilePath\\n  defaultProfile : String := \\\"work\\\"\\n  defaultWasSet : Bool := false\\n  /-- Explicit provider command, opt-out, or an omitted built-in MiniLM default. -/\\n  semanticMatcher : Option (List String) := none\\n  /-- Distinguishes an omitted built-in default from an explicit opt-out. -/\\n  semanticMatcherWasSet : Bool := false\\n  eggs : List Egg := []\\n  profiles : List Profile := []\\n  deriving Repr, DecidableEq\\n\\nstructure Selection where\\n  label : String\\n  semanticMatcher : Option (List String)\\n  read : List Egg\\n  write : Option Egg\\n  handoffChars : Nat\\n  /-- Set by the harness independently of the user profile's character budget. -/\\n  handoffBytes : Option Nat := none\\n  localUnion : Bool := true\\n  deriving Repr, DecidableEq\\n\\ninductive Section where\\n  | root\\n  | eggs\\n  | profile (name : String)\\n  deriving Repr, DecidableEq\\n\\nstructure ParseState where\\n  scope : Section := .root\\n  defaultProfile : Option String := none\\n  semanticMatcher : Option (List String) := none\\n  semanticMatcherWasSet : Bool := false\\n  eggs : List (String × String) := []\\n  profiles : List Profile := []\\n\\ndef trim (text : String) : String := text.trimAscii.copy\\n\\ndef stripCommentLoop : List Char → Bool → Bool → List Char\\n  | [], _, _ => []\\n  | character :: tail, quoted, escaped =>\\n      if character = '#' && !quoted then []\\n      else\\n        let nextQuoted := if character = '\\\"' && !escaped then !quoted else quoted\\n        let nextEscaped := quoted && character = '\\\\\\\\' && !escaped\\n        character :: stripCommentLoop tail nextQuoted nextEscaped\\n\\n/-- TOML comments begin outside strings; paths containing `#` remain intact. -/\\ndef stripComment (text : String) : String :=\\n  String.ofList (stripCommentLoop text.toList false false)\\n\\ndef unquote (text : String) : Except String String :=\\n  let value := trim text\\n  if value.length ≥ 2 && value.startsWith \\\"\\\\\\\"\\\" && value.endsWith \\\"\\\\\\\"\\\" then\\n    pure ((value.drop 1).take (value.length - 2)).copy\\n  else\\n    throw s!\\\"expected quoted TOML string, got {value}\\\"\\n\\ndef boolean (text : String) : Except String Bool :=\\n  match trim text with\\n  | \\\"true\\\" => pure true\\n  | \\\"false\\\" => pure false\\n  | value => throw s!\\\"expected TOML boolean, got {value}\\\"\\n\\ndef arrayStrings (text : String) : Except String (List String) := do\\n  let value := trim text\\n  if !(value.startsWith \\\"[\\\" && value.endsWith \\\"]\\\") then\\n    throw s!\\\"expected TOML string array, got {value}\\\"\\n  let body := ((value.drop 1).take (value.length - 2)).copy\\n  if trim body = \\\"\\\" then pure []\\n  else body.splitOn \\\",\\\" |>.map trim |>.filter (!·.isEmpty) |>.mapM unquote\\n\\ndef assignment (line : String) : Except String (String × String) :=\\n  match line.splitOn \\\"=\\\" with\\n  | [] | [_] => throw s!\\\"expected TOML assignment, got {line}\\\"\\n  | key :: values => pure (trim key, trim (\\\"=\\\".intercalate values))\\n\\ndef upsertProfile (profiles : List Profile) (profile : Profile) : List Profile :=\\n  profile :: profiles.filter (·.name != profile.name)\\n\\ndef alterProfile (state : ParseState) (name : String)\\n    (change : Profile → Profile) : ParseState :=\\n  let profile := state.profiles.find? (·.name == name) |>.getD { name }\\n  { state with profiles := upsertProfile state.profiles (change profile) }\\n\\ndef parseHeader (line : String) : Except String Section := do\\n  if !(line.startsWith \\\"[\\\" && line.endsWith \\\"]\\\") then\\n    throw s!\\\"invalid TOML section {line}\\\"\\n  let name := ((line.drop 1).take (line.length - 2)).copy\\n  if name = \\\"eggs\\\" then pure .eggs\\n  else if let some profile := (name.dropPrefix? \\\"profiles.\\\").map (·.toString) then\\n    pure (.profile profile)\\n  else throw s!\\\"unknown Eggshell config section [{name}]\\\"\\n\\ndef parseLine (state : ParseState) (raw : String) : Except String ParseState := do\\n  let line := trim (stripComment raw)\\n  if line = \\\"\\\" then pure state\\n  else if line.startsWith \\\"[\\\" then\\n    pure { state with scope := ← parseHeader line }\\n  else\\n    let (key, value) ← assignment line\\n    match state.scope with\\n    | .root =>\\n        if key = \\\"default\\\" then\\n          pure { state with defaultProfile := some (← unquote value) }\\n        else if key = \\\"semantic_matcher\\\" then\\n          if trim value = \\\"false\\\" then\\n            pure { state with\\n              semanticMatcher := none\\n              semanticMatcherWasSet := true }\\n          else\\n            let command ← arrayStrings value\\n            if command.isEmpty then\\n              throw \\\"semantic_matcher must name an executable or be false\\\"\\n            pure { state with\\n              semanticMatcher := some command\\n              semanticMatcherWasSet := true }\\n        else throw s!\\\"unknown Eggshell config key {key}\\\"\\n    | .eggs =>\\n        pure { state with eggs := (key, ← unquote value) :: state.eggs }\\n    | .profile name =>\\n        if key = \\\"read\\\" then\\n          let names ← arrayStrings value\\n          pure (alterProfile state name fun profile =>\\n            { profile with read := names })\\n        else if key = \\\"write\\\" then\\n          let target ← unquote value\\n          pure (alterProfile state name fun profile =>\\n            { profile with write := some target })\\n        else if key = \\\"handoff_chars\\\" then\\n          match value.toNat? with\\n          | some budget =>\\n              pure (alterProfile state name fun profile =>\\n                { profile with handoffChars := budget })\\n          | none => throw s!\\\"invalid handoff_chars {value}\\\"\\n        else if key = \\\"local_union\\\" then\\n          let enabled ← boolean value\\n          pure (alterProfile state name fun profile =>\\n            { profile with localUnion := enabled })\\n        else throw s!\\\"unknown profile key {key}\\\"\\n\\ndef logicalLines (text : String) : List String :=\\n  let rec go (lines : List String) (openArray : Option String)\\n      (result : List String) : List String :=\\n    match lines with\\n    | [] => (openArray.toList ++ result).reverse\\n    | raw :: tail =>\\n        let line := trim raw\\n        match openArray with\\n        | some accumulated =>\\n            let joined := accumulated ++ \\\" \\\" ++ line\\n            if line.endsWith \\\"]\\\" then go tail none (joined :: result)\\n            else go tail (some joined) result\\n        | none =>\\n            let parts := line.splitOn \\\"=\\\"\\n            let startsArray := match parts with\\n              | _ :: value :: _ => (trim value).startsWith \\\"[\\\"\\n              | _ => false\\n            if startsArray && !line.endsWith \\\"]\\\" then\\n              go tail (some line) result\\n            else go tail none (line :: result)\\n  go (text.splitOn \\\"\\\\n\\\") none []\\n\\ndef expandPath (source : System.FilePath) (raw : String) : IO System.FilePath := do\\n  let expanded ← if raw.startsWith \\\"~/\\\" then\\n      match ← IO.getEnv \\\"HOME\\\" with\\n      | some home => pure (System.FilePath.mk home / (raw.drop 2).copy)\\n      | none => throw (IO.userError \\\"HOME is unavailable\\\")\\n    else pure (System.FilePath.mk raw)\\n  if expanded.isAbsolute then pure expanded.normalize\\n  else pure ((source.parent.getD \\\".\\\") / expanded).normalize\\n\\ndef parse (source : System.FilePath) (text : String) : IO Config := do\\n  let state ← match (logicalLines text).foldlM parseLine {} with\\n    | .ok state => pure state\\n    | .error message => throw (IO.userError s!\\\"{source}: {message}\\\")\\n  let eggs ← state.eggs.reverse.mapM fun (name, rawPath) => do\\n    let path ← expandPath source rawPath\\n    pure { name, path }\\n  pure {\\n    source\\n    defaultProfile := state.defaultProfile.getD \\\"work\\\"\\n    defaultWasSet := state.defaultProfile.isSome\\n    semanticMatcher := state.semanticMatcher\\n    semanticMatcherWasSet := state.semanticMatcherWasSet\\n    eggs\\n    profiles := state.profiles.reverse\\n  }\\n\\ndef parseFile (path : System.FilePath) : IO Config := do\\n  parse path (← IO.FS.readFile path)\\n\\ndef insideProject (root path : System.FilePath) : Bool :=\\n  let rootParts := root.normalize.components\\n  let pathParts := path.normalize.components\\n  !pathParts.contains \\\"..\\\" && rootParts.length < pathParts.length &&\\n    rootParts.isPrefixOf pathParts\\n\\n/--\\nRepository data may select only repository-owned authorities. Shared authorities\\nand executable matchers remain user-owned global configuration.\\n-/\\ndef admitProject (config : Config) : Except String Config := do\\n  if config.semanticMatcher.isSome then\\n    throw \\\"project .eggshell.toml cannot execute semantic_matcher; configure custom providers in the user-owned global Eggshell config\\\"\\n  let root := config.source.parent.getD \\\".\\\" |>.normalize\\n  for egg in config.eggs do\\n    if !insideProject root egg.path then\\n      throw s!\\\"project egg {egg.name} must be a path below {root}\\\"\\n  let eggNames := config.eggs.map (·.name)\\n  for profile in config.profiles do\\n    if profile.read.any (!eggNames.contains ·) ||\\n        profile.write.any (!eggNames.contains ·) then\\n      throw s!\\\"project profile {profile.name} may reference only eggs declared by this project\\\"\\n  if config.defaultWasSet && config.profiles.all (·.name != config.defaultProfile) then\\n    throw \\\"project default must name a profile declared by this project\\\"\\n  pure config\\n\\ndef nearestProjectConfig (start : System.FilePath) : IO (Option System.FilePath) :=\\n  let rec go : Nat → System.FilePath → IO (Option System.FilePath)\\n    | 0, _ => pure none\\n    | fuel + 1, directory => do\\n        let candidate := directory / \\\".eggshell.toml\\\"\\n        if ← candidate.pathExists then pure (some candidate)\\n        else match directory.parent with\\n          | some parent =>\\n              if parent == directory then pure none\\n              else go fuel parent\\n          | none => pure none\\n  go (start.toString.length + 1) start\\n\\ndef globalPath : IO (Option System.FilePath) := do\\n  pure (some (← Paths.globalConfig))\\n\\ndef merge (base overlay : Config) : Config :=\\n  let eggs := overlay.eggs ++ base.eggs.filter fun egg =>\\n    overlay.eggs.all (·.name != egg.name)\\n  let profiles := overlay.profiles ++ base.profiles.filter fun profile =>\\n    overlay.profiles.all (·.name != profile.name)\\n  {\\n    source := overlay.source\\n    defaultProfile := if overlay.defaultWasSet then\\n      overlay.defaultProfile else base.defaultProfile\\n    defaultWasSet := overlay.defaultWasSet || base.defaultWasSet\\n    semanticMatcher := if overlay.semanticMatcherWasSet then\\n      overlay.semanticMatcher else base.semanticMatcher\\n    semanticMatcherWasSet := overlay.semanticMatcherWasSet ||\\n      base.semanticMatcherWasSet\\n    eggs\\n    profiles\\n  }\\n\\ndef loadWith (cwd : System.FilePath) (explicit : Option String) : IO (Option Config) := do\\n  if let some explicit := explicit then\\n    if !explicit.trimAscii.isEmpty then\\n      return some (← parseFile (System.FilePath.mk explicit).normalize)\\n  let global ← match ← globalPath with\\n    | some path =>\\n        if ← path.pathExists then pure (some (← parseFile path))\\n        else pure none\\n    | none => pure none\\n  let project ← match ← nearestProjectConfig cwd with\\n    | some path => do\\n        let config ← parseFile path\\n        match admitProject config with\\n        | .ok admitted =>\\n            if let some base := global then\\n              if admitted.eggs.any fun egg => base.eggs.any (·.name == egg.name) then\\n                throw (IO.userError s!\\\"{path}: project egg names cannot shadow global eggs\\\")\\n            pure (some admitted)\\n        | .error message => throw (IO.userError s!\\\"{path}: {message}\\\")\\n    | none => pure none\\n  pure <| match global, project with\\n    | none, none => none\\n    | some config, none | none, some config => some config\\n    | some base, some overlay => some (merge base overlay)\\n\\ndef load (cwd : System.FilePath) : IO (Option Config) := do\\n  loadWith cwd (← IO.getEnv \\\"EGGSHELL_CONFIG\\\")\\n\\ndef resolve (config : Config) (profileName : String) : Except String Selection := do\\n  let profile ← match config.profiles.find? (·.name == profileName) with\\n    | some profile => pure profile\\n    | none => throw s!\\\"unknown Eggshell profile {profileName}\\\"\\n  let resolveEgg name := match config.eggs.find? (·.name == name) with\\n    | some egg => pure egg\\n    | none => throw s!\\\"profile {profileName} names unknown egg {name}\\\"\\n  let mut reads ← profile.read.mapM resolveEgg\\n  let write ← profile.write.mapM resolveEgg\\n  if let some target := write then\\n    if !reads.contains target then reads := reads ++ [target]\\n  pure {\\n    label := profileName\\n    semanticMatcher := config.semanticMatcher\\n    read := reads.eraseDups\\n    write\\n    handoffChars := profile.handoffChars\\n    localUnion := profile.localUnion\\n  }\\n\\nend Eggshell.Config\\n\",[]]"],["Eggshell.CongruenceComplete","[\"module\\n\\npublic import Eggshell.CongruenceFixed\\n\\n@[expose] public section\\nnamespace Eggshell.QuotientBuilder.CongruenceComplete\\nopen Partition\\n\\ndef canonical (partition : RawPartition) (value : Value) : Value :=\\n  (lookup partition value).headD value\\n\\ndef Mono (before after : RawPartition) : Prop :=\\n  ∀ left right, canonical before left = canonical before right →\\n    canonical after left = canonical after right\\n\\ntheorem merge_mono (partition : RawPartition) (valid : Valid partition) (left right : Value) :\\n    Mono partition (merge partition left right) := by\\n  intro first second equal\\n  have present := (heads_equal valid first second).mp equal\\n  apply (heads_equal (merge_valid valid left right) first second).mpr\\n  rw [merge_lookup valid]\\n  split\\n  · exact present\\n  · split\\n    · rename_i _ joined\\n      rcases List.mem_append.mp joined with inLeft | inRight\\n      · have sameClass := lookup_related valid left first inLeft\\n        exact List.mem_append_left _ (sameClass ▸ present)\\n      · have sameClass := lookup_related valid right first inRight\\n        exact List.mem_append_right _ (sameClass ▸ present)\\n    · exact present\\n\\ntheorem merge_join (partition : RawPartition) (valid : Valid partition) (left right : Value) :\\n    canonical (merge partition left right) left = canonical (merge partition left right) right := by\\n  apply (heads_equal (merge_valid valid left right) left right).mpr\\n  rw [merge_lookup valid]\\n  split\\n  · assumption\\n  · have first : left ∈ lookup partition left ++ lookup partition right :=\\n      List.mem_append_left _ (lookup_contains partition left)\\n    simp only [first, ↓reduceIte]\\n    exact List.mem_append_right _ (lookup_contains partition right)\\n\\ntheorem step_valid (index : Representatives) (state : Representatives × RawPartition)\\n    (valid : Valid state.2) (value : Value) : Valid (applicationStep index state value).2 := by\\n  cases value with\\n  | atom _ => exact valid\\n  | apply operator arguments =>\\n    cases found : state.1[signature index (.apply operator arguments)]? with\\n    | none => simpa only [applicationStep, congruenceStep, found] using valid\\n    | some prior => simpa only [applicationStep, congruenceStep, found] using merge_valid valid prior (.apply operator arguments)\\n\\ntheorem step_mono (index : Representatives) (state : Representatives × RawPartition)\\n    (valid : Valid state.2) (value : Value) : Mono state.2 (applicationStep index state value).2 := by\\n  cases value with\\n  | atom _ => exact fun _ _ same => same\\n  | apply operator arguments =>\\n    cases found : state.1[signature index (.apply operator arguments)]? with\\n    | none => exact fun _ _ same => by simpa only [applicationStep, congruenceStep, found] using same\\n    | some prior => simpa only [applicationStep, congruenceStep, found] using merge_mono state.2 valid prior (.apply operator arguments)\\n\\ntheorem fold_mono (index : Representatives) (values : List Value) (state : Representatives × RawPartition)\\n    (valid : Valid state.2) : Valid (values.foldl (applicationStep index) state).2 ∧\\n    Mono state.2 (values.foldl (applicationStep index) state).2 := by\\n  induction values generalizing state with\\n  | nil => exact ⟨valid, fun _ _ equal => equal⟩\\n  | cons value rest ih =>\\n    have next := ih _ (step_valid index state valid value)\\n    exact ⟨next.1, fun left right equal => next.2 left right (step_mono index state valid value left right equal)⟩\\n\\ntheorem step_preserves (index : Representatives) (state : Representatives × RawPartition) (value key prior : Value)\\n    (stored : state.1[key]? = some prior) : (applicationStep index state value).1[key]? = some prior := by\\n  cases value with\\n  | atom _ => exact stored\\n  | apply operator arguments =>\\n    cases found : state.1[signature index (.apply operator arguments)]? with\\n    | some _ => simpa only [applicationStep, congruenceStep, found] using stored\\n    | none =>\\n      simp only [applicationStep, congruenceStep, found, Std.HashMap.getElem?_insert]\\n      split\\n      · rename_i equal\\n        have same : signature index (.apply operator arguments) = key := beq_iff_eq.mp equal\\n        rw [same, stored] at found\\n        contradiction\\n      · exact stored\\n\\ntheorem fold_preserves (index : Representatives) (values : List Value)\\n    (state : Representatives × RawPartition) (key prior : Value) (stored : state.1[key]? = some prior) :\\n    (values.foldl (applicationStep index) state).1[key]? = some prior := by\\n  induction values generalizing state with\\n  | nil => exact stored\\n  | cons value rest ih => exact ih _ (step_preserves index state value key prior stored)\\n\\n/-- Every scanned application has a signature witness in the actual final\\ntable and is joined to that witness in the actual final partition. -/\\ntheorem fold_covers (index : Representatives) (values : List Value)\\n    (state : Representatives × RawPartition) (valid : Valid state.2)\\n    (operator : Operator) (arguments : Refs) (present : Value.apply operator arguments ∈ values) :\\n    ∃ prior, (values.foldl (applicationStep index) state).1[signature index (.apply operator arguments)]? = some prior ∧\\n      canonical (values.foldl (applicationStep index) state).2 (.apply operator arguments) =\\n        canonical (values.foldl (applicationStep index) state).2 prior := by\\n  induction values generalizing state with\\n  | nil => simp at present\\n  | cons value rest ih =>\\n    rcases List.mem_cons.mp present with same | later\\n    · subst value\\n      let next := applicationStep index state (.apply operator arguments)\\n      have recorded : ∃ prior, next.1[signature index (.apply operator arguments)]? = some prior ∧\\n          canonical next.2 (.apply operator arguments) = canonical next.2 prior := by\\n        cases found : state.1[signature index (.apply operator arguments)]? with\\n        | none => exact ⟨.apply operator arguments, by simp [next, applicationStep, congruenceStep, found], rfl⟩\\n        | some prior =>\\n          exact ⟨prior, by simp [next, applicationStep, congruenceStep, found],\\n            by simpa only [next, applicationStep, congruenceStep, found] using (merge_join state.2 valid prior (.apply operator arguments)).symm⟩\\n      obtain ⟨prior, stored, equal⟩ := recorded\\n      exact ⟨prior, fold_preserves index rest next _ prior stored,\\n        (fold_mono index rest next (step_valid index state valid _)).2 _ _ equal⟩\\n    · exact ih _ (step_valid index state valid value) later\\n\\n/-- A fixed production pass is closed under every same-signature pair in\\nits input domain; this follows from the executed scan, not a new pair scan. -/\\ntheorem pass_closed (values : List Value) (partition : RawPartition) (valid : Valid partition)\\n    (fixed : congruencePass values partition = partition) (left right : Value)\\n    (leftIn : left ∈ values) (rightIn : right ∈ values)\\n    (equal : signature (representatives partition) left = signature (representatives partition) right) :\\n    canonical partition left = canonical partition right := by\\n  cases left with\\n  | atom bytes =>\\n    have literal := ApplicationScan.signature_atom (representatives partition) right bytes equal.symm\\n    subst right\\n    rfl\\n  | apply operator arguments =>\\n    cases right with\\n    | atom bytes => simp [signature] at equal\\n    | apply other references =>\\n      obtain ⟨first, firstStored, firstEqual⟩ := fold_covers (representatives partition) values ({}, partition) valid operator arguments leftIn\\n      obtain ⟨second, secondStored, secondEqual⟩ := fold_covers (representatives partition) values ({}, partition) valid other references rightIn\\n      rw [equal, secondStored] at firstStored\\n      have same := Option.some.inj firstStored\\n      subst first\\n      change canonical (congruencePass values partition) _ = canonical (congruencePass values partition) _ at firstEqual secondEqual\\n      rw [fixed] at firstEqual secondEqual\\n      exact firstEqual.trans secondEqual.symm\\n\\ntheorem saturation_mono (values : List Value) (fuel : Nat) (partition : RawPartition)\\n    (valid : Valid partition) : Valid (saturateCongruence values fuel partition) ∧\\n    Mono partition (saturateCongruence values fuel partition) := by\\n  induction fuel generalizing partition with\\n  | zero => exact ⟨valid, fun _ _ equal => equal⟩\\n  | succ fuel ih =>\\n    simp only [saturateCongruence_step]\\n    split\\n    · exact ⟨valid, fun _ _ equal => equal⟩\\n    · have next := fold_mono (representatives partition) values ({}, partition) valid\\n      have rest := ih _ next.1\\n      exact ⟨rest.1, fun left right equal => rest.2 left right (next.2 left right equal)⟩\\n\\ntheorem explicit_mono (partition : RawPartition) (valid : Valid partition) (edges : List UnionEdge) :\\n    Valid (mergeExplicit partition edges) ∧ Mono partition (mergeExplicit partition edges) := by\\n  induction edges generalizing partition with\\n  | nil => exact ⟨valid, fun _ _ equal => equal⟩\\n  | cons edge rest ih =>\\n    have next := ih _ (merge_valid valid edge.left edge.right)\\n    exact ⟨next.1, fun left right equal => next.2 left right (merge_mono partition valid edge.left edge.right left right equal)⟩\\n\\ntheorem explicit_connected (partition : RawPartition) (valid : Valid partition) (edges : List UnionEdge) :\\n    ∀ edge ∈ edges, canonical (mergeExplicit partition edges) edge.left = canonical (mergeExplicit partition edges) edge.right := by\\n  induction edges generalizing partition with\\n  | nil => simp\\n  | cons edge rest ih =>\\n    intro selected member\\n    rcases List.mem_cons.mp member with same | later\\n    · subst selected\\n      exact (explicit_mono _ (merge_valid valid edge.left edge.right) rest).2 _ _ (merge_join partition valid edge.left edge.right)\\n    · exact ih _ (merge_valid valid edge.left edge.right) selected later\\n\\ntheorem saturation_domain (values : List Value) (fuel : Nat) (partition : RawPartition)\\n    (valid : Valid partition) (covered : values ⊆ partition.flatten) :\\n    Valid (saturateCongruence values fuel partition) ∧\\n      (∀ value, value ∈ (saturateCongruence values fuel partition).flatten ↔ value ∈ partition.flatten) := by\\n  induction fuel generalizing partition with\\n  | zero => exact ⟨valid, fun _ => Iff.rfl⟩\\n  | succ fuel ih =>\\n    simp only [saturateCongruence_step]\\n    split\\n    · exact ⟨valid, fun _ => Iff.rfl⟩\\n    · have next := CongruenceFixed.pass_progress values partition valid covered\\n      have rest := ih _ next.1 (fun value present => (next.2.1 value).mpr (covered present))\\n      exact ⟨rest.1, fun value => (rest.2 value).trans (next.2.1 value)⟩\\n\\ntheorem kernel_domain (roots : List Value) (edges : List UnionEdge) :\\n    Valid (kernelPartition roots edges) ∧\\n      (∀ value, value ∈ (kernelPartition roots edges).flatten ↔ value ∈ kernelValues roots edges) := by\\n  let values := kernelValues roots edges\\n  have initialDomain (value : Value) : value ∈ (initial values).flatten ↔ value ∈ values := by\\n    rw [CongruenceFixed.initial_flatten, HashDistinct.mem]\\n  have prepared := CongruenceFixed.explicit_progress (initial values) (initial_valid values) edges (fun edge member =>\\n    let endpoints := CongruenceFixed.kernel_endpoints roots edges edge member\\n    ⟨(initialDomain edge.left).mpr endpoints.1, (initialDomain edge.right).mpr endpoints.2⟩)\\n  have result := saturation_domain values values.length _ prepared.1\\n    (fun value present => (prepared.2.1 value).mpr ((initialDomain value).mpr present))\\n  exact ⟨result.1, fun value => (result.2 value).trans ((prepared.2.1 value).trans (initialDomain value))⟩\\n\\ntheorem kernel_connected (roots : List Value) (edges : List UnionEdge) :\\n    ∀ edge ∈ edges, canonical (kernelPartition roots edges) edge.left = canonical (kernelPartition roots edges) edge.right := by\\n  intro edge member\\n  let values := kernelValues roots edges\\n  exact (saturation_mono values values.length _ (explicit_valid (initial_valid values) edges)).2 _ _\\n    (explicit_connected (initial values) (initial_valid values) edges edge member)\\n\\ntheorem kernel_closed_signatures (roots : List Value) (edges : List UnionEdge) (left right : Value)\\n    (leftIn : left ∈ kernelValues roots edges) (rightIn : right ∈ kernelValues roots edges)\\n    (same : signature (representatives (kernelPartition roots edges)) left =\\n      signature (representatives (kernelPartition roots edges)) right) :\\n    canonical (kernelPartition roots edges) left = canonical (kernelPartition roots edges) right :=\\n  pass_closed _ _ (kernel_domain roots edges).1 (CongruenceFixed.kernel_fixed roots edges) _ _ leftIn rightIn same\\n\\nmutual\\ntheorem semantic_nested (root member : Value) (present : member ∈ root.semanticNodes) :\\n    member.semanticNodes ⊆ root.semanticNodes := by\\n  cases root with\\n  | atom bytes =>\\n    have same : member = .atom bytes := by simpa [Value.semanticNodes] using present\\n    subst member\\n    exact fun _ member => member\\n  | apply operator arguments =>\\n    simp only [Value.semanticNodes, List.mem_cons] at present ⊢\\n    rcases present with same | nested\\n    · subst member\\n      exact fun _ member => member\\n    · exact fun value member => List.mem_cons_of_mem _ (references_nested arguments _ nested member)\\n\\ntheorem references_nested (arguments : Refs) (member : Value)\\n    (present : member ∈ Value.refsSemanticNodes arguments) :\\n    member.semanticNodes ⊆ Value.refsSemanticNodes arguments := by\\n  cases arguments with\\n  | nil => simp [Value.refsSemanticNodes] at present\\n  | exact _ rest => exact references_nested rest member present\\n  | semantic value rest =>\\n    rcases List.mem_append.mp present with here | there\\n    · exact fun query nested => List.mem_append_left _ (semantic_nested value member here nested)\\n    · exact fun query nested => List.mem_append_right _ (references_nested rest member there nested)\\nend\\n\\ntheorem kernel_semantic_closed (roots : List Value) (edges : List UnionEdge) (value : Value)\\n    (present : value ∈ kernelValues roots edges) : value.semanticNodes ⊆ kernelValues roots edges := by\\n  obtain ⟨root, rootIn, nested⟩ := List.mem_flatMap.mp ((HashDistinct.mem _ _).mp present)\\n  intro query member\\n  exact (HashDistinct.mem _ _).mpr (List.mem_flatMap.mpr ⟨root, rootIn, semantic_nested root value nested member⟩)\\n\\ntheorem representative_canonical (partition : RawPartition) (valid : Valid partition) (value : Value) :\\n    (representatives partition).getD value value = canonical partition value := by\\n  have equation := Authority.raw_lookup partition valid ({} : Representatives) value\\n  change (representatives partition).getD value value = _ at equation\\n  rw [equation]\\n  split\\n  · rfl\\n  · rename_i absent\\n    simp [canonical, lookup_missing partition value absent]\\n\\n/-- A finite completed ground domain. The model below extends it to every\\nfinite Value, including terms absent from the stored or demanded corpus. -/\\nstructure Algebra where\\n  values : List Value\\n  partition : RawPartition\\n  valid : Valid partition\\n  closed : ∀ value ∈ values, value.semanticNodes ⊆ values\\n  signatures : ∀ left ∈ values, ∀ right ∈ values,\\n    signature (representatives partition) left = signature (representatives partition) right →\\n      canonical partition left = canonical partition right\\n\\ndef kernelAlgebra (roots : List Value) (edges : List UnionEdge) : Algebra :=\\n  ⟨kernelValues roots edges, kernelPartition roots edges, (kernel_domain roots edges).1,\\n    kernel_semantic_closed roots edges,\\n    fun left leftIn right rightIn => kernel_closed_signatures roots edges left right leftIn rightIn⟩\\n\\nmutual\\ninductive ModelValue where\\n  | identified (representative : Value)\\n  | atom (bytes : ByteArray)\\n  | apply (operator : Operator) (arguments : ModelRefs)\\ninductive ModelRefs where\\n  | nil\\n  | semantic (value : ModelValue) (tail : ModelRefs)\\n  | exact (value : Value) (tail : ModelRefs)\\nend\\n\\nderiving instance DecidableEq for ModelValue, ModelRefs\\n\\nmutual\\ndef decode : ModelValue → Value\\n  | .identified value => value\\n  | .atom bytes => .atom bytes\\n  | .apply operator arguments => .apply operator (decodeRefs arguments)\\ndef decodeRefs : ModelRefs → Refs\\n  | .nil => .nil\\n  | .semantic value tail => .semantic (decode value) (decodeRefs tail)\\n  | .exact value tail => .exact value (decodeRefs tail)\\nend\\n\\ndef shallowRefs : Refs → ModelRefs\\n  | .nil => .nil\\n  | .semantic value tail => .semantic (.identified value) (shallowRefs tail)\\n  | .exact value tail => .exact value (shallowRefs tail)\\n\\ndef shallow : Value → ModelValue\\n  | .atom bytes => .atom bytes\\n  | .apply operator arguments => .apply operator (shallowRefs arguments)\\n\\ntheorem decode_shallow_refs (arguments : Refs) : decodeRefs (shallowRefs arguments) = arguments := by\\n  cases arguments with\\n  | nil => rfl\\n  | semantic _ tail | exact _ tail => simp [shallowRefs, decodeRefs, decode, decode_shallow_refs tail]\\n\\ntheorem shallow_injective {left right : Value} (equal : shallow left = shallow right) : left = right := by\\n  have restored (value : Value) : decode (shallow value) = value := by\\n    cases value <;> simp [shallow, decode, decode_shallow_refs]\\n  simpa only [restored] using congrArg decode equal\\n\\ndef domainKey (algebra : Algebra) (value : Value) : ModelValue :=\\n  shallow (signature (representatives algebra.partition) value)\\n\\n/-- This is a proof model, not a second search engine. Known ground\\nsignatures evaluate to their class; an unknown structure remains distinct.\\nIt does not enumerate the unbounded universe of terms. -/\\ndef Algebra.lookup (algebra : Algebra) (key : ModelValue) : ModelValue :=\\n  match algebra.values.find? (fun value => decide (domainKey algebra value = key)) with\\n  | some value => .identified (canonical algebra.partition value)\\n  | none => key\\n\\ntheorem lookup_known (algebra : Algebra) (value : Value) (present : value ∈ algebra.values) :\\n    algebra.lookup (domainKey algebra value) = .identified (canonical algebra.partition value) := by\\n  unfold Algebra.lookup\\n  cases found : algebra.values.find? (fun prior => decide (domainKey algebra prior = domainKey algebra value)) with\\n  | none =>\\n    have absent := (List.find?_eq_none.mp found) value present\\n    simp at absent\\n  | some prior =>\\n    have source := List.mem_of_find?_eq_some found\\n    have same : domainKey algebra prior = domainKey algebra value := by\\n      simpa using List.find?_some found\\n    have signatures := shallow_injective same\\n    exact congrArg ModelValue.identified (algebra.signatures prior source value present signatures)\\n\\nmutual\\ndef evaluate (algebra : Algebra) : Value → ModelValue\\n  | .atom bytes => algebra.lookup (.atom bytes)\\n  | .apply operator arguments => algebra.lookup (.apply operator (evaluateRefs algebra arguments))\\ndef evaluateRefs (algebra : Algebra) : Refs → ModelRefs\\n  | .nil => .nil\\n  | .semantic value tail => .semantic (evaluate algebra value) (evaluateRefs algebra tail)\\n  | .exact value tail => .exact value (evaluateRefs algebra tail)\\nend\\n\\nmutual\\ntheorem evaluate_domain (algebra : Algebra) (value : Value) (present : value ∈ algebra.values) :\\n    evaluate algebra value = .identified (canonical algebra.partition value) := by\\n  cases value with\\n  | atom bytes => exact lookup_known algebra (.atom bytes) present\\n  | apply operator arguments =>\\n    have covered : Value.refsSemanticNodes arguments ⊆ algebra.values :=\\n      fun query member => algebra.closed (.apply operator arguments) present (List.mem_cons_of_mem _ member)\\n    change algebra.lookup (.apply operator (evaluateRefs algebra arguments)) = _\\n    rw [evaluate_refs_domain algebra arguments covered]\\n    exact lookup_known algebra (.apply operator arguments) present\\n\\ntheorem evaluate_refs_domain (algebra : Algebra) (arguments : Refs)\\n    (covered : Value.refsSemanticNodes arguments ⊆ algebra.values) :\\n    evaluateRefs algebra arguments = shallowRefs (normalizeRefs (representatives algebra.partition) arguments) := by\\n  cases arguments with\\n  | nil => rfl\\n  | exact value rest =>\\n    change ModelRefs.exact value (evaluateRefs algebra rest) = .exact value (shallowRefs (normalizeRefs _ rest))\\n    rw [evaluate_refs_domain algebra rest covered]\\n  | semantic value rest =>\\n    have present := covered (List.mem_append_left _ (CongruenceFixed.semantic_self value))\\n    have tail : Value.refsSemanticNodes rest ⊆ algebra.values := fun query member => covered (List.mem_append_right _ member)\\n    simp only [evaluateRefs, normalizeRefs, shallowRefs]\\n    rw [evaluate_domain algebra value present, evaluate_refs_domain algebra rest tail,\\n      representative_canonical algebra.partition algebra.valid value]\\nend\\n\\n/-- Semantic congruence is preserved even through arbitrary intermediate\\nterms absent from the finite domain. Exact arguments stay literally equal. -/\\ntheorem evaluate_equivalent (algebra : Algebra) (edges : List UnionEdge)\\n    (joined : ∀ edge ∈ edges, evaluate algebra edge.left = evaluate algebra edge.right)\\n    {left right : Value} (equivalent : Eggshell.Equivalent edges left right) :\\n    evaluate algebra left = evaluate algebra right :=\\n  Eggshell.Equivalent.rec\\n    (motive_1 := fun left right _ => evaluate algebra left = evaluate algebra right)\\n    (motive_2 := fun left right _ => evaluateRefs algebra left = evaluateRefs algebra right)\\n    (fun _ => rfl)\\n    (fun edge member => joined edge member)\\n    (fun _ equal => equal.symm)\\n    (fun _ _ first second => first.trans second)\\n    (fun operator _ same => congrArg (fun arguments => algebra.lookup (.apply operator arguments)) same)\\n    rfl\\n    (fun _ _ head tail =>\\n      (congrArg (fun value => ModelRefs.semantic value _) head).trans\\n        (congrArg (ModelRefs.semantic _) tail))\\n    (fun _ tail => congrArg (ModelRefs.exact _) tail)\\n    equivalent\\n\\ntheorem kernel_complete (roots : List Value) (edges : List UnionEdge) (left right : Value)\\n    (leftIn : left ∈ kernelValues roots edges) (rightIn : right ∈ kernelValues roots edges)\\n    (equivalent : Eggshell.Equivalent edges left right) :\\n    canonical (kernelPartition roots edges) left = canonical (kernelPartition roots edges) right := by\\n  let algebra := kernelAlgebra roots edges\\n  have joined : ∀ edge ∈ edges, evaluate algebra edge.left = evaluate algebra edge.right := by\\n    intro edge member\\n    have endpoints := CongruenceFixed.kernel_endpoints roots edges edge member\\n    rw [evaluate_domain algebra edge.left endpoints.1, evaluate_domain algebra edge.right endpoints.2]\\n    exact congrArg ModelValue.identified (kernel_connected roots edges edge member)\\n  have equal := evaluate_equivalent algebra edges joined equivalent\\n  rw [evaluate_domain algebra left leftIn, evaluate_domain algebra right rightIn] at equal\\n  exact ModelValue.identified.inj equal\\n\\ntheorem evaluate_atom_missing (algebra : Algebra) (bytes : ByteArray)\\n    (missing : Value.atom bytes ∉ algebra.values) : evaluate algebra (.atom bytes) = .atom bytes := by\\n  have absent : algebra.values.find? (fun value => decide (domainKey algebra value = .atom bytes)) = none := by\\n    apply List.find?_eq_none.mpr\\n    intro value present accepted\\n    have key : domainKey algebra value = .atom bytes := by simpa using accepted\\n    have same : signature (representatives algebra.partition) value = .atom bytes :=\\n      shallow_injective key\\n    exact missing ((ApplicationScan.signature_atom _ value bytes same) ▸ present)\\n  simp [evaluate, Algebra.lookup, absent]\\n\\ntheorem evaluate_atom_origin (algebra : Algebra) (value : Value) (bytes : ByteArray)\\n    (equal : evaluate algebra value = .atom bytes) : value = .atom bytes := by\\n  cases value with\\n  | atom other =>\\n    unfold evaluate Algebra.lookup at equal\\n    cases found : algebra.values.find? (fun value => decide (domainKey algebra value = .atom other)) with\\n    | none =>\\n      have same : other = bytes := by simpa only [found, ModelValue.atom.injEq] using equal\\n      exact congrArg Value.atom same\\n    | some prior => simp [found] at equal\\n  | apply operator arguments =>\\n    unfold evaluate Algebra.lookup at equal\\n    cases found : algebra.values.find? (fun value => decide (domainKey algebra value =\\n        .apply operator (evaluateRefs algebra arguments))) <;> simp [found] at equal\\n\\n/-- A completely unmentioned Atom cannot acquire an alias through unseen\\nintermediate applications. This also covers mixed and recursive edges. -/\\ntheorem outside_atom_literal (roots : List Value) (edges : List UnionEdge) (bytes : ByteArray)\\n    (missing : Value.atom bytes ∉ kernelValues roots edges) (value : Value)\\n    (equivalent : Eggshell.Equivalent edges (.atom bytes) value) : Value.atom bytes = value := by\\n  let algebra := kernelAlgebra roots edges\\n  have joined : ∀ edge ∈ edges, evaluate algebra edge.left = evaluate algebra edge.right := by\\n    intro edge member\\n    have endpoints := CongruenceFixed.kernel_endpoints roots edges edge member\\n    rw [evaluate_domain algebra edge.left endpoints.1, evaluate_domain algebra edge.right endpoints.2]\\n    exact congrArg ModelValue.identified (kernel_connected roots edges edge member)\\n  have equal := evaluate_equivalent algebra edges joined equivalent\\n  rw [evaluate_atom_missing algebra bytes missing] at equal\\n  exact (evaluate_atom_origin algebra value bytes equal.symm).symm\\n\\n/-- Completeness of the actual producer on its demanded semantic domain.\\nThe derivation may use arbitrary outside terms; it is not restricted to\\nproofs whose intermediate Values were read from the corpus. -/\\ntheorem build_complete (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (quotient : Quotient) (built : build? roots persistent runLocal = some quotient)\\n    (left right : Value) (leftIn : left ∈ kernelValues roots (persistent ++ runLocal))\\n    (rightIn : right ∈ kernelValues roots (persistent ++ runLocal))\\n    (equivalent : Eggshell.Equivalent (persistent ++ runLocal) left right) :\\n    quotient.toEquality.same left right = true := by\\n  unfold build? at built\\n  split at built\\n  · rename_i empty\\n    have noEdges : persistent = [] ∧ runLocal = [] := by simpa using empty\\n    obtain ⟨rfl, rfl⟩ := noEdges\\n    have literal := Eggshell.Equivalent.without_edges equivalent\\n    subst right\\n    exact quotient.toEquality.reflexive left\\n  · unfold congruenceBuild? at built\\n    apply (Quotient.same_iff_canonical_eq quotient).mpr\\n    rw [certify_lookup (kernel_domain roots (persistent ++ runLocal)).1 built,\\n      certify_lookup (kernel_domain roots (persistent ++ runLocal)).1 built]\\n    exact kernel_complete roots (persistent ++ runLocal) left right leftIn rightIn equivalent\\n\\n/-- Text Work and newly produced text fragments need no corpus-membership\\nassumption. If an Atom is not in the closed edge domain, only literal equality\\nis possible. No old complete root/body catalogue is required. -/\\ntheorem build_complete_atoms (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (quotient : Quotient) (built : build? roots persistent runLocal = some quotient)\\n    (left right : ByteArray) (equivalent : Eggshell.Equivalent (persistent ++ runLocal) (.atom left) (.atom right)) :\\n    quotient.toEquality.same (.atom left) (.atom right) = true := by\\n  by_cases leftIn : Value.atom left ∈ kernelValues roots (persistent ++ runLocal)\\n  · by_cases rightIn : Value.atom right ∈ kernelValues roots (persistent ++ runLocal)\\n    · exact build_complete roots persistent runLocal quotient built _ _ leftIn rightIn equivalent\\n    · have literal := outside_atom_literal roots (persistent ++ runLocal) right rightIn (.atom left) (.symm equivalent)\\n      rw [literal]\\n      exact quotient.toEquality.reflexive _\\n  · have literal := outside_atom_literal roots (persistent ++ runLocal) left leftIn (.atom right) equivalent\\n    rw [literal]\\n    exact quotient.toEquality.reflexive _\\n\\ntheorem kernel_root (roots : List Value) (edges : List UnionEdge) (value : Value)\\n    (present : value ∈ roots) : value ∈ kernelValues roots edges :=\\n  (HashDistinct.mem _ _).mpr (List.mem_flatMap.mpr\\n    ⟨value, List.mem_append_left _ present, CongruenceFixed.semantic_self value⟩)\\n\\nend Eggshell.QuotientBuilder.CongruenceComplete\\n\",[]]"],["Eggshell.CongruenceFixed","[\"module\\n\\npublic import Eggshell.QuotientAuthority\\n\\n@[expose] public section\\nnamespace Eggshell.QuotientBuilder.CongruenceFixed\\nopen Partition\\n\\n/-- Removing a present class only moves that class to the front. -/\\ntheorem take_perm (partition : RawPartition) (value : Value)\\n    (present : value ∈ partition.flatten) :\\n    partition.Perm (lookup partition value :: (takeClass value partition).2) := by\\n  induction partition with\\n  | nil => simp at present\\n  | cons head tail ih =>\\n    by_cases here : value ∈ head\\n    · simp [lookup, takeClass, here]\\n    · have there : value ∈ tail.flatten := by simpa [List.flatten_cons, here] using present\\n      simpa [lookup, takeClass, here] using\\n        (List.Perm.cons head (ih there)).trans (List.Perm.swap _ _ _)\\n\\ntheorem merge_progress {partition : RawPartition} (valid : Valid partition)\\n    (left right : Value) (leftIn : left ∈ partition.flatten) (rightIn : right ∈ partition.flatten) :\\n    Valid (merge partition left right) ∧\\n      (∀ value, value ∈ (merge partition left right).flatten ↔ value ∈ partition.flatten) ∧\\n      (merge partition left right).length ≤ partition.length ∧\\n      ((merge partition left right).length = partition.length → merge partition left right = partition) := by\\n  refine ⟨merge_valid valid left right, ?_⟩\\n  cases matched : same partition left right with\\n  | true => simp [merge, matched]\\n  | false =>\\n    have outside : right ∉ lookup partition left := by\\n      rw [same_lookup valid] at matched\\n      simpa using matched\\n    have first := take_perm partition left leftIn\\n    have rightRemaining : right ∈ (takeClass left partition).2.flatten := by\\n      have member := first.flatten.mem_iff.mp rightIn\\n      simpa [List.flatten_cons, outside] using member\\n    have second := take_perm (takeClass left partition).2 right rightRemaining\\n    have ordered := first.trans (List.Perm.cons _ second)\\n    rw [merge_eq valid left right matched]\\n    refine ⟨?_, ?_, ?_⟩\\n    · intro value\\n      simpa [List.flatten_cons, List.append_assoc] using (ordered.flatten.mem_iff (a := value)).symm\\n    · have count := ordered.length_eq\\n      simp only [List.length_cons] at count ⊢\\n      omega\\n    · have count := ordered.length_eq\\n      simp only [List.length_cons] at count ⊢\\n      omega\\n\\ndef SeenInside (partition : RawPartition) (seen : Representatives) : Prop :=\\n  ∀ (key value : Value), seen[key]? = some value → value ∈ partition.flatten\\n\\ntheorem seen_insert (partition : RawPartition) (seen : Representatives)\\n    (inside : SeenInside partition seen) (key value : Value) (present : value ∈ partition.flatten) :\\n    SeenInside partition (seen.insert key value) := by\\n  intro query found stored\\n  rw [Std.HashMap.getElem?_insert] at stored\\n  split at stored\\n  · have equal := Option.some.inj stored\\n    simpa [← equal] using present\\n  · exact inside query found stored\\n\\ntheorem step_progress (index : Representatives) (state : Representatives × RawPartition)\\n    (valid : Valid state.2) (inside : SeenInside state.2 state.1)\\n    (value : Value) (present : value ∈ state.2.flatten) :\\n    Valid (applicationStep index state value).2 ∧\\n      SeenInside (applicationStep index state value).2 (applicationStep index state value).1 ∧\\n      (∀ query, query ∈ (applicationStep index state value).2.flatten ↔ query ∈ state.2.flatten) ∧\\n      (applicationStep index state value).2.length ≤ state.2.length ∧\\n      ((applicationStep index state value).2.length = state.2.length →\\n        (applicationStep index state value).2 = state.2) := by\\n  rcases state with ⟨seen, partition⟩\\n  cases value with\\n  | atom bytes => exact ⟨valid, inside, fun _ => Iff.rfl, Nat.le_refl _, fun _ => rfl⟩\\n  | apply operator arguments =>\\n    cases found : seen[signature index (.apply operator arguments)]? with\\n    | none =>\\n      simpa only [applicationStep, congruenceStep, found] using\\n        (show Valid partition ∧\\n          SeenInside partition (seen.insert (signature index (.apply operator arguments)) (.apply operator arguments)) ∧\\n          (∀ query, query ∈ partition.flatten ↔ query ∈ partition.flatten) ∧\\n          partition.length ≤ partition.length ∧ (partition.length = partition.length → partition = partition) from\\n          ⟨valid, seen_insert partition seen inside _ _ present,\\n            fun _ => Iff.rfl, Nat.le_refl _, fun _ => rfl⟩)\\n    | some prior =>\\n      have next := merge_progress valid prior _ (inside _ _ found) present\\n      simpa only [applicationStep, congruenceStep, found] using\\n        (show Valid (merge partition prior (.apply operator arguments)) ∧\\n          SeenInside (merge partition prior (.apply operator arguments)) seen ∧\\n          (∀ query, query ∈ (merge partition prior (.apply operator arguments)).flatten ↔ query ∈ partition.flatten) ∧\\n          (merge partition prior (.apply operator arguments)).length ≤ partition.length ∧\\n          ((merge partition prior (.apply operator arguments)).length = partition.length →\\n            merge partition prior (.apply operator arguments) = partition) from\\n          ⟨next.1, fun key value stored => (next.2.1 value).mpr (inside key value stored), next.2⟩)\\n\\ntheorem fold_progress (index : Representatives) (values : List Value)\\n    (state : Representatives × RawPartition) (valid : Valid state.2)\\n    (inside : SeenInside state.2 state.1) (covered : values ⊆ state.2.flatten) :\\n    Valid (values.foldl (applicationStep index) state).2 ∧\\n      (∀ value, value ∈ (values.foldl (applicationStep index) state).2.flatten ↔ value ∈ state.2.flatten) ∧\\n      (values.foldl (applicationStep index) state).2.length ≤ state.2.length ∧\\n      ((values.foldl (applicationStep index) state).2.length = state.2.length →\\n        (values.foldl (applicationStep index) state).2 = state.2) := by\\n  induction values generalizing state with\\n  | nil => exact ⟨valid, fun _ => Iff.rfl, Nat.le_refl _, fun _ => rfl⟩\\n  | cons value rest ih =>\\n    have next := step_progress index state valid inside value (covered (by simp))\\n    have later := ih _ next.1 next.2.1 (fun v member =>\\n      (next.2.2.1 v).mpr (covered (by simp [member])))\\n    simp only [List.foldl_cons]\\n    refine ⟨later.1, fun v => (later.2.1 v).trans (next.2.2.1 v),\\n      Nat.le_trans later.2.2.1 next.2.2.2.1, ?_⟩\\n    intro count\\n    have firstCount : (applicationStep index state value).2.length = state.2.length := by omega\\n    have lastCount : (rest.foldl (applicationStep index) (applicationStep index state value)).2.length =\\n        (applicationStep index state value).2.length := by omega\\n    exact (later.2.2.2 lastCount).trans (next.2.2.2.2 firstCount)\\n\\n/-- A changed pass strictly removes a class. Reordering or a cached script\\ncannot consume fuel without semantic progress. All values are already in the\\nclosed input domain, so the pass cannot introduce a new class. -/\\ntheorem pass_progress (values : List Value) (partition : RawPartition)\\n    (valid : Valid partition) (covered : values ⊆ partition.flatten) :\\n    Valid (congruencePass values partition) ∧\\n      (∀ value, value ∈ (congruencePass values partition).flatten ↔ value ∈ partition.flatten) ∧\\n      (congruencePass values partition).length ≤ partition.length ∧\\n      ((congruencePass values partition).length = partition.length →\\n        congruencePass values partition = partition) :=\\n  fold_progress (representatives partition) values ({}, partition) valid\\n    (by simp [SeenInside]) covered\\n\\n/-- The actual interpreter reaches a fixed point within the number of\\nremaining classes, independently of payload sizes, mixed/cyclic unions or\\nthe contents of an old join plan. This is a step bound, not a wall-clock SLO. -/\\ntheorem saturation_fixed (values : List Value) (fuel : Nat) (partition : RawPartition)\\n    (valid : Valid partition) (covered : values ⊆ partition.flatten)\\n    (enough : partition.length ≤ fuel) :\\n    congruencePass values (saturateCongruence values fuel partition) =\\n      saturateCongruence values fuel partition := by\\n  induction fuel generalizing partition with\\n  | zero =>\\n    have empty : partition = [] := List.eq_nil_of_length_eq_zero (by omega)\\n    subst partition\\n    have noValues : values = [] := List.eq_nil_iff_forall_not_mem.mpr (by\\n      intro value member\\n      have impossible := covered member\\n      simp at impossible)\\n    subst values\\n    rfl\\n  | succ fuel ih =>\\n    simp only [saturateCongruence_step]\\n    by_cases changed : congruencePass values partition = partition\\n    · simp only [changed, ↓reduceIte]\\n    · simp only [changed, ↓reduceIte]\\n      have next := pass_progress values partition valid covered\\n      have strict : (congruencePass values partition).length < partition.length := by\\n        have unequal : (congruencePass values partition).length ≠ partition.length :=\\n          fun count => changed (next.2.2.2 count)\\n        omega\\n      exact ih _ next.1 (fun value present => (next.2.1 value).mpr (covered present)) (by omega)\\n\\ntheorem initial_flatten (values : List Value) : (initial values).flatten = hashDistinct values := by\\n  have singletons (items : List Value) : (items.map (fun value => [value])).flatten = items := by\\n    induction items <;> simp_all\\n  exact singletons _\\n\\ntheorem explicit_progress (partition : RawPartition) (valid : Valid partition) (edges : List UnionEdge)\\n    (endpoints : ∀ edge ∈ edges, edge.left ∈ partition.flatten ∧ edge.right ∈ partition.flatten) :\\n    Valid (mergeExplicit partition edges) ∧\\n      (∀ value, value ∈ (mergeExplicit partition edges).flatten ↔ value ∈ partition.flatten) ∧\\n      (mergeExplicit partition edges).length ≤ partition.length := by\\n  induction edges generalizing partition with\\n  | nil => exact ⟨valid, fun _ => Iff.rfl, Nat.le_refl _⟩\\n  | cons edge rest ih =>\\n    have present := endpoints edge (by simp)\\n    have next := merge_progress valid edge.left edge.right present.1 present.2\\n    have later := ih _ next.1 (fun other member =>\\n      let before := endpoints other (by simp [member])\\n      ⟨(next.2.1 other.left).mpr before.1, (next.2.1 other.right).mpr before.2⟩)\\n    exact ⟨later.1, fun value => (later.2.1 value).trans (next.2.1 value),\\n      Nat.le_trans later.2.2 next.2.2.1⟩\\n\\ntheorem semantic_self (value : Value) : value ∈ value.semanticNodes := by\\n  cases value <;> simp [Value.semanticNodes]\\n\\ntheorem kernel_endpoints (roots : List Value) (edges : List UnionEdge) :\\n    ∀ edge ∈ edges, edge.left ∈ kernelValues roots edges ∧ edge.right ∈ kernelValues roots edges := by\\n  intro edge present\\n  have containsEndpoint (value : Value) (endpoint : value = edge.left ∨ value = edge.right) :\\n      value ∈ kernelValues roots edges := by\\n    apply (HashDistinct.mem _ _).mpr\\n    apply List.mem_flatMap.mpr\\n    refine ⟨value, List.mem_append_right _ (List.mem_flatMap.mpr ⟨edge, present, ?_⟩), semantic_self value⟩\\n    rcases endpoint with left | right\\n    · exact List.mem_append_left _ (left ▸ semantic_self edge.left)\\n    · exact List.mem_append_right _ (right ▸ semantic_self edge.right)\\n  exact ⟨containsEndpoint edge.left (Or.inl rfl), containsEndpoint edge.right (Or.inr rfl)⟩\\n\\n/-- The production builder's chosen fuel is sufficient, not a heuristic\\niteration cap. No old result or assumed completed-output equality is used. -/\\ntheorem kernel_fixed (roots : List Value) (edges : List UnionEdge) :\\n    congruencePass (kernelValues roots edges) (kernelPartition roots edges) = kernelPartition roots edges := by\\n  let values := kernelValues roots edges\\n  have domain (value : Value) : value ∈ (initial values).flatten ↔ value ∈ values := by\\n    rw [initial_flatten, HashDistinct.mem]\\n  have prepared := explicit_progress (initial values) (initial_valid values) edges (fun edge member =>\\n    let endpoints := kernel_endpoints roots edges edge member\\n    ⟨(domain edge.left).mpr endpoints.1, (domain edge.right).mpr endpoints.2⟩)\\n  apply saturation_fixed values values.length _ prepared.1\\n  · exact fun value present => (prepared.2.1 value).mpr ((domain value).mpr present)\\n  · have count : (initial values).length ≤ values.length := by\\n      simpa only [initial, List.length_map] using HashDistinct.length_le values\\n    exact Nat.le_trans prepared.2.2 count\\n\\nend Eggshell.QuotientBuilder.CongruenceFixed\\n\",[]]"],["Eggshell.CongruenceSound","[\"module\\n\\npublic import Eggshell.CongruenceComplete\\n\\n@[expose] public section\\nnamespace Eggshell.QuotientBuilder.CongruenceSound\\nopen Partition\\n\\n/-- Each computed class is generated by today's edges and Semantic\\ncongruence. Exact-footprint safety alone cannot establish this provenance. -/\\ndef Sound (edges : List UnionEdge) (partition : RawPartition) : Prop :=\\n  ∀ query, ∀ member ∈ lookup partition query,\\n    Eggshell.Equivalent edges member query\\n\\ndef IndexSound (edges : List UnionEdge) (index : Representatives) : Prop :=\\n  ∀ value, Eggshell.Equivalent edges value (index.getD value value)\\n\\ntheorem empty_sound (edges : List UnionEdge) : Sound edges [] := by\\n  intro query member present\\n  have equal : member = query := by simpa [lookup, takeClass] using present\\n  subst member\\n  exact .refl query\\n\\ntheorem initial_sound (edges : List UnionEdge) (values : List Value) :\\n    Sound edges (initial values) := by\\n  intro query member present\\n  rw [initial_equivalent_empty values query] at present\\n  exact empty_sound edges query member present\\n\\ntheorem merge_sound {edges : List UnionEdge} {partition : RawPartition}\\n    (valid : Valid partition) (sound : Sound edges partition) (left right : Value)\\n    (generated : Eggshell.Equivalent edges left right) :\\n    Sound edges (merge partition left right) := by\\n  intro query member present\\n  rw [merge_lookup valid] at present\\n  split at present\\n  · exact sound query member present\\n  · split at present\\n    · rename_i _ inside\\n      have queryLeft : Eggshell.Equivalent edges query left := by\\n        rcases List.mem_append.mp inside with first | second\\n        · exact sound left query first\\n        · exact .trans (sound right query second) (.symm generated)\\n      apply Eggshell.Equivalent.trans _ (.symm queryLeft)\\n      rcases List.mem_append.mp present with first | second\\n      · exact sound left member first\\n      · exact .trans (sound right member second) (.symm generated)\\n    · exact sound query member present\\n\\ntheorem explicit_sound {edges : List UnionEdge} {partition : RawPartition}\\n    (valid : Valid partition) (sound : Sound edges partition) (updates : List UnionEdge)\\n    (current : ∀ edge ∈ updates, edge ∈ edges) :\\n    Sound edges (mergeExplicit partition updates) := by\\n  induction updates generalizing partition with\\n  | nil => exact sound\\n  | cons edge rest ih =>\\n    exact ih (merge_valid valid edge.left edge.right)\\n      (merge_sound valid sound edge.left edge.right (.union edge (current edge (by simp))))\\n      (fun next member => current next (by simp [member]))\\n\\ntheorem representatives_sound {edges : List UnionEdge} {partition : RawPartition}\\n    (valid : Valid partition) (sound : Sound edges partition) :\\n    IndexSound edges (representatives partition) := by\\n  intro query\\n  have equation := Authority.raw_lookup partition valid ({} : Representatives) query\\n  change (representatives partition).getD query query = _ at equation\\n  rw [equation]\\n  split\\n  · apply Eggshell.Equivalent.symm\\n    apply sound query\\n    have present := lookup_contains partition query\\n    cases found : lookup partition query with\\n    | nil => simp [found] at present\\n    | cons head rest => simp\\n  · simpa using Eggshell.Equivalent.refl (edges := edges) query\\n\\ntheorem normalize_sound (edges : List UnionEdge) (index : Representatives)\\n    (sound : IndexSound edges index) (arguments : Refs) :\\n    RefsEquivalent edges arguments (normalizeRefs index arguments) := by\\n  cases arguments with\\n  | nil => exact .nil\\n  | semantic value rest =>\\n      exact .semantic (sound value) (normalize_sound edges index sound rest)\\n  | exact value rest => exact .exact (normalize_sound edges index sound rest)\\ntermination_by sizeOf arguments\\n\\ntheorem signature_sound (edges : List UnionEdge) (index : Representatives)\\n    (sound : IndexSound edges index) (value : Value) :\\n    Eggshell.Equivalent edges value (signature index value) := by\\n  cases value with\\n  | atom bytes => exact .refl _\\n  | apply operator arguments => exact .apply operator (normalize_sound edges index sound arguments)\\n\\ntheorem application_step (edges : List UnionEdge) (index : Representatives)\\n    (indexSound : IndexSound edges index) (state : Representatives × RawPartition)\\n    (valid : Valid state.2) (sound : Sound edges state.2)\\n    (seen : ApplicationScan.Sound index state.1) (value : Value) :\\n    Valid (applicationStep index state value).2 ∧ Sound edges (applicationStep index state value).2 ∧\\n      ApplicationScan.Sound index (applicationStep index state value).1 := by\\n  rcases state with ⟨known, partition⟩\\n  cases value with\\n  | atom bytes => exact ⟨valid, sound, seen⟩\\n  | apply operator arguments =>\\n    cases found : known[signature index (.apply operator arguments)]? with\\n    | none =>\\n      simp only [applicationStep, congruenceStep, found]\\n      exact ⟨valid, sound, ApplicationScan.sound_insert index known seen _⟩\\n    | some prior =>\\n      have priorSignature := signature_sound edges index indexSound prior\\n      rw [seen _ _ found] at priorSignature\\n      have generated := Eggshell.Equivalent.trans priorSignature\\n        (.symm (signature_sound edges index indexSound (.apply operator arguments)))\\n      simp only [applicationStep, congruenceStep, found]\\n      exact ⟨merge_valid valid prior _, merge_sound valid sound prior _ generated, seen⟩\\n\\ntheorem application_fold (edges : List UnionEdge) (index : Representatives)\\n    (indexSound : IndexSound edges index) (values : List Value)\\n    (state : Representatives × RawPartition) (valid : Valid state.2)\\n    (sound : Sound edges state.2) (seen : ApplicationScan.Sound index state.1) :\\n    Valid (values.foldl (applicationStep index) state).2 ∧\\n      Sound edges (values.foldl (applicationStep index) state).2 := by\\n  induction values generalizing state with\\n  | nil => exact ⟨valid, sound⟩\\n  | cons value rest ih =>\\n    have next := application_step edges index indexSound state valid sound seen value\\n    exact ih _ next.1 next.2.1 next.2.2\\n\\ntheorem congruence_sound (edges : List UnionEdge) (values : List Value)\\n    {partition : RawPartition} (valid : Valid partition) (sound : Sound edges partition) :\\n    Valid (congruencePass values partition) ∧ Sound edges (congruencePass values partition) :=\\n  application_fold edges (representatives partition) (representatives_sound valid sound) values\\n    ({}, partition) valid sound (by simp [ApplicationScan.Sound])\\n\\ntheorem saturation_sound (edges : List UnionEdge) (values : List Value) (fuel : Nat)\\n    {partition : RawPartition} (valid : Valid partition) (sound : Sound edges partition) :\\n    Valid (saturateCongruence values fuel partition) ∧\\n      Sound edges (saturateCongruence values fuel partition) := by\\n  induction fuel generalizing partition with\\n  | zero => exact ⟨valid, sound⟩\\n  | succ fuel ih =>\\n    simp only [saturateCongruence_step]\\n    split\\n    · exact ⟨valid, sound⟩\\n    · have next := congruence_sound edges values valid sound\\n      exact ih next.1 next.2\\n\\ndef QuotientSound (edges : List UnionEdge) (quotient : Quotient) : Prop :=\\n  ∀ left right, quotient.toEquality.same left right = true →\\n    Eggshell.Equivalent edges left right\\n\\ntheorem certified_sound (edges : List UnionEdge) {partition : RawPartition}\\n    (valid : Valid partition) (sound : Sound edges partition) {quotient : Quotient}\\n    (certified : certify partition = some quotient) : QuotientSound edges quotient := by\\n  intro left right equal\\n  have heads : (lookup partition left).headD left = (lookup partition right).headD right := by\\n    simpa only [Quotient.same_iff_canonical_eq, certify_lookup valid certified] using equal\\n  exact .symm (sound left right ((heads_equal valid left right).mp heads))\\n\\n/-- Any equality returned by the actual builder, for any roots, corrections,\\ndeletions or mixed Atom/Apply edges, follows from the current edge set. -/\\ntheorem build_sound (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (quotient : Quotient) (built : build? roots persistent runLocal = some quotient) :\\n    QuotientSound (persistent ++ runLocal) quotient := by\\n  unfold build? at built\\n  split at built\\n  · cases Option.some.inj built\\n    intro left right same\\n    have same : left = right := by simpa [Quotient.toEquality, Quotient.literal_canonical] using same\\n    subst right\\n    exact .refl left\\n  · unfold congruenceBuild? kernelPartition at built\\n    let values := kernelValues roots (persistent ++ runLocal)\\n    have prepared := saturation_sound (persistent ++ runLocal) values values.length\\n      (explicit_valid (initial_valid values) _) (explicit_sound (initial_valid values) (initial_sound _ values) _\\n        (fun _ member => member))\\n    exact certified_sound _ prepared.1 prepared.2 built\\n\\n/-- The runtime producer returns a generated quotient, not just an\\nauthority-safe arbitrary partition. Proofs erase; no second scan is added. -/\\nstructure Checked (roots : List Value) (persistent runLocal : List UnionEdge) where\\n  quotient : Quotient\\n  built : build? roots persistent runLocal = some quotient\\n  generated : QuotientSound (persistent ++ runLocal) quotient\\n  fixed : congruencePass (kernelValues roots (persistent ++ runLocal))\\n      (kernelPartition roots (persistent ++ runLocal)) = kernelPartition roots (persistent ++ runLocal)\\n  complete : ∀ left ∈ kernelValues roots (persistent ++ runLocal),\\n    ∀ right ∈ kernelValues roots (persistent ++ runLocal),\\n      Eggshell.Equivalent (persistent ++ runLocal) left right → quotient.toEquality.same left right = true\\n\\ntheorem Checked.ungenerated_rejected (checked : Checked roots persistent runLocal)\\n    (left right : Value) (unsupported : ¬ Eggshell.Equivalent (persistent ++ runLocal) left right) :\\n    checked.quotient.toEquality.same left right = false := by\\n  cases observed : checked.quotient.toEquality.same left right with\\n  | false => rfl\\n  | true => exact False.elim (unsupported (checked.generated left right observed))\\n\\ntheorem Checked.without_edges (checked : Checked roots [] []) (left right : Value) :\\n    checked.quotient.toEquality.same left right = true ↔ left = right := by\\n  constructor\\n  · intro same\\n    exact Eggshell.Equivalent.without_edges (checked.generated left right same)\\n  · intro same\\n    subst right\\n    exact checked.quotient.toEquality.reflexive left\\n\\n/-- Corpus pruning/extension cannot change any comparison whose two terms\\nbelong to both closed domains. The current generating edges are fixed;\\nneither final-result equality nor a corpus-size bound is assumed. -/\\ntheorem Checked.domain_independent (first : Checked roots persistent runLocal)\\n    (second : Checked otherRoots persistent runLocal) (left right : Value)\\n    (firstLeft : left ∈ kernelValues roots (persistent ++ runLocal))\\n    (firstRight : right ∈ kernelValues roots (persistent ++ runLocal))\\n    (secondLeft : left ∈ kernelValues otherRoots (persistent ++ runLocal))\\n    (secondRight : right ∈ kernelValues otherRoots (persistent ++ runLocal)) :\\n    first.quotient.toEquality.same left right = second.quotient.toEquality.same left right := by\\n  apply Bool.eq_iff_iff.mpr\\n  exact ⟨fun same => second.complete left secondLeft right secondRight (first.generated left right same),\\n    fun same => first.complete left firstLeft right firstRight (second.generated left right same)⟩\\n\\n/-- Text Work and ephemeral text fragments are independent of the root\\ncatalogue even when the edge set contains mixed Atom/Apply unions. -/\\ntheorem Checked.atoms_independent (first : Checked roots persistent runLocal)\\n    (second : Checked otherRoots persistent runLocal) (left right : ByteArray) :\\n    first.quotient.toEquality.same (.atom left) (.atom right) =\\n      second.quotient.toEquality.same (.atom left) (.atom right) := by\\n  apply Bool.eq_iff_iff.mpr\\n  exact ⟨fun same => CongruenceComplete.build_complete_atoms otherRoots persistent runLocal second.quotient second.built\\n      left right (first.generated _ _ same),\\n    fun same => CongruenceComplete.build_complete_atoms roots persistent runLocal first.quotient first.built\\n      left right (second.generated _ _ same)⟩\\n\\ndef attach (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (result : Option Quotient) (exact : result = build? roots persistent runLocal) :\\n    Option (Checked roots persistent runLocal) :=\\n  match result with\\n  | none => none\\n  | some quotient =>\\n      some ⟨quotient, exact.symm, build_sound roots persistent runLocal quotient exact.symm,\\n        CongruenceFixed.kernel_fixed roots (persistent ++ runLocal),\\n        fun left leftIn right rightIn =>\\n          CongruenceComplete.build_complete roots persistent runLocal quotient exact.symm left right leftIn rightIn⟩\\n\\ntheorem attach_exact (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (result : Option Quotient) (exact : result = build? roots persistent runLocal) :\\n    (attach roots persistent runLocal result exact).map (·.quotient) = result := by\\n  cases result <;> rfl\\n\\nend Eggshell.QuotientBuilder.CongruenceSound\\n\",[]]"],["Eggshell.ContentCapture","[\"module\\npublic import Eggshell.ObservedRecords\\npublic import tools.ContentCorrespondence\\n@[expose] public section\\n\\nnamespace Eggshell.ContentCapture\\nopen Lean Synapses Synapses.Extraction\\nopen ContentCorrespondence\\n\\n/-- Literal coordinates supplement the original record. They are not an\\nexecution certificate, a closed dependency set, or a reason to union Work. -/\\nstructure Alias where\\n  file : Synapses.File\\n  line : Nat\\n  spelling : Synapses.ObservedRecords.Spelling\\n  chars : Nat\\n  first : Nat\\n  limit : Nat\\n  deriving Repr, BEq, ToJson, FromJson\\n\\nstructure Captured where\\n  implementation : String\\n  /-- Export only files referenced by accepted matches. Unmatched argument\\n  files and failed scans remain in the private pre-call capture. -/\\n  inputs : Array SourceEvidence.File\\n  complete : Bool\\n  aliases : Array Alias\\n  failure : Option String := none\\n  deriving Repr, ToJson, FromJson\\n\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.content-capture\\\".toUTF8 [\\n  (include_str \\\"ContentCapture.lean\\\").toUTF8,\\n  (include_str \\\"ContentMetadata.lean\\\").toUTF8,(include_str \\\"SourceEvidence.lean\\\").toUTF8,\\n  (include_str \\\"FileSystem.lean\\\").toUTF8,\\n  (include_str \\\"../tools/ContentCorrespondence.lean\\\").toUTF8,\\n  Synapses.ObservedRecords.implementation.toUTF8])\\n\\nstructure Output where\\n  spelling : Synapses.ObservedRecords.Spelling\\n  text : String\\n\\n/-- Index actual data projections, never a command or provider name. Base\\npartitions remain in ObservedRecords even if no file correspondence exists. -/\\ndef outputs (raw : String) : Array Output := Id.run do\\n  let characters := raw.toList.toArray\\n  let mut result := #[]\\n  let mut seen : Std.HashSet (Nat × Nat × Synapses.ObservedRecords.Projection) := {}\\n  for record in Synapses.ObservedRecords.normalize raw do\\n    for spelling in record.spellings do\\n      unless [Synapses.ObservedRecords.Projection.rawLine,.stringBodyLine,.string].contains spelling.projection do continue\\n      let key := (spelling.first,spelling.limit,spelling.projection)\\n      if seen.contains key then continue\\n      seen := seen.insert key\\n      let some text := Synapses.ObservedRecords.project characters spelling | continue\\n      unless !text.isEmpty && !text.contains '\\\\n' do continue\\n      result := result.push ⟨spelling,text⟩\\n  return result\\n\\n
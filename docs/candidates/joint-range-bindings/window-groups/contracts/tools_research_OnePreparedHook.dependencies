vidence ← match timing with\\n      | .interval value =>\\n          if valid : value.valid = true then pure (.observed value valid)\\n          else throw \\\"invalid observed native interval\\\"\\n      | .awaiting => pure .awaiting\\n      | .unavailable => pure .unavailable\\n    return ({tool,occurrence,evidence} : NativePublication.Item)\\n  if matching : NativePublication.matchesPending pending items = true then\\n    return ⟨pending,target.normalize,some identity,capsule.checkpoint,items,matching⟩\\n  else throw \\\"native capsule changed its original observations\\\"\\n\\nstructure Project where\\n  database : String\\n  capability : String\\n  deriving ToJson, FromJson\\n\\ndef directory : IO System.FilePath := do\\n  let root := (← Paths.dataRoot) / \\\"publisher\\\"\\n  FileSystem.rejectSymlinkAncestors root\\n  FileSystem.privateDirectory root\\n  return root\\n\\n/-- Installation paths and copy mtimes are not service generations. The same\\nsource protocol can share one owner across clients built from the same code. -/\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.project-service\\\".toUTF8 [\\n  (include_str \\\"PublicationWire.lean\\\").toUTF8,(include_str \\\"PublicationClient.lean\\\").toUTF8,\\n  (include_str \\\"PublicationService.lean\\\").toUTF8,(include_str \\\"NativePublication.lean\\\").toUTF8,\\n  (include_str \\\"CanonicalSourcePrepared.lean\\\").toUTF8,(include_str \\\"DaemonWire.lean\\\").toUTF8,\\n  (include_str \\\"PluginModel.lean\\\").toUTF8,(include_str \\\"DB/PageMap.lean\\\").toUTF8,\\n  (include_str \\\"DB/Sidecar.lean\\\").toUTF8,\\n  CanonicalSource.Cache.implementation.toUTF8,Index.implementation.toUTF8])\\n\\ninitialize runtimeGeneration : String ← pure implementation\\n\\ndef generation : IO String := pure runtimeGeneration\\n\\ndef maxClients : Nat := 128\\ndef maxResidentBytes : Nat := 64*1024*1024\\ndef maxBudgetMs : Nat := 28000\\n\\nend Eggshell.Plugin.Publication\\n\"],[\"PublicationClient.lean\",\"module\\n\\npublic import Eggshell.PublicationWire\\npublic import Eggshell.Numerical\\npublic import Eggshell.CanonicalSourcePrepared\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin.Publication.Client\\nopen Lean DB\\n\\nstructure SourceReference where\\n  endpoint : Daemon.Endpoint\\n  access : Synapses.CanonicalSource.Shared.Access\\n\\ndef SourceReference.metadata (reference : SourceReference) := reference.access.metadata\\n\\ndef SourceReference.identity (reference : SourceReference) : Json := reference.access.identity\\n\\ndef liveBudget (deadline : Nat) : IO Nat := do\\n  let now ← IO.monoMsNow\\n  unless now < deadline do throw (IO.userError \\\"prepared source request expired\\\")\\n  return min maxBudgetMs (deadline-now)\\n\\n/-- An explicitly supplied data-side owner is useful to native clients and\\ndoes not require a writer registration for a read-only source. -/\\ndef prepareSourceUsing (endpoint : Daemon.Endpoint) (source : PageMap.Snapshot)\\n    (storage : Sidecar.Storage) (deadline : Nat) : IO (Option SourceReference) := do\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange endpoint \\\"prepare-source\\\" (Json.mkObj [\\n    (\\\"directory\\\",toJson source.directory.toString),(\\\"source\\\",toJson source.head),(\\\"storage\\\",toJson storage),\\n    (\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let value ← IO.ofExcept (Json.parse response)\\n  if value == Json.null then return none\\n  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)\\n  unless access.database == source.head.identity && access.source == source.head &&\\n      access.metadata.source.identity == source.head.identity && Synapses.digest access.scope &&\\n      Synapses.digest access.capability &&\\n      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do\\n    throw (IO.userError \\\"prepared source reply changed its scope or source\\\")\\n  return some ⟨{endpoint with secret := access.capability},access⟩\\n\\n/-- After local administration grants a read scope, refreshing it needs only\\nthat scope's read capability, including when the publisher is another owner. -/\\ndef SourceReference.refresh (reference : SourceReference) (source : PageMap.Head)\\n    (deadline : Nat) : IO (Option SourceReference) := do\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange reference.endpoint \\\"refresh-source\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson reference.access.database),(\\\"scope\\\",toJson reference.access.scope),\\n    (\\\"source\\\",toJson (some source)),(\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let value ← IO.ofExcept (Json.parse response)\\n  if value == Json.null then return none\\n  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)\\n  unless access.database == reference.access.database && access.scope == reference.access.scope &&\\n      access.capability == reference.access.capability && access.source == source &&\\n      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do\\n    throw (IO.userError \\\"prepared source refresh changed its read authority\\\")\\n  return some ⟨reference.endpoint,access⟩\\n\\ndef sourceRows (reference : SourceReference) (owners : Array String) (deadline : Nat) :\\n    IO Synapses.CanonicalSource.Shared.Projection := do\\n  let access := reference.access\\n  let owners := (hashDistinct owners.toList).toArray\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange reference.endpoint \\\"source-rows\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson access.database),(\\\"scope\\\",toJson access.scope),(\\\"source\\\",toJson access.source),\\n    (\\\"metadata\\\",toJson access.metadata),(\\\"owners\\\",toJson owners),(\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let result ← IO.ofExcept (Json.parse response >>= fromJson? (α := Synapses.CanonicalSource.Shared.Projection))\\n  unless result.identity == reference.identity && result.rows.map Prod.fst == owners do\\n    throw (IO.userError \\\"prepared source projection changed its owner domain\\\")\\n  for (owner,rows) in result.rows do\\n    unless rows.all (fun row => row.origins.all (fun origin =>\\n        origin.binding.database == access.database && origin.binding.owner == owner)) do\\n      throw (IO.userError \\\"prepared source projection crossed its owner scope\\\")\\n    let _ ← IO.ofExcept (Synapses.CanonicalSource.load access.database rows)\\n    pure ()\\n  return result\\n\\ndef endpoint? : IO (Option Daemon.Endpoint) := do\\n  readJson? ((← directory) / \\\"endpoint.json\\\") []\\n\\ndef sourceRecords (reference : SourceReference) (owners : Array String) (deadline : Nat) :\\n    IO (Array (String × Option Synapses.ObservedRecordView.View)) := do\\n  let access := reference.access\\n  let owners := (hashDistinct owners.toList).toArray\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange reference.endpoint \\\"source-records\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson access.database),(\\\"scope\\\",toJson access.scope),(\\\"source\\\",toJson access.source),\\n    (\\\"metadata\\\",toJson access.metadata),(\\\"owners\\\",toJson owners),(\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let (head,rows) ← IO.ofExcept (Json.parse response >>=\\n    fromJson? (α := PageMap.Head × Array (String × Option Synapses.ObservedRecordView.View)))\\n  unless head == access.source && rows.map Prod.fst == owners do\\n    throw (IO.userError \\\"original record projection changed its requested source or owner domain\\\")\\n  for (owner,found) in rows do\\n    if let some view := found then\\n      unless view.header.database == access.database && view.header.owner == owner do\\n        throw (IO.userError \\\"original record view crossed its read scope\\\")\\n  return rows\\n\\ndef ready (endpoint : Daemon.Endpoint) : IO Unit := do\\n  unless endpoint.session == \\\"publisher\\\" && endpoint.compatible (← generation) do\\n    throw (IO.userError \\\"publisher executable identity differs from this caller\\\")\\n  let _ ← Daemon.exchange endpoint \\\"ping\\\" (budget := 500)\\n  pure ()\\n\\ndef resolve : IO Daemon.Endpoint := do\\n  let root ← directory\\n  if let some endpoint ← endpoint? then\\n    if endpoint.compatible (← generation) then\\n      let reachable ← try ready endpoint; pure true catch _ => pure false\\n      if reachable then return endpoint\\n  Persistence.withLockWithin (root / \\\"starting\\\") 10000 do\\n    if let some endpoint ← endpoint? then\\n      let live ← Numerical.alive endpoint.pid\\n      if live then\\n        if endpoint.compatible (← generation) then\\n          ready endpoint\\n          return endpoint\\n        throw (IO.userError \\\"shared data service uses another implementation; explicitly stop its owner before replacement\\\")\\n      else removeIfExists (root / \\\"endpoint.json\\\")\\n    let child ← IO.Process.spawn {\\n      cmd := (← IO.appPath).toString,args := #[\\\"codex-publication-daemon\\\"]\\n      stdin := .null,stdout := .null,stderr := .inherit,setsid := true }\\n    let deadline := (← IO.monoMsNow)+10000\\n    repeat\\n      unless (← child.tryWait).isNone do throw (IO.userError \\\"publisher exited during startup\\\")\\n      if let some endpoint ← endpoint? then\\n        unless endpoint.pid == child.pid.toNat do throw (IO.userError \\\"publisher startup returned another owner\\\")\\n        ready endpoint\\n        return endpoint\\n      unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"publisher startup expired\\\")\\n      IO.sleep 5\\n    throw (IO.userError \\\"unreachable publisher startup\\\")\\n\\ndef prepareSource (source : PageMap.Snapshot) (storage : Sidecar.Storage)\\n    (deadline : Nat) : IO (Option SourceReference) := do\\n  prepareSourceUsing (← resolve) source storage deadline\\n\\ndef register (endpoint : Daemon.Endpoint) (path : System.FilePath) (identity : String) : IO Project := do\\n  let response ← Daemon.exchange endpoint \\\"register\\\" (Json.mkObj [\\n    (\\\"directory\\\",toJson path.toString),(\\\"database\\\",toJson identity)]) (budget := 5000)\\n  let project ← IO.ofExcept (Json.parse response >>= fromJson? (α := Project))\\n  unless project.database == identity && Synapses.digest project.capability do\\n    throw (IO.userError \\\"publisher granted another database\\\")\\n  return project\\n\\ndef submit (endpoint : Daemon.Endpoint) (project : Project) (capsule : Capsule) : IO NativePublication.SourceReceipt := do\\n  let peer := {endpoint with secret := project.capability}\\n  let response ← Daemon.exchange peer \\\"publish\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson project.database),(\\\"capsule\\\",toJson capsule)]) (budget := maxBudgetMs)\\n  let receipt ← IO.ofExcept (Json.parse response >>= fromJson? (α := NativePublication.SourceReceipt))\\n  unless receipt.accounted && receipt.head.identity == project.database do\\n    throw (IO.userError \\\"publisher returned an unrelated source ACK\\\")\\n  return receipt\\n\\n/-- Reconstruct only the submitted view from the authenticated durable ACK.\\nThe service does not send the whole DB or duplicate every graph Value. -/\\ndef restore (request : NativePublication.Prepared) (receipt : NativePublication.SourceReceipt) : IO NativePublication.Published := do\\n  let expected := NativePublication.receipt request.items receipt.head\\n  unless (toJson expected).compress == (toJson receipt).compress do\\n    throw (IO.userError \\\"publisher source coverage differs from the native request\\\")\\n  let authority ← IO.ofExcept (Json.parse receipt.head.authority >>=\\n    Persistence.valueFromJson (receipt.head.authority.length+1))\\n  let header := {Graph.empty authority with revision := receipt.head.revision}\\n  let (transaction,promotion) ← IO.ofExcept (NativePublication.compilePrepared header request.target request)\\n  let submitted : Graph := {\\n    authority,revision := receipt.head.revision,values := transaction.stagedValues,unions := []\\n    values_wellFormed := transaction.stagedValues_wellFormed }\\n  return ⟨← prepareCommitted submitted promotion,receipt⟩\\n\\ndef run (pending : PendingTurn) (target : System.FilePath) (checkpoint : Bool) : IO NativePublication.Published := do\\n  let target ← PageMap.absolute target\\n  let source ← match ← PageMap.open? target with\\n    | some source => pure source\\n    | none => Persistence.withLock target (Persistence.ensureSnapshot target)\\n  let request ← NativePublication.prepare pending target checkpoint\\n  let endpoint ← resolve\\n  let project ← register endpoint target source.head.identity\\n  let receipt ← submit endpoint project (Capsule.ofPrepared request)\\n  restore request receipt\\n\\ndef control (kind : String) : IO String := do\\n  unless #[\\\"stats\\\",\\\"shutdown\\\"].contains kind do throw (IO.userError \\\"unknown publication control operation\\\")\\n  let some endpoint ← endpoint? | return \\\"null\\\"\\n  Daemon.exchange endpoint kind (budget := 5000)\\n\\nend Eggshell.Plugin.Publication.Client\\n\\nnamespace Eggshell.Plugin\\n\\ndef promote (pending : PendingTurn) (target : System.FilePath) : IO NativePublication.Published :=\\n  Publication.Client.run pending target false\\n\\ndef promoteObservations (pending : PendingTurn) (target : System.FilePath) : IO NativePublication.Published :=\\n  Publication.Client.run pending target true\\n\\nend Eggshell.Plugin\\n\"],[\"PublicationService.lean\",\"module\\n\\npublic import Eggshell.PublicationWire\\npublic import Eggshell.CanonicalSourcePrepared\\npublic import Std.Sync.Mutex\\npublic import Init.System.Promise\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin.Publication.Service\\nopen Lean DB Synapses Std Async TCP\\n\\nstructure Job where\\n  request : NativePublication.Prepared\\n  bytes : Nat\\n  admitted : Nat\\n  deadline : Nat\\n  cancelled : IO.Ref Bool\\n  reply : IO.Promise (Except String Json)\\n\\nstructure ProjectState where\\n  directory : System.FilePath\\n  identity : String\\n  capability : String\\n  lease : FileSystem.ReadHandle\\n  queue : Array Job := #[]\\n  active : Bool := false\\n\\nstructure State where\\n  projects : Array ProjectState := #[]\\n  closed : Bool := false\\n  publishedGroups : Nat := 0\\n  publishedReplies : Nat := 0\\n  admittedBytes : Nat := 0\\n\\nstructure ReadSource where\\n  directory : System.FilePath\\n  database : String\\n  storage : Sidecar.Storage\\n  scope : String\\n  capability : String\\n\\nstructure DeferredReply where\\n  promise : IO.Promise (Except IO.Error Unit)\\n  charge : Nat\\n\\nstructure Server where\\n  state : Std.Mutex State\\n  resident : Std.Mutex Nat\\n  stopping : IO.Ref Bool\\n  sources : Std.Mutex (Array ReadSource)\\n  prepared : CanonicalSource.Shared.Pool\\n  sourceReplies : Std.Mutex Nat\\n  deferredReplies : Std.Mutex (Array DeferredReply)\\n\\ndef reserveReply (server : Server) (charge deadline : Nat) : IO Unit := do\\n  repeat\\n    unless !(← server.stopping.get) && (← IO.monoMsNow) < deadline do\\n      throw (IO.userError \\\"source service reply admission expired\\\")\\n    let admitted ← server.sourceReplies.atomically do\\n      let used ← get\\n      -- Large source responses leave control headroom. Slow readers must\\n      -- not prevent stats, source ACKs or the service owner's shutdown.\\n      let limit := if charge > 65536 then 48*1024*1024 else 64*1024*1024\\n      if used+charge > limit then return false\\n      set (used+charge)\\n      return true\\n    if admitted then return\\n    IO.sleep 1\\n\\n/-- A timed-out send retains its byte reservation until the native write has\\nreleased its buffers. Slow readers cannot create unaccounted output queues. -/\\ndef sendReply (server : Server) (client : Socket.Client) (payload : ByteArray)\\n    (deadline : Nat) (reserved : IO.Ref Nat) : IO Unit := do\\n  let charge ← reserved.get\\n  unless payload.size ≤ Daemon.maxFrameBytes && payload.size ≤ charge && charge > 0 do\\n    throw (IO.userError \\\"unreserved or oversized source service reply\\\")\\n  let pending ← client.native.send #[Daemon.frameLength payload,payload]\\n  let started ← IO.monoMsNow\\n  repeat\\n    if ← pending.isResolved then\\n      let some result := pending.result?.get | throw (IO.userError \\\"source service send disappeared\\\")\\n      return ← IO.ofExcept result\\n    let now ← IO.monoMsNow\\n    if now ≥ deadline || ((← server.stopping.get) && now ≥ started+25) then\\n      let charge ← reserved.get\\n      server.deferredReplies.atomically (modify (·.push ⟨pending,charge⟩))\\n      reserved.set 0\\n      throw (IO.userError \\\"source service send expired\\\")\\n    IO.sleep 1\\n\\ndef reapReplies (server : Server) : IO Unit := do\\n  let released ← server.deferredReplies.atomically do\\n    let mut live := #[]\\n    let mut released := 0\\n    for reply in ← get do\\n      if ← reply.promise.isResolved then released := released+reply.charge\\n      else live := live.push reply\\n    set live\\n    return released\\n  server.sourceReplies.atomically (modify (·-released))\\n\\n/-- Read registration grants no publisher lease or source write authority.\\nPaths are accepted only through the existing local administration capability. -/\\ndef readSource (server : Server) (path : System.FilePath) (database : String)\\n    (storage : Sidecar.Storage) : IO ReadSource := server.sources.atomically do\\n  let sources ← get\\n  if let some source := sources.find? (fun source => source.directory == path &&\\n      source.database == database && source.storage == storage) then return source\\n  unless sources.size < 1024 do throw (IO.userError \\\"prepared source registration is full\\\")\\n  let scope := Sha256.hex (toJson (path.normalize.toString,database,storage)).compress.toUTF8\\n  let source : ReadSource := ⟨path,database,storage,scope,Blake3.hex (← IO.getRandomBytes 32)⟩\\n  set (sources.push source)\\n  return source\\n\\ndef prepareRegistered (server : Server) (scope : ReadSource)\\n    (requested : Option PageMap.Head) (deadline : Nat) : IO Json := do\\n  let current ← PageMap.pin scope.directory\\n  unless current.head.identity == scope.database do throw (IO.userError \\\"prepared source incarnation changed\\\")\\n  let some pinned ← PageMap.HistoryReader.make? current (requested.getD current.head) |\\n    throw (IO.userError \\\"requested prepared source snapshot is unavailable\\\")\\n  let source := pinned.snapshot\\n  let cachePath ← CanonicalSource.Cache.directory source scope.storage\\n  let some metadata ← CanonicalSource.Cache.manifest? cachePath | return Json.null\\n  unless metadata.implementation == CanonicalSource.Cache.implementation &&\\n      digest metadata.payload && (← Index.sameSources source metadata.source) do return Json.null\\n  server.prepared.withReady source cachePath metadata deadline fun loaded reuse => do\\n    let access : CanonicalSource.Shared.Access := {\\n      database := source.head.identity\\n      scope := scope.scope\\n      capability := scope.capability\\n      source := source.head\\n      metadata := loaded.ready.metadata\\n      reuse}\\n    return toJson access\\n\\ndef prepareSource (server : Server) (payload : Json) (deadline : Nat) : IO Json := do\\n  let path ← PageMap.absolute (.mk (← IO.ofExcept (payload.getObjValAs? String \\\"directory\\\")))\\n  let head ← IO.ofExcept (payload.getObjVal? \\\"source\\\" >>= fromJson? (α := PageMap.Head))\\n  let storage ← IO.ofExcept (payload.getObjVal? \\\"storage\\\" >>= fromJson? (α := Sidecar.Storage))\\n  let current ← PageMap.pin path\\n  unless current.head.identity == head.identity do throw (IO.userError \\\"prepared source identity changed\\\")\\n  let scope ← readSource server path head.identity storage\\n  prepareRegistered server scope (some head) deadline\\n\\ndef scopedSource (server : Server) (secret : String) (payload : Json) : IO ReadSource := do\\n  let database ← IO.ofExcept (payload.getObjValAs? String \\\"database\\\")\\n  let identity ← IO.ofExcept (payload.getObjValAs? String \\\"scope\\\")\\n  server.sources.atomically do\\n    let some scope := (← get).find? (fun source => source.database == database && source.scope == identity) |\\n      throw (IO.userError \\\"unknown prepared source scope\\\")\\n    unless scope.capability == secret do throw (IO.userError \\\"unauthorized prepared source projection\\\")\\n    return scope\\n\\ndef refreshSource (server : Server) (secret : String) (payload : Json) (deadline : Nat) : IO Json := do\\n  let scope ← scopedSource server secret payload\\n  let requested ← IO.ofExcept (payload.getObjVal? \\\"source\\\" >>= fromJson? (α := Option PageMap.Head))\\n  prepareRegistered server scope requested deadline\\n\\ndef sourceRows (server : Server) (secret : String) (payload : Json) (deadline : Nat) : IO Json := do\\n  let database ← IO.ofExcept (payload.getObjValAs? String \\\"database\\\")\\n  let identity ← IO.ofExcept (payload.getObjValAs? String \\\"scope\\\")\\n  let scope ← scopedSource server secret payload\\n  let head ← IO.ofExcept (payload.getObjVal? \\\"source\\\" >>= fromJson? (α := PageMap.Head))\\n  let metadata ← IO.ofExcept (payload.getObjVal? \\\"metadata\\\" >>= fromJson? (α := CanonicalSource.Cache.Manifest))\\n  let owners ← IO.ofExcept (payload.getObjValAs? (Array String) \\\"owners\\\")\\n  unless owners.size ≤ 4096 && owners.all (fun owner => owner.utf8ByteSize ≤ 256) &&\\n      head.identity == scope.database && metadata.source.identity == scope.database &&\\n      metadata.implementation == CanonicalSource.Cache.implementation && digest metadata.payload do\\n    throw (IO.userError \\\"invalid prepared source projection request\\\")\\n  let current ← PageMap.pin scope.directory\\n  let some pinned ← PageMap.HistoryReader.make? current head |\\n    throw (IO.userError \\\"prepared source snapshot retired\\\")\\n  let path ← CanonicalSource.Cache.directory pinned.snapshot scope.storage\\n  server.prepared.withReady pinned.snapshot path metadata deadline fun loaded reuse => do\\n    let access : CanonicalSource.Shared.Access := ⟨database,identity,\\\"\\\",head,metadata,reuse⟩\\n    let result : CanonicalSource.Shared.Projection := ⟨access.identity,loaded.rows owners,reuse⟩\\n    let value := toJson result\\n    unless value.compress.utf8ByteSize ≤ (Daemon.maxFrameBytes-4096)/2 do\\n      throw (IO.userError \\\"prepared source projection exceeds its wire bound\\\")\\n    return value\\n\\n/-- The identical authenticated read scope serves generic original output.\\nThe prepared index snapshot is shared; no query repairs or normalizes it. -/\\ndef sourceRecords (server : Server) (secret : String) (payload : Json) (deadline : Nat) : IO Json := do\\n  let scope ← scopedSource server secret payload\\n  let head ← IO.ofExcept (payload.getObjVal? \\\"source\\\" >>= fromJson? (α := PageMap.Head))\\n  let metadata ← IO.ofExcept (payload.getObjVal? \\\"metadata\\\" >>= fromJson? (α := CanonicalSource.Cache.Manifest))\\n  let owners ← IO.ofExcept (payload.getObjValAs? (Array String) \\\"owners\\\")\\n  unless owners.size ≤ 4096 && owners.all (fun owner => owner.utf8ByteSize ≤ 256) &&\\n      head.identity == scope.database && metadata.source.identity == scope.database &&\\n      metadata.implementation == CanonicalSource.Cache.implementation && digest metadata.payload do\\n    throw (IO.userError \\\"invalid original record projection request\\\")\\n  let current ← PageMap.pin scope.directory\\n  let some pinned ← PageMap.HistoryReader.make? current head |\\n    throw (IO.userError \\\"original source snapshot retired\\\")\\n  let path ← CanonicalSource.Cache.directory pinned.snapshot scope.storage\\n  server.prepared.withReady pinned.snapshot path metadata deadline fun loaded _ => do\\n    let some original := loaded.originals | throw (IO.userError \\\"original record view is not prepared\\\")\\n    let mut rows : Array (String × Option ObservedRecordView.View) := #[]\\n    let mut size := 0\\n    for owner in owners do\\n      unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"original record projection expired\\\")\\n      let found ← ObservedRecordView.load? original.index scope.database owner\\n      let value := toJson (owner,found)\\n      size := size+value.compress.utf8ByteSize\\n      unless size ≤ (Daemon.maxFrameBytes-4096)/2 do throw (IO.userError \\\"original record projection exceeds wire bound\\\")\\n      rows := rows.push (owner,found)\\n    return toJson (head,rows)\\n\\ndef lease (path : System.FilePath) : IO FileSystem.ReadHandle := do\\n  FileSystem.immutableExistingBytes path ByteArray.empty\\n  let handle ← FileSystem.openRead path.toString\\n  unless ← FileSystem.tryReadLock handle true do throw (IO.userError \\\"another publisher owns this database\\\")\\n  return handle\\n\\n/-- Registration is local administrator authority. Project capabilities grant\\nonly scoped publication; they cannot register paths or control the service. -/\\ndef register (server : Server) (payload : Json) : IO Project := do\\n  let raw ← IO.ofExcept (payload.getObjValAs? String \\\"directory\\\")\\n  let identity ← IO.ofExcept (payload.getObjValAs? String \\\"database\\\")\\n  let path ← PageMap.absolute (.mk raw)\\n  let source ← PageMap.pin path\\n  unless source.head.identity == identity do throw (IO.userError \\\"registered database identity changed\\\")\\n  server.state.atomically do\\n    let state ← get\\n    unless !state.closed do throw (IO.userError \\\"publisher is closed\\\")\\n    if let some project := state.projects.find? (·.identity == identity) then\\n      unless project.directory == path do throw (IO.userError \\\"database already has another registered location\\\")\\n      return ⟨identity,project.capability⟩\\n    let owned ← lease (path / \\\"publisher.guard\\\")\\n    let capability := Blake3.hex (← IO.getRandomBytes 32)\\n    set {state with projects := state.projects.push {directory := path,identity,capability,lease := owned}}\\n    return ⟨identity,capability⟩\\n\\ndef submit (server : Server) (secret : String) (payload : Json) (deadline : Nat)\\n    (cancelled : IO.Ref Bool) : IO (IO.Promise (Except String Json)) := do\\n  let database ← IO.ofExcept (payload.getObjValAs? String \\\"database\\\")\\n  let capsule ← IO.ofExcept (payload.getObjVal? \\\"capsule\\\" >>= fromJson? (α := Capsule))\\n  let promise ← IO.Promise.new\\n  server.state.atomically do\\n    let state ← get\\n    unless !state.closed do throw (IO.userError \\\"publisher is closed\\\")\\n    let some index := state.projects.findIdx? (·.identity == database) |\\n      throw (IO.userError \\\"unknown project capability\\\")\\n    let some project := state.projects[index]? | throw (IO.userError \\\"missing project\\\")\\n    unless secret == project.capability do throw (IO.userError \\\"unauthorized project publication\\\")\\n    let prepared ← IO.ofExcept (capsule.prepare project.directory project.identity)\\n    let bytes := (toJson prepared.pending).compress.utf8ByteSize\\n    unless bytes ≤ NativePublication.maxBatchBytes && (← IO.monoMsNow) < deadline do\\n      throw (IO.userError \\\"publication request exceeds its live bounds\\\")\\n    let queued := state.projects.foldl (fun count project => count+project.queue.size) 0\\n    unless queued < maxClients && state.admittedBytes+bytes ≤ maxResidentBytes do\\n      throw (IO.userError \\\"publisher admission is full\\\")\\n    let job : Job := ⟨prepared,bytes,← IO.monoMsNow,deadline,cancelled,promise⟩\\n    set {state with\\n      admittedBytes := state.admittedBytes+bytes\\n      projects := state.projects.modify index fun project => {project with queue := project.queue.push job}}\\n    return promise\\n\\ndef takeGroup (server : Server) : IO (Option (System.FilePath × String × Array Job)) :=\\n  server.state.atomically do\\n    let state ← get\\n    if state.closed then return none\\n    let now ← IO.monoMsNow\\n    for index in [:state.projects.size] do\\n      let some project := state.projects[index]? | continue\\n      if project.active || project.queue.isEmpty then continue\\n      let some oldest := project.queue[0]? | continue\\n      if now < oldest.admitted+2 then continue\\n      let mut jobs := #[]\\n      let mut remaining := #[]\\n      let mut bytes := 0\\n      let mut dropped := 0\\n      for job in project.queue do\\n        if (← job.cancelled.get) || now ≥ job.deadline then\\n          job.reply.resolve (.error \\\"publication expired before commit admission\\\")\\n          dropped := dropped+job.bytes\\n        else if jobs.size < NativePublication.maxBatchRequests && bytes+job.bytes ≤ NativePublication.maxBatchBytes then\\n          jobs := jobs.push job\\n          bytes := bytes+job.bytes\\n        else remaining := remaining.push job\\n      let updated := {project with queue := remaining,active := !jobs.isEmpty}\\n      -- Rotate the chosen DB so a continuous producer cannot starve siblings.\\n      set {state with\\n        admittedBytes := state.admittedBytes-dropped\\n        projects := (state.projects.extract 0 index ++\\n        state.projects.extract (index+1) state.projects.size).push updated}\\n      if jobs.isEmpty then return none\\n      return some (project.directory,project.identity,jobs)\\n    return none\\n\\n/-- Failed atomic groups have published nothing. Split only those groups, so\\na conflicting immutable observation cannot discard unrelated originals.\\nFuel and the original request/byte bounds limit fault-isolation work. -/\\ndef commitJobs (server : Server) (path : System.FilePath) : Nat → Array Job → IO (Nat × Nat)\\n  | 0, jobs => do\\n      for job in jobs do job.reply.resolve (.error \\\"publisher fault-isolation bound reached\\\")\\n      return (0,0)\\n  | fuel+1, jobs => do\\n      let now ← IO.monoMsNow\\n      let live ← jobs.filterM fun job => do\\n        if (← server.stopping.get) || (← job.cancelled.get) || now ≥ job.deadline then\\n          job.reply.resolve (.error \\\"publication left before commit admission\\\")\\n          return false\\n        return true\\n      if live.isEmpty then return (0,0)\\n      let result ← try\\n        let publications ← NativePublication.runPrepared path (live.map (·.request))\\n        unless publications.size == live.size do throw (IO.userError \\\"publisher changed its admitted group\\\")\\n        pure (.ok publications : Except String (Array NativePublication.Published))\\n      catch error => pure (.error error.toString)\\n      match result with\\n      | .ok publications =>\\n          for (job,published) in live.zip publications do job.reply.resolve (.ok (toJson published.source))\\n          return (1,live.size)\\n      | .error error =>\\n          if live.size == 1 then\\n            for job in live do job.reply.resolve (.error error)\\n            return (0,0)\\n          let middle := live.size/2\\n          let left ← commitJobs server path fuel (live.extract 0 middle)\\n          let right ← commitJobs server path fuel (live.extract middle live.size)\\n          return (left.1+right.1,left.2+right.2)\\n\\ndef publish (server : Server) (path : System.FilePath) (identity : String) (jobs : Array Job) : IO Unit := do\\n  let committed ← IO.mkRef (0,0)\\n  try\\n    committed.set (← commitJobs server path (jobs.size+1) jobs)\\n  catch error =>\\n    for job in jobs do job.reply.resolve (.error error.toString)\\n  finally\\n    let committed ← committed.get\\n    server.state.atomically do\\n      modify fun state => {state with\\n        projects := state.projects.map (fun project =>\\n          if project.identity == identity then {project with active := false} else project)\\n        publishedGroups := state.publishedGroups+committed.1\\n        publishedReplies := state.publishedReplies+committed.2\\n        admittedBytes := state.admittedBytes-(jobs.foldl (fun total job => total+job.bytes) 0)}\\n\\ndef stats (server : Server) : IO Json := server.state.atomically do\\n  let state ← get\\n  return Json.mkObj [(\\\"projects\\\",toJson state.projects.size),\\n    (\\\"queued\\\",toJson (state.projects.foldl (fun count project => count+project.queue.size) 0)),\\n    (\\\"active\\\",toJson (state.projects.filter (·.active)).size),(\\\"closed\\\",toJson state.closed),\\n    (\\\"admittedBytes\\\",toJson state.admittedBytes),\\n    (\\\"publishedGroups\\\",toJson state.publishedGroups),(\\\"publishedReplies\\\",toJson state.publishedReplies),\\n    (\\\"preparedSources\\\",← server.prepared.stats),\\n    (\\\"replyBytes\\\",toJson (← server.sourceReplies.atomically get)),\\n    (\\\"deferredReplies\\\",toJson (← server.deferredReplies.atomically get).size)]\\n\\npartial def receiveLive (server : Server) (client : Socket.Client) (remaining deadline : Nat)\\n    (received : ByteArray := ByteArray.empty) : IO ByteArray := do\\n  if remaining == 0 then return received\\n  let now ← IO.monoMsNow\\n  unless !(← server.stopping.get) && now < deadline do throw (IO.userError \\\"publisher frame expired\\\")\\n  let chunk : Option (Option ByteArray) ← (do\\n    let timer ← Selector.sleep (.ofNat (min 5 (deadline-now)))\\n    Selectable.one #[.case (client.recvSelector remaining.toUInt64) (fun value => pure (some value)),\\n      .case timer (fun _ => pure none)]).block\\n  match chunk with\\n  | none => receiveLive server client remaining deadline received\\n  | some none => throw (IO.userError \\\"publisher peer closed an incomplete frame\\\")\\n  | some (some bytes) =>\\n      unless !bytes.isEmpty do throw (IO.userError \\\"publisher received an empty frame\\\")\\n      receiveLive server client (remaining-bytes.size) deadline (received.append bytes)\\n\\ndef peerWaiting (client : Socket.Client) : IO Bool := (do\\n  let timer ← Selector.sleep (.ofNat 5)\\n  Selectable.one #[.case (client.recvSelector 1) (fun _ => pure false),\\n    .case timer (fun _ => pure true)]).block\\n\\ndef awaitReply (server : Server) (client : Socket.Client) (cancelled : IO.Ref Bool)\\n    (promise : IO.Promise (Except String Json)) (deadline : Nat) : IO Json := do\\n  repeat\\n    if ← promise.isResolved then\\n      let some result := promise.result?.get | throw (IO.userError \\\"publisher dropped its reply\\\")\\n      return ← IO.ofExcept result\\n    unless !(← server.stopping.get) && (← IO.monoMsNow) < deadline && (← peerWaiting client) do\\n      cancelled.set true\\n      throw (IO.userError \\\"publisher requester left before its reply\\\")\\n  throw (IO.userError \\\"unreachable publication wait\\\")\\n\\ndef serveClient (server : Server) (admin : String) (client : Socket.Client) : IO Unit := do\\n  let reserved ← IO.mkRef (0 : Nat)\\n  let reservedReply ← IO.mkRef (0 : Nat)\\n  let cancelled ← IO.mkRef false\\n  let deadline := (← IO.monoMsNow)+maxBudgetMs\\n  let replyDeadline ← IO.mkRef deadline\\n  let reply ← try\\n    let header ← receiveLive server client 4 deadline\\n    let size := Daemon.decodeLength header\\n    unless size ≤ Daemon.maxFrameBytes do throw (IO.userError \\\"publisher frame exceeds its bound\\\")\\n    let admitted ← server.resident.atomically do\\n      let bytes ← get\\n      if bytes+size > maxResidentBytes then return false\\n      set (bytes+size)\\n      return true\\n    unless admitted do throw (IO.userError \\\"publisher resident byte budget is full\\\")\\n    reserved.set size\\n    let bytes ← receiveLive server client size deadline\\n    let some text := String.fromUTF8? bytes | throw (IO.userError \\\"publisher frame is not UTF-8\\\")\\n    let json ← IO.ofExcept (Json.parse text)\\n    let secret ← IO.ofExcept (json.getObjValAs? String \\\"secret\\\")\\n    let kind ← IO.ofExcept (json.getObjValAs? String \\\"kind\\\")\\n    let payload := json.getObjValD \\\"payload\\\"\\n    let deadline ← if [\\\"prepare-source\\\",\\\"refresh-source\\\",\\\"source-rows\\\",\\\"source-records\\\"].contains kind then do\\n        let budget ← IO.ofExcept (payload.getObjValAs? Nat \\\"budgetMs\\\")\\n        pure (min deadline (deadline-maxBudgetMs+min budget maxBudgetMs))\\n      else pure deadline\\n    replyDeadline.set deadline\\n    let replyCharge := if kind == \\\"source-rows\\\" || kind == \\\"source-records\\\" then 16*1024*1024 else 65536\\n    reserveReply server replyCharge deadline\\n    reservedReply.set replyCharge\\n    let value ← if kind == \\\"refresh-source\\\" then refreshSource server secret payload deadline\\n      else if kind == \\\"source-rows\\\" then sourceRows server secret payload deadline\\n      else if kind == \\\"source-records\\\" then sourceRecords server secret payload deadline\\n      else if kind == \\\"publish\\\" then do\\n        let promise ← submit server secret payload deadline cancelled\\n        awaitReply server client cancelled promise deadline\\n      else do\\n        unless secret == admin do throw (IO.userError \\\"unauthorized publisher administration\\\")\\n        match kind with\\n        | \\\"prepare-source\\\" => prepareSource server payload deadline\\n        | \\\"register\\\" => toJson <$> register server payload\\n        | \\\"ping\\\" => pure (toJson true)\\n        | \\\"stats\\\" => stats server\\n        | \\\"shutdown\\\" => server.stopping.set true; pure (toJson true)\\n        | _ => throw (IO.userError \\\"unknown publication operation\\\")\\n    pure (Daemon.response (.ok value.compress))\\n    catch error => pure (Daemon.response (.error error.toString))\\n  try\\n    if (← reservedReply.get) == 0 then\\n      reserveReply server 65536 (min deadline ((← IO.monoMsNow)+100))\\n      reservedReply.set 65536\\n    sendReply server client reply.compress.toUTF8 (← replyDeadline.get) reservedReply\\n  finally\\n    cancelled.set true\\n    let bytes ← reserved.get\\n    server.resident.atomically (modify (·-bytes))\\n    let bytes ← reservedReply.get\\n    server.sourceReplies.atomically (modify (·-bytes))\\n\\ndef retain (tasks : List (Task (Except IO.Error Unit))) : IO (List (Task (Except IO.Error Unit))) := do\\n  let mut live := []\\n  for task in tasks do\\n    if ← IO.hasFinished task then\\n      if let .error error ← IO.wait task then IO.eprintln s!\\\"publisher operation stopped: {error}\\\"\\n    else live := task::live\\n  return live\\n\\ndef close (server : Server) : IO (Array ProjectState) := server.state.atomically do\\n  let state : State ← get\\n  set {state with closed := true,projects := state.projects.map (fun (project : ProjectState) => {project with queue := #[]})}\\n  for project in state.projects do\\n    for job in project.queue do job.reply.resolve (.error \\\"publisher closed before commit admission\\\")\\n  return state.projects\\n\\n/-- A local data-side service. Loopback administration is private to its OS\\nowner; project capabilities are distinct. Network deployment/auth is separate. -/\\ndef run : IO UInt32 := do\\n  let root ← directory\\n  let owner ← lease (root / \\\"service.guard\\\")\\n  let socket ← Socket.Server.mk\\n  socket.bind (Daemon.loopback 0)\\n  socket.listen maxClients.toUInt32\\n  socket.noDelay\\n  let address ← socket.getSockName\\n  let endpoint : Daemon.Endpoint := {\\n    session := \\\"publisher\\\",pid := (← IO.Process.getPID).toNat,port := address.port.toNat\\n    secret := Blake3.hex (← IO.getRandomBytes 32),generation := ← generation }\\n  writeJson (root / \\\"endpoint.json\\\") endpoint\\n  let server : Server := ⟨← Std.Mutex.new ({} : State),← Std.Mutex.new 0,← IO.mkRef false,\\n    ← Std.Mutex.new #[],← CanonicalSource.Shared.Pool.new,← Std.Mutex.new 0,← Std.Mutex.new #[]⟩\\n  -- `finally` must read the live owners, rather than a mutable local captured\\n  -- when its cleanup closure was constructed.\\n  let clients ← IO.mkRef ([] : List (Task (Except IO.Error Unit)))\\n  let publications ← IO.mkRef ([] : List (Task (Except IO.Error Unit)))\\n  let mut activity ← IO.monoMsNow\\n  try\\n    while !(← server.stopping.get) do\\n      match ← socket.tryAccept with\\n      | none => pure ()\\n      | some client =>\\n          activity ← IO.monoMsNow\\n          if (← clients.get).length < maxClients then\\n            let task ← IO.asTask (serveClient server endpoint.secret client) .dedicated\\n            clients.modify (task :: ·)\\n      clients.set (← retain (← clients.get))\\n      publications.set (← retain (← publications.get))\\n      reapReplies server\\n      while (← publications.get).length < 2 do\\n        let some (path,identity,jobs) ← takeGroup server | break\\n        let task ← IO.asTask (publish server path identity jobs) .dedicated\\n        publications.modify (task :: ·)\\n      if (← clients.get).isEmpty && (← publications.get).isEmpty && (← IO.monoMsNow) > activity+300000 then\\n        server.stopping.set true\\n      IO.sleep 1\\n    return 0\\n  finally\\n    server.stopping.set true\\n    server.prepared.close\\n    let projects ← close server\\n    let publications ← publications.get\\n    let clients ← clients.get\\n    -- No derived preparation is part of this wait. Active source commits\\n    -- finish their bounded group; queued requests receive no source ACK.\\n    for task in publications do let _ ← IO.wait task; pure ()\\n    -- receiveLive/awaitReply poll `stopping` every five milliseconds. Do not\\n    -- cancel tasks parked in async socket selectors: cancelling a selector's\\n    -- waiter does not guarantee that its blocking task completes.\\n    for task in clients do let _ ← IO.wait task; pure ()\\n    for project in projects do FileSystem.unlockRead project.lease\\n    if let some current ← (readJson? (root / \\\"endpoint.json\\\") [] : IO (Option Daemon.Endpoint)) then\\n      if current.secret == endpoint.secret then removeIfExists (root / \\\"endpoint.json\\\")\\n    FileSystem.unlockRead owner\\n\\nend Eggshell.Plugin.Publication.Service\\n\"],[\"NativePublication.lean\",\"module\\n\\npublic import Eggshell.SynapseJournal\\npublic import Eggshell.ObservedRecords\\npublic import Eggshell.ContentMetadata\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin.NativePublication\\nopen Lean DB Persistence.Store Synapses\\n\\nstructure CaptureCoverage where\\n  captured : Nat := 0\\n  unavailable : Nat := 0\\n  pending : Nat := 0\\n  aliases : Nat := 0\\n  deriving ToJson, FromJson\\n\\ndef CaptureCoverage.accounted (coverage : CaptureCoverage) (observations : Nat) : Bool :=\\n  coverage.captured+coverage.unavailable+coverage.pending == observations\\n\\n/-- Source timing, content correspondence and derived readiness are separate\\ncoverage claims. A complete native interval does not promise a file alias. -/\\nstructure SourceReceipt where\\n  head : PageMap.Head\\n  observations : Nat\\n  timed : Nat\\n  awaiting : Nat\\n  unavailable : Nat\\n  content : Option CaptureCoverage := none\\n  deriving ToJson, FromJson\\n\\ndef SourceReceipt.accounted (receipt : SourceReceipt) : Bool :=\\n  receipt.timed + receipt.awaiting + receipt.unavailable == receipt.observations &&\\n    receipt.content.all (·.accounted receipt.observations)\\n\\ndef SourceReceipt.complete (receipt : SourceReceipt) : Bool :=\\n  receipt.accounted && receipt.awaiting == 0 && receipt.unavailable == 0\\n\\ntheorem complete_has_all_observations (receipt : SourceReceipt)\\n    (complete : receipt.complete = true) : receipt.timed = receipt.observations := by\\n  simp only [SourceReceipt.complete, SourceReceipt.accounted, Bool.and_eq_true,\\n    beq_iff_eq] at complete\\n  omega\\n\\nstructure Saved where\\n  publication : SourceReceipt\\n  preparationQueued : Bool\\n  deriving ToJson, FromJson\\n\\n/-- A wire result must account for every observation before its source ACK is used. -/\\ndef Saved.check? (value : Json) : Except String Saved := do\\n  let saved ← fromJson? (α := Saved) value\\n  unless saved.publication.accounted do throw \\\"invalid source publication coverage\\\"\\n  return saved\\n\\ninductive SaveReply where\\n  | noWrite\\n  | published (saved : Saved)\\n  deriving ToJson, FromJson\\n\\ndef SaveReply.check? (value : Json) : Except String SaveReply := do\\n  let reply ← fromJson? (α := SaveReply) value\\n  if let .published saved := reply then\\n    unless saved.publication.accounted do throw \\\"invalid source publication coverage\\\"\\n  return reply\\n\\ndef agrees (occurrence : Occurrence) (tool : ToolEvent)\\n    (first last : Journal.Entry) : Bool :=\\n  match first.payload, last.payload with\\n  | .start before work _ _, .finish after name input response _ =>\\n      before == occurrence && after == occurrence &&\\n      work == canonicalToolWork tool && name == tool.name &&\\n      input == canonicalJson tool.input && response == canonicalJson tool.response &&\\n      first.clock.domain == last.clock.domain && digest first.clock.domain &&\\n      first.clock.nanos < last.clock.nanos\\n  | _, _ => false\\n\\ntheorem agrees_preserves_clock (occurrence : Occurrence) (tool : ToolEvent)\\n    (first last : Journal.Entry) (accepted : agrees occurrence tool first last = true) :\\n    first.clock.domain = last.clock.domain ∧ first.clock.nanos < last.clock.nanos := by\\n  cases first with | mk before first received =>\\n    cases last with | mk after last receivedAfter =>\\n      cases first <;> cases last <;> simp_all [agrees, Bool.and_eq_true, beq_iff_eq]\\n\\ntheorem agrees_preserves_observation (occurrence : Occurrence) (tool : ToolEvent)\\n    (first last : Journal.Entry) (accepted : agrees occurrence tool first last = true) :\\n    ∃ query known archive, first.payload = .start occurrence (canonicalToolWork tool) query known ∧\\n      last.payload = .finish occurrence tool.name (canonicalJson tool.input)\\n        (canonicalJson tool.response) archive := by\\n  cases first with | mk before first received =>\\n    cases last with | mk after last receivedAfter =>\\n      cases first <;> cases last <;> simp_all [agrees, Bool.and_eq_true, beq_iff_eq]\\n\\nstructure Interval where\\n  domain : String\\n  started : Nat\\n  finished : Nat\\n  receivedUnixMs : Option Nat\\n  deriving ToJson, FromJson\\n\\ndef Interval.valid (interval : Interval) : Bool :=\\n  digest interval.domain && interval.started < interval.finished\\n\\ninductive Evidence (occurrence : Occurrence) (tool : ToolEvent) where\\n  | timed (first last : Journal.Entry) (checked : agrees occurrence tool first last = true)\\n  | stored (origin : Provenance.Origin) (valid : origin.valid = true)\\n  /-- An authenticated native producer has checked the original pair locally.\\n  The receiving publisher rebinds this query-free interval to its own owner. -/\\n  | observed (interval : Interval) (valid : interval.valid = true)\\n  | awaiting\\n  | unavailable\\n\\nstructure Item where\\n  tool : ToolEvent\\n  occurrence : Occurrence\\n  evidence : Evidence occurrence tool\\n\\n/-- Exact native event keys only. Preparing a source ACK never replays the\\nturn, extracts source rows, constructs embeddings or opens a derived index. -/\\ndef plan (pending : PendingTurn) (target : System.FilePath) : IO (Array Item) := do\\n  let published ← PageMap.open? target\\n  let canonical := System.FilePath.mk (pending.write.getD target.toString)\\n  let journal ← match ← PageMap.open? canonical with\\n    | none => pure none\\n    | some source => Journal.open? source\\n  pending.tools.toArray.mapM fun tool => do\\n    let occurrence : Occurrence := ⟨pending.sessionId,pending.turnId,tool.useId⟩\\n    if let some source := published then\\n      let owner := (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).2\\n      let some edge := OutcomeEdge.fromValue? owner | throw (IO.userError \\\"invalid native owner\\\")\\n      if let some origin ← Provenance.lookup? source edge occurrence then\\n        if valid : origin.valid = true then return ⟨tool,occurrence,.stored origin valid⟩\\n        else throw (IO.userError \\\"invalid stored native interval\\\")\\n    let evidence ← match journal with\\n      | none => pure .unavailable\\n      | some journal => do\\n          let first ← Journal.lookup? journal \\\"start\\\" occurrence\\n          let last ← Journal.lookup? journal \\\"finish\\\" occurrence\\n          match first, last with\\n          | some first, some last =>\\n              if checked : agrees occurrence tool first last = true then\\n                pure (.timed first last checked)\\n              else pure .unavailable\\n          | some _, none => pure .awaiting\\n          | _, _ => pure .unavailable\\n    return ⟨tool,occurrence,evidence⟩\\n\\ndef stage (items : Array Item) (intern : Persistence.Store.Intern) : IO Persistence.Store.MetadataChange := do\\n  let mut bindings := #[]\\n  let mut recordsChanged := false\\n  let mut affected := []\\n  let mut owners := []\\n  for item in items do\\n    let owner := (compileOperationOutcomes (.text item.occurrence.session)\\n      (.text item.occurrence.turn) item.tool).2\\n    let some edge := OutcomeEdge.fromValue? owner |\\n      throw (IO.userError \\\"native publication did not compile an Outcome\\\")\\n    let id ← intern.value owner\\n    owners := id :: owners\\n    let document : Synapses.Extraction.Document := {\\n      owner := Persistence.selectionKey edge.relation\\n      work := Persistence.selectionKey edge.work\\n      workText := Persistence.Store.text? edge.work\\n      source := Persistence.Store.text? edge.outcome\\n      native := edge.observations.any (Relation.observesOutcomeWork edge.outcome edge.work)\\n      occurrences := Provenance.identities edge\\n      files := #[] }\\n    unless (← intern.writer.get (key \\\"member\\\" id)).isSome do\\n      throw (IO.userError \\\"original record owner was not source-published\\\")\\n    let originalChanged ← ObservedRecords.stage intern.writer id document\\n    let contentChanged ← match item.tool.correspondence with\\n      | none => pure false\\n      | some captured => ContentMetadata.stage intern.writer id document captured\\n    if originalChanged || contentChanged then\\n      recordsChanged := true\\n      affected := id :: affected\\n    let origin : Option Provenance.Origin := match item.evidence with\\n      | .timed first last _ => some ⟨id,item.occurrence,first.clock.domain,\\n          first.clock.nanos,last.clock.nanos,last.receivedUnixMs⟩\\n      | .stored origin _ => some origin\\n      | .observed interval _ => some ⟨id,item.occurrence,interval.domain,\\n          interval.started,interval.finished,interval.receivedUnixMs⟩\\n      | _ => none\\n    let some origin := origin | continue\\n    let some binding := Provenance.Binding.check? edge origin |\\n      throw (IO.userError \\\"native publication has an invalid observed interval\\\")\\n    bindings := bindings.push binding\\n  let timingChanged ← Provenance.stage intern bindings\\n  return {\\n    changed := timingChanged || recordsChanged\\n    affected := hashDistinct (affected ++ if timingChanged then owners else [])}\\n\\nstructure TimingCounts where\\n  timed : Nat := 0\\n  awaiting : Nat := 0\\n  unavailable : Nat := 0\\n\\ndef receipt (items : Array Item) (head : PageMap.Head) : SourceReceipt :=\\n  let counts := items.foldl (fun result item => match item.evidence with\\n    | .timed .. | .stored .. | .observed .. => {result with timed := result.timed+1}\\n    | .awaiting => {result with awaiting := result.awaiting+1}\\n    | .unavailable => {result with unavailable := result.unavailable+1}) ({} : TimingCounts)\\n  let content := items.foldl (fun result item => match item.tool.correspondence with\\n    | none => {result with pending := result.pending+1}\\n    | some captured => {\\n        result with\\n        captured := result.captured + if captured.complete then 1 else 0\\n        unavailable := result.unavailable + if captured.complete then 0 else 1\\n        aliases := result.aliases+captured.aliases.size}) ({} : CaptureCoverage)\\n  {head,observations := items.size,timed := counts.timed,\\n    awaiting := counts.awaiting,unavailable := counts.unavailable,content := some content}\\n\\ntheorem receipt_is_at_publication (items : Array Item) (head : PageMap.Head) :\\n    (receipt items head).head = head := rfl\\n\\nstructure Published where\\n  promotion : CommittedPromotion\\n  source : SourceReceipt\\n\\ndef matchesPending (pending : PendingTurn) (items : Array Item) : Bool :=\\n  items.size == pending.tools.length && (items.zip pending.tools.toArray).all (fun (item,tool) =>\\n    item.occurrence == (⟨pending.sessionId,pending.turnId,tool.useId⟩ : Occurrence) &&\\n    item.tool.useId == tool.useId && item.tool.name == tool.name &&\\n    item.tool.input == tool.input && item.tool.response == tool.response)\\n\\n/-- Private ingress is inspected before admission. Only query-free intervals\\nare staged into the source DB. This is an in-memory publisher input, not a\\nwire format for sending private journal entries to another machine. -/\\nstructure Prepared where\\n  pending : PendingTurn\\n  target : System.FilePath\\n  identity : Option String\\n  checkpoint : Bool\\n  items : Array Item\\n  matching : matchesPending pending items = true\\n\\ntheorem Prepared.tool_count (request : Prepared) : request.items.size = request.pending.tools.length := by\\n  have matching := request.matching\\n  simp only [matchesPending, Bool.and_eq_true, beq_iff_eq] at matching\\n  exact matching.1\\n\\ndef prepare (pending : PendingTurn) (target : System.FilePath) (checkpoint : Bool) : IO Prepared := do\\n  let pinned ← PageMap.open? target\\n  let items ← plan pending target\\n  if matching : matchesPending pending items = true then\\n    return ⟨pending,target.normalize,pinned.map (·.head.identity),checkpoint,items,matching⟩\\n  else throw (IO.userError \\\"publication input disagrees with its native observations\\\")\\n\\ndef compilePrepared (source : Graph) (target : System.FilePath) (request : Prepared) :\\n    Except String (Transaction × Promotion) := do\\n  if request.checkpoint then\\n    let roots ← stagedGraphValues request.pending\\n    let some transaction := (Transaction.begin source).stageValues? (roots.filter (!source.values.contains ·)) |\\n      throw \\\"observation compiler produced an invalid Value\\\"\\n    return (transaction,{outcomeRelations := observedRoots request.pending})\\n  else\\n    let compiled ← compile source request.pending target.toString\\n    return (compiled.transaction,compiled.promotion)\\n\\ndef maxBatchRequests : Nat := 128\\ndef maxBatchBytes : Nat := 8*1024*1024\\n\\n/-- One DB publisher commits a bounded group under one writer/root/fsync.\\nEvery reply refers to that one durable head. A failed group acknowledges none.\\nNo queue, model, derived work or remote-policy promise is hidden here. -/\\ndef runPrepared (target : System.FilePath) (requests : Array Prepared) : IO (Array Published) := do\\n  unless !requests.isEmpty && requests.size ≤ maxBatchRequests do\\n    throw (IO.userError \\\"publication group exceeds its request bound\\\")\\n  unless requests.all (fun request => request.items.size == request.pending.tools.length) do\\n    throw (IO.userError \\\"publication group changed its observed tool count\\\")\\n  unless requests.all (fun request => request.target == target.normalize) do\\n    throw (IO.userError \\\"publication group mixed database targets\\\")\\n  let payloadBytes := requests.foldl (fun total request =>\\n    total+(toJson request.pending).compress.utf8ByteSize) 0\\n  unless payloadBytes ≤ maxBatchBytes do throw (IO.userError \\\"publication group exceeds its byte bound\\\")\\n  let committed ← Persistence.appendPrepared target (fun graph => do\\n    let prepared ← requests.mapM (compilePrepared graph target)\\n    let roots := (prepared.toList.flatMap (·.1.stagedValues)).eraseDups\\n    let some transaction := (Transaction.begin graph).stageValues? roots |\\n      throw \\\"publication group contains an invalid Value\\\"\\n    return (transaction,prepared.map (·.2)))\\n    (fun intern _ => do\\n      let pinned ← intern.writer.snapshot\\n      unless requests.all (fun request => request.identity.all (· == pinned.head.identity)) do\\n        throw (IO.userError \\\"publication group database was replaced before commit\\\")\\n      stage (requests.flatMap (·.items)) intern)\\n  unless committed.value.size == requests.size do throw (IO.userError \\\"publication group changed its request count\\\")\\n  (requests.zip committed.value).mapM fun (request,value) => do\\n    let promotion ← prepareCommitted committed.graph value\\n    let source := receipt request.items committed.head\\n    unless source.accounted do throw (IO.userError \\\"native publication coverage disagrees\\\")\\n    return ⟨promotion,source⟩\\n\\ndef run (pending : PendingTurn) (target : System.FilePath) (checkpoint : Bool) : IO Published := do\\n  let request ← prepare pending target checkpoint\\n  let results ← runPrepared target #[request]\\n  let some result := results[0]? | throw (IO.userError \\\"publication group lost its single request\\\")\\n  return result\\n\\nend Eggshell.Plugin.NativePublication\\n\"],[\"CanonicalSourcePrepared.lean\",\"module\\n\\npublic import Eggshell.CanonicalSourceCache\\npublic import Eggshell.CanonicalSourceDelivery\\npublic import Std.Sync.Mutex\\npublic import Init.System.Promise\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.CanonicalSource.Shared\\nopen Lean DB\\n\\ndef allOwners (registry : Registry) : Std.HashSet (String × String) := Id.run do\\n  let mut allowed : Std.HashSet (String × String) := {}\\n  for (_,atom) in registry.atoms do\\n    for origin in atom.origins do\\n      allowed := allowed.insert (origin.binding.database,origin.binding.owner)\\n  return allowed\\n\\nstructure Loaded where\\n  ready : Cache.Ready\\n  owners : Std.HashMap String (Array StoredRow)\\n  exact : owners = Delivery.byOwner ready.registry (allOwners ready.registry)\\n  /-- Opened once for the pinned preparation, sharing the bounded PageMap\\n  -- block cache across sessions. No per-session original record rebuild. -/\\n  originals : Option Index.Reader := none\\n\\n/-- All owners are projected once. Filtering the request then performs point\\nlookups; neither a full registry nor another customer's state crosses the wire. -/\\ndef Loaded.make (ready : Cache.Ready) : Loaded :=\\n  ⟨ready,Delivery.byOwner ready.registry (allOwners ready.registry),rfl,none⟩\\n\\ntheorem Loaded.lookup_exact (loaded : Loaded) (owner : String) :\\n    loaded.owners[owner]? =\\n      (Delivery.byOwner loaded.ready.registry (allOwners loaded.ready.registry))[owner]? := by\\n  rw [loaded.exact]\\n\\ndef Loaded.rows (loaded : Loaded) (owners : Array String) : Array (String × Array StoredRow) :=\\n  owners.map fun owner => (owner,loaded.owners[owner]?.getD #[])\\n\\ntheorem Loaded.requested_domain (loaded : Loaded) (owners : Array String) :\\n    (loaded.rows owners).map Prod.fst = owners := by\\n  simp [Loaded.rows,Array.map_map,Function.comp_def]\\n\\nstructure Budget (capacity : Nat) where\\n  used : Nat := 0\\n  within : used ≤ capacity := by omega\\n\\ndef Budget.reserve? (budget : Budget capacity) (amount : Nat) : Option (Budget capacity) :=\\n  if fits : budget.used+amount ≤ capacity then some ⟨budget.used+amount,fits⟩ else none\\n\\ndef Budget.release (budget : Budget capacity) (amount : Nat) : Budget capacity :=\\n  ⟨budget.used-amount,Nat.le_trans (Nat.sub_le ..) budget.within⟩\\n\\ntheorem Budget.reserved_within (budget next : Budget capacity) (amount : Nat)\\n    (_reserved : budget.reserve? amount = some next) : next.used ≤ capacity := next.within\\n\\ndef capacity : Nat := 512*1024*1024\\ndef maxLoads : Nat := 2\\ndef maxEntries : Nat := 128\\n\\nstructure Entry where\\n  promise : IO.Promise (Except String Loaded)\\n  charge : Nat\\n  borrowers : Nat\\n  stamp : Nat\\n  serial : Nat\\n  loading : Bool := true\\n\\nstructure State where\\n  entries : Std.HashMap String Entry := {}\\n  budget : Budget capacity := {}\\n  active : Nat := 0\\n  clock : Nat := 0\\n  closed : Bool := false\\n  loads : Nat := 0\\n  hits : Nat := 0\\n  joins : Nat := 0\\n  evictions : Nat := 0\\n  readBytes : Nat := 0\\n\\nstructure Pool where\\n  state : Std.Mutex State\\n  tasks : Std.Mutex (Array (Task (Except IO.Error Unit)))\\n\\ndef Pool.new : IO Pool := return ⟨← Std.Mutex.new {},← Std.Mutex.new #[]⟩\\n\\ninductive Admission where\\n  | borrowed (entry : Entry)\\n  | start (entry : Entry)\\n  | busy\\n\\ndef evict (state : State) : Option State := do\\n  let idle := state.entries.toArray.filter fun (_,entry) => !entry.loading && entry.borrowers == 0\\n  let (key,entry) ← (idle.qsort fun a b => a.2.stamp < b.2.stamp)[0]?\\n  return {state with\\n    entries := state.entries.erase key\\n    budget := state.budget.release entry.charge\\n    evictions := state.evictions+1}\\n\\ndef reclaim (state : State) (charge : Nat) : Nat → State\\n  | 0 => state\\n  | fuel+1 =>\\n      if state.budget.used+charge ≤ capacity && state.entries.size < maxEntries then state else\\n      match evict state with\\n      | none => state\\n      | some next => reclaim next charge fuel\\n\\ndef State.borrow? (state : State) (key : String) : Option (State × Entry) := do\\n  let entry ← state.entries[key]?\\n  let entry := {entry with borrowers := entry.borrowers+1,stamp := state.clock+1}\\n  return ({state with\\n    entries := state.entries.insert key entry\\n    clock := state.clock+1\\n    hits := state.hits + (if entry.loading then 0 else 1)\\n    joins := state.joins + (if entry.loading then 1 else 0)},entry)\\n\\ndef Pool.borrow? (pool : Pool) (key : String) : IO (Option Entry) := pool.state.atomically do\\n  let state ← get\\n  unless !state.closed do throw (IO.userError \\\"prepared source service is closed\\\")\\n  let some (next,entry) := state.borrow? key | return none\\n  set next\\n  return some entry\\n\\ndef Pool.admit (pool : Pool) (key : String) (charge : Nat) : IO Admission := pool.state.atomically do\\n  let state ← get\\n  unless !state.closed do throw (IO.userError \\\"prepared source service is closed\\\")\\n  if let some (state,entry) := state.borrow? key then\\n    set state\\n    return .borrowed entry\\n  if state.active ≥ maxLoads then return .busy\\n  let state := reclaim state charge maxEntries\\n  if state.active ≥ maxLoads || state.entries.size ≥ maxEntries then\\n    set state\\n    return .busy\\n  let some budget := state.budget.reserve? charge | set state; return .busy\\n  let entry : Entry := ⟨← IO.Promise.new,charge,1,state.clock+1,state.clock+1,true⟩\\n  set {state with\\n    entries := state.entries.insert key entry\\n    budget\\n    clock := state.clock+1\\n    active := state.active+1\\n    loads := state.loads+1}\\n  return .start entry\\n\\ndef Pool.release (pool : Pool) (key : String) (serial : Nat) : IO Unit := pool.state.atomically do\\n  modify fun state => match state.entries[key]? with\\n    | none => state\\n    | some entry => if entry.serial != serial then state else\\n        {state with entries := state.entries.insert key {entry with borrowers := entry.borrowers-1}}\\n\\ndef Pool.finish (pool : Pool) (key : String) (entry : Entry)\\n    (bytes : Nat) (result : Except String Loaded) : IO Unit := pool.state.atomically do\\n  let state ← get\\n  if !state.closed then\\n    match state.entries[key]? with\\n    | none => pure ()\\n    | some current =>\\n        if current.serial != entry.serial then pure () else match result with\\n        | .ok _ => set {state with\\n            active := state.active-1\\n            readBytes := state.readBytes+bytes\\n            entries := state.entries.insert key {current with loading := false}}\\n        | .error _ => set {state with\\n            active := state.active-1\\n            entries := state.entries.erase key\\n            budget := state.budget.release current.charge}\\n  unless ← entry.promise.isResolved do entry.promise.resolve result\\n\\n/-- Closing and launching share the same short ownership lock. A requester\\ncannot spawn a preparation after close has retired its task registry. -/\\ndef Pool.launch (pool : Pool) (identity : String) (entry : Entry) (bytes : Nat)\\n    (load : IO Loaded) : IO Unit := pool.state.atomically do\\n  let state ← get\\n  if state.closed then\\n    unless ← entry.promise.isResolved do entry.promise.resolve (.error \\\"prepared source service stopped\\\")\\n    return\\n  let task ← IO.asTask (do\\n    let result ← try pure (.ok (← load) : Except String Loaded)\\n      catch error => pure (.error error.toString)\\n    pool.finish identity entry bytes result) .dedicated\\n  pool.tasks.atomically do\\n    let live ← (← get).filterM fun task => return !(← IO.hasFinished task)\\n    set (live.push task)\\n\\ndef key (path : System.FilePath) (metadata : Cache.Manifest) : String :=\\n  (toJson (path.normalize.toString,metadata)).compress\\n\\ninductive Reuse where\\n  | loaded | joined | hit\\n  deriving BEq, ToJson, FromJson\\n\\n/-- A read capability names one source scope and immutable preparation.\\nOnly its non-secret identity belongs in a delivery/memo receipt. -/\\nstructure Access where\\n  database : String\\n  scope : String\\n  capability : String\\n  source : PageMap.Head\\n  metadata : Cache.Manifest\\n  reuse : Reuse\\n  deriving ToJson, FromJson\\n\\ndef Access.identity (access : Access) : Json :=\\n  toJson (access.database,access.scope,access.source,access.metadata)\\n\\ntheorem Access.capability_not_identity (access : Access) (secret : String) :\\n    ({access with capability := secret}).identity = access.identity := rfl\\n\\nstructure Projection where\\n  identity : Json\\n  rows : Array (String × Array StoredRow)\\n  reuse : Reuse\\n  deriving ToJson, FromJson\\n\\n/-- Payload bytes are verified only by the preparation owner. Admission\\ncharges a conservative footprint including decoder and origin-index overhead;\\nthe process RSS limit is measured independently of this accounting. -/\\ndef Pool.acquire (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)\\n    (metadata : Cache.Manifest) (deadline : Nat) : IO (Entry × Reuse) := do\\n  unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"prepared source request expired\\\")\\n  let identity := key path metadata\\n  if let some entry ← pool.borrow? identity then\\n    return (entry,if entry.loading then .joined else .hit)\\n  let payload := path / (metadata.payload ++ \\\".json\\\")\\n  let bytes := (← payload.metadata).byteSize.toNat\\n  unless bytes ≤ 32*1024*1024 do throw (IO.userError \\\"prepared source payload exceeds its bound\\\")\\n  -- Include the original view's bounded page cache in service admission.\\n  let charge := bytes*8+metadata.rows*1024+65536+256*1024*1024\\n  unless charge ≤ capacity do throw (IO.userError \\\"prepared source footprint exceeds service capacity\\\")\\n  repeat\\n    unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"prepared source admission expired\\\")\\n    match ← pool.admit identity charge with\\n    | .busy => IO.sleep 1\\n    | .borrowed entry => return (entry,if entry.loading then .joined else .hit)\\n    | .start entry =>\\n        try\\n          pool.launch identity entry bytes do\\n            let some ready ← Cache.atSource? source path metadata |\\n              throw (IO.userError \\\"prepared source no longer matches its publication\\\")\\n            return {Loaded.make ready with originals := ← Index.openShared? source}\\n        catch error => pool.finish identity entry 0 (.error error.toString)\\n        return (entry,.loaded)\\n  throw (IO.userError \\\"unreachable prepared source admission\\\")\\n\\ndef Pool.withReady (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)\\n    (metadata : Cache.Manifest) (deadline : Nat) (use : Loaded → Reuse → IO α) : IO α := do\\n  let identity := key path metadata\\n  let (entry,reuse) ← pool.acquire source path metadata deadline\\n  try\\n    repeat\\n      unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"prepared source wait expired\\\")\\n      if ← entry.promise.isResolved then\\n        let some result := entry.promise.result?.get | throw (IO.userError \\\"prepared source reply missing\\\")\\n        return ← use (← IO.ofExcept result) reuse\\n      IO.sleep 1\\n    throw (IO.userError \\\"unreachable prepared source wait\\\")\\n  finally pool.release identity entry.serial\\n\\ndef Pool.close (pool : Pool) : IO Unit := do\\n  pool.state.atomically do\\n    let state ← get\\n    set {state with closed := true,entries := {},budget := {},active := 0}\\n    for (_,entry) in state.entries do\\n      unless ← entry.promise.isResolved do entry.promise.resolve (.error \\\"prepared source service stopped\\\")\\n  for task in ← pool.tasks.atomically get do IO.cancel task\\n\\ndef Pool.stats (pool : Pool) : IO Json := pool.state.atomically do\\n  let state ← get\\n  return Json.mkObj [(\\\"entries\\\",toJson state.entries.size),(\\\"chargedBytes\\\",toJson state.budget.used),\\n    (\\\"capacity\\\",toJson capacity),(\\\"active\\\",toJson state.active),(\\\"loads\\\",toJson state.loads),\\n    (\\\"hits\\\",toJson state.hits),(\\\"joins\\\",toJson state.joins),(\\\"evictions\\\",toJson state.evictions),\\n    (\\\"verifiedPayloadBytes\\\",toJson state.readBytes),(\\\"closed\\\",toJson state.closed),\\n    (\\\"accountedExact\\\",toJson (state.budget.used ==\\n      state.entries.fold (fun total _ entry => total+entry.charge) 0))]\\n\\nend Eggshell.Synapses.CanonicalSource.Shared\\n\"],[\"DaemonWire.lean\",\"module\\n\\npublic import Eggshell.PluginModel\\npublic import Std.Async.TCP\\npublic import Std.Async.Timer\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin.Daemon\\n\\nopen Lean Std Async TCP\\n\\ndef maxFrameBytes : Nat := 8 * 1024 * 1024\\ndef startupAttempts : Nat := 80\\n\\nstructure Endpoint where\\n  session : String := \\\"\\\"\\n  pid : Nat := 0\\n  port : Nat\\n  secret : String\\n  /-- Identity of the daemon executable selected by the current Plugin bundle. -/\\n  generation : String\\n  deriving ToJson, FromJson\\n\\ndef endpointJsonDefaults : List (String × Json) :=\\n  [(\\\"session\\\", toJson \\\"\\\"), (\\\"pid\\\", toJson (0 : Nat))]\\n\\nnamespace Endpoint\\n\\ndef compatible (endpoint : Endpoint) (generation : String) : Bool :=\\n  endpoint.generation == generation\\n\\ntheorem incompatible_generation_rejected {endpoint : Endpoint} {generation : String}\\n    (different : endpoint.generation ≠ generation) :\\n    endpoint.compatible generation = false := by\\n  simp [compatible, different]\\n\\nend Endpoint\\n\\ndef endpointPath (session : String) : IO System.FilePath := do\\n  pure ((← sessionFiles session).directory / \\\"daemon.json\\\")\\n\\ndef startupLock (session : String) : IO System.FilePath := do\\n  pure ((← sessionFiles session).directory / \\\"daemon-start\\\")\\n\\ndef daemonExecutable : IO System.FilePath := do\\n  match ← IO.getEnv \\\"PLUGIN_ROOT\\\" with\\n  | some root =>\\n      let bundled := System.FilePath.mk root / \\\"bin\\\" / \\\"eggshelld\\\"\\n      if ← bundled.pathExists then pure bundled else IO.appPath\\n  | none => IO.appPath\\n\\n/--\\nThe endpoint is valid only for the executable selected by this Plugin bundle.\\nFile metadata is a private lifecycle generation, not semantic authority; it\\nkeeps a reinstalled Plugin from silently talking to an older resident daemon.\\n-/\\ndef executableGeneration (path : System.FilePath) : IO String := do\\n  let metadata ← path.metadata\\n  pure s!\\\"{metadata.byteSize}:{repr metadata.modified}\\\"\\n\\ndef desiredGeneration : IO String := do\\n  executableGeneration (← daemonExecutable)\\n\\ndef loopback (port : UInt16) : Net.SocketAddress :=\\n  .v4 ⟨.ofParts 127 0 0 1, port⟩\\n\\ndef frameLength (bytes : ByteArray) : ByteArray :=\\n  let value := bytes.size.toUInt32\\n  .mk #[\\n    (value >>> 24).toUInt8,\\n    (value >>> 16).toUInt8,\\n    (value >>> 8).toUInt8,\\n    value.toUInt8]\\n\\ndef decodeLength (bytes : ByteArray) : Nat :=\\n  ((bytes.get! 0).toNat <<< 24) |||\\n    ((bytes.get! 1).toNat <<< 16) |||\\n    ((bytes.get! 2).toNat <<< 8) ||| (bytes.get! 3).toNat\\n\\npartial def receiveExactly (client : Socket.Client) (remaining : Nat)\\n    (deadline : Nat) (received : ByteArray := ByteArray.empty) : IO ByteArray := do\\n  if remaining = 0 then return received\\n  let now ← IO.monoMsNow\\n  if now ≥ deadline then throw (IO.userError \\\"daemon receive deadline expired\\\")\\n  let chunk ← (do\\n    let timer ← Selector.sleep (.ofNat (deadline - now))\\n    Selectable.one #[\\n      .case (client.recvSelector remaining.toUInt64) pure,\\n      .case timer (fun _ => throw (IO.userError \\\"daemon receive deadline expired\\\"))]).block\\n  let some chunk := chunk |\\n    throw (IO.userError \\\"eggshelld closed an incomplete frame\\\")\\n  if chunk.isEmpty then\\n    throw (IO.userError \\\"eggshelld returned an empty frame\\\")\\n  receiveExactly client (remaining - chunk.size) deadline (received.append chunk)\\n\\ndef receiveFrameBefore (client : Socket.Client) (deadline : Nat) : IO ByteArray := do\\n  let header ← receiveExactly client 4 deadline\\n  let length := decodeLength header\\n  if length > maxFrameBytes then\\n    throw (IO.userError \\\"eggshelld frame exceeds the transport bound\\\")\\n  receiveExactly client length deadline\\n\\ndef receiveFrame (client : Socket.Client) (budget : Nat := 24000) : IO ByteArray := do\\n  receiveFrameBefore client ((← IO.monoMsNow) + budget)\\n\\ndef sendFrame (client : Socket.Client) (payload : ByteArray) : IO Unit := do\\n  if payload.size > maxFrameBytes then\\n    throw (IO.userError \\\"eggshelld frame exceeds the transport bound\\\")\\n  (client.sendAll #[frameLength payload, payload]).block\\n\\ndef response (output : Except String String) : Json :=\\n  match output with\\n  | .ok value => Json.mkObj [(\\\"ok\\\", true), (\\\"output\\\", value)]\\n  | .error message => Json.mkObj [(\\\"ok\\\", false), (\\\"error\\\", message)]\\n\\ndef request (secret kind : String) (payload : Json := Json.null) : Json :=\\n  Json.mkObj [(\\\"secret\\\", secret), (\\\"kind\\\", kind), (\\\"payload\\\", payload)]\\n\\ndef connect (endpoint : Endpoint) : IO Socket.Client := do\\n  if endpoint.port > 65535 then\\n    throw (IO.userError \\\"invalid eggshelld port\\\")\\n  let client ← Socket.Client.mk\\n  (client.connect (loopback endpoint.port.toUInt16)).block\\n  pure client\\n\\ndef exchangeBefore (endpoint : Endpoint) (kind : String)\\n    (payload : Json) (deadline : Nat) : IO String := do\\n  let client ← connect endpoint\\n  sendFrame client (request endpoint.secret kind payload |>.compress |>.toUTF8)\\n  let bytes ← receiveFrameBefore client deadline\\n  let text ← match String.fromUTF8? bytes with\\n    | some text => pure text\\n    | none => throw (IO.userError \\\"daemon response is not UTF-8\\\")\\n  let json ← match Json.parse text with\\n    | .ok json => pure json\\n    | .error message => throw (IO.userError message)\\n  if json.getObjValD \\\"ok\\\" == true then\\n    pure ((json.getObjValAs? String \\\"output\\\").toOption.getD \\\"\\\")\\n  else throw (IO.userError ((json.getObjValAs? String \\\"error\\\").toOption.getD \\\"daemon failure\\\"))\\n\\ndef exchange (endpoint : Endpoint) (kind : String)\\n    (payload : Json := Json.null) (budget : Nat := 24000) : IO String := do\\n  exchangeBefore endpoint kind payload ((← IO.monoMsNow) + budget)\\n\\nend Eggshell.Plugin.Daemon\\n\"],[\"PluginModel.lean\",\"module\\n\\npublic import Eggshell.Config\\npublic import Eggshell.Blake3\\npublic import Eggshell.Lifecycle\\npublic import Eggshell.Receipt\\npublic import Eggshell.SourceEvidence\\npublic import Eggshell.SourceObservation\\npublic import Eggshell.ContentCapture\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin\\n\\nopen Lean\\n\\ninductive Projection where\\n  | automatic\\n  | none\\n  | roots (values : List String)\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\ninductive SemanticSearchStatus where\\n  | notRequested | completed | pending | timedOut | failed\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\ninductive SearchRoute where\\n  | configured | lexical\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\n/-- Runtime observations do not authorize equality or completion. -/\\nstructure SearchTrace where\\n  semantic : SemanticSearchStatus\\n  route : SearchRoute\\n  semanticMs : Nat\\n  lexicalMs : Nat\\n  warmMs : Nat := 0\\n  warmRequests : Nat := 0\\n  deriving Repr, ToJson, FromJson\\n\\nstructure DeliveryOffer where\\n  id : String\\n  stamp : RequestStamp\\n  graphs : List String\\n  text : String\\n  reason : String\\n  search : Option SearchTrace := none\\n  deriving Repr, ToJson, FromJson\\n\\nstructure ThreadState where\\n  profile : String\\n  /-- When false, hooks neither stage work nor read or send graph context. -/\\n  enabled : Bool := true\\n  nextProfile : Option String := none\\n  nextProjection : Option Projection := none\\n  deliveredGraphs : List String := []\\n  /-- Native history may have discarded previously visible staged Outcomes. -/\\n  afterCompaction : Bool := false\\n  lastHandoff : String := \\\"\\\"\\n  lastReason : String := \\\"\\\"\\n  lastSearch : Option SearchTrace := none\\n  /-- Record first versus subsequent eligible searches, including failed or empty results.\\n  This diagnostic marker is independent of acknowledgement, compaction and deadline allocation. -/\\n  searchStarted : Bool := false\\n  epoch : Nat := 0\\n  offers : List DeliveryOffer := []\\n  deriving Repr, ToJson, FromJson\\n\\n/-- Temporary claims expire; only client acknowledgements persist delivery. -/\\ndef ThreadState.deliveryClaims (state : ThreadState) (turn : String) (now : Nat) : List String :=\\n  (state.deliveredGraphs ++ (state.offers.filter (fun offer =>\\n    offer.stamp.accepts turn state.epoch now)).flatMap (·.graphs)).eraseDups\\n\\ntheorem expired_offer_is_not_a_claim (state : ThreadState) (turn : String) (now : Nat)\\n    (expired : ∀ offer ∈ state.offers, offer.stamp.accepts turn state.epoch now = false) :\\n    state.deliveryClaims turn now = state.deliveredGraphs.eraseDups := by\\n  have empty : state.offers.filter (fun offer => offer.stamp.accepts turn state.epoch now) = [] := by\\n    apply List.filter_eq_nil_iff.mpr\\n    intro offer present\\n    simp [expired offer present]\\n  simp [ThreadState.deliveryClaims, empty]\\n\\nstructure ToolEvent where\\n  name : String\\n  useId : String\\n  input : String\\n  response : String\\n  source : Option SourceEvidence.Capture := none\\n  contentInputs : Option SourceEvidence.Capture := none\\n  correspondence : Option ContentCapture.Captured := none\\n  deriving Repr, ToJson, FromJson\\n\\nstructure PendingTurn where\\n  sessionId : String\\n  turnId : String\\n  cwd : String\\n  prompt : String\\n  profile : String\\n  semanticMatcher : Option (List String)\\n  read : List String\\n  write : Option String\\n  handoffChars : Nat\\n  localUnion : Bool := true\\n  projection : Projection\\n  /--\\n  Native occurrences awaiting a possible PostToolUse result. Codex may omit the\\n  terminal hook, so this state is correlation only and never execution authority.\\n  -/\\n  inFlight : List ToolEvent := []\\n  tools : List ToolEvent := []\\n  /-- Related dependency descriptors, queued for the independent observer.\\n  These are locators/previous fingerprints, never evidence of new contents. -/\\n  sources : List SourceEvidence.File := []\\n  finalMessage : Option String := none\\n  closed : Bool := false\\n  deriving Repr, ToJson, FromJson\\n\\nstructure Promotion where\\n  outcomeRelations : List Value\\n\\n/-- The indexer receives the bounded owner view returned after DB publication,\\n    never from a merely compiled or staged turn. It is not a whole DB image. -/\\nstructure CommittedPromotion where\\n  snapshot : Graph\\n  outcomeRelations : List Value\\n  owners_in_snapshot : ∀ owner ∈ outcomeRelations, owner ∈ snapshot.values\\n\\ndef committedPromotion? (snapshot : Graph) (promotion : Promotion) :\\n    Option CommittedPromotion :=\\n  if members : promotion.outcomeRelations ⊆ snapshot.values then\\n    some {\\n      snapshot := snapshot\\n      outcomeRelations := promotion.outcomeRelations\\n      owners_in_snapshot := members }\\n  else none\\n\\ntheorem committedPromotion?_identity {snapshot : Graph} {promotion : Promotion}\\n    {committed : CommittedPromotion}\\n    (accepted : committedPromotion? snapshot promotion = some committed) :\\n    committed.snapshot = snapshot ∧\\n      committed.outcomeRelations = promotion.outcomeRelations := by\\n  unfold committedPromotion? at accepted\\n  split at accepted\\n  · cases accepted\\n    exact ⟨rfl, rfl⟩\\n  · cases accepted\\n\\ntheorem committed_index_owner_present (promotion : CommittedPromotion)\\n    (owner : Value) (present : owner ∈ promotion.outcomeRelations) :\\n    owner ∈ promotion.snapshot.values := promotion.owners_in_snapshot owner present\\n\\ndef prepareCommitted (snapshot : Graph)\\n    (promotion : Promotion) : IO CommittedPromotion := do\\n  let some committed := committedPromotion? snapshot promotion |\\n    throw (IO.userError \\\"published snapshot is missing a promoted outcome\\\")\\n  pure committed\\n\\nstructure SessionFiles where\\n  directory : System.FilePath\\n  state : System.FilePath\\n  pending : System.FilePath\\n  lock : System.FilePath\\n\\ndef safeSession (session : String) : Except String String :=\\n  if session != \\\"\\\" && session.toList.all fun character =>\\n      character.isAlphanum || character == '-' || character == '_' then\\n    pure session\\n  else throw \\\"Codex session ID contains a path-unsafe character\\\"\\n\\n/--\\nShared control-plane state must be visible to both Codex hooks and `!egg`.\\n`PLUGIN_DATA` is hook-only on some hosts, so using it would split one session\\nacross two directories. This root stores session state, daemon coordination,\\nand disposable matcher data; project-selected `.egg` authorities remain the\\nper-turn paths snapshotted in `PendingTurn`.\\n-/\\ndef dataRoot : IO System.FilePath := do\\n  Paths.dataRoot\\n\\ndef sessionFiles (session : String) : IO SessionFiles := do\\n  let safe ← match safeSession session with\\n    | .ok safe => pure safe\\n    | .error message => throw (IO.userError message)\\n  let directory := (← dataRoot) / \\\"sessions\\\" / safe\\n  pure {\\n    directory\\n    state := directory / \\\"state.json\\\"\\n    pending := directory / \\\"pending.json\\\"\\n    lock := directory / \\\"state\\\"\\n  }\\n\\ndef stateJsonDefaults : List (String × Json) :=\\n  [(\\\"searchStarted\\\", toJson false), (\\\"epoch\\\", toJson (0 : Nat)), (\\\"offers\\\", toJson ([] : List DeliveryOffer))]\\n\\ndef pendingJsonDefaults : List (String × Json) := [(\\\"closed\\\", toJson false)]\\n\\n/-- Add only fields introduced by this runtime. Existing malformed fields must\\n    still fail validation rather than being silently replaced. -/\\ndef readJson? [FromJson α] (path : System.FilePath)\\n    (defaults : List (String × Json) := []) : IO (Option α) := do\\n  if !(← path.pathExists) then pure none\\n  else\\n    let text ← IO.FS.readFile path\\n    let parsed ← match Json.parse text with\\n      | .ok json => pure json\\n      | .error message => throw (IO.userError s!\\\"{path}: {message}\\\")\\n    let parsed := match parsed with\\n      | .obj _ => defaults.foldl (fun json (key, value) =>\\n          if (json.getObjVal? key).isOk then json else json.setObjVal! key value) parsed\\n      | _ => parsed\\n    match fromJson? parsed with\\n    | .ok value => pure (some value)\\n    | .error message => throw (IO.userError s!\\\"{path}: {message}\\\")\\n\\ndef writeJson [ToJson α] (path : System.FilePath) (value : α) : IO Unit := do\\n  let path := ((← IO.currentDir) / path).normalize\\n  if let some parent := path.parent then Persistence.privateDirectory parent\\n  -- The receipt must survive a client or manager exit before its queued work\\n  -- is consumed. Publish only after the temporary bytes have been synced.\\n  FileSystem.atomicBytes path (toJson value |>.compress |>.toUTF8)\\n\\ndef readBoundedJson [FromJson α] (path : System.FilePath) (limit : Nat) : IO α := do\\n  let bytes ← FileSystem.boundedBytes path limit\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid JSON text encoding\\\")\\n  IO.ofExcept (Json.parse text >>= fromJson?)\\n\\ndef removeIfExists (path : System.FilePath) : IO Unit := do\\n  if ← path.pathExists then IO.FS.removeFile path\\n\\ndef withSession (session : String) (action : SessionFiles → IO α) : IO α := do\\n  let files ← sessionFiles session\\n  Persistence.privateDirectory files.directory\\n  Persistence.withLockWithin files.lock 100 (action files)\\n\\n/-- Corrupt control state is retained for diagnosis, never repeatedly parsed. -/\\ndef quarantine (path : System.FilePath) : IO Unit := do\\n  if ← path.pathExists then\\n    let suffix := toString (← IO.monoNanosNow)\\n    IO.FS.rename path (.mk (path.toString ++ \\\".corrupt-\\\" ++ suffix))\\n\\ndef readState? (files : SessionFiles) : IO (Option ThreadState) := do\\n  try readJson? files.state stateJsonDefaults\\n  catch error =>\\n    quarantine files.state\\n    let disabled : ThreadState := {\\n      profile := \\\"work\\\", enabled := false,\\n      lastReason := s!\\\"memory disabled after invalid session state: {error}\\\" }\\n    writeJson files.state disabled\\n    pure (some disabled)\\n\\ndef readPendingBase? (files : SessionFiles) : IO (Option PendingTurn) := do\\n  try readJson? files.pending pendingJsonDefaults\\n  catch error =>\\n    quarantine files.pending\\n    IO.eprintln s!\\\"Eggshell preserved an unreadable staged turn: {error}\\\"\\n    pure none\\n\\ndef toolDirectory (files : SessionFiles) (turn : String) : System.FilePath :=\\n  files.directory / \\\"tools\\\" / (Blake3.hex (Blake3.digest \\\"eggshell.turn\\\".toUTF8 [turn.toUTF8]))\\n\\n/-- Point-addressed lifecycle metadata, retained after a save job is consumed.\\nA late Stop/result must still have its original turn's destination and scope;\\nit must never borrow the currently active turn's metadata. -/\\ndef closedTurnPath (files : SessionFiles) (turn : String) : System.FilePath :=\\n  files.directory / \\\"closed\\\" /\\n    ((Blake3.hex (Blake3.digest \\\"eggshell.closed-turn\\\".toUTF8 [turn.toUTF8])) ++ \\\".json\\\")\\n\\ndef readClosedTurn? (files : SessionFiles) (turn : String) : IO (Option PendingTurn) := do\\n  let record ← (readJson? (closedTurnPath files turn) pendingJsonDefaults : IO (Option PendingTurn))\\n  pure (record.filter (fun pending => pending.turnId == turn && pending.closed))\\n\\ndef toolReceiptPath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  toolDirectory files turn /\\n    (Blake3.hex (Blake3.digest \\\"eggshell.tool\\\".toUTF8 [useId.toUTF8]) ++ \\\".json\\\")\\n\\ndef ToolEvent.native (tool : ToolEvent) : ToolEvent :=\\n  {tool with source := none,contentInputs := none,correspondence := none}\\n\\ntheorem native_receipt_ignores_source (tool : ToolEvent) (source : Option SourceEvidence.Capture) :\\n    ({tool with source}.native) = tool.native := rfl\\n\\ntheorem native_receipt_ignores_correspondence (tool : ToolEvent)\\n    (contentInputs : Option SourceEvidence.Capture) (correspondence : Option ContentCapture.Captured) :\\n    ({tool with contentInputs,correspondence}.native) = tool.native := rfl\\n\\nstructure SourceCertificate where\\n  stamp : String\\n  bytes : Nat\\n  source : SourceEvidence.Capture\\n  deriving ToJson, FromJson\\n\\nstructure ContentCertificate where\\n  stamp : String\\n  bytes : Nat\\n  captured : ContentCapture.Captured\\n  deriving ToJson, FromJson\\n\\ndef contentCertificatePath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  files.directory / \\\"correspondence\\\" / (toolDirectory files turn).fileName.getD \\\"\\\" /\\n    (toolReceiptPath files turn useId).fileName.getD \\\"\\\"\\n\\ndef sourceCertificatePath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  files.directory / \\\"sources\\\" / (toolDirectory files turn).fileName.getD \\\"\\\" /\\n    (toolReceiptPath files turn useId).fileName.getD \\\"\\\"\\n\\n/-- Parse bytes and observe their version through the same held descriptor.\\nA replaced or concurrently edited native receipt cannot authorize a companion. -/\\ndef readNativeTool? (path : System.FilePath) : IO (Option (ToolEvent × FileSystem.ReadVersion)) := do\\n  if (← FileSystem.regularMetadata? path).isNone then return none\\n  let handle ← FileSystem.openRead path.toString\\n  let before ← FileSystem.readVersion handle\\n  let mut bytes := ByteArray.empty\\n  while bytes.size < before.bytes do\\n    let count := min 4096 (before.bytes - bytes.size)\\n    let page ← FileSystem.readPage handle bytes.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    if page.size != count then throw (IO.userError \\\"short native receipt read\\\")\\n    bytes := bytes ++ page\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\\n  unless FileSystem.stableRead before after current bytes.size do\\n    throw (IO.userError \\\"native receipt changed during read\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"native receipt is not UTF-8\\\")\\n  let tool ← IO.ofExcept (Json.parse text >>= fromJson? (α := ToolEvent))\\n  pure (some (tool.native, before))\\n\\ndef attachCertificate (files : SessionFiles) (turn : String)\\n    (tool : ToolEvent) (version : FileSystem.ReadVersion) : IO ToolEvent := do\\n  let mut result := tool.native\\n  try\\n    if let some certificate ← (readJson? (sourceCertificatePath files turn tool.useId) :\\n        IO (Option SourceCertificate)) then\\n      if certificate.stamp == version.stamp && certificate.bytes == version.bytes then\\n        result := {result with source := some certificate.source}\\n  catch _ => pure () -- Optional provenance never discards the native result.\\n  try\\n    if let some certificate ← (readJson? (contentCertificatePath files turn tool.useId) :\\n        IO (Option ContentCertificate)) then\\n      if certificate.stamp == version.stamp && certificate.bytes == version.bytes then\\n        result := {result with correspondence := some certificate.captured}\\n  catch _ => pure ()\\n  return result\\n\\n/-- Journal the immutable body first; provenance is a small, version-bound\\ncompanion. An identical replay performs no body publication. Reusing a native\\nID for different bytes is an error, never replacement of an earlier result. -/\\ndef recordTool (files : SessionFiles) (turn : String) (tool : ToolEvent) : IO Unit := do\\n  let path := toolReceiptPath files turn tool.useId\\n  if let some (previous, _) ← readNativeTool? path then\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"conflicting native tool receipt ID\\\")\\n  else\\n    if let some parent := path.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes path (toJson tool.native |>.compress |>.toUTF8)\\n  if let some source := tool.source then\\n    let some (previous, version) ← readNativeTool? path |\\n      throw (IO.userError \\\"native receipt disappeared before source publication\\\")\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"source certificate belongs to another native result\\\")\\n    let certificate : SourceCertificate := ⟨version.stamp, version.bytes, source⟩\\n    let certificatePath := sourceCertificatePath files turn tool.useId\\n    if let some parent := certificatePath.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes certificatePath (toJson certificate |>.compress |>.toUTF8)\\n  if let some captured := tool.correspondence then\\n    let some (previous,version) ← readNativeTool? path |\\n      throw (IO.userError \\\"native receipt disappeared before content publication\\\")\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"content correspondence belongs to another native result\\\")\\n    let certificate : ContentCertificate := ⟨version.stamp,version.bytes,captured⟩\\n    let certificatePath := contentCertificatePath files turn tool.useId\\n    if let some parent := certificatePath.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes certificatePath (toJson certificate |>.compress |>.toUTF8)\\n\\ndef recordedTool? (files : SessionFiles) (turn : String) (tool : ToolEvent) : IO (Option ToolEvent) := do\\n  let some (previous, version) ← readNativeTool? (toolReceiptPath files turn tool.useId) | return none\\n  unless toJson previous == toJson tool.native do return none\\n  some <$> attachCertificate files turn previous version\\n\\n/-- Tool bodies are separate immutable receipts, not a growing JSON rewrite per hook. -/\\ndef loadToolReceipts (files : SessionFiles) (pending : PendingTurn) : IO PendingTurn := do\\n  let directory := toolDirectory files pending.turnId\\n  let mut tools := pending.tools\\n  if ← directory.pathExists then\\n    let entries := (← directory.readDir).toList.mergeSort (fun a b => a.fileName ≤ b.fileName)\\n    for entry in entries do\\n      if entry.fileName.endsWith \\\".json\\\" then\\n        try\\n          if let some (native, version) ← readNativeTool? entry.path then\\n            let tool ← attachCertificate files pending.turnId native version\\n            tools := tools.filter (·.useId != tool.useId) ++ [tool]\\n        catch error =>\\n          IO.eprintln s!\\\"Eggshell retained an unreadable tool receipt: {error}\\\"\\n  pure { pending with tools }\\n\\ndef readPending? (files : SessionFiles) : IO (Option PendingTurn) := do\\n  (← readPendingBase? files).mapM (loadToolReceipts files)\\n\\n/-- Immutable queue entries are removed only after the .egg commit succeeds. -/\\ndef queueCheckpoint (files : SessionFiles) (pending : PendingTurn) : IO Unit := do\\n  let key := Blake3.hex (Blake3.digest \\\"eggshell.checkpoint\\\".toUTF8\\n    [(toJson pending).compress.toUTF8])\\n  writeJson (files.directory / \\\"checkpoints\\\" / (key ++ \\\".json\\\")) pending\\n\\n/-- Independent observations have their own immutable identity. No native\\nresult or earlier source certificate is refreshed or attributed a later state. -/\\ndef observationTool (observation : SourceObservation.Observation limit) : ToolEvent :=\\n  let response := (SourceObservation.observationJson observation).compress\\n  let input := (Json.mkObj [(\\\"files\\\", toJson (observation.capture.record.files.map (·.relative)))]).compress\\n  { name := \\\"eggshell.observe_file\\\"\\n    useId := \\\"eggshell-observation:\\\" ++ Blake3.hex (Blake3.digest \\\"eggshell.observation.record\\\".toUTF8\\n      [input.toUTF8, response.toUTF8])\\n    input, response, source := some observation.capture }\\n\\ntheorem observation_binds_new_record (observation : SourceObservation.Observation limit) :\\n    (observationTool observation).source = some observation.capture ∧\\n      (observationTool observation).response = (SourceObservation.observationJson observation).compress :=\\n  ⟨rfl, rfl⟩\\n\\n/-- This save-worker operation observes registered related files regardless of\\nwhich command, program, editor or local provider changed them. The hook never\\ncalls it. Pending scans retain their queue entry and resume at a page cursor. -/\\ndef observeRelatedFiles (files : SessionFiles) (pending : PendingTurn) (deadline : Nat) : IO Bool := do\\n  let workspace := System.FilePath.mk pending.cwd\\n  let dependencies := (pending.tools.flatMap\\n    (fun tool => tool.source.map (·.record.files) |>.getD []) ++ pending.sources).eraseDups\\n  for file in dependencies do SourceObservation.register files.directory workspace file\\n  let mut finished := true\\n  for path in ← SourceObservation.entries files.directory workspace do\\n    if (← IO.monoMsNow) ≥ deadline then return false\\n    let observed ← try SourceObservation.step path workspace (128 * 1024) 256 deadline\\n      catch error =>\\n        IO.eprintln s!\\\"Eggshell retained source history; observation unavailable: {error}\\\"\\n        pure .unverified\\n    match observed with\\n    | .pending => finished := false\\n    | .unverified => pure ()\\n    | .complete snapshot observation =>\\n        if let some observation := observation then\\n          let tool := observationTool observation\\n          -- This durable queue contains the actual data and its certificate.\\n          -- It is not a native tool receipt: the running model has not seen\\n          -- this independent observation and it cannot bind its final answer.\\n          queueCheckpoint files {pending with tools := [tool], sources := [], inFlight := [], finalMessage := none, closed := false}\\n        SourceObservation.acknowledge path snapshot\\n  pure finished\\n\\ndef pendingSelection (pending : PendingTurn) : Config.Selection := {\\n  label := pending.profile\\n  semanticMatcher := pending.semanticMatcher\\n  read := pending.read.map fun raw => { name := raw, path := System.FilePath.mk raw }\\n  write := pending.write.map fun raw => { name := raw, path := System.FilePath.mk raw }\\n  handoffChars := pending.handoffChars\\n  localUnion := pending.localUnion\\n}\\n\\ndef valueEncoding (value : Value) : String :=\\n  Persistence.valueToJson value |>.compress\\n\\ndef indexOwnerKey (owner : Value) : String :=\\n  \\\"owner:\\\" ++ toString (hash owner)\\n\\ndef indexProviderKey (command : List String) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.index-provider\\\".toUTF8 [(toJson command).compress.toUTF8])\\n\\n/-- Executables belong to private installation configuration, never an imported DB. -/\\nstructure IndexTarget where\\n  owner : DB.Sidecar.Owner\\n  command : List String\\n  storage : DB.Sidecar.Storage := .database\\n  deriving Repr, BEq, ToJson, FromJson\\n\\ndef IndexTarget.key (target : IndexTarget) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.index-target\\\".toUTF8 [(toJson target).compress.toUTF8])\\n\\ndef IndexTarget.indexes (target : IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO System.FilePath := do\\n  pure ((← DB.Sidecar.locate snapshot target.storage).indexes / indexProviderKey target.command)\\n\\ndef indexRegistry : IO System.FilePath := do pure ((← dataRoot) / \\\"index-targets\\\")\\n\\ndef registerIndexTarget (snapshot : DB.PageMap.Snapshot) (command : List String)\\n    (writable : Bool := true) : IO IndexTarget := do\\n  if command.isEmpty then throw (IO.userError \\\"index provider must name an executable\\\")\\n  let owner := DB.Sidecar.Owner.ofSnapshot snapshot\\n  let (storage, _) ← DB.Sidecar.destination owner writable\\n  let target : IndexTarget := {owner, command, storage}\\n  let directory ← indexRegistry\\n  Persistence.rejectSymlinkAncestors directory\\n  Persistence.privateDirectory directory\\n  let path := directory / (target.key ++ \\\".json\\\")\\n  let bytes := (toJson target).compress.toUTF8\\n  unless bytes.size ≤ 65536 do throw (IO.userError \\\"index target exceeds metadata bound\\\")\\n  if ← path.pathExists then\\n    let previous ← FileSystem.boundedBytes path 65536\\n    if previous == bytes then return target\\n    let parsed : Except String IndexTarget := match String.fromUTF8? previous with\\n      | none => .error \\\"invalid index target encoding\\\"\\n      | some text => Json.parse text >>= fromJson?\\n    match parsed with\\n    | .ok _ => throw (IO.userError \\\"conflicting index target digest\\\")\\n    | .error error =>\\n        IO.eprintln s!\\\"Eggshell repairing a damaged index target: {error}\\\"\\n        quarantine path\\n  FileSystem.immutableBytes path bytes\\n  pure target\\n\\ndef registeredIndexTargets : IO (List (System.FilePath × IndexTarget)) := do\\n  let directory ← indexRegistry\\n  if !(← directory.pathExists) then return []\\n  let mut targets := []\\n  for entry in ((← directory.readDir).toList.mergeSort (fun a b => a.fileName ≤ b.fileName)) do\\n    if !entry.fileName.endsWith \\\".json\\\" then continue\\n    try\\n      let target ← (readBoundedJson entry.path 65536 : IO IndexTarget)\\n      unless entry.fileName == target.key ++ \\\".json\\\" && !target.command.isEmpty do\\n        throw (IO.userError \\\"index registry entry disagrees with its identity\\\")\\n      targets := targets ++ [(entry.path, target)]\\n    catch error => IO.eprintln s!\\\"Eggshell retained unreadable index target: {error}\\\"\\n  pure targets\\n\\n/-- Portable, data-only work. Provider hashes select locally registered lanes;\\nno executable or absolute destination is imported with a DB. -/\\nstructure IndexTicket where\\n  database : String\\n  provider : String\\n  authority : String\\n  roots : List String\\n  deriving ToJson, FromJson, BEq\\n\\ndef indexTicket (database provider : String)\\n    (promotion : CommittedPromotion) : IndexTicket := {\\n  database, provider\\n  authority := valueEncoding promotion.snapshot.authority\\n  roots := promotion.outcomeRelations.map indexOwnerKey |>.eraseDups\\n}\\n\\ntheorem index_ticket_root_is_published (database provider : String)\\n    (promotion : CommittedPromotion) (key : String)\\n    (present : key ∈ (indexTicket database provider promotion).roots) :\\n    ∃ owner ∈ promotion.snapshot.values, indexOwnerKey owner = key := by\\n  simp only [indexTicket, List.mem_eraseDups, List.mem_map] at present\\n  obtain ⟨owner, member, equal⟩ := present\\n  exact ⟨owner, promotion.owners_in_snapshot owner member, equal⟩\\n\\ndef queueIndex (target : String) (command : List String)\\n    (promotion : CommittedPromotion) : IO Unit := do\\n  let snapshot ← DB.PageMap.pin (.mk target)\\n  unless snapshot.head.authority == valueEncoding promotion.snapshot.authority do\\n    throw (IO.userError \\\"index publication belongs to another authority\\\")\\n  let target ← registerIndexTarget snapshot command\\n  let sidecar ← DB.Sidecar.prepare target.owner target.storage\\n  let directory ← DB.Sidecar.childDirectory sidecar.indexes (indexProviderKey command)\\n  let ticket := indexTicket snapshot.head.identity (indexProviderKey command) promotion\\n  let bytes := (toJson ticket).compress.toUTF8\\n  unless bytes.size ≤ 1048576 do throw (IO.userError \\\"index ticket exceeds metadata bound\\\")\\n  let key := Blake3.hex (Blake3.digest \\\"eggshell.index-ticket\\\".toUTF8\\n    [(toJson ticket).compress.toUTF8])\\n  FileSystem.immutableExistingBytes (directory / (key ++ \\\".json\\\")) bytes\\n\\ndef resolveIndexTicket (snapshot : Graph) (ticket : IndexTicket) : IO CommittedPromotion := do\\n  if valueEncoding snapshot.authority != ticket.authority then\\n    throw (IO.userError \\\"index ticket belongs to a different authority\\\")\\n  let candidates := snapshot.values.map fun owner => (indexOwnerKey owner, owner)\\n  let owners ← ticket.roots.mapM fun key => do\\n    match candidates.filter (fun candidate => candidate.1 == key) with\\n    | [(_, owner)] => pure owner\\n    | [] => throw (IO.userError \\\"published index owner is missing\\\")\\n    | _ => throw (IO.userError \\\"ambiguous index owner digest\\\")\\n  prepareCommitted snapshot { outcomeRelations := owners }\\n\\ndef valueKey (value : Value) : String :=\\n  Persistence.selectionKey value\\n\\ndef allNodes (composite : Persistence.Composite) : List Value :=\\n  composite.values.flatMap Value.nodes |>.eraseDups\\n\\ndef resolveKey (composite : Persistence.Composite) (key : String) : Except String Value :=\\n  match (allNodes composite).filter (valueKey · == key) with\\n  | [value] => pure value\\n  | [] => throw s!\\\"unknown Value {key}\\\"\\n  | _ => throw s!\\\"ambiguous display key {key}; inspect the full graph\\\"\\n\\n/-\\nNative JSON is identity-bearing data, not display framing. Lean's JSON object is\\nan ordered map, so parse-and-compress preserves keys, types, containers, array\\norder, and null while making object-key order irrelevant.\\n-/\\ndef canonicalJson (encoded : String) : String :=\\n  match Json.parse encoded with\\n  | .ok json => json.compress\\n  | .error _ => encoded\\n\\n/--\\nThe whole native invocation remains the reservation identity. Object-key order\\nis normalized, while every semantic distinction in the native input is retained.\\n-/\\ndef canonicalToolWork (tool : ToolEvent) : String :=\\n  tool.name ++ \\\"\\\\n\\\" ++ canonicalJson tool.input\\n\\n/--\\nRemember an admitted native occurrence for later PostToolUse correlation.\\nReservations never control execution because Codex does not emit a terminal\\nhook for every failed or externally blocked tool.\\n-/\\ndef reserveTool (pending : PendingTurn) (tool : ToolEvent) : PendingTurn :=\\n  { pending with\\n    inFlight := pending.inFlight.filter (·.useId != tool.useId) ++ [tool] }\\n\\n/-- Close exactly one native occurrence and retain one completed tool record. -/\\ndef finishTool (pending : PendingTurn) (tool : ToolEvent) : PendingTurn :=\\n  { pending with\\n    inFlight := pending.inFlight.filter (fun current => current.useId != tool.useId)\\n    tools := pending.tools.filter (fun current => current.useId != tool.useId) ++ [tool] }\\n\\n/-- A denied or failed PreToolUse releases only its own transient reservation. -/\\ndef cancelTool (pending : PendingTurn) (useId : String) : PendingTurn :=\\n  { pending with inFlight := pending.inFlight.filter (·.useId != useId) }\\n\\n/-- A session owns one pending turn; an omitted hook turn ID denotes that turn. -/\\ndef matchesHookTurn (pending : PendingTurn) : Option String → Bool\\n  | none => true\\n  | some turn => turn == pending.turnId\\n\\n@[simp] theorem matchesHookTurn_omitted (pending : PendingTurn) :\\n    matchesHookTurn pending none = true := rfl\\n\\ntheorem cancelTool_removes_useId (pending : PendingTurn) (useId : String) :\\n    (cancelTool pending useId).inFlight.all (·.useId != useId) := by\\n  simp [cancelTool]\\n\\ndef relation? (operator : Operator) (arguments : List Ref) : Except String Value :=\\n  match Relation.apply? operator arguments with\\n  | some relation => pure relation\\n  | none => throw s!\\\"invalid {Persistence.operatorName operator} relation\\\"\\n\\n/-- One native invocation owns exactly one observed Work→Outcome edge. -/\\ndef observedWorkOutcome (work observed occurrence : Value) : Value × Value :=\\n  let edge := OutcomeEdge.make work observed [occurrence]\\n    (by simp) (by simp [maxOutcomeObservations])\\n  (work, edge.relation)\\n\\n@[simp]\\ntheorem observedWorkOutcome_work (work observed occurrence : Value) :\\n    (observedWorkOutcome work observed occurrence).1 = work := rfl\\n\\n/--\\nOne native occurrence cites its Work and Outcome once. Session, turn, and the\\nnative tool-use ID are the exact occurrence identity; repeating the raw input\\nand response here would retain the same payload twice without adding authority.\\n-/\\ndef nativeOccurrenceArguments (session turn : Value) (tool : ToolEvent) : List Ref :=\\n  [\\n    .semantic (.text (canonicalJson tool.response)),\\n    .semantic (.text (canonicalToolWork tool)),\\n    .exact session,\\n    .exact turn,\\n    .exact (.text tool.useId)]\\n\\ndef nativeOccurrence (session turn : Value) (tool : ToolEvent) : Value :=\\n  .applyList .occurrence (nativeOccurrenceArguments session turn tool)\\n\\ntheorem nativeOccurrence_valid (session turn : Value) (tool : ToolEvent) :\\n    Relation.validArguments .occurrence\\n      (nativeOccurrenceArguments session turn tool) := by\\n  have semantic : (Authority.semantic == Authority.semantic) = true := by decide\\n  have exact : (Authority.exact == Authority.semantic) = false := by decide\\n  simp [nativeOccurrenceArguments, Relation.validArguments,\\n    Relation.splitOccurrence, Relation.semanticValues, Relation.exactValues,\\n    Ref.semantic, Ref.exact, List.takeWhile, semantic, exact]\\n\\ntheorem nativeOccurrence_exactFootprint (session turn : Value) (tool : ToolEvent) :\\n    (nativeOccurrence session turn tool).exactFootprint =\\n      session :: session.exactFootprint ++\\n      turn :: turn.exactFootprint ++ [.text tool.useId] := by\\n  simp [nativeOccurrence, nativeOccurrenceArguments, Value.applyList,\\n    Refs.ofList, Value.exactFootprint, Value.refsExactFootprint,\\n    Ref.semantic, Ref.exact, Value.text]\\n\\n/-\\nNative tool facts have one compiler regardless of whether they are still\\nstaged or are being promoted.  The active turn can therefore join the same\\nrun-local WorkGraph as committed `.egg` authorities without inventing a\\nsecond trace format or granting the stage persistent authority.\\n-/\\ndef compileOperationOutcomes (session turn : Value) (tool : ToolEvent) :\\n    Value × Value :=\\n  let work := Value.text (canonicalToolWork tool)\\n  let observed := Value.text (canonicalJson tool.response)\\n  observedWorkOutcome work observed (nativeOccurrence session turn tool)\\n\\ndef operationChildren (pending : PendingTurn) : List Value :=\\n  ((pending.tools.map fun tool =>\\n    (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).1).eraseDups) ++\\n    [HandoffRemainder.value pending.prompt]\\n\\ntheorem operation_checkpoint_keeps_open_remainder (pending : PendingTurn) :\\n    HandoffRemainder.value pending.prompt ∈ operationChildren pending := by\\n  simp [operationChildren]\\n\\ndef compileOperationGraph (pending : PendingTurn) : Except String (List Value × Value) := do\\n  let facts := pending.tools.map (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId))\\n  let all ← relation? .all\\n    (.semantic (.text pending.prompt) :: (operationChildren pending).map Ref.semantic)\\n  pure (facts.map (·.2), all)\\n\\ndef operationSourceReceipts (pending : PendingTurn) : List Value :=\\n  pending.tools.filterMap fun tool => tool.source.map fun capture =>\\n    let owner := (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).2\\n    SourceEvidence.receipt (.text pending.sessionId) (.text pending.turnId)\\n      (.text tool.useId) owner capture.record\\n\\ntheorem operation_owner_ignores_source (session turn : Value) (tool : ToolEvent)\\n    (source : Option SourceEvidence.Capture) :\\n    compileOperationOutcomes session turn {tool with source} =\\n      compileOperationOutcomes session turn tool := rfl\\n\\ntheorem operation_owner_ignores_correspondence (session turn : Value) (tool : ToolEvent)\\n    (contentInputs : Option SourceEvidence.Capture) (correspondence : Option ContentCapture.Captured) :\\n    compileOperationOutcomes session turn {tool with contentInputs,correspondence} =\\n      compileOperationOutcomes session turn tool := rfl\\n\\n/--\\nAn unresolved native occurrence and a missing final message cannot affect the\\nobserved operation graph.  Recovery may therefore retain exactly the terminal\\ntool outcomes while leaving the parent Work open.\\n-/\\ntheorem compileOperationGraph_ignores_unobserved (pending : PendingTurn)\\n    (inFlight : List ToolEvent) (finalMessage : Option String) :\\n    compileOperationGraph {\\n      pending with inFlight := inFlight, finalMessage := finalMessage\\n    } = compileOperationGraph pending := by\\n  rfl\\n\\n/-- The active turn joins the same positive graph shape later promoted to `.egg`. -/\\ndef stagedGraphValues (pending : PendingTurn) : Except String (List Value) := do\\n  let (outcomes, all) ← compileOperationGraph pending\\n  pure (outcomes ++ [all] ++ operationSourceReceipts pending)\\n\\ndef turnSources (pending : PendingTurn) : SourceEvidence.Record :=\\n  let records := pending.tools.map fun tool =>\\n    tool.source.map (·.record) |>.getD SourceEvidence.unverified\\n  { workspace := (System.FilePath.mk pending.cwd).fileName.getD pending.cwd\\n    files := records.flatMap (·.files) |>.eraseDups\\n    uris := records.flatMap (·.uris) |>.eraseDups\\n    -- A listing or provider with no file observations does not erase the\\n    -- independently sealed file state. The answer still has an open domain\\n    -- and therefore cannot complete a later native operation.\\n    complete := records.any (fun record => !record.files.isEmpty) &&\\n      (records.filter (fun record => !record.files.isEmpty)).all (·.complete)\\n    closed := !records.isEmpty && records.all (fun record => record.complete && record.closed) }\\n\\nstructure CompiledTurn (source : Graph) where\\n  transaction : Transaction\\n  promotion : Promotion\\n  transaction_authority : transaction.authority = source.authority\\n  transaction_revision : transaction.baseRevision = source.revision\\n\\ndef compile (graph : Graph) (pending : PendingTurn) (target : String) :\\n    Except String (CompiledTurn graph) := do\\n  let session := Value.text pending.sessionId\\n  let turn := Value.text pending.turnId\\n  let cwd := Value.text pending.cwd\\n  let task := Value.text pending.prompt\\n  let (outcomeRelations, all) ← compileOperationGraph pending\\n  let targetValue := Value.text target\\n  let (values, promotedOutcomes) ← match pending.finalMessage with\\n    | some finalMessage =>\\n        let result := Value.text finalMessage\\n        let turnOccurrence ← relation? .occurrence [\\n          .semantic task, .semantic result, .exact session, .exact turn, .exact cwd]\\n        let parentOutcome ← relation? .outcome [\\n          .semantic task, .semantic result, .exact turnOccurrence]\\n        let receipt ← relation? .receipt [\\n          .exact session, .exact turn, .exact task, .exact result,\\n          .exact parentOutcome, .exact all, .exact targetValue]\\n        let sourceReceipts := if pending.tools.any (·.source.isSome) then\\n          [SourceEvidence.receipt session turn (.text \\\"parent\\\") parentOutcome (turnSources pending)] else []\\n        pure\\n          ((outcomeRelations ++ [all, parentOutcome, receipt] ++ sourceReceipts ++ operationSourceReceipts pending).eraseDups,\\n            outcomeRelations ++ [parentOutcome])\\n    | none =>\\n        if pending.tools.isEmpty then\\n          throw \\\"cannot promote an interrupted turn without observed outcomes\\\"\\n        let receipt ← relation? .receipt [\\n          .exact session, .exact turn, .exact task, .exact cwd,\\n          .exact all, .exact targetValue, .exact (.text \\\"interrupted before final response\\\")]\\n        pure ((outcomeRelations ++ [all, receipt] ++ operationSourceReceipts pending).eraseDups, outcomeRelations)\\n  /-\\n  Only authoritative relation roots are stored. Their structural Values contain\\n  every Atom and occurrence, so duplicating that closure as top-level records\\n  changes no semantics and only inflates `.egg`.\\n  -/\\n  match accepted : (Transaction.begin graph).stageValues? (values.filter (!graph.values.contains ·)) with\\n  | none => throw \\\"turn compiler produced an invalid Value\\\"\\n  | some transaction =>\\n      have source := Transaction.stageValues?_preserves_source accepted\\n      pure {\\n        transaction\\n        promotion := {\\n          outcomeRelations := promotedOutcomes\\n        }\\n        transaction_authority := source.1\\n        transaction_revision := source.2\\n      }\\n\\ntheorem compiled_transaction_belongs_to_source {graph pending target compiled}\\n    (_accepted : compile graph pending target = .ok compiled) :\\n    compiled.transaction.authority = graph.authority ∧\\n      compiled.transaction.baseRevision = graph.revision :=\\n  ⟨compiled.transaction_authority, compiled.transaction_revision⟩\\n\\ntheorem compiled_values_are_well_formed {graph : Graph}\\n    (compiled : CompiledTurn graph) :\\n    ∀ value, value ∈ compiled.transaction.stagedValues →\\n      Relation.wellFormed value :=\\n  compiled.transaction.stagedValues_wellFormed\\n\\n/-- Outcome roots in a live checkpoint come only from observed native operations. -/\\ndef observedRoots (pending : PendingTurn) : List Value :=\\n  pending.tools.map fun tool =>\\n    (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).2\\n\\ntheorem checkpoint_ignores_parent_status (pending : PendingTurn)\\n    (finalMessage : Option String) (inFlight : List ToolEvent) :\\n    observedRoots { pending with finalMessage, inFlight } = observedRoots pending := by\\n  rfl\\n\\ntheorem checkpoint_has_only_observed_roots (pending : PendingTurn) (root : Value)\\n    (present : root ∈ observedRoots pending) :\\n    ∃ tool ∈ pending.tools,\\n      (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).2 = root := by\\n  simpa [observedRoots] using present\\n\\nend Eggshell.Plugin\\n\"],[\"DB/PageMap.lean\",\"module\\n\\npublic import Eggshell.DB.Wire\\npublic import Eggshell.FileSystem\\npublic import Eggshell.Blake3\\npublic import Std.Data.HashMap.Lemmas\\nimport all Init.Data.Ord.String\\nimport all Init.System.ST\\n\\n@[expose] public section\\nnamespace Eggshell.DB.PageMap\\nopen Lean Std\\n\\n/-- Dense immutable leaves and a high-fanout ordered directory. A transaction\\ncopies only affected leaf/directory pages; the head is a constant-size root.\\nPhysical addresses are never semantic identities. -/\\nabbrev Row := String × Option ByteArray\\n\\ndef rowCodec : Wire.Codec Row := Wire.text.product (Wire.optional Wire.byteBlob)\\n\\nstructure Ref where\\n  offset : Nat\\n  bytes : Nat\\n  checksum : String\\n  first : String\\n  last : String\\n  height : Nat\\n  rows : Nat\\n  deriving ToJson, FromJson, BEq, DecidableEq\\n\\ndef refCodec : Wire.Codec Ref :=\\n  (Wire.natural.product (Wire.natural.product (Wire.text.product\\n    (Wire.text.product (Wire.text.product (Wire.natural.product Wire.natural)))))).iso\\n    (fun r => (r.offset, r.bytes, r.checksum, r.first, r.last, r.height, r.rows))\\n    (fun (offset, bytes, checksum, first, last, height, rows) =>\\n      ⟨offset, bytes, checksum, first, last, height, rows⟩)\\n    (by intro r; cases r; rfl)\\n\\ninductive Page where\\n  | leaf (rows : List Row)\\n  | branch (children : List Ref)\\n  deriving DecidableEq\\n\\ndef pageCodec : Wire.Codec Page :=\\n  (Wire.sum (Wire.list rowCodec) (Wire.list refCodec)).iso\\n    (fun | .leaf rows => .inl rows | .branch children => .inr children)\\n    (fun | .inl rows => .leaf rows | .inr children => .branch children)\\n    (by intro page; cases page <;> rfl)\\n\\ndef encode (page : Page) : ByteArray := (pageCodec.encode page).toByteArray\\n\\ndef decode (bytes : ByteArray) : Except String Page := do\\n  let (page, tail) ← pageCodec.decode bytes.toList\\n  unless tail.isEmpty do throw \\\"trailing bytes in index page\\\"\\n  unless encode page == bytes do throw \\\"noncanonical index page\\\"\\n  pure page\\n\\ntheorem page_codec_roundtrip (page : Page) (tail : List UInt8) :\\n    pageCodec.decode (pageCodec.encode page ++ tail) = .ok (page, tail) :=\\n  pageCodec.roundtrip page tail\\n\\ndef ordered : List Row → Bool\\n  | [] | [_] => true\\n  | a :: b :: rest => compare a.1 b.1 == .lt && ordered (b :: rest)\\n\\ntheorem ordered_of_pairwise (rows : List Row)\\n    (sorted : rows.Pairwise (fun a b => compare a.1 b.1 = .lt)) : ordered rows = true := by\\n  induction rows with\\n  | nil => rfl\\n  | cons a rest ih =>\\n    cases rest with\\n    | nil => rfl\\n    | cons b rest =>\\n      have parts := List.pairwise_cons.mp sorted\\n      simp only [ordered, Bool.and_eq_true, beq_iff_eq]\\n      exact ⟨parts.1 b (by simp), ih parts.2⟩\\n\\n/-- The linear check performed by the disk decoder establishes the complete\\nstrict-order premise used by the merge proof; no quadratic runtime check is\\nneeded to connect decoded pages to that specification. -/\\ntheorem pairwise_of_ordered (rows : List Row) (accepted : ordered rows = true) :\\n    rows.Pairwise (fun a b => compare a.1 b.1 = .lt) := by\\n  induction rows with\\n  | nil => exact List.Pairwise.nil\\n  | cons a rest ih =>\\n    cases rest with\\n    | nil => simp\\n    | cons b rest =>\\n      simp only [ordered, Bool.and_eq_true, beq_iff_eq] at accepted\\n      have tail := ih accepted.2\\n      obtain ⟨afterB, _⟩ := List.pairwise_cons.mp tail\\n      apply List.pairwise_cons.mpr\\n      refine ⟨?_, tail⟩\\n      intro row member\\n      rcases List.mem_cons.mp member with equal | member\\n      · subst row; exact accepted.1\\n      · exact Std.TransCmp.lt_of_lt_of_isLE accepted.1 (by rw [afterB row member]; decide)\\n\\ndef childrenValid (refs : List Ref) : Bool :=\\n  !refs.isEmpty && refs.length ≤ 32 &&\\n  refs.all (fun r => 0 < r.rows && 0 < r.bytes && r.bytes ≤ 65536 && r.first ≤ r.last) &&\\n  (refs.zip refs.tail).all (fun (a, b) => a.last < b.first && a.height == b.height)\\n\\ndef agrees (ref : Ref) : Page → Bool\\n  | .leaf rows =>\\n      !rows.isEmpty && ordered rows && ref.height == 0 && ref.rows == rows.length &&\\n      rows.head?.map (·.1) == some ref.first && rows.getLast?.map (·.1) == some ref.last\\n  | .branch children =>\\n      childrenValid children &&\\n      children.head?.map (·.first) == some ref.first &&\\n      children.getLast?.map (·.last) == some ref.last &&\\n      children.head?.map (fun r => r.height + 1) == some ref.height &&\\n      ref.rows == (children.map (·.rows)).sum\\n\\ndef magic : ByteArray := \\\"eggshell.pages\\\\n\\\".toUTF8\\n\\ndef digest (bytes : ByteArray) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.page\\\".toUTF8 [bytes])\\n\\nstructure Head where\\n  identity : String\\n  authority : String\\n  revision : Nat := 0\\n  bytes : Nat := magic.size\\n  root : Option Ref := none\\n  deriving ToJson, FromJson, BEq, DecidableEq\\n\\ndef headCodec : Wire.Codec Head :=\\n  (Wire.text.product (Wire.text.product (Wire.natural.product\\n    (Wire.natural.product (Wire.optional refCodec))))).iso\\n    (fun h => (h.identity, h.authority, h.revision, h.bytes, h.root))\\n    (fun (identity, authority, revision, bytes, root) =>\\n      ⟨identity, authority, revision, bytes, root⟩)\\n    (by intro h; cases h; rfl)\\n\\ntheorem head_codec_roundtrip (head : Head) (tail : List UInt8) :\\n    headCodec.decode (headCodec.encode head ++ tail) = .ok (head, tail) :=\\n  headCodec.roundtrip head tail\\n\\nstructure Loaded (ref : Ref) where\\n  page : Page\\n  valid : agrees ref page = true\\n\\nstructure CachedPage where\\n  ref : Ref\\n  loaded : Loaded ref\\n\\n/-- Two bounded generations of certified pages from this pinned reader.\\nOffset lookup avoids scanning and rebuilding a recency list on every tree\\nlevel; complete reference equality still decides whether a page can be used. -/\\nstructure PageCache where\\n  recent : Std.HashMap Nat CachedPage := {}\\n  previous : Std.HashMap Nat CachedPage := {}\\n  recentBounded : recent.size ≤ 2048 := by simp\\n  previousBounded : previous.size ≤ 2048 := by simp\\n\\ndef PageCache.lookup (cache : PageCache) (offset : Nat) : Option CachedPage :=\\n  cache.recent[offset]?.orElse fun _ => cache.previous[offset]?\\n\\ndef PageCache.find (cache : PageCache) (ref : Ref) : Option (Loaded ref) := do\\n  let cached ← cache.lookup ref.offset\\n  if same : cached.ref = ref then some (same ▸ cached.loaded) else none\\n\\ndef PageCache.touch (cache : PageCache) (page : CachedPage) : PageCache :=\\n  -- Decide before insertion: retaining the old table for a possible rotation\\n  -- would force copy-on-write of its bucket array on every cache hit.\\n  if fits : cache.recent.size < 2048 ∨ page.ref.offset ∈ cache.recent then\\n    ⟨cache.recent.insert page.ref.offset page, cache.previous, by\\n      by_cases present : page.ref.offset ∈ cache.recent\\n      · simpa only [Std.HashMap.size_insert, if_pos present] using cache.recentBounded\\n      · have room := fits.resolve_right present\\n        simp only [Std.HashMap.size_insert, if_neg present]\\n        omega,\\n      cache.previousBounded⟩\\n  else\\n    ⟨({} : Std.HashMap Nat CachedPage).insert page.ref.offset page, cache.recent,\\n      by simp [Std.HashMap.size_insert], cache.recentBounded⟩\\n\\ntheorem PageCache.touch_bounded (cache : PageCache) (page : CachedPage) :\\n    (cache.touch page).recent.size + (cache.touch page).previous.size ≤ 4096 := by\\n  have := (cache.touch page).recentBounded\\n  have := (cache.touch page).previousBounded\\n  omega\\n\\ntheorem PageCache.touch_recent (cache : PageCache) (page : CachedPage) :\\n    (cache.touch page).lookup page.ref.offset = some page := by\\n  by_cases fits : cache.recent.size < 2048 ∨ page.ref.offset ∈ cache.recent\\n  <;> simp [touch, fits, lookup]\\n\\ntheorem PageCache.find_rejects (cache : PageCache) (ref : Ref) (cached : CachedPage)\\n    (located : cache.lookup ref.offset = some cached) (different : cached.ref ≠ ref) :\\n    cache.find ref = none := by\\n  simp [find, located, different]\\n\\ndef validIdentity (identity : String) : Bool :=\\n  identity.length == 64 && identity.toList.all (fun c =>\\n    ('0' ≤ c && c ≤ '9') || ('a' ≤ c && c ≤ 'f'))\\n\\ndef dataPath (directory : System.FilePath) (head : Head) : System.FilePath :=\\n  directory / (head.identity ++ \\\".pages\\\")\\n\\n/-- A reference into an append-only file incarnation. A checksum detects\\ndamage; reference identity, rather than checksum equality, preserves bytes. -/\\nstructure Blob where\\n  offset : Nat\\n  bytes : Nat\\n  checksum : String\\n  deriving BEq, DecidableEq, Hashable\\n\\ninstance : LawfulBEq Blob where\\n  rfl := by\\n    intro blob\\n    change instBEqBlob.beq blob blob = true\\n    cases blob; simp [instBEqBlob.beq]\\n  eq_of_beq := by\\n    intro left right equal\\n    change instBEqBlob.beq left right = true at equal\\n    cases left; cases right; simp_all [instBEqBlob.beq]\\n\\ndef blobCodec : Wire.Codec Blob :=\\n  (Wire.natural.product (Wire.natural.product Wire.text)).iso\\n    (fun blob => (blob.offset, blob.bytes, blob.checksum))\\n    (fun (offset, bytes, checksum) => ⟨offset, bytes, checksum⟩)\\n    (by intro blob; cases blob; rfl)\\n\\ntheorem blob_codec_roundtrip (blob : Blob) (tail : List UInt8) :\\n    blobCodec.decode (blobCodec.encode blob ++ tail) = .ok (blob, tail) :=\\n  blobCodec.roundtrip blob tail\\n\\n/-- The read reference must belong to the committed prefix of this pinned\\nhead. Each OS read is bounded independently of the size of the whole body. -/\\nstructure PinnedBlob (head : Head) where\\n  ref : Blob\\n  nonempty : 0 < ref.bytes\\n  bounded : ref.bytes ≤ 4096\\n  afterMagic : magic.size ≤ ref.offset\\n  committed : ref.offset + ref.bytes ≤ head.bytes\\n\\ndef Blob.pin? (blob : Blob) (head : Head) : Option (PinnedBlob head) :=\\n  if valid : 0 < blob.bytes ∧ blob.bytes ≤ 4096 ∧ magic.size ≤ blob.offset ∧\\n      blob.offset + blob.bytes ≤ head.bytes then\\n    some ⟨blob, valid.1, valid.2.1, valid.2.2.1, valid.2.2.2⟩\\n  else none\\n\\n/-- This is a byte equality under the append-only storage contract. No\\ninjectivity or collision-resistance assumption about a digest is used. -/\\ntheorem blob_bytes_preserved_by_append (before appended : ByteArray) (blob : Blob)\\n    (committed : blob.offset + blob.bytes ≤ before.size) :\\n    (before ++ appended).extract blob.offset (blob.offset + blob.bytes) =\\n      before.extract blob.offset (blob.offset + blob.bytes) := by\\n  rw [ByteArray.extract_append]\\n  have start : blob.offset - before.size = 0 := by omega\\n  have finish : blob.offset + blob.bytes - before.size = 0 := by omega\\n  simp [start, finish]\\n\\n/-- Discarding an uncommitted tail also preserves every committed reference.\\nThe native recovery adapter checks EOF and the writer supplies the durable\\nhead boundary; recovery never truncates inside that boundary. -/\\ntheorem blob_bytes_preserved_by_recovery (before : ByteArray) (retained : Nat) (blob : Blob)\\n    (committed : blob.offset + blob.bytes ≤ retained) :\\n    (before.extract 0 retained).extract blob.offset (blob.offset + blob.bytes) =\\n      before.extract blob.offset (blob.offset + blob.bytes) := by\\n  rw [ByteArray.extract_extract]\\n  simp only [Nat.zero_add, Nat.min_eq_left committed]\\n\\n/-- Actual search reads, including empty ranges and absent keys. A new\\nmatching owner cannot hide behind a cache which recorded only positive hits.\\nPayload dependencies retain immutable references, never another body copy.\\nThe source head records the file incarnation once for the complete read set;\\nvalidation checks that identity before checking references and body integrity. -/\\ninductive ReadObservation where\\n  | point (key : String) (value : Option ByteArray)\\n  | range (lower upper : String) (rows : List Row)\\n  | blob (ref : Blob)\\n  /-- The complete observed prefix is expanded from the source's saved root.\\n  A full read uses all chunks; a short-circuit comparison names only the\\n  prefix it actually consumed, never a duplicate descriptor/body list. -/\\n  | payload (payloadKey : String) (bytes chunks : Nat)\\n  deriving BEq, DecidableEq, Hashable\\n\\nlocal instance : LawfulBEq ByteArray where\\n  rfl := by\\n    intro bytes\\n    change ByteArray.beq bytes bytes = true\\n    simp [ByteArray.beq]\\n  eq_of_beq := by\\n    intro left right equal\\n    apply ByteArray.ext\\n    change (left.data == right.data) = true at equal\\n    exact beq_iff_eq.mp equal\\n\\ninstance : LawfulBEq ReadObservation where\\n  rfl := by\\n    intro observation\\n    change instBEqReadObservation.beq observation observation = true\\n    cases observation <;> simp [instBEqReadObservation.beq]\\n  eq_of_beq := by\\n    intro left right equal\\n    change instBEqReadObservation.beq left right = true at equal\\n    cases left <;> cases right <;> simp_all [instBEqReadObservation.beq]\\n\\ndef readObservationCodec : Wire.Codec ReadObservation :=\\n  (Wire.sum rowCodec (Wire.sum\\n    (Wire.text.product (Wire.text.product (Wire.list rowCodec)))\\n    (Wire.sum blobCodec (Wire.text.product (Wire.natural.product Wire.natural))))).iso\\n    (fun | .point key value => .inl (key, value)\\n         | .range lower upper rows => .inr (.inl (lower, upper, rows))\\n         | .blob ref => .inr (.inr (.inl ref))\\n         | .payload payloadKey bytes chunks => .inr (.inr (.inr (payloadKey, bytes, chunks))))\\n    (fun | .inl (key, value) => .point key value\\n         | .inr (.inl (lower, upper, rows)) => .range lower upper rows\\n         | .inr (.inr (.inl ref)) => .blob ref\\n         | .inr (.inr (.inr (payloadKey, bytes, chunks))) => .payload payloadKey bytes chunks)\\n    (by intro observation; cases observation <;> rfl)\\n\\ntheorem read_observation_roundtrip (observation : ReadObservation) (tail : List UInt8) :\\n    readObservationCodec.decode (readObservationCodec.encode observation ++ tail) =\\n      .ok (observation, tail) := readObservationCodec.roundtrip observation tail\\n\\ndef ReadObservation.check? (expected actual : ReadObservation) :\\n    Option { observed : ReadObservation // observed = expected } :=\\n  if same : actual = expected then some ⟨actual, same⟩ else none\\n\\ntheorem changed_observation_rejected (expected actual : ReadObservation)\\n    (changed : actual ≠ expected) : expected.check? actual = none := by\\n  simp [ReadObservation.check?, changed]\\n\\ndef readTraceAllowance : Nat := 65536\\n\\n/-- An address nominates a collision bucket; complete observation equality\\ndecides membership. The erased invariant covers misses, empty ranges and\\npayload bytes as well as positive rows. Arbitrary address functions, including\\na constant function, preserve the exact observed domain. -/\\nstructure ObservationIndex (address : ReadObservation → UInt64)\\n    (operations : List ReadObservation) where\\n  buckets : Std.HashMap UInt64 (List ReadObservation)\\n  exact : ∀ operation,\\n    operation ∈ buckets.getD (address operation) [] ↔ operation ∈ operations\\n\\ndef ObservationIndex.empty (address : ReadObservation → UInt64) :\\n    ObservationIndex address [] := ObservationIndex.mk {} (by intro operation; simp)\\n\\ndef ObservationIndex.contains (index : ObservationIndex address operations)\\n    (operation : ReadObservation) : Bool :=\\n  ((ObservationIndex.buckets index).getD (address operation) []).contains operation\\n\\ntheorem ObservationIndex.contains_exact (index : ObservationIndex address operations)\\n    (operation : ReadObservation) : index.contains operation = operations.contains operation := by\\n  apply Bool.eq_iff_iff.mpr\\n  simpa only [contains, List.contains_iff_mem] using index.exact operation\\n\\ndef ObservationIndex.insert (index : ObservationIndex address operations)\\n    (operation : ReadObservation) : ObservationIndex address (operation :: operations) :=\\n  ObservationIndex.mk ((ObservationIndex.buckets index).insert (address operation)\\n      (operation :: (ObservationIndex.buckets index).getD (address operation) [])) (by\\n    intro wanted\\n    rw [Std.HashMap.getD_insert]\\n    by_cases same : address operation = address wanted\\n    · simp only [same, BEq.rfl, ↓reduceIte, List.mem_cons]\\n      rw [index.exact]\\n    · have different : operation ≠ wanted := by\\n        intro equal; exact same (congrArg address equal)\\n      simp only [beq_iff_eq, same, ↓reduceIte, List.mem_cons,\\n        eq_comm (a := wanted) (b := operation), different, false_or]\\n      exact index.exact wanted)\\n\\ndef ObservationIndex.make (address : ReadObservation → UInt64) :\\n    (operations : List ReadObservation) → ObservationIndex address operations\\n  | [] => .empty address\\n  | operation :: rest => (make address rest).insert operation\\n\\nstructure ReadTrace where\\n  operations : List ReadObservation := []\\n  encodedBytes : Nat := 0\\n  complete : Bool := true\\n  index : ObservationIndex hash operations := ObservationIndex.make hash operations\\n\\nabbrev ReadSummary := List ReadObservation × Nat × Bool\\n\\n/-- Full-list interpreter used only as the capture specification. -/\\ndef ReadSummary.step (state : ReadSummary) (operation : ReadObservation) : ReadSummary :=\\n  if !state.2.2 || state.1.contains operation then state else\\n    let next := state.2.1 + readObservationCodec.encodedSize operation\\n    if next ≤ readTraceAllowance then (operation :: state.1, next, true) else ([], 0, false)\\n\\ndef ReadTrace.summary (trace : ReadTrace) : ReadSummary :=\\n  (trace.operations, trace.encodedBytes, trace.complete)\\n\\ndef ReadTrace.add (trace : ReadTrace) (operation : ReadObservation) : ReadTrace :=\\n  if !trace.complete || trace.index.contains operation then trace else\\n    let next := trace.encodedBytes + readObservationCodec.encodedSize operation\\n    if next ≤ readTraceAllowance then\\n      { operations := operation :: trace.operations, encodedBytes := next, complete := true,\\n        index := trace.index.insert operation }\\n    else { complete := false }\\n\\n/-- The complete externally observable trace, including order, charged bytes\\nand permanent overflow, is identical to the former full-list interpreter.\\nOnly collision-bucket members are traversed by the actual capture path. -/\\ntheorem ReadTrace.add_exact (trace : ReadTrace) (operation : ReadObservation) :\\n    (trace.add operation).summary = ReadSummary.step trace.summary operation := by\\n  simp only [add, ObservationIndex.contains_exact, summary, ReadSummary.step]\\n  split\\n  · simp_all\\n  · split\\n    · simp_all\\n    · simp_all\\n      exact (if_neg (show ¬ trace.encodedBytes + readObservationCodec.encodedSize operation ≤\\n        readTraceAllowance from by omega)).symm\\n\\ntheorem ReadTrace.fold_exact (trace : ReadTrace) (operations : List ReadObservation) :\\n    (operations.foldl ReadTrace.add trace).summary =\\n      operations.foldl ReadSummary.step trace.summary :=\\n  (List.foldl_hom ReadTrace.summary (g₁ := ReadTrace.add) (g₂ := ReadSummary.step)\\n    (l := operations) (init := trace)\\n    (fun state operation => (state.add_exact operation).symm)).symm\\n\\ntheorem ReadTrace.add_bounded (trace : ReadTrace) (operation : ReadObservation)\\n    (bounded : trace.encodedBytes ≤ readTraceAllowance) :\\n    (trace.add operation).encodedBytes ≤ readTraceAllowance := by\\n  unfold add\\n  split\\n  · exact bounded\\n  · dsimp only\\n    split\\n    · assumption\\n    · exact Nat.zero_le _\\n\\ntheorem ReadTrace.incomplete_stays_incomplete (trace : ReadTrace)\\n    (incomplete : trace.complete = false) (operation : ReadObservation) :\\n    (trace.add operation).complete = false := by\\n  simp [add, incomplete]\\n\\nstructure Snapshot where\\n  directory : System.FilePath\\n  head : Head\\n  handle : FileSystem.ReadHandle\\n  reads : IO.Ref Nat\\n  readBytes : IO.Ref Nat\\n  cache : IO.Ref PageCache\\n  trace : IO.Ref (Option ReadTrace)\\n\\ndef Snapshot.observe (snapshot : Snapshot) (operation : ReadObservation) : IO Unit :=\\n  snapshot.trace.modify (·.map (·.add operation))\\n\\n/-- A bounded asynchronous source pull shares the same immutable image and\\nread observations, but cannot mark the controller's page cache as shared. -/\\ndef Snapshot.forkReader (snapshot : Snapshot) : IO Snapshot := do\\n  pure {snapshot with cache := ← IO.mkRef {}}\\n\\ndef absolute (path : System.FilePath) : IO System.FilePath := do\\n  let cwd ← IO.currentDir\\n  pure ((if path.isAbsolute then path else cwd / path).normalize)\\n\\ndef open? (directory : System.FilePath) : IO (Option Snapshot) := do\\n  let directory ← absolute directory\\n  FileSystem.rejectSymlinkAncestors directory\\n  match ← FileSystem.symlinkMetadata? directory with\\n  | none => pure none\\n  | some metadata =>\\n      unless metadata.type == .dir do throw (IO.userError \\\"memory DB must be a directory\\\")\\n      let bytes ← FileSystem.boundedBytes (directory / \\\"head\\\") 16384\\n      let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid DB head encoding\\\")\\n      let head : Head ← IO.ofExcept (Json.parse text >>= fromJson?)\\n      unless validIdentity head.identity do throw (IO.userError \\\"invalid DB file incarnation\\\")\\n      unless head.bytes ≥ magic.size && head.bytes < 2 ^ 63 do\\n        throw (IO.userError \\\"invalid committed DB extent\\\")\\n      if head.root.isNone then\\n        unless head.bytes == magic.size && head.revision == 0 do\\n          throw (IO.userError \\\"a published nonempty DB lost its root\\\")\\n      let handle ← FileSystem.openRead (dataPath directory head).toString\\n      let signature : FileSystem.ReadSize ← if small : magic.size ≤ 4096 then\\n          pure ⟨magic.size, small⟩ else throw (IO.userError \\\"DB signature exceeds one page\\\")\\n      unless (← FileSystem.readVersion handle).bytes ≥ head.bytes &&\\n          (← FileSystem.readPage handle 0 signature) == magic do\\n        throw (IO.userError \\\"truncated or foreign DB pages\\\")\\n      -- Opening a shared or filesystem-read-only publication never changes\\n      -- its permissions. Creation owns access-mode initialization.\\n      pure (some ⟨directory, head, handle, ← IO.mkRef 0, ← IO.mkRef 0, ← IO.mkRef {}, ← IO.mkRef none⟩)\\n\\ndef pin (directory : System.FilePath) : IO Snapshot := do\\n  let some snapshot ← open? directory | throw (IO.userError \\\"memory DB does not exist\\\")\\n  pure snapshot\\n\\ndef Snapshot.load (snapshot : Snapshot) (ref : Ref) : IO (Loaded ref) := do\\n  unless 0 < ref.bytes && ref.bytes ≤ 65536 && magic.size ≤ ref.offset &&\\n      ref.offset + ref.bytes ≤ snapshot.head.bytes do\\n    throw (IO.userError \\\"index page is outside its pinned committed extent\\\")\\n  if let some loaded := (← snapshot.cache.get).find ref then\\n    snapshot.cache.modify (·.touch ⟨ref, loaded⟩)\\n    return loaded\\n  let mut bytes := ByteArray.empty\\n  while bytes.size < ref.bytes do\\n    let count := min 4096 (ref.bytes - bytes.size)\\n    let part ← FileSystem.readPage snapshot.handle (ref.offset + bytes.size).toUInt64\\n      ⟨count, Nat.min_le_left _ _⟩\\n    unless part.size == count do throw (IO.userError \\\"truncated DB page\\\")\\n    bytes := bytes ++ part\\n  snapshot.reads.modify (· + 1)\\n  snapshot.readBytes.modify (· + bytes.size)\\n  unless digest bytes == ref.checksum do throw (IO.userError \\\"corrupted DB page\\\")\\n  let page ← IO.ofExcept (decode bytes)\\n  if valid : agrees ref page = true then\\n    let loaded : Loaded ref := ⟨page, valid⟩\\n    snapshot.cache.modify (·.touch ⟨ref, loaded⟩)\\n    pure loaded\\n  else throw (IO.userError \\\"DB page differs from its directory descriptor\\\")\\n\\n/-- The last fence not greater than the key also handles insertions beyond\\ncurrent outer fences. Point reads never enumerate the remaining children. -/\\ndef route (refs : List Ref) (key : String) : Option (Nat × Ref) :=\\n  refs.zipIdx |>.foldl (fun chosen (ref, index) =>\\n    if chosen.isNone || ref.first ≤ key then some (index, ref) else chosen) none\\n\\nstructure Lookup (height : Nat) where\\n  value : Option ByteArray\\n  visits : Nat\\n  bounded : visits ≤ height + 1\\n\\n/-- The bound counts executed page visits, including directory nodes. Cache\\nhits can reduce physical reads; they cannot weaken the fixed-snapshot bound. -/\\ndef Snapshot.getAt (snapshot : Snapshot) (ref : Ref) (key : String) : IO (Lookup ref.height) := do\\n  -- A miss is certified by the decoded page's fences. Checking an unchecked\\n  -- head/directory descriptor first can silently turn corruption into emptiness.\\n  let loaded ← snapshot.load ref\\n  if key < ref.first || ref.last < key then return ⟨none, 1, by omega⟩\\n  match loaded.page with\\n  | .leaf rows => pure ⟨(rows.find? (fun row => row.1 == key)).bind (·.2), 1, by omega⟩\\n  | .branch children =>\\n      let some (_, child) := route children key | throw (IO.userError \\\"empty branch\\\")\\n      if smaller : child.height < ref.height then\\n        let next ← snapshot.getAt child key\\n        pure ⟨next.value, next.visits + 1, by have := next.bounded; omega⟩\\n      else throw (IO.userError \\\"index height did not decrease\\\")\\ntermination_by ref.height\\n\\ntheorem Lookup.pages_bounded (result : Lookup height) : result.visits ≤ height + 1 := result.bounded\\n\\ndef Snapshot.get (snapshot : Snapshot) (key : String) : IO (Option ByteArray) := do\\n  let result ← match snapshot.head.root with\\n  | none => pure none\\n  | some ref => pure (← snapshot.getAt ref key).value\\n  snapshot.observe (.point key result)\\n  pure result\\n\\n/-- Half-open key intervals. Range readers use the same checked pages and\\nimmutable root as point readers; they never enumerate unrelated namespaces. -/\\nstructure KeyRange where\\n  lower : String\\n  upper : String\\n  deriving DecidableEq\\n\\ndef KeyRange.contains (range : KeyRange) (key : String) : Bool :=\\n  decide (range.lower ≤ key ∧ key < range.upper)\\n\\ndef KeyRange.overlaps (range : KeyRange) (ref : Ref) : Bool :=\\n  decide (range.lower ≤ ref.last ∧ ref.first < range.upper)\\n\\ndef KeyRange.select (range : KeyRange) (rows : List Row) : List Row :=\\n  rows.filter fun row => range.contains row.1\\n\\ntheorem KeyRange.select_exact (range : KeyRange) (rows : List Row) (row : Row) :\\n    row ∈ range.select rows ↔ row ∈ rows ∧ range.lower ≤ row.1 ∧ row.1 < range.upper := by\\n  simp [select, contains]\\n\\ntheorem ordered_bounds (rows : List Row) (sorted : ordered rows = true)\\n    (first last : String) (head : rows.head?.map Prod.fst = some first)\\n    (ending : rows.getLast?.map Prod.fst = some last) :\\n    ∀ row ∈ rows, first ≤ row.1 ∧ row.1 ≤ last := by\\n  induction rows generalizing first last with\\n  | nil => simp at head\\n  | cons a rest ih =>\\n      simp only [List.head?_cons, Option.map_some, Option.some.injEq] at head\\n      subst first\\n      cases rest with\\n      | nil =>\\n          simp only [List.getLast?_singleton, Option.map_some, Option.some.injEq] at ending\\n          subst last\\n          intro row member\\n          simp only [List.mem_singleton] at member\\n          subst row\\n          exact ⟨Std.le_refl _, Std.le_refl _⟩\\n      | cons b tail =>\\n          simp only [ordered, Bool.and_eq_true, beq_iff_eq] at sorted\\n          have later := ih sorted.2 b.1 last rfl (by simpa using ending)\\n          have before : a.1 ≤ b.1 := Std.le_of_lt (compareOfLessAndEq_eq_lt.mp sorted.1)\\n          intro row member\\n          rcases List.mem_cons.mp member with same | member\\n          · subst row\\n            exact ⟨Std.le_refl _, Std.le_trans before (later b (by simp)).2⟩\\n          · obtain ⟨lower, upper⟩ := later row member\\n            exact ⟨Std.le_trans before lower, upper⟩\\n\\n/-- The actual page-decoder predicate establishes the fences used by pruning;\\nthey are not an additional assumption supplied by a range caller. -/\\ntheorem leaf_bounds (ref : Ref) (rows : List Row) (checked : agrees ref (.leaf rows) = true) :\\n    ∀ row ∈ rows, ref.first ≤ row.1 ∧ row.1 ≤ ref.last := by\\n  simp only [agrees, Bool.and_eq_true, beq_iff_eq] at checked\\n  exact ordered_bounds rows checked.1.1.1.1.2 ref.first ref.last checked.1.2 checked.2\\n\\n/-- Directory fences can discard a subtree only when no key in its checked\\ninterval belongs to the request. This includes both ends of the interval. -/\\ntheorem KeyRange.prune_exact (range : KeyRange) (ref : Ref) (rows : List Row)\\n    (bounded : ∀ row ∈ rows, ref.first ≤ row.1 ∧ row.1 ≤ ref.last)\\n    (outside : range.overlaps ref = false) : range.select rows = [] := by\\n  apply List.eq_nil_iff_forall_not_mem.mpr\\n  intro row present\\n  obtain ⟨member, lower, upper⟩ := (range.select_exact rows row).mp present\\n  obtain ⟨first, last⟩ := bounded row member\\n  have overlapping : range.overlaps ref = true := by\\n    simp only [overlaps, decide_eq_true_eq]\\n    exact ⟨Std.le_trans lower last, Std.lt_of_le_of_lt first upper⟩\\n  simp [outside] at overlapping\\n\\ntheorem KeyRange.select_append (range : KeyRange) (left right : List Row) :\\n    range.select (left ++ right) = range.select left ++ range.select right :=\\n  List.filter_append left right\\n\\ndef KeyRange.prunedRows (range : KeyRange) (subtrees : List (Ref × List Row)) : List Row :=\\n  subtrees.flatMap fun (ref, rows) => if range.overlaps ref then range.select rows else []\\n\\n/-- Pruning any number of checked subtrees gives the same ordered rows as a\\nfull traversal. No matching row can disappear at a skipped directory. -/\\ntheorem KeyRange.prunedRows_exact (range : KeyRange) (subtrees : List (Ref × List Row))\\n    (bounded : ∀ subtree ∈ subtrees, ∀ row ∈ subtree.2,\\n      subtree.1.first ≤ row.1 ∧ row.1 ≤ subtree.1.last) :\\n    range.prunedRows subtrees = range.select (subtrees.flatMap Prod.snd) := by\\n  induction subtrees with\\n  | nil => rfl\\n  | cons subtree rest ih =>\\n      obtain ⟨ref, rows⟩ := subtree\\n      simp only [prunedRows, List.flatMap_cons, select_append]\\n      have tail := ih (fun subtree member => bounded subtree (by simp [member]))\\n      change _ ++ range.prunedRows rest = _\\n      rw [tail]\\n      by_cases overlap : range.overlaps ref = true\\n      · simp [overlap]\\n      · have outside : range.overlaps ref = false := Bool.eq_false_iff.mpr overlap\\n        rw [if_neg overlap, range.prune_exact ref rows (bounded (ref, rows) (by simp)) outside]\\n\\n/-- Stream the selected rows to the consumer. Only one decoded leaf and the\\ndirectory path are needed; bodies are not read by this traversal. Tombstones\\nare retained here so callers can choose their own live-row projection. -/\\ndef Snapshot.foldRangeAt (snapshot : Snapshot) (ref : Ref) (range : KeyRange)\\n    (consume : α → Row → IO α) (initial : α) : IO α := do\\n  -- As in point lookup, an unchecked head cannot certify an empty result.\\n  let loaded ← snapshot.load ref\\n  unless range.overlaps ref do return initial\\n  match loaded.page with\\n  | .leaf rows => (range.select rows).foldlM consume initial\\n  | .branch children =>\\n      let mut result := initial\\n      for child in children do\\n        -- Child fences come from this checksum-checked directory page.\\n        if range.overlaps child then\\n          if _smaller : child.height < ref.height then\\n            result ← snapshot.foldRangeAt child range consume result\\n          else throw (IO.userError \\\"range index height did not decrease\\\")\\n      pure result\\ntermination_by ref.height\\n\\ndef Snapshot.foldRange (snapshot : Snapshot) (range : KeyRange)\\n    (consume : α → Row → IO α) (initial : α) : IO α := do\\n  let tracing := (← snapshot.trace.get).any (·.complete)\\n  if !tracing then\\n    match snapshot.head.root with\\n    | none => pure initial\\n    | some ref => snapshot.foldRangeAt ref range consume initial\\n  else\\n    let captured ← IO.mkRef (some ([], 0) : Option (List Row × Nat))\\n    let collect := fun (state : α) (row : Row) => do\\n      captured.modify fun previous => previous.bind fun (rows, size) =>\\n        let size := size + rowCodec.encodedSize row\\n        if size ≤ readTraceAllowance then some (row :: rows, size) else none\\n      consume state row\\n    let result ← match snapshot.head.root with\\n      | none => pure initial\\n      | some ref => snapshot.foldRangeAt ref range collect initial\\n    match ← captured.get with\\n    | some (rows, _) => snapshot.observe (.range range.lower range.upper rows.reverse)\\n    | none => snapshot.trace.modify (·.map fun _ => { complete := false })\\n    pure result\\n\\ndef decodeBlob (bytes : ByteArray) : Except String Blob := do\\n  let (blob, tail) ← blobCodec.decode bytes.toList\\n  unless tail.isEmpty do throw \\\"trailing bytes in body descriptor\\\"\\n  unless (blobCodec.encode blob).toByteArray == bytes do throw \\\"noncanonical body descriptor\\\"\\n  pure blob\\n\\ndef Snapshot.readPinnedBlob (snapshot : Snapshot) (pinned : PinnedBlob snapshot.head) :\\n    IO ByteArray := do\\n  let blob := pinned.ref\\n  let count : FileSystem.ReadSize := ⟨blob.bytes, pinned.bounded⟩\\n  let bytes ← FileSystem.readPage snapshot.handle blob.offset.toUInt64 count\\n  unless bytes.size == blob.bytes && digest bytes == blob.checksum do\\n    throw (IO.userError \\\"corrupted or truncated body chunk\\\")\\n  snapshot.reads.modify (· + 1)\\n  snapshot.readBytes.modify (· + bytes.size)\\n  snapshot.observe (.blob blob)\\n  pure bytes\\n\\ndef Snapshot.readBlob (snapshot : Snapshot) (blob : Blob) : IO ByteArray := do\\n  let some pinned := blob.pin? snapshot.head |\\n    throw (IO.userError \\\"body chunk is outside its pinned extent or exceeds its budget\\\")\\n  snapshot.readPinnedBlob pinned\\n\\n/-- Disabling capture uses a separate observer, never a mutable toggle on a\\nreader shared with another calculation. Physical IO counters remain shared. -/\\nstructure QuietReader (origin : Snapshot) where\\n  snapshot : Snapshot\\n  sameDirectory : snapshot.directory = origin.directory\\n  sameHead : snapshot.head = origin.head\\n  sameHandle : snapshot.handle = origin.handle\\n  sameCounts : snapshot.reads = origin.reads ∧ snapshot.readBytes = origin.readBytes\\n\\ndef QuietReader.make (origin : Snapshot) : IO (QuietReader origin) := do\\n  let trace ← IO.mkRef (none : Option ReadTrace)\\n  pure ⟨{origin with trace}, rfl, rfl, rfl, rfl, rfl⟩\\n\\nstructure HistoryReader (origin : Snapshot) (basis : Head) where\\n  snapshot : Snapshot\\n  pinned : snapshot.head = basis\\n  sameHandle : snapshot.handle = origin.handle\\n  sameIdentity : origin.head.identity = basis.identity\\n  retained : basis.bytes ≤ origin.head.bytes\\n\\ndef HistoryReader.make? (origin : Snapshot) (basis : Head) :\\n    IO (Option (HistoryReader origin basis)) := do\\n  if valid : origin.head.identity = basis.identity ∧ origin.head.authority = basis.authority ∧\\n      basis.revision ≤ origin.head.revision ∧ magic.size ≤ basis.bytes ∧\\n      basis.bytes ≤ origin.head.bytes then\\n    let trace ← IO.mkRef (none : Option ReadTrace)\\n    pure (some ⟨{origin with head := basis, trace}, rfl, rfl, valid.1, valid.2.2.2.2⟩)\\n  else pure none\\n\\ndef HistoryReader.retainBlob {origin : Snapshot} {basis : Head} (reader : HistoryReader origin basis)\\n    (pinned : PinnedBlob basis) : PinnedBlob origin.head :=\\n  ⟨pinned.ref, pinned.nonempty, pinned.bounded, pinned.afterMagic,\\n    Nat.le_trans pinned.committed reader.retained⟩\\n\\ntheorem HistoryReader.retains_exact_reference {origin : Snapshot} {basis : Head}\\n    (reader : HistoryReader origin basis)\\n    (pinned : PinnedBlob basis) : (reader.retainBlob pinned).ref = pinned.ref := rfl\\n\\ndef payloadChunkKey (payloadKey : String) (chunk : Nat) : String := payloadKey ++ \\\":\\\" ++ toString chunk\\n\\ndef payloadSize (row : Option ByteArray) : Except String Nat := do\\n  let some bytes := row | throw \\\"missing node byte count\\\"\\n  let (size, tail) ← Wire.natural.decode bytes.data.toList\\n  if tail = [] ∧ (Wire.natural.encode size).toByteArray = bytes then pure size\\n  else throw \\\"trailing or noncanonical node byte count\\\"\\n\\n/-- A constant-size dependency names its complete ordered read program. The\\nold root keeps the original descriptors, including all chunk checksums. -/\\ndef Snapshot.readPayloadUsing (snapshot : Snapshot) (read : String → IO (Option ByteArray))\\n    (payloadKey : String) : IO ByteArray := do\\n  let size ← IO.ofExcept (payloadSize (← read payloadKey))\\n  let mut bytes := ByteArray.empty\\n  for chunk in [:((size + 4095) / 4096)] do\\n    let some encoded ← read (payloadChunkKey payloadKey chunk) |\\n      throw (IO.userError \\\"missing node chunk\\\")\\n    let part ← snapshot.readBlob (← IO.ofExcept (decodeBlob encoded))\\n    unless part.size == min 4096 (size - chunk * 4096) do\\n      throw (IO.userError \\\"invalid node chunk size\\\")\\n    bytes := bytes ++ part\\n  pure bytes\\n\\ndef Snapshot.readPayload (snapshot : Snapshot) (payloadKey : String) : IO ByteArray := do\\n  let quiet ← QuietReader.make snapshot\\n  let bytes ← quiet.snapshot.readPayloadUsing quiet.snapshot.get payloadKey\\n  snapshot.observe (.payload payloadKey bytes.size ((bytes.size + 4095) / 4096))\\n  pure bytes\\n\\n/-- Short-circuit validation is the complete ordered chunk domain. The\\nruntime recursion keeps no list of chunk positions or descriptors. -/\\ndef checkPayloadChunks (check : Nat → IO Bool) (first : Nat) : Nat → IO Bool\\n  | 0 => pure true\\n  | count + 1 => do\\n      if ← check first then checkPayloadChunks check (first + 1) count else pure false\\n\\ntheorem checkPayloadChunks_full_domain (check : Nat → IO Bool) (first count : Nat) :\\n    checkPayloadChunks check first count = (List.range' first count).allM check := by\\n  induction count generalizing first with\\n  | zero => simp [checkPayloadChunks]\\n  | succ count ih => simp [checkPayloadChunks, List.range'_succ, ih]\\n\\n/-- The observer cannot invent a completed comparison or an empty failing\\nprefix. Only the actual ordered checker constructs this consumption result. -/\\nstructure CheckedPrefix (count : Nat) where\\n  checked : Nat\\n  accepted : Bool\\n  bounded : checked ≤ count\\n  complete : accepted = true → checked = count\\n  stopped : accepted = false → 0 < checked\\n\\n/-- Tail recursion retains one position counter, never a chunk/position list\\nor one return frame per consumed chunk. The erased equality ties the counter\\nto the remaining domain in every executed recursive call. -/\\ndef checkPrefixLoop (check : Nat → IO Bool) (first total checked : Nat) :\\n    (remaining : Nat) → (exact : checked + remaining = total) → IO (CheckedPrefix total)\\n  | 0, exact => pure ⟨checked, true, by omega, fun _ => by omega, by simp⟩\\n  | remaining + 1, exact => do\\n      if ← check (first + checked) then\\n        checkPrefixLoop check first total (checked + 1) remaining (by omega)\\n      else pure ⟨checked + 1, false, by omega, by simp, fun _ => by omega⟩\\n\\ndef checkPrefix (check : Nat → IO Bool) (first count : Nat) : IO (CheckedPrefix count) :=\\n  checkPrefixLoop check first count 0 count (by omega)\\n\\n/- IO's EST representation has no library LawfulMonad instance. Establish\\nthese laws from its actual state/error operations, locally to this refinement;\\nno callback is assumed pure and no effect or exception is erased. -/\\nprivate theorem lawfulIO : LawfulMonad IO := .mk'\\n  (id_map := fun x => funext fun s => by\\n    change EST.bind x (fun a => EST.pure (id a)) s = x s\\n    simp only [EST.bind]\\n    cases x s <;> rfl)\\n  (pure_bind := fun _ _ => rfl)\\n  (bind_assoc := fun x f g => funext fun s => by\\n    change EST.bind (EST.bind x f) g s = EST.bind x (fun a => EST.bind (f a) g) s\\n    simp only [EST.bind]\\n    cases x s <;> rfl)\\n  (map_const := fun _ _ => rfl)\\n\\ntheorem checkPrefixLoop_exact (check : Nat → IO Bool) (first total checked remaining : Nat)\\n    (exact : checked + remaining = total) :\\n    (fun result => result.accepted) <$> checkPrefixLoop check first total checked remaining exact =\\n      checkPayloadChunks check (first + checked) remaining := by\\n  letI := lawfulIO\\n  induction remaining generalizing checked with\\n  | zero => simp [checkPrefixLoop, checkPayloadChunks]\\n  | succ remaining ih =>\\n      simp only [checkPrefixLoop, checkPayloadChunks, map_bind]\\n      congr 1\\n      funext accepted\\n      cases accepted <;> simp [ih, Nat.add_assoc]\\n\\ntheorem checkPrefix_exact (check : Nat → IO Bool) (first count : Nat) :\\n    (fun result => result.accepted) <$> checkPrefix check first count =\\n      (List.range' first count).allM check := by\\n  rw [checkPrefix, checkPrefixLoop_exact]\\n  simpa using checkPayloadChunks_full_domain check first count\\n\\nstructure PayloadPrefix (bytes : Nat) where\\n  chunks : Nat\\n  bounded : chunks ≤ (bytes + 4095) / 4096\\n\\ndef PayloadPrefix.check? (bytes chunks : Nat) : Option (PayloadPrefix bytes) :=\\n  if bounded : chunks ≤ (bytes + 4095) / 4096 then some ⟨chunks, bounded⟩ else none\\n\\ntheorem PayloadPrefix.outside_rejected (bytes chunks : Nat)\\n    (outside : (bytes + 4095) / 4096 < chunks) : PayloadPrefix.check? bytes chunks = none := by\\n  simp [check?, show ¬chunks ≤ (bytes + 4095) / 4096 by omega]\\n\\ndef Snapshot.checkPayload? (snapshot : Snapshot) (basis : Head)\\n    (payloadKey : String) (size chunks : Nat) : IO Bool := do\\n  let some domain := PayloadPrefix.check? size chunks | return false\\n  let some history ← HistoryReader.make? snapshot basis | return false\\n  let quiet ← QuietReader.make snapshot\\n  let old := history.snapshot\\n  let now := quiet.snapshot\\n  let expected := some (Wire.natural.encode size).toByteArray\\n  if (← old.get payloadKey) != expected || (← now.get payloadKey) != expected then return false\\n  checkPayloadChunks (fun chunk => do\\n    let before ← old.get (payloadChunkKey payloadKey chunk)\\n    let after ← now.get (payloadChunkKey payloadKey chunk)\\n    unless before == after do return false\\n    let some encoded := before | return false\\n    let ref ← IO.ofExcept (decodeBlob encoded)\\n    let some pinned := ref.pin? basis |\\n      throw (IO.userError \\\"body chunk is outside its pinned extent or exceeds its budget\\\")\\n    let retained : PinnedBlob now.head := quiet.sameHead.symm ▸ history.retainBlob pinned\\n    let part ← now.readPinnedBlob retained\\n    pure (part.size == min 4096 (size - chunk * 4096))) 0 domain.chunks\\n\\nstructure RangeProgress (expected : List Row) where\\n  seen : List Row\\n  remaining : List Row\\n  exact : seen.reverse ++ remaining = expected\\n\\ndef RangeProgress.start (expected : List Row) : RangeProgress expected := ⟨[], expected, rfl⟩\\n\\n/-- A streaming range certificate cannot skip, duplicate or reorder a row.\\nAn extra row, including the first new row in a previously empty interval,\\nis rejected before the rest of that interval can be loaded. -/\\ndef RangeProgress.step? (progress : RangeProgress expected) (row : Row) :\\n    Option (RangeProgress expected) :=\\n  match rest : progress.remaining with\\n  | [] => none\\n  | head :: tail =>\\n      if same : head = row then\\n        some ⟨row :: progress.seen, tail, by\\n          simpa only [List.reverse_cons, List.append_assoc, List.singleton_append, ← same, ← rest]\\n            using progress.exact⟩\\n      else none\\n\\ndef RangeProgress.finish? (progress : RangeProgress expected) :\\n    Option { rows : List Row // rows = expected } :=\\n  if done : progress.remaining = [] then\\n    some ⟨progress.seen.reverse, by simpa only [done, List.append_nil] using progress.exact⟩\\n  else none\\n\\ntheorem RangeProgress.unexpected_rejected (progress : RangeProgress expected) (row : Row)\\n    (unexpected : progress.remaining.head? ≠ some row) : progress.step? row = none := by\\n  unfold step?\\n  split\\n  · rfl\\n  · rename_i head tail rest\\n    have different : head ≠ row := by\\n      intro same\\n      simp [rest, same] at unexpected\\n    simp only [dif_neg different]\\n\\n/-- Demand validation short-circuits at the first changed row. A normal new\\nmatch is a typed miss, not an IO failure. Invalid pages still fail through\\nthe same checked immutable reader used by the complete range traversal. -/\\ndef Snapshot.checkRangeAt? (snapshot : Snapshot) (ref : Ref) (range : KeyRange)\\n    (progress : RangeProgress expected) : IO (Option (RangeProgress expected)) := do\\n  let loaded ← snapshot.load ref\\n  unless range.overlaps ref do return some progress\\n  match loaded.page with\\n  | .leaf rows =>\\n      let mut progress := progress\\n      for row in range.select rows do\\n        let some next := progress.step? row | return none\\n        progress := next\\n      pure (some progress)\\n  | .branch children =>\\n      let mut progress := progress\\n      for child in children do\\n        if range.overlaps child then\\n          if _smaller : child.height < ref.height then\\n            let some next ← snapshot.checkRangeAt? child range progress | return none\\n            progress := next\\n          else throw (IO.userError \\\"range index height did not decrease\\\")\\n      pure (some progress)\\ntermination_by ref.height\\n\\n/-- Every observed point, complete key interval and payload is rechecked on\\none immutable current snapshot. Checking a range includes new matches and\\nabsence; checking a blob validates its full bytes and checksum. -/\\ndef Snapshot.checkObservation? (snapshot : Snapshot) (basis : Head) (expected : ReadObservation) :\\n    IO (Option { observed : ReadObservation // observed = expected }) := do\\n  let actual ← match expected with\\n    | .point key _ => pure (.point key (← snapshot.get key))\\n    | .range lower upper rows =>\\n        let progress ← match snapshot.head.root with\\n          | none => pure (some (RangeProgress.start rows))\\n          | some ref => snapshot.checkRangeAt? ref ⟨lower, upper⟩ (RangeProgress.start rows)\\n        let some progress := progress | return none\\n        let some actual := progress.finish? | return none\\n        pure (.range lower upper actual.val)\\n    | .blob ref =>\\n        let _ ← snapshot.readBlob ref\\n        pure (.blob ref)\\n    | .payload payloadKey size chunks =>\\n        unless ← snapshot.checkPayload? basis payloadKey size chunks do return none\\n        pure (.payload payloadKey size chunks)\\n  pure (expected.check? actual)\\n\\nstructure VerifiedReads (head basis : Head) (expected : List ReadObservation) where\\n  sameIdentity : head.identity = basis.identity\\n  actual : List ReadObservation\\n  exact : actual = expected\\n\\ndef Snapshot.verifyReadOperations? (snapshot : Snapshot) (basis : Head)\\n    (sameIdentity : snapshot.head.identity = basis.identity) :\\n    (expected : List ReadObservation) → IO (Option (VerifiedReads snapshot.head basis expected))\\n  | [] => pure (some ⟨sameIdentity, [], rfl⟩)\\n  | expected :: rest => do\\n      let some head ← snapshot.checkObservation? basis expected | return none\\n      let some tail ← snapshot.verifyReadOperations? basis sameIdentity rest | return none\\n      pure (some ⟨sameIdentity, head.val :: tail.actual, by rw [head.property, tail.exact]⟩)\\n\\n/-- Physical references have meaning only in their original file incarnation.\\nStore the identity once per source; a foreign DB must be rejected even if an\\noffset, length, checksum and all body bytes happen to be identical. -/\\ndef Snapshot.verifyReads? (snapshot : Snapshot) (basis : Head)\\n    (expected : List ReadObservation) : IO (Option (VerifiedReads snapshot.head basis expected)) :=\\n  if sameIdentity : snapshot.head.identity = basis.identity then\\n    snapshot.verifyReadOperations? basis sameIdentity expected\\n  else pure none\\n\\ntheorem foreign_read_identity_rejected (snapshot : Snapshot) (basis : Head)\\n    (expected : List ReadObservation) (different : snapshot.head.identity ≠ basis.identity) :\\n    snapshot.verifyReads? basis expected = pure none := by\\n  simp [Snapshot.verifyReads?, different]\\n\\n/-- Derived query rows have one reserved namespace. The graph publisher's\\nempty-delta claim is checked against actual writes, including already-flushed\\npages. It cannot infer neutrality from an empty remaining pending buffer. -/\\ndef derivedKey (key : String) : Bool := key.startsWith \\\"memo:\\\"\\n\\ndef derivedStep (onlyDerived : Bool) (key : String) : Bool :=\\n  onlyDerived && derivedKey key\\n\\n@[simp] theorem derivedStep_false (key : String) : derivedStep false key = false := rfl\\n\\n/-- The writer only retains this monotone bit; flush does not reset it. The\\nequivalence covers the complete edit sequence without retaining that sequence\\nor searching already-written pages at publication time. -/\\ntheorem derived_trace_exact (rows : List Row) (before : Bool) :\\n    rows.foldl (fun flag row => derivedStep flag row.1) before = true ↔\\n      before = true ∧ rows.all (fun row => derivedKey row.1) = true := by\\n  induction rows generalizing before with\\n  | nil => simp\\n  | cons head tail ih =>\\n    rw [List.foldl_cons, ih]\\n    simp only [derivedStep, Bool.and_eq_true, List.all_cons, and_assoc]\\n\\ndef applyRows (rows : List Row) (before : String → Option ByteArray) : String → Option ByteArray :=\\n  rows.foldl (fun state row query => if query = row.1 then row.2 else state query) before\\n\\n/-- The actual row-update algebra, including overwrite and deletion. A\\nderived-only trace preserves every other key, not just positive graph hits. -/\\ntheorem derived_rows_preserve (rows : List Row) (before : String → Option ByteArray)\\n    (onlyDerived : rows.all (fun row => derivedKey row.1) = true)\\n    (key : String) (outside : derivedKey key = false) :\\n    applyRows rows before key = before key := by\\n  induction rows generalizing before with\\n  | nil => rfl\\n  | cons head tail ih =>\\n    have parts : derivedKey head.1 = true ∧\\n        tail.all (fun row => derivedKey row.1) = true := by simpa using onlyDerived\\n    have permitted := parts.1\\n    have different : key ≠ head.1 := by\\n      intro same\\n      rw [same, permitted] at outside\\n      cases outside\\n    simpa only [applyRows, List.foldl_cons, different, ↓reduceIte] using\\n      ih (fun query => if query = head.1 then head.2 else before query)\\n        parts.2\\n\\ntheorem derived_trace_preserve (rows : List Row) (before : String → Option ByteArray)\\n    (accepted : rows.foldl (fun flag row => derivedStep flag row.1) true = true)\\n    (key : String) (outside : derivedKey key = false) :\\n    applyRows rows before key = before key :=\\n  derived_rows_preserve rows before ((derived_trace_exact rows true).mp accepted).2 key outside\\n\\nstructure Writer where\\n  base : Snapshot\\n  handle : FileSystem.AppendHandle\\n  extent : IO.Ref Nat\\n  written : IO.Ref Nat\\n  root : IO.Ref (Option Ref)\\n  failed : IO.Ref Bool\\n  pending : IO.Ref (Std.TreeMap String (Option ByteArray))\\n  onlyDerived : IO.Ref Bool\\n  journalSealed : IO.Ref Bool\\n\\n/-- Newly appended pages may be read through the same opened file object;\\nonly this writer owns their uncommitted extent. Readers retain the old head. -/\\ndef Writer.snapshot (writer : Writer) : IO Snapshot := do\\n  pure { writer.base with head := { writer.base.head with bytes := ← writer.extent.get } }\\n\\ndef Writer.appendBlob (writer : Writer) (bytes : ByteArray)\\n    (_nonempty : 0 < bytes.size) (_bounded : bytes.size ≤ 4096) : IO Blob := do\\n  if ← writer.failed.get then throw (IO.userError \\\"DB writer requires recovery\\\")\\n  let blob : Blob := ⟨← writer.extent.get, bytes.size, digest bytes⟩\\n  try\\n    FileSystem.appendAt writer.handle blob.offset.toUInt64 bytes\\n    writer.extent.modify (· + bytes.size)\\n    writer.written.modify (· + bytes.size)\\n    pure blob\\n  catch error => writer.failed.set true; throw error\\n\\ndef Writer.appendPage (writer : Writer) (page : Page) : IO Ref := do\\n  if ← writer.failed.get then throw (IO.userError \\\"DB writer requires recovery\\\")\\n  let bytes := encode page\\n  unless 0 < bytes.size && bytes.size ≤ 65536 do throw (IO.userError \\\"DB page exceeds budget\\\")\\n  let (first, last, height, rows) ← match page with\\n    | .leaf rows =>\\n        let some first := rows.head? | throw (IO.userError \\\"empty leaf\\\")\\n        let some last := rows.getLast? | throw (IO.userError \\\"empty leaf\\\")\\n        pure (first.1, last.1, 0, rows.length)\\n    | .branch refs =>\\n        let some first := refs.head? | throw (IO.userError \\\"empty branch\\\")\\n        let some last := refs.getLast? | throw (IO.userError \\\"empty branch\\\")\\n        pure (first.first, last.last, first.height + 1, (refs.map (·.rows)).sum)\\n  let ref : Ref := ⟨← writer.extent.get, bytes.size, digest bytes, first, last, height, rows⟩\\n  unless agrees ref page do throw (IO.userError \\\"invalid page ordering or child heights\\\")\\n  try\\n    FileSystem.appendAt writer.handle ref.offset.toUInt64 bytes\\n    writer.extent.modify (· + bytes.size)\\n    writer.written.modify (· + bytes.size)\\n    pure ref\\n  catch error => writer.failed.set true; throw error\\n\\n/- Check cardinality before invoking the list-based wire encoder. A bulk\\npublication must not allocate an encoding of its entire pending map merely\\nto discover that it does not fit one page. This is a writer policy, not a\\nreader format limit; all input rows are retained by the existing split. -/\\ndef leafFits (rows : List Row) : Bool :=\\n  if rows.length ≤ 128 then decide ((encode (.leaf rows)).size ≤ 8192) else false\\n\\ntheorem leaf_fits_bounded_rows (rows : List Row) (fits : leafFits rows = true) :\\n    rows.length ≤ 128 := by\\n  by_cases bounded : rows.length ≤ 128\\n  · exact bounded\\n  · simp [leafFits,bounded] at fits\\n\\ntheorem leaf_fits_bounded_bytes (rows : List Row) (fits : leafFits rows = true) :\\n    (encode (.leaf rows)).size ≤ 8192 := by\\n  have bounded := leaf_fits_bounded_rows rows fits\\n  simpa [leafFits,bounded] using fits\\n\\ntheorem large_leaf_splits (rows : List Row) (large : 128 < rows.length) :\\n    leafFits rows = false := by simp [leafFits,Nat.not_le_of_lt large]\\n\\ndef Writer.leaves (writer : Writer) (rows : List Row) : IO (List Ref) := do\\n  let page := Page.leaf rows\\n  if leafFits rows then pure [← writer.appendPage page]\\n  else\\n    if _splittable : rows.length > 1 then\\n      let middle := rows.length / 2\\n      let left ← writer.leaves (rows.take middle)\\n      let right ← writer.leaves (rows.drop middle)\\n      pure (left ++ right)\\n    else throw (IO.userError \\\"one indexed row exceeds page budget; chunk its payload\\\")\\ntermination_by rows.length\\n\\n/-- Directory fanout is bounded regardless of the number of rows in a batch. -/\\ndef Writer.branches (writer : Writer) (children : List Ref) : IO (List Ref) := do\\n  if _bounded : children.length ≤ 32 then pure [← writer.appendPage (.branch children)]\\n  else\\n    let first ← writer.appendPage (.branch (children.take 32))\\n    pure (first :: (← writer.branches (children.drop 32)))\\ntermination_by children.length\\n\\n/-- Linear merge of two unique ordered row lists. Pending edits never\\nserialize a partially filled leaf once per term or chunk. -/\\ndef lookup (rows : List Row) (key : String) : Option (Option ByteArray) :=\\n  (rows.find? fun row => row.1 == key).map (·.2)\\n\\ndef mergeRows (newer older : List Row) : List Row :=\\n  match newer, older with\\n  | [], rows | rows, [] => rows\\n  | n :: ns, o :: os =>\\n      match compare n.1 o.1 with\\n      | .lt => n :: mergeRows ns (o :: os)\\n      | .eq => n :: mergeRows ns os\\n      | .gt => o :: mergeRows (n :: ns) os\\ntermination_by newer.length + older.length\\n\\nprivate theorem lookup_cons (row : Row) (rest : List Row) (key : String) :\\n    lookup (row :: rest) key = if row.1 == key then some row.2 else lookup rest key := by\\n  by_cases hit : row.1 == key <;> simp [lookup, hit]\\n\\nprivate theorem absent_before (rows : List Row) (key : String)\\n    (before : ∀ row ∈ rows, compare key row.1 = .lt) : lookup rows key = none := by\\n  unfold lookup\\n  have absent : rows.find? (fun row => row.1 == key) = none := by\\n    apply List.find?_eq_none.mpr\\n    intro row member hit\\n    have same : row.1 = key := by simpa using hit\\n    have impossible := before row member\\n    simp [same] at impossible\\n  rw [absent]; rfl\\n\\n/-- Pending edits replace the current row even when the edit removes it.\\nThe nested Option distinguishes a deletion from an absent pending edit. -/\\ntheorem merge_lookup (newer older : List Row)\\n    (sorted : newer.Pairwise (fun a b => compare a.1 b.1 = .lt)) (key : String) :\\n    lookup (mergeRows newer older) key = (lookup newer key).or (lookup older key) := by\\n  induction newer generalizing older with\\n  | nil => simp [mergeRows, lookup]\\n  | cons n ns ih =>\\n    obtain ⟨afterHead, sortedTail⟩ := List.pairwise_cons.mp sorted\\n    induction older with\\n    | nil => simp [mergeRows, lookup]\\n    | cons o os io =>\\n      rw [mergeRows]\\n      split\\n      · rw [lookup_cons, ih _ sortedTail]\\n        simp only [lookup_cons]\\n        by_cases hit : n.1 == key <;> simp [hit]\\n      · rename_i same\\n        have equal : n.1 = o.1 := compare_eq_iff_eq.mp same\\n        rw [lookup_cons, ih _ sortedTail]\\n        simp only [lookup_cons, equal]\\n        by_cases hit : o.1 == key <;> simp [hit]\\n      · rename_i before\\n        have less : compare o.1 n.1 = .lt := Std.OrientedCmp.lt_of_gt before\\n        have absent : lookup (n :: ns) o.1 = none := absent_before _ _ (by\\n          intro row member\\n          rcases List.mem_cons.mp member with equal | member\\n          · subst row; exact less\\n          · exact Std.TransCmp.lt_of_lt_of_isLE less (by rw [afterHead row member]; decide))\\n        rw [lookup_cons, io, lookup_cons o]\\n        by_cases hit : o.1 == key\\n        · have equal : o.1 = key := by simpa using hit\\n          rw [equal] at absent\\n          simp [hit, absent]\\n        · simp [hit]\\n\\ndef Writer.putManyAt (writer : Writer) (ref : Ref) (edits : List Row) : IO (List Ref) := do\\n  if edits.isEmpty then return [ref]\\n  let snapshot ← writer.snapshot\\n  match (← snapshot.load ref).page with\\n  | .leaf rows =>\\n      unless ordered edits do throw (IO.userError \\\"unordered edit batch\\\")\\n      let updated := mergeRows edits rows\\n      if updated == rows then return [ref]\\n      writer.leaves updated\\n  | .branch children =>\\n      let mut updated : List Ref := []\\n      for (child, index) in children.zipIdx do\\n        let selected := edits.filter fun edit => (route children edit.1).map (·.1) == some index\\n        if _smaller : child.height < ref.height then\\n          updated := updated ++ (← writer.putManyAt child selected)\\n        else throw (IO.userError \\\"index height did not decrease\\\")\\n      if updated == children then return [ref]\\n      writer.branches updated\\ntermination_by ref.height\\n\\n/-- All roots at this boundary have the same height. Grouping increases the\\nheight while reducing the number of roots, until there is exactly one. -/\\ndef Writer.finishRoots (writer : Writer) (roots : List Ref) : IO Ref := do\\n  if roots.length ≤ 1 then\\n    let some root := roots.head? | throw (IO.userError \\\"empty update roots\\\")\\n    pure root\\n  else\\n    let next ← writer.branches roots\\n    if _decreases : next.length < roots.length then writer.finishRoots next\\n    else throw (IO.userError \\\"directory grouping did not progress\\\")\\ntermination_by roots.length\\n\\ndef Writer.flush (writer : Writer) : IO Unit := do\\n  let edits := (← writer.pending.get).toList\\n  if edits.isEmpty then return\\n  let roots ← match ← writer.root.get with\\n    | none => writer.leaves edits\\n    | some root => writer.putManyAt root edits\\n  writer.root.set (some (← writer.finishRoots roots))\\n  writer.pending.set {}\\n\\ndef Writer.put (writer : Writer) (key : String) (value : Option ByteArray) : IO Unit := do\\n  unless key.toUTF8.size ≤ 1024 do throw (IO.userError \\\"index key exceeds its page budget\\\")\\n  if ← writer.journalSealed.get then\\n    throw (IO.userError \\\"index write after the change journal was sealed\\\")\\n  writer.onlyDerived.modify (derivedStep · key)\\n  writer.pending.modify (·.insert key value)\\n\\ndef Writer.get (writer : Writer) (key : String) : IO (Option ByteArray) := do\\n  match (← writer.pending.get)[key]? with\\n  | some value => pure value\\n  | none =>\\n      let snapshot ← writer.snapshot\\n      ({ snapshot with head := { snapshot.head with root := ← writer.root.get } }).get key\\n\\n/-- Caller holds the authority's writer guard. Recovery discards only bytes\\nbeyond the currently published extent, never any pinned-reader interval. -/\\nprivate def withWriterLocked (snapshot : Snapshot) (action : Writer → IO α) : IO (α × Head × Nat) := do\\n  let current ← pin snapshot.directory\\n  unless current.head == snapshot.head do throw (IO.userError \\\"stale DB writer snapshot\\\")\\n  let handle ← FileSystem.openAppend (dataPath snapshot.directory snapshot.head).toString\\n  try\\n    let actual ← FileSystem.readVersion snapshot.handle\\n    if actual.bytes > snapshot.head.bytes then\\n      FileSystem.truncateAppend handle actual.bytes.toUInt64 snapshot.head.bytes.toUInt64\\n    let writer : Writer := ⟨snapshot, handle, ← IO.mkRef snapshot.head.bytes,\\n      ← IO.mkRef 0, ← IO.mkRef snapshot.head.root, ← IO.mkRef false, ← IO.mkRef {},\\n      ← IO.mkRef true, ← IO.mkRef false⟩\\n    let result ← action writer\\n    writer.flush\\n    if ← writer.failed.get then throw (IO.userError \\\"failed DB update cannot publish\\\")\\n    let root ← writer.root.get\\n    if root == snapshot.head.root then return (result, snapshot.head, 0)\\n    let bytes ← writer.extent.get\\n    let head : Head := { snapshot.head with\\n      root := root\\n      bytes := bytes\\n      revision := snapshot.head.revision + 1 }\\n    let header := (toJson head).compress.toUTF8\\n    unless header.size ≤ 16384 do throw (IO.userError \\\"DB head exceeds metadata budget\\\")\\n    FileSystem.syncAppend handle\\n    FileSystem.atomicBytes (snapshot.directory / \\\"head\\\") header\\n    pure (result, head, ← writer.written.get)\\n  finally FileSystem.closeAppend handle\\n\\n/-- Ownership is acquired before reading the recovery extent. A raw caller\\ncannot race another writer's publication and then truncate its committed tail.\\nReaders hold no writer lock. OS descriptor/lock semantics are native premises. -/\\nopaque withWriter (snapshot : Snapshot) (action : Writer → IO α) : IO (α × Head × Nat) := do\\n  let guard ← FileSystem.openRead (snapshot.directory / \\\"writer\\\").toString\\n  unless ← FileSystem.tryReadLock guard true do throw (IO.userError \\\"DB writer is busy\\\")\\n  try withWriterLocked snapshot action\\n  finally FileSystem.unlockRead guard\\n\\n/-- Creation uses stable random authority identity, independent of placement.\\nThere is no regular-file compatibility fallback. -/\\ndef create (directory : System.FilePath) (authority : String) : IO Snapshot := do\\n  let directory ← absolute directory\\n  if (← FileSystem.symlinkMetadata? directory).isSome then\\n    throw (IO.userError \\\"memory DB already exists\\\")\\n  let parent := directory.parent.getD \\\"/\\\"\\n  FileSystem.durableDirectory parent\\n  let temporary := parent / s!\\\".eggshell-create-{← IO.Process.getPID}-{← IO.monoNanosNow}\\\"\\n  if (← FileSystem.symlinkMetadata? temporary).isSome then throw (IO.userError \\\"DB creation temporary exists\\\")\\n  FileSystem.durableDirectory temporary\\n  try\\n    let head : Head := ⟨Blake3.hex (← IO.getRandomBytes 32), authority, 0, magic.size, none⟩\\n    FileSystem.immutableBytes (dataPath temporary head) magic\\n    FileSystem.immutableBytes (temporary / \\\"writer\\\") ByteArray.empty\\n    let header := (toJson head).compress.toUTF8\\n    unless header.size ≤ 16384 do throw (IO.userError \\\"DB head exceeds metadata budget\\\")\\n    FileSystem.immutableBytes (temporary / \\\"head\\\") header\\n    FileSystem.publishDirectory temporary.toString directory.toString\\n  finally\\n    if (← FileSystem.symlinkMetadata? temporary).isSome then IO.FS.removeDirAll temporary\\n  pin directory\\n\\nend Eggshell.DB.PageMap\\n\"],[\"DB/Sidecar.lean\",\"module\\n\\npublic import Eggshell.DB.PageMap\\npublic import Eggshell.Paths\\n\\n@[expose] public section\\n\\nnamespace Eggshell.DB\\n\\ninductive Sidecar.Storage where\\n  | database\\n  | user\\n  deriving Repr, BEq, Lean.ToJson, Lean.FromJson\\n\\nstructure Sidecar.Owner where\\n  directory : String\\n  database : String\\n  deriving Repr, BEq, Lean.ToJson, Lean.FromJson\\n\\ndef Sidecar.Owner.ofSnapshot (snapshot : PageMap.Snapshot) : Sidecar.Owner :=\\n  ⟨snapshot.directory.toString, snapshot.head.identity⟩\\n\\ndef Sidecar.Owner.pin (owner : Sidecar.Owner) : IO PageMap.Snapshot := do\\n  let path := System.FilePath.mk owner.directory\\n  unless path.isAbsolute do throw (IO.userError \\\"DB owner must have an absolute directory\\\")\\n  let snapshot ← PageMap.pin path\\n  unless snapshot.head.identity == owner.database do\\n    throw (IO.userError \\\"numerical work belongs to a different DB incarnation\\\")\\n  pure snapshot\\n\\n/-- Rebuildable data belongs to the DB incarnation, outside its page map.\\nMoving/copying the DB retains it; removing the DB removes it with the owner. -/\\nstructure Sidecar where\\n  database : String\\n  directory : System.FilePath\\n  semantic : System.FilePath\\n  indexes : System.FilePath\\n\\ndef Sidecar.ofSnapshot (snapshot : PageMap.Snapshot) : Sidecar :=\\n  let directory := snapshot.directory / \\\"derived\\\" / snapshot.head.identity\\n  { database := snapshot.head.identity, directory,\\n    semantic := directory / \\\"semantic\\\", indexes := directory / \\\"indexes\\\" }\\n\\ndef Sidecar.locate (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Sidecar := do\\n  if storage == .database then return Sidecar.ofSnapshot snapshot\\n  let directory := (← Paths.dataRoot) / \\\"read-cache\\\" / snapshot.head.identity\\n  pure {\\n    database := snapshot.head.identity, directory\\n    semantic := directory / \\\"semantic\\\", indexes := directory / \\\"indexes\\\"}\\n\\n/-- Create one child, never missing ancestors or the DB itself. -/\\ndef Sidecar.childDirectory (parent : System.FilePath) (name : String) : IO System.FilePath := do\\n  let path := parent / name\\n  FileSystem.rejectSymlinkAncestors path\\n  let created ← try IO.FS.createDir path; pure true\\n    catch error => do\\n      let metadata ← try path.symlinkMetadata catch _ => throw error\\n      unless metadata.type == .dir do throw error\\n      pure false\\n  if created then\\n    IO.setAccessRights path {\\n      user := {read := true, write := true, execution := true}, group := {}, other := {} }\\n    FileSystem.syncPath path.toString true\\n    FileSystem.syncPath parent.toString true\\n  pure path\\n\\ndef Sidecar.Owner.routeKey (owner : Sidecar.Owner) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.cache-owner\\\".toUTF8 [(Lean.toJson owner).compress.toUTF8])\\n\\n/-- Registration shares this short claim; retirement takes it exclusively.\\nThe stable installation guard lives outside every reclaimable DB directory. -/\\ndef Sidecar.withCacheClaim (exclusive : Bool) (action : IO α) : IO (Option α) := do\\n  let root ← Paths.dataRoot\\n  FileSystem.rejectSymlinkAncestors root\\n  FileSystem.privateDirectory root\\n  let path := root / \\\"cache-owners.guard\\\"\\n  let guard ← try FileSystem.openRead path.toString catch _ => do\\n    FileSystem.immutableExistingBytes path ByteArray.empty\\n    FileSystem.openRead path.toString\\n  let mut claimed ← FileSystem.tryReadLock guard exclusive\\n  let admissionDeadline := (← IO.monoMsNow) + 25\\n  while !claimed && !exclusive && (← IO.monoMsNow) < admissionDeadline do\\n    IO.sleep 1\\n    claimed ← FileSystem.tryReadLock guard false\\n  unless claimed do return none\\n  try some <$> action\\n  finally FileSystem.unlockRead guard\\n\\ndef Sidecar.recordOwner (directory : System.FilePath) (owner : Sidecar.Owner) : IO Unit := do\\n  let routes ← Sidecar.childDirectory directory \\\"owners\\\"\\n  let path := routes / (owner.routeKey ++ \\\".json\\\")\\n  let bytes := (Lean.toJson owner).compress.toUTF8\\n  unless bytes.size ≤ 65536 do throw (IO.userError \\\"cache owner exceeds metadata bound\\\")\\n  if let some _ ← FileSystem.symlinkMetadata? path then\\n    let previous ← FileSystem.boundedBytes path 65536\\n    if previous == bytes then return\\n    let parsed : Except String Sidecar.Owner := do\\n      let some text := String.fromUTF8? previous | throw \\\"invalid cache owner UTF-8\\\"\\n      Lean.Json.parse text >>= Lean.fromJson?\\n    if let .ok previous := parsed then\\n      if previous.database == owner.database && previous.routeKey == owner.routeKey then\\n        throw (IO.userError \\\"conflicting cache owner digest\\\")\\n    FileSystem.atomicExistingBytes path bytes\\n  else FileSystem.immutableExistingBytes path bytes\\n\\n/-- Reading a shared private overlay registers the currently observed copy.\\nOnly private metadata is written; the shared DB remains read-only. -/\\ndef Sidecar.observe (snapshot : PageMap.Snapshot) : IO Unit := do\\n  let sidecar ← Sidecar.locate snapshot .user\\n  if (← FileSystem.symlinkMetadata? sidecar.directory).isNone then return\\n  let owner := Sidecar.Owner.ofSnapshot snapshot\\n  let recorded ← Sidecar.withCacheClaim false do\\n    let _ ← owner.pin\\n    Sidecar.recordOwner sidecar.directory owner\\n  unless recorded.isSome do throw (IO.userError \\\"private cache retirement is busy\\\")\\n  pure ()\\n\\ndef Sidecar.prepare (owner : Sidecar.Owner) (storage : Sidecar.Storage := .database) : IO Sidecar := do\\n  let snapshot ← owner.pin\\n  let directory ← if storage == .database then do\\n      let derived ← Sidecar.childDirectory snapshot.directory \\\"derived\\\"\\n      Sidecar.childDirectory derived snapshot.head.identity\\n    else do\\n      let prepared ← Sidecar.withCacheClaim false do\\n        let _ ← owner.pin\\n        let root := (← Paths.dataRoot) / \\\"read-cache\\\"\\n        FileSystem.rejectSymlinkAncestors root\\n        FileSystem.privateDirectory root\\n        let directory ← Sidecar.childDirectory root snapshot.head.identity\\n        Sidecar.recordOwner directory owner\\n        pure directory\\n      let some directory := prepared | throw (IO.userError \\\"private cache retirement is busy\\\")\\n      pure directory\\n  let semantic ← Sidecar.childDirectory directory \\\"semantic\\\"\\n  let _ ← Sidecar.childDirectory semantic \\\"vectors\\\"\\n  let indexes ← Sidecar.childDirectory directory \\\"indexes\\\"\\n  pure {database := snapshot.head.identity, directory, semantic, indexes}\\n\\n/-- A profile grants DB writes explicitly. A filesystem refusal redirects\\nonly rebuildable maintenance to the user's DB-identity-scoped overlay. -/\\ndef Sidecar.destination (owner : Sidecar.Owner) (writable : Bool) :\\n    IO (Sidecar.Storage × Sidecar) := do\\n  let _ ← owner.pin\\n  if !writable then return (.user, ← Sidecar.prepare owner .user)\\n  try\\n    let sidecar ← Sidecar.prepare owner\\n    let probe := sidecar.semantic / \\\"vectors\\\" / (\\\".write-\\\" ++ Blake3.hex (← IO.getRandomBytes 16))\\n    let handle ← IO.FS.Handle.mk probe .write\\n    handle.flush\\n    IO.FS.removeFile probe\\n    pure (.database, sidecar)\\n  catch error => match error with\\n    | .permissionDenied _ _ _ => pure (.user, ← Sidecar.prepare owner .user)\\n    | _ => throw error\\n\\n/-- Index and explicit warm share a non-waiting claim; neither takes the DB\\nwriter. An exited owner releases the descriptor lock automatically. -/\\ndef Sidecar.withIndexClaim (owner : Sidecar.Owner) (action : Sidecar → IO α)\\n    (storage : Sidecar.Storage := .database) : IO α := do\\n  let sidecar ← Sidecar.prepare owner storage\\n  let path := sidecar.directory / \\\"index.guard\\\"\\n  FileSystem.immutableExistingBytes path ByteArray.empty\\n  let guard ← FileSystem.openRead path.toString\\n  unless ← FileSystem.tryReadLock guard true do throw (IO.userError \\\"DB indexer is busy\\\")\\n  try action sidecar\\n  finally FileSystem.unlockRead guard\\n\\nend Eggshell.DB\\n\"]]]"],["Eggshell.QuotationContext","[\"module\\npublic import Eggshell.SynapseSource\\npublic import Eggshell.Sha256\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.QuotationContext\\nopen Lean _root_.Eggshell.Synapses.Extraction\\n\\nstructure Source where\\n  raw : String\\n  characters : Array Char\\n  exact : characters = raw.toList.toArray\\n  fingerprint : String\\n  fingerprintExact : fingerprint = Sha256.hex raw.toUTF8\\n\\ndef Source.make (raw : String) : Source := ⟨raw,raw.toList.toArray,rfl,Sha256.hex raw.toUTF8,rfl⟩\\ndef Source.slice (source : Source) (first limit : Nat) : String :=\\n  String.ofList (source.characters.extract first limit).toList\\n\\ntheorem Source.slice_exact (source : Source) (first limit : Nat) :\\n    source.slice first limit = String.ofList (source.raw.toList.drop first |>.take (limit-first)) := by\\n  simp [Source.slice,source.exact]\\n\\ndef encoded (text : String) : String :=\\n  String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast)\\n\\nstructure Projection (source : Source) (text : String) where\\n  characters : Array Char\\n  exact : characters = text.toList.toArray\\n  offsets : Array Nat\\n  count : offsets.size = characters.size+1\\n  lines : Array TextLine\\n  multiline : Bool\\n  first : Nat\\n  limit : Nat\\n\\n/-- A projection is recognized by exact bytes, not by a tool/provider name.\\nJSON member prefixes and a trimmed final newline remain in the containing\\nrecord; the offset map refers only to this checked spelling. -/\\ndef prepare? (source : Source) (first limit : Nat) (text : String) : Option (Projection source text) := do\\n  if first ≥ limit || limit > source.characters.size then none else do\\n    let raw := source.slice first limit\\n    let (base,escaped) ←\\n      if raw == text || raw == text ++ \\\"\\\\n\\\" then some (first,false)\\n      else do\\n        let quoted := (toJson text).compress\\n        if raw == quoted then some (first+1,true)\\n        else if raw == encoded text || raw == encoded (text ++ \\\"\\\\n\\\") then some (first,true)\\n        else if raw.endsWith quoted then some (limit-quoted.length+1,true)\\n        else if !text.isEmpty && raw.endsWith text then some (limit-text.length,false)\\n        else none\\n    let characters := text.toList.toArray\\n    let mut offsets := #[base]\\n    let mut position := base\\n    for character in characters do\\n      position := position + if escaped then (encoded (String.singleton character)).length else 1\\n      offsets := offsets.push position\\n    if position > limit || base < first then none else do\\n      if count : offsets.size = characters.size+1 then\\n        some ⟨characters,rfl,offsets,count,textLines text,text.contains '\\\\n',first,limit⟩\\n      else none\\n\\nstructure Located (source : Source) (quote : String) where\\n  first : Nat\\n  limit : Nat\\n  contextFirst : Nat\\n  contextLimit : Nat\\n  within : contextFirst ≤ first ∧ first < limit ∧ limit ≤ contextLimit ∧\\n    contextLimit ≤ source.characters.size\\n  literal : source.slice first limit = quote ∨ source.slice first limit = encoded quote\\n\\n/-- The enclosing logical rows are already prepared. A multiline quote\\nkeeps every intervening row; this is independent of source language. -/\\ndef row? (lines : Array TextLine) (position : Nat) : Option TextLine := Id.run do\\n  let mut lower := 0\\n  let mut upper := lines.size\\n  while lower < upper do\\n    let middle := lower+(upper-lower)/2\\n    if (lines[middle]?).any (fun line => line.limit ≤ position) then lower := middle+1\\n    else upper := middle\\n  return (lines[lower]?).filter fun line => line.first ≤ position && position < line.limit\\n\\ndef Projection.locate? (projection : Projection source text) (first limit : Nat) :\\n    Option (Located source (String.ofList (projection.characters.extract first limit).toList)) := do\\n  if first ≥ limit || limit > projection.characters.size then none else do\\n    let a ← projection.offsets[first]?\\n    let b ← projection.offsets[limit]?\\n    let (c,d) ← if projection.multiline then do\\n        let start ← row? projection.lines first\\n        let stop ← row? projection.lines (limit-1)\\n        some (← projection.offsets[start.first]?,← projection.offsets[stop.limit]?)\\n      else some (projection.first,projection.limit)\\n    let quote := String.ofList (projection.characters.extract first limit).toList\\n    if within : c ≤ a ∧ a < b ∧ b ≤ d ∧ d ≤ source.characters.size then\\n      if literal : source.slice a b = quote ∨ source.slice a b = encoded quote then\\n        some ⟨a,b,c,d,within,literal⟩ else none\\n    else none\\n\\ntheorem Located.literal_is_original {source : Source} {text : String} (located : Located source text) :\\n    source.slice located.first located.limit = text ∨\\n      source.slice located.first located.limit = encoded text := located.literal\\n\\ntheorem Located.context_contains_match {source : Source} {text : String} (located : Located source text) :\\n    located.contextFirst ≤ located.first ∧ located.limit ≤ located.contextLimit :=\\n  ⟨located.within.1,located.within.2.2.1⟩\\n\\nend Eggshell.Synapses.QuotationContext\\n\",[]]"],["Eggshell.Quotient","[\"module\\n\\npublic import Eggshell.Extract\\npublic import Std.Data.HashMap.Basic\\npublic import Std.Data.HashMap.Lemmas\\n\\n@[expose] public section\\n\\nnamespace Eggshell\\n\\n/-- One checked equivalence class. The producer may be heuristic; this certificate is not. -/\\nstructure EquivalenceClass where\\n  representative : Value\\n  members : List Value\\n  exactAuthority : ∀ member, member ∈ members →\\n    Value.SameExactFootprint member representative\\n\\nnamespace EquivalenceClass\\n\\ndef certify? : List Value → Option EquivalenceClass\\n  | [] => none\\n  | representative :: tail =>\\n      let members := representative :: tail\\n      if accepted : members.all\\n          (fun member => Value.sameExactFootprint member representative) then\\n        some {\\n          representative\\n          members\\n          exactAuthority := by\\n            intro member present\\n            apply Value.sameExactFootprint_sound\\n            exact (List.all_eq_true.mp accepted) member present\\n        }\\n      else none\\n\\nend EquivalenceClass\\n\\nnamespace RepresentativeIndex\\n\\nabbrev T := Std.HashMap Value Value\\n\\ndef Sound (index : T) : Prop :=\\n  ∀ value, Value.SameExactFootprint value (index.getD value value)\\n\\ndef insertMembers (representative : Value) : T → List Value → T\\n  | index, [] => index\\n  | index, member :: tail =>\\n      insertMembers representative (index.insert member representative) tail\\n\\ndef build : T → List EquivalenceClass → T\\n  | index, [] => index\\n  | index, equivalenceClass :: tail =>\\n      build (insertMembers equivalenceClass.representative index equivalenceClass.members) tail\\n\\ntheorem empty_sound : Sound ({} : T) := by\\n  intro value\\n  have lookup : ({} : T).getD value value = value := by\\n    apply Std.HashMap.getD_of_isEmpty\\n    exact Std.HashMap.isEmpty_emptyWithCapacity\\n  rw [lookup]\\n  exact Value.sameExactFootprint_refl value\\n\\ntheorem insert_sound {index : T} (sound : Sound index) {member representative : Value}\\n    (safe : Value.SameExactFootprint member representative) :\\n    Sound (index.insert member representative) := by\\n  intro value\\n  rw [Std.HashMap.getD_insert]\\n  split\\n  · rename_i same\\n    have equality : member = value := by simpa using same\\n    subst value\\n    exact safe\\n  · exact sound value\\n\\ntheorem insertMembers_sound {index : T} (sound : Sound index)\\n    {representative : Value} {members : List Value}\\n    (safe : ∀ member, member ∈ members →\\n      Value.SameExactFootprint member representative) :\\n    Sound (insertMembers representative index members) := by\\n  induction members generalizing index with\\n  | nil => exact sound\\n  | cons head tail induction =>\\n      apply induction (insert_sound sound (safe head (by simp)))\\n      intro member present\\n      exact safe member (by simp [present])\\n\\ntheorem build_sound {index : T} (sound : Sound index)\\n    (classes : List EquivalenceClass) : Sound (build index classes) := by\\n  induction classes generalizing index with\\n  | nil => exact sound\\n  | cons equivalenceClass tail induction =>\\n      apply induction\\n      exact insertMembers_sound sound equivalenceClass.exactAuthority\\n\\nend RepresentativeIndex\\n\\nstructure Quotient where\\n  classes : List EquivalenceClass\\n  representatives : RepresentativeIndex.T\\n  exactAuthority : RepresentativeIndex.Sound representatives\\n\\nnamespace Quotient\\n\\n/-- With no Union, structural equality needs no corpus-dependent index. -/\\ndef literal : Quotient := ⟨[], {}, RepresentativeIndex.empty_sound⟩\\n\\ndef canonical (quotient : Quotient) (value : Value) : Value :=\\n  quotient.representatives.getD value value\\n\\ntheorem literal_canonical (value : Value) : literal.canonical value = value := by\\n  simp [literal, canonical]\\n\\ndef toEquality (quotient : Quotient) : Equality where\\n  same left right := decide (quotient.canonical left = quotient.canonical right)\\n  reflexive value := by simp [canonical]\\n  symmetric := by\\n    simp only [decide_eq_true_eq]\\n    exact Eq.symm\\n  transitive := by\\n    simp only [decide_eq_true_eq]\\n    exact Eq.trans\\n  preservesExact := by\\n    intro left right same\\n    simp only [decide_eq_true_eq] at same\\n    have middle : Value.SameExactFootprint\\n        (quotient.canonical left) (quotient.canonical right) := by\\n      rw [same]\\n      exact Value.sameExactFootprint_refl _\\n    exact Value.sameExactFootprint_trans (quotient.exactAuthority left)\\n      (Value.sameExactFootprint_trans middle\\n        (Value.sameExactFootprint_symm (quotient.exactAuthority right)))\\n\\n@[simp]\\ntheorem same_iff_canonical_eq (quotient : Quotient) {left right} :\\n    quotient.toEquality.same left right ↔\\n      quotient.canonical left = quotient.canonical right := by\\n  simp [toEquality]\\n\\ntheorem equality_of_canonical (left right : Quotient)\\n    (same : left.canonical = right.canonical) :\\n    left.toEquality = right.toEquality := by\\n  simp only [toEquality, same]\\n\\ntheorem equality_preserves_exact (quotient : Quotient) {left right}\\n    (same : quotient.toEquality.same left right) :\\n    Value.SameExactFootprint left right :=\\n  quotient.toEquality.preservesExact same\\n\\nnamespace AliasBuckets\\n\\nabbrev T := Std.HashMap Value (List Value)\\n\\ndef add (buckets : T) (row : Value × Value) : T :=\\n  buckets.insert row.2 (row.1 :: buckets.getD row.2 [])\\n\\ndef collect (rows : List (Value × Value)) (buckets : T) : T :=\\n  rows.foldl add buckets\\n\\ntheorem collect_membership (rows : List (Value × Value)) (buckets : T)\\n    (value representative : Value) :\\n    value ∈ (collect rows buckets).getD representative [] ↔\\n      value ∈ buckets.getD representative [] ∨ (value, representative) ∈ rows := by\\n  induction rows generalizing buckets with\\n  | nil => simp [collect]\\n  | cons row rest ih =>\\n      obtain ⟨source, target⟩ := row\\n      simp only [collect, List.foldl_cons]\\n      rw [← collect, ih]\\n      by_cases same : target = representative\\n      · subst target\\n        simp [add, List.mem_cons, or_assoc, or_comm, or_left_comm]\\n      · simp [add, Std.HashMap.getD_insert, same, List.mem_cons]\\n        constructor\\n        · rintro (present | present)\\n          · exact Or.inl present\\n          · exact Or.inr (Or.inr present)\\n        · rintro (present | equal | present)\\n          · exact Or.inl present\\n          · exact False.elim (same equal.2.symm)\\n          · exact Or.inr present\\n\\nend AliasBuckets\\n\\n/-- Invert the current quotient once per discovery pass. The certificate\\nincludes every key of the actual representative table, not just explicit\\nUnion endpoints. Congruence-created structured aliases therefore participate\\nin child-role lookup without loading every saved All's descendants. -/\\nstructure AliasIndex (quotient : Quotient) where\\n  buckets : AliasBuckets.T\\n  complete : ∀ value representative,\\n    value ∈ buckets.getD representative [] ↔\\n      quotient.representatives[value]? = some representative\\n\\ndef AliasIndex.prepare (quotient : Quotient) : AliasIndex quotient := {\\n  buckets := AliasBuckets.collect quotient.representatives.toList {}\\n  complete := by\\n    intro value representative\\n    change value ∈ (AliasBuckets.collect quotient.representatives.toList\\n      ({} : AliasBuckets.T)).getD representative [] ↔ _\\n    rw [AliasBuckets.collect_membership]\\n    simp\\n}\\n\\n/-- A value outside the finite table represents itself. Include that value\\nonly if it really is absent; no idempotence assumption about representatives\\nis needed for this lookup. All other aliases come from one inverse bucket. -/\\ndef AliasIndex.aliases (index : AliasIndex quotient) (work : Value) : List Value :=\\n  let representative := quotient.canonical work\\n  let members := index.buckets.getD representative []\\n  if quotient.representatives[representative]?.isNone then representative :: members\\n  else members\\n\\ntheorem AliasIndex.aliases_exact (index : AliasIndex quotient) (work value : Value) :\\n    value ∈ index.aliases work ↔ quotient.toEquality.same work value = true := by\\n  rw [Quotient.same_iff_canonical_eq]\\n  unfold aliases\\n  dsimp only\\n  cases found : quotient.representatives[quotient.canonical work]? with\\n  | none =>\\n      simp only [Option.isNone_none, ↓reduceIte, List.mem_cons, index.complete]\\n      cases actual : quotient.representatives[value]? with\\n      | none =>\\n          have literal : quotient.canonical value = value := by\\n            simp [canonical, Std.HashMap.getD_eq_getD_getElem?, actual]\\n          simp [literal, eq_comm]\\n      | some representative =>\\n          have different : value ≠ quotient.canonical work := by\\n            intro same\\n            rw [same, found] at actual\\n            contradiction\\n          have canonical : quotient.canonical value = representative := by\\n            simp [Quotient.canonical, Std.HashMap.getD_eq_getD_getElem?, actual]\\n          simp [canonical, different, eq_comm]\\n  | some representative =>\\n      simp only [Option.isNone_some, Bool.false_eq_true, ↓reduceIte, index.complete]\\n      cases actual : quotient.representatives[value]? with\\n      | none =>\\n          have different : value ≠ quotient.canonical work := by\\n            intro same\\n            rw [same, found] at actual\\n            contradiction\\n          have literal : quotient.canonical value = value := by\\n            simp [canonical, Std.HashMap.getD_eq_getD_getElem?, actual]\\n          simp [literal, different, eq_comm]\\n      | some representative =>\\n          have canonical : quotient.canonical value = representative := by\\n            simp [Quotient.canonical, Std.HashMap.getD_eq_getD_getElem?, actual]\\n          simp [canonical, eq_comm]\\n\\n/-- The indexed predicate used by completion is exactly the full child scan,\\nincluding structured congruence aliases, absent values and literal equality.\\nThe IO adapter separately checks the saved child-posting frames and roots. -/\\ntheorem AliasIndex.child_role_exact (index : AliasIndex quotient)\\n    (children : List Value) (work : Value) :\\n    (index.aliases work).any children.contains =\\n      children.any (quotient.toEquality.same work) := by\\n  apply Bool.eq_iff_iff.mpr\\n  simp only [List.any_eq_true, List.contains_iff_mem]\\n  constructor\\n  · rintro ⟨value, present, child⟩\\n    exact ⟨value, child, (index.aliases_exact work value).mp present⟩\\n  · rintro ⟨value, child, same⟩\\n    exact ⟨value, (index.aliases_exact work value).mpr same, child⟩\\n\\nend Quotient\\n\\nnamespace QuotientBuilder\\n\\nabbrev RawClass := List Value\\nabbrev RawPartition := List RawClass\\n\\ndef initial (values : List Value) : RawPartition :=\\n  hashDistinct values |>.map (fun value => [value])\\n\\ndef same (partition : RawPartition) (left right : Value) : Bool :=\\n  left == right || partition.any fun equivalenceClass =>\\n    equivalenceClass.contains left && equivalenceClass.contains right\\n\\ndef takeClass (value : Value) : RawPartition → RawClass × RawPartition\\n  | [] => ([value], [])\\n  | equivalenceClass :: tail =>\\n      if equivalenceClass.contains value then (equivalenceClass, tail)\\n      else\\n        let (found, rest) := takeClass value tail\\n        (found, equivalenceClass :: rest)\\n\\ndef merge (partition : RawPartition) (left right : Value) : RawPartition :=\\n  if same partition left right then partition\\n  else\\n    let (leftClass, withoutLeft) := takeClass left partition\\n    let (rightClass, rest) := takeClass right withoutLeft\\n    hashDistinct (leftClass ++ rightClass) :: rest\\n\\ndef mergeExplicit (partition : RawPartition) (edges : List UnionEdge) : RawPartition :=\\n  edges.foldl (fun classes edge => merge classes edge.left edge.right) partition\\n\\nabbrev Representatives := Std.HashMap Value Value\\n\\ndef representatives (partition : RawPartition) : Representatives :=\\n  partition.foldl (fun index equivalenceClass =>\\n    match equivalenceClass with\\n    | [] => index\\n    | representative :: _ => equivalenceClass.foldl\\n        (fun current member => current.insert member representative) index) {}\\n\\ndef normalizeRefs (index : Representatives) : Refs → Refs\\n  | .nil => .nil\\n  | .semantic value tail =>\\n      .semantic (index.getD value value) (normalizeRefs index tail)\\n  | .exact value tail => .exact value (normalizeRefs index tail)\\n\\n@[simp]\\ntheorem normalizeRefs_nil (index : Representatives) :\\n    normalizeRefs index .nil = .nil := rfl\\n\\n@[simp]\\ntheorem normalizeRefs_semantic (index : Representatives) (value : Value)\\n    (tail : Refs) :\\n    normalizeRefs index (.semantic value tail) =\\n      .semantic (index.getD value value) (normalizeRefs index tail) := rfl\\n\\n/-- Congruence canonicalizes beneath Semantic authority, never Exact authority. -/\\n@[simp]\\ntheorem normalizeRefs_exact (index : Representatives) (value : Value)\\n    (tail : Refs) :\\n    normalizeRefs index (.exact value tail) =\\n      .exact value (normalizeRefs index tail) := rfl\\n\\n/-- Canonical structural signature under one equivalence snapshot. -/\\ndef signature (index : Representatives) : Value → Value\\n  | atom@(.atom _) => atom\\n  | .apply operator arguments => .apply operator (normalizeRefs index arguments)\\n\\n/--\\nHash-consed congruence pass. Hashing only nominates a bucket; `HashMap` confirms\\nfull structural equality, so collisions never enter semantic identity.\\n-/\\ndef congruenceStep (index : Representatives) (state : Representatives × RawPartition)\\n    (value : Value) : Representatives × RawPartition :=\\n  let (seen, current) := state\\n  let key := signature index value\\n  match seen[key]? with\\n  | some prior => (seen, merge current prior value)\\n  | none => (seen.insert key value, current)\\n\\n/-- Full-scan specification retained independently of the runtime scan. -/\\ndef referenceCongruencePass (values : List Value) (partition : RawPartition) : RawPartition :=\\n  (values.foldl (congruenceStep (representatives partition)) ({}, partition)).2\\n\\n/-- Atom signatures never change and cannot collide with application\\nsignatures. Skipping them avoids hashing their potentially large payloads in\\nevery congruence round. Explicit Union processing remains unchanged. -/\\ndef applicationStep (index : Representatives) (state : Representatives × RawPartition) :\\n    Value → Representatives × RawPartition\\n  | .atom _ => state\\n  | value@(.apply _ _) => congruenceStep index state value\\n\\n@[simp]\\ntheorem applicationStep_atom (index : Representatives) (state : Representatives × RawPartition)\\n    (bytes : ByteArray) : applicationStep index state (.atom bytes) = state := rfl\\n\\ndef congruencePass (values : List Value) (partition : RawPartition) : RawPartition :=\\n  (values.foldl (applicationStep (representatives partition)) ({}, partition)).2\\n\\nnamespace ApplicationScan\\n\\ndef Sound (index seen : Representatives) : Prop :=\\n  ∀ key value, seen[key]? = some value → signature index value = key\\n\\ndef Agree (first second : Representatives) : Prop :=\\n  ∀ operator arguments, first[Value.apply operator arguments]? = second[Value.apply operator arguments]?\\n\\ntheorem signature_atom (index : Representatives) (value : Value) (bytes : ByteArray)\\n    (same : signature index value = .atom bytes) : value = .atom bytes := by\\n  cases value <;> simp_all [signature]\\n\\ntheorem merge_self (partition : RawPartition) (value : Value) : merge partition value value = partition := by\\n  simp [merge, same]\\n\\ntheorem sound_insert (index seen : Representatives) (sound : Sound index seen) (value : Value) :\\n    Sound index (seen.insert (signature index value) value) := by\\n  intro query found stored\\n  rw [Std.HashMap.getElem?_insert] at stored\\n  split at stored\\n  · have same : signature index value = query := by simpa using ‹(signature index value == query) = true›\\n    have equal : value = found := Option.some.inj stored\\n    simpa [← equal] using same\\n  · exact sound query found stored\\n\\ntheorem agree_insert (first second : Representatives) (agree : Agree first second)\\n    (key value : Value) : Agree (first.insert key value) (second.insert key value) := by\\n  intro operator arguments\\n  simp only [Std.HashMap.getElem?_insert, agree operator arguments]\\n\\ntheorem agree_atom_insert (first second : Representatives) (agree : Agree first second)\\n    (bytes : ByteArray) : Agree (first.insert (.atom bytes) (.atom bytes)) second := by\\n  intro operator arguments\\n  simpa only [Std.HashMap.getElem?_insert, show (Value.atom bytes == .apply operator arguments) = false from by simp,\\n    Bool.false_eq_true, ↓reduceIte] using agree operator arguments\\n\\ntheorem step (index : Representatives) (first second : Representatives × RawPartition)\\n    (partition : first.2 = second.2) (sound : Sound index first.1) (agree : Agree first.1 second.1)\\n    (value : Value) :\\n    (congruenceStep index first value).2 = (applicationStep index second value).2 ∧\\n    Sound index (congruenceStep index first value).1 ∧\\n    Agree (congruenceStep index first value).1 (applicationStep index second value).1 := by\\n  rcases first with ⟨seen, before⟩\\n  rcases second with ⟨other, after⟩\\n  dsimp only at partition sound agree\\n  subst after\\n  cases value with\\n  | atom bytes =>\\n    cases found : seen[Value.atom bytes]? with\\n    | none =>\\n      simp only [congruenceStep, applicationStep, signature, found]\\n      exact ⟨True.intro, sound_insert index seen sound (.atom bytes), agree_atom_insert seen other agree bytes⟩\\n    | some prior =>\\n      have same := signature_atom index prior bytes (sound _ _ found)\\n      subst prior\\n      simp only [congruenceStep, applicationStep, signature, found, merge_self]\\n      exact ⟨True.intro, sound, agree⟩\\n  | apply operator arguments =>\\n    have same := agree operator (normalizeRefs index arguments)\\n    cases found : seen[Value.apply operator (normalizeRefs index arguments)]? with\\n    | none =>\\n      have otherFound : other[Value.apply operator (normalizeRefs index arguments)]? = none := same.symm.trans found\\n      simp only [congruenceStep, applicationStep, signature, found, otherFound]\\n      exact ⟨True.intro, sound_insert index seen sound (.apply operator arguments),\\n        agree_insert seen other agree _ _⟩\\n    | some prior =>\\n      have otherFound : other[Value.apply operator (normalizeRefs index arguments)]? = some prior := same.symm.trans found\\n      simp only [congruenceStep, applicationStep, signature, found, otherFound]\\n      exact ⟨True.intro, sound, agree⟩\\n\\ntheorem fold (index : Representatives) (values : List Value)\\n    (first second : Representatives × RawPartition)\\n    (partition : first.2 = second.2) (sound : Sound index first.1) (agree : Agree first.1 second.1) :\\n    (values.foldl (congruenceStep index) first).2 =\\n      (values.foldl (applicationStep index) second).2 := by\\n  induction values generalizing first second with\\n  | nil => exact partition\\n  | cons value rest ih =>\\n    have next := step index first second partition sound agree value\\n    exact ih _ _ next.1 next.2.1 next.2.2\\n\\nend ApplicationScan\\n\\n/-- Exact partition equality for arbitrary Values and arbitrary incoming\\npartitions, including mixed explicit Unions. No atom-only corpus assumption\\nor completed-output equivalence premise is needed. -/\\ntheorem congruencePass_reference (values : List Value) (partition : RawPartition) :\\n    congruencePass values partition = referenceCongruencePass values partition := by\\n  symm\\n  exact ApplicationScan.fold (representatives partition) values ({}, partition) ({}, partition)\\n    rfl (by simp [ApplicationScan.Sound]) (by intro _ _; rfl)\\n\\nnamespace CongruenceMemo\\n\\n/-- Hashing is a cached calculation, not equality authority. A key carries\\nthe full current structural signature and the hash of exactly that signature.\\nIt cannot supply an arbitrary hash that hides an equal key in another bucket. -/\\nstructure Key where\\n  value : Value\\n  fingerprint : UInt64\\n  exact : fingerprint = hash value\\n\\ndef Key.make (value : Value) : Key := ⟨value, hash value, rfl⟩\\n\\ntheorem Key.ext (left right : Key) (same : left.value = right.value) : left = right := by\\n  cases left with\\n  | mk lv lh le =>\\n    cases right with\\n    | mk rv rh re =>\\n      dsimp only at same\\n      subst rv\\n      cases le\\n      cases re\\n      rfl\\n\\ninstance : BEq Key where\\n  beq left right := left.value == right.value\\n\\ninstance : LawfulBEq Key where\\n  rfl := by intro key; change (key.value == key.value) = true; simp\\n  eq_of_beq := by\\n    intro left right equal\\n    apply Key.ext\\n    change (left.value == right.value) = true at equal\\n    exact beq_iff_eq.mp equal\\n\\ninstance : Hashable Key where\\n  hash key := key.fingerprint\\n\\ninstance : DecidableEq Key := fun left right =>\\n  if same : left.value = right.value then isTrue (Key.ext left right same)\\n  else isFalse (fun equal => same (congrArg Key.value equal))\\n\\n@[simp] theorem Key.make_beq (left right : Value) :\\n    (Key.make left == Key.make right) = (left == right) := rfl\\n\\nstructure Prepared (value : Value) where\\n  key : Key\\n  exact : key.value = value\\n  reused : Bool\\n\\n/-- Validate the complete current dependency sequence without first allocating\\nits normalized replacement. Exact references remain literal; a Semantic\\nreference must name precisely today's representative, including after splits.\\nBoth missing and additional references reject the old calculation. -/\\ndef refsAgree (index : Representatives) : Refs → Refs → Bool\\n  | .nil, .nil => true\\n  | .semantic value tail, .semantic observed rest =>\\n      observed == index.getD value value && refsAgree index tail rest\\n  | .exact value tail, .exact observed rest =>\\n      observed == value && refsAgree index tail rest\\n  | _, _ => false\\n\\ntheorem refsAgree_exact (index : Representatives) (source observed : Refs) :\\n    refsAgree index source observed = true ↔ observed = normalizeRefs index source := by\\n  cases source with\\n  | nil => cases observed <;> simp [refsAgree, normalizeRefs]\\n  | semantic value tail =>\\n      cases observed with\\n      | nil => simp [refsAgree, normalizeRefs]\\n      | exact observed rest => simp [refsAgree, normalizeRefs]\\n      | semantic observed rest =>\\n          simp only [refsAgree, normalizeRefs, Bool.and_eq_true, beq_iff_eq, Refs.semantic.injEq]\\n          exact and_congr Iff.rfl (refsAgree_exact index tail rest)\\n  | exact value tail =>\\n      cases observed with\\n      | nil => simp [refsAgree, normalizeRefs]\\n      | semantic observed rest => simp [refsAgree, normalizeRefs]\\n      | exact observed rest =>\\n          simp only [refsAgree, normalizeRefs, Bool.and_eq_true, beq_iff_eq, Refs.exact.injEq]\\n          exact and_congr Iff.rfl (refsAgree_exact index tail rest)\\n\\n/-- A position nominates an old signature, but never authorizes it. Check\\noperator, authority and every current child before reusing its cached hash. -/\\ndef signatureAgrees (index : Representatives) : Value → Value → Bool\\n  | .atom source, .atom observed => decide (observed = source)\\n  | .apply operator source, .apply observedOperator observed =>\\n      decide (observedOperator = operator) && refsAgree index source observed\\n  | _, _ => false\\n\\ntheorem signatureAgrees_exact (index : Representatives) (source observed : Value) :\\n    signatureAgrees index source observed = true ↔ observed = signature index source := by\\n  cases source <;> cases observed <;>\\n    simp [signatureAgrees, signature, refsAgree_exact]\\n\\n/-- The hit path checks current dependencies and returns the existing key.\\nOnly a miss builds and hashes a fresh structural signature. Its dependent\\nresult certifies the entire signature for arbitrary previous metadata. -/\\ndef prepareSignature (previous : Option Key) (index : Representatives) (source : Value) :\\n    Prepared (signature index source) :=\\n  match previous with\\n  | some key =>\\n      if same : signatureAgrees index source key.value = true then\\n        ⟨key, (signatureAgrees_exact index source key.value).mp same, true⟩\\n      else ⟨Key.make (signature index source), rfl, false⟩\\n  | none => ⟨Key.make (signature index source), rfl, false⟩\\n\\ntheorem Prepared.canonical (prepared : Prepared value) : prepared.key = Key.make value :=\\n  Key.ext prepared.key (Key.make value) prepared.exact\\n\\nabbrev Seen := Std.HashMap Key Value\\n\\ndef Agree (cached : Seen) (reference : Representatives) : Prop :=\\n  ∀ value, cached[Key.make value]? = reference[value]?\\n\\ntheorem agree_insert (cached : Seen) (reference : Representatives)\\n    (agree : Agree cached reference) (key value : Value) :\\n    Agree (cached.insert (Key.make key) value) (reference.insert key value) := by\\n  intro query\\n  simp only [Std.HashMap.getElem?_insert, Key.make_beq, agree query]\\n\\ndef keyedStep (state : Seen × RawPartition) (key : Key) (value : Value) :\\n    Seen × RawPartition :=\\n  match state.1[key]? with\\n  | some prior => (state.1, merge state.2 prior value)\\n  | none => (state.1.insert key value, state.2)\\n\\ntheorem keyedStep_exact (index : Representatives) (cached : Seen × RawPartition)\\n    (reference : Representatives × RawPartition) (partition : cached.2 = reference.2)\\n    (agree : Agree cached.1 reference.1) (key : Key) (value : Value)\\n    (exact : key.value = signature index value) :\\n    (keyedStep cached key value).2 = (congruenceStep index reference value).2 ∧\\n      Agree (keyedStep cached key value).1 (congruenceStep index reference value).1 := by\\n  have canonical : key = Key.make (signature index value) := Key.ext _ _ exact\\n  simp only [keyedStep, canonical, congruenceStep]\\n  rw [agree (signature index value)]\\n  cases found : reference.1[signature index value]? with\\n  | none => exact ⟨partition, agree_insert cached.1 reference.1 agree _ value⟩\\n  | some prior => exact ⟨congrArg (fun p => merge p prior value) partition, agree⟩\\n\\nabbrev Row := Key × Value\\n\\ndef rows (index : Representatives) (values : List Value) : List Row :=\\n  values.filterMap fun value => match value with\\n    | .atom _ => none\\n    | .apply .. => some (Key.make (signature index value), value)\\n\\nstructure Rows (index : Representatives) (values : List Value) where\\n  rows : List Row\\n  exact : rows = CongruenceMemo.rows index values\\n  reused : Nat\\n  computed : Nat\\n\\n/-- The source Value is part of every row. Two different applications whose\\nnormalized signatures coincide cannot silently exchange cached instructions. -/\\ndef prepareRows (previous : List Key) (index : Representatives) :\\n    (values : List Value) → Rows index values\\n  | [] => ⟨[], rfl, 0, 0⟩\\n  | value :: values => match value with\\n    | .atom _ =>\\n        let rest := prepareRows previous index values\\n        ⟨rest.rows, rest.exact, rest.reused, rest.computed⟩\\n    | .apply operator arguments =>\\n        let value := Value.apply operator arguments\\n        let prepared := prepareSignature previous.head? index value\\n        let rest := prepareRows previous.tail index values\\n        ⟨(prepared.key, value) :: rest.rows,\\n          by simp only [rows, List.filterMap_cons]; rw [prepared.canonical, rest.exact]; rfl,\\n          rest.reused + if prepared.reused then 1 else 0,\\n          rest.computed + if prepared.reused then 0 else 1⟩\\n\\ndef instructions (seen : Seen) : List Row → List (Option Value)\\n  | [] => []\\n  | (key, value) :: rows =>\\n      let prior := seen[key]?\\n      let next := if prior.isSome then seen else seen.insert key value\\n      prior :: instructions next rows\\n\\n/-- A compiled join script has a producer certificate, not an assumed cached\\noutput. It covers all ordered rows, including new and formerly negative keys. -/\\nstructure Script (seen : Seen) (rows : List Row) where\\n  instructions : List (Option Value)\\n  exact : instructions = CongruenceMemo.instructions seen rows\\n  reused : Nat := 0\\n  computed : Nat := 0\\n\\ndef Script.make (seen : Seen) (rows : List Row) : Script seen rows :=\\n  ⟨CongruenceMemo.instructions seen rows, rfl, 0, rows.length⟩\\n\\n/-- Rebuildable disk hints have no producer proof attached. Validate once\\nagainst their entire recorded dependency sequence before exposing a Script. -/\\ndef Script.check? (seen : Seen) (rows : List Row) (observed : List (Option Value)) :\\n    Option (Script seen rows) :=\\n  if exact : observed = CongruenceMemo.instructions seen rows then\\n    some ⟨observed, exact, 0, rows.length⟩ else none\\n\\ntheorem Script.wrong_instructions_rejected (seen : Seen) (rows : List Row)\\n    (observed : List (Option Value))\\n    (wrong : observed ≠ CongruenceMemo.instructions seen rows) :\\n    Script.check? seen rows observed = none := by\\n  simp [check?, wrong]\\n\\ndef advanceSeen (seen : Seen) (row : Row) (prior : Option Value) : Seen :=\\n  if prior.isSome then seen else seen.insert row.1 row.2\\n\\ntheorem advanceSeen_outside (seen : Seen) (row : Row) (prior : Option Value) (key : Key)\\n    (different : key ≠ row.1) : (advanceSeen seen row prior)[key]? = seen[key]? := by\\n  unfold advanceSeen\\n  split\\n  · rfl\\n  · simp [Std.HashMap.getElem?_insert, Ne.symm different]\\n\\n/-- Only keys touched by a changed row can have different earliest sources.\\nThe former seen map is a proof index, not a second runtime table. -/\\nstructure ChangedKeys (old current : Seen) where\\n  keys : Std.HashMap Key Unit\\n  agrees : ∀ key, keys.contains key = false → old[key]? = current[key]?\\n\\ndef changedAfter (keys : Std.HashMap Key Unit) (before row : Row) : Std.HashMap Key Unit :=\\n  if before = row then keys else (keys.insert before.1 ()).insert row.1 ()\\n\\ndef ChangedKeys.advance (scope : ChangedKeys old current) (before row : Row)\\n    (oldPrior prior : Option Value) (oldHead : oldPrior = old[before.1]?)\\n    (head : prior = current[row.1]?) :\\n    ChangedKeys (advanceSeen old before oldPrior) (advanceSeen current row prior) :=\\n  if same : before = row then\\n    ⟨scope.keys, by\\n      subst before\\n      intro key outside\\n      by_cases atRow : key = row.1\\n      · subst key\\n        have equal : oldPrior = prior := oldHead.trans ((scope.agrees row.1 outside).trans head.symm)\\n        rw [equal]\\n        cases prior with\\n        | none => simp [advanceSeen]\\n        | some value => simpa only [advanceSeen, Option.isSome_some, ↓reduceIte]\\n            using scope.agrees row.1 outside\\n      · rw [advanceSeen_outside _ _ _ _ atRow, advanceSeen_outside _ _ _ _ atRow]\\n        exact scope.agrees key outside⟩\\n  else\\n    ⟨(scope.keys.insert before.1 ()).insert row.1 (), by\\n      intro key outside\\n      have separated : key ≠ row.1 ∧ key ≠ before.1 ∧ scope.keys.contains key = false := by\\n        simp only [Std.HashMap.contains_insert] at outside\\n        have rowAbsent := (Bool.or_eq_false_iff.mp outside).1\\n        have rest := Bool.or_eq_false_iff.mp (Bool.or_eq_false_iff.mp outside).2\\n        have beforeAbsent := rest.1\\n        refine ⟨?_, ?_, rest.2⟩\\n        · intro same\\n          subst key\\n          simp at rowAbsent\\n        · intro same\\n          subst key\\n          simp at beforeAbsent\\n      rw [advanceSeen_outside _ _ _ _ separated.2.1,\\n        advanceSeen_outside _ _ _ _ separated.1]\\n      exact scope.agrees key separated.2.2⟩\\n\\ntheorem ChangedKeys.advance_keys (scope : ChangedKeys old current) (before row : Row)\\n    (oldPrior prior : Option Value) (oldHead : oldPrior = old[before.1]?)\\n    (head : prior = current[row.1]?) :\\n    (scope.advance before row oldPrior prior oldHead head).keys =\\n      changedAfter scope.keys before row := by\\n  unfold ChangedKeys.advance changedAfter\\n  split <;> rfl\\n\\n/-- Package the former prefix state exclusively in a proposition. Keeping it\\nas a recursive value argument would cause the compiler to rebuild a second\\nseen table even though only the dependency invariant requires it. -/\\nstructure ReplayState (current : Seen) (old : List Row) where\\n  hints : List (Option Value)\\n  changed : Std.HashMap Key Unit\\n  valid : ∃ previous : Seen, hints = instructions previous old ∧\\n    ∀ key, changed.contains key = false → previous[key]? = current[key]?\\n\\ndef ReplayState.start (seen : Seen) (old : List Row) (script : Script seen old) :\\n    ReplayState seen old := ⟨script.instructions, {}, ⟨seen, script.exact, by intro _ _; rfl⟩⟩\\n\\ndef ReplayState.next (state : ReplayState current (before :: old)) (row : Row)\\n    (prior : Option Value) (head : prior = current[row.1]?) :\\n    ReplayState (advanceSeen current row prior) old :=\\n  ⟨state.hints.tail, changedAfter state.changed before row, by\\n    rcases state.valid with ⟨previous, original, agree⟩\\n    let oldPrior := state.hints.headD none\\n    have oldHead : oldPrior = previous[before.1]? := by\\n      dsimp only [oldPrior]\\n      rw [original]\\n      cases before\\n      rfl\\n    let next := advanceSeen previous before oldPrior\\n    let scope : ChangedKeys previous current := ⟨state.changed, agree⟩\\n    let advanced := scope.advance before row oldPrior prior oldHead head\\n    refine ⟨next, ?_, ?_⟩\\n    · rw [original]\\n      dsimp only [next, advanceSeen]\\n      rw [oldHead]\\n      cases before\\n      rfl\\n    · intro key outside\\n      apply advanced.agrees key\\n      rw [scope.advance_keys before row oldPrior prior oldHead head]\\n      exact outside⟩\\n\\n/-- Repair the affected signature keys, including negative first occurrences.\\nAn unchanged row after a correction can still reuse its prior instruction\\nwhen none of its signature dependencies changed. No old partition survives\\nretraction; only current-row instructions obtain the exact producer proof. -/\\ndef Script.repairFrom (currentSeen : Seen) (old : List Row)\\n    (state : ReplayState currentSeen old) :\\n    (current : List Row) → Script currentSeen current\\n  | [] => ⟨[], rfl, 0, 0⟩\\n  | row :: current => match old with\\n    | [] => Script.make currentSeen (row :: current)\\n    | before :: old =>\\n        let oldPrior := state.hints.headD none\\n        let reused := decide (before = row) && !state.changed.contains row.1\\n        let prior := if reused then oldPrior else currentSeen[row.1]?\\n        have head : prior = currentSeen[row.1]? := by\\n          dsimp only [prior]\\n          split\\n          · rename_i allowed\\n            have same : before = row ∧ state.changed.contains row.1 = false := by\\n              have parts : before = row ∧ (!state.changed.contains row.1) = true := by\\n                simpa only [reused, Bool.and_eq_true, decide_eq_true_eq] using allowed\\n              refine ⟨parts.1, ?_⟩\\n              cases absent : state.changed.contains row.1\\n              · rfl\\n              · simp [absent] at parts\\n            rcases state.valid with ⟨previous, original, agree⟩\\n            have oldHead : oldPrior = previous[before.1]? := by\\n              dsimp only [oldPrior]\\n              rw [original]\\n              cases before\\n              rfl\\n            rw [oldHead, same.1, agree row.1 same.2]\\n          · rfl\\n        let next := advanceSeen currentSeen row prior\\n        let advanced := state.next row prior head\\n        let rest := Script.repairFrom next old advanced current\\n        ⟨prior :: rest.instructions, by\\n          rw [rest.exact]\\n          dsimp only [next, advanceSeen]\\n          rw [head]\\n          cases row\\n          rfl,\\n          rest.reused + if reused then 1 else 0,\\n          rest.computed + if reused then 0 else 1⟩\\n\\ndef Script.repair (seen : Seen) (old : List Row) (script : Script seen old)\\n    (current : List Row) : Script seen current :=\\n  Script.repairFrom seen old (ReplayState.start seen old script) current\\n\\nstructure Entry where\\n  rows : List Row\\n  script : Script {} rows\\n\\ndef prepareScript (previous : Option Entry) (rows : List Row) : Script {} rows :=\\n  match previous with\\n  | none => Script.make {} rows\\n  | some previous => previous.script.repair {} previous.rows rows\\n\\ndef applyInstructions : List Row → List (Option Value) → RawPartition → RawPartition\\n  | [], _, partition => partition\\n  | _, [], partition => partition\\n  | (_, value) :: rows, prior :: instructions, partition =>\\n      applyInstructions rows instructions (match prior with\\n        | none => partition\\n        | some prior => merge partition prior value)\\n\\ntheorem apply_compiled (seen : Seen) (rows : List Row) (partition : RawPartition) :\\n    applyInstructions rows (instructions seen rows) partition =\\n      (rows.foldl (fun state row => keyedStep state row.1 row.2) (seen, partition)).2 := by\\n  induction rows generalizing seen partition with\\n  | nil => rfl\\n  | cons row rows ih =>\\n      rcases row with ⟨key, value⟩\\n      cases found : seen[key]? <;>\\n        simp [instructions, applyInstructions, found, keyedStep, ih]\\n\\ntheorem rows_fold (index : Representatives) (values : List Value)\\n    (state : Seen × RawPartition) (reference : Representatives × RawPartition)\\n    (partition : state.2 = reference.2) (agree : Agree state.1 reference.1) :\\n    ((rows index values).foldl (fun state row => keyedStep state row.1 row.2) state).2 =\\n      (values.foldl (applicationStep index) reference).2 ∧\\n    Agree ((rows index values).foldl (fun state row => keyedStep state row.1 row.2) state).1\\n      (values.foldl (applicationStep index) reference).1 := by\\n  induction values generalizing state reference with\\n  | nil => exact ⟨partition, agree⟩\\n  | cons value values ih =>\\n      cases value with\\n      | atom bytes =>\\n          simpa only [rows, List.filterMap_cons, List.foldl_cons, applicationStep] using\\n            ih state reference partition agree\\n      | apply operator arguments =>\\n          let value := Value.apply operator arguments\\n          have next := keyedStep_exact index state reference partition agree\\n            (Key.make (signature index value)) value rfl\\n          simpa only [rows, List.filterMap_cons, List.foldl_cons] using\\n            ih (keyedStep state (Key.make (signature index value)) value)\\n              (applicationStep index reference value) next.1 next.2\\n\\nstructure Pass where\\n  partition : RawPartition\\n  keys : List Key\\n  reused : Nat\\n  computed : Nat\\n  plan : Entry\\n\\n/-- One generation of signature metadata is retained, not a copy of the\\npartition per application or all historical representative maps. -/\\ndef pass (previous : List Key) (values : List Value) (partition : RawPartition)\\n    (previousPlan : Option Entry := none) : Pass :=\\n  let prepared := prepareRows previous (representatives partition) values\\n  let script := prepareScript previousPlan prepared.rows\\n  ⟨applyInstructions prepared.rows script.instructions partition,\\n    prepared.rows.map Prod.fst, prepared.reused, prepared.computed, ⟨prepared.rows, script⟩⟩\\n\\n/-- Exact ordered classes for arbitrary Values and arbitrary incoming\\npartitions. No atom-only assumption, digest injectivity or stale output\\nequivalence premise is required. A miss cannot omit a newly added key. -/\\ntheorem pass_exact (previous : List Key) (values : List Value) (partition : RawPartition)\\n    (previousPlan : Option Entry := none) :\\n    (pass previous values partition previousPlan).partition = congruencePass values partition := by\\n  simp only [pass, (prepareScript _ _).exact, apply_compiled,\\n    (prepareRows _ _ _).exact]\\n  exact (rows_fold (representatives partition) values ({}, partition) ({}, partition)\\n    rfl (by intro value; simp)).1\\n\\nend CongruenceMemo\\n\\n/-- Full scan specification of ordered application congruence. -/\\ndef scanSaturateCongruence (values : List Value) : Nat → RawPartition → RawPartition\\n  | 0, partition => partition\\n  | fuel + 1, partition =>\\n      let next := congruencePass values partition\\n      if next = partition then partition\\n      else scanSaturateCongruence values fuel next\\n\\nstructure Saturated where\\n  partition : RawPartition\\n  keys : List CongruenceMemo.Key\\n  plan : Option CongruenceMemo.Entry\\n\\n/-- The actual saturation interpreter carries only one generation of join\\ninstructions. Every round repairs its demanded current dependency sequence;\\nan old partition is never imported through this acceleration boundary. -/\\ndef plannedSaturateCongruence (values : List Value) (previous : List CongruenceMemo.Key)\\n    (plan : Option CongruenceMemo.Entry) :\\n    Nat → RawPartition → Saturated\\n  | 0, partition => ⟨partition, previous, plan⟩\\n  | fuel + 1, partition =>\\n      let next := CongruenceMemo.pass previous values partition plan\\n      if next.partition = partition then ⟨partition, next.keys, some next.plan⟩\\n      else plannedSaturateCongruence values next.keys (some next.plan) fuel next.partition\\n\\ntheorem plannedSaturateCongruence_exact (values : List Value)\\n    (previous : List CongruenceMemo.Key) (plan : Option CongruenceMemo.Entry)\\n    (fuel : Nat) (partition : RawPartition) :\\n    (plannedSaturateCongruence values previous plan fuel partition).partition =\\n      scanSaturateCongruence values fuel partition := by\\n  induction fuel generalizing previous plan partition with\\n  | zero => rfl\\n  | succ fuel ih =>\\n      simp only [plannedSaturateCongruence, scanSaturateCongruence,\\n        CongruenceMemo.pass_exact]\\n      split\\n      · rfl\\n      · exact ih _ _ _\\n\\ndef memoSaturateCongruence (values : List Value) (previous : List CongruenceMemo.Key)\\n    (fuel : Nat) (partition : RawPartition) : RawPartition :=\\n  (plannedSaturateCongruence values previous none fuel partition).partition\\n\\ntheorem memoSaturateCongruence_exact (values : List Value)\\n    (previous : List CongruenceMemo.Key) (fuel : Nat) (partition : RawPartition) :\\n    memoSaturateCongruence values previous fuel partition =\\n      scanSaturateCongruence values fuel partition := by\\n  exact plannedSaturateCongruence_exact values previous none fuel partition\\n\\ndef saturateCongruence (values : List Value) (fuel : Nat) (partition : RawPartition) :\\n    RawPartition := memoSaturateCongruence values [] fuel partition\\n\\n@[simp] theorem saturateCongruence_zero (values : List Value) (partition : RawPartition) :\\n    saturateCongruence values 0 partition = partition := rfl\\n\\ntheorem saturateCongruence_step (values : List Value) (fuel : Nat) (partition : RawPartition) :\\n    saturateCongruence values (fuel + 1) partition =\\n      let next := congruencePass values partition\\n      if next = partition then partition else saturateCongruence values fuel next := by\\n  simp only [saturateCongruence, memoSaturateCongruence_exact, scanSaturateCongruence]\\n\\n/-- The original full scan, including Atom signatures, in every round. -/\\ndef referenceSaturateCongruence (values : List Value) : Nat → RawPartition → RawPartition\\n  | 0, partition => partition\\n  | fuel + 1, partition =>\\n      let next := referenceCongruencePass values partition\\n      if next = partition then partition\\n      else referenceSaturateCongruence values fuel next\\n\\ntheorem saturateCongruence_reference (values : List Value) (fuel : Nat) (partition : RawPartition) :\\n    saturateCongruence values fuel partition = referenceSaturateCongruence values fuel partition := by\\n  induction fuel generalizing partition with\\n  | zero => rfl\\n  | succ fuel ih =>\\n      simp only [saturateCongruence_step, referenceSaturateCongruence, congruencePass_reference, ih]\\n\\ndef certify (partition : RawPartition) : Option Quotient := do\\n  let classes ← partition.mapM EquivalenceClass.certify?\\n  let representatives := RepresentativeIndex.build {} classes\\n  pure {\\n    classes\\n    representatives\\n    exactAuthority := RepresentativeIndex.build_sound\\n      RepresentativeIndex.empty_sound classes\\n  }\\n\\n/-- One ordered closed term domain shared by fresh builds, retained plans and\\ntheir persisted dependency basis. Exact children are not substitutable terms. -/\\ndef kernelValues (roots : List Value) (edges : List UnionEdge) : List Value :=\\n  (roots ++ edges.flatMap (fun edge => edge.left.semanticNodes ++ edge.right.semanticNodes))\\n    |>.flatMap Value.semanticNodes |> hashDistinct\\n\\ndef referenceBuild? (roots : List Value) (persistent runLocal : List UnionEdge) : Option Quotient :=\\n  let values := kernelValues roots (persistent ++ runLocal)\\n  let explicit := mergeExplicit (initial values) (persistent ++ runLocal)\\n  certify (referenceSaturateCongruence values values.length explicit)\\n\\ndef kernelPartition (roots : List Value) (edges : List UnionEdge) : RawPartition :=\\n  let values := kernelValues roots edges\\n  saturateCongruence values values.length (mergeExplicit (initial values) edges)\\n\\ndef congruenceBuild? (roots : List Value) (persistent runLocal : List UnionEdge) : Option Quotient :=\\n  certify (kernelPartition roots (persistent ++ runLocal))\\n\\ntheorem congruenceBuild_reference (roots : List Value) (persistent runLocal : List UnionEdge) :\\n    congruenceBuild? roots persistent runLocal = referenceBuild? roots persistent runLocal := by\\n  simp only [congruenceBuild?, kernelPartition, referenceBuild?, saturateCongruence_reference]\\n\\nnamespace LiteralProof\\n\\ndef SelfIndex (index : RepresentativeIndex.T) : Prop :=\\n  ∀ value, index.getD value value = value\\n\\ntheorem empty_self : SelfIndex {} := by\\n  intro value\\n  simp\\n\\ntheorem insert_self (index : RepresentativeIndex.T) (known : SelfIndex index) (added : Value) :\\n    SelfIndex (index.insert added added) := by\\n  intro value\\n  rw [Std.HashMap.getD_insert]\\n  split\\n  · rename_i same\\n    simpa using same\\n  · exact known value\\n\\ntheorem fold_self (index : RepresentativeIndex.T) (known : SelfIndex index) (values : List Value) :\\n    SelfIndex (values.foldl (fun current value => current.insert value value) index) := by\\n  induction values generalizing index with\\n  | nil => exact known\\n  | cons head tail ih => exact ih _ (insert_self index known head)\\n\\ntheorem representatives_self (values : List Value) :\\n    SelfIndex (representatives (values.map (fun value => [value]))) := by\\n  simpa [representatives, List.foldl_map] using fold_self {} empty_self values\\n\\ntheorem normalize_self (index : Representatives) (known : SelfIndex index) :\\n    (refs : Refs) → normalizeRefs index refs = refs\\n  | .nil => rfl\\n  | .semantic value rest => by\\n      rw [normalizeRefs_semantic, known value, normalize_self index known rest]\\n  | .exact value rest => by\\n      rw [normalizeRefs_exact, normalize_self index known rest]\\n\\ntheorem signature_self (index : Representatives) (known : SelfIndex index) (value : Value) :\\n    signature index value = value := by\\n  cases value with\\n  | atom _ => rfl\\n  | apply operator refs => simp [signature, normalize_self index known refs]\\n\\ntheorem found_self (index : Representatives) (known : SelfIndex index) (value prior : Value)\\n    (found : index.get? value = some prior) : prior = value := by\\n  have equal := known value\\n  rw [Std.HashMap.getD_eq_getD_getElem?] at equal\\n  simpa [show index[value]? = some prior from found] using equal\\n\\ntheorem merge_self (partition : RawPartition) (value : Value) :\\n    merge partition value value = partition := by simp [merge, same]\\n\\ntheorem pass_fold (index seen : Representatives) (known : SelfIndex index)\\n    (seenSelf : SelfIndex seen) (partition : RawPartition) (values : List Value) :\\n    (values.foldl (fun (state : Representatives × RawPartition) value =>\\n      match state.1.get? (signature index value) with\\n      | some prior => (state.1, merge state.2 prior value)\\n      | none => (state.1.insert (signature index value) value, state.2))\\n        (seen, partition)).2 = partition := by\\n  induction values generalizing seen with\\n  | nil => rfl\\n  | cons value tail ih =>\\n    simp only [List.foldl_cons, signature_self index known value]\\n    cases found : seen.get? value with\\n    | none =>\\n      exact ih _ (insert_self seen seenSelf value)\\n    | some prior =>\\n      have equal := found_self seen seenSelf value prior found\\n      subst prior\\n      simp only [merge_self]\\n      exact ih seen seenSelf\\n\\ntheorem pass_singletons (values members : List Value) :\\n    congruencePass values (members.map (fun value => [value])) =\\n      members.map (fun value => [value]) := by\\n  rw [congruencePass_reference]\\n  exact pass_fold _ {} (representatives_self members) empty_self _ values\\n\\ntheorem saturation_singletons (values members : List Value) (fuel : Nat) :\\n    saturateCongruence values fuel (members.map (fun value => [value])) =\\n      members.map (fun value => [value]) := by\\n  cases fuel with\\n  | zero => rfl\\n  | succ fuel => simp [saturateCongruence_step, pass_singletons]\\n\\ndef singleton (value : Value) : EquivalenceClass := {\\n  representative := value\\n  members := [value]\\n  exactAuthority := by\\n    intro member present\\n    have equal := List.mem_singleton.mp present\\n    subst member\\n    exact Value.sameExactFootprint_refl value\\n}\\n\\ntheorem certify_singleton (value : Value) :\\n    EquivalenceClass.certify? [value] = some (singleton value) := by\\n  have reflexive : Value.sameExactFootprint value value = true := by\\n    simp [Value.sameExactFootprint, List.all_eq_true]\\n  simp [EquivalenceClass.certify?, reflexive, singleton]\\n\\ntheorem singleton_index (index : RepresentativeIndex.T) (known : SelfIndex index)\\n    (values : List Value) :\\n    SelfIndex (RepresentativeIndex.build index (values.map singleton)) := by\\n  induction values generalizing index with\\n  | nil => exact known\\n  | cons head tail ih =>\\n    simp only [List.map_cons, RepresentativeIndex.build, singleton,\\n      RepresentativeIndex.insertMembers]\\n    exact ih _ (insert_self index known head)\\n\\ndef singletonQuotient (values : List Value) : Quotient := {\\n  classes := values.map singleton\\n  representatives := RepresentativeIndex.build {} (values.map singleton)\\n  exactAuthority := RepresentativeIndex.build_sound RepresentativeIndex.empty_sound _\\n}\\n\\ntheorem certify_singletons (values : List Value) :\\n    certify (values.map (fun value => [value])) = some (singletonQuotient values) := by\\n  have classes : (values.map (fun value => [value])).mapM EquivalenceClass.certify? =\\n      some (values.map singleton) := by\\n    induction values with\\n    | nil => rfl\\n    | cons head tail ih => simp [certify_singleton, ih]\\n  simp [certify, classes, singletonQuotient]\\n\\nend LiteralProof\\n\\n/-- The full pre-optimization algorithm succeeds with no edges and its\\nrepresentative map is identity for EVERY Value, including unseen values.\\nNo candidate-completeness or final-result-equality assumption is used. -/\\ntheorem reference_without_unions (roots : List Value) :\\n    ∃ quotient, referenceBuild? roots [] [] = some quotient ∧\\n      ∀ value, quotient.canonical value = value := by\\n  unfold referenceBuild?\\n  simp only [kernelValues, List.append_nil, List.flatMap_nil, mergeExplicit, List.foldl_nil, initial]\\n  rw [← saturateCongruence_reference, LiteralProof.saturation_singletons, LiteralProof.certify_singletons]\\n  exact ⟨_, rfl, LiteralProof.singleton_index {} LiteralProof.empty_self _⟩\\n\\ndef build? (roots : List Value) (persistent runLocal : List UnionEdge) : Option Quotient :=\\n  if persistent.isEmpty && runLocal.isEmpty then some Quotient.literal\\n  else congruenceBuild? roots persistent runLocal\\n\\n/-- A rebuild starts from today's explicit edges. A retained script can save\\njoin discovery, but cannot import yesterday's partition after a retraction. -/\\nstructure PlannedBuild (roots : List Value) (persistent runLocal : List UnionEdge) where\\n  quotient : Option Quotient\\n  plan : Option CongruenceMemo.Entry\\n  exact : quotient = build? roots persistent runLocal\\n\\ndef plannedBuild? (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (previous : Option CongruenceMemo.Entry) : PlannedBuild roots persistent runLocal :=\\n  if empty : persistent.isEmpty && runLocal.isEmpty then\\n    ⟨some Quotient.literal, none, by simp [build?, empty]⟩\\n  else\\n    let values := kernelValues roots (persistent ++ runLocal)\\n    let explicit := mergeExplicit (initial values) (persistent ++ runLocal)\\n    let result := plannedSaturateCongruence values\\n      (previous.map (fun plan => plan.rows.map Prod.fst) |>.getD []) previous values.length explicit\\n    ⟨certify result.partition, result.plan, by\\n      simp only [build?, empty, Bool.false_eq_true, ↓reduceIte, congruenceBuild?, kernelPartition]\\n      rw [plannedSaturateCongruence_exact]\\n      simp only [saturateCongruence, memoSaturateCongruence_exact]\\n      rfl⟩\\n\\ntheorem plannedBuild_exact (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (previous : Option CongruenceMemo.Entry) :\\n    (plannedBuild? roots persistent runLocal previous).quotient = build? roots persistent runLocal :=\\n  (plannedBuild? roots persistent runLocal previous).exact\\n\\ntheorem build_without_unions (roots : List Value) :\\n    build? roots [] [] = some Quotient.literal := rfl\\n\\ntheorem empty_build_preserves_canonical (roots : List Value) :\\n    ∃ previous, referenceBuild? roots [] [] = some previous ∧\\n      ∀ value, Quotient.literal.canonical value = previous.canonical value := by\\n  obtain ⟨previous, found, exact⟩ := reference_without_unions roots\\n  exact ⟨previous, found, fun value => (Quotient.literal_canonical value).trans (exact value).symm⟩\\n\\n/-- This is equality of the actual kernel input, not just of a sampled\\nset of queries. Extraction therefore keeps its complete ordered result. -/\\ntheorem empty_build_preserves_equality (roots : List Value) :\\n    ∃ previous, referenceBuild? roots [] [] = some previous ∧\\n      Quotient.literal.toEquality = previous.toEquality := by\\n  obtain ⟨previous, found, same⟩ := empty_build_preserves_canonical roots\\n  exact ⟨previous, found, Quotient.equality_of_canonical _ _ (funext same)⟩\\n\\ntheorem empty_build_preserves_extraction (roots : List Value) (graph : WorkGraph)\\n    (policy : OutcomePolicy) (work : Value) :\\n    (build? roots [] []).map (fun quotient =>\\n      Extract.runWithPolicy graph quotient.toEquality policy work) =\\n    (referenceBuild? roots [] []).map (fun quotient =>\\n      Extract.runWithPolicy graph quotient.toEquality policy work) := by\\n  obtain ⟨previous, found, same⟩ := empty_build_preserves_equality roots\\n  simp only [build_without_unions, found, Option.map_some, same]\\n\\ntheorem build_with_unions (roots : List Value) (persistent runLocal : List UnionEdge)\\n    (present : persistent ≠ [] ∨ runLocal ≠ []) :\\n    build? roots persistent runLocal = referenceBuild? roots persistent runLocal := by\\n  cases persistent <;> cases runLocal <;> simp_all [build?, congruenceBuild_reference]\\n\\n/-- Even a heuristic Union producer cannot make the checked quotient cross Exact authority. -/\\ntheorem build_equality_preserves_exact {roots persistent runLocal quotient}\\n    (_built : build? roots persistent runLocal = some quotient)\\n    {left right : Value} (same : quotient.toEquality.same left right) :\\n    Value.SameExactFootprint left right := by\\n  exact quotient.equality_preserves_exact same\\n\\nend QuotientBuilder\\n\\n/-- One run owns speculative equality; the durable graph is immutable here. -/\\nstructure RunView where\\n  graph : WorkGraph\\n  quotient : Quotient\\n  localUnions : List UnionEdge\\n\\nnamespace RunView\\n\\ndef make? (graph : WorkGraph) (roots : List Value)\\n    (persistent runEdges : List UnionEdge) : Option RunView := do\\n  let quotient ← QuotientBuilder.build? roots persistent runEdges\\n  pure { graph, quotient, localUnions := runEdges }\\n\\ndef extract (view : RunView) (root : Value) : Extraction :=\\n  Extract.run view.graph view.quotient.toEquality root\\n\\ndef extractWith (view : RunView) (policy : OutcomePolicy) (root : Value) : Extraction :=\\n  Extract.runWithPolicy view.graph view.quotient.toEquality policy root\\n\\n/-- Adding local identity cannot mutate durable graph facts by construction. -/\\n@[simp]\\ntheorem graph_is_immutable (view : RunView) : view.graph = view.graph := rfl\\n\\nend RunView\\n\\nend Eggshell\\n\",[]]"],["Eggshell.QuotientAuthority","[\"module\\npublic import Eggshell.PartitionIndex\\n@[expose] public section\\nnamespace Eggshell.QuotientBuilder.Authority\\nopen Partition\\n\\ndef Safe (partition : RawPartition) : Prop :=\\n  ∀ query, ∀ member ∈ lookup partition query, Value.SameExactFootprint member query\\n\\ntheorem empty_safe : Safe [] := by\\n  intro query member present\\n  have equal : member = query := by simpa [lookup, takeClass] using present\\n  subst member\\n  exact Value.sameExactFootprint_refl query\\n\\ntheorem initial_safe (values : List Value) : Safe (initial values) := by\\n  intro query member present\\n  rw [initial_equivalent_empty values query] at present\\n  exact empty_safe query member present\\n\\ntheorem merge_safe {partition : RawPartition} (valid : Valid partition) (safe : Safe partition)\\n    (left right : Value) (authority : Value.SameExactFootprint left right) :\\n    Safe (merge partition left right) := by\\n  intro query member present\\n  rw [merge_lookup valid] at present\\n  split at present\\n  · exact safe query member present\\n  · split at present\\n    · rename_i _ inside\\n      have querySafe : Value.SameExactFootprint query left := by\\n        rcases List.mem_append.mp inside with first | second\\n        · exact safe left query first\\n        · exact Value.sameExactFootprint_trans (safe right query second)\\n            (Value.sameExactFootprint_symm authority)\\n      apply Value.sameExactFootprint_trans _ (Value.sameExactFootprint_symm querySafe)\\n      rcases List.mem_append.mp present with first | second\\n      · exact safe left member first\\n      · exact Value.sameExactFootprint_trans (safe right member second)\\n          (Value.sameExactFootprint_symm authority)\\n    · exact safe query member present\\n\\ntheorem explicit_safe {partition : RawPartition} (valid : Valid partition) (safe : Safe partition)\\n    (edges : List UnionEdge) : Safe (mergeExplicit partition edges) := by\\n  induction edges generalizing partition with\\n  | nil => exact safe\\n  | cons edge rest ih =>\\n    exact ih (merge_valid valid edge.left edge.right)\\n      (merge_safe valid safe edge.left edge.right edge.exactAuthority)\\n\\ntheorem fold_members (members : List Value) (index : Representatives) (representative : Value) :\\n    members.foldl (fun current member => current.insert member representative) index =\\n      RepresentativeIndex.insertMembers representative index members := by\\n  induction members generalizing index with\\n  | nil => rfl\\n  | cons head tail ih => exact ih _\\n\\ntheorem raw_lookup (partition : RawPartition) (valid : Valid partition)\\n    (index : Representatives) (query : Value) :\\n    (partition.foldl (fun current members => match members with\\n      | [] => current\\n      | head :: _ => members.foldl (fun next member => next.insert member head) current) index).getD query query =\\n      if query ∈ partition.flatten then (lookup partition query).headD query else index.getD query query := by\\n  induction partition generalizing index with\\n  | nil => rfl\\n  | cons members tail ih =>\\n    obtain ⟨_, tailValid, nonempty, apart⟩ := valid_cons.mp valid\\n    cases members with\\n    | nil => exact False.elim (nonempty rfl)\\n    | cons head rest =>\\n      simp only [List.foldl_cons, ih tailValid, List.flatten_cons, List.mem_append, lookup_cons]\\n      by_cases inTail : query ∈ tail.flatten\\n      · have outside : query ∉ head :: rest := fun inside => apart query inside inTail\\n        simp only [inTail, outside, false_or, ↓reduceIte]\\n      · have joined := insertMembers_lookup index head query (head :: rest)\\n        rw [← fold_members] at joined\\n        simp only [List.foldl_cons] at joined\\n        rw [joined]\\n        by_cases inHead : query ∈ head :: rest\\n        · simp only [inTail, inHead, true_or, ↓reduceIte, List.headD_cons]\\n        · simp only [inTail, inHead, or_self, ↓reduceIte]\\n\\ntheorem representatives_safe {partition : RawPartition} (valid : Valid partition) (safe : Safe partition) :\\n    RepresentativeIndex.Sound (representatives partition) := by\\n  intro query\\n  have equation := raw_lookup partition valid ({} : Representatives) query\\n  change (representatives partition).getD query query = _ at equation\\n  rw [equation]\\n  split\\n  · apply Value.sameExactFootprint_symm\\n    apply safe query\\n    have present := lookup_contains partition query\\n    cases found : lookup partition query with\\n    | nil => simp [found] at present\\n    | cons head rest => simp\\n  · simpa using Value.sameExactFootprint_refl query\\n\\ntheorem normalize_authority (index : Representatives) (safe : RepresentativeIndex.Sound index)\\n    (arguments : Refs) (exact : Value) :\\n    exact ∈ Value.refsExactFootprint (normalizeRefs index arguments) ↔\\n      exact ∈ Value.refsExactFootprint arguments := by\\n  cases arguments with\\n  | nil => rfl\\n  | semantic value rest =>\\n    simp only [normalizeRefs, Value.refsExactFootprint, List.mem_append,\\n      normalize_authority index safe rest exact, ← safe value exact]\\n  | exact value rest =>\\n    simp only [normalizeRefs, Value.refsExactFootprint, List.mem_append, List.mem_cons,\\n      normalize_authority index safe rest exact]\\ntermination_by sizeOf arguments\\n\\ntheorem signature_authority (index : Representatives) (safe : RepresentativeIndex.Sound index)\\n    (value : Value) : Value.SameExactFootprint value (signature index value) := by\\n  cases value with\\n  | atom bytes => exact Value.sameExactFootprint_refl _\\n  | apply operator arguments =>\\n    intro exact\\n    exact (normalize_authority index safe arguments exact).symm\\n\\ntheorem application_step (index : Representatives) (indexSafe : RepresentativeIndex.Sound index)\\n    (state : Representatives × RawPartition) (valid : Valid state.2) (safe : Safe state.2)\\n    (seen : ApplicationScan.Sound index state.1) (value : Value) :\\n    Valid (applicationStep index state value).2 ∧ Safe (applicationStep index state value).2 ∧\\n      ApplicationScan.Sound index (applicationStep index state value).1 := by\\n  rcases state with ⟨known, partition⟩\\n  cases value with\\n  | atom bytes => exact ⟨valid, safe, seen⟩\\n  | apply operator arguments =>\\n    cases found : known[signature index (.apply operator arguments)]? with\\n    | none =>\\n      simp only [applicationStep, congruenceStep, found]\\n      exact ⟨valid, safe, ApplicationScan.sound_insert index known seen _⟩\\n    | some prior =>\\n      have authority := signature_authority index indexSafe prior\\n      rw [seen _ _ found] at authority\\n      have same := Value.sameExactFootprint_trans authority\\n        (Value.sameExactFootprint_symm (signature_authority index indexSafe (.apply operator arguments)))\\n      simp only [applicationStep, congruenceStep, found]\\n      exact ⟨merge_valid valid prior _, merge_safe valid safe prior _ same, seen⟩\\n\\ntheorem application_fold (index : Representatives) (indexSafe : RepresentativeIndex.Sound index)\\n    (values : List Value) (state : Representatives × RawPartition) (valid : Valid state.2)\\n    (safe : Safe state.2) (seen : ApplicationScan.Sound index state.1) :\\n    Valid (values.foldl (applicationStep index) state).2 ∧\\n      Safe (values.foldl (applicationStep index) state).2 := by\\n  induction values generalizing state with\\n  | nil => exact ⟨valid, safe⟩\\n  | cons value rest ih =>\\n    have next := application_step index indexSafe state valid safe seen value\\n    exact ih _ next.1 next.2.1 next.2.2\\n\\ntheorem congruence_safe (values : List Value) {partition : RawPartition}\\n    (valid : Valid partition) (safe : Safe partition) :\\n    Valid (congruencePass values partition) ∧ Safe (congruencePass values partition) :=\\n  application_fold (representatives partition) (representatives_safe valid safe) values\\n    ({}, partition) valid safe (by simp [ApplicationScan.Sound])\\n\\ntheorem saturation_safe (values : List Value) (fuel : Nat) {partition : RawPartition}\\n    (valid : Valid partition) (safe : Safe partition) :\\n    Valid (saturateCongruence values fuel partition) ∧ Safe (saturateCongruence values fuel partition) := by\\n  induction fuel generalizing partition with\\n  | zero => exact ⟨valid, safe⟩\\n  | succ fuel ih =>\\n    simp only [saturateCongruence_step]\\n    split\\n    · exact ⟨valid, safe⟩\\n    · have next := congruence_safe values valid safe\\n      exact ih next.1 next.2\\n\\ntheorem footprint_complete {left right : Value} (safe : Value.SameExactFootprint left right) :\\n    Value.sameExactFootprint left right = true := by\\n  simp only [Value.sameExactFootprint, Bool.and_eq_true, List.all_eq_true]\\n  exact ⟨fun value present => List.contains_iff_mem.mpr ((safe value).mp present),\\n    fun value present => List.contains_iff_mem.mpr ((safe value).mpr present)⟩\\n\\ntheorem class_exists {partition : RawPartition} (valid : Valid partition) (safe : Safe partition)\\n    (members : RawClass) (stored : members ∈ partition) :\\n    ∃ item, EquivalenceClass.certify? members = some item := by\\n  cases members with\\n  | nil => exact False.elim (valid.2 [] stored rfl)\\n  | cons head tail =>\\n    have selected := lookup_member valid stored (List.mem_cons_self (a := head) (l := tail))\\n    have allSafe : (head :: tail).all (fun member => Value.sameExactFootprint member head) = true := by\\n      apply List.all_eq_true.mpr\\n      intro member present\\n      apply footprint_complete\\n      exact safe head member (selected ▸ present)\\n    simp only [EquivalenceClass.certify?, allSafe, ↓reduceDIte]\\n    exact ⟨_, rfl⟩\\n\\n/-- Every valid authority-safe partition passes the existing executable\\ncertificate. This proves success; it does not assume the old builder returned\\na successful quotient before comparing two results. -/\\ntheorem certify_exists {partition : RawPartition} (valid : Valid partition) (safe : Safe partition) :\\n    ∃ quotient, certify partition = some quotient := by\\n  have each := class_exists valid safe\\n  have mapped (items : RawPartition)\\n      (accepted : ∀ members ∈ items, ∃ item, EquivalenceClass.certify? members = some item) :\\n      ∃ classes, items.mapM EquivalenceClass.certify? = some classes := by\\n    induction items with\\n    | nil => exact ⟨[], rfl⟩\\n    | cons head tail ih =>\\n      obtain ⟨item, first⟩ := accepted head (by simp)\\n      obtain ⟨items, rest⟩ := ih (fun members member => accepted members (by simp [member]))\\n      exact ⟨item :: items, by simp [List.mapM_cons, first, rest]⟩\\n  obtain ⟨classes, found⟩ := mapped partition each\\n  simp [certify, found]\\n\\ntheorem reference_exists (roots : List Value) (persistent runLocal : List UnionEdge) :\\n    ∃ quotient, referenceBuild? roots persistent runLocal = some quotient := by\\n  dsimp only [referenceBuild?]\\n  rw [← saturateCongruence_reference]\\n  apply certify_exists\\n  · exact (saturation_safe _ _ (explicit_valid (initial_valid _) _)\\n      (explicit_safe (initial_valid _) (initial_safe _) _)).1\\n  · exact (saturation_safe _ _ (explicit_valid (initial_valid _) _)\\n      (explicit_safe (initial_valid _) (initial_safe _) _)).2\\n\\nend Eggshell.QuotientBuilder.Authority\\n\",[]]"],["Eggshell.RankMemo","[\"module\\n\\npublic import Eggshell.SurfaceJoin\\n\\n@[expose] public section\\nnamespace Eggshell.Matcher.RankMemo\\nopen Lean LogicalText Persistence\\n\\n/-- Positions are hints, never serialized evidence or an erased certificate.\\nThe current complete source domain verifies every retained calculation. -/\\nabbrev Saved := List (String × List Nat)\\ndef allowance : Nat := 262144\\ndef frontierAllowance : Nat := 16384\\ndef slots : Nat := 16\\nabbrev Slot := Fin slots\\ninductive Lane where\\n  | rank\\n  | selection\\n  | context\\n  deriving DecidableEq\\n\\ndef Lane.prefix : Lane → String\\n  | .rank => \\\"memo:rank:\\\"\\n  | .selection => \\\"memo:selection:\\\"\\n  | .context => \\\"memo:context:\\\"\\ndef slotOf (key : String) : Slot :=\\n  ⟨(hash key).toNat % slots, Nat.mod_lt _ (by decide)⟩\\ndef slotRow (slot : Slot) (lane : Lane := .rank) : String := lane.prefix ++ toString slot.val\\ndef row (key : String) (lane : Lane := .rank) : String := slotRow (slotOf key) lane\\ndef codec : DB.Wire.Codec Saved := DB.Wire.list (DB.Wire.text.product (DB.Wire.list DB.Wire.natural))\\n\\ntheorem codec_roundtrip (saved : Saved) (tail : List UInt8) :\\n    codec.decode (codec.encode saved ++ tail) = .ok (saved, tail) := codec.roundtrip saved tail\\n\\ndef binding (query target : Pattern) : String :=\\n  toString query.locator ++ \\\":\\\" ++ toString target.locator\\n\\nstructure Input where\\n  query : LogicalText.T\\n  target : LogicalText.T\\n  weights : List Nat\\n  queryLocator : UInt64\\n  targetLocator : UInt64\\n  deriving DecidableEq\\n\\ndef Input.locator (input : Input) : UInt64 × UInt64 × UInt64 :=\\n  (input.queryLocator, input.targetLocator, hash input.weights)\\n\\ndef reference (input : Input) : List Evidence :=\\n  referenceRank input.weights (makePattern input.query) (makePattern input.target)\\n\\nstructure Entry where\\n  input : Input\\n  ranked : List Evidence\\n  exact : ranked = reference input\\n\\nabbrev Cache := Std.HashMap (UInt64 × UInt64 × UInt64) Entry\\n\\ndef provider (cache : Cache) : RankProvider := fun weights query target =>\\n  let input : Input := ⟨query.logical, target.logical, weights, query.locator, target.locator⟩\\n  match cache[input.locator]? with\\n  | some entry =>\\n      if entry.input = input then entry.ranked else reference input\\n  | none => reference input\\n\\ntheorem provider_exact (cache : Cache) : provider cache = referenceRank := by\\n  funext weights query target\\n  simp only [provider]\\n  split\\n  · split\\n    · rename_i same\\n      rw [Entry.exact, same]\\n      simp only [reference, ← Pattern.canonical query, ← Pattern.canonical target]\\n    · simp only [reference, ← Pattern.canonical query, ← Pattern.canonical target]\\n  · simp only [reference, ← Pattern.canonical query, ← Pattern.canonical target]\\n\\n/-- Unlike a positive-only trace, this certifier checks the entire current\\njoin count, every source ordinal, permutation and stable frequency ordering.\\nMissing/new/duplicate/out-of-range positions cannot produce a stale answer. -/\\ndef obtainUsing (saved : Saved) (weights : List Nat) (query target : Pattern)\\n    (source : EvidenceReplay.Indexed (surfaceEvidence query target)) :\\n    {ranked : List Evidence // ranked = referenceRank weights query target} ×\\n      Option (String × List Nat) × Bool := Id.run do\\n  if source.count < 32 || source.count > frontierAllowance then\\n    return (⟨referenceRank weights query target, rfl⟩, none, false)\\n  let key := binding query target\\n  if let some positions := (saved.find? (·.1 == key)).map Prod.snd then\\n    if let some (ranked, repaired) := EvidenceReplay.repairIndexed weights source positions then\\n      return (ranked, some (key, repaired), true)\\n  let generated := EvidenceReplay.generate weights (surfaceEvidence query target)\\n  return (generated.1, some (key, generated.2), false)\\n\\ndef obtain (saved : Saved) (weights : List Nat) (query target : Pattern) :=\\n  obtainUsing saved weights query target (SurfaceJoin.current query target)\\n\\nstructure Prepared where\\n  cache : Cache := {}\\n  saved : Saved := []\\n  charged : Nat := 0\\n  bounded : charged ≤ allowance := by decide\\n  reused : Nat := 0\\n  computed : Nat := 0\\n\\n/-- Only demanded orders are retained. The additive encoded charge bounds\\nthe optional durable row; it is not a claim about allocator RSS. -/\\ndef Prepared.addUsing (prepared : Prepared) (previous : Saved) (weights : List Nat)\\n    (query target : Pattern) (source : EvidenceReplay.Indexed (surfaceEvidence query target)) : Prepared :=\\n  -- Tiny joins are faster to execute directly. Do not hash and retain an\\n  -- additional result merely because a memo interface is available.\\n  if source.count < 32 || source.count > frontierAllowance then prepared else\\n  let found := obtainUsing previous weights query target source\\n  let input : Input := ⟨query.logical, target.logical, weights, query.locator, target.locator⟩\\n  let entry : Entry := ⟨input, found.1.val, by\\n    rw [found.1.property]\\n    change referenceRank weights query target =\\n      referenceRank weights (makePattern query.logical) (makePattern target.logical)\\n    rw [← Pattern.canonical query, ← Pattern.canonical target]⟩\\n  let cache := prepared.cache.insert input.locator entry\\n  let reused := prepared.reused + (if found.2.2 then 1 else 0)\\n  let computed := prepared.computed + (if found.2.2 then 0 else 1)\\n  match found.2.1 with\\n  | none => { prepared with cache, reused, computed }\\n  | some retained =>\\n      if prepared.saved.any (·.1 == retained.1) then { prepared with cache, reused, computed }\\n      else\\n        let cost := codec.encodedSize [retained]\\n        if fits : prepared.charged + cost ≤ allowance then\\n          { cache, saved := retained :: prepared.saved, charged := prepared.charged + cost,\\n            bounded := fits, reused, computed }\\n        else { prepared with cache, reused, computed }\\n\\ndef Prepared.add (prepared : Prepared) (previous : Saved) (weights : List Nat)\\n    (query target : Pattern) : Prepared :=\\n  prepared.addUsing previous weights query target (SurfaceJoin.current query target)\\n\\ndef readSlot (snapshot : Store.Snapshot) (slot : Slot) (lane : Lane := .rank) : IO Saved := do\\n  let tag := slotRow slot lane\\n  let some _ ← snapshot.get tag | return []\\n  let size ← Store.getNat snapshot.get tag\\n  unless size ≤ allowance do throw (IO.userError \\\"rank memo exceeds its encoded allowance\\\")\\n  let payloadSize ← Store.getNat snapshot.get (Store.key tag 0)\\n  unless payloadSize == size do throw (IO.userError \\\"rank memo payload differs from its bounded marker\\\")\\n  let bytes ← Store.readChunks snapshot snapshot.get tag 0\\n  let (saved, tail) ← IO.ofExcept (codec.decode bytes.toList)\\n  unless saved.length == 1 && tail.isEmpty && (codec.encode saved).toByteArray == bytes do\\n    throw (IO.userError \\\"noncanonical rank memo\\\")\\n  pure saved\\n\\n/-- A slot collision only loses an optional hint. The complete locator must\\nagree before positions reach the current-domain certifier. -/\\ndef select (key : String) (saved : Saved) : Saved := saved.filter (·.1 == key)\\n\
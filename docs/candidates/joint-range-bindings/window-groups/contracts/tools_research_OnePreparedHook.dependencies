set.toUInt64 ⟨count,Nat.min_le_left _ _⟩\\n    unless page.size == count do return none\\n    root := SourceEvidence.stepRoot root page\\n    offset := offset+count\\n    for byte in page do\\n      if byte == 10 then\\n        if !omitted then\\n          if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text\\n        pending := ByteArray.empty\\n        omitted := false\\n        line := line+1\\n      else if !omitted then\\n        if pending.size < maxLine then pending := pending.push byte\\n        else pending := ByteArray.empty; omitted := true\\n  if !pending.isEmpty && !omitted then\\n    if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\\n  unless (← IO.monoMsNow) < deadline && FileSystem.stableRead before after current offset &&\\n      Blake3.hex root.val == expected.root do return none\\n  return some state\\n\\ndef finish (workspace : System.FilePath) (captured : SourceEvidence.Capture)\\n    (raw : String) (deadline : Nat) : IO Captured := do\\n  let inputs := captured.record.files.toArray\\n  let failed := fun reason => ({implementation,inputs := #[],complete := false,aliases := #[],failure := some reason} : Captured)\\n  unless captured.record.valid && captured.record.files == captured.probes.map (·.file) do\\n    return failed \\\"input-not-captured\\\"\\n  unless raw.utf8ByteSize ≤ 2*1024*1024 do return failed \\\"output-budget\\\"\\n  let rows := outputs raw\\n  let trie := Trie.prepare rows\\n  let characters := raw.toList.toArray\\n  let mut state := trie.start\\n  for fileIndex in [:inputs.size] do\\n    let some file := inputs[fileIndex]? | return failed \\\"input-domain\\\"\\n    let result ← try scan workspace file fileIndex trie state deadline catch _ => pure none\\n    let some next := result | return failed \\\"input-no
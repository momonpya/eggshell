[["BoundedSample","[\"module\\npublic import Std.Data.TreeMap.Lemmas\\n\\n@[expose] public section\\nnamespace Eggshell.BoundedSample\\n\\n/-- Keep the least ranking keys, using a balanced tree whose resident size\\nis independent of the source population. The rank includes the original key\\nafter the hash, so collisions still have a deterministic total order. -/\\nstructure State (α : Type) (capacity : Nat) where\\n  entries : Std.TreeMap String α := ∅\\n  bounded : entries.size ≤ capacity\\n\\ndef empty : State α capacity := ⟨∅,by simp⟩\\n\\ndef State.insert (state : State α capacity) (key : String) (value : α) : State α capacity :=\\n  let next := state.entries.insert key value\\n  if bounded : next.size ≤ capacity then ⟨next,bounded⟩\\n  else\\n    have nonempty : next.isEmpty = false := by\\n      rw [Std.TreeMap.isEmpty_eq_size_eq_zero]\\n      simp only [beq_eq_false_iff_ne]\\n      omega\\n    let last := next.maxKey nonempty\\n    ⟨next.erase last,by\\n      have previous := state.bounded\\n      have grown := Std.TreeMap.size_insert_le (t := state.entries) (k := key) (v := value)\\n      have retained := Std.TreeMap.contains_maxKey (t := next) (he := nonempty)\\n      rw [Std.TreeMap.size_erase]\\n      simp only [last,retained,↓reduceIte]\\n      dsimp [next] at *\\n      omega⟩\\n\\ntheorem resident_bounded (state : State α capacity) : state.entries.size ≤ capacity := state.bounded\\n\\ntheorem insert_bounded (state : State α capacity) (key : String) (value : α) :\\n    (state.insert key value).entries.size ≤ capacity := (state.insert key value).bounded\\n\\nend Eggshell.BoundedSample\\n\",[]]"],["Eggshell.AdvisoryFrontier","[\"module\\n\\npublic import Eggshell.PluginModel\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin\\nopen Lean\\n\\n/-- Stable DB identity and its append-only root insertion frontier. This is\\npublication metadata, never a claim that an omitted body was delivered. -/\\nstructure AdvisoryFrontier where\\n  identity : String\\n  nextRoot : Nat\\n  deriving ToJson, FromJson, BEq\\n\\n/-- A position checked against the exact pinned source that supplies it. -/\\nstructure AdvisoryPosition where\\n  frontier : AdvisoryFrontier\\n  ordinal : Nat\\n  published : ordinal < frontier.nextRoot\\n\\ndef advisoryFrontierKey (question : String) (frontier : AdvisoryFrontier) : String :=\\n  \\\"a:\\\" ++ (toJson (question, frontier)).compress\\n\\ndef acceptedAdvisoryFrontier (question identity : String) (receipts : List String) : Option Nat :=\\n  (receipts.filterMap fun receipt => do\\n    if !receipt.startsWith \\\"a:\\\" then none else do\\n      let json ← (Json.parse (receipt.drop 2).toString).toOption\\n      let (recorded, frontier) ← (fromJson? json : Except String (String × AdvisoryFrontier)).toOption\\n      if recorded == question && frontier.identity == identity then some frontier.nextRoot else none).head?\\n\\n/-- Reranking is not a new request. After the first accepted packet, old\\nadvisory owners stay closed. New publications, another question/source and\\nindependently grounded native operations remain eligible. -/\\ndef advisoryPositionAllowed (accepted : Option Nat) (ordinal : Nat) : Bool :=\\n  accepted.all (fun limit => decide (limit ≤ ordinal))\\n\\ntheorem old_advisory_position_closed (ordinal limit : Nat) (old : ordinal < limit) :\\n    advisoryPositionAllowed (some limit) ordinal = false := by\\n  simp [advisoryPositionAllowed, Nat.not_le.mpr old]\\n\\ntheorem new_advisory_position_retained (ordinal limit : Nat) (fresh : limit ≤ ordinal) :\\n    advisoryPositionAllowed (some limit) ordinal = true := by\\n  simp [advisoryPositionAllowed, fresh]\\n\\ntheorem unaccepted_advisory_position_retained (ordinal : Nat) :\\n    advisoryPositionAllowed none ordinal = true := rfl\\n\\ndef advisoryOwnerAllowed (question : String) (receipts : List String)\\n    (positions : List AdvisoryPosition) : Bool :=\\n  positions.isEmpty || positions.any (fun position => advisoryPositionAllowed\\n    (acceptedAdvisoryFrontier question position.frontier.identity receipts) position.ordinal)\\n\\ndef advisoryTransportAllowed (grounded : Bool) (excluded : List Value) (owner : Value) : Bool :=\\n  grounded || !excluded.contains owner\\n\\ntheorem grounded_transport_retained (excluded : List Value) (owner : Value) :\\n    advisoryTransportAllowed true excluded owner = true := by\\n  simp [advisoryTransportAllowed]\\n\\ntheorem excluded_advisory_transport_closed (excluded : List Value) (owner : Value)\\n    (present : excluded.contains owner = true) :\\n    advisoryTransportAllowed false excluded owner = false := by\\n  unfold advisoryTransportAllowed\\n  rw [present]\\n  rfl\\n\\nend Eggshell.Plugin\\n\",[]]"],["Eggshell.AppendUnique","[\"module\\npublic import Std.Data.HashSet.Lemmas\\n\\n@[expose] public section\\nnamespace Eggshell.AppendUnique\\n\\nvariable {α β : Type} [BEq β] [LawfulBEq β] [Hashable β]\\n\\ndef reference (key : α → β) (base added : List α) : List α :=\\n  added.foldl (fun current item =>\\n    if current.any (fun old => key old == key item) then current\\n    else current ++ [item]) base\\n\\ndef Seen (key : α → β) (known : Std.HashSet β) (items : List α) : Prop :=\\n  ∀ value, known.contains value = items.any (fun item => key item == value)\\n\\n/-- Keep original payloads; the set only answers exact membership. -/\\ndef loop (key : α → β) (known : Std.HashSet β) (added reversed : List α) :\\n    List α :=\\n  match added with\\n  | [] => reversed\\n  | item :: rest =>\\n      if known.contains (key item) then loop key known rest reversed\\n      else loop key (known.insert (key item)) rest (item :: reversed)\\n\\ntheorem loop_exact (key : α → β) (base added : List α) (known : Std.HashSet β)\\n    (reversed : List α) (seen : Seen key known (base ++ reversed.reverse)) :\\n    base ++ (loop key known added reversed).reverse =\\n      reference key (base ++ reversed.reverse) added := by\\n  induction added generalizing known reversed with\\n  | nil => rfl\\n  | cons item rest ih =>\\n      change base ++ (loop key known (item :: rest) reversed).reverse =\\n        reference key (if (base ++ reversed.reverse).any (fun old => key old == key item)\\n          then base ++ reversed.reverse else (base ++ reversed.reverse) ++ [item]) rest\\n      rw [← seen (key item)]\\n      cases found : known.contains (key item) with\\n      | true => simpa only [loop, found, ↓reduceIte] using ih known reversed seen\\n      | false =>\\n          have next : base ++ (item :: reversed).reverse =\\n              (base ++ reversed.reverse) ++ [item] := by\\n            simp only [List.reverse_cons, List.append_assoc]\\n          have nextSeen : Seen key (known.insert (key item)) (base ++ (item :: reversed).reverse) := by\\n            intro value\\n            rw [next, List.any_append, ← seen value]\\n            simp [Std.HashSet.contains_insert, Bool.or_comm]\\n          simpa only [loop, found, Bool.false_eq_true, ↓reduceIte, next] using\\n            ih (known.insert (key item)) (item :: reversed) nextSeen\\n\\n/-- Existing duplicates stay; unseen additions retain first payload and order.\\nBoth prefix copying and repeated complete membership scans disappear. -/\\ndef merge (key : α → β) (base added : List α) : List α :=\\n  base ++ (loop key (Std.HashSet.ofList (base.map key)) added []).reverse\\n\\ntheorem merge_exact (key : α → β) (base added : List α) :\\n    merge key base added = reference key base added := by\\n  have seen : Seen key (Std.HashSet.ofList (base.map key)) (base ++ [].reverse) := by\\n    intro value\\n    simp only [List.reverse_nil, List.append_nil, Std.HashSet.contains_ofList, List.contains_map]\\n    exact List.any_congr rfl (fun _ => BEq.comm)\\n  simpa only [merge, List.reverse_nil, List.append_nil] using\\n    loop_exact key base added (Std.HashSet.ofList (base.map key)) [] seen\\n\\nend Eggshell.AppendUnique\\n\",[]]"],["Eggshell.AtomQuotient","[\"module\\npublic import Eggshell.PartitionIndex\\n@[expose] public section\\nnamespace Eggshell.QuotientBuilder.AtomQuotient\\nopen Partition\\n\\ndef isAtom : Value → Bool\\n  | .atom _ => true\\n  | .apply _ _ => false\\n\\n/-- Every equivalence class has one constructor kind. This is required:\\nan explicit Atom/application Union can otherwise expose new Atom aliases\\nthrough application congruence. -/\\ndef Homogeneous (partition : RawPartition) : Prop :=\\n  ∀ query, ∀ member ∈ lookup partition query, isAtom member = isAtom query\\n\\ntheorem empty_homogeneous : Homogeneous [] := by\\n  intro query member present\\n  exact congrArg isAtom (by simpa [lookup, takeClass] using present)\\n\\ntheorem initial_homogeneous (values : List Value) : Homogeneous (initial values) := by\\n  intro query member present\\n  rw [initial_equivalent_empty values query] at present\\n  exact empty_homogeneous query member present\\n\\ntheorem merge_homogeneous {partition : RawPartition} (valid : Valid partition)\\n    (homogeneous : Homogeneous partition) (left right : Value)\\n    (kinds : isAtom left = isAtom right) : Homogeneous (merge partition left right) := by\\n  intro query member present\\n  rw [merge_lookup valid] at present\\n  split at present\\n  · exact homogeneous query member present\\n  · split at present\\n    · rename_i _ inside\\n      have queryKind : isAtom query = isAtom left := by\\n        rcases List.mem_append.mp inside with first | second\\n        · exact homogeneous left query first\\n        · exact (homogeneous right query second).trans kinds.symm\\n      apply Eq.trans _ queryKind.symm\\n      rcases List.mem_append.mp present with first | second\\n      · exact homogeneous left member first\\n      · exact (homogeneous right member second).trans kinds.symm\\n    · exact homogeneous query member present\\n\\ntheorem merge_applications {partition : RawPartition} (valid : Valid partition)\\n    (homogeneous : Homogeneous partition) (left right : Value)\\n    (leftApp : isAtom left = false) (rightApp : isAtom right = false) (bytes : ByteArray) :\\n    lookup (merge partition left right) (.atom bytes) = lookup partition (.atom bytes) := by\\n  have outside : Value.atom bytes ∉ lookup partition left ++ lookup partition right := by\\n    intro member\\n    rcases List.mem_append.mp member with first | second\\n    · have impossible := (homogeneous left _ first).trans leftApp\\n      cases impossible\\n    · have impossible := (homogeneous right _ second).trans rightApp\\n      cases impossible\\n  rw [merge_lookup valid, if_neg outside]\\n  exact ite_self _\\n\\ndef HomogeneousEdges (edges : List UnionEdge) : Prop :=\\n  ∀ edge ∈ edges, isAtom edge.left = isAtom edge.right\\n\\ntheorem explicit_homogeneous {partition : RawPartition} (valid : Valid partition)\\n    (homogeneous : Homogeneous partition) (edges : List UnionEdge) (kinds : HomogeneousEdges edges) :\\n    Homogeneous (mergeExplicit partition edges) := by\\n  induction edges generalizing partition with\\n  | nil => exact homogeneous\\n  | cons edge rest ih =>\\n    have sameKind := kinds edge (by simp)\\n    exact ih (merge_valid valid edge.left edge.right)\\n      (merge_homogeneous valid homogeneous edge.left edge.right sameKind)\\n      (fun next member => kinds next (by simp [member]))\\n\\ntheorem signature_kind (index : Representatives) (value : Value) :\\n    isAtom (signature index value) = isAtom value := by cases value <;> rfl\\n\\ntheorem application_step (index : Representatives) (state : Representatives × RawPartition)\\n    (valid : Valid state.2) (homogeneous : Homogeneous state.2)\\n    (sound : ApplicationScan.Sound index state.1) (value : Value) :\\n    Valid (applicationStep index state value).2 ∧\\n    Homogeneous (applicationStep index state value).2 ∧\\n    ApplicationScan.Sound index (applicationStep index state value).1 ∧\\n    ∀ bytes, lookup (applicationStep index state value).2 (.atom bytes) = lookup state.2 (.atom bytes) := by\\n  rcases state with ⟨seen, partition⟩\\n  cases value with\\n  | atom bytes => exact ⟨valid, homogeneous, sound, fun _ => rfl⟩\\n  | apply operator arguments =>\\n    cases found : seen[signature index (.apply operator arguments)]? with\\n    | none =>\\n      simp only [applicationStep, congruenceStep, found]\\n      exact ⟨valid, homogeneous, ApplicationScan.sound_insert index seen sound _, fun _ => True.intro⟩\\n    | some prior =>\\n      have priorApp : isAtom prior = false := by\\n        rw [← signature_kind index prior, sound _ _ found]\\n        rfl\\n      simp only [applicationStep, congruenceStep, found]\\n      exact ⟨merge_valid valid prior _, merge_homogeneous valid homogeneous prior _ priorApp,\\n        sound, merge_applications valid homogeneous prior _ priorApp rfl⟩\\n\\ntheorem application_fold (index : Representatives) (values : List Value)\\n    (state : Representatives × RawPartition) (valid : Valid state.2)\\n    (homogeneous : Homogeneous state.2) (sound : ApplicationScan.Sound index state.1) :\\n    Valid (values.foldl (applicationStep index) state).2 ∧\\n    Homogeneous (values.foldl (applicationStep index) state).2 ∧\\n    ∀ bytes, lookup (values.foldl (applicationStep index) state).2 (.atom bytes) = lookup state.2 (.atom bytes) := by\\n  induction values generalizing state with\\n  | nil => exact ⟨valid, homogeneous, fun _ => rfl⟩\\n  | cons value rest ih =>\\n    have next := application_step index state valid homogeneous sound value\\n    have result := ih _ next.1 next.2.1 next.2.2.1\\n    exact ⟨result.1, result.2.1, fun bytes => (result.2.2 bytes).trans (next.2.2.2 bytes)⟩\\n\\ntheorem congruence_atoms (values : List Value) {partition : RawPartition}\\n    (valid : Valid partition) (homogeneous : Homogeneous partition) :\\n    Valid (congruencePass values partition) ∧ Homogeneous (congruencePass values partition) ∧\\n    ∀ bytes, lookup (congruencePass values partition) (.atom bytes) = lookup partition (.atom bytes) :=\\n  application_fold (representatives partition) values ({}, partition) valid homogeneous\\n    (by simp [ApplicationScan.Sound])\\n\\ntheorem saturation_atoms (values : List Value) (fuel : Nat) {partition : RawPartition}\\n    (valid : Valid partition) (homogeneous : Homogeneous partition) :\\n    Valid (saturateCongruence values fuel partition) ∧\\n    Homogeneous (saturateCongruence values fuel partition) ∧\\n    ∀ bytes, lookup (saturateCongruence values fuel partition) (.atom bytes) = lookup partition (.atom bytes) := by\\n  induction fuel generalizing partition with\\n  | zero => exact ⟨valid, homogeneous, fun _ => rfl⟩\\n  | succ fuel ih =>\\n    simp only [saturateCongruence_step]\\n    split\\n    · exact ⟨valid, homogeneous, fun _ => rfl⟩\\n    · have next := congruence_atoms values valid homogeneous\\n      have result := ih next.1 next.2.1\\n      exact ⟨result.1, result.2.1, fun bytes => (result.2.2 bytes).trans (next.2.2 bytes)⟩\\n\\n/-- Full runtime saturation, for any corpus and fuel, has exactly the same\\nordered Atom classes as the explicit constructor-preserving Union fold.\\nApplication/application unions and congruence cannot create Atom aliases.\\nAtom/application unions are deliberately outside this certified domain. -/\\ntheorem independent (values : List Value) (fuel : Nat) (edges : List UnionEdge)\\n    (kinds : HomogeneousEdges edges) (bytes : ByteArray) :\\n    lookup (saturateCongruence values fuel (mergeExplicit (initial values) edges)) (.atom bytes) =\\n      lookup (mergeExplicit [] edges) (.atom bytes) :=\\n  ((saturation_atoms values fuel (explicit_valid (initial_valid values) edges)\\n    (explicit_homogeneous (initial_valid values) (initial_homogeneous values) edges kinds)).2.2 bytes).trans\\n    (explicit_independent values edges (.atom bytes))\\n\\ntheorem certified_aliases (values : List Value) (fuel : Nat) (edges : List UnionEdge)\\n    (kinds : HomogeneousEdges edges) (quotient : Quotient)\\n    (built : certify (saturateCongruence values fuel (mergeExplicit (initial values) edges)) = some quotient)\\n    (bytes : ByteArray) (value : Value) :\\n    quotient.toEquality.same (.atom bytes) value = true ↔\\n      value ∈ lookup (mergeExplicit [] edges) (.atom bytes) := by\\n  have valid := (saturation_atoms values fuel (explicit_valid (initial_valid values) edges)\\n    (explicit_homogeneous (initial_valid values) (initial_homogeneous values) edges kinds)).1\\n  rw [Quotient.same_iff_canonical_eq, certify_lookup valid built, certify_lookup valid built,\\n    heads_equal valid, independent values fuel edges kinds bytes]\\n\\ntheorem reference_aliases (roots : List Value) (edges : List UnionEdge)\\n    (kinds : HomogeneousEdges edges) (quotient : Quotient)\\n    (built : referenceBuild? roots [] edges = some quotient) (bytes : ByteArray) (value : Value) :\\n    quotient.toEquality.same (.atom bytes) value = true ↔\\n      value ∈ lookup (mergeExplicit [] edges) (.atom bytes) := by\\n  simp only [referenceBuild?, List.nil_append, ← saturateCongruence_reference] at built\\n  exact certified_aliases _ _ edges kinds quotient built bytes value\\n\\ntheorem build_aliases (roots : List Value) (edges : List UnionEdge)\\n    (kinds : HomogeneousEdges edges) (quotient : Quotient)\\n    (built : build? roots [] edges = some quotient) (bytes : ByteArray) (value : Value) :\\n    quotient.toEquality.same (.atom bytes) value = true ↔\\n      value ∈ lookup (mergeExplicit [] edges) (.atom bytes) := by\\n  by_cases empty : edges = []\\n  · subst edges\\n    have literal := Option.some.inj built\\n    subst quotient\\n    simp [Quotient.toEquality, Quotient.literal_canonical, mergeExplicit, lookup, takeClass, eq_comm]\\n  · rw [build_with_unions roots [] edges (Or.inr empty)] at built\\n    exact reference_aliases roots edges kinds quotient built bytes value\\n\\n/-- A query-local Work class index. Its size depends on explicit Union\\nendpoints, never on the stored corpus, Outcome payloads or root inventory. -/\\nstructure Index (edges : List UnionEdge) where\\n  partition : RawPartition\\n  exact : partition = mergeExplicit [] edges\\n  homogeneous : HomogeneousEdges edges\\n\\ndef Index.empty : Index [] := ⟨[], rfl, by simp [HomogeneousEdges]⟩\\n\\n/-- Extend the existing classes with new edges only. The ordered class\\nrepresentation equals a fresh fold over the complete edge sequence. -/\\ndef Index.append (index : Index edges) (added : List UnionEdge)\\n    (kinds : HomogeneousEdges added) : Index (edges ++ added) where\\n  partition := mergeExplicit index.partition added\\n  exact := by simp only [index.exact, mergeExplicit, List.foldl_append]\\n  homogeneous := by\\n    intro edge member\\n    rcases List.mem_append.mp member with old | new\\n    · exact index.homogeneous edge old\\n    · exact kinds edge new\\n\\ndef Index.append? (index : Index edges) (added : List UnionEdge) :\\n    Option (Index (edges ++ added)) :=\\n  if checked : added.all (fun edge => isAtom edge.left == isAtom edge.right) then\\n    some (index.append added (by\\n      intro edge member\\n      exact beq_iff_eq.mp ((List.all_eq_true.mp checked) edge member)))\\n  else none\\n\\n/-- Begin a run with an empty local delta, preserving the certified ordered\\npartition explicitly rather than transporting an executable Option through\\na proposition about list append. -/\\ndef Index.beginRun (index : Index edges) : Index (edges ++ []) := {\\n  partition := index.partition\\n  exact := by simpa only [List.append_nil] using index.exact\\n  homogeneous := by simpa only [List.append_nil] using index.homogeneous }\\n\\ntheorem Index.beginRun_partition (index : Index edges) :\\n    index.beginRun.partition = index.partition := rfl\\n\\ntheorem Index.append_partition (index : Index edges) (added : List UnionEdge)\\n    (kinds : HomogeneousEdges added) :\\n    (index.append added kinds).partition = mergeExplicit [] (edges ++ added) :=\\n  (index.append added kinds).exact\\n\\ntheorem Index.append_no_replay (index : Index edges) (added : List UnionEdge)\\n    (kinds : HomogeneousEdges added) :\\n    (index.append added kinds).partition = mergeExplicit index.partition added := rfl\\n\\ndef Index.values (index : Index edges) (work : Value) : List Value :=\\n  lookup index.partition work\\n\\ntheorem Index.values_fresh (index fresh : Index edges) (work : Value) :\\n    index.values work = fresh.values work := by\\n  simp only [Index.values, index.exact, fresh.exact]\\n\\ntheorem Index.values_exact (index : Index edges) (quotient : Quotient)\\n    (certified : certify index.partition = some quotient) (work value : Value) :\\n    value ∈ index.values work ↔ quotient.toEquality.same work value = true := by\\n  have valid : Valid index.partition := index.exact ▸ explicit_valid valid_nil edges\\n  rw [Quotient.same_iff_canonical_eq, certify_lookup valid certified,\\n    certify_lookup valid certified, heads_equal valid]\\n  rfl\\n\\ndef prepare (edges : List UnionEdge) : Option (Index edges) :=\\n  if checked : edges.all (fun edge => isAtom edge.left == isAtom edge.right) then\\n    some ⟨mergeExplicit [] edges, rfl, by\\n      intro edge member\\n      exact beq_iff_eq.mp ((List.all_eq_true.mp checked) edge member)⟩\\n  else none\\n\\ndef Index.aliases (index : Index edges) (bytes : ByteArray) : List Value :=\\n  lookup index.partition (.atom bytes)\\n\\ntheorem Index.aliases_are_atoms (index : Index edges) (bytes : ByteArray) (value : Value)\\n    (present : value ∈ index.aliases bytes) : isAtom value = true := by\\n  have homogeneous : Homogeneous index.partition := by\\n    rw [index.exact]\\n    exact explicit_homogeneous valid_nil empty_homogeneous edges index.homogeneous\\n  exact homogeneous (.atom bytes) value present\\n\\ntheorem Index.aliases_exact (index : Index edges) (roots : List Value) (quotient : Quotient)\\n    (built : build? roots [] edges = some quotient) (bytes : ByteArray) (value : Value) :\\n    value ∈ index.aliases bytes ↔ quotient.toEquality.same (.atom bytes) value = true := by\\n  rw [Index.aliases, index.exact]\\n  exact (build_aliases roots edges index.homogeneous quotient built bytes value).symm\\n\\n/-- Checking literal child postings for every Atom alias is exactly the\\nfull quotient's subwork membership, including children outside the demand\\nclosure. A structured sibling cannot create an Atom alias. -/\\ntheorem Index.subwork_exact (index : Index edges) (roots : List Value) (quotient : Quotient)\\n    (built : build? roots [] edges = some quotient) (bytes : ByteArray) (children : List Value) :\\n    (index.aliases bytes).any (fun alias => children.contains alias) =\\n      children.any (quotient.toEquality.same (.atom bytes)) := by\\n  apply Bool.eq_iff_iff.mpr\\n  simp only [List.any_eq_true, List.contains_iff_mem, index.aliases_exact roots quotient built]\\n  constructor\\n  · rintro ⟨value, same, member⟩\\n    exact ⟨value, member, same⟩\\n  · rintro ⟨value, member, same⟩\\n    exact ⟨value, same, member⟩\\n\\ntheorem prepare_complete (edges : List UnionEdge) (kinds : HomogeneousEdges edges) :\\n    (prepare edges).isSome = true := by\\n  have accepted : edges.all (fun edge => isAtom edge.left == isAtom edge.right) = true := by\\n    apply List.all_eq_true.mpr\\n    intro edge member\\n    exact beq_iff_eq.mpr (kinds edge member)\\n  simp [prepare, accepted]\\n\\ntheorem prepare_mixed_rejected (edges : List UnionEdge) (edge : UnionEdge)\\n    (present : edge ∈ edges) (mixed : isAtom edge.left ≠ isAtom edge.right) :\\n    prepare edges = none := by\\n  have rejected : edges.all (fun item => isAtom item.left == isAtom item.right) = false := by\\n    cases checked : edges.all (fun item => isAtom item.left == isAtom item.right) with\\n    | false => rfl\\n    | true => exact False.elim (mixed (beq_iff_eq.mp ((List.all_eq_true.mp checked) edge present)))\\n  simp [prepare, rejected]\\n\\nend Eggshell.QuotientBuilder.AtomQuotient\\n\",[]]"],["Eggshell.Blake3","[\"module\\n\\nimport Std\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Blake3\\n\\ndef blockBytes : Nat := 64\\ndef chunkBytes : Nat := 1024\\n\\ndef chunkStart : UInt32 := 1\\ndef chunkEnd : UInt32 := 2\\ndef parent : UInt32 := 4\\ndef root : UInt32 := 8\\n\\ndef iv : Array UInt32 := #[\\n  0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,\\n  0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19]\\n\\ndef permutation : Array Nat := #[2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]\\n\\ndef rotateRight (word : UInt32) (count : Nat) : UInt32 :=\\n  (word >>> count.toUInt32) ||| (word <<< (32 - count).toUInt32)\\n\\ndef modifyAt (words : Array UInt32) (index : Nat) (change : UInt32 → UInt32) :\\n    Array UInt32 :=\\n  words.set! index (change words[index]!)\\n\\ndef g (state : Array UInt32) (a b c d mx my : Nat) : Array UInt32 :=\\n  let state := modifyAt state a fun value => value + state[b]! + state[mx]!\\n  let state := state.set! d (rotateRight (state[d]! ^^^ state[a]!) 16)\\n  let state := modifyAt state c fun value => value + state[d]!\\n  let state := state.set! b (rotateRight (state[b]! ^^^ state[c]!) 12)\\n  let state := modifyAt state a fun value => value + state[b]! + state[my]!\\n  let state := state.set! d (rotateRight (state[d]! ^^^ state[a]!) 8)\\n  let state := modifyAt state c fun value => value + state[d]!\\n  state.set! b (rotateRight (state[b]! ^^^ state[c]!) 7)\\n\\ndef round (state : Array UInt32) (message : Array UInt32) : Array UInt32 :=\\n  let words := state ++ message\\n  let words := g words 0 4 8 12 16 17\\n  let words := g words 1 5 9 13 18 19\\n  let words := g words 2 6 10 14 20 21\\n  let words := g words 3 7 11 15 22 23\\n  let words := g words 0 5 10 15 24 25\\n  let words := g words 1 6 11 12 26 27\\n  let words := g words 2 7 8 13 28 29\\n  let words := g words 3 4 9 14 30 31\\n  words.extract 0 16\\n\\ndef permute (message : Array UInt32) : Array UInt32 :=\\n  permutation.map fun index => message[index]!\\n\\ndef sevenRounds (state message : Array UInt32) : Array UInt32 :=\\n  let first := round state message\\n  let secondMessage := permute message\\n  let second := round first secondMessage\\n  let thirdMessage := permute secondMessage\\n  let third := round second thirdMessage\\n  let fourthMessage := permute thirdMessage\\n  let fourth := round third fourthMessage\\n  let fifthMessage := permute fourthMessage\\n  let fifth := round fourth fifthMessage\\n  let sixthMessage := permute fifthMessage\\n  let sixth := round fifth sixthMessage\\n  round sixth (permute sixthMessage)\\n\\nstructure Source where\\n  segments : List ByteArray\\n  size : Nat\\n\\nnamespace Source\\n\\ndef ofSegments (segments : List ByteArray) : Source :=\\n  { segments, size := segments.foldl (fun total bytes => total + bytes.size) 0 }\\n\\ndef byteAt : List ByteArray → Nat → UInt8\\n  | [], _ => 0\\n  | head :: tail, offset =>\\n      if offset < head.size then head.get! offset\\n      else byteAt tail (offset - head.size)\\n\\ndef getD (source : Source) (offset : Nat) : UInt8 :=\\n  if offset < source.size then byteAt source.segments offset else 0\\n\\nend Source\\n\\ndef wordAt (source : Source) (offset : Nat) : UInt32 :=\\n  let byte index := (source.getD (offset + index)).toUInt32\\n  byte 0 ||| (byte 1 <<< 8) ||| (byte 2 <<< 16) ||| (byte 3 <<< 24)\\n\\ndef blockWords (source : Source) (offset : Nat) : Array UInt32 :=\\n  (Array.range 16).map fun index => wordAt source (offset + index * 4)\\n\\ndef counterLow (counter : UInt64) : UInt32 := counter.toUInt32\\ndef counterHigh (counter : UInt64) : UInt32 := (counter >>> 32).toUInt32\\n\\ndef compress (chaining : Array UInt32) (block : Array UInt32)\\n    (counter : UInt64) (length : UInt32) (flags : UInt32) : Array UInt32 :=\\n  let initial := chaining ++ iv.extract 0 4 ++\\n    #[counterLow counter, counterHigh counter, length, flags]\\n  let state := sevenRounds initial block\\n  (Array.range 8).map (fun index => state[index]! ^^^ state[index + 8]!) ++\\n    (Array.range 8).map (fun index => state[index + 8]! ^^^ chaining[index]!)\\n\\nstructure Output where\\n  chaining : Array UInt32\\n  block : Array UInt32\\n  counter : UInt64\\n  length : UInt32\\n  flags : UInt32\\n\\nnamespace Output\\n\\ndef words (output : Output) (extraFlags : UInt32 := 0) : Array UInt32 :=\\n  compress output.chaining output.block output.counter output.length\\n    (output.flags ||| extraFlags)\\n\\ndef chainingValue (output : Output) : Array UInt32 :=\\n  (output.words).extract 0 8\\n\\nend Output\\n\\ndef chunkOutput (source : Source) (start length : Nat) (counter : UInt64) : Output := Id.run do\\n  let blocks := if length = 0 then 1 else (length + blockBytes - 1) / blockBytes\\n  let mut chaining := iv\\n  for blockIndex in [0:blocks - 1] do\\n    let blockStart := start + blockIndex * blockBytes\\n    let blockLength := Nat.min blockBytes (length - blockIndex * blockBytes)\\n    let flags := if blockIndex = 0 then chunkStart else 0\\n    chaining := (compress chaining (blockWords source blockStart) counter\\n      blockLength.toUInt32 flags).extract 0 8\\n  let finalIndex := blocks - 1\\n  let finalStart := start + finalIndex * blockBytes\\n  let finalLength := if length = 0 then 0 else length - finalIndex * blockBytes\\n  let finalFlags := chunkEnd ||| (if finalIndex = 0 then chunkStart else 0)\\n  return {\\n    chaining\\n    block := blockWords source finalStart\\n    counter\\n    length := finalLength.toUInt32\\n    flags := finalFlags\\n  }\\n\\ndef parentOutput (left right : Array UInt32) : Output := {\\n  chaining := iv\\n  block := left ++ right\\n  counter := 0\\n  length := 64\\n  flags := parent\\n}\\n\\ndef mergeStack (stack : List (Array UInt32)) (value : Array UInt32)\\n    (completedChunks : Nat) : List (Array UInt32) :=\\n  let rec go (remaining : Nat) (stack : List (Array UInt32))\\n      (value : Array UInt32) : List (Array UInt32) :=\\n    if remaining % 2 = 0 then\\n      match stack with\\n      | left :: tail => go (remaining / 2) tail (parentOutput left value).chainingValue\\n      | [] => [value]\\n    else value :: stack\\n  go completedChunks stack value\\n\\ndef finalOutput (source : Source) : Output := Id.run do\\n  let chunks := if source.size = 0 then 1 else (source.size + chunkBytes - 1) / chunkBytes\\n  let mut stack : List (Array UInt32) := []\\n  for chunkIndex in [0:chunks - 1] do\\n    let start := chunkIndex * chunkBytes\\n    let length := Nat.min chunkBytes (source.size - start)\\n    let output := chunkOutput source start length chunkIndex.toUInt64\\n    stack := mergeStack stack output.chainingValue (chunkIndex + 1)\\n  let lastIndex := chunks - 1\\n  let lastStart := lastIndex * chunkBytes\\n  let lastLength := if source.size = 0 then 0 else source.size - lastStart\\n  let mut output := chunkOutput source lastStart lastLength lastIndex.toUInt64\\n  for left in stack do\\n    output := parentOutput left output.chainingValue\\n  return output\\n\\ndef appendWord (output : ByteArray) (word : UInt32) : ByteArray :=\\n  output\\n    |>.push word.toUInt8\\n    |>.push (word >>> 8).toUInt8\\n    |>.push (word >>> 16).toUInt8\\n    |>.push (word >>> 24).toUInt8\\n\\ndef wordBytes (word : UInt32) : ByteArray := appendWord {} word\\n\\ndef hashSegments (segments : List ByteArray) : ByteArray :=\\n  let words := (finalOutput (Source.ofSegments segments)).words root\\n  wordBytes words[0]! ++ wordBytes words[1]! ++\\n    wordBytes words[2]! ++ wordBytes words[3]! ++\\n    wordBytes words[4]! ++ wordBytes words[5]! ++\\n    wordBytes words[6]! ++ wordBytes words[7]!\\n\\ndef hash (bytes : ByteArray) : ByteArray := hashSegments [bytes]\\n\\ndef u64le (value : Nat) : ByteArray :=\\n  (Array.range 8).foldl (fun bytes index =>\\n    bytes.push (value >>> (index * 8)).toUInt8) {}\\n\\ndef digest (domain : ByteArray) (fields : List ByteArray) : ByteArray :=\\n  hashSegments (u64le domain.size :: domain ::\\n    fields.flatMap fun field => [u64le field.size, field])\\n\\ndef hexDigit (value : UInt8) : Char :=\\n  if value < 10 then Char.ofNat ('0'.toNat + value.toNat)\\n  else Char.ofNat ('a'.toNat + value.toNat - 10)\\n\\ndef hex (bytes : ByteArray) : String :=\\n  String.ofList <| bytes.toList.flatMap fun byte =>\\n    [hexDigit (byte.toNat / 16).toUInt8, hexDigit (byte.toNat % 16).toUInt8]\\n\\ntheorem hashSegments_size (segments : List ByteArray) :\\n    (hashSegments segments).size = 32 := by\\n  simp [hashSegments, wordBytes, appendWord]\\n\\ntheorem hash_size (bytes : ByteArray) : (hash bytes).size = 32 := by\\n  exact hashSegments_size [bytes]\\n\\nend Eggshell.Blake3\\n\",[]]"],["Eggshell.BlockScore","[\"module\\npublic import ProjectionCache\\npublic import Eggshell.MiniLM\\n\\n@[expose] public section\\nnamespace Eggshell.BlockScore\\nopen Lean DB\\n\\n/-- A transient projection or a durable source hint. Neither carries Work,\\nfreshness, original-observation or completed authority. -/\\ninductive Input where\\n  | indexed (owner : Sidecar.Owner) (window : String)\\n  | projected (hex : String)\\n  deriving ToJson, FromJson\\n\\nstructure Request where\\n  queries : Array String\\n  blockRows : Array Input\\n  deriving FromJson\\n\\ndef kernelSource : String := include_str \\\"../runtime/block_score.py\\\"\\ndef implementation : String := Sha256.hex ((include_str \\\"BlockScore.lean\\\").toUTF8 ++\\n  kernelSource.toUTF8 ++ (include_str \\\"../ProjectionCache.lean\\\").toUTF8 ++ ProjectionCursor.implementation.toUTF8)\\ndef maxFrameBytes : Nat := 16*1024*1024\\n\\nstructure Frame where\\n  raw : ByteArray\\n  queries : Nat\\n  rows : Nat\\n  width : Nat\\n  exact : raw.size = (queries+rows)*width*8\\n  bounded : raw.size ≤ maxFrameBytes\\n  coverage : Array (Option String)\\n  sourceReadMs : Nat\\n  projectionHits : Nat\\n  projectionMisses : Nat\\n  retainedBytes : Nat\\n\\n/-- The bytes actually sent agree with the dimensions the numerical kernel reads. -/\\ntheorem Frame.byte_count (frame : Frame) : frame.raw.size = (frame.queries+frame.rows)*frame.width*8 := frame.exact\\n\\ndef Frame.header (frame : Frame) : Json := Json.mkObj [\\n  (\\\"queries\\\",toJson frame.queries),(\\\"rows\\\",toJson frame.rows),(\\\"width\\\",toJson frame.width)]\\n\\ndef ready (model : String) (pages : IO.Ref PageMap.PageCache) (owner : Sidecar.Owner) : IO VectorMatrix.Ready := do\\n  let source ← owner.pin\\n  for storage in [.database,.user] do\\n    let root := (← Sidecar.locate source storage).semantic\\n    let encoder := Sha256.hex MiniLM.embeddingSource.toUTF8\\n    if let some matrix ← VectorMatrix.open? root model encoder then\\n      let matrix := {matrix with snapshot := {matrix.snapshot with cache := pages}}\\n      ProjectionCursor.checkExtent matrix.snapshot\\n      return matrix\\n  throw (IO.userError \\\"original projections are pending explicit warm\\\")\\n\\ndef prepare (model : String) (cache : ProjectionCache.Cache) (pages : IO.Ref PageMap.PageCache) (body : String)\\n    (deadline : Nat) (cancelled : IO Bool) : IO Frame := do\\n  unless body.utf8ByteSize ≤ 8*1024*1024 do throw (IO.userError \\\"block-score request exceeds its bound\\\")\\n  let request : Request ← IO.ofExcept (Json.parse body >>= fromJson?)\\n  unless 0 < request.queries.size && request.queries.size ≤ 256 &&\\n      0 < request.blockRows.size && request.blockRows.size ≤ 256 do\\n    throw (IO.userError \\\"invalid block-score counts\\\")\\n  let beforeHits ← cache.hits.get\\n  let beforeMisses ← cache.misses.get\\n  let started ← IO.monoMsNow\\n  let queries ← request.queries.mapM (IO.ofExcept ∘ VectorMatrix.decodeHex)\\n  let width := queries[0]!.size/8\\n  unless 0 < width && width ≤ 4096 && queries.all (·.size == width*8) do\\n    throw (IO.userError \\\"query projection dimensions disagree\\\")\\n  let mut known : Std.HashMap String (VectorMatrix.Ready × String) := {}\\n  let mut raw := queries.foldl (·++·) ByteArray.empty\\n  let mut coverage := #[]\\n  for input in request.blockRows do\\n    unless (← IO.monoMsNow) < deadline && !(← cancelled) do throw (IO.userError \\\"block-score read expired\\\")\\n    let (bytes,metadata) ← match input with\\n      | .projected hex => pure (← IO.ofExcept (VectorMatrix.decodeHex hex),none)\\n      | .indexed owner window => do\\n          let scope := (toJson owner).compress\\n          let (matrix,identity) ← match known[scope]? with\\n            | some pair => pure pair\\n            | none => do\\n                let matrix ← ready model pages owner\\n                let pair := (matrix,ProjectionCache.scope matrix)\\n                known := known.insert scope pair\\n                pure pair\\n          let row ← ProjectionCache.read matrix cache identity window\\n          pure (row.payload.bytes,some row.row.value.coverage)\\n    unless bytes.size == width*8 do throw (IO.userError \\\"source projection dimensions disagree\\\")\\n    raw := raw++bytes\\n    coverage := coverage.push metadata\\n  for (_,matrix,_) in known.toList do\\n    ProjectionCursor.checkExtent matrix.snapshot\\n  if exact : raw.size = (queries.size+request.blockRows.size)*width*8 then\\n    if bounded : raw.size ≤ maxFrameBytes then\\n      return ⟨raw,queries.size,request.blockRows.size,width,exact,bounded,coverage,\\n        (← IO.monoMsNow)-started,(← cache.hits.get)-beforeHits,(← cache.misses.get)-beforeMisses,\\n        (← cache.state.get).bytes⟩\\n    else throw (IO.userError \\\"binary numerical frame exceeds its bound\\\")\\n  else throw (IO.userError \\\"binary numerical frame dimensions disagree\\\")\\n\\nend Eggshell.BlockScore\\n\",[[\"../runtime/block_score.py\",\"\\\"\\\"\\\"Numerical boundary: original binary64 -> float32 -> per-row NumPy dot.\\n\\nLean owns source lookup, integrity, cache, framing limits, lifecycle and ranking.\\nNo model, source persistence, routing, selection or authority lives here.\\n\\\"\\\"\\\"\\nimport json\\nimport sys\\nimport time\\n\\nstarted = time.perf_counter_ns()\\nimport numpy as np\\nstartup_us = (time.perf_counter_ns() - started) // 1000\\nfirst = True\\n\\n\\ndef vector(raw):\\n    result = np.frombuffer(raw, dtype=\\\"<f8\\\")\\n    if not np.isfinite(result).all():\\n        raise ValueError(\\\"nonfinite packed vector\\\")\\n    return np.asarray(result, dtype=np.float32)\\n\\n\\nfor line in sys.stdin.buffer:\\n    requested = time.perf_counter_ns()\\n    timing = {}\\n    try:\\n        header = json.loads(line)\\n        queries, rows, width = header[\\\"queries\\\"], header[\\\"rows\\\"], header[\\\"width\\\"]\\n        if not (1 <= queries <= 256 and 1 <= rows <= 256 and 1 <= width <= 4096):\\n            raise ValueError(\\\"invalid bounded numerical frame\\\")\\n        size = (queries + rows) * width * 8\\n        raw = sys.stdin.buffer.read(size)\\n        if len(raw) != size:\\n            raise ValueError(\\\"short numerical frame\\\")\\n        step = width * 8\\n        inputs = [vector(memoryview(raw)[i:i + step]) for i in range(0, size, step)]\\n        score_started = time.perf_counter_ns()\\n        scores = [max(float(np.dot(q, row)) for q in inputs[:queries])\\n                  for row in inputs[queries:]]\\n        timing[\\\"scoreUs\\\"] = (time.perf_counter_ns() - score_started) // 1000\\n        result = {\\\"scores\\\": scores}\\n    except Exception as error:\\n        result = {\\\"error\\\": str(error)}\\n    result[\\\"timing\\\"] = dict(timing, startupUs=startup_us if first else 0,\\n        leaseUs=0, initializeUs=0, encodeUs=0, modelLoaded=False,\\n        requestUs=(time.perf_counter_ns() - requested) // 1000)\\n    print(json.dumps(result, allow_nan=False, separators=(\\\",\\\", \\\":\\\")), flush=True)\\n    first = False\\n    if \\\"error\\\" in result:\\n        break\\n\"],[\"BlockScore.lean\",\"module\\npublic import ProjectionCache\\npublic import Eggshell.MiniLM\\n\\n@[expose] public section\\nnamespace Eggshell.BlockScore\\nopen Lean DB\\n\\n/-- A transient projection or a durable source hint. Neither carries Work,\\nfreshness, original-observation or completed authority. -/\\ninductive Input where\\n  | inde
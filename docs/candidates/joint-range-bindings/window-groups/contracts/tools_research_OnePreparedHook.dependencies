 not live\\\")\\n    unless (← getNat source.get (key \\\"member\\\" owner)) == ordinal do\\n      throw (IO.userError \\\"original candidate ordinal disagrees with membership\\\")\\n    return (← consume state ordinal document,count+1)) (initial,0)\\n  unless count == (← getNat source.get \\\"candidates\\\") do\\n    throw (IO.userError \\\"original candidate directory is incomplete\\\")\\n  return result\\n\\n/-- Count live source references; focus/query-only projections do not enter\\nthe discovery population. This retains keys and counts, not Work or vectors. -/\\ndef references (source : Snapshot) : IO (Std.HashMap String Nat) :=\\n  fold source (fun table _ document => pure (document.windows.foldl\\n    (fun table key => table.insert key (table[key]?.getD 0+1)) table)) {}\\n\\nend Eggshell.SourceCatalogue\\n\",[]]"],["Std","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std\"]"],["Std.Async.TCP","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Async.TCP\"]"],["Std.Async.Timer","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Async.Timer\"]"],["Std.Data.DHashMap","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.DHashMap\"]"],["Std.Data.HashMap","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.HashMap\"]"],["Std.Data.HashMap.Basic","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.HashMap.Basic\"]"],["Std.Data.HashMap.Lemmas","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.HashMap.Lemmas\"]"],["Std.Data.HashSet","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.HashSet\"]"],["Std.Data.HashSet.Lemmas","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.HashSet.Lemmas\"]"],["Std.Data.TreeMap.Lemmas","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.TreeMap.Lemmas\"]"],["Std.Data.TreeSet.Lemmas","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Data.TreeSet.Lemmas\"]"],["Std.Sync.Mutex","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Sync.Mutex\"]"],["Std.Time.DateTime.Timestamp","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std.Time.DateTime.Timestamp\"]"],["VectorPartition","[\"module\\npublic import PartitionDelta\\npublic import Init.Data.FloatArray\\npublic import Init.Data.List.Sort.Lemmas\\n\\n@[expose] public section\\nnamespace Eggshell.VectorPartition\\nopen Lean DB\\n\\ndef sampleCapacity : Nat := 16384\\ndef sampleLeafCapacity : Nat := 32\\ndef iterations : Nat := 4\\ndef postingCapacity : Nat := 32\\n\\ndef dot (a b : FloatArray) : Float := Id.run do\\n  let mut value := 0.0\\n  for i in [:a.size] do value := value + a[i]!*b[i]!\\n  return value\\n\\ndef zero (width : Nat) : FloatArray := (Array.replicate width (0.0 : Float)).toList.toFloatArray\\n\\ndef add (a b : FloatArray) : FloatArray := Id.run do\\n  let mut result := a\\n  for i in [:a.size] do result := result.set! i (a[i]!+b[i]!)\\n  return result\\n\\ndef subtract (a b : FloatArray) : FloatArray := Id.run do\\n  let mut result := FloatArray.emptyWithCapacity a.size\\n  for i in [:a.size] do result := result.push (a[i]!-b[i]!)\\n  return result\\n\\ndef normalize (a : FloatArray) : FloatArray := Id.run do\\n  let norm := (dot a a).sqrt\\n  if norm == 0.0 then return a\\n  let mut result := FloatArray.emptyWithCapacity a.size\\n  for i in [:a.size] do result := result.push (a[i]!/norm)\\n  return result\\n\\n/-- Routing sees the same float32 values as the unchanged scorer. This view\\ndoes not replace the original binary64 bytes or change their score. -/\\ndef decode (raw : ByteArray) : Except String FloatArray := do\\n  unless 0 < raw.size && raw.size%8 == 0 && raw.size/8 ≤ 4096 do throw \\\"invalid partition dimensions\\\"\\n  let mut result := FloatArray.emptyWithCapacity (raw.size/8)\\n  for i in [:raw.size/8] do\\n    let mut bits : UInt64 := 0\\n    for j in [:8] do bits := bits ||| (raw[i*8+j]!.toUInt64 <<< (8*j).toUInt64)\\n    let value := (Float.ofBits bits).toFloat32.toFloat\\n    unless value.isFinite do throw \\\"nonfinite partition coordinate\\\"\\n    result := result.push value\\n  return result\\n\\ndef pack (values : FloatArray) : ByteArray := Id.run do\\n  let mut result := ByteArray.empty\\n  for value in values do\\n    let bits := value.toBits\\n    for j in [:8] do result := result.push ((bits >>> (8*j).toUInt64).toUInt8)\\n  return result\\n\\n/-- Centroids and planes retain binary64 routing arithmetic. They are never\\nfed back as substitute source projections. -/\\ndef unpack (raw : ByteArray) : Except String FloatArray := do\\n  unless 0 < raw.size && raw.size%8 == 0 && raw.size/8 ≤ 4096 do throw \\\"invalid routing geometry\\\"\\n  let mut result := FloatArray.emptyWithCapacity (raw.size/8)\\n  for i in [:raw.size/8] do\\n    let mut bits : UInt64 := 0\\n    for j in [:8] do bits := bits ||| (raw[i*8+j]!.toUInt64 <<< (8*j).toUInt64)\\n    let value := Float.ofBits bits\\n    unless value.isFinite do throw \\\"nonfinite routing geometry\\\"\\n    result := result.push value\\n  return result\\n\\nstructure Sample where\\n  key : String\\n  values : FloatArray\\n  deriving Inhabited\\n\\ndef center (points : List Sample) : FloatArray :=\\n  normalize (points.foldl (fun sum point => add sum point.values)\\n    (zero (points.headD default).values.size))\\n\\ndef furthest (points : List Sample) (origin : FloatArray) : Sample :=\\n  let fixed := dot origin origin\\n  points.foldl (fun best point =>\\n    let distance := fun p : Sample => dot p.values p.values - 2.0*dot p.values origin + fixed\\n    if distance point > distance best || (distance point == distance best && point.key < best.key)\\n      then point else best) (points.headD default)\\n\\ndef byProjection (plane : FloatArray) (points : List Sample) : List Sample :=\\n  ((points.map fun point => (dot point.values plane,point)).mergeSort fun a b =>\\n    a.1 > b.1 || (a.1 == b.1 && a.2.key ≤ b.2.key)).map Prod.snd\\n\\ntheorem projection_perm (plane : FloatArray) (points : List Sample) :\\n    (byProjection plane points).Perm points := by\\n  have h := (List.mergeSort_perm (points.map fun point => (dot point.values plane,point))\\n    (fun a b => a.1 > b.1 || (a.1 == b.1 && a.2.key ≤ b.2.key))).map Prod.snd\\n  simpa [byProjection,List.map_map,Function.comp_def] using h\\n\\ndef plane (points : List Sample) : FloatArray := Id.run do\\n  let seed := furthest points (center points)\\n  let other := furthest points seed.values\\n  let mut direction := subtract (normalize seed.values) (normalize other.values)\\n  for _ in [:iterations] do\\n    let ordered := byProjection direction points\\n    let left := ordered.take (points.length/2)\\n    let right := ordered.drop (points.length/2)\\n    direction := subtract (center left) (center right)\\n  return direction\\n\\ninductive Training where\\n  | leaf (points : List Sample) (bounded : points.length ≤ sampleLeafCapacity)\\n  | branch (direction : FloatArray) (cut : Float) (tie : String) (left right : Training)\\n\\ndef Training.points : Training → List Sample\\n  | .leaf points _ => points\\n  | .branch _ _ _ a b => a.points ++ b.points\\n\\nstructure Trained (original : List Sample) where\\n  tree : Training\\n  exact : tree.points.Perm original\\n\\n/-- Data-dependent balanced splits retain every sample, even when all vectors\\nare identical. There is no nearest-neighbor or floating pruning claim here. -/\\ndef train (original : List Sample) : Trained original :=\\n  if small : original.length ≤ sampleLeafCapacity then\\n    ⟨.leaf original small,List.Perm.refl _⟩\\n  else\\n    let direction := plane original\\n    let ordered := byProjection direction original\\n    let middle := original.length/2\\n    let pivot := (ordered.drop middle).headD default\\n    let a := train (ordered.take middle)\\n    let b := train (ordered.drop middle)\\n    ⟨.branch direction (dot pivot.values direction) pivot.key a.tree b.tree,by\\n      change (a.tree.points ++ b.tree.points).Perm original\\n      have both := a.exact.append b.exact\\n      rw [List.take_append_drop] at both\\n      exact both.trans (projection_perm direction original)⟩\\ntermination_by original.length\\ndecreasing_by\\n  all_goals have len := List.Perm.length_eq (projection_perm (plane original) original)\\n  all_goals simp only [List.length_take,List.length_drop] at *\\n  all_goals have big : 32 < original.length := by simpa [sampleLeafCapacity] using Nat.lt_of_not_ge small\\n  all_goals have half : original.length/2 < original.length := Nat.div_lt_self (by omega) (by omega)\\n  all_goals omega\\n\\ntheorem training_preserves_samples (points : List Sample) : (train points).tree.points.Perm points :=\\n  (train points).exact\\n\\ninductive Node where\\n  | leaf (cell : Nat)\\n  | branch (direction : ByteArray) (cut : Nat) (tie : String) (left right : Nat)\\n  deriving Inhabited\\n\\ndef nodeCodec : Wire.Codec Node :=\\n  (Wire.sum Wire.natural (Wire.byteBlob.product (Wire.natural.product\\n    (Wire.text.product (Wire.natural.product Wire.natural))))).iso\\n    (fun | .leaf cell => .inl cell\\n         | .branch direction cut tie left right => .inr (direction,cut,tie,left,right))\\n    (fun | .inl cell => .leaf cell\\n         | .inr (direction,cut,tie,left,right) => .branch direction cut tie left right)\\n    (by intro node; cases node <;> rfl)\\n\\ntheorem node_roundtrip (node : Node) (tail : List UInt8) :\\n    nodeCodec.decode (nodeCodec.encode node ++ tail) = .ok (node,tail) := nodeCodec.roundtrip node tail\\n\\nstructure Geometry where\\n  nodes : Array Node\\n  root : Nat\\n  cells : Nat\\n\\ndef compile (tree : Training) : Geometry := Id.run do\\n  let rec visit (tree : Training) (nodes : Array Node) (next : Nat) : Array Node × Nat × Nat :=\\n    match tree with\\n    | .leaf _ _ => (nodes.push (.leaf next),nodes.size,next+1)\\n    | .branch direction cut tie a b =>\\n      let (nodes,left,next) := visit a nodes next\\n      let (nodes,right,next) := visit b nodes next\\n      (nodes.push (.branch (pack direction) cut.toBits.toNat tie left right),nodes.size,next)\\n  let (nodes,root,cells) := visit tree #[] 0\\n  return ⟨nodes,root,cells⟩\\n\\ninductive RuntimeNode where\\n  | leaf (cell : Nat)\\n  | branch (direction : FloatArray) (cut : Float) (tie : String) (left right : Nat)\\n\\nstructure Runtime where\\n  geometry : Geometry\\n  nodes : Array RuntimeNode\\n\\ndef restore (geometry : Geometry) (width : Nat) : Except String Runtime := do\\n  let nodes ← geometry.nodes.mapIdxM fun index node => do\\n    match node with\\n    | .leaf cell =>\\n      unless cell < geometry.cells do throw \\\"foreign assignment cell\\\"\\n      return RuntimeNode.leaf cell\\n    | .branch raw cut tie left right =>\\n      unless left < index && right < index && left != right && cut < 2^64 do throw \\\"invalid assignment branch\\\"\\n      let direction ← unpack raw\\n      let threshold := Float.ofBits cut.toUInt64\\n      unless direction.size == width && threshold.isFinite do throw \\\"invalid assignment geometry\\\"\\n      return RuntimeNode.branch direction threshold tie left right\\n  return ⟨geometry,nodes⟩\\n\\ndef assign (runtime : Runtime) (key : String) (values : FloatArray) : Except String Nat := do\\n  let geometry := runtime.geometry\\n  let mut index := geometry.root\\n  for _ in [:64] do\\n    let some node := runtime.nodes[index]? | throw \\\"foreign assignment node\\\"\\n    match node with\\n    | .leaf cell =>\\n      unless cell < geometry.cells do throw \\\"foreign assignment cell\\\"\\n      return cell\\n    | .branch direction cut tie left right =>\\n      unless direction.size == values.size do throw \\\"assignment dimensions disagree\\\"\\n      let score := dot values direction\\n      unless score.isFinite && cut.isFinite do throw \\\"nonfinite assignment\\\"\\n      index := if score > cut || (score == cut && key < tie) then left else right\\n  throw \\\"assignment depth exceeded\\\"\\n\\nstructure Basis where\\n  source : PageMap.Head\\n  matrix : PageMap.Head\\n  eligibility : String\\n  rows : Nat\\n  width : Nat\\n  deriving ToJson, FromJson, BEq\\n\\nstructure Cell where\\n  center : FloatArray\\n  keys : Array String\\n  deriving Inhabited\\n\\nstructure Header where\\n  basis : Basis\\n  nodes : Nat\\n  root : Nat\\n  cells : Nat\\n  slots : Nat\\n  deriving ToJson, FromJson\\n\\ndef implementation := Sha256.hex (include_str \\\"VectorPartition.lean\\\").toUTF8\\ndef authority := \\\"eggshell.vector-partition:\\\"++implementation\\n\\ndef cellCodec := Wire.byteBlob.product Wire.natural\\n\\ndef postingKey (cell : Nat) (key : String) : String := s!\\\"member:{cell}:{key}\\\"\\ndef postingRange (cell : Nat) : PageMap.KeyRange := ⟨s!\\\"member:{cell}:\\\",s!\\\"member:{cell};\\\"⟩\\n\\ndef decodeCount (raw : ByteArray) : IO Nat := do\\n  let (value,tail) ← IO.ofExcept (Wire.natural.decode raw.toList)\\n  unless tail.isEmpty && Wire.natural.encode value == raw.toList do\\n    throw (IO.userError \\\"invalid partition reference count\\\")\\n  return value\\n\\ndef publish (path : System.FilePath) (basis : Basis) (geometry : Geometry) (cells : Array Cell)\\n    (references : Std.HashMap String Nat) : IO PageMap.Snapshot := do\\n  unless cells.size == geometry.cells &&\\n      0 < cells.size && 0 < geometry.nodes.size && geometry.root+1 == geometry.nodes.size do\\n    throw (IO.userError \\\"invalid partition publication\\\")\\n  let _ ← IO.ofExcept (restore geometry basis.width)\\n  let snapshot ← match ← PageMap.open? path with\\n    | some snapshot =>\\n      unless snapshot.head.authority == authority do throw (IO.userError \\\"foreign partition writer\\\")\\n      pure snapshot\\n    | none => PageMap.create path authority\\n  let _ ← PageMap.withWriter snapshot fun writer => do\\n    writer.root.set none\\n    let mut rows := 0\\n    let mut seen : Std.HashSet String := {}\\n    for i in [:geometry.nodes.size] do\\n      writer.put (s!\\\"node:{i}\\\") (some (nodeCodec.encode geometry.nodes[i]!).toByteArray)\\n    for i in [:cells.size] do\\n      let cell := cells[i]!\\n      unless cell.center.size == basis.width do throw (IO.userError \\\"cell dimensions disagree\\\")\\n      writer.put (s!\\\"cell:{i}\\\") (some (cellCodec.encode (pack cell.center,cell.keys.size)).toByteArray)\\n      for key in cell.keys do\\n        let count := references[key]?.getD 0\\n        unless Receipt.validId key && !seen.contains key && count > 0 do\\n          throw (IO.userError \\\"duplicate, foreign or unreferenced partition key\\\")\\n        seen := seen.insert key\\n        writer.put (postingKey i key) (some (Wire.natural.encode count).toByteArray)\\n      rows := rows+cell.keys.size\\n    unless rows == basis.rows && references.size == rows do\\n      throw (IO.userError \\\"partition eligibility not covered exactly\\\")\\n    let header : Header := ⟨basis,geometry.nodes.size,geometry.root,cells.size,rows⟩\\n    writer.put \\\"ready\\\" (some (toJson header).compress.toUTF8)\\n  PageMap.pin path\\n\\nstructure Ready where\\n  snapshot : PageMap.Snapshot\\n  header : Header\\n\\ndef load? (path : System.FilePath) : IO (Option Ready) := do\\n  let some snapshot ← PageMap.open? path | return none\\n  unless snapshot.head.authority == authority do throw (IO.userError \\\"foreign partition authority\\\")\\n  let some raw ← snapshot.get \\\"ready\\\" | return none\\n  unless raw.size ≤ 65536 do throw (IO.userError \\\"oversized partition header\\\")\\n  let some text := String.fromUTF8? raw | throw (IO.userError \\\"invalid partition header\\\")\\n  let header : Header ← IO.ofExcept (Json.parse text >>= fromJson?)\\n  unless 0 < header.cells && header.cells ≤ sampleCapacity && header.root+1 == header.nodes &&\\n      header.basis.rows ≤ header.slots &&\\n      snapshot.head.root.any (·.rows == header.nodes+header.cells+header.slots+1) do\\n    throw (IO.userError \\\"partition publication does not cover its header\\\")\\n  return some ⟨snapshot,header⟩\\n\\ndef open? (path : System.FilePath) (basis : Basis) : IO (Option Ready) := do\\n  let some ready ← load? path | return none\\n  if ready.header.basis == basis then return some ready else return none\\n\\ndef geometry (ready : Ready) : IO Runtime := do\\n  let mut nodes := #[]\\n  for index in [:ready.header.nodes] do\\n    let some raw ← ready.snapshot.get (s!\\\"node:{index}\\\") | throw (IO.userError \\\"missing assignment node\\\")\\n    let (node,tail) ← IO.ofExcept (nodeCodec.decode raw.toList)\\n    unless tail.isEmpty && (nodeCodec.encode node).toByteArray == raw do\\n      throw (IO.userError \\\"invalid assignment node encoding\\\")\\n    nodes := nodes.push node\\n  IO.ofExcept (restore ⟨nodes,ready.header.root,ready.header.cells⟩ ready.header.basis.width)\\n\\ndef cell (ready : Ready) (id : Nat) : IO (ByteArray × Nat) := do\\n  unless id < ready.header.cells do throw (IO.userError \\\"foreign partition cell\\\")\\n  let some raw ← ready.snapshot.get (s!\\\"cell:{id}\\\") | throw (IO.userError \\\"missing partition cell\\\")\\n  let ((encoded,count),tail) ← IO.ofExcept (cellCodec.decode raw.toList)\\n  unless tail.isEmpty && (cellCodec.encode (encoded,count)).toByteArray == raw &&\\n      count ≤ ready.header.basis.rows do throw (IO.userError \\\"invalid partition cell\\\")\\n  let center ← IO.ofExcept (unpack encoded)\\n  unless center.size == ready.header.basis.width do throw (IO.userError \\\"invalid cell width\\\")\\n  return (encoded,count)\\n\\nstructure Nominations where\\n  keys : List String\\n  visitedCells : Nat\\n  totalCells : Nat\\n  totalPoints : Nat\\n  partialCell : Bool\\n  physicalRows : Nat\\n  deriving ToJson\\n\\n/-- Fixed trained centroids rank cells. Ordered member rows carry reference\\ncounts; zero-count rows consume the same physical budget as live rows. -/\\ndef nominate (ready : Ready) (queries : Array FloatArray) (quota : Nat) :\\n    IO {result : Nominations // result.keys.length ≤ quota ∧ result.physicalRows ≤ 2*quota} := do\\n  unless quota ≤ 4096 && !queries.isEmpty && queries.all (·.size == ready.header.basis.width) do\\n    throw (IO.userError \\\"invalid partition query allowance\\\")\\n  if quota == 0 then\\n    return ⟨⟨[],0,ready.header.cells,ready.header.basis.rows,false,0⟩,by simp⟩\\n  let mut ordered : List (Float × Nat × Nat) := []\\n  for i in [:ready.header.cells] do\\n    let (encoded,count) ← cell ready i\\n    let center ← IO.ofExcept (unpack encoded)\\n    let score := queries.foldl (fun best query => max best (dot query center)) (-1.0e30)\\n    unless score.isFinite do throw (IO.userError \\\"nonfinite centroid score\\\")\\n    if count > 0 then ordered := (score,i,count)::ordered\\n  ordered := ordered.mergeSort (fun a b => a.1 > b.1 || (a.1 == b.1 && a.2.1 ≤ b.2.1))\\n  let mut keys := []\\n  let mut count := 0\\n  let mut visited := 0\\n  let mut partialCell := false\\n  let mut remaining := 2*quota\\n  for (_,id,cellCount) in ordered do\\n    if count == quota then break\\n    if remaining == 0 then\\n      partialCell := true\\n      break\\n    visited := visited+1\\n    let range := postingRange id\\n    let selected ← match ready.snapshot.head.root with\\n      | none => pure (WindowOwners.Slice.mk [] remaining false)\\n      | some root => WindowOwners.scanAt ready.snapshot root range ⟨[],remaining,false⟩\\n    remaining := selected.remaining\\n    let mut taken := 0\\n    for (stored,raw) in selected.rows.reverse do\\n      let some raw := raw | throw (IO.userError \\\"retired partition member row\\\")\\n      let references ← decodeCount raw\\n      let key := String.ofList (stored.toList.drop (s!\\\"member:{id}:\\\".length))\\n      unless Receipt.validId key && stored == postingKey id key do\\n        throw (IO.userError \\\"foreign partition member row\\\")\\n      if references > 0 && count < quota then\\n        keys := key::keys\\n        count := count+1\\n        taken := taken+1\\n    if taken < cellCount || selected.incomplete then partialCell := true\\n  let result := Nominations.mk keys.reverse visited ready.header.cells ready.header.basis.rows partialCell (2*quota-remaining)\\n  if bounded : result.keys.length ≤ quota ∧ result.physicalRows ≤ 2*quota then return ⟨result,bounded⟩\\n  else throw (IO.userError \\\"partition nomination exceeds its checked quota\\\")\\n\\nend Eggshell.VectorPartition\\n\",[[\"VectorPartition.lean\",\"module\\npublic import PartitionDelta\\npublic import Init.Data.FloatArray\\npublic import Init.Data.List.Sort.Lemmas\\n\\n@[expose] public section\\nnamespace Eggshell.VectorPartition\\nopen Lean DB\\n\\ndef sampleCapacity : Nat := 16384\\ndef sampleLeafCapacity : Nat := 32\\ndef iterations : Nat := 4\\ndef postingCapacity : Nat := 32\\n\\ndef dot (a b : FloatArray) : Float := Id.run do\\n  let mut value := 0.0\\n  for i in [:a.size] do value := value + a[i]!*b[i]!\\n  return value\\n\\ndef zero (width : Nat) : FloatArray := (Array.replicate width (0.0 : Float)).toList.toFloatArray\\n\\ndef add (a b : FloatArray) : FloatArray := Id.run do\\n  let mut result := a\\n  for i in [:a.size] do result := result.set! i (a[i]!+b[i]!)\\n  return result\\n\\ndef subtract (a b : FloatArray) : FloatArray := Id.run do\\n  let mut result := FloatArray.emptyWithCapacity a.size\\n  for i in [:a.size] do result := result.push (a[i]!-b[i]!)\\n  return result\\n\\ndef normalize (a : FloatArray) : FloatArray := Id.run do\\n  let norm := (dot a a).sqrt\\n  if norm == 0.0 then return a\\n  let mut result := FloatArray.emptyWithCapacity a.size\\n  for i in [:a.size] do result := result.push (a[i]!/norm)\\n  return result\\n\\n/-- Routing sees the same float32 values as the unchanged scorer. This view\\ndoes not replace the original binary64 bytes or change their score. -/\\ndef decode (raw : ByteArray) : Except String FloatArray := do\\n  unless 0 < raw.size && raw.size%8 == 0 && raw.size/8 ≤ 4096 do throw \\\"invalid partition dimensions\\\"\\n  let mut result := FloatArray.emptyWithCapacity (raw.size/8)\\n  for i in [:raw.size/8] do\\n    let mut bits : UInt64 := 0\\n    for j in [:8] do bits := bits ||| (raw[i*8+j]!.toUInt64 <<< (8*j).toUInt64)\\n    let value := (Float.ofBits bits).toFloat32.toFloat\\n    unless value.isFinite do throw \\\"nonfinite partition coordinate\\\"\\n    result := result.push value\\n  return result\\n\\ndef pack (values : FloatArray) : ByteArray := Id.run do\\n  let mut result := ByteArray.empty\\n  for value in values do\\n    let bits := value.toBits\\n    for j in [:8] do result := result.push ((bits >>> (8*j).toUInt64).toUInt8)\\n  return result\\n\\n/-- Centroids and planes retain binary64 routing arithmetic. They are never\\nfed back as substitute source projections. -/\\ndef unpack (raw : ByteArray) : Except String FloatArray := do\\n  unless 0 < raw.size && raw.size%8 == 0 && raw.size/8 ≤ 4096 do throw \\\"invalid routing geometry\\\"\\n  let mut result := FloatArray.emptyWithCapacity (raw.size/8)\\n  for i in [:raw.size/8] do\\n    let mut bits : UInt64 := 0\\n    for j in [:8] do bits := bits ||| (raw[i*8+j]!.toUInt64 <<< (8*j).toUInt64)\\n    let value := Float.ofBits bits\\n    unless value.isFinite do throw \\\"nonfinite routing geometry\\\"\\n    result := result.push value\\n  return result\\n\\nstructure Sample where\\n  key : String\\n  values : FloatArray\\n  deriving Inhabited\\n\\ndef center (points : List Sample) : FloatArray :=\\n  normalize (points.foldl (fun sum point => add sum point.values)\\n    (zero (points.headD default).values.size))\\n\\ndef furthest (points : List Sample) (origin : FloatArray) : Sample :=\\n  let fixed := dot origin origin\\n  points.foldl (fun best point =>\\n    let distance := fun p : Sample => dot p.values p.values - 2.0*dot p.values origin + fixed\\n    if distance point > distance best || (distance point == distance best && point.key < best.key)\\n      then point else best) (points.headD default)\\n\\ndef byProjection (plane : FloatArray) (points : List Sample) : List Sample :=\\n  ((points.map fun point => (dot point.values plane,point)).mergeSort fun a b =>\\n    a.1 > b.1 || (a.1 == b.1 && a.2.key ≤ b.2.key)).map Prod.snd\\n\\ntheorem projection_perm (plane : FloatArray) (points : List Sample) :\\n    (byProjection plane points).Perm points := by\\n  have h := (List.mergeSort_perm (points.map fun point => (dot point.values plane,point))\\n    (fun a b => a.1 > b.1 || (a.1 == b.1 && a.2.key ≤ b.2.key))).map Prod.snd\\n  simpa [byProjection,List.map_map,Function.comp_def] using h\\n\\ndef plane (points : List Sample) : FloatArray := Id.run do\\n  let seed := furthest points (center points)\\n  let other := furthest points seed.values\\n  let mut direction := subtract (normalize seed.values) (normalize other.values)\\n  for _ in [:iterations] do\\n    let ordered := byProjection direction points\\n    let left := ordered.take (points.length/2)\\n    let right := ordered.drop (points.length/2)\\n    direction := subtract (center left) (center right)\\n  return direction\\n\\ninductive Training where\\n  | leaf (points : List Sample) (bounded : points.length ≤ sampleLeafCapacity)\\n  | branch (direction : FloatArray) (cut : Float) (tie : String) (left right : Training)\\n\\ndef Training.points : Training → List Sample\\n  | .leaf points _ => points\\n  | .branch _ _ _ a b => a.points ++ b.points\\n\\nstructure Trained (original : List Sample) where\\n  tree : Training\\n  exact : tree.points.Perm original\\n\\n/-- Data-dependent balanced splits retain every sample, even when all vectors\\nare identical. There is no nearest-neighbor or floating pruning claim here. -/\\ndef train (original : List Sample) : Trained original :=\\n  if small : original.length ≤ sampleLeafCapacity then\\n    ⟨.leaf original small,List.Perm.refl _⟩\\n  else\\n    let direction := plane original\\n    let ordered := byProjection direction original\\n    let middle := original.length/2\\n    let pivot := (ordered.drop middle).headD default\\n    let a := train (ordered.take middle)\\n    let b := train (ordered.drop middle)\\n    ⟨.branch direction (dot pivot.values direction) pivot.key a.tree b.tree,by\\n      change (a.tree.points ++ b.tree.points).Perm original\\n      have both := a.exact.append b.exact\\n      rw [List.take_append_drop] at both\\n      exact both.trans (projection_perm direction original)⟩\\ntermination_by original.length\\ndecreasing_by\\n  all_goals have len := List.Perm.length_eq (projection_perm (plane original) original)\\n  all_goals simp only [List.length_take,List.length_drop] at *\\n  all_goals have big : 32 < original.length := by simpa [sampleLeafCapacity] using Nat.lt_of_not_ge small\\n  all_goals have half : original.length/2 < original.length := Nat.div_lt_self (by omega) (by omega)\\n  all_goals omega\\n\\ntheorem training_preserves_samples (points : List Sample) : (train points).tree.points.Perm points :=\\n  (train points).exact\\n\\ninductive Node where\\n  | leaf (cell : Nat)\\n  | branch (direction : ByteArray) (cut : Nat) (tie : String) (left right : Nat)\\n  deriving Inhabited\\n\\ndef nodeCodec : Wire.Codec Node :=\\n  (Wire.sum Wire.natural (Wire.byteBlob.product (Wire.natural.product\\n    (Wire.text.product (Wire.natural.product Wire.natural))))).iso\\n    (fun | .leaf cell => .inl cell\\n         | .branch direction cut tie left right => .inr (direction,cut,tie,left,right))\\n    (fun | .inl cell => .leaf cell\\n         | .inr (direction,cut,tie,left,right) => .branch direction cut tie left right)\\n    (by intro node; cases node <;> rfl)\\n\\ntheorem node_roundtrip (node : Node) (tail : List UInt8) :\\n    nodeCodec.decode (nodeCodec.encode node ++ tail) = .ok (node,tail) := nodeCodec.roundtrip node tail\\n\\nstructure Geometry where\\n  nodes : Array Node\\n  root : Nat\\n  cells : Nat\\n\\ndef compile (tree : Training) : Geometry := Id.run do\\n  let rec visit (tree : Training) (nodes : Array Node) (next : Nat) : Array Node × Nat × Nat :=\\n    match tree with\\n    | .leaf _ _ => (nodes.push (.leaf next),nodes.size,next+1)\\n    | .branch direction cut tie a b =>\\n      let (nodes,left,next) := visit a nodes next\\n      let (nodes,right,next) := visit b nodes next\\n      (nodes.push (.branch (pack direction) cut.toBits.toNat tie left right),nodes.size,next)\\n  let (nodes,root,cells) := visit tree #[] 0\\n  return ⟨nodes,root,cells⟩\\n\\ninductive RuntimeNode where\\n  | leaf (cell : Nat)\\n  | branch (direction : FloatArray) (cut : Float) (tie : String) (left right : Nat)\\n\\nstructure Runtime where\\n  geometry : Geometry\\n  nodes : Array RuntimeNode\\n\\ndef restore (geometry : Geometry) (width : Nat) : Except String Runtime := do\\n  let nodes ← geometry.nodes.mapIdxM fun index node => do\\n    match node with\\n    | .leaf cell =>\\n      unless cell < geometry.cells do throw \\\"foreign assignment cell\\\"\\n      return RuntimeNode.leaf cell\\n    | .branch raw cut tie left right =>\\n      unless left < index && right < index && left != right && cut < 2^64 do throw \\\"invalid assignment branch\\\"\\n      let direction ← unpack raw\\n      let threshold := Float.ofBits cut.toUInt64\\n      unless direction.size == width && threshold.isFinite do throw \\\"invalid assignment geometry\\\"\\n      return RuntimeNode.branch direction threshold tie left right\\n  return ⟨geometry,nodes⟩\\n\\ndef assign (runtime : Runtime) (key : String) (values : FloatArray) : Except String Nat := do\\n  let geometry := runtime.geometry\\n  let mut index := geometry.root\\n  for _ in [:64] do\\n    let some node := runtime.nodes[index]? | throw \\\"foreign assignment node\\\"\\n    match node with\\n    | .leaf cell =>\\n      unless cell < geometry.cells do throw \\\"foreign assignment cell\\\"\\n      return cell\\n    | .branch direction cut tie left right =>\\n      unless direction.size == values.size do throw \\\"assignment dimensions disagree\\\"\\n      let score := dot values direction\\n      unless score.isFinite && cut.isFinite do throw \\\"nonfinite assignment\\\"\\n      index := if score > cut || (score == cut && key < tie) then left else right\\n  throw \\\"assignment depth exceeded\\\"\\n\\nstructure Basis where\\n  source : PageMap.Head\\n  matrix : PageMap.Head\\n  eligibility : String\\n  rows : Nat\\n  width : Nat\\n  deriving ToJson, FromJson, BEq\\n\\nstructure Cell where\\n  center : FloatArray\\n  keys : Array String\\n  deriving Inhabited\\n\\nstructure Header where\\n  basis : Basis\\n  nodes : Nat\\n  root : Nat\\n  cells : Nat\\n  slots : Nat\\n  deriving ToJson, FromJson\\n\\ndef implementation := Sha256.hex (include_str \\\"VectorPartition.lean\\\").toUTF8\\ndef authority := \\\"eggshell.vector-partition:\\\"++implementation\\n\\ndef cellCodec := Wire.byteBlob.product Wire.natural\\n\\ndef postingKey (cell : Nat) (key : String) : String := s!\\\"member:{cell}:{key}\\\"\\ndef postingRange (cell : Nat) : PageMap.KeyRange := ⟨s!\\\"member:{cell}:\\\",s!\\\"member:{cell};\\\"⟩\\n\\ndef decodeCount (raw : ByteArray) : IO Nat := do\\n  let (value,tail) ← IO.ofExcept (Wire.natural.decode raw.toList)\\n  unless tail.isEmpty && Wire.natural.encode value == raw.toList do\\n    throw (IO.userError \\\"invalid partition reference count\\\")\\n  return value\\n\\ndef publish (path : System.FilePath) (basis : Basis) (geometry : Geometry) (cells : Array Cell)\\n    (references : Std.HashMap String Nat) : IO PageMap.Snapshot := do\\n  unless cells.size == geometry.cells &&\\n      0 < cells.size && 0 < geometry.nodes.size && geometry.root+1 == geometry.nodes.size do\\n    throw (IO.userError \\\"invalid partition publication\\\")\\n  let _ ← IO.ofExcept (restore geometry basis.width)\\n  let snapshot ← match ← PageMap.open? path with\\n    | some snapshot =>\\n      unless snapshot.head.authority == authority do throw (IO.userError \\\"foreign partition writer\\\")\\n      pure snapshot\\n    | none => PageMap.create path authority\\n  let _ ← PageMap.withWriter snapshot fun writer => do\\n    writer.root.set none\\n    let mut rows := 0\\n    let mut seen : Std.HashSet String := {}\\n    for i in [:geometry.nodes.size] do\\n      writer.put (s!\\\"node:{i}\\\") (some (nodeCodec.encode geometry.nodes[i]!).toByteArray)\\n    for i in [:cells.size] do\\n      let cell := cells[i]!\\n      unless cell.center.size == basis.width do throw (IO.userError \\\"cell dimensions disagree\\\")\\n      writer.put (s!\\\"cell:{i}\\\") (some (cellCodec.encode (pack cell.center,cell.keys.size)).toByteArray)\\n      for key in cell.keys do\\n        let count := references[key]?.getD 0\\n        unless Receipt.validId key && !seen.contains key && count > 0 do\\n          throw (IO.userError \\\"duplicate, foreign or unreferenced partition key\\\")\\n        seen := seen.insert key\\n        writer.put (postingKey i key) (some (Wire.natural.encode count).toByteArray)\\n      rows := rows+cell.keys.size\\n    unless rows == basis.rows && references.size == rows do\\n      throw (IO.userError \\\"partition eligibility not covered exactly\\\")\\n    let header : Header := ⟨basis,geometry.nodes.size,geometry.root,cells.size,rows⟩\\n    writer.put \\\"ready\\\" (some (toJson header).compress.toUTF8)\\n  PageMap.pin path\\n\\nstructure Ready where\\n  snapshot : PageMap.Snapshot\\n  header : Header\\n\\ndef load? (path : System.FilePath) : IO (Option Ready) := do\\n  let some snapshot ← PageMap.open? path | return none\\n  unless snapshot.head.authority == authority do throw (IO.userError \\\"foreign partition authority\\\")\\n  let some raw ← snapshot.get \\\"ready\\\" | return none\\n  unless raw.size ≤ 65536 do throw (IO.userError \\\"oversized partition header\\\")\\n  let some text := String.fromUTF8? raw | throw (IO.userError \\\"invalid partition header\\\")\\n  let header : Header ← IO.ofExcept (Json.parse text >>= fromJson?)\\n  unless 0 < header.cells && header.cells ≤ sampleCapacity && header.root+1 == header.nodes &&\\n      header.basis.rows ≤ header.slots &&\\n      snapshot.head.root.any (·.rows == header.nodes+header.cells+header.slots+1) do\\n    throw (IO.userError \\\"partition publication does not cover its header\\\")\\n  return some ⟨snapshot,header⟩\\n\\ndef open? (path : System.FilePath) (basis : Basis) : IO (Option Ready) := do\\n  let some ready ← load? path | return none\\n  if ready.header.basis == basis then return some ready else return none\\n\\ndef geometry (ready : Ready) : IO Runtime := do\\n  let mut nodes := #[]\\n  for index in [:ready.header.nodes] do\\n    let some raw ← ready.snapshot.get (s!\\\"node:{index}\\\") | throw (IO.userError \\\"missing assignment node\\\")\\n    let (node,tail) ← IO.ofExcept (nodeCodec.decode raw.toList)\\n    unless tail.isEmpty && (nodeCodec.encode node).toByteArray == raw do\\n      throw (IO.userError \\\"invalid assignment node encoding\\\")\\n    nodes := nodes.push node\\n  IO.ofExcept (restore ⟨nodes,ready.header.root,ready.header.cells⟩ ready.header.basis.width)\\n\\ndef cell (ready : Ready) (id : Nat) : IO (ByteArray × Nat) := do\\n  unless id < ready.header.cells do throw (IO.userError \\\"foreign partition cell\\\")\\n  let some raw ← ready.snapshot.get (s!\\\"cell:{id}\\\") | throw (IO.userError \\\"missing partition cell\\\")\\n  let ((encoded,count),tail) ← IO.ofExcept (cellCodec.decode raw.toList)\\n  unless tail.isEmpty && (cellCodec.encode (encoded,count)).toByteArray == raw &&\\n      count ≤ ready.header.basis.rows do throw (IO.userError \\\"invalid partition cell\\\")\\n  let center ← IO.ofExcept (unpack encoded)\\n  unless center.size == ready.header.basis.width do throw (IO.userError \\\"invalid cell width\\\")\\n  return (encoded,count)\\n\\nstructure Nominations where\\n  keys : List String\\n  visitedCells : Nat\\n  totalCells : Nat\\n  totalPoints : Nat\\n  partialCell : Bool\\n  physicalRows : Nat\\n  deriving ToJson\\n\\n/-- Fixed trained centroids rank cells. Ordered member rows carry reference\\ncounts; zero-count rows consume the same physical budget as live rows. -/\\ndef nominate (ready : Ready) (queries : Array FloatArray) (quota : Nat) :\\n    IO {result : Nominations // result.keys.length ≤ quota ∧ result.physicalRows ≤ 2*quota} := do\\n  unless quota ≤ 4096 && !queries.isEmpty && queries.all (·.size == ready.header.basis.width) do\\n    throw (IO.userError \\\"invalid partition query allowance\\\")\\n  if quota == 0 then\\n    return ⟨⟨[],0,ready.header.cells,ready.header.basis.rows,false,0⟩,by simp⟩\\n  let mut ordered : List (Float × Nat × Nat) := []\\n  for i in [:ready.header.cells] do\\n    let (encoded,count) ← cell ready i\\n    let center ← IO.ofExcept (unpack encoded)\\n    let score := queries.foldl (fun best query => max best (dot query center)) (-1.0e30)\\n    unless score.isFinite do throw (IO.userError \\\"nonfinite centroid score\\\")\\n    if count > 0 then ordered := (score,i,count)::ordered\\n  ordered := ordered.mergeSort (fun a b => a.1 > b.1 || (a.1 == b.1 && a.2.1 ≤ b.2.1))\\n  let mut keys := []\\n  let mut count := 0\\n  let mut visited := 0\\n  let mut partialCell := false\\n  let mut remaining := 2*quota\\n  for (_,id,cellCount) in ordered do\\n    if count == quota then break\\n    if remaining == 0 then\\n      partialCell := true\\n      break\\n    visited := visited+1\\n    let range := postingRange id\\n    let selected ← match ready.snapshot.head.root with\\n      | none => pure (WindowOwners.Slice.mk [] remaining false)\\n      | some root => WindowOwners.scanAt ready.snapshot root range ⟨[],remaining,false⟩\\n    remaining := selected.remaining\\n    let mut taken := 0\\n    for (stored,raw) in selected.rows.reverse do\\n      let some raw := raw | throw (IO.userError \\\"retired partition member row\\\")\\n      let references ← decodeCount raw\\n      let key := String.ofList (stored.toList.drop (s!\\\"member:{id}:\\\".length))\\n      unless Receipt.validId key && stored == postingKey id key do\\n        throw (IO.userError \\\"foreign partition member row\\\")\\n      if references > 0 && count < quota then\\n        keys := key::keys\\n        count := count+1\\n        taken := taken+1\\n    if taken < cellCount || selected.incomplete then partialCell := true\\n  let result := Nominations.mk keys.reverse visited ready.header.cells ready.header.basis.rows partialCell (2*quota-remaining)\\n  if bounded : result.keys.length ≤ quota ∧ result.physicalRows ≤ 2*quota then return ⟨result,bounded⟩\\n  else throw (IO.userError \\\"partition nomination exceeds its checked quota\\\")\\n\\nend Eggshell.VectorPartition\\n\"]]]"],["tools.BudgetPlan","[\"module\\n\\npublic import Std\\n\\n@[expose] public section\\nnamespace Eggshell\\n\\n/-- Materialize budget-independent preparation before evaluating alternatives.\\nThe two real cases retain a constructor boundary in native compilation;\\nreturning a curried function lets arity expansion repeat preparation. -/\\ninductive BudgetPlan (α : Type) where\\n  | constant (value : Option α)\\n  | sized (render : Nat → Option α)\\n\\ndef BudgetPlan.eval (plan : BudgetPlan α) (budget : Nat) : Option α :=\\n  match plan with\\n  | .constant value => value\\n  | .sized render => render budget\\n\\ndef BudgetPlan.map (f : α → β) : BudgetPlan α → BudgetPlan β\\n  | .constant value => .constant (value.map f)\\n  | .sized render => .sized fun budget => (render budget).map f\\n\\ntheorem BudgetPlan.eval_map (f : α → β) (plan : BudgetPlan α) (budget : Nat) :\\n    (plan.map f).eval budget = (plan.eval budget).map f := by\\n  cases plan <;> rfl\\n\\nend Eggshell\\n\",[]]"],["tools.ClosedCoverage","[\"module\\npublic import tools.SharedCoverage\\n@[expose] public section\\n\\nnamespace ClosedCoverage\\n\\n/-- A proposal may earn an additional cue only together with every original\\npayload offer it names. This module cannot name Work, Match or Union. -/\\nstructure Recipe (p : SharedCoverage.Problem) where\\n  parts : List (Fin p.offers.size)\\n  bonus : List (Fin p.weights.size) := []\\n\\ndef Recipe.offer (recipe : Recipe p) : SharedCoverage.Offer p.costs.size p.weights.size := {\\n  closure := recipe.parts.flatMap fun index => p.offers[index].closure\\n  covers := (recipe.parts.flatMap fun index => p.offers[index].covers) ++ recipe.bonus}\\n\\ndef compile (p : SharedCoverage.Problem) (recipes : Array (Recipe p)) : SharedCoverage.Problem := {\\n  costs := p.costs, weights := p.weights, offers := recipes.map Recipe.offer\\n  fixed := p.fixed, limit := p.limit}\\n\\ndef original (p : SharedCoverage.Problem) : Array (Recipe p) :=\\n  (List.finRange p.offers.size).toArray.map fun index => {parts := [index]}\\n\\ndef recipeAt (p : SharedCoverage.Problem) (recipes : Array (Recipe p))\\n    (index : Fin (compile p recipes).offers.size) : Recipe p :=\\n  recipes[index.val]'(by simpa [compile] using index.isLt)\\n\\ntheorem offer_at (p : SharedCoverage.Problem) (recipes : Array (Recipe p))\\n    (index : Fin (compile p recipes).offers.size) :\\n    (compile p recipes).offers[index] = (recipeAt p recipes index).offer := by\\n  have bounds : index.val < recipes.size := by simpa [compile] using index.isLt\\n  change (recipes.map Recipe.offer)[index.val]'(by simpa using bounds) =\\n    (recipes[index.val]'bounds).offer\\n  rw [Array.getElem_map]\\n\\ndef expand (p : SharedCoverage.Problem) (recipes : Array (Recipe p))\\n    (selected : List (Fin (compile p recipes).offers.size)) : List (Fin p.offers.size) :=\\n  selected.flatMap fun index => (recipeAt p recipes index).parts\\n\\ntheorem part_is_expanded (p : SharedCoverage.Problem) (recipes : Array (Recipe p))\\n    (selected : List (Fin (compile p recipes).offers.size))\\n    (index : Fin (compile p recipes).offers.size) (chosen : index ∈ selected)\\n    (part : Fin p.offers.size) (required : part ∈ (recipeAt p recipes index).parts) :\\n    part ∈ expand p recipes selected := by\\n  exact List.mem_flatMap.mpr ⟨index,chosen,required⟩\\n\\ntheorem closure_expansion (p : SharedCoverage.Problem) (recipes : Array (Recipe p))\\n    (selected : List (Fin (compile p recipes).offers.size)) :\\n    selected.flatMap (fun index => (compile p recipes).offers[index].closure) =\\n      (expand p recipes selected).flatMap (fun index => p.offers[index].closure) := by\\n  simp only [offer_at, Recipe.offer, expand, List.flatMap_assoc]\\n  rfl\\n\\ntheorem cost_expansion (p : SharedCoverage.Problem) (recipes : Array (Recipe p))\\n    (selected : List (Fin (compile p recipes).offers.size)) :\\n    SharedCoverage.cost (compile p recipes) selected =\\n      SharedCoverage.cost p (expand p recipes selected) := by\\n  unfold SharedCoverage.cost SharedCoverage.nodes\\n  rw [closure_expansion]\\n  rfl\\n\\n/-- The gate changes when an existing source cue can be credited, not its\\nmaximum value. Duplicate evidence cannot create a second source vote. -/\\ntheorem bonus_conserved (base graph : Nat) : base + (max base graph - base) = max base graph := by\\n  omega\\n\\ntheorem credited_has_complete_recipe (p : SharedCoverage.Problem) (recipes : Array (Recipe p))\\n    (selected : List (Fin (compile p recipes).offers.size))\\n    (index : Fin (compile p recipes).offers.size) (chosen : index ∈ selected)\\n    (cue : Fin p.weights.size) (credited : cue ∈ (recipeAt p recipes index).bonus) :\\n    cue ∈ SharedCoverage.cues (compile p recipes) selected ∧\\n      ∀ part ∈ (recipeAt p recipes index).parts, part ∈ expand p recipes selected := by\\n  constructor\\n  · have present : cue ∈ selected.flatMap (fun index => (compile p recipes).offers[index].covers) := by\\n      apply List.mem_flatMap.mpr\\n      refine ⟨index,chosen,?_⟩\\n      rw [offer_at]\\n      exact List.mem_append_right _ credited\\n    change cue ∈ (selected.flatMap (fun index => (compile p recipes).offers[index].covers)).eraseDups\\n    exact List.mem_eraseDups.mpr present\\n  · intro part required\\n    exact part_is_expanded p recipes selected index chosen part required\\n\\nend ClosedCoverage\\n\",[]]"],["tools.ContentCorrespondence","[\"module\\npublic import Std.Data.HashMap\\npublic import Std.Data.HashSet.Lemmas\\n@[expose] public section\\n\\n/- Content correspondence has no command, file-system, Work, Match or Union\\ninput. A capture adapter must supply verified acquired input records and retain\\ntheir identities. This module proves equality of content at actual positions;\\nit does not turn a matching string into an execution or freshness certificate. -/\\nnamespace ContentCorrespondence\\n\\nabbrev Inputs := Array (Array String)\\nabbrev Position := Nat × Nat\\nvariable {inputs : Inputs}\\n\\ndef positions (inputs : Inputs) : List Position :=\\n  (List.finRange inputs.size).flatMap fun source =>\\n    (List.finRange inputs[source].size).map fun row => (source.val,row.val)\\n\\ntheorem position_present (source : Fin inputs.size) (row : Fin inputs[source].size) :\\n    (source.val,row.val) ∈ positions inputs := by\\n  apply List.mem_flatMap.mpr\\n  refine ⟨source,by simp,?_⟩\\n  exact List.mem_map.mpr ⟨row,by simp,rfl⟩\\n\\ndef textAt (inputs : Inputs) (position : Position) : String :=\\n  ((inputs[position.1]?).bind fun rows => rows[position.2]?).getD \\\"\\\"\\n\\n@[simp] theorem textAt_present (source : Fin inputs.size) (row : Fin inputs[source].size) :\\n    textAt inputs (source.val,row.val) = inputs[source][row] := by\\n  simp [textAt]\\n\\nstructure Correspondence (inputs : Inputs) (text : String) (position : Position) : Type where\\n  sourceBound : position.1 < inputs.size\\n  rowBound : position.2 < (inputs[position.1]'sourceBound).size\\n  original : (inputs[position.1]'sourceBound)[position.2]'rowBound = text\\n\\ndef check? (inputs : Inputs) (text : String) (position : Position) :\\n    Option (Correspondence inputs text position) :=\\n  if sourceBound : position.1 < inputs.size then\\n    if rowBound : position.2 < inputs[position.1].size then\\n      if original : inputs[position.1][position.2] = text then\\n        some ⟨sourceBound,rowBound,original⟩ else none\\n    else none\\n  else none\\n\\nabbrev Buckets := Std.HashMap String (Std.HashSet Position)\\n\\ndef bucket (buckets : Buckets) (text : String) : Std.HashSet Position :=\\n  buckets[text]?.getD {}\\n\\n/-- The one-time completeness check permits safe absence/ambiguity decisions.\\nHash collisions never suffice: the map key is the full original string. -/\\ndef complete (inputs : Inputs) (buckets : Buckets) : Bool :=\\n  (positions inputs).all fun position => (bucket buckets (textAt inputs position)).contains position\\n\\nstructure Index (inputs : Inputs) where\\n  buckets : Buckets\\n  complete : complete inputs buckets = true\\n\\ndef checkedIndex? (inputs : Inputs) (buckets : Buckets) : Option (Index inputs) :=\\n  if checked : complete inputs buckets = true then some ⟨buckets,checked⟩ else none\\n\\ndef prepare? (inputs : Inputs) : Option (Index inputs) := Id.run do\\n  let mut buckets : Buckets := {}\\n  for position in positions inputs do\\n    let text := textAt inputs position\\n    buckets := buckets.insert text ((bucket buckets text).insert position)\\n  return checkedIndex? inputs buckets\\n\\ntheorem Index.contains_original (index : Index inputs) (source : Fin inputs.size)\\n    (row : Fin inputs[source].size) (text : String) (same : inputs[source][row] = text) :\\n    (bucket index.buckets text).contains (source.val,row.val) = true := by\\n  have present := List.all_eq_true.mp index.complete (source.val,row.val) (position_present source row)\\n  simpa only [textAt_present,same] using present\\n\\nstructure Unique (index : Index inputs) (text : String) where\\n  position : Position\\n  correspondence : Correspondence inputs text position\\n  only : (bucket index.buckets text).toList = [position]\\n\\ndef Index.unique? (index : Index inputs) (text : String) : Option (Unique index text) :=\\n  match found : (bucket index.buckets text).toList with\\n  | [position] => do\\n      let correspondence ← check? inputs text position\\n      some ⟨position,correspondence,found⟩\\n  | _ => none\\n\\ntheorem Unique.only_original {index : Index inputs} {text : String}\\n    (unique : Unique index text) (source : Fin inputs.size)\\n    (row : Fin inputs[source].size) (same : inputs[source][row] = text) :\\n    unique.position = (source.val,row.val) := by\\n  have included := index.contains_original source row text same\\n  have present : (source.val,row.val) ∈ (bucket index.buckets text).toList :=\\n    Std.HashSet.mem_toList.mpr (Std.HashSet.mem_iff_contains.mpr included)\\n  rw [unique.only] at present\\n  exact (List.mem_singleton.mp present).symm\\n\\n/-- Neighboring records are accepted only through literal sequence equality.\\nThe adapter may propose a run around a unique anchor, but cannot fill a gap\\nfrom a path name, line-number hint or presumed tool operation. -/\\nstructure Run (inputs : Inputs) (output : Array String)\\n    (source first outputFirst count : Nat) : Type where\\n  nonempty : 0 < count\\n  sourceBound : source < inputs.size\\n  sourceEnd : first+count ≤ (inputs[source]'sourceBound).size\\n  outputEnd : outputFirst+count ≤ output.size\\n  original : ∀ offset : Fin count,\\n    (inputs[source]'sourceBound)[first+offset.val]'(by have := offset.isLt; omega) =\\n      output[outputFirst+offset.val]'(by have := offset.isLt; omega)\\n\\ndef run? (inputs : Inputs) (output : Array String) (source first outputFirst count : Nat) :\\n    Option (Run inputs output source first outputFirst count) :=\\n  if nonempty : 0 < count then\\n    if sourceBound : source < inputs.size then\\n      if sourceEnd : first+count ≤ inputs[source].size then\\n        if outputEnd : outputFirst+count ≤ output.size then\\n          if original : (List.finRange count).all (fun offset =>\\n              decide (inputs[source][first+offset.val]'(by have := offset.isLt; omega) =\\n                output[outputFirst+offset.val]'(by have := offset.isLt; omega))) = true then\\n            some ⟨nonempty,sourceBound,sourceEnd,outputEnd,by\\n              intro offset\\n              simpa only [decide_eq_true_eq] using\\n                (List.all_eq_true.mp original offset (by simp))⟩\\n          else none\\n        else none\\n      else none\\n    else none\\n  else none\\n\\nstructure AnchoredRun (index : Index inputs) (output : Array String) (anchorIndex : Fin output.size)\\n    (anchor : Unique index output[anchorIndex]) (first count : Nat) : Type where\\n  contains : first ≤ anchorIndex.val ∧ anchorIndex.val < first+count\\n  preceding : anchorIndex.val-first ≤ anchor.position.2\\n  original : Run inputs output anchor.position.1 (anchor.position.2-(anchorIndex.val-first)) first count\\n\\n/-- The source and its starting position come from a unique content anchor,\\nnot a guessed path. Every neighboring output record is checked again. -/\\ndef anchoredRun? (index : Index inputs) (output : Array String) (anchorIndex : Fin output.size)\\n    (anchor : Unique index output[anchorIndex]) (first count : Nat) :\\n    Option (AnchoredRun index output anchorIndex anchor first count) :=\\n  if contains : first ≤ anchorIndex.val ∧ anchorIndex.val < first+count then\\n    if preceding : anchorIndex.val-first ≤ anchor.position.2 then do\\n      let original ← run? inputs output anchor.position.1 (anchor.position.2-(anchorIndex.val-first)) first count\\n      some ⟨contains,preceding,original⟩\\n    else none\\n  else none\\n\\ntheorem AnchoredRun.anchor_preserved (run : AnchoredRun index output anchorIndex anchor first count) :\\n    anchor.position.2-(anchorIndex.val-first)+(anchorIndex.val-first) = anchor.position.2 := by\\n  have := run.preceding\\n  omega\\n\\n/-- Capture needs only absence, one location, or proven ambiguity. It never\\nstores an unbounded posting list for common records such as `}`. Replaying\\nthe same immutable input position does not manufacture ambiguity. -/\\ninductive Candidate where\\n  | absent\\n  | one (position : Position)\\n  | ambiguous\\n  deriving DecidableEq, BEq, Repr\\n\\ndef Candidate.join : Candidate → Candidate → Candidate\\n  | .absent,right => right\\n  | left,.absent => left\\n  | .one left,.one right => if left = right then .one left else .ambiguous\\n  | _,_ => .ambiguous\\n\\n@[simp] theorem Candidate.absent_join (candidate : Candidate) :\\n    Candidate.absent.join candidate = candidate := rfl\\n\\n@[simp] theorem Candidate.join_absent (candidate : Candidate) :\\n    candidate.join .absent = candidate := by cases candidate <;> rfl\\n\\n@[simp] theorem Candidate.ambiguous_join (candidate : Candidate) :\\n    Candidate.ambiguous.join candidate = .ambiguous := by cases candidate <;> rfl\\n\\n@[simp] theorem Candidate.join_ambiguous (candidate : Candidate) :\\n    candidate.join .ambiguous = .ambiguous := by cases candidate <;> rfl\\n\\ntheorem Candidate.join_idempotent (candidate : Candidate) :\\n    candidate.join candidate = candidate := by\\n  cases candidate <;> simp [join]\\n\\ntheorem Candidate.join_commutative (left right : Candidate) :\\n    left.join right = right.join left := by\\n  cases left <;> cases right <;>\\n    try simp only [absent_join,join_absent,ambiguous_join,join_ambiguous]\\n  rename_i a b\\n  by_cases same : a = b\\n  · subst b; simp [join]\\n  · simp [join,same,Ne.symm same]\\n\\ntheorem Candidate.join_associative (left middle right : Candidate) :\\n    (left.join middle).join right = left.join (middle.join right) := by\\n  cases left <;> cases middle <;> cases right <;>\\n    try simp only [absent_join,join_absent,ambiguous_join,join_ambiguous]\\n  rename_i a b c\\n  by_cases same : a = b\\n  · subst b\\n    by_cases next : a = c <;> simp [join,next]\\n  · by_cases next : b = c\\n    · subst c; simp [join,same]\\n    · simp [join,same,next]\\n\\nabbrev StreamIndex := Std.HashMap String Candidate\\n\\ndef start (output : Array String) : StreamIndex :=\\n  output.foldl (fun index text => index.insert text .absent) {}\\n\\n/-- Index the bounded observed output, then stream the acquired input once.\\nUnwanted input records allocate no entry. The capture adapter must seal all\\ninput fingerprints and EOF before treating a `.one` as final correspondence. -/\\ndef observe (index : StreamIndex) (position : Position) (text : String) : StreamIndex :=\\n  index.modify text (fun candidate => candidate.join (.one position))\\n\\ntheorem observe_size (index : StreamIndex) (position : Position) (text : String) :\\n    (observe index position text).size = index.size := by\\n  exact Std.HashMap.size_modify\\n\\ntheorem observe_keeps_domain (index : StreamIndex) (position : Position) (text query : String) :\\n    (observe index position text).contains query = index.contains query := by\\n  exact Std.HashMap.contains_modify\\n\\nend ContentCorrespondence\\n\",[]]"],["tools.DeferredCoverage","[\"module\\npublic import tools.SharedCoverage\\npublic import tools.KeyPostings\\n@[expose] public section\\n\\nnamespace SharedCoverage.Deferred\\nopen Eggshell\\nvariable {p : Problem} {prior : Selection p}\\n\\n/-- Fuse mapping and natural-number accumulation. This remains exact for\\narbitrarily large weights; no floating-point arithmetic enters selection. -/\\ndef weighted (measure : α → Nat) (values : List α) : Nat :=\\n  values.foldl (fun total value => total+measure value) 0\\n\\ntheorem weighted_exact (measure : α → Nat) (values : List α) :\\n    weighted measure values = (values.map measure).sum := by\\n  simp only [weighted,List.sum_eq_foldl_nat,List.foldl_map]\\n\\ndef benefitFold (p : Problem) (selected : List (Fin p.offers.size)) : Nat :=\\n  weighted (fun cue => p.weights[cue]) (cues p selected)\\n\\n@[csimp] theorem benefit_fold_compiled : @benefit = @benefitFold := by\\n  funext p selected\\n  exact (weighted_exact (fun cue => p.weights[cue]) (cues p selected)).symm\\n\\ndef afterBenefitFold (cached : Evaluation prior) (index : Fin p.offers.size) : Nat :=\\n  let fresh := hashDistinct (p.offers[index].covers.filter fun cue => !cached.cueIndex.contains cue)\\n  cached.beforeBenefit + weighted (fun cue => p.weights[cue]) fresh\\n\\n@[csimp] theorem after_benefit_fold_compiled : @Evaluation.afterBenefit = @afterBenefitFold := by\\n  funext p prior cached index\\n  simp only [Evaluation.afterBenefit,afterBenefitFold,weighted_exact]\\n\\n/-- Membership is fixed for one scan. Every lookup is tied to the actual\\nselected list; no unchecked cached membership can reject an offer. -/\\nstructure Known (prior : Selection p) where\\n  selected : Std.HashMap (Fin p.offers.size) Unit\\n  exact : ∀ index, selected.contains index = prior.selected.contains index\\n\\ndef known (prior : Selection p) : Known prior := {\\n  selected := prior.selected.foldl (fun found index => found.insert index ()) {}\\n  exact := by intro index; simp [HashDistinct.fold_contains]}\\n\\ndef Known.fresh (seen : Known prior) (index : Fin p.offers.size) : Decidable (index ∉ prior.selected) :=\\n  if present : seen.selected.contains index = true then\\n    isFalse (by\\n      have member : index ∈ prior.selected := List.contains_iff_mem.mp (by rwa [seen.exact] at present)\\n      exact fun absent => absent member)\\n  else isTrue (by\\n    intro member\\n    apply present\\n    rw [seen.exact]\\n    exact List.contains_iff_mem.mpr member)\\n\\ntheorem Known.fresh_exact (seen : Known prior) (index : Fin p.offers.size) :\\n    seen.fresh index = (inferInstance : Decidable (index ∉ prior.selected)) := Subsingleton.elim _ _\\n\\n/-- Losing candidates carry only an index and scalar score. Construct the\\nextended selected list once, after choosing the winner. -/\\nstructure Score (prior : Selection p) (cached : Evaluation prior) where\\n  index : Fin p.offers.size\\n  fresh : index ∉ prior.selected\\n  fits : (cached.afterCost index).1 ≤ p.limit.1 ∧ (cached.afterCost index).2 ≤ p.limit.2\\n  gain : Nat\\n  positive : 0 < gain\\n  charge : Nat\\n\\ndef Score.proposal (score : Score prior cached) : Proposal prior := {\\n  result := {\\n    selected := prior.selected ++ [score.index]\\n    unique := by\\n      apply List.nodup_append.mpr\\n      refine ⟨prior.unique,by simp,?_⟩\\n      intro a present b singleton same\\n      have last : b = score.index := List.mem_singleton.mp singleton\\n      exact score.fresh ((same.trans last) ▸ present)\\n    charsFit := by rw [← cached.afterCost_exact score.index]; exact score.fits.1\\n    bytesFit := by rw [← cached.afterCost_exact score.index]; exact score.fits.2}\\n  gain := score.gain,positive := score.positive,charge := score.charge}\\n\\ndef score? (prior : Selection p) (cached : Evaluation prior) (seen : Known prior)\\n    (index : Fin p.offers.size) : Option (Score prior cached) :=\\n  letI : Decidable (index ∉ prior.selected) := seen.fresh index\\n  if fresh : index ∉ prior.selected then\\n    let after := cached.afterCost index\\n    if fits : after.1 ≤ p.limit.1 ∧ after.2 ≤ p.limit.2 then\\n      let gain := cached.afterBenefit index-cached.beforeBenefit\\n      if positive : 0 < gain then\\n        some ⟨index,fresh,fits,gain,positive,\\n          max ((after.1-cached.beforeCost.1)*p.limit.2) ((after.2-cached.beforeCost.2)*p.limit.1)⟩\\n      else none\\n    else none\\n  else none\\n\\ntheorem score_exact (cached : Evaluation prior) (seen : Known prior) (index : Fin p.offers.size) :\\n    (score? prior cached seen index).map Score.proposal = proposalCached? prior cached index := by\\n  unfold score? proposalCached? extendCached?\\n  by_cases fresh : index ∉ prior.selected\\n  · by_cases fits : (cached.afterCost index).1 ≤ p.limit.1 ∧ (cached.afterCost index).2 ≤ p.limit.2\\n    · by_cases positive : 0 < cached.afterBenefit index-cached.beforeBenefit\\n      · simp [fresh,fits,positive,Score.proposal]\\n      · simp [fresh,fits,positive]\\n    · simp [fresh,fits]\\n  · simp [fresh]\\n\\ndef betterScore (next previous : Score prior cached) : Bool :=\\n  if next.charge == 0 then previous.charge != 0 || previous.gain < next.gain\\n  else if previous.charge == 0 then false\\n  else previous.gain*next.charge < next.gain*previous.charge\\n\\ntheorem betterScore_exact (next previous : Score prior cached) :\\n    betterScore next previous = better next.proposal previous.proposal := rfl\\n\\ndef step (prior : Selection p) (cached : Evaluation prior) (seen : Known prior)\\n    (found : Option (Score prior cached)) (index : Fin p.offers.size) : Option (Score prior cached) :=\\n  match score? prior cached seen index,found with\\n  | none,_ => found\\n  | some next,none => some next\\n  | some next,some previous => if betterScore next previous then some next else found\\n\\ndef referenceStep (prior : Selection p) (cached : Evaluation prior)\\n    (found : Option (Proposal prior)) (index : Fin p.offers.size) : Option (Proposal prior) :=\\n  match proposalCached? prior cached index,found with\\n  | none,_ => found\\n  | some next,none => some next\\n  | some next,some previous => if better next previous then some next else found\\n\\ntheorem step_exact (cached : Evaluation prior) (seen : Known prior)\\n    (found : Option (Score prior cached)) (index : Fin p.offers.size) :\\n    (step prior cached seen found index).map Score.proposal =\\n      referenceStep prior cached (found.map Score.proposal) index := by\\n  unfold step referenceStep\\n  rw [← score_exact cached seen index]\\n  cases current : score? prior cached seen index with\\n  | none => cases found <;> rfl\\n  | some next =>\\n      cases found with\\n      | none => rfl\\n      | some previous =>\\n          cases selected : betterScore next previous <;>\\n            simp [selected, ← betterScore_exact]\\n\\ntheorem scan_exact (cached : Evaluation prior) (seen : Known prior)\\n    (pending : List (Fin p.offers.size)) (found : Option (Score prior cached)) :\\n    (pending.foldl (step prior cached seen) found).map Score.proposal =\\n      pending.foldl (referenceStep prior cached) (found.map Score.proposal) := by\\n  induction pending generalizing found with\\n  | nil => rfl\\n  | cons head tail ih =>\\n      simp only [List.foldl_cons,ih,step_exact]\\n\\ndef bestDeferred (prior : Selection p) : Option (Proposal prior) :=\\n  let cached := evaluation prior\\n  let seen := known prior\\n  ((List.finRange p.offers.size).foldl (step prior cached seen) none).map Score.proposal\\n\\ntheorem bestDeferred_exact (prior : Selection p) : bestDeferred prior = best prior := by\\n  rw [best_cached_compiled]\\n  unfold bestDeferred bestCached\\n  rw [scan_exact]\\n  rfl\\n\\ndef fillDeferred (fuel : Nat) (prior : Selection p) : Selection p :=\\n  match fuel with\\n  | 0 => prior\\n  | fuel+1 => match bestDeferred prior with\\n    | none => prior\\n    | some next => fillDeferred fuel next.result\\n\\ntheorem fillDeferred_exact (fuel : Nat) (prior : Selection p) :\\n    fillDeferred fuel prior = fill fuel prior := by\\n  induction fuel generalizing prior with\\n  | zero => rfl\\n  | succ fuel ih =>\\n      simp only [fillDeferred,fill,bestDeferred_exact]\\n      cases best prior with\\n      | none => rfl\\n      | some next => exact ih next.result\\n\\ndef chooseDeferred? (p : Problem) : Option (Selection p) := do\\n  let initial ← empty? p\\n  pure (prefer (fillDeferred p.offers.size initial) (bestSingleton initial))\\n\\ntheorem choose_deferred_compiled : @choose? = @chooseDeferred? := by\\n  funext p\\n  simp only [choose?,chooseFrom,chooseDeferred?,fillDeferred_exact]\\n\\nnamespace Sparse\\n\\n/-- The reverse incidence contains all full feature/offer identities. Hashes\\nnominate buckets only. Duplicate features remain harmless during updates. -/\\ndef pairs (features : Fin n → List (Fin d)) : Array (Fin d × Fin n) :=\\n  ((List.finRange n).flatMap fun index => (features index).map (·,index)).toArray\\n\\nstructure Incidence (features : Fin n → List (Fin d)) where\\n  index : KeyPostings.Index Prod.fst (pairs features)\\n\\ndef incidence (features : Fin n → List (Fin d)) : Incidence features :=\\n  ⟨KeyPostings.prepare Prod.fst (pairs features)⟩\\n\\ndef Incidence.lookup {features : Fin n → List (Fin d)}\\n    (layout : Incidence features) (feature : Fin d) : List (Fin n) :=\\n  ((layout.index.lookup feature).map Prod.snd).toList\\n\\ntheorem Incidence.lookup_exact {features : Fin n → List (Fin d)}\\n    (layout : Incidence features) (feature : Fin d) (offer : Fin n) :\\n    offer ∈ layout.lookup feature ↔ feature ∈ features offer := by\\n  unfold Incidence.lookup\\n  rw [layout.index.lookup_exact]\\n  simp only [Array.toList_map,Array.toList_filterMap,\\n    pairs,List.mem_filterMap,List.mem_flatMap,\\n    List.mem_map,List.mem_finRange,true_and]\\n  constructor\\n  · rintro ⟨pair,⟨_,⟨i,value,member,rfl⟩,kept⟩,last⟩\\n    by_cases equal : value = feature\\n    · simp only [equal,BEq.rfl,ite_true,Option.some.injEq] at kept\\n      subst pair\\n      simpa only [Prod.snd] using last ▸ equal ▸ member\\n    · simp [equal] at kept\\n  · intro member\\n    exact ⟨(feature,offer),⟨(feature,offer),⟨offer,feature,member,rfl⟩,by simp⟩,rfl⟩\\n\\ndef Incidence.touched {features : Fin n → List (Fin d)}\\n    (layout : Incidence features) (added : List (Fin d)) : List (Fin n) :=\\n  added.flatMap layout.lookup\\n\\ntheorem Incidence.touched_complete {features : Fin n → List (Fin d)}\\n    (layout : Incidence features) (added : List (Fin d)) (offer : Fin n)\\n    (feature : Fin d) (present : feature ∈ features offer) (new : feature ∈ added) :\\n    offer ∈ layout.touched added :=\\n  List.mem_flatMap.mpr ⟨feature,new,(layout.lookup_exact feature offer).mpr present⟩\\n\\ndef patch (values : Vector α n) (replacement : Fin n → α) (indices : List (Fin n)) : Vector α n :=\\n  indices.foldl (fun current (index : Fin n) => current.set index.val (replacement index) index.isLt) values\\n\\ntheorem patch_exact (values : Vector α n) (replacement : Fin n → α)\\n    (indices : List (Fin n)) (query : Fin n) :\\n    (patch values replacement indices)[query] =\\n      if query ∈ indices then replacement query else values[query] := by\\n  induction indices generalizing values with\\n  | nil => simp [patch]\\n  | cons head tail ih =>\\n    change (patch (values.set head.val (replacement head) head.isLt) replacement tail)[query] = _\\n    rw [ih]\\n    by_cases member : query ∈ tail\\n    · simp [member]\\n    · by_cases same : query = head\\n      · subst query; simp [member]\\n      · have different : head.val ≠ query.val := by\\n          intro equal; exact same (Fin.ext equal.symm)\\n        simp [member,same,different]\\n\\ndef rawCost (cached : Evaluation prior) (index : Fin p.offers.size) : Nat × Nat :=\\n  (hashDistinct (p.offers[index].closure.filter fun node => !cached.nodeIndex.contains node)).foldl\\n    (fun total node => (total.1+p.costs[node].1,total.2+p.costs[node].2)) (0,0)\\n\\ndef rawGain (cached : Evaluation prior) (index : Fin p.offers.size) : Nat :=\\n  weighted (fun cue => p.weights[cue])\\n    (hashDistinct (p.offers[index].covers.filter fun cue => !cached.cueIndex.contains cue))\\n\\ntheorem fold_cost_base (p : Problem) (items : List (Fin p.costs.size)) (base : Nat × Nat) :\\n    items.foldl (fun total node => (total.1+p.costs[node].1,total.2+p.costs[node].2)) base =\\n    let zero := items.foldl (fun total node => (total.1+p.costs[node].1,total.2+p.costs[node].2)) (0,0)\\n    (base.1+zero.1,base.2+zero.2) := by\\n  induction items generalizing base with\\n  | nil => simp\\n  | cons head tail ih =>\\n    simp only [List.foldl_cons]\\n    simp only [Nat.zero_add]\\n    rw [ih _ , ih (p.costs[head].1,p.costs[head].2)]\\n    simp [Nat.add_assoc]\\n\\ntheorem rawCost_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\\n    cached.afterCost index =\\n      (cached.beforeCost.1+(rawCost cached index).1,cached.beforeCost.2+(rawCost cached index).2) := by\\n  exact fold_cost_base _ _ _\\n\\ntheorem rawGain_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\\n    cached.afterBenefit index = cached.beforeBenefit+rawGain cached index := by\\n  simp only [Evaluation.afterBenefit,rawGain,weighted_exact]\\n\\ndef marginal (prior : Selection p) (index : Fin p.offers.size) : (Nat × Nat) × Nat :=\\n  let cached := evaluation prior\\n  (rawCost cached index,rawGain cached index)\\n\\nstructure Values (prior : Selection p) where\\n  base : Evaluation prior\\n  baseExact : base = evaluation prior\\n  costs : Vector (Nat × Nat) p.offers.size\\n  gains : Vector Nat p.offers.size\\n  costsExact : ∀ index, costs[index] = rawCost (evaluation prior) index\\n  gainsExact : ∀ index, gains[index] = rawGain (evaluation prior) index\\n\\ndef values (prior : Selection p) : Values prior :=\\n  let cached := evaluation prior\\n  ⟨cached,rfl,Vector.ofFn (rawCost cached),Vector.ofFn (rawGain cached),\\n    by intro index; simp [cached],by intro index; simp [cached]⟩\\n\\ntheorem features_unchanged (features : Fin n → List (Fin d)) (selected : List (Fin n))\\n    (winner offer : Fin n)\\n    (covered : ∀ feature ∈ features offer, feature ∈ features winner → feature ∈ selected.flatMap features)\\n    (feature : Fin d) (present : feature ∈ features offer) :\\n    ((selected++[winner]).flatMap features).contains feature =\\n      (selected.flatMap features).contains feature := by\\n  by_cases already : feature ∈ selected.flatMap features\\n  · simp [List.flatMap_append,List.contains_eq_mem,already]\\n  · have absent : feature ∉ features winner := fun member => already (covered feature present member)\\n    simp [List.flatMap_append,List.contains_eq_mem,already,absent]\\n\\ntheorem nodeFilter_unchanged (prior next : Selection p) (winner offer : Fin p.offers.size)\\n    (extension : next.selected = prior.selected++[winner])\\n    (covered : ∀ node ∈ p.offers[offer].closure, node ∈ p.offers[winner].closure →\\n      (evaluation prior).nodeIndex.contains node = true) :\\n    p.offers[offer].closure.filter (fun node => !(evaluation prior).nodeIndex.contains node) =\\n      p.offers[offer].closure.filter (fun node => !(evaluation next).nodeIndex.contains node) := by\\n    apply List.filter_congr\\n    intro node present\\n    rw [(evaluation prior).nodesExact,(evaluation next).nodesExact]\\n    simp only [nodes,List.contains_eq_mem,List.mem_eraseDups,extension]\\n    simpa only [List.contains_eq_mem] using congrArg (! ·)\\n      (features_unchanged (fun i => p.offers[i].closure)\\n        prior.selected winner offer (by\\n          intro value member included\\n          have seen := covered value member included\\n          rw [(evaluation prior).nodesExact] at seen\\n          simpa [nodes] using List.contains_iff_mem.mp seen) node present).symm\\n\\ntheorem cueFilter_unchanged (prior next : Selection p) (winner offer : Fin p.offers.size)\\n    (extension : next.selected = prior.selected++[winner])\\n    (covered : ∀ cue ∈ p.offers[offer].covers, cue ∈ p.offers[winner].covers →\\n      (evaluation prior).cueIndex.contains cue = true) :\\n    p.offers[offer].covers.filter (fun cue => !(evaluation prior).cueIndex.contains cue) =\\n      p.offers[offer].covers.filter (fun cue => !(evaluation next).cueIndex.contains cue) := by\\n    apply List.filter_congr\\n    intro cue present\\n    rw [(evaluation prior).cuesExact,(evaluation next).cuesExact]\\n    simp only [cues,List.contains_eq_mem,List.mem_eraseDups,extension]\\n    simpa only [List.contains_eq_mem] using congrArg (! ·)\\n      (features_unchanged (fun i => p.offers[i].covers)\\n        prior.selected winner offer (by\\n          intro value member included\\n          have seen := covered value member included\\n          rw [(evaluation prior).cuesExact] at seen\\n          simpa [cues] using List.contains_iff_mem.mp seen) cue present).symm\\n\\ndef Incidence.changed {features : Fin n → List (Fin d)} (layout : Incidence features)\\n    (seen : Std.HashMap (Fin d) Unit) (added : List (Fin d)) : List (Fin n) :=\\n  hashDistinct (layout.touched (added.filter fun feature => !seen.contains feature))\\n\\n/-- Stream postings into one membership set. Do not build a large list of\\nduplicate affected offers merely to throw the duplicates away afterwards. -/\\ndef Incidence.changedStreaming {features : Fin n → List (Fin d)} (layout : Incidence features)\\n    (seen : Std.HashMap (Fin d) Unit) (added : List (Fin d)) : List (Fin n) :=\\n  let input := added.filter fun feature => !seen.contains feature\\n  let result := input.foldl (fun state feature => (layout.lookup feature).foldl HashDistinct.step state) ({},[])\\n  result.2.reverse\\n\\n@[csimp] theorem Incidence.changed_streaming_exact : @Incidence.changed = @Incidence.changedStreaming := by\\n  funext n d features layout seen added\\n  unfold changed changedStreaming Incidence.touched hashDistinct\\n  rw [List.foldl_flatMap]\\n  rfl\\n\\ntheorem Incidence.unchanged {features : Fin n → List (Fin d)} (layout : Incidence features)\\n    (seen : Std.HashMap (Fin d) Unit) (added : List (Fin d)) (offer : Fin n)\\n    (absent : offer ∉ layout.changed seen added) (feature : Fin d)\\n    (present : feature ∈ features offer) (included : feature ∈ added) :\\n    seen.contains feature = true := by\\n  cases found : seen.contains feature with\\n  | true => rfl\\n  | false =>\\n    apply False.elim\\n    apply absent\\n    exact (HashDistinct.mem _ _).mpr (layout.touched_complete _ _ feature present\\n      (List.mem_filter.mpr ⟨included,by simp [found]⟩))\\n\\nstructure Layout (p : Problem) where\\n  nodes : Incidence (fun i : Fin p.offers.size => p.offers[i].closure)\\n  cues : Incidence (fun i : Fin p.offers.size => p.offers[i].covers)\\n\\ndef layout (p : Problem) : Layout p := ⟨incidence _,incidence _⟩\\n\\ndef Values.advance (stored : Values prior) (layout : Layout p) (next : Selection p)\\n    (winner : Fin p.offers.size) (extension : next.selected = prior.selected++[winner]) : Values next :=\\n  let before := stored.base\\n  let after := evaluation next\\n  {base := after\\n   baseExact := rfl\\n   costs := patch stored.costs (rawCost after) (layout.nodes.changed before.nodeIndex p.offers[winner].closure)\\n   gains := patch stored.gains (rawGain after) (layout.cues.changed before.cueIndex p.offers[winner].covers)\\n   costsExact := by\\n    intro query\\n    rw [patch_exact]\\n    split\\n    · rfl\\n    · rename_i absent\\n      rw [stored.costsExact]\\n      simp only [before,stored.baseExact] at absent\\n      unfold rawCost\\n      rw [nodeFilter_unchanged prior next winner query extension\\n        (layout.nodes.unchanged _ _ _ absent)]\\n   gainsExact := by\\n    intro query\\n    rw [patch_exact]\\n    split\\n    · rfl\\n    · rename_i absent\\n      rw [stored.gainsExact]\\n      simp only [before,stored.baseExact] at absent\\n      unfold rawGain\\n      rw [cueFilter_unchanged prior next winner query extension\\n        (layout.cues.unchanged _ _ _ absent)]}\\n\\ndef Values.afterCost (stored : Values prior) (index : Fin p.offers.size) : Nat × Nat :=\\n  let before := stored.base.beforeCost\\n  (before.1+stored.costs[index].1,before.2+stored.costs[index].2)\\n\\ntheorem Values.afterCost_exact (stored : Values prior) (index : Fin p.offers.size) :\\n    stored.afterCost index = (evaluation prior).afterCost index := by\\n  simp only [Values.afterCost,stored.costsExact,stored.baseExact,rawCost_exact]\\n\\ntheorem Values.gain_exact (stored : Values prior) (index : Fin p.offers.size) :\\n    stored.gains[index] = (evaluation prior).afterBenefit index-(evaluation prior).beforeBenefit := by\\n  simp only [stored.gainsExact,rawGain_exact,Nat.add_sub_cancel_left]\\n\\ndef score? (prior : Selection p) (stored : Values prior) (seen : Known prior)\\n    (index : Fin p.offers.size) : Option (Score prior (evaluation prior)) :=\\n  letI : Decidable (index ∉ prior.selected) := seen.fresh index\\n  if fresh : index ∉ prior.selected then\\n    let after := stored.afterCost index\\n    if fits : after.1 ≤ p.limit.1 ∧ after.2 ≤ p.limit.2 then\\n      let gain := stored.gains[index]\\n      if positive : 0 < gain then\\n        some ⟨index,fresh,by\\n          dsimp only [after] at fits\\n          rwa [stored.afterCost_exact] at fits,gain,positive,\\n          max ((after.1-stored.base.beforeCost.1)*p.limit.2)\\n            ((after.2-stored.base.beforeCost.2)*p.limit.1)⟩\\n      else none\\n    else none\\n  else none\\n\\ntheorem score_exact (stored : Values prior) (seen : Known prior) (index : Fin p.offers.size) :\\n    score? prior stored seen index = Deferred.score? prior (evaluation prior) seen index := by\\n  simp only [score?,Deferred.score?,stored.afterCost_exact,stored.gain_exact,stored.baseExact]\\n\\ndef step (prior : Selection p) (stored : Values prior) (seen : Known prior)\\n    (found : Option (Score prior (evaluation prior))) (index : Fin p.offers.size) :=\\n  match score? prior stored seen index,found with\\n  | none,_ => found\\n  | some next,none => some next\\n  | some next,some previous => if betterScore next previous then some next else found\\n\\ntheorem step_exact (stored : Values prior) (seen : Known prior)\\n    (found : Option (Score prior (evaluation prior))) (index : Fin p.offers.size) :\\n    step prior stored seen found index = Deferred.step prior (evaluation prior) seen found index := by\\n  simp only [step,Deferred.step,score_exact]\\n  cases current : Deferred.score? prior (evaluation prior) seen index <;> cases found <;> rfl\\n\\ndef best (prior : Selection p) (stored : Values prior) : Option (Score prior (evaluation prior)) :=\\n  (List.finRange p.offers.size).foldl (step prior stored (known prior)) none\\n\\ntheorem best_exact (stored : Values prior) :\\n    (best prior stored).map Score.proposal = SharedCoverage.best prior := by\\n  have same : step prior stored (known prior) = Deferred.step prior (evaluation prior) (known prior) := by\\n    funext found index\\n    exact step_exact stored _ found index\\n  rw [← bestDeferred_exact]\\n  simp only [best,bestDeferred,same]\\n\\ndef fill (layout : Layout p) (fuel : Nat) (prior : Selection p) (stored : Values prior) : Selection p :=\\n  match fuel with\\n  | 0 => prior\\n  | fuel+1 => match best prior stored with\\n    | none => prior\\n    | some score =>\\n      let next := score.proposal.result\\n      fill layout fuel next (stored.advance layout next score.index rfl)\\n\\ntheorem fill_exact (layout : Layout p) (fuel : Nat) (prior : Selection p) (stored : Values prior) :\\n    fill layout fuel prior stored = SharedCoverage.fill fuel prior := by\\n  induction fuel generalizing prior with\\n  | zero => rfl\\n  | succ fuel ih =>\\n    rw [SharedCoverage.fill,← best_exact stored]\\n    cases found : best prior stored with\\n    | none => simp [fill,found]\\n    | some score =>\\n      simpa only [fill,found,Option.map_some] using\\n        (ih score.proposal.result (stored.advance layout _ score.index rfl))\\n\\ndef choose? (p : Problem) : Option (Selection p) := do\\n  let initial ← empty? p\\n  let prepared := layout p\\n  pure (prefer (fill prepared p.offers.size initial (values initial)) (bestSingleton initial))\\n\\n@[csimp] theorem choose_exact : @SharedCoverage.choose? = @choose? := by\\n  rw [choose_deferred_compiled]\\n  funext p\\n  simp only [chooseDeferred?,choose?,fill_exact,fillDeferred_exact]\\n\\nend Sparse\\nend SharedCoverage.Deferred\\n\",[]]"],["tools.DirectoryReads","[\"module\\n\\npublic import Eggshell.FileSystem\\n\\n@[expose] public section\\nnamespace Eggshell\\n\\n/-- One request's directory objects, including failures. A later request\\nopens a fresh view; a local write invalidates its own directory entry. -/\\nstructure DirectoryReads where\\n  directories : IO.Ref (Std.HashMap String (Except IO.Error FileSystem.ReadDirectory))\\n\\ndef DirectoryReads.new : IO DirectoryReads := do\\n  pure ⟨← IO.mkRef {}⟩\\n\\ndef DirectoryReads.open (reads : DirectoryReads) (path : System.FilePath) : IO FileSystem.ReadHandle := do\\n  let root := (path.parent.getD \\\".\\\").toString\\n  let opened ← match (← reads.directories.get)[root]? with\\n    | some opened => pure opened\\n    | none => do\\n        let opened ← try pure (.ok (← FileSystem.openReadDirectory root))\\n          catch error => pure (.error error)\\n        reads.directories.modify (·.insert root opened)\\n        pure opened\\n  match opened with\\n  | .error error => throw error\\n  | .ok directory => FileSystem.openReadAt directory (path.fileName.getD \\\"\\\")\\n\\ndef DirectoryReads.invalidate (reads : DirectoryReads) (path : System.FilePath) : IO Unit :=\\n  reads.directories.modify (·.erase (path.parent.getD \\\".\\\").toString)\\n\\nend Eggshell\\n\",[]]"],["tools.ExactLazyMemo","[\"module\\n\\npublic import Std\\n\\n@[expose] public section\\nnamespace Eggshell.ExactLazyMemo\\n\\nuniverse u\\nvariable {α : Type u}\\n\\n/-- A finite address tree with lazy branches and certified leaf values.\\nOnly paths actually read are constructed; repeated reads share Lean's Thunks.\\nGetter fields keep the indexed recursive type strictly positive. Construction\\nuses Thunk.fn, whose standard compiler equality preserves cached access. -/\\ninductive Tree (f : Nat → α) : Nat → Nat → Type u where\\n  | leaf (saved : Unit → {value : α // value = f first}) : Tree f first 0\\n  | branch (left : Unit → Tree f first depth)\\n      (right : Unit → Tree f (first + 2 ^ depth) depth) : Tree f first (depth + 1)\\n\\ndef make (f : Nat → α) (first : Nat) : (depth : Nat) → Tree f first depth\\n  | 0 => .leaf (Thunk.mk fun _ => ⟨f first, rfl⟩).fn\\n  | depth + 1 => .branch (Thunk.mk fun _ => make f first depth).fn\\n      (Thunk.mk fun _ => make f (first + 2 ^ depth) depth).fn\\n\\n/-- Out-of-domain addresses retain the exact result; they do not alias a leaf. -/\\ndef read (f : Nat → α) {first depth : Nat} (tree : Tree f first depth) (key : Nat) : α :=\\n  match tree with\\n  | .leaf saved => if key = first then (saved ()).val else f key\\n  | .branch left right =>\\n      if key < first + 2 ^ (depth - 1) then read f (left ()) key else read f (right ()) key\\ntermination_by depth\\n\\ntheorem read_exact (f : Nat → α) {first depth : Nat} (tree : Tree f first depth) (key : Nat) :\\n    read f tree key = f key := by\\n  induction depth generalizing first with\\n  | zero =>\\n      cases tree with\\n      | leaf saved =>\\n          simp only [read]\\n          split\\n          next same => rw [same]; exact (saved ()).property\\n          next => rfl\\n  | succ depth ih =>\\n      cases tree with\\n      | branch left right =>\\n          simp only [read]\\n          split <;> apply ih\\n\\nend Eggshell.ExactLazyMemo\\n\",[]]"],["tools.ExactMemo","[\"module\\n\\npublic import Std.Data.DHashMap\\n\\n@[expose] public section\\nnamespace Eggshell.ExactMemo\\n\\nvariable {α β : Type} [BEq α] [LawfulBEq α] [Hashable α]\\n\\n/-- Every value carries equality with this function at its actual lookup key.\\nThe dependent table cannot contain an unchecked or foreign-key result. -/\\nabbrev Table (f : α → β) := Std.DHashMap α (fun key => {value : β // value = f key})\\n\\ndef read (f : α → β) (table : Table f) (key : α) : β × Table f :=\\n  match table.get? key with\\n  | some checked => (checked.val, table)\\n  | none =>\\n      let value := f key\\n      (value, table.insert key ⟨value, rfl⟩)\\n\\ntheorem read_exact (f : α → β) (table : Table f) (key : α) :\\n    (read f table key).1 = f key := by\\n  unfold read\\n  cases found : table.get? key with\\n  | none => rfl\\n  | some checked => exact checked.property\\n\\ndef loop (f : α → β) (table : Table f) (items : List α) (kept : List β) : List β :=\\n  match items with\\n  | [] => kept.reverse\\n  | item :: rest =>\\n      let next := read f table item\\n      loop f next.2 rest (next.1 :: kept)\\n\\ntheorem loop_exact (f : α → β) (table : Table f) (items : List α) (kept : List β) :\\n    loop f table items kept = kept.reverse ++ items.map f := by\\n  induction items generalizing table kept with\\n  | nil => simp [loop]\\n  | cons item rest ih => simp [loop, ih, read_exact, List.reverse_cons, List.append_assoc]\\n\\ndef map (f : α → β) (items : List α) : List β := loop f {} items []\\n\\ntheorem map_exact (f : α → β) (items : List α) : map f items = items.map f := by\\n  simp [map, loop_exact]\\n\\n/-- Preserve order, multiplicity and absent results. Only evaluation is shared. -/\\ndef filterMap (f : α → Option β) (items : List α) : List β :=\\n  (map f items).filterMap id\\n\\ntheorem filterMap_exact (f : α → Option β) (items : List α) :\\n    filterMap f items = items.filterMap f := by\\n  simp [filterMap, map_exact, List.filterMap_map]\\n\\nend Eggshell.ExactMemo\\n\",[]]"],["tools.FirstIndex","[\"module\\npublic import Eggshell.HashDistinct\\n\\n@[expose] public section\\nnamespace Eggshell\\n\\nuniverse u\\nvariable {α : Type u}\\n\\n/-- The first full-key match wins, including duplicate keys. Nat keys remain\\nsparse; an untrusted large locator cannot request a proportional allocation. -/\\ndef firstTable (key : α → Nat) (rows : List α) : Std.HashMap Nat α :=\\n  rows.foldr (fun row table => table.insert (key row) row) {}\\n\\ntheorem firstTable_exact (key : α → Nat) (rows : List α) (query : Nat) :\\n    (firstTable key rows)[query]? = rows.find? (fun row => key row == query) := by\\n  induction rows with\\n  | nil => simp [firstTable]\\n  | cons row tail ih =>\\n      change ((firstTable key tail).insert (key row) row)[query]? =\\n        (row :: tail).find? (fun row => key row == query)\\n      rw [Std.HashMap.getElem?_insert, List.find?_cons, ih]\\n      cases key row == query <;> rfl\\n\\nstructure FirstIndex (key : α → Nat) (rows : List α) where\\n  table : Std.HashMap Nat α\\n  exact : ∀ query, table[query]? = rows.find? (fun row => key row == query)\\n\\ndef FirstIndex.make (key : α → Nat) (rows : List α) : FirstIndex key rows :=\\n  ⟨firstTable key rows, firstTable_exact key rows⟩\\n\\nvariable {key : α → Nat} {rows : List α}\\n\\ndef FirstIndex.read (index : FirstIndex key rows) (query : Nat) : Option α :=\\n  index.table[query]?\\n\\ntheorem FirstIndex.read_exact (index : FirstIndex key rows) (query : Nat) :\\n    index.read query = rows.find? (fun row => key row == query) := index.exact query\\n\\nend Eggshell\\n\",[]]"],["tools.FocusWindows","[\"module\\n\\npublic import Eggshell.Sha256\\n\\n@[expose] public section\\nnamespace Eggshell.Plugin\\n\\n/-- The original saved window slot stays unchanged. Only its Work prefix\\nis removed from the numerical evidence view, using character coordinates. -/\\ndef evidenceWindowStart (workChars index : Nat) : Nat :=\\n  workChars + 1 - index * 384\\n\\ndef evidenceWindowText (workChars index : Nat) (window : String) : String :=\\n  (window.drop (evidenceWindowStart workChars index)).copy\\n\\n/-- Warm readiness includes the actual view implementation, not a manually\\nnumbered format. Cache entries themselves remain keyed by their actual text. -/\\ndef focusWindowContract : String :=\\n  Sha256.hex (include_str \\\"FocusWindows.lean\\\").toUTF8\\n\\nend Eggshell.Plugin\\n\",[[\"FocusWindows.lean\",\"module\\n\\npublic import Eggshell.Sha256\\n\\n@[expose] public section\\nnamespace Eggshell.Plugin\\n\\n/-- The original saved window slot stays unchanged. Only its Work prefix\\nis removed from the numerical evidence view, using character coordinates. -/\\ndef evidenceWindowStart (workChars index : Nat) : Nat :=\\n  workChars + 1 - index * 384\\n\\ndef evidenceWindowText (workChars index : Nat) (window : String) : String :=\\n  (window.drop (evidenceWindowStart workChars index)).copy\\n\\n/-- Warm readiness includes the actual view implementation, not a manually\\nnumbered format. Cache entries themselves remain keyed by their actual text. -/\\ndef focusWindowContract : String :=\\n  Sha256.hex (include_str \\\"FocusWindows.lean\\\").toUTF8\\n\\nend Eggshell.Plugin\\n\"]]]"],["tools.IdentifierParts","[\"module\\n\\npublic import Eggshell.SearchUnicode\\npublic import tools.RetrievalCategories\\n\\n@[expose] public section\\n\\nnamespace Eggshell.IdentifierParts\\n\\ndef lower (c : Char) : Bool := 'a' ≤ c && c ≤ 'z'\\ndef upper (c : Char) : Bool := 'A' ≤ c && c ≤ 'Z'\\ndef digit (c : Char) : Bool := '0' ≤ c && c ≤ '9'\\n\\n/-- Keep acronym tails with the following word: HTTPServer -> HTTP, Server.\\nOnly ASCII case supplies a case boundary; Unicode words remain intact. -/\\ndef boundary (previous current : Char) (next : Option Char) : Bool :=\\n  (lower previous && upper current) ||\\n  (upper previous && upper current && next.any lower) ||\\n  (digit previous && (lower current || upper current)) ||\\n  ((lower previous || upper previous) && digit current)\\n\\ndef normalized (characters : Array Char) : String :=\\n  String.ofList (characters.toList.flatMap fun c => (SearchUnicode.fold c).toList)\\n\\n/-- Additional retrieval hints from original identifier/path components.\\nThe caller supplies its existing script boundary, so this introduces neither\\na dictionary nor a second CJK policy. Whole original terms remain separate.\\nThese hints have no role in Work identity, equivalence or completion. -/\\ndef parts (script : Char → Bool) (text : String) : List String := Id.run do\\n  let characters := (RetrievalResearch.Unicode.widthFold text).toList.toArray\\n  let mut result : Array String := #[]\\n  let mut current : Array Char := #[]\\n  for index in [:characters.size] do\\n    let c := characters[index]!\\n    let word := !script c && (RetrievalResearch.Unicode.letterNumber c ||\\n      (!current.isEmpty && RetrievalResearch.Unicode.mark c))\\n    if word then\\n      if let some previous := current.back? then\\n        if boundary previous c characters[index + 1]? then\\n          result := result.push (normalized current)\\n          current := #[]\\n      current := current.push c\\n    else if !current.isEmpty then\\n      result := result.push (normalized current)\\n      current := #[]\\n  if !current.isEmpty then result := result.push (normalized current)\\n  return result.toList\\n\\nend Eggshell.IdentifierParts\\n\",[]]"],["tools.IndexedCharacters","[\"module\\n\\npublic import Std\\n\\n@[expose] public section\\nnamespace Eggshell\\n\\n/-- An immutable character array bound to the exact original String. Substring\\nreads traverse only the selected characters, preserving character coordinates. -/\\nstructure IndexedCharacters (source : String) where\\n  chars : Array Char\\n  exact : chars = source.toList.toArray\\n\\n@[noinline] def IndexedCharacters.make (source : String) : IndexedCharacters source :=\\n  ⟨source.toList.toArray, rfl⟩\\n\\ntheorem IndexedCharacters.is_canonical (indexed : IndexedCharacters source) :\\n    indexed = make source := by\\n  cases indexed with\\n  | mk chars exact => subst chars; rfl\\n\\ndef IndexedCharacters.slice (indexed : IndexedCharacters source) (first count : Nat) : String :=\\n  String.ofList (indexed.chars.extract first (first + count)).toList\\n\\ntheorem IndexedCharacters.slice_exact (indexed : IndexedCharacters source) (first count : Nat) :\\n    indexed.slice first count = ((source.drop first).take count).copy := by\\n  apply String.ext\\n  simp [slice, indexed.exact]\\n\\n/-- A decision over indexed slices certifies the exact original String slices.\\nThe equality transport erases; only bounded slice work remains at runtime. -/\\ndef IndexedCharacters.decide₂ (left : IndexedCharacters a) (first count : Nat)\\n    (right : IndexedCharacters b) (otherFirst otherCount : Nat)\\n    (predicate : String → String → Prop) [DecidableRel predicate] :\\n    Decidable (predicate ((a.drop first).take count).copy ((b.drop otherFirst).take otherCount).copy) :=\\n  decidable_of_iff (predicate (left.slice first count) (right.slice otherFirst otherCount))\\n    (by rw [slice_exact, slice_exact])\\n\\ntheorem IndexedCharacters.decide₂_eq (left : IndexedCharacters a) (first count : Nat)\\n    (right : IndexedCharacters b) (otherFirst otherCount : Nat)\\n    (predicate : String → String → Prop) [DecidableRel predicate] :\\n    left.decide₂ first count right otherFirst otherCount predicate =\\n      (inferInstance : Decidable (predicate ((a.drop first).take count).copy\\n        ((b.drop otherFirst).take otherCount).copy)) := Subsingleton.elim _ _\\n\\ndef IndexedCharacters.branch₂ (left : IndexedCharacters a) (first count : Nat)\\n    (right : IndexedCharacters b) (otherFirst otherCount : Nat)\\n    (predicate : String → String → Prop) [DecidableRel predicate]\\n    (yes : predicate ((a.drop first).take count).copy ((b.drop otherFirst).take otherCount).copy → γ)\\n    (no : ¬predicate ((a.drop first).take count).copy ((b.drop otherFirst).take otherCount).copy → γ) : γ :=\\n  @dite γ _ (left.decide₂ first count right otherFirst otherCount predicate) yes no\\n\\ntheorem IndexedCharacters.branch₂_exact (left : IndexedCharacters a) (first count : Nat)\\n    (right : IndexedCharacters b) (otherFirst otherCount : Nat)\\n    (predicate : String → String → Prop) [DecidableRel predicate]\\n    (yes : predicate ((a.drop first).take count).copy ((b.drop otherFirst).take otherCount).copy → γ)\\n    (no : ¬predicate ((a.drop first).take count).copy ((b.drop otherFirst).take otherCount).copy → γ) :\\n    left.branch₂ first count right otherFirst otherCount predicate yes no =\\n      if h : predicate ((a.drop first).take count).copy ((b.drop otherFirst).take otherCount).copy then\\n        yes h else no h := by\\n  unfold branch₂\\n  rw [decide₂_eq]\\n\\nend Eggshell\\n\",[]]"],["tools.KeyPostings","[\"module\\npublic import Std.Data.HashMap.Lemmas\\n@[expose] public section\\nnamespace Eggshell.KeyPostings\\nvariable {κ α : Type} [BEq κ] [Hashable κ] [LawfulBEq κ]\\n\\n/-- A directory retains the exact input sequence for each full key.\\nHash collisions cannot merge keys or discard duplicate values. -/\\ndef directory (keyOf : α → κ) (values : Array α) : Std.HashMap κ (Array α) :=\\n  values.foldl (fun found value => found.insert (keyOf value)\\n    ((found[keyOf value]?.getD #[]).push value
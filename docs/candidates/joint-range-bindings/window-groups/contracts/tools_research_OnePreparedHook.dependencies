ef blockKey (digest : String) := \\\"observed-view:block:\\\" ++ digest\\ndef blockRef (owner : String) (index : Nat) := \\\"observed-view:ref:\\\" ++ owner ++ \\\":\\\" ++ toString index\\ndef blockChars := ObservedRecords.chunkChars\\n\\ndef make (database : String) (document : Document) : Except String View := do\\n  unless document.native && !document.occurrences.isEmpty do throw \\\"missing original observation authority\\\"\\n  let some raw := document.source | throw \\\"missing original observation body\\\"\\n  let prepared ← ObservedRecords.prepare raw\\n  let characters := raw.toList.toArray\\n  let spans := prepared.records.filterMap fun record =>\\n    if record.spellings.isEmpty || record.limit-record.first > blockChars then none else\\n    some (⟨record.first,record.limit,\\n      record.spellings.any fun spelling => spelling.first == record.first &&\\n        spelling.limit == record.limit &&\\n        (spelling.projection == .stringBody || spelling.projection == .stringBodyLine)⟩ : Span)\\n  let blocks := (ObservedRecords.base characters.size).map fun record =>\\n    String.ofList (characters.extract record.first record.limit).toList\\n  return ⟨⟨database,document.owner,document.work,ObservationContext.originalSubject document.work raw,\\n    document.occurrences,characters.size,blocks.size⟩,spans,blocks⟩\\n\\n/-- The payload is copied exactly once into bounded content-addressed blocks.\\nThe source publication, original digest and observation identities stay in\\nthe directory, independently of payload sharing. -/\\ndef stage (writer : PageMap.Writer) (database : String) (document : Document) : IO Unit := do\\n  let view ← IO.ofExcept (make database document)\\n  for index in [:view.blocks.size] do\\n    let block : Block := ⟨view.blocks[index]!,view.spans.filter fun span =>\\n      span.first < (index+1)*blockChars && index*blockChars < span.limit⟩\\n    let bytes := (toJson block).compress.toUTF8\\n    unless bytes.size ≤ 60000 do throw (IO.userError \\\"original view block exceeds page bound\\\")\\n    let digest := Sha256.hex bytes\\n    if let some previous ← writer.get (blockKey digest) then\\n      unless previous == bytes do throw (IO.userError \\\"conflicting original view block\\\")\\n    else writer.put (blockKey digest) (some bytes)\\n    writer.put (blockRef document.owner index) (some digest.toUTF8)\\n  let bytes := (toJson view.header).compress.toUTF8\\n  unless bytes.size ≤ 16384 do throw (IO.userError \\\"original view directory exceeds its byte bound\\\")\\n  writer.put (ownerKey document.owner) (some bytes)\\n\\ndef load? (index : PageMap.Snapshot) (database owner : String) : IO (Option View) := do\\n  let some bytes ← index.get (ownerKey owner) | return none\\n  unless bytes.size ≤ 16384 do throw (IO.userError \\\"oversized original view directory\\\")\\n  let header ← ObservedRecords.decode (α := Header) bytes\\n  unless header.database == database && header.owner == owner &&\\n      header.occurrences.all Occurrence.valid && !header.occurrences.isEmpty &&\\n      header.blocks == (header.characters+blockChars-1)/blockChars do\\n    throw (IO.userError \\\"foreign or invalid original view directory\\\")\\n  let mut blocks := #[]\\n  let mut spans := #[]\\n  for position in [:header.blocks] do\\n    let some pointer ← index.get (blockRef owner position) | throw (IO.userError \\\"missing original block pointer\\\")\\n    let some digest := String.fromUTF8? pointer | throw (IO.userError \\\"invalid original block pointer\\\")\\n    let some bytes ← index.get (blockKey digest) | throw (IO.userError \\\"missing original view block\\\")\\n    unless bytes.size ≤ 60000 && Sha256.hex bytes == digest do\\n      throw (IO.userError \\\"invalid original view block digest\\\")\\n    let block ← ObservedRecords.decode (α := Block) bytes\\n    let text := block.text\\n    unless text.length == min blockChars (header.characters-position*blockChars) do\\n      throw (IO.userError \\\"invalid original view character extent\\\")\\n    unless block.spans.all (fun span => span.first < span.limit && span.limit ≤ header.characters &&\\n        span.limit-span.first ≤ blockChars && span.first < (position+1)*blockChars && position*blockChars < span.limit) do\\n      throw (IO.userError \\\"invalid original view record interval\\\")\\n    spans := spans ++ block.spans\\n    blocks := blocks.push text\\n  return some ⟨header,(hashDistinct spans.toList).toArray,blocks⟩\\n\\n/-- A point extraction reads only intersecting blocks; it never walks the\\nprefix of the owner's body or repeats JSON parsing/record normalization. -/\\ndef View.slice (view : View) (first limit : Nat) : Option String := do\\n  unless first < limit && limit ≤ view.header.characters do none\\n  let start := first/blockChars\\n  let stop := (limit-1)/blockChars+1\\n  let mut parts := []\\n  for index in [start:stop] do\\n    let block ← view.blocks[index]?\\n    let a := first-index*blockChars\\n    let b := min blockChars (limit-index*blockChars)\\n    parts := String.ofList (block.toList.drop a |>.take (b-a)) :: parts\\n  return \\\"\\\".intercalate parts.reverse\\n\\nstructure Piece where\\n  span : Span\\n  original : String\\n  deriving BEq, ToJson, FromJson\\n\\n/-- Only intersecting prepared records are offered. The base partition is\\nalways available for bytes outside a structural record; no input shape can\\nmake an original region disappear. The caller retains query priorities. -/\\ndef View.pieces (view : View) (first limit : Nat) : Array Piece := Id.run do\\n  if first ≥ limit || limit > view.header.characters then return #[]\\n  let spans := (view.spans.filter fun span => span.first < limit && first < span.limit).qsort fun a b => a.first < b.first\\n  let mut cursor := first\\n  let mut all := spans\\n  for span in spans do\\n    if cursor < span.first then\\n      for record in ObservedRecords.base view.header.characters do\\n        let a := max cursor record.first\\n        let b := min span.
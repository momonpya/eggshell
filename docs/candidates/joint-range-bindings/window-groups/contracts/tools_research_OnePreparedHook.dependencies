ilterMap (fun value => if keyOf value == key then some value else none)).toList.reverse := by\\n    intro reversed\\n    induction reversed with\\n    | nil => simp [reversedDirectory]\\n    | cons value previous ih =>\\n      have step : (value :: previous).reverse.toArray = previous.reverse.toArray.push value := by simp\\n      rw [step]\\n      simp only [reversedDirectory,Array.foldl_push,Std.HashMap.getElem?_insert]\\n      by_cases same : keyOf value = key\\n      · simpa [same,reversedDirectory,Array.filterMap_push] using congrArg (List.cons value) ih\\n      · simpa [same,reversedDirectory,Array.filterMap_push] using ih\\n  simpa using go values.toList.reverse\\n\\ndef compactDirectory (keyOf : α → κ) (values : Array α) : Std.HashMap κ (Array α) :=\\n  (reversedDirectory keyOf values).map (fun _ rows => rows.reverse.toArray)\\n\\ntheorem compactDirectory_exact (keyOf : α → κ) (values : Array α) (key : κ) :\\n    (compactDirectory keyOf values)[key]?.getD #[] = values.filterMap\\n      (fun value => if keyOf value == key then some value else none) := by\\n  have exact := reversedDirectory_exact keyOf values key\\n  unfold compactDirectory\\n  simp only [Std.HashMap.getElem?_map]\\n  cases found : (reversedDirectory keyOf values)[key]? with\\n  | none => simpa [found] using congrArg (fun rows => rows.reverse.toArray) exact\\n  | some rows =>\\n    simp only [found,Option.getD_some] at exact\\n    simp only [Option.map_some,Option.getD_some]\\n    rw [exact,List.reverse_reverse,Array.toArray_toList]\\n\\ndef prepare (keyOf : α → κ) (values : Array α) : Index keyOf values :=\\n  ⟨compactDirectory keyOf values,compactDirectory_exact keyOf values⟩\\n\\nvariable {keyOf : α → κ} {values : Array α}\\n\\ndef Index.lookup (index : Index keyOf values) (key : κ) : Array α :=\\n  index.postings[key]?.getD #[]\\n\\nomit [LawfulBEq κ] in\\ntheorem Index.lookup_exact (index : Index keyOf values) (key : κ) :\\n    index.lookup key = values.filterMap (fun value => if keyOf value == key then some value else none) :=\\n  index.exact key\\n\\nend Eggshell.KeyPostings\\n\",[]]"],["tools.KeyedOverride","[\"module\\n\\npublic import Eggshell.HashDistinct\\npublic import Std.Data.HashSet.Lemmas\\n\\n@[expose] public section\\nnamespace Eggshell.KeyedOverride\\n\\nvariable {α β : Type} [BEq β] [LawfulBEq β] [Hashable β]\\n\\ndef put (key : α → β) (previous : List α) (item : α) : List α :=\\n  item :: previous.filter (fun old => !(key item == key old))\\n\\ndef reference (key : α → β) (previous added : List α) : List α :=\\n  added.foldl (put key) previous\\n\\n/-- Right-to-left specification: new keys keep their latest complete payload;\\nuntouched prior entries, including duplicates, remain in their original order. -/\\ndef collect (key : α → β) (seen : Std.HashSet β) (items previous : List α) : List α :=\\n  match items with\\n  | [] => previous.filter (fun item => !seen.contains (key item))\\n  | item :: rest =>\\n      if seen.contains (key item) then collect key seen rest previous\\n      else item :: collect key (seen.insert (key item)) rest previous\\n\\nprivate theorem insert_filter (key : α → β) (seen : Std.HashSet β) (value : β)\\n    (rows : List α) :\\n    rows.filter (fun item => !(seen.insert value).contains (key item)) =\\n      (rows.filter (fun item => !(value == key item))).filter\\n        (fun item => !seen.contains (key item)) := by\\n  rw [List.filter_filter]\\n  apply List.filter_congr\\n  intro item _\\n  simp [Std.HashSet.contains_insert, Bool.not_or, Bool.and_comm]\\n\\nprivate theorem seen_filter (key : α → β) (seen : Std.HashSet β) (value : β)\\n    (present : seen.contains value = true) (rows : List α) :\\n    (rows.filter (fun item => !(value == key item))).filter\\n        (fun item => !seen.contains (key item)) =\\n      rows.filter (fun item => !seen.contains (key item)) := by\\n  rw [List.filter_filter]\\n  apply List.filter_congr\\n  intro item _\\n  by_cases same : value = key item\\n  · have present : seen.contains (key item) = true := same ▸ present\\n    simp [present]\\n  · simp [beq_eq_false_iff_ne.mpr same]\\n\\nprivate theorem filter_put (key : α → β) (seen : Std.HashSet β)\\n    (rows : List α) (item : α) :\\n    (put key rows item).filter (fun old => !seen.contains (key old)) =\\n      if seen.contains (key item) then rows.filter (fun old => !seen.contains (key old))\\n      else item :: rows.filter (fun old => !(seen.insert (key item)).contains (key old)) := by\\n  unfold put\\n  rw [List.filter_cons]\\n  cases present : seen.contains (key item) with\\n  | false =>\\n      simp only [Bool.not_false, Bool.false_eq_true, ↓reduceIte]\\n      exact congrArg (List.cons item) (insert_filter key seen (key item) rows).symm\\n  | true => simp [seen_filter key seen (key item) present rows]\\n\\ntheorem collect_exact (key : α → β) (seen : Std.HashSet β) (items previous : List α) :\\n    collect key seen items previous =\\n      (items.foldr (fun item rows => put key rows item) previous).filter\\n        (fun item => !seen.contains (key item)) := by\\n  induction items generalizing seen with\\n  | nil => rfl\\n  | cons item rest ih =>\\n      rw [List.foldr_cons, filter_put]\\n      unfold collect\\n      cases present : seen.contains (key item) <;> simp [ih]\\n\\nprivate theorem collect_insert_seen (key : α → β) (seen : Std.HashSet β) (value : β)\\n    (present : seen.contains value = true) (items previous : List α) :\\n    collect key (seen.insert value) items previous = collect key seen items previous := by\\n  rw [collect_exact, collect_exact, insert_filter, seen_filter key seen value present]\\n\\n/-- Tail-recursive implementation. The set is only an exact membership index;\\nthe retained list carries every chosen original payload and its final order. -/\\ndef loop (key : α → β) (seen : Std.HashSet β) (items kept : List α) :\\n    Std.HashSet β × List α :=\\n  match items with\\n  | [] => (seen, kept)\\n  | item :: rest =>\\n      let checked := seen.containsThenInsert (key item)\\n      if checked.1 then loop key checked.2 rest kept\\n      else loop key checked.2 rest (item :: kept)\\n\\ntheorem loop_exact (key : α → β) (seen : Std.HashSet β) (items kept previous : List α) :\\n    let result := loop key seen items kept\\n    result.2.reverse ++ previous.filter (fun item => !result.1.contains (key item)) =\\n      kept.reverse ++ collect key seen items previous := by\\n  induction items generalizing seen kept with\\n  | nil => rfl\\n  | cons item rest ih =>\\n      simp only [loop, collect, Std.HashSet.containsThenInsert_fst, Std.HashSet.containsThenInsert_snd]\\n      cases present : seen.contains (key item) with\\n      | true =>\\n          simp only [↓reduceIte]\\n          rw [ih, collect_insert_seen key seen (key item) present]\\n      | false =>\\n          simp only [Bool.false_eq_true, ↓reduceIte]\\n          rw [ih]\\n          simp [List.reverse_cons, List.append_assoc]\\n\\ndef merge (key : α → β) (previous added : List α) : List α :=\\n  let result := loop key {} added.reverse []\\n  result.2.reverse ++ previous.filter (fun item => !result.1.contains (key item))\\n\\ntheorem merge_exact (key : α → β) (previous added : List α) :\\n    merge key previous added = reference key previous added := by\\n  unfold merge\\n  rw [loop_exact, collect_exact]\\n  simp [reference]\\n\\nend Eggshell.KeyedOverride\\n\",[]]"],["tools.LinearOutput","[\"module\\npublic import Std\\n@[expose] public section\\n\\nnamespace Eggshell.LinearOutput\\n\\nvariable {α β σ τ : Type}\\n\\n/-- A reference stateful output log; the tail append is intentionally explicit. -/\\ndef append (step : σ → α → Option (σ × β)) : List α → σ → List β → Option (σ × List β)\\n  | [],state,rows => some (state,rows)\\n  | value :: rest,state,rows => do\\n    let (next,row) ← step state value\\n    append step rest next (rows ++ [row])\\n\\ndef prepend (step : σ → α → Option (σ × β)) : List α → σ → List β → Option (σ × List β)\\n  | [],state,rows => some (state,rows)\\n  | value :: rest,state,rows => do\\n    let (next,row) ← step state value\\n    prepend step rest next (row :: rows)\\n\\ntheorem reversed_log (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    append step values state rows.reverse =\\n      (prepend step values state rows).map (fun result => (result.1,result.2.reverse)) := by\\n  induction values generalizing state rows with\\n  | nil => rfl\\n  | cons value rest ih =>\\n    cases outcome : step state value with\\n    | none => simp [append,prepend,outcome]\\n    | some result =>\\n      rcases result with ⟨next,row⟩\\n      simpa [append,prepend,outcome,List.reverse_cons] using ih next (row :: rows)\\n\\ndef prepared (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    Option (σ × List β) :=\\n  (prepend step values state rows.reverse).map (fun result => (result.1,result.2.reverse))\\n\\ntheorem append_prepared (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    append step values state rows = prepared step values state rows := by\\n  simpa only [prepared,List.reverse_reverse] using reversed_log step values state rows.reverse\\n\\ndef loop (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    Option (σ × List β) := do\\n  let mut state := state\\n  let mut rows := rows\\n  for value in values do\\n    let (next,row) ← step state value\\n    state := next\\n    rows := rows ++ [row]\\n  return (state,rows)\\n\\ntheorem loop_cons (step : σ → α → Option (σ × β)) (value : α) (rest : List α) (state : σ) (rows : List β) :\\n    loop step (value :: rest) state rows = (do\\n      let (next,row) ← step state value\\n      loop step rest next (rows ++ [row])) := by\\n  cases outcome : step state value with\\n  | none => simp [loop,outcome]\\n  | some result =>\\n    rcases result with ⟨next,row⟩\\n    simp [loop,outcome]\\n\\ntheorem append_loop (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    append step values state rows = loop step values state rows := by\\n  induction values generalizing state rows with\\n  | nil => rfl\\n  | cons value rest ih =>\\n    rw [append,loop_cons]\\n    cases step state value <;> simp [ih]\\n\\n@[csimp] theorem loop_compiled : @loop = @prepared := by\\n  funext α β σ step values state rows\\n  rw [← append_loop,append_prepared]\\n\\n/-- A pair of mutable preparation fields keeps the original loop's state\\nlayout. Its output log still has the single shared linear implementation. -/\\ndef pairLoop (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)\\n    (left : σ) (right : τ) (rows : List β) : Option (σ × τ × List β) := do\\n  let mut left := left\\n  let mut right := right\\n  let mut rows := rows\\n  for value in values do\\n    let (next,row) ← step (left,right) value\\n    left := next.1\\n    right := next.2\\n    rows := rows ++ [row]\\n  return (left,right,rows)\\n\\ntheorem pairLoop_cons (step : (σ × τ) → α → Option ((σ × τ) × β)) (value : α) (rest : List α)\\n    (left : σ) (right : τ) (rows : List β) :\\n    pairLoop step (value :: rest) left right rows = (do\\n      let (next,row) ← step (left,right) value\\n      pairLoop step rest next.1 next.2 (rows ++ [row])) := by\\n  cases outcome : step (left,right) value with\\n  | none => simp [pairLoop,outcome]\\n  | some result =>\\n    rcases result with ⟨⟨nextLeft,nextRight⟩,row⟩\\n    simp [pairLoop,outcome]\\n\\ntheorem pair_loop_agrees (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)\\n    (left : σ) (right : τ) (rows : List β) :\\n    pairLoop step values left right rows =\\n      (loop step values (left,right) rows).map (fun result => (result.1.1,result.1.2,result.2)) := by\\n  induction values generalizing left right rows with\\n  | nil => rfl\\n  | cons value rest ih =>\\n    rw [pairLoop_cons,loop_cons]\\n    cases outcome : step (left,right) value with\\n    | none => simp\\n    | some result =>\\n      rcases result with ⟨⟨nextLeft,nextRight⟩,row⟩\\n      simpa [outcome] using ih nextLeft nextRight (rows ++ [row])\\n\\ndef pairPrepared (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)\\n    (left : σ) (right : τ) (rows : List β) : Option (σ × τ × List β) :=\\n  (prepared step values (left,right) rows).map (fun result => (result.1.1,result.1.2,result.2))\\n\\n@[csimp] theorem pair_loop_compiled : @pairLoop = @pairPrepared := by\\n  funext α β σ τ step values left right rows\\n  rw [pair_loop_agrees,loop_compiled]\\n  rfl\\n\\nend Eggshell.LinearOutput\\n\",[]]"],["tools.LiteralSearch","[\"module\\npublic import Std.Data.HashMap\\n@[expose] public section\\n\\n/- Multi-pattern literal search. This module knows no tools, files, Work,\\nfreshness, Union or model. Every reported occurrence is checked against both\\nthe requested pattern and actual bounded source characters. -/\\nnamespace LiteralSearch\\n\\nstructure Node where\\n  next : Std.HashMap Char Nat := {}\\n  failure : Nat := 0\\n  terminal : Array Nat := #[]\\n  exit : Option Nat := none\\n  deriving Inhabited\\n\\nstructure Index (patterns : Array String) where\\n  nodes : Array Node\\n\\ndef advance (nodes : Array Node) (start : Nat) (character : Char) : Nat := Id.run do\\n  let mut state := start\\n  for _ in [:nodes.size+1] do\\n    let some node := nodes[state]? | return 0\\n    if let some target := node.next[character]? then return target\\n    if state == 0 then return 0\\n    state := node.failure\\n  return 0\\n\\n/-- Aho-Corasick failure/exit links share all prefixes and avoid copying the\\noutputs of suffix states. Source data is scanned once for all requested\\npatterns; repeated and overlapping occurrences remain distinct. -/\\ndef prepare (patterns : Array String) : Index patterns := Id.run do\\n  let mut nodes : Array Node := #[{}]\\n  for pattern in [:patterns.size] do\\n    let characters := patterns[pattern]!.toList\\n    if characters.isEmpty then continue\\n    let mut state := 0\\n    for character in characters do\\n      match nodes[state]!.next[character]? with\\n      | some target => state := target\\n      | none =>\\n        let target := nodes.size\\n        nodes := nodes.modify state fun node => {node with next := node.next.insert character target}\\n        nodes := nodes.push {}\\n        state := target\\n    nodes := nodes.modify state fun node => {node with terminal := node.terminal.push pattern}\\n  let mut queue := nodes[0]!.next.toArray.map (·.2)\\n  let mut position := 0\\n  while position < queue.size do\\n    let parent := queue[position]!\\n    position := position+1\\n    for (character,child) in nodes[parent]!.next do\\n      let failure := advance nodes nodes[parent]!.failure character\\n      let exit := if nodes[failure]!.terminal.isEmpty then nodes[failure]!.exit else some failure\\n      nodes := nodes.modify child fun node => {node with failure,exit}\\n      queue := queue.push child\\n  return ⟨nodes⟩\\n\\nstructure Hit (patterns : Array String) (original : String) where\\n  pattern : Fin patterns.size\\n  first : Nat\\n  limit : Nat\\n  within : first < limit ∧ limit ≤ original.length\\n  exact : patterns[pattern] = String.ofList (original.toList.toArray.extract first limit).toList\\n\\ntheorem hit_is_requested_original (hit : Hit patterns original) :\\n    hit.first < hit.limit ∧ hit.limit ≤ original.length ∧\\n      patterns[hit.pattern] = String.ofList (original.toList.toArray.extract hit.first hit.limit).toList :=\\n  ⟨hit.within.1,hit.within.2,hit.exact⟩\\n\\ndef collect (firstOnly : Bool) (index : Index patterns) (original : String) :\\n    Array (Hit patterns original) := Id.run do\\n  let characters := original.toList.toArray\\n  let lengths := patterns.map String.length\\n  let mut result := #[]\\n  let mut seen : Std.HashMap Nat Unit := {}\\n  let mut state := 0\\n  for position in [:characters.size] do\\n    state := advance index.nodes state characters[position]!\\n    let mut output := some state\\n    for _ in [:index.nodes.size+1] do\\n      let some nodeIndex := output | break\\n      let some node := index.nodes[nodeIndex]? | break\\n      for pattern in node.terminal do\\n        if firstOnly && seen.contains pattern then continue\\n        if present : pattern < patterns.size then\\n          let limit := position+1\\n          let first := limit-lengths[pattern]!\\n          if within : first < limit ∧ limit ≤ original.length then\\n            if exact : patterns[pattern] = String.ofList (characters.extract first limit).toList then\\n              result := result.push ⟨⟨pattern,present⟩,first,limit,within,exact⟩\\n              if firstOnly then seen := seen.insert pattern ()\\n      output := node.exit\\n  return result\\n\\n/-- Full occurrences for independent diagnostic comparison. -/\\ndef find (index : Index patterns) (original : String) : Array (Hit patterns original) :=\\n  collect false index original\\n\\n/-- Advisory attachment needs presence in each original record, not an array\\nof every repeated character occurrence. Retain one checked witness per\\nrequested pattern, while scanning the same failure/exit automaton. -/\\ndef first (index : Index patterns) (original : String) : Array (Hit patterns original) :=\\n  collect true index original\\n\\nend LiteralSearch\\n\",[]]"],["tools.OwnedRows","[\"module\\npublic import tools.FirstIndex\\n\\n@[expose] public section\\nnamespace Eggshell\\n\\nuniverse u\\nvariable {α : Type u}\\n\\n/-- One prepared positional directory, tied to the complete original list. -/\\nstructure OwnedRows (rows : List α) where\\n  values : Array α\\n  lookup : ∀ index : Nat, values[index]? = rows[index]?\\n\\ndef OwnedRows.make (rows : List α) : OwnedRows rows :=\\n  ⟨rows.toArray, fun _ => List.getElem?_toArray⟩\\n\\ndef OwnedRows.reference (rows : List α) (index : Nat) : Option {row // row ∈ rows} :=\\n  match present : rows[index]? with\\n  | none => none\\n  | some row => some ⟨row, List.mem_of_getElem? present⟩\\n\\ntheorem OwnedRows.reference_value (rows : List α) (index : Nat) :\\n    (OwnedRows.reference rows index).map Subtype.val = rows[index]? := by\\n  unfold OwnedRows.reference\\n  split\\n  · rename_i missing\\n    exact missing.symm\\n  · rename_i row present\\n    change some row = rows[index]?\\n    exact present.symm\\n\\nvariable {rows : List α}\\n\\ndef OwnedRows.get (directory : OwnedRows rows) (index : Nat) : Option {row // row ∈ rows} :=\\n  match present : directory.values[index]? with\\n  | none => none\\n  | some row => some ⟨row, List.mem_of_getElem? ((directory.lookup index).symm.trans present)⟩\\n\\ntheorem OwnedRows.get_exact (directory : OwnedRows rows) (index : Nat) :\\n    directory.get index = OwnedRows.reference rows index := by\\n  unfold OwnedRows.get OwnedRows.reference\\n  split\\n  · rename_i missing\\n    have original := (directory.lookup index).symm.trans missing\\n    split\\n    · rfl\\n    · rename_i row present\\n      rw [original] at present\\n      contradiction\\n  · rename_i row indexed\\n    have original := (directory.lookup index).symm.trans indexed\\n    split\\n    · rename_i missing\\n      rw [original] at missing\\n      contradiction\\n    · rename_i other present\\n      have same := Option.some.inj (original.symm.trans present)\\n      cases same\\n      rfl\\n\\n/-- Preserve left-to-right effects and the first error while avoiding repeated\\ncopying of the already accepted prefix. filterMapM uses its standard tail loop. -/\\ntheorem append_fold_filterMapM (read : α → Except ε (Option β)) (items : List α)\\n    (initial : List β) :\\n    items.foldlM (fun values item => do\\n      match ← read item with\\n      | none => pure values\\n      | some value => pure (values ++ [value])) initial =\\n    (do let values ← items.filterMapM read; pure (initial ++ values)) := by\\n  induction items generalizing initial with\\n  | nil => simp\\n  | cons head tail ih =>\\n      rw [List.foldlM_cons, List.filterMapM_cons]\\n      cases effect : read head with\\n      | error message => rfl\\n      | ok value =>\\n          cases value with\\n          | none =>\\n              change tail.foldlM _ initial = _\\n              rw [ih]\\n              rfl\\n          | some value =>\\n              change tail.foldlM _ (initial ++ [value]) = _\\n              rw [ih]\\n              cases result : tail.filterMapM read with\\n              | error message => rfl\\n              | ok values =>\\n                  simp only [List.append_assoc, List.singleton_append]\\n                  rfl\\n\\nend Eggshell\\n\",[]]"],["tools.OwnerProjection","[\"module\\npublic import Eggshell.HashDistinct\\nimport all Init.System.ST\\nimport all Init.System.IO\\n\\n@[expose] public section\\nnamespace Eggshell.OwnerProjection\\n\\nvariable {α β : Type} [BEq α] [LawfulBEq α] [Hashable α]\\n  [BEq β] [LawfulBEq β] [Hashable β]\\n\\nabbrev Choice (α β : Type) := Sum α β × List Nat\\n\\nstructure Result (α β : Type) where\\n  durable : List α := []\\n  staged : List β := []\\n  durableWindows : List (α × List Nat) := []\\n  stagedWindows : List (β × List Nat) := []\\n  durableRanking : List α := []\\n  stagedRanking : List β := []\\n  presentationOrder : List (Sum α β) := []\\n  focused : List α := []\\n  deriving BEq\\n\\ndef hasKey (rows : List (α × List Nat)) (key : α) : Bool :=\\n  (rows.map Prod.fst).contains key\\n\\nomit [Hashable α] in theorem hasKey_exact (rows : List (α × List Nat)) (key : α) :\\n    hasKey rows key = rows.any (·.1 == key) := by\\n  simp only [hasKey, List.contains_map]\\n  exact List.any_congr rfl (fun _ => BEq.comm)\\n\\ndef Result.related (state : Result α β) (choice : Choice α β) : Result α β :=\\n  match choice.1 with\\n  | .inl key => {state with\\n      durable := state.durable ++ [key]\\n      durableWindows := state.durableWindows ++ [(key, choice.2)]}\\n  | .inr key => {state with\\n      staged := state.staged ++ [key]\\n      stagedWindows := state.stagedWindows ++ [(key, choice.2)]}\\n\\ndef rankWindows (rows : List (α × List Nat)) (entry : α × List Nat) : List (α × List Nat) :=\\n  if hasKey rows entry.1 || entry.2.isEmpty then rows else rows ++ [entry]\\n\\ndef Result.ranked (state : Result α β) (choice : Choice α β) : Result α β :=\\n  match choice.1 with\\n  | .inl key => {state with\\n      durableRanking := state.durableRanking ++ [key]\\n      durableWindows := rankWindows state.durableWindows (key, choice.2)\\n      presentationOrder := state.presentationOrder ++ [.inl key]}\\n  | .inr key => {state with\\n      stagedRanking := state.stagedRanking ++ [key]\\n      stagedWindows := rankWindows state.stagedWindows (key, choice.2)\\n      presentationOrder := state.presentationOrder ++ [.inr key]}\\n\\ndef reference (initial : Result α β) (related ranked : List (Choice α β)) : Result α β :=\\n  ranked.foldl Result.ranked (related.foldl Result.related initial)\\n\\n/-- The full key decides identity. Seen keys include empty related windows,\\nwhich must block a later ranked window just like the original list test. -/\\nstructure Windows (α : Type) [BEq α] [Hashable α] where\\n  rows : Array (α × List Nat)\\n  seen : Std.HashMap α Unit\\n  exact : ∀ key, seen.contains key = (rows.toList.map Prod.fst).contains key\\n\\ndef Windows.make (rows : List (α × List Nat)) : Windows α := {\\n  rows := rows.toArray\\n  seen := (rows.map Prod.fst).foldl (fun known key => known.insert key ()) {}\\n  exact := by\\n    intro key\\n    simpa using HashDistinct.fold_contains (rows.map Prod.fst) ({} : Std.HashMap α Unit) key }\\n\\ndef Windows.related (state : Windows α) (entry : α × List Nat) : Windows α := {\\n  rows := state.rows.push entry\\n  seen := state.seen.insert entry.1 ()\\n  exact := by\\n    intro key\\n    simp only [Std.HashMap.contains_insert, Array.toList_push, List.map_append,\\n      List.map_cons, List.map_nil, List.contains_append, List.contains_cons,\\n      List.contains_nil, Bool.or_false, state.exact]\\n    simp only [BEq.comm, Bool.or_comm] }\\n\\ndef Windows.ranked (state : Windows α) (entry : α × List Nat) : Windows α :=\\n  if state.seen.contains entry.1 || entry.2.isEmpty then state else state.related entry\\n\\ntheorem Windows.related_exact (state : Windows α) (entry : α × List Nat) :\\n    (state.related entry).rows.toList = state.rows.toList ++ [entry] := by\\n  simp [Windows.related]\\n\\ntheorem Windows.ranked_exact (state : Windows α) (entry : α × List Nat) :\\n    (state.ranked entry).rows.toList = rankWindows state.rows.toList entry := by\\n  have same : state.seen.contains entry.1 = hasKey state.rows.toList entry.1 := state.exact _\\n  simp only [Windows.ranked, same, rankWindows]\\n  split <;> simp_all [Windows.related]\\n\\nstructure Builder (α β : Type) [BEq α] [Hashable α] [BEq β] [Hashable β] where\\n  durable : Array α\\n  staged : Array β\\n  durableWindows : Windows α\\n  stagedWindows : Windows β\\n  durableRanking : Array α\\n  stagedRanking : Array β\\n  presentationOrder : Array (Sum α β)\\n  focused : List α\\n\\ndef Builder.view (state : Builder α β) : Result α β := {\\n  durable := state.durable.toList, staged := state.staged.toList\\n  durableWindows := state.durableWindows.rows.toList\\n  stagedWindows := state.stagedWindows.rows.toList\\n  durableRanking := state.durableRanking.toList, stagedRanking := state.stagedRanking.toList\\n  presentationOrder := state.presentationOrder.toList, focused := state.focused }\\n\\ndef Builder.make (initial : Result α β) : Builder α β := {\\n  durable := initial.durable.toArray, staged := initial.staged.toArray\\n  durableWindows := Windows.make initial.durableWindows\\n  stagedWindows := Windows.make initial.stagedWindows\\n  durableRanking := initial.durableRanking.toArray, stagedRanking := initial.stagedRanking.toArray\\n  presentationOrder := initial.presentationOrder.toArray, focused := initial.focused }\\n\\ndef Builder.related (state : Builder α β) (choice : Choice α β) : Builder α β :=\\n  match choice.1 with\\n  | .inl key => {state with\\n      durable := state.durable.push key\\n      durableWindows := state.durableWindows.related (key, choice.2)}\\n  | .inr key => {state with\\n      staged := state.staged.push key\\n      stagedWindows := state.stagedWindows.related (key, choice.2)}\\n\\ndef Builder.ranked (state : Builder α β) (choice : Choice α β) : Builder α β :=\\n  match choice.1 with\\n  | .inl key => {state with\\n      durableRanking := state.durableRanking.push key\\n      durableWindows := state.durableWindows.ranked (key, choice.2)\\n      presentationOrder := state.presentationOrder.push (.inl key)}\\n  | .inr key => {state with\\n      stagedRanking := state.stagedRanking.push key\\n      stagedWindows := state.stagedWindows.ranked (key, choice.2)\\n      presentationOrder := state.presentationOrder.push (.inr key)}\\n\\ntheorem Builder.make_exact (initial : Result α β) : (Builder.make initial).view = initial := by\\n  cases initial\\n  simp [Builder.make, Builder.view, Windows.make]\\n\\ntheorem Builder.related_exact (state : Builder α β) (choice : Choice α β) :\\n    (state.related choice).view = state.view.related choice := by\\n  rcases choice with ⟨key, indices⟩\\n  cases key <;> simp [Builder.related, Builder.view, Result.related, Windows.related]\\n\\ntheorem Builder.ranked_exact (state : Builder α β) (choice : Choice α β) :\\n    (state.ranked choice).view = state.view.ranked choice := by\\n  rcases choice with ⟨key, indices⟩\\n  cases key <;> simp [Builder.ranked, Builder.view, Result.ranked, Windows.ranked_exact]\\n\\ntheorem Builder.fold_related_exact (state : Builder α β) (input : List (Choice α β)) :\\n    (input.foldl Builder.related state).view = input.foldl Result.related state.view := by\\n  induction input generalizing state with\\n  | nil => rfl\\n  | cons head tail ih => simp only [List.foldl_cons, ih, Builder.related_exact]\\n\\ntheorem Builder.fold_ranked_exact (state : Builder α β) (input : List (Choice α β)) :\\n    (input.foldl Builder.ranked state).view = input.foldl Result.ranked state.view := by\\n  induction input generalizing state with\\n  | nil => rfl\\n  | cons head tail ih => simp only [List.foldl_cons, ih, Builder.ranked_exact]\\n\\n/-- One array append per row and one full-key lookup per ranked window.\\nLists are materialized once, after both folds, with their original order. -/\\ndef project (initial : Result α β) (related ranked : List (Choice α β)) : Result α β :=\\n  (ranked.foldl Builder.ranked (related.foldl Builder.related (Builder.make initial))).view\\n\\ntheorem project_exact (initial : Result α β) (related ranked : List (Choice α β)) :\\n    project initial related ranked = reference initial related ranked := by\\n  simp only [project, reference, Builder.fold_ranked_exact, Builder.fold_related_exact,\\n    Builder.make_exact]\\n\\n/-- A resolver may fail or observe arbitrary state. Refinement preserves the\\nsame left-to-right effects, including the first failure; it is not IO caching. -/\\ntheorem foldlM_view {m : Type → Type} [Monad m] [LawfulMonad m]\\n    {σ τ ρ : Type} (view : σ → τ) (fast : σ → ρ → m σ) (slow : τ → ρ → m τ)\\n    (same : ∀ state row, view <$> fast state row = slow (view state) row)\\n    (rows : List ρ) (initial : σ) :\\n    view <$> rows.foldlM fast initial = rows.foldlM slow (view initial) := by\\n  induction rows generalizing initial with\\n  | nil => simp\\n  | cons head tail ih =>\\n      simp only [List.foldlM_cons, map_bind, ih]\\n      rw [← same initial head]\\n      simp only [bind_map_left]\\n\\ndef referenceM {m : Type → Type} [Monad m] {γ δ : Type}\\n    (initial : Result α β) (related : List γ) (ranked : List δ)\\n    (resolveRelated : γ → m (Choice α β)) (resolveRanked : δ → m (Choice α β)) : m (Result α β) := do\\n  let found ← related.foldlM (fun state row => state.related <$> resolveRelated row) initial\\n  ranked.foldlM (fun state row => state.ranked <$> resolveRanked row) found\\n\\n/-- The original imperative traversal, before compiling the accumulator. -/\\ndef legacyM {m : Type → Type} [Monad m] {γ δ : Type}\\n    (initial : Result α β) (related : List γ) (ranked : List δ)\\n    (resolveRelated : γ → m (Choice α β)) (resolveRanked : δ → m (Choice α β)) : m (Result α β) := do\\n  let mut found := initial\\n  for row in related do\\n    found := found.related (← resolveRelated row)\\n  for row in ranked do\\n    found := found.ranked (← resolveRanked row)\\n  pure found\\n\\nomit [LawfulBEq α] [Hashable α] [LawfulBEq β] [Hashable β] in\\ntheorem legacyM_exact {m : Type → Type} [Monad m] [LawfulMonad m] {γ δ : Type}\\n    (initial : Result α β) (related : List γ) (ranked : List δ)\\n    (resolveRelated : γ → m (Choice α β)) (resolveRanked : δ → m (Choice α β)) :\\n    legacyM initial related ranked resolveRelated resolveRanked =\\n      referenceM initial related ranked resolveRelated resolveRanked := by\\n  simp only [legacyM, referenceM, ← map_eq_pure_bind, List.forIn_yield_eq_foldlM, bind_pure]\\n\\ndef projectM {m : Type → Type} [Monad m] {γ δ : Type}\\n    (initial : Result α β) (related : List γ) (ranked : List δ)\\n    (resolveRelated : γ → m (Choice α β)) (resolveRanked : δ → m (Choice α β)) : m (Result α β) := do\\n  let found ← related.foldlM (fun state row => state.related <$> resolveRelated row) (Builder.make initial)\\n  let found ← ranked.foldlM (fun state row => state.ranked <$> resolveRanked row) found\\n  pure found.view\\n\\ntheorem projectM_exact {m : Type → Type} [Monad m] [LawfulMonad m] {γ δ : Type}\\n    (initial : Result α β) (related : List γ) (ranked : List δ)\\n    (resolveRelated : γ → m (Choice α β)) (resolveRanked : δ → m (Choice α β)) :\\n    projectM initial related ranked resolveRelated resolveRanked =\\n      referenceM initial related ranked resolveRelated resolveRanked := by\\n  have relatedSame := foldlM_view Builder.view\\n    (fun state row => state.related <$> resolveRelated row)\\n    (fun state row => state.related <$> resolveRelated row)\\n    (by intro state row; simp only [Functor.map_map, Builder.related_exact])\\n    related (Builder.make initial)\\n  simp only [Builder.make_exact] at relatedSame\\n  have rankedSame := fun state => foldlM_view Builder.view\\n    (fun state row => state.ranked <$> resolveRanked row)\\n    (fun state row => state.ranked <$> resolveRanked row)\\n    (by intro state row; simp only [Functor.map_map, Builder.ranked_exact])\\n    ranked state\\n  unfold projectM referenceM\\n  simp only [← map_eq_pure_bind]\\n  simp only [rankedSame]\\n  have bound := bind_map_left Builder.view\\n    (related.foldlM (fun (state : Builder α β) row => state.related <$> resolveRelated row)\\n      (Builder.make initial))\\n    (fun (state : Result α β) => ranked.foldlM\\n      (fun state row => state.ranked <$> resolveRanked row) state)\\n  rw [← bound, relatedSame]\\n\\ndef legacyIO {γ δ : Type} (initial : Result Nat Value) (related : List γ) (ranked : List δ)\\n    (resolveRelated : γ → IO (Choice Nat Value)) (resolveRanked : δ → IO (Choice Nat Value)) :\\n    IO (Result Nat Value) :=\\n  legacyM initial related ranked resolveRelated resolveRanked\\n\\ndef projectIO {γ δ : Type} (initial : Result Nat Value) (related : List γ) (ranked : List δ)\\n    (resolveRelated : γ → IO (Choice Nat Value)) (resolveRanked : δ → IO (Choice Nat Value)) :\\n    IO (Result Nat Value) :=\\n  projectM initial related ranked resolveRelated resolveRanked\\n\\n/-- Lean exposes IO's exception/state representation but does not install\\nits lawful-monad instance. These kernel proofs use that representation only. -/\\nlocal instance : LawfulMonad IO := .mk'\\n  (id_map := fun action => by\\n    funext world\\n    simp only [Functor.map, instMonadEIO._aux_1, EST.bind]\\n    cases action world <;> rfl)\\n  (pure_bind := fun _ _ => rfl)\\n  (bind_assoc := fun action next last => by\\n    funext world\\n    simp only [Bind.bind, instMonadEIO._aux_13, EST.bind]\\n    cases action world <;> rfl)\\n\\n@[csimp] theorem legacy_io_compiled : @legacyIO = @projectIO := by\\n  funext γ δ initial related ranked resolveRelated resolveRanked\\n  exact (legacyM_exact initial related ranked resolveRelated resolveRanked).trans\\n    (projectM_exact initial related ranked resolveRelated resolveRanked).symm\\n\\nend Eggshell.OwnerProjection\\n\",[]]"],["tools.OwnerUnitPostings","[\"module\\npublic import Std.Data.HashMap.Lemmas\\npublic import Std.Data.TreeSet.Lemmas\\npublic import Init.Data.List.Nat.Pairwise\\n\\n@[expose] public section\\n\\nnamespace Eggshell.OwnerUnitPostings\\n\\n/-- A unit belongs to exactly the owner named by its original family. The\\ndirectory narrows work, while the caller's original predicate still decides. -/\\ndef directory (ownerOf : Fin n → Option String) (indices : List (Fin n)) :\\n    Std.HashMap String (List (Fin n)) :=\\n  indices.foldr (fun index found => match ownerOf index with\\n    | none => found\\n    | some owner => found.insert owner (index :: found[owner]?.getD [])) {}\\n\\ntheorem directory_exact (ownerOf : Fin n → Option String) (indices : List (Fin n))\\n    (owner : String) :\\n    (directory ownerOf indices)[owner]?.getD [] =\\n      indices.filter (fun index => ownerOf index == some owner) := by\\n  induction indices with\\n  | nil => simp [directory]\\n  | cons index rest ih =>\\n    cases found : ownerOf index with\\n    | none => simpa [directory,found] using ih\\n    | some actual =>\\n      by_cases same : actual = owner\\n      · simpa [directory,found,same] using congrArg (List.cons index) ih\\n      · simpa [directory,found,same,Std.HashMap.getElem?_insert] using ih\\n\\nstructure Index (ownerOf : Fin n → Option String) where\\n  postings : Std.HashMap String (List (Fin n))\\n  exact : ∀ owner, postings[owner]?.getD [] =\\n    (List.finRange n).filter (fun index => ownerOf index == some owner)\\n\\ndef prepare (ownerOf : Fin n → Option String) : Index ownerOf :=\\n  ⟨directory ownerOf (List.finRange n),directory_exact ownerOf (List.finRange n)⟩\\n\\nvariable {n : Nat} {ownerOf : Fin n → Option String}\\n\\n/-- Ordered union retains the original ascending unit order, including ties\\nin the selector. Duplicate owner bindings cannot duplicate a unit. -/\\ndef Index.union (index : Index ownerOf) (owners : List String) :\\n    Std.TreeSet (Fin n) compare :=\\n  (∅ : Std.TreeSet (Fin n) compare).insertMany\\n    (owners.flatMap fun owner => index.postings[owner]?.getD [])\\n\\ntheorem Index.union_mem (index : Index ownerOf) (owners : List String) (unit : Fin n) :\\n    unit ∈ (index.union owners).toList ↔\\n      ∃ owner ∈ owners, ownerOf unit = some owner := by\\n  simp [Index.union,index.exact,List.mem_flatMap]\\n\\ndef Index.select (index : Index ownerOf) (owners : List String)\\n    (accept : Fin n → Bool) : List (Fin n) :=\\n  (index.union owners).toList.filter accept\\n\\n/-- The indexed candidate sequence, not merely its set, is the original full\\nscan. Thus marginal-cost ties and the later selector see exactly the same input. -/\\ntheorem Index.select_exact (index : Index ownerOf) (owners : List String)\\n    (accept : Fin n → Bool)\\n    (necessary : ∀ unit, accept unit = true → ∃ owner ∈ owners, ownerOf unit = some owner) :\\n    index.select owners accept = (List.finRange n).filter accept := by\\n  have distinct : (index.union owners).toList.Nodup :=\\n    (index.union owners).distinct_toList.imp (by\\n      intro a b differs same\\n      subst b\\n      exact differs (by simp))\\n  have sameMembers : ∀ unit, unit ∈ index.select owners accept ↔\\n      unit ∈ (List.finRange n).filter accept := by\\n    intro unit\\n    simp only [Index.select,List.mem_filter,Index.union_mem,List.mem_finRange,true_and]\\n    exact ⟨fun h => h.2,fun h => ⟨necessary unit h,h⟩⟩\\n  apply List.Perm.eq_of_pairwise (le := fun a b : Fin n => a.val ≤ b.val)\\n  · intro a b _ _ ab ba\\n    exact Fin.ext (Nat.le_antisymm ab ba)\\n  · exact ((index.union owners).ordered_toList.imp (by\\n      intro a b ordered\\n      exact Nat.le_of_lt (Nat.compare_eq_lt.mp ordered))).filter accept\\n  · exact (List.pairwise_le_finRange n).filter accept\\n  · exact (List.perm_ext_iff_of_nodup (distinct.filter accept)\\n      ((List.nodup_finRange n).filter accept)).mpr sameMembers\\n\\nend Eggshell.OwnerUnitPostings\\n\",[]]"],["tools.PairDecisions","[\"module\\n\\npublic import tools.ExactLazyMemo\\n\\n@[expose] public section\\nnamespace Eggshell\\n\\ndef pairDecisionValue (predicate : Nat → Nat → Prop) [DecidableRel predicate]\\n    (width key : Nat) : Bool := decide (predicate (key / width) (key % width))\\n\\n/-- The two coordinates belong to this predicate, width and lazy tree.\\nThe canonical witness also preserves equality of enclosing source layouts. -/\\nstructure PairDecisions (predicate : Nat → Nat → Prop) [DecidableRel predicate]\\n    (width depth : Nat) where\\n  tree : ExactLazyMemo.Tree (pairDecisionValue predicate width) 0 depth\\n  canonical : tree = ExactLazyMemo.make (pairDecisionValue predicate width) 0 depth\\n\\n@[noinline] def PairDecisions.make (predicate : Nat → Nat → Prop) [DecidableRel predicate]\\n    (width depth : Nat) : PairDecisions predicate width depth :=\\n  ⟨ExactLazyMemo.make (pairDecisionValue predicate width) 0 depth, rfl⟩\\n\\ntheorem PairDecisions.is_canonical [DecidableRel predicate] (memo : PairDecisions predicate width depth) :\\n    memo = make predicate width depth := by\\n  cases memo with\\n  | mk tree canonical => subst tree; rfl\\n\\ntheorem PairDecisions.read_eq [DecidableRel predicate]\\n    (memo : PairDecisions predicate width depth) (first second : Nat) (bounded : second < width) :\\n    ExactLazyMemo.read (pairDecisionValue predicate width) memo.tree (second + width * first) =\\n      decide (predicate first second) := by\\n  rw [ExactLazyMemo.read_exact]\\n  have positive : 0 < width := Nat.lt_of_le_of_lt (Nat.zero_le second) bounded\\n  unfold pairDecisionValue\\n  rw [Nat.add_mul_div_left second first positive, Nat.div_eq_of_lt bounded, Nat.zero_add,\\n    Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt bounded]\\n\\n/-- Positions outside the stride retain the original decision rather than\\naliasing another coordinate. Stored decisions certify the actual proposition. -/\\ndef PairDecisions.decision [DecidableRel predicate]\\n    (memo : PairDecisions predicate width depth) (first second : Nat) : Decidable (predicate first second) :=\\n  if bounded : second < width then\\n    if accepted : ExactLazyMemo.read (pairDecisionValue predicate width) memo.tree\\n        (second + width * first) = true then\\n      isTrue (of_decide_eq_true (by rwa [memo.read_eq first second bounded] at accepted))\\n    else\\n      isFalse (of_decide_eq_false (by\\n        have rejected : ExactLazyMemo.read (pairDecisionValue predicate width) memo.tree\\n            (second + width * first) = false := Bool.eq_false_iff.mpr accepted\\n        rwa [memo.read_eq first second bounded] at rejected))\\n  else inferInstance\\n\\ntheorem PairDecisions.decision_eq [DecidableRel predicate]\\n    (memo : PairDecisions predicate width depth) (first second : Nat) :\\n    memo.decision first second = (inferInstance : Decidable (predicate first second)) :=\\n  Subsingleton.elim _ _\\n\\ndef PairDecisions.branch [DecidableRel predicate]\\n    (memo : PairDecisions predicate width depth) (first second : Nat)\\n    (yes : predicate first second → α) (no : ¬predicate first second → α) : α :=\\n  @dite α _ (memo.decision first second) yes no\\n\\ntheorem PairDecisions.branch_exact [DecidableRel predicate]\\n    (memo : PairDecisions predicate width depth) (first second : Nat)\\n    (yes : predicate first second → α) (no : ¬predicate first second → α) :\\n    memo.branch first second yes no = dite (predicate first second) yes no := by\\n  unfold branch\\n  rw [decision_eq]\\n\\ntheorem PairDecisions.branch_function_eq [DecidableRel predicate]\\n    (memo : PairDecisions predicate width depth) :\\n    @PairDecisions.branch predicate width depth α _ memo =\\n      fun first second yes no => dite (predicate first second) yes no := by\\n  funext first second yes no\\n  exact branch_exact memo first second yes no\\n\\nend Eggshell\\n\",[]]"],["tools.PreparedCueIndex","[\"module\\npublic import tools.OwnerUnitPostings\\npublic import Init.Data.Array.OfFn\\n@[expose] public section\\n\\nnamespace Eggshell.PreparedCueIndex\\n\\n/-- An ordered posting index into one shared array. Every returned value is\\nan original input; duplicates and input order survive narrowing. -/\\nstructure Prepared (keyOf : α → String) (values : Array α) where\\n  index : OwnerUnitPostings.Index (fun i : Fin values.size => some (keyOf values[i.val]))\\n\\ndef prepare (keyOf : α → String) (values : Array α) : Prepared keyOf values :=\\n  ⟨OwnerUnitPostings.prepare (fun i => some (keyOf values[i.val]))⟩\\n\\nvariable {α : Type} {keyOf : α → String} {values : Array α}\\n\\nprivate theorem filtered_values (values : Array α) (accept : α → Bool) :\\n    ((List.finRange values.size).filter (fun i => accept values[i.val])).map (fun i => values[i.val]) =\\n      values.toList.filter accept := by\\n  change ((List.finRange values.size).filter (accept ∘ (fun i => values[i.val]))).map\\n    (fun i => values[i.val]) = _\\n  rw [← List.filter_map]\\n  have rows : (List.finRange values.size).map (fun i => values[i.val]) = values.toList := by\\n    simp only [List.finRange,List.map_ofFn,Function.comp_def]\\n    rw [← Array.toList_ofFn,Array.ofFn_getElem]\\n  rw [rows]\\n\\ndef Prepared.one (prepared : Prepared keyOf values) (key : String) (accept : α → Bool) : List α :=\\n  ((prepared.index.postings[key]?.getD []).filter (fun i => accept values[i.val])).map (fun i => values[i.val])\\n\\ntheorem Prepared.one_exact (prepared : Prepared keyOf values) (key : String) (accept : α → Bool)\\n    (necessary : ∀ value, accept value = true → keyOf value = key) :\\n    prepared.one key accept = values.toList.filter accept := by\\n  unfold Prepared.one\\n  rw [prepared.index.exact,List.filter_filter]\\n  have same : (fun i : Fin values.size => accept values[i.val] &&\\n      (some (keyOf values[i.val]) == some key)) = (fun i => accept values[i.val]) := by\\n    funext i\\n    apply Bool.eq_iff_iff.mpr\\n    simp only [Bool.and_eq_true,beq_iff_eq,Option.some.injEq]\\n    exact ⟨And.left,fun accepted => ⟨accepted,necessary _ accepted⟩⟩\\n  rw [same]\\n  exact filtered_values values accept\\n\\ndef Prepared.many (prepared : Prepared keyOf values) (keys : List String) (accept : α → Bool) : List α :=\\n  (prepared.index.select keys.eraseDups (fun i => accept values[i.val])).map (fun i => values[i.val])\\n\\ntheorem Prepared.many_exact (prepared : Prepared keyOf values) (keys : List String) (accept : α → Bool)\\n    (necessary : ∀ value, accept value = true → keyOf value ∈ keys) :\\n    prepared.many keys accept = values.toList.filter accept := by\\n  unfold Prepared.many\\n  rw [prepared.index.select_exact keys.eraseDups (fun i => accept values[i.val]) (by\\n    intro i accepted\\n    exact ⟨keyOf values[i.val],List.mem_eraseDups.mpr (necessary values[i.val] accepted),rfl⟩)]\\n  exact filtered_values values accept\\n\\nend Eggshell.PreparedCueIndex\\n\",[]]"],["tools.QueryLiterals","[\"module\\npublic import Eggshell.SearchRank\\npublic import tools.IdentifierParts\\n@[expose] public section\\n\\nnamespace Eggshell.QueryLiterals\\n\\ndef nameChar (c : Char) : Bool := RetrievalResearch.Unicode.letterNumber c || c == '_'\\n\\n/-- Option-shaped text from the current question is a retrieval hint. Negative\\nnumbers, prose-internal hyphens and standalone list markers supply no hint. -/\\ndef query (text : String) : List (List String) := Id.run do\\n  let chars := text.toList.toArray\\n  let mut result := []\\n  for i in [:chars.size] do\\n    if chars[i]! != '-' || (i > 0 && (nameChar chars[i-1]! || chars[i-1]! == '-')) then continue\\n    let mut first := i\\n    while first < chars.size && chars[first]! == '-' do first := first + 1\\n    if first == chars.size || !RetrievalResearch.Unicode.letterNumber chars[first]! || chars[first]!.isDigit then continue\\n    let mut last := first\\n    while last < chars.size && (nameChar chars[last]! || chars[last]! == '-') do last := last + 1\\n    let parts := IdentifierParts.parts (fun _ => false) (String.ofList ((chars.toList.drop first).take (last-first)))\\n    if !parts.isEmpty && !result.contains parts then result := result ++ [parts]\\n  return result\\n\\ndef identifiers (text : String) : List (List String) := Id.run do\\n  let mut result : Array (List String) := #[]\\n  let mut current : List Char := []\\n  for c in text.toList do\\n    if nameChar c then current := c :: current\\n    else if !current.isEmpty then\\n      result := result.push (IdentifierParts.parts (fun _ => false) (String.ofList current.reverse))\\n      current := []\\n  if !current.isEmpty then\\n    result := result.push (IdentifierParts.parts (fun _ => false) (String.ofList current.reverse))\\n  return result.toList\\n\\n/-- Match complete trailing identifier components, preserving component order.\\nThis is advice only; no prefix vocabulary, option alias table or Work identity\\nis inferred from a spelling resemblance. -/\\ndef suffix (literal identifier : List String) : Bool :=\\n  literal.length ≤ identifier.length && identifier.drop (identifier.length-literal.length) == literal\\n\\nstructure Focus where\\n  windows : List Nat\\n  anchors : List Nat\\n\\ndef focus (question : String) (documents : List String) (ranked : List Nat) : Focus :=\\n  let literals := query question\\n  let words := if literals.isEmpty then [] else documents.map identifiers\\n  let channels := literals.map fun literal =>\\n    let matching := (words.zipIdx.filter fun (names,_) => names.any fun identifier =>\\n      literal.length < identifier.length && suffix literal identifier).map Prod.snd\\n    (ranked.filter matching.contains ++ matching.filter (fun index => !ranked.contains index)).toArray\\n  let hints := (List.range documents.length).flatMap fun rank => channels.filterMap (·[rank]?)\\n  let selected := SearchRank.select documents.length ranked.length [] (hints ++ ranked)\\n  {windows := selected, anchors := selected.filter hints.contains}\\n\\ndef windows (question : String) (documents : List String) (ranked : List Nat) : List Nat :=\\n  (focus question documents ranked).windows\\n\\ntheorem window_is_original (question : String) (documents : List String) (ranked : List Nat)\\n    (index : Nat) (present : index ∈ windows question documents ranked) : index < documents.length :=\\n  SearchRank.selected_is_existing _ _ _ _ _ present\\n\\ntheorem window_count_bounded (question : String) (documents : List String) (ranked : List Nat) :\\n    (windows question documents ranked).length ≤ ranked.length :=\\n  SearchRank.selected_within_budget _ _ _ _\\n\\ntheorem windows_distinct (question : String) (documents : List String) (ranked : List Nat) :\\n    (windows question documents ranked).Nodup := SearchRank.selected_no_duplicates _ _ _ _\\n\\ntheorem anchors_are_selected (question : String) (documents : List String) (ranked : List Nat)\\n    (index : Nat) (present : index ∈ (focus question documents ranked).anchors) :\\n    index ∈ (focus question documents ranked).windows :=\\n  (List.mem_filter.mp present).1\\n\\nend Eggshell.QueryLiterals\\n\",[]]"],["tools.RangeReach","[\"module\\npublic import Std\\n@[expose] public section\\n\\nnamespace Eggshell.RangeReach\\n\\n/-- Original intervals with opaque payload identities. No source equivalence\\nor completion authority is inferred by this recommendation index. -/\\nstructure Entry (α : Type) where\\n  first : Nat\\n  limit : Nat\\n  value : α\\n\\nstructure Prepared (α : Type) where\\n  starts : Array Nat\\n  farthest : Array (Entry α)\\n\\n/-- The prefix maximum answers a furthest-reaching interval query with one\\nbinary search. Preparation happens once per owner, not once per citation. -/\\ndef prepare (entries : Array (Entry α)) : Prepared α := Id.run do\\n  let ordered := (entries.filter (fun entry => entry.first < entry.limit)).qsort\\n    (fun left right => if left.first == right.first then left.limit > right.limit else left.first < right.first)\\n  let mut starts := #[]\\n  let mut farthest := #[]\\n  let mut best := none\\n  for entry in ordered do\\n    let current := match best with\\n      | none => entry\\n      | some prior => if prior.limit < entry.limit then entry else prior\\n    starts := starts.push entry.first\\n    farthest := farthest.push current\\n    best := some current\\n  return ⟨starts,farthest⟩\\n\\ndef Prepared.lookup? (prepared : Prepared α) (point : Nat) : Option (Entry α) := Id.run do\\n  let mut lower := 0\\n  let mut upper := prepared.starts.size\\n  while lower < upper do\\n    let middle := (lower+upper)/2\\n    let some start := prepared.starts[middle]? | return none\\n    if start ≤ point then lower := middle+1 else upper := middle\\n  if lower == 0 then return none\\n  let some found := prepared.farthest[lower-1]? | return none\\n  if found.first ≤ point && point < found.limit then return some found else return none\\n\\ndef Prepared.coverFuel (prepared : Prepared α) : Nat → Nat → Nat → Option (List α)\\n  | 0,first,last => if last ≤ first then some [] else none\\n  | fuel+1,first,last => do\\n    if last ≤ first then return []\\n    let found ← prepared.lookup? first\\n    if first < found.limit then\\n      let rest ← prepared.coverFuel fuel (min last found.limit) last\\n      return found.value :: rest\\n    else none\\n\\ndef Prepared.cover? (prepared : Prepared α) (first last : Nat) : Option (List α) :=\\n  if first < last then prepared.coverFuel prepared.farthest.size first last else none\\n\\nend Eggshell.RangeReach\\n\",[]]"],["tools.RetrievalCategories","[\"module\\n\\npublic import Std\\n\\n@[expose] public section\\n\\nnamespace Eggshell.RetrievalResearch.Unicode\\n\\n/-- Generated Unicode categories.
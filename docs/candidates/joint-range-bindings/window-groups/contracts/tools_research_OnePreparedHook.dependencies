  header.work == doc.work && header.original == Sha256.hex raw.toUTF8 do\\n    throw (IO.userError \\\"content correspondence belongs to another original\\\")\\n  let mut aliases := #[]\\n  for digest in header.chunks do\\n    unless Synapses.digest digest do throw (IO.userError \\\"invalid content block address\\\")\\n    let some bytes ← source.get (chunkKey digest) | throw (IO.userError \\\"missing content block\\\")\\n    unless Sha256.hex bytes == digest do throw (IO.userError \\\"changed content block\\\")\\n    let rows ← ObservedRecords.decode (α := Array ContentCapture.Alias) bytes\\n    unless rows.size ≤ chunkCount do throw (IO.userError \\\"foreign content block extent\\\")\\n    aliases := aliases ++ rows\\n  let characters := raw.toList.toArray\\n  unless aliases.size == header.aliases && (header.complete || aliases.isEmpty) &&\\n      aliases.all (validAlias header.inputs characters) do\\n    throw (IO.userError \\\"incomplete content correspondence directory\\\")\\n  return some ⟨header.implementation,header.inputs,header.complete,aliases,header.failure⟩\\n\\ndef catalog (database : String) (doc : Document) (captured : ContentCapture.Captured) :\\n    Except String ObservationContext.Catalog := do\\n  let some raw := doc.source | throw \\\"missing original content body\\\"\\n  let some occurrence := doc.occurrences[0]? | throw \\\"missing original occurrence\\\"\\n  let characters := raw.toList.toArray\\n  let mut result : ObservationContext.Catalog := {}\\n  let quoteSource := QuotationContext.Source.make raw\\n  for alias in captured.aliases do\\n    let some code := ContentCapture.code? characters alias | throw \\\"content alias lost literal equality\\\"\\n    let read : Read := {\\n      occurrence,source := ⟨.file alias.file,alias.line,alias.line⟩\\n      binding := ⟨database,doc.owner,doc.work,alias.first,alias.limit⟩\\n      quotations := #[Quotes.digest code]}\\n    unless read.valid do throw \\\"content alias has an invalid original binding\\\"\\n    result := {\\n      located := result.located.push ⟨read,#[⟨read.source,alias.first,alias.limit⟩],#[read],code⟩\\n      quotations := result.quotations.push\\n        (ObservationContext.Quotation.prepare quoteSource read alias.first alias.limit code)}\\n  return result\\n\\nend Eggshell.ContentMetadata\\n\"],[\"SourceEvidence.lean\",\"module\\n\\npublic import Eggshell.FileSystem\\npublic import Eggshell.Blake3\\npublic import Eggshell.Relation\\npublic import Lean.Data.Json.FromToJson\\npublic import Lean.Data.Json.Parser\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SourceEvidence\\nopen Lean\\n\\n/-- A portable locator is relative to the current workspace. The producing\\nworkspace's absolute name is not an identity or permission to read elsewhere. -/\\ndef safeRelative (path : String) : Bool :=\\n  !path.isEmpty && !path.startsWith \\\"/\\\" && !path.contains '\\\\x00' &&\\n    (path.splitOn \\\"/\\\").all (fun part =>\\n      !part.isEmpty && part != \\\".\\\" && part != \\\"..\\\")\\n\\nstructure Relative where\\n  text : String\\n  safe : safeRelative text = true\\n\\ndef Relative.check? (path : String) : Option Relative :=\\n  if safe : safeRelative path = true then some ⟨path, safe⟩ else none\\n\\ntheorem relative_cannot_escape (path : Relative) :\\n    (path.text.splitOn \\\"/\\\").all (fun part => part != \\\"..\\\") = true := by\\n  have parts := path.safe\\n  simp only [safeRelative, Bool.and_eq_true] at parts\\n  apply List.all_eq_true.mpr\\n  intro part member\\n  have valid := List.all_eq_true.mp parts.2 part member\\n  simpa only [Bool.and_eq_true] using (Bool.and_eq_true_iff.mp valid).2\\n\\ndef withoutDots (path : String) : String :=\\n  (if path.startsWith \\\"/\\\" then \\\"/\\\" else \\\"\\\") ++\\n    \\\"/\\\".intercalate ((path.splitOn \\\"/\\\").filter (fun part => !part.isEmpty && part != \\\".\\\"))\\n\\ndef relative? (workspace directory : System.FilePath) (path : String) : Option Relative := do\\n  if path.isEmpty || path.contains '\\\\x00' then none else do\\n    let workspace := withoutDots workspace.normalize.toString\\n    let actual := withoutDots (directory / System.FilePath.mk path).normalize.toString\\n    let basePrefix := if workspace.endsWith \\\"/\\\" then workspace else workspace ++ \\\"/\\\"\\n    if !actual.startsWith basePrefix then none else\\n      Relative.check? ((actual.drop basePrefix.length).copy)\\n\\nstructure Fingerprint where\\n  bytes : Nat\\n  root : String\\n  deriving Repr, DecidableEq, BEq, ToJson, FromJson\\n\\nstructure File where\\n  relative : String\\n  content : Option Fingerprint\\n  deriving Repr, DecidableEq, BEq, ToJson, FromJson\\n\\nstructure Record where\\n  workspace : String\\n  files : List File\\n  uris : List String := []\\n  complete : Bool\\n  /-- File observations may be complete while a directory search or another\\n      operation has an open dependency domain. Such a record never completes Work. -/\\n  closed : Bool := false\\n  deriving Repr, DecidableEq, ToJson\\n\\n/-- Absence of a closed-domain witness never asserts complete operation\\ncoverage. It also does not discard the independently recorded file data. -/\\ninstance : FromJson Record where\\n  fromJson? json := do\\n    let workspace ← json.getObjValAs? String \\\"workspace\\\"\\n    let files ← json.getObjValAs? (List File) \\\"files\\\"\\n    let uris ← json.getObjValAs? (List String) \\\"uris\\\"\\n    let complete ← json.getObjValAs? Bool \\\"complete\\\"\\n    let closed ← match json.getObjVal? \\\"closed\\\" with\\n      | .error _ => pure false\\n      | .ok value => fromJson? value\\n    pure ⟨workspace, files, uris, complete, closed⟩\\n\\ninstance : BEq Record := ⟨fun left right => decide (left = right)⟩\\ninstance : LawfulBEq Record where\\n  rfl := by intro record; simp [BEq.beq]\\n  eq_of_beq := by intro left right equal; exact of_decide_eq_true equal\\n\\ndef Record.valid (record : Record) : Bool :=\\n  record.complete && record.uris.isEmpty && !record.files.isEmpty &&\\n    decide ((record.files.map (·.relative)).Nodup) &&\\n    record.files.all (fun file => safeRelative file.relative &&\\n      file.content.all (fun content => content.root.length == 64 &&\\n        content.root.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f'))))\\n\\n/-- Freshness authorizes only exact currently observed dependency descriptors.\\nIt does not assert collision freedom or prove a provider's external behavior. -/\\ndef agrees (record : Record) (current : List File) : Bool :=\\n  record.valid && decide (current = record.files)\\n\\nstructure Checked (record : Record) (current : List File) : Type where\\n  valid : record.valid = true\\n  exact : current = record.files\\n\\ndef check? (record : Record) (current : List File) : Option (Checked record current) :=\\n  if accepted : agrees record current = true then\\n    some ⟨(Bool.and_eq_true_iff.mp accepted).1,\\n      of_decide_eq_true (Bool.and_eq_true_iff.mp accepted).2⟩\\n  else none\\n\\ntheorem checked_dependencies_exact (checked : Checked record current) :\\n    current = record.files := checked.exact\\n\\n/-- A valid historical observation becomes usable again exactly when its\\nactual dependencies match; a later observation cannot refresh its hashes. -/\\ntheorem checked_iff_valid_dependencies (record : Record) (current : List File) :\\n    (check? record current).isSome = true ↔ record.valid = true ∧ current = record.files := by\\n  unfold check?\\n  split\\n  · rename_i accepted\\n    constructor\\n    · intro _\\n      exact ⟨(Bool.and_eq_true_iff.mp accepted).1,\\n        of_decide_eq_true (Bool.and_eq_true_iff.mp accepted).2⟩\\n    · intro _\\n      rfl\\n  · rename_i rejected\\n    constructor\\n    · intro impossible\\n      simp at impossible\\n    · rintro ⟨valid, equal⟩\\n      exact False.elim (rejected (by simp [agrees, valid, equal]))\\n\\ntheorem changed_dependency_rejected (record : Record) (current : List File)\\n    (changed : current ≠ record.files) : check? record current = none := by\\n  simp [check?, agrees, changed]\\n\\ntheorem incomplete_record_rejected (record : Record) (current : List File)\\n    (incomplete : record.complete = false) : check? record current = none := by\\n  simp [check?, agrees, Record.valid, incomplete]\\n\\n/-- Workspace names are display provenance. Relocation changes neither the\\nrelative dependency keys nor the contents which the receiving machine checks. -/\\ntheorem relocated_record_agreement (record : Record) (current : List File) (name : String) :\\n    agrees {record with workspace := name} current = agrees record current := rfl\\n\\nstructure Probe where\\n  file : File\\n  stamp : Option String\\n  deriving Repr, ToJson, FromJson\\n\\nstructure Capture where\\n  record : Record\\n  probes : List Probe\\n  deriving Repr, ToJson, FromJson\\n\\ndef pageRoot (previous page : ByteArray) : ByteArray :=\\n  Blake3.digest \\\"eggshell.source.page\\\".toUTF8 [previous, page]\\n\\ntheorem page_root_size (previous page : ByteArray) : (pageRoot previous page).size = 32 := by\\n  exact Blake3.hashSegments_size _\\n\\nabbrev Root := {bytes : ByteArray // bytes.size = 32}\\n\\ndef stepRoot (previous : Root) (page : ByteArray) : Root :=\\n  ⟨pageRoot previous.val page, page_root_size _ _⟩\\n\\n/-- The scanner holds a single bounded native page, a digest and counters.\\nThe chain commits page order and file length. It is a content fingerprint,\\nnot an assertion that equal finite hashes imply equal arbitrary files. -/\\ndef fingerprint (path : System.FilePath) (deadline : Nat) : IO (Option (Fingerprint × String)) := do\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  let handle ← FileSystem.openRead path.toString\\n  let before ← FileSystem.readVersion handle\\n  let mut offset := 0\\n  let mut root : Root := ⟨Blake3.digest \\\"eggshell.source.file\\\".toUTF8 [Blake3.u64le before.bytes],\\n    Blake3.hashSegments_size _⟩\\n  while offset < before.bytes do\\n    if (← IO.monoMsNow) ≥ deadline then return none\\n    let count := min 4096 (before.bytes - offset)\\n    let page ← FileSystem.readPage handle offset.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    if page.size != count then return none\\n    root := stepRoot root page\\n    offset := offset + count\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  if !FileSystem.stableRead before after current offset then return none\\n  pure (some (⟨before.bytes, Blake3.hex root.val⟩, before.stamp))\\n\\ndef probe (workspace : System.FilePath) (relative : Relative) (deadline : Nat) : IO (Option Probe) := do\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  let path := workspace / relative.text\\n  try\\n    FileSystem.rejectSymlinkAncestors path\\n    match ← FileSystem.regularMetadata? path with\\n    | none => pure (some ⟨⟨relative.text, none⟩, none⟩)\\n    | some _ =>\\n        pure ((← fingerprint path deadline).map fun (content, stamp) =>\\n          ⟨⟨relative.text, some content⟩, some stamp⟩)\\n  catch _ => pure none -- inaccessible, symlink or interrupted is unverified, never absent\\n\\ndef stillCurrent (workspace : System.FilePath) (probe : Probe) : IO Bool := do\\n  let some relative := Relative.check? probe.file.relative | return false\\n  let path := workspace / relative.text\\n  try\\n    FileSystem.rejectSymlinkAncestors path\\n    match probe.stamp, ← FileSystem.regularMetadata? path with\\n    | none, none => pure true\\n    | some expected, some _ => pure ((← FileSystem.readVersion\\n        (← FileSystem.openRead path.toString)).stamp == expected)\\n    | _, _ => pure false\\n  catch _ => pure false\\n\\n/-- Recheck the version after all related fingerprints have been collected.\\nThe OS version checks are observations, not an atomic filesystem snapshot. -/\\ndef checkedProbeFile (workspace : System.FilePath) (observed : Option Probe)\\n    (deadline : Nat) : IO (Option File) := do\\n  let some observed := observed | return none\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  unless ← stillCurrent workspace observed do return none\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  pure (some observed.file)\\n\\n/-- Observe precisely the declared files. There is no workspace scan, Git\\ndependency, remote request, persistent negative cache or hard file-count cap. -/\\ndef observe (workspace : System.FilePath) (files : List File) (deadline : Nat) :\\n    IO (Option (List File)) := do\\n  let mut observations := []\\n  for file in files do\\n    let some relative := Relative.check? file.relative | return none\\n    let some observed ← probe workspace relative deadline | return none\\n    observations := observed :: observations\\n  let mut files := []\\n  for observed in observations.reverse do\\n    let some file ← checkedProbeFile workspace (some observed) deadline | return none\\n    files := file :: files\\n  pure (some files.reverse)\\n\\ndef verify (workspace : System.FilePath) (record : Record) (deadline : Nat) : IO Bool := do\\n  if !record.valid then return false\\n  let some current ← observe workspace record.files deadline | return false\\n  pure ((check? record current).isSome)\\n\\ndef unknown (workspace : System.FilePath) (uris : List String := []) : Capture :=\\n  ⟨⟨workspace.fileName.getD workspace.toString, [], uris, false, false⟩, []⟩\\n\\n/-- Only explicitly named local files are captured. Unrecognized shell syntax,\\ndirectory searches and remote providers remain historical evidence. -/\\ndef pathsFromInput (input : Json) : List String :=\\n  [\\\"path\\\", \\\"file_path\\\", \\\"filename\\\", \\\"file\\\"].filterMap fun key =>\\n    (input.getObjValAs? String key).toOption\\n\\ndef urisFromInput (input : Json) : List String :=\\n  [\\\"url\\\", \\\"uri\\\"].filterMap fun key => (input.getObjValAs? String key).toOption\\n\\ndef isURI (path : String) : Bool := (path.splitOn \\\"://\\\").length > 1\\n\\n/-- Literal shell words. Expansion, redirection and substitution do not\\nestablish a closed local read. Quoted patterns are separate from operands. -/\\ndef literalWords? (text : String) : Option (List String) := do\\n  if text.contains '\\\\x00' then return ← none\\n  let mut words := []\\n  let mut word := \\\"\\\"\\n  let mut quote := (0 : Nat)\\n  let mut started := false\\n  let mut escaped := false\\n  for c in text.toList do\\n    if quote == 1 then\\n      if c == '\\\\'' then quote := 0 else word := word.push c\\n    else if quote == 2 then\\n      if escaped then\\n        if c == '\\\\n' || c == '\\\\r' then return ← none\\n        if !['$', '`', '\\\"', '\\\\\\\\'].contains c then word := word.push '\\\\\\\\'\\n        word := word.push c\\n        escaped := false\\n      else if c == '\\\\\\\\' then escaped := true\\n      else if c == '\\\"' then quote := 0\\n      else if c == '$' || c == '`' then return ← none\\n      else word := word.push c\\n    else if c == '\\\\'' then\\n      quote := 1\\n      started := true\\n    else if c == '\\\"' then\\n      quote := 2\\n      started := true\\n    else if c == '\\\\n' || c == '\\\\r' then return ← none\\n    else if c.isWhitespace then\\n      if started then words := word :: words\\n      word := \\\"\\\"\\n      started := false\\n    else if ['$', '`', '\\\\\\\\', ';', '|', '&', '<', '>', '*', '?', '[', ']', '(', ')', '{', '}'].contains c then\\n      return ← none\\n    else\\n      word := word.push c\\n      started := true\\n  if quote != 0 || escaped then return ← none\\n  if started then words := word :: words\\n  pure words.reverse\\n\\ndef printProgram (program : String) : Bool :=\\n  (program.splitOn \\\";\\\").all fun range =>\\n    range.endsWith \\\"p\\\" && !(range.dropEnd 1).isEmpty &&\\n      ((range.dropEnd 1).copy.toList).all (fun c => c.isDigit || c == ',' || c == '$')\\n\\n/-- A stream filter has no file operand. Programs which read/write another\\nfile, execute a command or substitute shell expressions cannot inhabit this\\nplan. The external command/OS observation remains outside this pure contract. -/\\ninductive StreamFilter where\\n  | print (program : String) (literal : printProgram program = true)\\n  | prefix (lines : Nat)\\n  | suffix (lines : Nat)\\n\\ndef streamFilter? (words : List String) : Option StreamFilter := do\\n  match words with\\n  | [\\\"sed\\\", \\\"-n\\\", program] =>\\n      if literal : printProgram program = true then some (.print program literal) else none\\n  | [\\\"head\\\", \\\"-n\\\", count] => count.toNat? |>.map StreamFilter.prefix\\n  | [\\\"head\\\", count] =>\\n      if count.startsWith \\\"-\\\" then\\n        ((count.drop 1).copy.toNat?).map StreamFilter.prefix else none\\n  | [\\\"tail\\\", \\\"-n\\\", count] => count.toNat? |>.map StreamFilter.suffix\\n  | [\\\"tail\\\", count] =>\\n      if count.startsWith \\\"-\\\" then\\n        ((count.drop 1).copy.toNat?).map StreamFilter.suffix else none\\n  | _ => none\\n\\n/-- Split only unquoted pipes; every filter must consume its input stream\\nwithout introducing another source. -/\\ndef pipelineSegments? (command : String) : Option (List String) := do\\n  let mut parts := []\\n  let mut part := \\\"\\\"\\n  let mut quote := (0 : Nat)\\n  let mut escaped := false\\n  for c in command.toList do\\n    if escaped then\\n      part := part.push c\\n      escaped := false\\n    else if quote == 2 && c == '\\\\\\\\' then\\n      part := part.push c\\n      escaped := true\\n    else if quote == 0 && c == '|' then\\n      parts := part :: parts\\n      part := \\\"\\\"\\n    else\\n      part := part.push c\\n      if quote == 1 then\\n        if c == '\\\\'' then quote := 0\\n      else if quote == 2 then\\n        if c == '\\\"' then quote := 0\\n      else if c == '\\\\'' then quote := 1\\n      else if c == '\\\"' then quote := 2\\n  if quote != 0 || escaped then return ← none\\n  pure ((part :: parts).reverse)\\n\\n/-- Split a literal list of read pipelines. Both sides of `&&` are included:\\nan unexecuted right side can only make the dependency set conservative.\\nQuotes retain separators in regexes and sed programs. Unsupported operators,\\nexpansion and commands are rejected by the subsequent pipeline parser. -/\\ndef sequenceSegments? (command : String) : Option (List String) := do\\n  let mut parts := []\\n  let mut part := \\\"\\\"\\n  let mut quote := (0 : Nat)\\n  let mut ampersand := false\\n  let mut afterAnd := false\\n  let mut escaped := false\\n  for c in command.toList do\\n    if escaped then\\n      part := part.push c\\n      escaped := false\\n    else if quote == 2 && c == '\\\\\\\\' then\\n      part := part.push c\\n      escaped := true\\n    else if ampersand then\\n      if c != '&' then return ← none\\n      if part.trimAscii.isEmpty then return ← none\\n      parts := part :: parts\\n      part := \\\"\\\"\\n      ampersand := false\\n      afterAnd := true\\n    else if quote == 0 && c == '&' then\\n      ampersand := true\\n    else if quote == 0 && (c == ';' || c == '\\\\n') then\\n      if part.trimAscii.isEmpty then return ← none\\n      parts := part :: parts\\n      part := \\\"\\\"\\n    else\\n      part := part.push c\\n      if !c.isWhitespace then afterAnd := false\\n      if quote == 1 then\\n        if c == '\\\\'' then quote := 0\\n      else if quote == 2 then\\n        if c == '\\\"' then quote := 0\\n      else if c == '\\\\'' then quote := 1\\n      else if c == '\\\"' then quote := 2\\n  if quote != 0 || escaped || ampersand || afterAnd then return ← none\\n  if !part.trimAscii.isEmpty then parts := part :: parts\\n  pure parts.reverse\\n\\ndef readerFiles? (words : List String) : Option (List String) := do\\n  let executable ← words.head?\\n  let arguments := words.tail\\n  let name := (System.FilePath.mk executable).fileName.getD executable\\n  match name with\\n  | \\\"cat\\\" =>\\n      let files := arguments.dropWhile (fun word => [\\\"--\\\", \\\"-n\\\", \\\"-b\\\", \\\"-s\\\", \\\"-v\\\", \\\"-E\\\", \\\"-T\\\"].contains word)\\n      if files.isEmpty || files.any (fun file => file.startsWith \\\"-\\\") then none else some files\\n  | \\\"sed\\\" =>\\n      match arguments with\\n      | \\\"-n\\\" :: program :: files =>\\n          if !files.isEmpty && printProgram program &&\\n              !files.any (fun file => file.startsWith \\\"-\\\") then some files else none\\n      | _ => none\\n  | \\\"rg\\\" =>\\n      let arguments := arguments.dropWhile (fun word =>\\n        [\\\"-n\\\", \\\"-l\\\", \\\"-i\\\", \\\"-S\\\", \\\"-F\\\", \\\"-w\\\", \\\"-s\\\", \\\"--fixed-strings\\\", \\\"--line-number\\\",\\n          \\\"--ignore-case\\\", \\\"--word-regexp\\\"].contains word)\\n      let files ← match arguments with\\n        | \\\"--\\\" :: _pattern :: files => some files\\n        | pattern :: files => if pattern.startsWith \\\"-\\\" then none else some files\\n        | _ => none\\n      if !files.isEmpty && !files.any (fun file => file.startsWith \\\"-\\\") then some files else none\\n  | \\\"nl\\\" =>\\n      match arguments with\\n      | [file] | [\\\"-ba\\\", file] => if file.startsWith \\\"-\\\" then none else some [file]\\n      | _ => none\\n  | _ => none\\n\\nstructure ReadPlan where\\n  sources : {files : List String // files ≠ []}\\n  filters : List StreamFilter\\n\\ndef pipelineReadPlan? (command : String) : Option ReadPlan := do\\n  let segments ← pipelineSegments? command\\n  let words ← segments.mapM literalWords?\\n  let first ← words.head?\\n  let files ← readerFiles? first\\n  let filters ← words.tail.mapM streamFilter?\\n  if nonempty : files ≠ [] then some ⟨⟨files, nonempty⟩, filters⟩ else none\\n\\ndef combinedFiles (plans : List ReadPlan) : List String :=\\n  (plans.flatMap (·.sources.val)).eraseDups\\n\\n/-- No accepted pipeline is omitted. A batch can never authorize just its\\nrecognizable prefix; parsing all pipelines succeeds before this is called. -/\\ndef joinReadPlans? (plans : List ReadPlan) : Option ReadPlan :=\\n  if nonempty : combinedFiles plans ≠ [] then\\n    some ⟨⟨combinedFiles plans, nonempty⟩, plans.flatMap (·.filters)⟩\\n  else none\\n\\ndef readPlan? (command : String) : Option ReadPlan := do\\n  let segments ← sequenceSegments? command\\n  let plans ← segments.mapM pipelineReadPlan?\\n  joinReadPlans? plans\\n\\ndef commandFiles? (command : String) : Option (List String) :=\\n  (readPlan? command).map (·.sources.val)\\n\\n/-- Preserve each independently recognized read in a mixed batch. Failure to\\ndescribe the entire command does not erase observations of explicitly named\\nfiles. This list gives observation targets only, never completion authority. -/\\ndef observedCommandFiles (command : String) : List String :=\\n  ((sequenceSegments? command).getD []).filterMap pipelineReadPlan? |>.flatMap (·.sources.val) |>.eraseDups\\n\\ntheorem observed_command_file_from_read (command : String) (file : String)\\n    (present : file ∈ observedCommandFiles command) :\\n    ∃ segment ∈ (sequenceSegments? command).getD [],\\n      ∃ plan, pipelineReadPlan? segment = some plan ∧ file ∈ plan.sources.val := by\\n  simp only [observedCommandFiles, List.mem_eraseDups, List.mem_flatMap, List.mem_filterMap] at present\\n  obtain ⟨plan, ⟨segment, member, parsed⟩, filePresent⟩ := present\\n  exact ⟨segment, member, plan, parsed, filePresent⟩\\n\\ntheorem accepted_read_plan_dependencies (command : String) (plan : ReadPlan)\\n    (accepted : readPlan? command = some plan) :\\n    commandFiles? command = some plan.sources.val := by\\n  simp [commandFiles?, accepted]\\n\\ntheorem read_plan_dependencies_nonempty (plan : ReadPlan) : plan.sources.val ≠ [] :=\\n  plan.sources.property\\n\\ntheorem stream_filters_preserve_dependencies (plan : ReadPlan) (filters : List StreamFilter) :\\n    ({plan with filters} : ReadPlan).sources = plan.sources := rfl\\n\\ntheorem combined_files_exact (plans : List ReadPlan) (file : String) :\\n    file ∈ combinedFiles plans ↔ ∃ plan ∈ plans, file ∈ plan.sources.val := by\\n  simp [combinedFiles, List.mem_flatMap]\\n\\ntheorem joined_read_plan_dependencies (plans : List ReadPlan) (plan : ReadPlan)\\n    (accepted : joinReadPlans? plans = some plan) :\\n    plan.sources.val = combinedFiles plans := by\\n  unfold joinReadPlans? at accepted\\n  split at accepted\\n  · cases accepted\\n    rfl\\n  · contradiction\\n\\ntheorem joined_read_plan_preserves_every_source (plans : List ReadPlan) (plan : ReadPlan)\\n    (accepted : joinReadPlans? plans = some plan) (file : String) :\\n    file ∈ plan.sources.val ↔ ∃ pipeline ∈ plans, file ∈ pipeline.sources.val := by\\n  rw [joined_read_plan_dependencies plans plan accepted]\\n  exact combined_files_exact plans file\\n\\ndef inputPaths (input : Json) : List String :=\\n  let direct := pathsFromInput input ++ ((input.getObjValAs? (List String) \\\"paths\\\").toOption.getD [])\\n  (if !direct.isEmpty then direct else\\n    (((input.getObjValAs? String \\\"cmd\\\").toOption.orElse\\n      (fun _ => (input.getObjValAs? String \\\"command\\\").toOption)).bind commandFiles?).getD []).eraseDups\\n\\ndef observedInputPaths (input : Json) : List String :=\\n  let direct := pathsFromInput input ++ ((input.getObjValAs? (List String) \\\"paths\\\").toOption.getD [])\\n  (if !direct.isEmpty then direct else\\n    (((input.getObjValAs? String \\\"cmd\\\").toOption.orElse\\n      (fun _ => (input.getObjValAs? String \\\"command\\\").toOption)).map observedCommandFiles).getD []).eraseDups\\n\\ndef inputDirectory? (workspace : System.FilePath) (input : Json) : Option System.FilePath := do\\n  let mut directory := workspace\\n  let mut specified := false\\n  for key in [\\\"workdir\\\", \\\"cwd\\\"] do\\n    if (input.getObjVal? key).isOk then\\n      let raw ← (input.getObjValAs? String key).toOption\\n      let actual := (workspace / raw).normalize\\n      if specified && directory != actual then return ← none\\n      directory := actual\\n      specified := true\\n  pure directory\\n\\ndef capture (workspace : System.FilePath) (input : Json) (deadline : Nat) : IO Capture := do\\n  let paths := observedInputPaths input\\n  let uris := (urisFromInput input ++ paths.filter isURI).eraseDups\\n  if paths.isEmpty || !uris.isEmpty then return unknown workspace uris\\n  let some directory := inputDirectory? workspace input | return unknown workspace\\n  let mut probes := []\\n  let mut closed := paths == inputPaths input && !paths.isEmpty\\n  for path in paths do\\n    let some relative := relative? workspace directory path | return unknown workspace\\n    -- A named directory is an open search domain, not a failed file read.\\n    -- Retain the other sealed file observations; do not traverse the directory.\\n    if ← (directory / path).isDir then\\n      closed := false\\n      continue\\n    let some observed ← probe workspace relative deadline | return unknown workspace\\n    probes := observed :: probes\\n  let completed := probes.reverse\\n  let record : Record := ⟨workspace.fileName.getD workspace.toString, completed.map (·.file), [], true, closed⟩\\n  if !record.valid then return unknown workspace\\n  pure ⟨record, completed⟩\\n\\ndef sealCapture (workspace : System.FilePath) (capture : Capture) (deadline : Nat) : IO Record := do\\n  if capture.record.files != capture.probes.map (·.file) || !capture.record.valid then\\n    return {capture.record with complete := false}\\n  for probe in capture.probes do\\n    if (← IO.monoMsNow) ≥ deadline then return {capture.record with complete := false}\\n    unless ← stillCurrent workspace probe do return {capture.record with complete := false}\\n  pure capture.record\\n\\ndef sourceMarker : String := \\\"EGGSHELL SOURCE\\\\n\\\"\\n\\ndef encode (record : Record) : String := sourceMarker ++ (toJson record).compress\\n\\ndef decode? (text : String) : Option Record := do\\n  if !text.startsWith sourceMarker then none else\\n    (Json.parse ((text.drop sourceMarker.length).copy) >>= fromJson?).toOption\\n\\n/-- Source certificates are separate Exact-only roots. Adding one never\\nchanges the identity of an observed Outcome or its semantic search terms. -/\\ndef receiptMarker : String := \\\"eggshell.source\\\"\\ndef receiptPurpose : String := \\\"observed dependency certificate\\\"\\n\\nstructure ReceiptFields (α : Type) where\\n  marker : α\\n  session : α\\n  turn : α\\n  tag : α\\n  owner : α\\n  data : α\\n  purpose : α\\n\\ndef receiptFields? {α : Type} (references : List (Authority × α)) : Option (ReceiptFields α) :=\\n  match Relation.exactValues references with\\n  | some [marker, session, turn, tag, owner, data, purpose] =>\\n      some ⟨marker, session, turn, tag, owner, data, purpose⟩\\n  | _ => none\\n\\ndef receiptArguments (session turn tag owner : Value) (record : Record) : List Ref :=\\n  [\\n    .exact (.text receiptMarker), .exact session, .exact turn, .exact tag,\\n    .exact owner, .exact (.text (encode record)), .exact (.text receiptPurpose)]\\n\\ndef receipt (session turn tag owner : Value) (record : Record) : Value :=\\n  .applyList .receipt (receiptArguments session turn tag owner record)\\n\\ntheorem receipt_owner_bound (session turn tag owner : Value) (record : Record) :\\n    (receiptFields? (receiptArguments session turn tag owner record)).map (·.owner) = some owner := by\\n  rfl\\n\\ndef receiptRecord? (owner value : Value) : Option Record := do\\n  match value with\\n  | .apply .receipt references =>\\n      let fields ← receiptFields? references.toList\\n      if fields.marker != .text receiptMarker || fields.purpose != .text receiptPurpose ||\\n          fields.owner != owner then none\\n      else match fields.data with\\n        | .atom bytes => String.fromUTF8? bytes >>= decode?\\n        | _ => none\\n  | _ => none\\n\\ntheorem receipt_other_owner_rejected (session turn tag owner other : Value) (record : Record)\\n    (different : owner ≠ other) :\\n    receiptRecord? other (receipt session turn tag owner record) = none := by\\n  simp [receiptRecord?, receipt, receiptArguments, receiptFields?, Relation.exactValues,\\n    Value.applyList, Refs.ofList, Refs.toList, Ref.exact, different]\\n\\n/-- Unknown is a real provenance state, not a successful check with no files. -/\\ndef unverified : Record := ⟨\\\"\\\", [], [], false, false⟩\\n\\nabbrev Ledger := Std.HashMap String (Option File)\\n\\ndef currentFiles? (ledger : Ledger) (files : List File) : Option (List File) :=\\n  files.mapM fun file => (ledger[file.relative]?).join\\n\\ndef recordAgrees (ledger : Ledger) (record : Record) : Bool :=\\n  (currentFiles? ledger record.files).any (agrees record)\\n\\nstructure Authorization (records : List Record) where\\n  ledger : Ledger\\n  nonempty : records ≠ []\\n  checked : ∀ record ∈ records, recordAgrees ledger record = true\\n\\ndef authorize? (records : List Record) (ledger : Ledger) : Option (Authorization records) :=\\n  if checked : (!records.isEmpty && records.all (recordAgrees ledger)) = true then\\n    some ⟨ledger, by\\n      intro empty\\n      simp [empty] at checked,\\n      List.all_eq_true.mp (Bool.and_eq_true_iff.mp checked).2⟩ else none\\n\\ntheorem authorization_uses_observed_ledger (records : List Record) (ledger : Ledger)\\n    (authorization : Authorization records)\\n    (accepted : authorize? records ledger = some authorization) :\\n    authorization.ledger = ledger := by\\n  unfold authorize? at accepted\\n  split at accepted\\n  · cases accepted\\n    rfl\\n  · contradiction\\n\\n/-- A currently named file/directory must occur in the selected sources under\\nthe same relative locator, not merely with a matching basename or bytes. -/\\ndef targetAgreement (targets : List String) (records : List Record) : Bool :=\\n  targets.all fun target => (records.flatMap (·.files)).any fun file =>\\n    file.relative == target || file.relative.startsWith (target ++ \\\"/\\\")\\n\\ntheorem target_agreement_has_each_locator (targets : List String) (records : List Record)\\n    (accepted : targetAgreement targets records = true) (target : String) (present : target ∈ targets) :\\n    ∃ file ∈ records.flatMap (·.files), file.relative == target ||\\n      file.relative.startsWith (target ++ \\\"/\\\") := by\\n  have covered := List.all_eq_true.mp accepted target present\\n  simpa only [List.any_eq_true] using covered\\n\\ndef workTargets? (workspace : System.FilePath) (work : String) : Option (List String) := do\\n  let lines := work.splitOn \\\"\\\\n\\\"\\n  let input ← (Json.parse (\\\"\\\\n\\\".intercalate lines.tail)).toOption\\n  let paths := inputPaths input\\n  if paths.isEmpty || !(urisFromInput input).isEmpty || paths.any isURI then none else do\\n    let directory ← inputDirectory? workspace input\\n    paths.mapM fun path => (relative? workspace directory path).map (·.text)\\n\\ntheorem authorization_has_current_dependencies (authorization : Authorization records)\\n    (record : Record) (present : record ∈ records) :\\n    ∃ current, currentFiles? authorization.ledger record.files = some current ∧\\n      record.valid = true ∧ current = record.files := by\\n  have accepted := authorization.checked record present\\n  cases observed : currentFiles? authorization.ledger record.files with\\n  | none => simp [recordAgrees, observed] at accepted\\n  | some current =>\\n      refine ⟨current, rfl, ?_⟩\\n      simpa [recordAgrees, observed, agrees] using accepted\\n\\ninductive ProbeStatus where\\n  | checked | unverified | timedOut\\n  deriving BEq, ToJson\\n\\ninductive RecordStatus where\\n  | matched | changed | unverified | timedOut | external\\n  deriving BEq, ToJson\\n\\nstructure FileCheck where\\n  relative : String\\n  status : ProbeStatus\\n  deriving ToJson\\n\\nstructure RecordCheck where\\n  ordinal : Nat\\n  status : RecordStatus\\n  deriving ToJson\\n\\nstructure Observation where\\n  ledger : Ledger\\n  files : Array FileCheck\\n  records : Array RecordCheck\\n  startedMs : Nat\\n  finishedMs : Nat\\n  deadlineMs : Nat\\n\\ndef Observation.receipt (observation : Observation) : Json := Json.mkObj [\\n  (\\\"startedMs\\\",toJson observation.startedMs),(\\\"finishedMs\\\",toJson observation.finishedMs),\\n  (\\\"deadlineMs\\\",toJson observation.deadlineMs),\\n  (\\\"elapsedMs\\\",toJson (observation.finishedMs-observation.startedMs)),\\n  (\\\"files\\\",toJson observation.files),(\\\"records\\\",toJson observation.records)]\\n\\ndef recordStatus (ledger : Ledger) (failures : Std.HashMap String ProbeStatus) (record : Record) : RecordStatus :=\\n  if !record.uris.isEmpty then .external\\n  else if !record.valid then .unverified\\n  else if recordAgrees ledger record then .matched\\n  else if record.files.any (fun file => (ledger[file.relative]?).join.any (· != file)) then .changed\\n  else if record.files.any (fun file => failures[file.relative]? == some .timedOut) then .timedOut\\n  else .unverified\\n\\ntheorem matched_status_has_checked_dependencies (ledger : Ledger)\\n    (failures : Std.HashMap String ProbeStatus) (record : Record)\\n    (matched : recordStatus ledger failures record = .matched) : recordAgrees ledger record = true := by\\n  unfold recordStatus at matched\\n  split at matched <;> try contradiction\\n  split at matched <;> try contradiction\\n  split at matched\\n  · assumption\\n  · split at matched <;> try contradiction\\n    split at matched <;> contradiction\\n\\ntheorem external_status_never_matches (ledger : Ledger)\\n    (failures : Std.HashMap String ProbeStatus) (record : Record)\\n    (external : record.uris.isEmpty = false) : recordStatus ledger failures record = .external := by\\n  simp [recordStatus,external]\\n\\n/-- Request-local observation is shared by all selected owners. A failed or\\nexpired probe stays unknown, independently of a definite changed fingerprint.\\nThe diagnostic states never populate the authorization ledger. -/\\ndef observeRecords (workspace : System.FilePath) (records : List Record) (deadline : Nat) :\\n    IO Observation := do\\n  let startedMs ← IO.monoMsNow\\n  let mut observations : Std.HashMap String (Option Probe) := {}\\n  let mut failures : Std.HashMap String ProbeStatus := {}\\n  for record in records do\\n    if !record.valid then continue\\n    for file in record.files do\\n      if observations.contains file.relative then continue\\n      let some relative := Relative.check? file.relative | continue\\n      let observed ← probe workspace relative deadline\\n      observations := observations.insert file.relative observed\\n      if observed.isNone then\\n        failures := failures.insert file.relative (if (← IO.monoMsNow) ≥ deadline then .timedOut else .unverified)\\n  let mut ledger : Ledger := {}\\n  for (relative, observed) in observations.toList do\\n    let checked ← checkedProbeFile workspace observed deadline\\n    ledger := ledger.insert relative checked\\n    if checked.isNone && !failures.contains relative then\\n      failures := failures.insert relative (if (← IO.monoMsNow) ≥ deadline then .timedOut else .unverified)\\n  let files := ledger.toArray.map fun (relative,current) =>\\n    ({relative,status := if current.isSome then .checked else failures[relative]?.getD .unverified} : FileCheck)\\n  return {\\n    ledger,files := files.qsort (fun a b => a.relative < b.relative)\\n    records := records.toArray.mapIdx (fun ordinal record => ⟨ordinal,recordStatus ledger failures record⟩)\\n    startedMs,finishedMs := ← IO.monoMsNow,deadlineMs := deadline}\\n\\n/-- Delivery status replaces the previous observation for the same selected\\nsource scope. Graph delivery and completion keys use separate namespaces. -/\\ndef deliveryScope? (key : String) : Option String :=\\n  match key.splitOn \\\":\\\" with\\n  | [\\\"s\\\", scope, status] => if scope.isEmpty || status.isEmpty then none else some scope\\n  | _ => none\\n\\nend Eggshell.SourceEvidence\\n\"],[\"FileSystem.lean\",\"module\\n\\npublic import Std\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\nnamespace Eggshell.FileSystem\\n\\ndef privateFile (path : System.FilePath) : IO Unit :=\\n  IO.setAccessRights path {\\n    user := { read := true, write := true }, group := {}, other := {} }\\n\\ndef privateDirectory (path : System.FilePath) : IO Unit := do\\n  IO.FS.createDirAll path\\n  IO.setAccessRights path {\\n    user := { read := true, write := true, execution := true }, group := {}, other := {} }\\n\\n/-- Permission and device failures are not evidence that a file is absent. -/\\ndef symlinkMetadata? (path : System.FilePath) : IO (Option IO.FS.Metadata) := do\\n  try pure (some (← path.symlinkMetadata))\\n  catch error => match error with\\n    | .noFileOrDirectory .. => pure none\\n    | _ => throw error\\n\\ndef rejectSymlinkAncestors (path : System.FilePath) : IO Unit := do\\n  let rec visit : Nat → System.FilePath → IO Unit\\n    | 0, _ => throw (IO.userError s!\\\"authority path is too deep: {path}\\\")\\n    | fuel + 1, current => do\\n        if let some metadata ← symlinkMetadata? current then\\n          if metadata.type == .symlink then\\n            throw (IO.userError s!\\\"authority path traverses a symbolic link: {current}\\\")\\n        match current.parent with\\n        | some parent => if parent == current then pure () else visit fuel parent\\n        | none => pure ()\\n  visit (path.toString.length + 1) path.normalize\\n\\ndef regularMetadata? (path : System.FilePath) : IO (Option IO.FS.Metadata) := do\\n  rejectSymlinkAncestors path\\n  match ← symlinkMetadata? path with\\n  | none => pure none\\n  | some metadata =>\\n      if metadata.type == .file then pure (some metadata)\\n      else throw (IO.userError s!\\\"Eggshell authority is not a regular file: {path}\\\")\\n\\nend Eggshell.FileSystem\\n\\nnamespace Eggshell.FileSystem\\n\\n/-- OS identity is a validation witness, never a portable memory key. -/\\nstructure ReadVersion where\\n  stamp : String\\n  bytes : Nat\\n  deriving Repr, DecidableEq, BEq, Lean.ToJson, Lean.FromJson\\n\\n/-- A regular, no-symlink file descriptor. The OS adapter owns its lifetime;\\nreads use explicit offsets and share neither a cursor nor a global lock. -/\\nopaque ReadHandle : Type\\n@[extern \\\"eggshell_read_open\\\"] opaque openRead (path : @& String) : IO ReadHandle\\n/-- A directory reached without following any symbolic-link ancestor. Its\\nnative descriptor is owned until this request-local object is released. -/\\nopaque ReadDirectory : Type\\n@[extern \\\"eggshell_read_directory_open\\\"] opaque openReadDirectory (path : @& String) : IO ReadDirectory\\n@[extern \\\"eggshell_read_open_at\\\"] opaque openReadAt (directory : @& ReadDirectory)\\n    (name : @& String) : IO ReadHandle\\n\\n@[extern \\\"eggshell_read_version\\\"] opaque readVersion (handle : @& ReadHandle) : IO ReadVersion\\n@[extern \\\"eggshell_read_page\\\"] private opaque readPageRaw (handle : @& ReadHandle)\\n    (offset : UInt64) (count : USize) : IO ByteArray\\n\\nstructure ReadSize where\\n  bytes : Nat\\n  bounded : bytes ≤ 4096\\n\\n/-- The native adapter accepts at most one page. Larger objects must use the\\nsame descriptor in bounded steps; a caller cannot silently exceed this API. -/\\nopaque readPage (handle : ReadHandle) (offset : UInt64) (count : ReadSize) : IO ByteArray :=\\n  readPageRaw handle offset count.bytes.toUSize\\n\\ntheorem ReadSize.native_bound (count : ReadSize) : count.bytes ≤ 4096 := count.bounded\\n\\n/-- An unbuffered, regular-file descriptor for the exclusively owned writer.\\nThe OS adapter checks the expected EOF before writing at explicit offsets.\\nAn IO failure cannot leave a stdio buffer to flush after ownership ends. -/\\nopaque AppendHandle : Type\\n@[extern \\\"eggshell_append_open\\\"] opaque openAppend (path : @& String) : IO AppendHandle\\n@[extern \\\"eggshell_append_write\\\"] opaque appendAt (handle : @& AppendHandle)\\n    (offset : UInt64) (bytes : @& ByteArray) : IO Unit\\n@[extern \\\"eggshell_append_sync\\\"] opaque syncAppend (handle : @& AppendHandle) : IO Unit\\n@[extern \\\"eggshell_append_close\\\"] opaque closeAppend (handle : @& AppendHandle) : IO Unit\\n\\n/-- Non-waiting advisory reader-cohort guards on securely opened files.\\nThe OS releases these locks on descriptor close, including process death. -/\\n@[extern \\\"eggshell_read_try_lock\\\"] opaque tryReadLock (handle : @& ReadHandle)\\n    (exclusive : Bool) : IO Bool\\n@[extern \\\"eggshell_read_unlock\\\"] opaque unlockRead (handle : @& ReadHandle) : IO Unit\\n\\n/-- Atomic no-replacement rename of a completed DB directory. Parent\\nresolution and fsync use held descriptors at the native boundary. -/\\n@[extern \\\"eggshell_publish_directory\\\"] opaque publishDirectory\\n    (source target : @& String) : IO Unit\\n\\nstructure PruneSize where\\n  entries : Nat\\n  bounded : 0 < entries ∧ entries ≤ 128\\n\\n@[extern \\\"eggshell_prune_directory\\\"] private opaque pruneDirectoryRaw\\n    (path : @& String) (entries : USize) : IO Bool\\n\\n/-- One bounded, descriptor-relative step over an already retired derived\\ndirectory. Leaf symlinks are unlinked; directory links are never followed. -/\\nopaque pruneDirectory (path : String) (count : PruneSize) : IO Bool :=\\n  pruneDirectoryRaw path count.entries.toUSize\\n\\n/-- Shrink to the caller's committed boundary iff the descriptor still has the\\nexpected EOF, then fsync. The caller must hold exclusive writer ownership. -/\\n@[extern \\\"eggshell_append_truncate\\\"] opaque truncateAppend (handle : @& AppendHandle)\\n    (expectedEnd retainedEnd : UInt64) : IO Unit\\n\\n/-- The complete bytes must come from the still-current file object. -/\\ndef stableRead (before after current : ReadVersion) (bytes : Nat) : Bool :=\\n  decide (before = after) && decide (after = current) && decide (bytes = current.bytes)\\n\\ntheorem stable_read_identity {before after current : ReadVersion} {bytes : Nat}\\n    (accepted : stableRead before after current bytes = true) :\\n    before = after ∧ after = current ∧ bytes = current.bytes := by\\n  simpa [stableRead, and_assoc] using accepted\\n\\ntheorem replaced_read_rejected {before after current : ReadVersion} (bytes : Nat)\\n    (replaced : after ≠ current) : stableRead before after current bytes = false := by\\n  simp [stableRead, replaced]\\n\\ntheorem mutated_read_rejected {before after current : ReadVersion} (bytes : Nat)\\n    (mutated : before ≠ after) : stableRead before after current bytes = false := by\\n  simp [stableRead, mutated]\\n\\n/-- Native filesystem primitive: Lean does not expose POSIX fsync. -/\\n@[extern \\\"eggshell_sync_path\\\"] opaque syncPath (path : @& String)\\n    (directory : Bool) : IO Unit\\n\\ndef directoryWithin : Nat → System.FilePath → IO Unit\\n  | 0, _ => throw (IO.userError \\\"directory ancestor traversal did not terminate\\\")\\n  | fuel + 1, path => do\\n    FileSystem.rejectSymlinkAncestors path\\n    let existed ← path.isDir\\n    if !existed then\\n      if let some parent := path.parent then\\n        if parent != path && !(← parent.isDir) then directoryWithin fuel parent\\n      FileSystem.privateDirectory path\\n      syncPath path.toString true\\n      if let some parent := path.parent then syncPath parent.toString true\\n\\ndef durableDirectory (path : System.FilePath) : IO Unit :=\\n  directoryWithin (path.toString.length + 1) path.normalize\\n\\n/-- The writers and streaming directory readers share one namespace for\\nobjects which have not reached their atomic publication point. -/\\ninductive PublicationKind where\\n  | replace\\n  | immutable\\n  deriving BEq, DecidableEq, Repr\\n\\ndef publicationTemporary (kind : PublicationKind) (suffix : String) : String :=\\n  (match kind with | .replace => \\\".egg-tmp-\\\" | .immutable => \\\".egg-object-\\\") ++ suffix\\n\\ndef isPublicationTemporary (name : String) : Bool :=\\n  name.startsWith \\\".egg-tmp-\\\" || name.startsWith \\\".egg-object-\\\"\\n\\ntheorem publication_temporary_recognized (kind : PublicationKind) (suffix : String) :\\n    isPublicationTemporary (publicationTemporary kind suffix) = true := by\\n  cases kind <;> simp [publicationTemporary, isPublicationTemporary]\\n\\nprivate opaque PublicationHandle : Type\\n@[extern \\\"eggshell_publication_open\\\"] private opaque openPublication\\n    (path temporary : @& String) : IO PublicationHandle\\n@[extern \\\"eggshell_publication_write\\\"] private opaque writePublication\\n    (handle : @& PublicationHandle) (bytes : @& ByteArray) : IO Unit\\n@[extern \\\"eggshell_publication_sync_data\\\"] private opaque syncPublicationData\\n    (handle : @& PublicationHandle) : IO Unit\\n@[extern \\\"eggshell_publication_install\\\"] private opaque installPublication\\n    (handle : @& PublicationHandle) (immutable : Bool) : IO Bool\\n@[extern \\\"eggshell_publication_target\\\"] private opaque readPublicationTarget\\n    (handle : @& PublicationHandle) : IO ReadHandle\\n@[extern \\\"eggshell_publication_sync_parent\\\"] private opaque syncPublicationParent\\n    (handle : @& PublicationHandle) : IO Unit\\n@[extern \\\"eggshell_publication_close\\\"] private opaque closePublication\\n    (handle : @& PublicationHandle) : IO Unit\\n\\n/-- One securely opened parent and one exclusively created temporary file.\\nThe indexed phases make the executed write/sync/install order mandatory. OS\\ndescriptor identity, fsync and namespace atomicity remain native premises. -/\\nprivate inductive PublicationPhase where\\n  | opened | written | synced | installed | durable\\n\\ninductive PublicationBoundary where\\n  | written | synced | installed | durable\\n  deriving BEq, DecidableEq, Repr\\n\\n/-- Agreement is about the same current file object and exact bytes, never\\nonly a name, hash or matching length. This is the immutable collision gate. -/\\ndef publicationAgreement (before after current : ReadVersion)\\n    (existing expected : ByteArray) : Bool :=\\n  stableRead before after current existing.size && decide (existing = expected)\\n\\ntheorem publication_agreement_exact {before after current : ReadVersion}\\n    {existing expected : ByteArray}\\n    (accepted : publicationAgreement before after current existing expected = true) :\\n    before = after ∧ after = current ∧ existing = expected ∧ expected.size = current.bytes := by\\n  have parts : stableRead before after current existing.size = true ∧ existing = expected := by\\n    simpa [publicationAgreement] using accepted\\n  obtain ⟨same, now, sized⟩ := stable_read_identity parts.1\\n  exact ⟨same, now, parts.2, parts.2 ▸ sized⟩\\n\\ntheorem publication_replacement_rejected {before after current : ReadVersion}\\n    (existing expected : ByteArray) (replaced : after ≠ current) :\\n    publicationAgreement before after current existing expected = false := by\\n  simp [publicationAgreement, replaced_read_rejected existing.size replaced]\\n\\nprivate structure Publication (path : System.FilePath) (bytes : ByteArray)\\n    (phase : PublicationPhase) where\\n  mk ::\\n  handle : PublicationHandle\\n\\nprivate def Publication.write (publication : Publication path bytes .opened) :\\n    IO (Publication path bytes .written) := do\\n  writePublication publication.handle bytes\\n  pure ⟨publication.handle⟩\\n\\nprivate def Publication.syncData (publication : Publication path bytes .written) :\\n    IO (Publication path bytes .synced) := do\\n  syncPublicationData publication.handle\\n  pure ⟨publication.handle⟩\\n\\nprivate def Publication.install (publication : Publication path bytes .synced)\\n    (kind : PublicationKind) : IO (Publication path bytes .installed × Bool) := do\\n  let created ← installPublication publication.handle (kind == .immutable)\\n  pure (⟨publication.handle⟩, created)\\n\\nprivate def Publication.syncParent (publication : Publication path bytes .installed) :\\n    IO (Publication path bytes .durable) := do\\n  syncPublicationParent publication.handle\\n  pure ⟨publication.handle⟩\\n\\nprivate def Publication.agree (publication : Publication path bytes .installed) : IO Unit := do\\n  let target ← readPublicationTarget publication.handle\\n  let before ← readVersion target\\n  unless before.bytes == bytes.size do\\n    throw (IO.userError \\\"immutable object collision or concurrent replacement\\\")\\n  let mut existing := ByteArray.empty\\n  while existing.size < bytes.size do\\n    let count := min 4096 (bytes.size - existing.size)\\n    let part ← readPage target existing.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    unless part.size == count do\\n      throw (IO.userError \\\"immutable object collision or concurrent replacement\\\")\\n    existing := existing ++ part\\n  let after ← readVersion target\\n  let current ← readVersion (← readPublicationTarget publication.handle)\\n  unless publicationAgreement before after current existing bytes do\\n    throw (IO.userError \\\"immutable object collision or concurrent replacement\\\")\\n\\nprivate def publishExistingBytes (kind : PublicationKind) (path : System.FilePath)\\n    (bytes : ByteArray) (observe : PublicationBoundary → IO Unit) : IO Unit := do\\n  let temporary := publicationTemporary kind s!\\\"{← IO.Process.getPID}-{← IO.monoNanosNow}\\\"\\n  let initial : Publication path bytes .opened := ⟨← openPublication path.toString temporary⟩\\n  try\\n    let written ← initial.write\\n    observe .written\\n    let synced ← written.syncData\\n    observe .synced\\n    let (installed, created) ← synced.install kind\\n    if kind == .immutable && !created then installed.agree\\n    observe .installed\\n    let _ ← installed.syncParent\\n    observe .durable\\n    pure ()\\n  finally closePublication initial.handle\\n\\nprivate def publishBytes (kind : PublicationKind) (path : System.FilePath)\\n    (bytes : ByteArray) (observe : PublicationBoundary → IO Unit) : IO Unit := do\\n  durableDirectory (path.parent.getD \\\".\\\")\\n  publishExistingBytes kind path bytes observe\\n\\n/-- Never recreate an owner which was
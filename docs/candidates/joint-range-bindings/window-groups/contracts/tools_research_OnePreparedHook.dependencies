    | .branch children =>\\n          let mut groups : Std.HashMap Nat (PageMap.Ref × List String) := {}\\n          for name in inside do\\n            match PageMap.route children name with\\n            | none => values := values.insert name (.error (IO.userError \\\"empty branch\\\"))\\n            | some (ordinal,child) =>\\n                let before := (groups[ordinal]?.map Prod.snd).getD []\\n                groups := groups.insert ordinal (child,name :: before)\\n          for (_,child,requested) in groups.toList do\\n            if _smaller : child.height < ref.height then\\n              let next ← getManyAt snapshot child requested\\n              for (name,value) in next.toList do values := values.insert name value\\n            else\\n              for name in requested do\\n                values := values.insert name (.error (IO.userError \\\"index height did not decrease\\\"))\\n      return values\\ntermination_by ref.height\\n\\ndef batchLimit : Nat := 1024\\n\\nstructure Batch where\\n  snapshot : PageMap.Snapshot\\n  names : List String\\n  bounded : names.length ≤ batchLimit\\n  values : Captured\\n\\n/-- A batch is bounded independently of total DB size. It shares the immutable\\nroot, original page authentication and physical counters, without recording\\nspeculative reads as logical memo dependencies. No whole namespace is loaded. -/\\ndef load (snapshot : PageMap.Snapshot) (names : List String) : IO Batch := do\\n  if bounded : names.length ≤ batchLimit then\\n    let quiet ← PageMap.QuietReader.make snapshot\\n    let values ← match snapshot.head.root with\\n      | none => pure (names.foldl (fun values name => values.insert name (.ok none)) {})\\n      | some root => getManyAt quiet.snapshot root names\\n    return ⟨snapshot,names,bounded,values⟩\\n  else throw (IO.userError \\\"lexical point batch exceeds its key bound\\\")\\n\\ndef Batch.read (batch : Batch) (name : String) : IO (Option ByteArray) := do\\n  let some captured := batch.values[name]? |\\n    throw (IO.userError \\\"lexical lookup escaped its requested point batch\\\")\\n  let value ← match captured with\\n    | .error error => throw error\\n    | .ok value => pure value\\n  batch.snapshot.observe (.point name value)\\n  return value\\n\\ntheorem Batch.keys_bounded (batch : Batch) : batch.names.length ≤ batchLimit := batch.bounded\\n\\nstructure Metrics where\\n  preparationMs : Nat := 0\\n  batches : Nat := 0\\n  requestedKeys : Nat := 0\\n  largestBatch : Nat := 0\\n  postingCalls : Nat := 0\\n  postingRows : Nat := 0\\n  postingMs : Nat := 0\\n  validatedOwners : Nat := 0\\n  validationHits : Nat := 0\\n  ordinalHits : Nat := 0\\n  deriving ToJson\\n\\n/-- The ordinary source-counter decoder, factored without changing its\\nmissing-value or malformed-tail behavior. -/\\ndef counterValue (data : Option ByteArray) : Except String Nat := do\\n  let some bytes := data | return 0\\n  let (value,tail) ← Wire.natural.decode bytes.toList\\n  unless tail.isEmpty do throw \\\"trailing bytes in DB counter\\\"\\n  return value\\n\\n/-- These are the actual retained bytes of all three original checks. A\\nrequest-local entry cannot merely assert an ordinal or a live-owner flag. -/\\nstructure OwnerWitness where\\n  ordinal : Nat\\n  indexed : Option ByteArray\\n  member : Option ByteArray\\n  candidate : Option ByteArray\\n  indexedExact : payloadSize indexed = .ok ordinal\\n  memberExact : payloadSize member = .ok ordinal\\n  candidateExact : counterValue candidate = .ok 1\\n\\ndef OwnerWitness.check? (ordinal : Nat) (indexed member candidate : Option ByteArray) :\\n    Option OwnerWitness := do\\n  match indexedExact : payloadSize indexed with\\n  | .error _ => none\\n  | .ok original =>\\n    if same : original = ordinal then\\n      match memberExact : payloadSize member with\\n      | .error _ => none\\n      | .ok current =>\\n        if sameMember : current = ordinal then\\n          match candidateExact : counterValue candidate with\\n          | .ok 1 => some ⟨ordinal,indexed,member,candidate,\\n              by simpa only [same] using indexedExact,\\n              by simpa only [sameMember] using memberExact,candidateExact⟩\\n          | _ => none\\n        else none\\n    else none\\n\\ntheorem OwnerWitness.original_checks (witness : OwnerWitness) :\\n    payloadSize witness.indexed = .ok witness.ordinal ∧\\n    payloadSize witness.member = .ok witness.ordinal ∧\\n    counterValue witness.candidate = .ok 1 :=\\n  ⟨witness.indexedExact,witness.memberExact,witness.candidateExact⟩\\n\\ndef observe (source : PageMap.Snapshot) (receipt : Option String) (metrics : Metrics) : IO Unit :=\\n  Receipt.observe receipt (\\\"lexical-reads-\\\" ++ source.head.identity) (toJson metrics)\\n\\n/-- Every check from Reader.posting remains, on original pinned values. Only\\nrequested posting owners are batched; results are consumed in original order.\\nThis creates no Work, Match, Union or completed authority. -/\\ndef postingWith (reader : RetrievalResearch.Index.Reader source)\\n    (known : IO.Ref (Std.HashMap Nat OwnerWitness))\\n    (metrics : IO.Ref Metrics)\\n    (receipt : Option String) (unit : String) : IO (List Nat × Nat) := do\\n  let started ← IO.monoMsNow\\n  let some term ← findTerm? reader.index reader.index.get unit | return ([],0)\\n  let rows ← directory reader.index (key \\\"posting\\\" term.id)\\n  let count ← getNat reader.index.get (key \\\"frequency\\\" term.id)\\n  unless rows.length == count do throw (IO.userError \\\"lexical posting frequency disagrees\\\")\\n  let mut remaining := rows\\n  while !remaining.isEmpty do\\n    let selected := remaining.take (batchLimit / 2)\\n    remaining := remaining.drop (batchLimit / 2)\\n    let captured ← known.get\\n    let missing := selected.filter (fun (_,owner) => !captured.contains owner)\\n    let begin ← IO.monoMsNow\\n    let indexed ← load reader.index (missing.map fun (_,owner) => key \\\"owner\\\" owner)\\n    let live ← load source (missing.flatMap fun (_,owner) => [key \\\"member\\\" owner,key \\\"candidate\\\" owner])\\n    let elapsed := (← IO.monoMsNow)-begin\\n    metrics.modify fun before => {before with\\n      preparationMs := before.preparationMs+elapsed\\n      batches := before.batches+2\\n      requestedKeys := before.requestedKeys+indexed.names.length+live.names.length\\n      largestBatch := max before.largestBatch (max indexed.names.length live.names.length)}\\n    for (ordinal,owner) in selected do\\n      if let some previous := (← known.get)[owner]? then\\n        -- Replay the original logical reads, even after a trace reset. A\\n        -- conflicting posting still observes all three points before its\\n        -- Boolean rejection, exactly as the original monadic reader does.\\n        reader.index.observe (.point (key \\\"owner\\\" owner) previous.indexed)\\n        source.observe (.point (key \\\"member\\\" owner) previous.member)\\n        source.observe (.point (key \\\"candidate\\\" owner) previous.candidate)\\n        unless previous.ordinal == ordinal do\\n          throw (IO.userError \\\"lexical posting names a different live source owner\\\")\\n        metrics.modify fun before => {before with validationHits := before.validationHits+1}\\n      else\\n        let indexBytes ← indexed.read (key \\\"owner\\\" owner)\\n        let indexValue ← IO.ofExcept (payloadSize indexBytes)\\n        let memberBytes ← live.read (key \\\"member\\\" owner)\\n        let memberValue ← IO.ofExcept (payloadSize memberBytes)\\n        let candidateBytes ← live.read (key \\\"candidate\\\" owner)\\n        let candidateValue ← getNat (fun _ => pure candidateBytes) (key \\\"candidate\\\" owner)\\n        unless indexValue == ordinal && memberValue == ordinal && candidateValue == 1 do\\n          throw (IO.userError \\\"lexical posting names a different live source owner\\\")\\n        let some checked := OwnerWitness.check? ordinal indexBytes memberBytes candidateBytes |\\n          throw (IO.userError \\\"lexical owner witness disagrees with its validated bytes\\\")\\n        known.modify (·.insert owner checked)\\n        metrics.modify fun before => {before with validatedOwners := before.validatedOwners+1}\\n  let elapsed := (← IO.monoMsNow)-started\\n  metrics.modify fun before => {before with\\n    postingCalls := before.postingCalls+1\\n    postingRows := before.postingRows+rows.length\\n    postingMs := before.postingMs+elapsed}\\n  observe source receipt (← metrics.get)\\n  return (rows.map Prod.snd,count)\\n\\ndef posting (reader : RetrievalResearch.Index.Reader source) (metrics : IO.Ref Metrics)\\n    (receipt : Option String) (unit : String) : IO (List Nat × Nat) := do\\n  postingWith reader (← IO.mkRef {}) metrics receipt unit\\n\\nstructure Query where\\n  posting : String → IO (List Nat × Nat)\\n  ordinal : Nat → IO Nat\\n  report : IO Unit := pure ()\\n\\n/-- One immutable source/index pair owns this cache. It never crosses a\\nrequest boundary. Ranking reuses the member bytes already checked above. -/\\ndef query (reader : RetrievalResearch.Index.Reader source) (receipt : Option String := none) :\\n    IO Query := do\\n  let known ← IO.mkRef ({} : Std.HashMap Nat OwnerWitness)\\n  let metrics ← IO.mkRef ({} : Metrics)\\n  return {\\n    posting := postingWith reader known metrics receipt\\n    ordinal := fun owner => do\\n      let some checked := (← known.get)[owner]? |\\n        throw (IO.userError \\\"lexical ordinal was not validated by this request\\\")\\n      source.observe (.point (key \\\"member\\\" owner) checked.member)\\n      metrics.modify fun before => {before with ordinalHits := before.ordinalHits+1}\\n      return checked.ordinal\\n    report := do observe source receipt (← metrics.get) }\\n\\ndef make (reader : RetrievalResearch.Index.Reader source) (receipt : Option String := none) :\\n    IO (String → IO (List Nat × Nat)) := do\\n  return (← query reader receipt).posting\\n\\ndef strictLookup (source : PageMap.Snapsho
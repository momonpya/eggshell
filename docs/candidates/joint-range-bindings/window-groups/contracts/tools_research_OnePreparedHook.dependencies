us => previous.join (.one position))\\n\\ntheorem Trie.observe_size (trie : Trie) (state : State) (position : Position) (text : String) :\\n    (trie.observe state position text).size = state.size := by\\n  simp only [observe]\\n  split <;> simp\\n\\ntheorem Trie.find_checked (trie : Trie) (text : String) (node : Nat)\\n    (found : trie.find? text = some node) : trie.key? node = some text := by\\n  cases vacant : text.isEmpty with\\n  | true => simp [find?,vacant] at found\\n  | false =>\\n    cases traced : text.toList.reverse.foldlM (fun node char => trie.edges[(node,char)]?) 0 with\\n    | none => simp [find?,vacant,traced] at found\\n    | some selected =>\\n      simp [find?,vacant,traced] at found\\n      simpa [found.2] using found.1\\n\\ndef Trie.selected? (trie : Trie) (state : State) (output : Output) : Option (Position × Nat) := Id.run do\\n  let mut node := 0\\n  let mut depth := 0\\n  let characters := output.text.toList.toArray\\n  let mut found : Option (Candidate × Nat) := none\\n  for char in output.text.toList.reverse do\\n    let some next := trie.edges[(node,char)]? | break\\n    node := next\\n    depth := depth+1\\n    let candidate := state[node]?.getD .absent\\n    let expected := fun _ => String.ofList (characters.extract (characters.size-depth) characters.size).toList\\n    if candidate != .absent && trie.key? node == some (expected ()) then\\n      found := some (candidate,depth)\\n  match found with\\n  | some (.one position,count) => return some (position,count)\\n  | _ => return none\\n\\ndef escapedWidth (text : String) : Nat := (toJson text).compress.length-2\\n\\ndef alias? (inputs : Array SourceEvidence.File) (characters : Array Char) (output : Output)\\n    (position : Position) (chars : Nat) : Option Alias := do\\n  let file ← inputs[position.1]?\\n  let content ← file.content\\n  if chars == 0 || output.text.length < chars || position.2 == 0 then none else do\\n    let code := suffix output.text chars\\n    let preceding := String.ofList (output.text.toList.take (output.text.length-chars))\\n    let encoded := match output.spelling.projection with\\n      | .string | .stringBody | .stringBodyLine => true\\n      | _ => false\\n    let base := output.spelling.first + if output.spelling.projection == .string then 1 else 0\\n    let first := base + if encoded then escapedWidth preceding else preceding.length\\n    let limit := first + if encoded then escapedWidth code else code.length\\n    let literal := String.ofList (characters.extract first limit).toList\\n    let expected := if encoded then String.ofList ((toJson code).compress.toList.drop 1 |>.dropLast) else code\\n    if first < limit && limit ≤ output.spelling.limit && literal == expected then\\n      some ⟨⟨file.relative,content.root,content.bytes⟩,position.2,output.spelling,chars,first,limit⟩\\n    else none\\n\\n/-- JSON leaves and a general literal lexer supply path hints. The executable\\nname is not a discriminator. Only regular files inside the workspace survive;\\nthese hints never establish complete execution dependencies. -/\\npartial def inputStrings : Json → Array String\\n  | .str value => #[value]\\n  | .arr values => values.flatMap inputStrings\\n  | .obj values => values.toArray.flatMap (inputStrings ∘ Prod.snd)\\n  | _ => #[]\\n\\ndef candidates (workspace : System.FilePath) (input : Json) : Array SourceEvidence.Relative := Id.run do\\n  let some directory := SourceEvidence.inputDirectory? workspace input | return #[]\\n  let mut result := #[]\\n  let mut seen : Std.HashSet String := {}\\n  for value in inputStrings input do\\n    for word in #[value] ++ ((shellWords value).toOption.getD #[]) do\\n      if word.contains \\\"://\\\" then continue\\n      let some relative := SourceEvidence.relative? workspace directory word | continue\\n      if seen.contains relative.text then continue\\n      seen := seen.insert relative.text\\n      result := result.push relative\\n  return result\\n\\ndef captureInputs (workspace :
IO.userError s!\\\"{name} must be an absolute path\\\")\\n    pure (some path.normalize)\\n\\ndef home : IO System.FilePath := do\\n  match ← absoluteEnvironment \\\"HOME\\\" with\\n  | some home => pure home\\n  | none => throw (IO.userError \\\"EGGSHELL_PREFIX and HOME are unavailable\\\")\\n\\n/-- Root of the relocatable Eggshell installation, independent of `CODEX_HOME`. -/\\ndef installRoot : IO System.FilePath := do\\n  match ← absoluteEnvironment \\\"EGGSHELL_PREFIX\\\" with\\n  | some root => pure root\\n  | none => pure ((← home) / \\\".local\\\")\\n\\ndef dataRoot : IO System.FilePath := do\\n  match ← absoluteEnvironment \\\"EGGSHELL_DATA_ROOT\\\" with\\n  | some root => pure root\\n  | none => pure ((← installRoot) / \\\"share\\\" / \\\"eggshell\\\" / \\\"plugin\\\")\\n\\ndef globalConfig : IO System.FilePath := do\\n  pure ((← installRoot) / \\\"config\\\" / \\\"eggshell\\\" / \\\"config.toml\\\")\\n\\nend Eggshell.Paths\\n\",[]]"],["Eggshell.Persistence","[\"module\\n\\npublic import Eggshell.GraphStore\\n\\n@[expose] public section\\nnamespace Eggshell.Persistence\\nopen Lean\\n\\n/-- Normal storage is the page DB. Whole-graph materialization is an explicit\\ninspection path; promotion and indexing use selective snapshots below. -/\\ndef loadExisting? (path : System.FilePath) : IO (Option Graph) := do\\n  match ← DB.PageMap.open? path with\\n  | none => pure none\\n  | some snapshot => some <$> Store.materialize snapshot\\n\\ndef load (path : System.FilePath) : IO Graph := do\\n  let some graph ← loadExisting? path | throw (IO.userError \\\"memory DB does not exist\\\")\\n  pure graph\\n\\ndef freshAuthority : IO Value := do\\n  pure (.text (\\\"egg authority \\\" ++ Blake3.hex (← IO.getRandomBytes 32)))\\n\\ndef ensureSnapshot (path : System.FilePath) : IO Store.Snapshot := do\\n  match ← DB.PageMap.open? path with\\n  | some snapshot => pure snapshot\\n  | none =>\\n      let authority ← freshAuthority\\n      DB.PageMap.create path (valueToJson authority).compress\\n\\n/-- Explicit graph import/administrative replacement. Payload and indexes are\\npublished under one root. Ordinary hooks do not call a full-graph save. -/\\ndef saveAtomic (path : System.FilePath) (graph : Graph) : IO Unit := do\\n  let snapshot ← match ← DB.PageMap.open? path with\\n    | some snapshot => pure snapshot\\n    | none => DB.PageMap.create path (valueToJson graph.authority).compress\\n  unless (← Store.authority snapshot) == graph.authority do\\n    throw (IO.userError \\\"graph belongs to another authority\\\")\\n  let _ ← DB.PageMap.withWriter snapshot fun writer => do\\n    let intern : Store.Intern := ⟨writer, ← IO.mkRef {}⟩\\n    let previous ← Store.rootIds snapshot\\n    let desired ← graph.values.mapM intern.value\\n    let removed := previous.filter (!desired.contains ·)\\n    let added := desired.filter (!previous.contains ·)\\n    -- Keep one stable authoritative insertion order. A caller asking for a\\n    -- different tie order is rejected rather than silently changing it.\\n    unless desired == previous.filter desired.contains ++ added do\\n      throw (IO.userError \\\"administrative replacement changed the retained root order\\\")\\n    for id in removed do Store.removeRoot writer id\\n    for value in graph.values do let _ ← intern.root value; pure ()\\n    let oldPairs ← Store.unionPairs snapshot\\n    let newPairs ← graph.unions.mapM fun edge => do\\n      pure (← intern.value edge.edge.left, ← intern.value edge.edge.right)\\n    let unionsChanged := oldPairs != newPairs\\n    if unionsChanged then\\n      for (ordinal, (left, right)) in (← Store.unionDirectory snapshot) do\\n        writer.put (Store.unionPairKey left right) none\\n        writer.put (Store.key \\\"union\\\" ordinal) none\\n      for (left, right) in oldPairs do\\n        let left ← Store.readNode snapshot snapshot.get left\\n        let right ← Store.readNode snapshot snapshot.get right\\n        writer.put (\\\"unionKey:\\\" ++ Store.unionDisplayKey left right) none\\n      Store.putNat writer \\\"unions\\\" 0\\n      Store.addUnions intern (graph.unions.map (·.edge))\\n    if !added.isEmpty || !removed.isEmpty || unionsChanged then\\n      Store.writeChange writer {added,removed,unionsChanged}\\n  pure ()\\n\\ndef lockPath (path : System.FilePath) : System.FilePath :=\\n  .mk (path.toString ++ \\\".guard\\\")\\n\\ndef acquireLock (handle : IO.FS.Handle) (path : System.FilePath) : Nat → IO Unit\\n  | 0 => throw (IO.userError s!\\\"timed out waiting for {lockPath path}\\\")\\n  | retries + 1 =>\\n      do\\n        if ← handle.tryLock then return\\n        IO.sleep 5\\n        acquireLock handle path retries\\n\\ndef withLockAcquisition (path : System.FilePath)\\n    (acquire : IO.FS.Handle → IO Unit) (action : IO α) : IO α := do\\n  rejectSymlinkAncestors path\\n  -- A kernel-owned lock is released even if its owner is killed. Never unlink\\n  -- this file: doing so would create two independent lock inodes.\\n  let guard := lockPath path\\n  rejectSymlinkAncestors guard\\n  if let some parent := guard.parent then\\n    if !(← parent.pathExists) then privateDirectory parent\\n  let handle ← IO.FS.Handle.mk guard .append\\n  privateFile guard\\n  acquire handle\\n  try\\n    action\\n  finally\\n    handle.unlock\\n\\ndef withLockWithin (path : System.FilePath) (waitMs : Nat) (action : IO α) : IO α :=\\n  withLockAcquisition path (fun handle => acquireLock handle path (waitMs / 5 + 1)) action\\n\\n/-- A native request spends its existing absolute deadline while waiting for\\nmetadata. A busy sibling must not turn a 100ms admission cutoff into lost\\ningress. An expired request cannot start its protected action. -/\\npartial def acquireLockUntil (handle : IO.FS.Handle) (path : System.FilePath)\\n    (deadline : Nat) : IO Unit := do\\n  let now ← IO.monoMsNow\\n  unless now < deadline do throw (IO.userError s!\\\"timed out waiting for {lockPath path}\\\")\\n  if ← handle.tryLock then return\\n  IO.sleep (UInt32.ofNat (min 5 (deadline-now)))\\n  acquireLockUntil handle path deadline\\n\\ndef withLockUntil (path : System.FilePath) (deadline : Nat) (action : IO α) : IO α :=\\n  withLockAcquisition path (fun handle => acquireLockUntil handle path deadline) action\\n\\ndef withLock (path : System.FilePath) (action : IO α) : IO α :=\\n  withLockWithin path 1000 action\\n\\ndef create (path : System.FilePath) : IO Graph :=\\n  withLock path do\\n    if (← FileSystem.symlinkMetadata? path).isSome then\\n      throw (IO.userError \\\"memory DB already exists\\\")\\n    Store.header (← ensureSnapshot path)\\n\\n/-- Returned only after the page extent and its root have been durably published. -/\\nstructure Publication (α : Type) where\\n  graph : Graph\\n  value : α\\n  head : DB.PageMap.Head\\n\\n/-- The turn compiler receives only the current authority/revision. Existing\\nroot membership and frequency updates are resolved by point lookup, rather\\nthan loading the old graph to filter a newly compiled turn. The returned view\\ncontains the submitted, now-published roots; it is not the entire database. -/\\ndef appendPrepared (path : System.FilePath)\\n    (prepare : Graph → Except String (Transaction × α))\\n    (stage : Store.Intern → α → IO Store.MetadataChange := fun _ _ => pure {}) : IO (Publication α) :=\\n  withLock path do\\n    let snapshot ← ensureSnapshot path\\n    let header ← Store.header snapshot\\n    let (transaction, result) ← IO.ofExcept (prepare header)\\n    unless transaction.appliesTo header do throw (IO.userError \\\"stale DB transaction\\\")\\n    let (_, head, _) ← DB.PageMap.withWriter snapshot fun writer => do\\n      let intern : Store.Intern := ⟨writer, ← IO.mkRef {}⟩\\n      let mut added := []\\n      for value in transaction.stagedValues do\\n        let id ← intern.value value\\n        let fresh := (← writer.get (Store.key \\\"member\\\" id)).isNone\\n        let _ ← intern.root value\\n        if fresh then added := id :: added\\n      let oldUnions ← Store.getNat writer.get \\\"unions\\\"\\n      Store.addUnions intern (transaction.stagedUnions.map (·.edge))\\n      let unionsChanged := (← Store.getNat writer.get \\\"unions\\\") != oldUnions\\n      let metadataChanged ← stage intern result\\n      if !added.isEmpty || unionsChanged || metadataChanged.changed || !metadataChanged.affected.isEmpty then\\n        Store.writeChange writer {\\n          added := added.reverse,removed := [],unionsChanged\\n          affected := hashDistinct metadataChanged.affected}\\n    let values := transaction.stagedValues\\n    let publication : Graph := {\\n      authority := header.authority\\n      revision := head.revision\\n      values := values\\n      unions := []\\n      values_wellFormed := transaction.stagedValues_wellFormed }\\n    pure ⟨publication,result,head⟩\\n\\nstructure Composite where\\n  values : List Value\\n  unions : List UnionEdge\\n  authorities : List Value\\n  origins : List (Value × Value)\\n  unionOrigins : List (UnionEdge × Value)\\n  deriving DecidableEq\\n\\ndef Composite.authoritiesFor (composite : Composite) (value : Value) : List Value :=\\n  (composite.origins.filterMap fun (candidate, authority) =>\\n    if candidate = value then some authority else none\\n  ).eraseDups\\n\\ndef loadComposite (paths : List System.FilePath) : IO Composite := do\\n  let graphs := (← paths.mapM loadExisting?).filterMap id\\n  pure {\\n    values := graphs.flatMap (·.values) |>.eraseDups\\n    unions := graphs.flatMap fun graph => graph.unions.map (·.edge)\\n    authorities := graphs.map (·.authority)\\n    origins := graphs.flatMap fun graph => graph.values.map (fun value =>\\n      (value, graph.authority))\\n    unionOrigins := graphs.flatMap fun graph => graph.unions.map (fun persistent =>\\n      (persistent.edge, graph.authority))\\n  }\\n\\n/-- Deliberate fixture/exchange import, never an automatic read fallback. -/\\ndef importGraphFile (source destination : System.FilePath) : IO Unit :=\\n  withLock destination do\\n    if (← FileSystem.symlinkMetadata? destination).isSome then\\n      throw (IO.userError \\\"import destination already exists\\\")\\n    let graph ← IO.ofExcept (decode (← IO.FS.readFile source))\\n    saveAtomic destination graph\\n\\nend Eggshell.Persistence\\n\",[]]"],["Eggshell.PluginCli","[\"module\\n\\npublic import Eggshell.PluginHooks\\npublic import Eggshell.PublicationClient\\npublic import Eggshell.Warm\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin\\nopen Lean\\n\\ndef controlUsage : String :=\\n  \\\"usage: egg [init|on|off|use P|next P|next graph auto|none|VALUES|keep [EGG]|drop|\\\" ++\\n  \\\"graph [VALUES]|why|find TEXT|class VALUE|union LEFT RIGHT|split UNION|\\\" ++\\n  \\\"diff [EGG]|inspect|doctor|warm [EGG|PATH]]\\\"\\n\\ndef diagnosticState : IO (Option ThreadState) := do\\n  match ← IO.getEnv \\\"CODEX_THREAD_ID\\\" with\\n  | none => pure none\\n  | some id => readJson? (← sessionFiles id).state stateJsonDefaults\\n\\ndef databaseCacheStatus (egg : Config.Egg) (command : Option (List String)) : IO Json := do\\n  let fields := [(\\\"name\\\", toJson egg.name), (\\\"path\\\", toJson egg.path.toString)]\\n  try\\n    let some snapshot ← DB.PageMap.open? egg.path |\\n      return Json.mkObj (fields ++ [(\\\"state\\\", toJson \\\"absent\\\")])\\n    let some command := command |\\n      return Json.mkObj (fields ++ [(\\\"state\\\", toJson \\\"provider-unavailable\\\")])\\n    let options ← Warm.options snapshot command\\n    let inspected ← Warm.inspect snapshot options\\n    let state := if inspected.coverage.invalid > 0 then \\\"invalid\\\"\\n      else if inspected.coverage.missing > 0 then \\\"cold\\\" else \\\"warm\\\"\\n    pure (Json.mkObj (fields ++ [(\\\"state\\\", toJson state), (\\\"coverage\\\", toJson inspected.coverage)]))\\n  catch error => pure (Json.mkObj (fields ++ [(\\\"state\\\", toJson \\\"error\\\"), (\\\"reason\\\", toJson error.toString)]))\\n\\n/-- Inspect configuration without creating session state, writing memory, or\\n    starting search or model inference. Cache coverage counts live DB windows.\\n    Installed/configured is not proof that native hooks ran. -/\\ndef doctor : IO String := do\\n  let config ← (← Config.load (← IO.currentDir)).mapM withDefaultMatcher\\n  let state ← diagnosticState\\n  let mut fields := [(\\\"runtime\\\", Lean.toJson \\\"installed\\\"),\\n    (\\\"hook_trust\\\", Lean.toJson \\\"review /hooks in Codex\\\"),\\n    (\\\"session_state_present\\\", Lean.toJson state.isSome),\\n    (\\\"handoff_observed\\\", Lean.toJson (state.any (! ·.lastHandoff.isEmpty)))]\\n  match config with\\n  | none => fields := fields ++ [(\\\"configuration\\\", Lean.toJson \\\"missing\\\"),\\n      (\\\"next_step\\\", Lean.toJson \\\"Set up Eggshell for this project.\\\")]\\n  | some config =>\\n      let profile := state.map (·.profile) |>.getD config.defaultProfile\\n      let selection ← IO.ofExcept (Config.resolve config profile)\\n      let mode := if state.any (! ·.enabled) ||\\n          (selection.read.isEmpty && selection.write.isNone) then \\\"off\\\"\\n        else if selection.write.isNone then \\\"read-only\\\" else \\\"read/write\\\"\\n      fields := fields ++ [(\\\"configuration\\\", Lean.toJson \\\"ready\\\"),\\n        (\\\"config\\\", Lean.toJson config.source.toString),\\n        (\\\"profile\\\", Lean.toJson profile), (\\\"memory\\\", Lean.toJson mode),\\n        (\\\"databases\\\", toJson (← selection.read.mapM (databaseCacheStatus · selection.semanticMatcher))),\\n        (\\\"next_step\\\", Lean.toJson\\n          \\\"Review /hooks and start a new chat. Verify saving and delivery with the two-chat example.\\\")]\\n  pure (Lean.Json.mkObj fields |>.compress)\\n\\n/-- Explicit warming is available from an ordinary terminal, including a DB\\nimported without a project config. It does not need or mutate chat state. -/\\ndef warm (requested : Option String) : IO String := do\\n  let config ← (← Config.load (← IO.currentDir)).mapM withDefaultMatcher\\n  let state ← diagnosticState\\n  let selected ← config.mapM fun config =>\\n    IO.ofExcept (Config.resolve config (state.map (·.profile) |>.getD config.defaultProfile))\\n  let eggs ← match requested with\\n    | some raw =>\\n        let named := config.bind (fun config => config.eggs.find? (·.name == raw))\\n        pure [named.getD {name := raw, path := .mk raw}]\\n    | none =>\\n        let some selection := selected | throw (IO.userError \\\"specify a DB path: egg warm PATH\\\")\\n        pure selection.read\\n  let command ← match config with\\n    | some config => pure config.semanticMatcher\\n    | none => MiniLM.command (← Paths.installRoot)\\n  let some command := command |\\n    throw (IO.userError \\\"numerical provider is disabled or not installed\\\")\\n  let results ← eggs.mapM fun egg => do\\n    let writable := selected.all fun selection =>\\n      selection.write.any (fun target => target.path.normalize == egg.path.normalize)\\n    Warm.run (← DB.PageMap.pin egg.path) command writable\\n  pure (Json.mkObj [(\\\"databases\\\", toJson results)]).compress\\n\\ndef controlSession : IO String := do\\n  match ← IO.getEnv \\\"CODEX_THREAD_ID\\\" with\\n  | some session => pure session\\n  | none => throw (IO.userError \\\"run egg through Codex ! shell UI\\\")\\n\\ndef currentConfig : IO Config.Config := do\\n  let cwd ← IO.currentDir\\n  let some config ← Config.load cwd |\\n    throw (IO.userError \\\"no .eggshell.toml or global Eggshell config\\\")\\n  pure config\\n\\ndef currentSelection (config : Config.Config) (state : ThreadState) : IO Config.Selection :=\\n  match Config.resolve config state.profile with\\n  | .ok selection => pure selection\\n  | .error message => throw (IO.userError message)\\n\\ndef statusLine (selection : Config.Selection) (state : ThreadState)\\n    (pending : Option PendingTurn) : String :=\\n  let enabled := if state.enabled then \\\"on\\\" else \\\"off\\\"\\n  let reads := \\\" \\\".intercalate (selection.read.map (·.name))\\n  let write := selection.write.map (·.name) |>.getD \\\"read-only\\\"\\n  let pendingText := match pending with\\n    | none => \\\"none\\\"\\n    | some pending =>\\n        let phase := if pending.closed || pending.finalMessage.isSome then \\\"sealed\\\" else \\\"active\\\"\\n        s!\\\"{phase}:{pending.turnId.take 8}\\\"\\n  s!\\\"egg {enabled} {state.profile} [{reads}] → {write} pending:{pendingText}\\\"\\n\\ndef chooseTarget (config : Config.Config) (pending : PendingTurn)\\n    (requested : Option String) : IO System.FilePath := do\\n  match requested with\\n  | some name =>\\n      match config.eggs.find? (·.name == name) with\\n      | some egg => pure egg.path\\n      | none => throw (IO.userError s!\\\"unknown egg {name}\\\")\\n  | none =>\\n      match pending.write with\\n      | some path => pure (System.FilePath.mk path)\\n      | none => throw (IO.userError \\\"pending turn has no write target; name one with !egg keep EGG\\\")\\n\\ndef graphForSelection (selection : Config.Selection) : IO Persistence.Composite :=\\n  Persistence.loadComposite (selection.read.map (·.path))\\n\\ndef renderFind (composite : Persistence.Composite) (query : String) : String :=\\n  let needle := query.toLower\\n  let found := allNodes composite |>.filterMap fun value => do\\n    let text ← Matcher.atomText? value\\n    if text.toLower.contains needle then\\n      some s!\\\"{valueKey value}  {shortValue value 500}\\\"\\n    else none\\n  if found.isEmpty then \\\"no matching Atom\\\" else \\\"\\\\n\\\".intercalate found\\n\\ndef unionKey (edge : UnionEdge) : String :=\\n  Persistence.Store.unionDisplayKey edge.left edge.right\\n\\ndef renderClass (composite : Persistence.Composite) (value : Value) : IO String := do\\n  match QuotientBuilder.build? (allNodes composite) composite.unions [] with\\n  | none => throw (IO.userError \\\"stored Union classes failed certification\\\")\\n  | some quotient =>\\n      let representative := quotient.canonical value\\n      let members := allNodes composite |>.filter fun member =>\\n        quotient.toEquality.same member value\\n      let unions := composite.unionOrigins.filterMap fun (edge, authority) =>\\n        if quotient.toEquality.same edge.left value ||\\n            quotient.toEquality.same edge.right value then\\n          some (s!\\\"UNION {unionKey edge} {valueKey edge.left} = \\\" ++\\n            s!\\\"{valueKey edge.right} authority={valueKey authority}\\\")\\n        else none\\n      let unionText := if unions.isEmpty then \\\"\\\" else\\n        \\\"\\\\n\\\" ++ \\\"\\\\n\\\".intercalate unions\\n      pure <| \\\"CLASS representative=\\\" ++ valueKey representative ++ \\\"\\\\n\\\" ++\\n        \\\"\\\\n\\\".intercalate (members.map fun member =>\\n          s!\\\"{valueKey member}  {shortValue member 1000}\\\") ++ unionText\\n\\ndef graphClosure (root : Value) : List Value := root.nodes.eraseDups\\n\\ndef renderRoots (roots : List Value) : String :=\\n  \\\"\\\\n\\\".intercalate <| roots.flatMap graphClosure |>.eraseDups |>.map (fun value =>\\n    s!\\\"{valueKey value}  {shortValue value 4000}\\\")\\n\\ndef persistUnion (target : System.FilePath) (left right : Value) : IO UnionEdge := do\\n  if safe : Value.sameExactFootprint left right then\\n    let snapshot ← DB.PageMap.pin target\\n    let edge : UnionEdge := {\\n        left\\n        right\\n        scope := .workspace (← Persistence.Store.authority snapshot)\\n        exactAuthority := Value.sameExactFootprint_sound safe\\n      }\\n    if left == right then return edge\\n    let _ ← DB.PageMap.withWriter snapshot fun writer => do\\n      let intern : Persistence.Store.Intern := ⟨writer, ← IO.mkRef {}⟩\\n      let leftId ← intern.value left\\n      let rightId ← intern.value right\\n      if (← writer.get (Persistence.Store.unionPairKey leftId rightId)).isSome then return\\n      Persistence.Store.addUnions intern [edge]\\n      Persistence.Store.writeChange writer {added := [],removed := [],unionsChanged := true}\\n    pure edge\\n  else throw (IO.userError \\\"Union would change Exact authority\\\")\\n\\ndef splitPersistentUnion (target : System.FilePath) (key : String) : IO UnionEdge :=\\n  Persistence.withLock target do\\n    let snapshot ← DB.PageMap.pin target\\n    let some entry ← Persistence.Store.locateUnion? snapshot key |\\n      throw (IO.userError s!\\\"Union {key} is not owned by {target}\\\")\\n    let _ ← DB.PageMap.withWriter snapshot fun writer => do\\n      Persistence.Store.removeUnion writer entry\\n      Persistence.Store.writeChange writer {added := [],removed := [],unionsChanged := true}\\n    pure entry.edge\\n\\ndef control (arguments : List String) : IO String := do\\n  let session ← controlSession\\n  withSession session fun files => do\\n    if arguments == [\\\"off\\\"] then\\n      let state := (← readState? files).getD { profile := \\\"work\\\" }\\n      quarantine files.pending\\n      writeJson files.state { state with\\n        enabled := false, epoch := state.epoch + 1, offers := [],\\n        nextProfile := none, nextProjection := none }\\n      return \\\"egg off (memory disabled; no graph will be stored or sent)\\\"\\n    let config ← currentConfig\\n    let mut state := (← readState? files).getD\\n      (defaultState config)\\n    if arguments == [\\\"on\\\"] &&\\n        state.lastReason.startsWith \\\"memory disabled after invalid session state:\\\" then\\n      state := { state with profile := config.defaultProfile }\\n    let pending ← readPending? files\\n    let selection ← currentSelection config state\\n    match arguments with\\n    | [] => pure (statusLine selection state pending)\\n    | [\\\"--help\\\"] | [\\\"-h\\\"] => pure controlUsage\\n    | [\\\"on\\\"] =>\\n        state := { state with enabled := true }\\n        writeJson files.state state\\n        pure \\\"egg on (memory enabled)\\\"\\n    | [\\\"use\\\", profile] =>\\n        let _ ← match Config.resolve config profile with\\n          | .ok selection => pure selection\\n          | .error message => throw (IO.userError message)\\n        state := { state with profile }\\n        writeJson files.state state\\n        pure s!\\\"egg {profile} selected\\\"\\n    | [\\\"next\\\", profile] =>\\n        let _ ← match Config.resolve config profile with\\n          | .ok selection => pure selection\\n          | .error message => throw (IO.userError message)\\n        state := { state with nextProfile := some profile }\\n        writeJson files.state state\\n        pure s!\\\"egg next {profile}\\\"\\n    | [\\\"next\\\", \\\"graph\\\", \\\"none\\\"] =>\\n        state := { state with nextProjection := some .none }\\n        writeJson files.state state\\n        pure \\\"egg next graph none\\\"\\n    | [\\\"next\\\", \\\"graph\\\", \\\"auto\\\"] =>\\n        state := { state with nextProjection := some .automatic }\\n        writeJson files.state state\\n        pure \\\"egg next graph auto\\\"\\n    | \\\"next\\\" :: \\\"graph\\\" :: roots =>\\n        state := { state with nextProjection := some (.roots roots) }\\n        writeJson files.state state\\n        pure s!\\\"egg next graph roots:{roots.length}\\\"\\n    | [\\\"drop\\\"] =>\\n        removeIfExists files.pending\\n        pure \\\"egg cleared the active turn; saved observations and queued commits are retained\\\"\\n    | [\\\"keep\\\"] | [\\\"keep\\\", _] =>\\n        if !state.enabled then\\n          throw (IO.userError \\\"Eggshell is off; run !egg on before keeping a turn\\\")\\n        let some pending := pending |\\n          throw (IO.userError \\\"no staged turn\\\")\\n        if !pending.closed && pending.finalMessage.isNone then\\n          throw (IO.userError \\\"active turn cannot be kept\\\")\\n        let requested := arguments.drop 1 |>.head?\\n        let target ← chooseTarget config pending requested\\n        let promotion ← promote pending target\\n        -- The foreground command publishes; its indexing runs in the same\\n        -- durable background lane as native terminal observations.\\n        queueCheckpoint files { pending with write := some target.toString }\\n        let _sourceReceipt := promotion.source\\n        removeIfExists files.pending\\n        pure s!\\\"egg kept {pending.turnId.take 8} → {target}\\\"\\n    | [\\\"graph\\\"] =>\\n        pure <| if !state.enabled then \\\"egg off; no graph was sent\\\"\\n          else if state.lastHandoff = \\\"\\\" then \\\"no graph was sent\\\" else state.lastHandoff\\n    | [\\\"why\\\"] =>\\n        pure <| if !state.enabled then \\\"egg off; no graph selection has run\\\"\\n          else if state.lastReason = \\\"\\\" then \\\"no graph selection has run\\\" else state.lastReason\\n    | \\\"graph\\\" :: roots =>\\n        let values ← readSelection selection roots\\n        pure (renderRoots values)\\n    | \\\"find\\\" :: query =>\\n        let composite ← graphForSelection selection\\n        pure (renderFind composite (\\\" \\\".intercalate query))\\n    | [\\\"class\\\", key] =>\\n        let composite ← graphForSelection selection\\n        let value ← match resolveKey composite key with\\n          | .ok value => pure value\\n          | .error message => throw (IO.userError message)\\n        renderClass composite value\\n    | [\\\"union\\\", leftKey, rightKey] =>\\n        if !state.enabled then\\n          throw (IO.userError \\\"Eggshell is off; run !egg on before changing a graph\\\")\\n        let target ← match selection.write with\\n          | some egg => pure egg.path\\n          | none => throw (IO.userError \\\"current profile is read-only\\\")\\n        let values ← readSelection selection [leftKey, rightKey]\\n        let [left, right] := values | throw (IO.userError \\\"selected Union endpoint arity changed\\\")\\n        let edge ← persistUnion target left right\\n        pure s!\\\"egg union {unionKey edge} {leftKey} = {rightKey} → {target}\\\"\\n    | [\\\"split\\\", key] =>\\n        if !state.enabled then\\n          throw (IO.userError \\\"Eggshell is off; run !egg on before changing a graph\\\")\\n        let target ← match selection.write with\\n          | some egg => pure egg.path\\n          | none => throw (IO.userError \\\"current profile is read-only\\\")\\n        let edge ← splitPersistentUnion target key\\n        pure s!\\\"egg split {key} {valueKey edge.left} != {valueKey edge.right} → {target}\\\"\\n    | [\\\"inspect\\\"] =>\\n        let reads := \\\", \\\".intercalate (selection.read.map fun egg =>\\n          s!\\\"{egg.name}={egg.path}\\\")\\n        let heads ← selection.read.mapM fun egg => do\\n          match ← DB.PageMap.open? egg.path with\\n          | none => pure s!\\\"{egg.name}:missing\\\"\\n          | some snapshot => pure (s!\\\"{egg.name}:revision={snapshot.head.revision},\\\" ++\\n              s!\\\"values={(← Persistence.Store.rootIds snapshot).length},\\\" ++\\n              s!\\\"unions={(← Persistence.Store.unionPairs snapshot).length}\\\")\\n        pure (statusLine selection state pending ++ s!\\\"\\\\nread=[{reads}]\\\\n\\\" ++\\n          \\\"heads=[\\\" ++ \\\"; \\\".intercalate heads ++ s!\\\"]\\\\nconfig={config.source}\\\")\\n    | [\\\"diff\\\"] | [\\\"diff\\\", _] =>\\n        let some pending := pending |\\n          throw (IO.userError \\\"no staged turn\\\")\\n        let requested := arguments.drop 1 |>.head?\\n        let target ← chooseTarget config pending requested\\n        let graph ← match ← DB.PageMap.open? target with\\n          | some snapshot => Persistence.Store.header snapshot\\n          | none => pure (Graph.empty (← Persistence.freshAuthority))\\n        let compiled ← match compile graph pending target.toString with\\n          | .ok compiled => pure compiled\\n          | .error message => throw (IO.userError message)\\n        pure s!\\\"target={target}\\\\nbase-revision={graph.revision}\\\\nstaged-values={compiled.transaction.stagedValues.length}\\\\noutcomes={compiled.promotion.outcomeRelations.length}\\\"\\n    | _ => throw (IO.userError controlUsage)\\n\\ndef eggControl (arguments : List String) : IO UInt32 := do\\n  if arguments = [\\\"--help\\\"] || arguments = [\\\"-h\\\"] then\\n    IO.println controlUsage\\n    return 0\\n  try\\n    let output ← match arguments with\\n      | [\\\"doctor\\\"] => doctor\\n      | [\\\"warm\\\"] => warm none\\n      | [\\\"warm\\\", requested] => warm (some requested)\\n      | _ => control arguments\\n    IO.println output\\n    pure 0\\n  catch error =>\\n    IO.eprintln s!\\\"egg: {error}\\\"\\n    pure 1\\n\\nend Eggshell.Plugin\\n\",[]]"],["Eggshell.PluginHooks","[\"module\\n\\npublic import Eggshell.DB.CacheReclaim\\n\\npublic import Eggshell.Worker\\npublic import Eggshell.MiniLM\\npublic import Eggshell.SynapseLive\\npublic import Eggshell.HashDistinct\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin\\n\\nopen Lean\\n\\ndef requiredString (json : Json) (name : String) : Except String String := do\\n  (json.getObjVal? name).bind Json.getStr?\\n\\ndef optionalString (json : Json) (name : String) : Option String :=\\n  (json.getObjVal? name).toOption.bind (Json.getStr? · |>.toOption)\\n\\ndef jsonField (json : Json) (name : String) : String :=\\n  json.getObjValD name |>.compress\\n\\ndef emptyHook : String := \\\"{}\\\"\\n\\ndef systemMessage (message : String) : String :=\\n  Json.mkObj [(\\\"systemMessage\\\", message)] |>.compress\\n\\ndef withSearchNotice (handoff : Option Handoff) (output : String) : String :=\\n  match handoff.bind (·.search) with\\n  | some trace =>\\n      if trace.route == .lexical && trace.semantic != .notRequested then\\n        let status := match trace.semantic with\\n          | .timedOut => \\\"timed out\\\"\\n          | .pending => \\\"is pending\\\"\\n          | .failed => \\\"is unavailable\\\"\\n          | .completed => \\\"completed\\\"\\n          | .notRequested => \\\"was not requested\\\"\\n        let delivery := if handoff.any (fun result =>\\n            result.reason != \\\"search-incomplete\\\" && !result.text.isEmpty) then\\n          \\\"keyword search supplied saved-memory evidence.\\\"\\n          else \\\"no new saved-memory body was delivered.\\\"\\n        match Json.parse output with\\n        | .ok json => (json.setObjVal! \\\"systemMessage\\\" (toJson\\n            s!\\\"Eggshell semantic search {status}; {delivery}\\\")).compress\\n        | .error _ => output\\n      else output\\n  | none => output\\n\\ndef defaultState (config : Config.Config) : ThreadState :=\\n  { profile := config.defaultProfile }\\n\\ndef withDefaultMatcher (config : Config.Config) : IO Config.Config := do\\n  if config.semanticMatcherWasSet then pure config\\n  else pure {config with semanticMatcher := ← MiniLM.command (← Paths.installRoot)}\\n\\ndef configFromHook (input : Json) (cwd : System.FilePath) : IO (Option Config.Config) := do\\n  let config? ← Config.loadWith cwd (optionalString input \\\"_eggshell_config\\\")\\n  config?.mapM withDefaultMatcher\\n\\ndef replaceSourceStatus (keys : List String) (key : String) : List String :=\\n  match SourceEvidence.deliveryScope? key with\\n  | none => (keys ++ [key]).eraseDups\\n  | some scope =>\\n      (keys.filter (fun old => SourceEvidence.deliveryScope? old != some scope) ++ [key]).eraseDups\\n\\n/-- Preserve the ordered delivery ledger while avoiding a quadratic scan for\\nevery prefix of a large source packet. Hashes nominate; full strings decide. -/\\ndef replaceSourceStatusFast (keys : List String) (key : String) : List String :=\\n  match SourceEvidence.deliveryScope? key with\\n  | none => hashDistinct (keys ++ [key])\\n  | some scope =>\\n      hashDistinct (keys.filter (fun old => SourceEvidence.deliveryScope? old != some scope) ++ [key])\\n\\n@[csimp] theorem replace_source_status_compiled :\\n    replaceSourceStatus = replaceSourceStatusFast := by\\n  funext keys key\\n  simp only [replaceSourceStatus, replaceSourceStatusFast, HashDistinct.reference]\\n\\ntheorem replace_source_status_preserves_other_keys (keys : List String) (key previous : String)\\n    (present : previous ∈ keys) (ordinary : SourceEvidence.deliveryScope? previous = none) :\\n    previous ∈ replaceSourceStatus keys key := by\\n  unfold replaceSourceStatus\\n  split\\n  · simp [present]\\n  · simp [present, ordinary]\\n\\ndef addDeliveredGraphs (state : ThreadState) (keys : List String) : ThreadState :=\\n  { state with deliveredGraphs := keys.foldl replaceSourceStatus state.deliveredGraphs }\\n\\ntheorem add_delivered_preserves_other_keys (state : ThreadState) (keys : List String)\\n    (previous : String) (present : previous ∈ state.deliveredGraphs)\\n    (ordinary : SourceEvidence.deliveryScope? previous = none) :\\n    previous ∈ (addDeliveredGraphs state keys).deliveredGraphs := by\\n  have preserved : ∀ incoming : List String, ∀ prior : List String,\\n      previous ∈ prior → previous ∈ incoming.foldl replaceSourceStatus prior := by\\n    intro incoming\\n    induction incoming with\\n    | nil => intro prior member; exact member\\n    | cons key tail ih =>\\n        intro prior member\\n        exact ih _ (replace_source_status_preserves_other_keys prior key previous member ordinary)\\n  exact preserved keys state.deliveredGraphs present\\n\\n/-- Compaction forgets context delivery but retains evidence-specific checkpoints. -/\\ndef compactState (state : ThreadState) : ThreadState := {\\n  state with\\n      epoch := state.epoch + 1\\n      offers := []\\n      deliveredGraphs := state.deliveredGraphs.filter (·.startsWith \\\"d:\\\")\\n      afterCompaction := true\\n      lastHandoff := \\\"\\\"\\n      lastReason := \\\"compacted; graph may be resent without repeating a checkpoint\\\" }\\n\\ntheorem compaction_preserves_checkpoint (state : ThreadState) (key : String)\\n    (present : key ∈ state.deliveredGraphs) (checkpoint : key.startsWith \\\"d:\\\" = true) :\\n    key ∈ (compactState state).deliveredGraphs := by\\n  simp [compactState, present, checkpoint]\\n\\ndef boundedHookDeadline (now budget : Nat) (upstream : Option Nat) : Nat :=\\n  min (now + budget) (upstream.getD (now + budget))\\n\\ntheorem hook_deadline_preserves_upstream (now budget deadline : Nat)\\n    (within : deadline ≤ now + budget) :\\n    boundedHookDeadline now budget (some deadline) = deadline := by\\n  simp [boundedHookDeadline, Nat.min_eq_right within]\\n\\ntheorem hook_deadline_never_extends_upstream (now budget deadline : Nat) :\\n    boundedHookDeadline now budget (some deadline) ≤ deadline := by\\n  exact Nat.min_le_right _ _\\n\\n/-- The native client reserves teardown/RPC time inside the 30-second hook.\\nSearch consumes that shared deadline rather than imposing a second 20-second\\ncutoff. Direct callers retain the client's ordinary 29-second ceiling. -/\\ndef hookDeadline (input : Json) (budget : Nat := 29000) : IO Nat := do\\n  let now ← IO.monoMsNow\\n  pure <| boundedHookDeadline now budget\\n    (input.getObjValAs? Nat \\\"_eggshell_deadline\\\").toOption\\n\\n/-- Native ingress and delivery publication share the hook's absolute deadline.\\nBackground polling retains its short, independently retryable admission. -/\\ndef withHookSession (input : Json) (session : String)\\n    (action : SessionFiles → IO α) : IO α := do\\n  let files ← sessionFiles session\\n  Persistence.privateDirectory files.directory\\n  Persistence.withLockUntil files.lock (← hookDeadline input) (action files)\\n\\n/-- Closing with no message cannot erase a final answer already received. -/\\ndef sealPending (pending : PendingTurn) (message : Option String) : PendingTurn :=\\n  { pending with finalMessage := message.or pending.finalMessage, closed := true, inFlight := [] }\\n\\ntheorem terminal_order_preserves_answer (pending : PendingTurn) (message : String) :\\n    sealPending (sealPending pending none) (some message) =\\n      sealPending (sealPending pending (some message)) none := by\\n  simp [sealPending]\\n\\ntheorem terminal_seal_preserves_observations (pending : PendingTurn) (message : Option String) :\\n    observedRoots (sealPending pending message) = observedRoots pending := by rfl\\n\\ntheorem terminal_close_never_reopens (pending : PendingTurn) (message : Option String) :\\n    (sealPending pending message).closed = true ∧\\n      (sealPending pending message).inFlight = [] := ⟨rfl, rfl⟩\\n\\n/-- Archive only metadata while holding the session lock. Receipts stay in place.\\nRetain the original turn capability before removing its active slot: SessionEnd\\nmay arrive before Stop, or an already running result may finish after closure. -/\\ndef deferPending (files : SessionFiles) (pending : PendingTurn) : IO Unit := do\\n  -- Keep unresolved reservations as diagnostic/recovery state. They never\\n  -- become observed roots; Stop separately clears them when sealing an answer.\\n  let pending := { pending with closed := true }\\n  writeJson (closedTurnPath files pending.turnId) pending\\n  let key := SemanticMatcher.contentKey (.text pending.turnId)\\n  writeJson (files.directory / \\\"deferred\\\" / (key ++ \\\".json\\\")) pending\\n  removeIfExists files.pending\\n\\n/-- The journal is authoritative for observed events even if the native hook\\n    exits between recording a receipt and registering its save. This cursor is\\n    only an optimization: restarting a manager safely replays all receipts. -/\\ndef reconcileToolReceipts (session : String) (files : SessionFiles)\\n    (cursor : IO.Ref (String × List String)) : IO Unit := do\\n  let pending ← withSession session fun files => do\\n    let some state ← readState? files | return none\\n    if !state.enabled then return none\\n    readPendingBase? files\\n  let some pending := pending | return\\n  let (turn, seen) ← cursor.get\\n  let mut seen := if turn == pending.turnId then seen else []\\n  let directory := toolDirectory files pending.turnId\\n  if ← directory.pathExists then\\n    for entry in ← directory.readDir do\\n      if !entry.fileName.endsWith \\\".json\\\" || seen.contains entry.fileName then continue\\n      try\\n        if let some (native, version) ← readNativeTool? entry.path then\\n          let tool ← attachCertificate files pending.turnId native version\\n          let paths := (Json.parse tool.input).toOption.map\\n            (SourceObservation.targets (System.FilePath.mk pending.cwd) tool.name) |>.getD []\\n          queueCheckpoint files {pending with tools := [tool], sources := paths.map (fun relative => ⟨relative, none⟩), inFlight := [], finalMessage := none, closed := false}\\n          seen := entry.fileName :: seen\\n          cursor.set (pending.turnId, seen)\\n      catch error => IO.eprintln s!\\\"Eggshell retained an unqueued tool receipt: {error}\\\"\\n\\n/-- Saving is isolated from search and never holds the session state lock. -/\\ndef flushDeferred (session : String) (deadline : Nat)\\n    (cursor : Option (IO.Ref (String × List String)) := none) : IO Unit := do\\n  let files ← sessionFiles session\\n  try Persistence.withLockWithin (files.directory / \\\"save\\\") 0 do\\n    if let some cursor := cursor then reconcileToolReceipts session files cursor\\n    let mut entries := []\\n    for name in [\\\"deferred\\\", \\\"checkpoints\\\"] do\\n      let directory := files.directory / name\\n      if ← directory.pathExists then entries := entries ++ (← directory.readDir).toList\\n    for entry in entries.take 8 do\\n      if (← IO.monoMsNow) ≥ deadline then return\\n      if !entry.fileName.endsWith \\\".json\\\" then continue\\n      let state ← withSession session fun files => readState? files\\n      if state.any (! ·.enabled) then return\\n      let payload := Json.mkObj [(\\\"session\\\", session), (\\\"path\\\", entry.path.toString)]\\n      let some result ← Worker.exchange session \\\"save\\\" payload deadline | return\\n      let .ok _saved := NativePublication.SaveReply.check? result |\\n        IO.eprintln s!\\\"Eggshell retained uncommitted work in {session} from {entry.path}: {result.compress}\\\"\\n        continue\\n      -- Source persistence acknowledges no delivery to a model context.\\n      -- Only native observation or a separate delivery ACK may add such claims.\\n  catch error => IO.eprintln s!\\\"Eggshell retained queued work: {error}\\\"\\n\\ndef drainIndexTarget (session : String) (deadline : Nat)\\n    (reference : System.FilePath) (target : IndexTarget) : IO Unit := do\\n  let snapshot ← DB.PageMap.open? (.mk target.owner.directory)\\n  let some snapshot := snapshot | do\\n    removeIfExists reference\\n    return\\n  if snapshot.head.identity != target.owner.database then\\n    removeIfExists reference\\n    return\\n  DB.Sidecar.observe snapshot\\n  -- A remembered writer grant cannot make a reader chat mutate shared DBs.\\n  -- Standalone recovery without a current turn can still finish prior work.\\n  if target.storage == .database then\\n    let files ← sessionFiles session\\n    if let some pending ← readPendingBase? files then\\n      unless pending.write.any (fun path =>\\n          (System.FilePath.mk path).normalize == (System.FilePath.mk target.owner.directory).normalize) do\\n        return\\n  let directory ← target.indexes snapshot\\n  let entries ← if ← directory.pathExists then directory.readDir else pure #[]\\n  let entries := (entries.toList.filter (·.fileName.endsWith \\\".json\\\"))\\n    |>.mergeSort (fun a b => a.fileName ≤ b.fileName)\\n  let warm ← Warm.required target snapshot\\n  let synapses := (← Synapses.Build.required snapshot target.storage) || (← Synapses.Journal.required snapshot target.storage)\\n  if entries.isEmpty && !warm && !synapses then return\\n  let payload := Json.mkObj [(\\\"target\\\", toJson target), (\\\"warm\\\", toJson warm),\\n    (\\\"paths\\\", toJson (entries.take 8 |>.map (·.path.toString)))]\\n  if let some result ← Worker.exchange session \\\"index\\\" payload deadline then\\n    if !(fromJson? result : Except String Nat).isOk then\\n      IO.eprintln s!\\\"Eggshell retained unindexed published work: {result.compress}\\\"\\n\\ndef drainRegisteredIndexes (session : String) (deadline : Nat) : IO Unit := do\\n  for (reference, target) in ← registeredIndexTargets do\\n    if (← IO.monoMsNow) ≥ deadline then return\\n    try drainIndexTarget session deadline reference target\\n    catch error => IO.eprintln s!\\\"Eggshell retained DB index work: {error}\\\"\\n\\ndef drainSynapticTargets (session : String) (deadline : Nat) : IO Unit := do\\n  for (reference, target) in ← Synapses.Journal.targets do\\n    if (← IO.monoMsNow) ≥ deadline then return\\n    try\\n      let some source ← DB.PageMap.open? (.mk target.owner.directory) | do\\n        removeIfExists reference\\n        continue\\n      if source.head.identity != target.owner.database then\\n        removeIfExists reference\\n        continue\\n      if target.storage == .database then\\n        let files ← sessionFiles session\\n        if let some pending ← readPendingBase? files then\\n          unless pending.write.any (fun path => (System.FilePath.mk path).normalize ==\\n              (System.FilePath.mk target.owner.directory).normalize) do continue\\n      if !(← Synapses.Journal.required source target.storage) then continue\\n      let payload := Json.mkObj [(\\\"kind\\\", toJson \\\"synapses\\\"), (\\\"target\\\", toJson target)]\\n      let reply ← Worker.exchange session \\\"index\\\" payload deadline\\n      if reply.any (fun json => !(fromJson? json : Except String Synapses.Journal.Result).isOk) then\\n        IO.eprintln \\\"Eggshell retained native synaptic index work\\\"\\n    catch error => IO.eprintln s!\\\"Eggshell retained native synaptic index work: {error}\\\"\\n\\ndef flushIndexWork (session : String) (deadline : Nat) : IO Unit := do\\n  -- Current configuration discovers portable work at a new DB location.\\n  -- This optional discovery cannot prevent draining already registered DBs.\\n  let files ← sessionFiles session\\n  try\\n    if let some pending ← (readJson? files.pending pendingJsonDefaults : IO (Option PendingTurn)) then\\n      if let some command := pending.semanticMatcher then\\n        for path in (pending.read ++ pending.write.toList).eraseDups do\\n          if let some snapshot ← DB.PageMap.open? (.mk path) then\\n            let _ ← registerIndexTarget snapshot command (pending.write == some path)\\n            pure ()\\n  catch error => IO.eprintln s!\\\"Eggshell retained undiscovered DB work: {error}\\\"\\n  let root ← dataRoot\\n  Persistence.rejectSymlinkAncestors root\\n  Persistence.privateDirectory root\\n  let guardPath := root / \\\"index-drain.guard\\\"\\n  Persistence.rejectSymlinkAncestors guardPath\\n  let guard ← IO.FS.Handle.mk guardPath .append\\n  Persistence.privateFile guardPath\\n  if !(← guard.tryLock) then return\\n  try\\n    try\\n      let _ ← DB.Sidecar.collect (min deadline ((← IO.monoMsNow) + 50))\\n      pure ()\\n    catch error => IO.eprintln s!\\\"Eggshell retained private caches: {error}\\\"\\n    drainSynapticTargets session deadline\\n    drainRegisteredIndexes session deadline\\n  finally guard.unlock\\n\\n/-- Installation-wide discovery survives chats. The single drain admission and\\nper-DB worker claim never acquire the graph writer or a session state lock. -/\\ndef flushIndexes (session : String) (deadline : Nat) : IO Unit := do\\n  try flushIndexWork session deadline\\n  catch error => IO.eprintln s!\\\"Eggshell retained index tickets: {error}\\\"\\n\\ndef sessionStart (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  if optionalString input \\\"source\\\" = some \\\"compact\\\" then\\n    Worker.cancel session \\\"search\\\"\\n    withHookSession input session fun files => do\\n      if let some state ← readState? files then\\n        if state.enabled then writeJson files.state (compactState state)\\n    return emptyHook\\n  else\\n    let cwd := System.FilePath.mk ((optionalString input \\\"cwd\\\").getD \\\".\\\")\\n    let config ← configFromHook input cwd\\n    let state ← withHookSession input session fun files => do\\n      let state ← readState? files\\n      if state.isNone then\\n        if let some config := config then\\n          let state := defaultState config\\n          writeJson files.state state\\n          return some state\\n      pure state\\n    let some config := config |\\n      return systemMessage \\\"Eggshell memory is not configured for this project. Ask Codex: Set up Eggshell for this project.\\\"\\n    let some state := state | return emptyHook\\n    if !state.enabled then\\n      return systemMessage \\\"Eggshell memory is off for this chat. Use !egg on only if you want to enable it.\\\"\\n    let selection ← IO.ofExcept (Config.resolve config state.profile)\\n    let mode := if selection.read.isEmpty && selection.write.isNone then \\\"off\\\"\\n      else if selection.write.isNone then \\\"read-only\\\" else \\\"read/write\\\"\\n    return systemMessage (s!\\\"Eggshell session hook connected: memory {mode}, profile {state.profile}. \\\" ++\\n      \\\"Use !egg doctor to check setup; !egg graph shows context actually delivered.\\\")\\n\\ndef acceptOffer (state : ThreadState) (turn : String) (now : Nat)\\n    (offer : DeliveryOffer) : ThreadState :=\\n  if state.enabled && offer.stamp.accepts turn state.epoch now then\\n    { (addDeliveredGraphs state offer.graphs) with\\n      lastHandoff := offer.text, lastReason := offer.reason, lastSearch := offer.search }\\n  else state\\n\\ntheorem rejected_offer_changes_nothing (state : ThreadState) (turn : String)\\n    (now : Nat) (offer : DeliveryOffer)\\n    (rejected : offer.stamp.accepts turn state.epoch now = false) :\\n    acceptOffer state turn now offer = state := by\\n  simp [acceptOffer, rejected]\\n\\ntheorem disabled_memory_rejects_delivery (state : ThreadState) (turn : String)\\n    (now : Nat) (offer : DeliveryOffer) (disabled : state.enabled = false) :\\n    acceptOffer state turn now offer = state := by\\n  simp [acceptOffer, disabled]\\n\\ndef acknowledge (session id : String) : IO Bool := withSession session fun files => do\\n  let some state ← readState? files | return false\\n  let some pending ← readPendingBase? files | return false\\n  let now ← IO.monoMsNow\\n  let some offer := state.offers.find? (·.id == id) | return false\\n  if !(state.enabled && offer.stamp.accepts pending.turnId state.epoch now) then\\n    Synapses.Live.unconfirmed files\\n  let state := { state with offers := state.offers.filter (·.id != id) }\\n  writeJson files.state (acceptOffer state pending.turnId now offer)\\n  pure (state.enabled && offer.stamp.accepts pending.turnId state.epoch now)\\n\\n/-- Semantic discovery gets the first window; DB delivery retains the rest. -/\\ndef semanticSearchBudgetMs : Nat := 15000\\n\\ndef semanticSearchDeadline (now deadline : Nat) : Nat :=\\n  min deadline (now + min semanticSearchBudgetMs ((deadline - now) / 2))\\n\\ntheorem semantic_deadline_preserves_upstream (now deadline : Nat) :\\n    semanticSearchDeadline now deadline ≤ deadline := Nat.min_le_left _ _\\n\\ntheorem semantic_deadline_reserves_fallback (now deadline : Nat) :\\n    semanticSearchDeadline now deadline ≤ now + (deadline - now) / 2 := by\\n  exact Nat.le_trans (Nat.min_le_right _ _) (Nat.add_le_add_left (Nat.min_le_right _ _) _)\\n\\n\\n/-- Once checked nominations are ready, status uses the same overall deadline\\nas the transport. A later pending result is not a discovery timeout. -/\\ndef configuredSearchDeadline (finishReady ready : Bool) (phaseDeadline deadline : Nat) : Nat :=\\n  if finishReady && ready then deadline else min phaseDeadline deadline\\n\\ntheorem configured_deadline_preserves_upstream (finishReady ready : Bool)\\n    (phaseDeadline deadline : Nat) :\\n    configuredSearchDeadline finishReady ready phaseDeadline deadline ≤ deadline := by\\n  unfold configuredSearchDeadline\\n  split\\n  · exact Nat.le_refl _\\n  · exact Nat.min_le_right _ _\\n\\ndef searchIncomplete (reply : Option Json) : Bool :=\\n  match reply with\\n  | none => true\\n  | some json => match (fromJson? json : Except String (Option Handoff)) with\\n    | .error _ => true\\n    | .ok none => false\\n    | .ok (some handoff) => handoff.reason == \\\"search-incomplete\\\"\\n\\ndef incompleteSemanticStatus (reply : Option Json) (now deadline : Nat) : SemanticSearchStatus :=\\n  if now ≥ deadline then .timedOut else\\n    match reply with\\n    | none => .failed\\n    | some json => match (fromJson? json : Except String (Option Handoff)) with\\n      | .ok (some handoff) => if handoff.reason == \\\"search-incomplete\\\" then .pending else .failed\\n      | _ => .failed\\n\\n/-- A valid empty worker reply adds no memory or completion authority. Retain\\nthe observed search status even when its fallback has no new body to publish. -/\\ndef emptySearchResult (trace : SearchTrace) : Handoff := {\\n  text := \\\"\\\", reason := \\\"no-new-memory\\\"\\n  deliveredGraphs := [], completed := 0, advisory := 0, localUnions := 0\\n  coveredFragments := [], blocksCurrent := false, search := some trace }\\n\\ntheorem empty_search_has_no_authority (trace : SearchTrace) :\\n    (emptySearchResult trace).text = \\\"\\\" ∧\\n    (emptySearchResult trace).deliveredGraphs = [] ∧\\n    (emptySearchResult trace).completed = 0 ∧\\n    (emptySearchResult trace).localUnions = 0 ∧\\n    (emptySearchResult trace).coveredFragments = [] ∧\\n    (emptySearchResult trace).blocksCurrent = false := by\\n  exact ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩\\n\\ntheorem empty_search_preserves_status (trace : SearchTrace) :\\n    (emptySearchResult trace).search = some trace := rfl\\n\\n/-- Constant metadata per DB, never a scan or embedding job in the hook.\\nThe registry retains unavailable indexes. Actual numerical cache observations\\npersist typed private repair debt; a deadline never invalidates a checkpoint. -/\\ndef requestBackgroundWarm (pending : PendingTurn) (deadline : Nat) : IO Nat := do\\n  let some command := pending.semanticMatcher | return 0\\n  let _ :: \\\"search-provider\\\" :: _ := command | return 0\\n  let mut count := 0\\n  for path in pending.read.eraseDups do\\n    if (← IO.monoMsNow) ≥ deadline then break\\n    try\\n      if let some snapshot ← DB.PageMap.open? (.mk path) then\\n        let _ ← registerIndexTarget snapshot command (pending.write == some path)\\n        -- Retain a background re-evaluation request. Do not inspect complete\\n        -- prepared domains or invalidate a checkpoint on the foreground path.\\n        count := count + 1\\n    catch error => IO.eprintln s!\\\"Eggshell retained an unavailable warm target: {error}\\\"\\n  pure count\\n\\n/-- Search results become offers only after checking the current turn and epoch. -/\\ndef deliverForWork (input : Json) (pending : PendingTurn) (work : String)\\n    (enforce : Bool) (evidenceText : Option String := none) (staged : Bool := false) :\\n    IO (Option Handoff) := do\\n  let session := pending.sessionId\\n  let deadline ← hookDeadline input\\n  let snapshot ← withHookSession input session fun files => do\\n    let some state ← readState? files | return none\\n    let some current ← readPendingBase? files | return none\\n    if !state.enabled || current.turnId != pending.turnId || (current.closed || current.finalMessage.isSome) then\\n      return none\\n    if pending.projection == .none || pending.read.isEmpty then return none\\n    writeJson files.state {state with searchStarted := true}\\n    pure (some state)\\n  let some initial := snapshot | return none\\n  let stamp : RequestStamp := { turn := pending.turnId, epoch := initial.epoch, deadline }\\n  let query : Worker.Search := {\\n    pending, state := initial, work, enforce, evidence := evidenceText, staged, deadline\\n    receipt := optionalString input \\\"_eggshell_receipt\\\" }\\n  let semantic := pending.projection == .automatic && pending.semanticMatcher.isSome && evidenceText.isNone\\n  let started ← IO.monoMsNow\\n  let firstDeadline := if semantic then semanticSearchDeadline started deadline else deadline\\n  let readyAt ← IO.mkRef (none : Option Nat)\\n  let policy : Worker.SearchPolicy := {\\n    identity := query.identity\\n    finishReady := semantic\\n    onReady := fun now => do\\n      if (← readyAt.get).isNone then readyAt.set (some now) }\\n  let first ← Worker.exchange session \\\"search\\\" (toJson query) firstDeadline (some policy)\\n  let observed ← IO.monoMsNow\\n  let finishDeadline := configuredSearchDeadline policy.finishReady (← readyAt.get).isSome firstDeadline deadline\\n  let (result, trace) ← if semantic && searchIncomplete first then do\\n      let warmRequests ← requestBackgroundWarm pending\\n        (min deadline (observed + (deadline - observed) / 4))\\n      let lexical := {query with route := .lexical}\\n      let lexicalStarted ← IO.monoMsNow\\n      let result ← Worker.exchange session \\\"search\\\" (toJson lexical) deadline\\n        (some {identity := lexical.identity})\\n      let trace : SearchTrace := {\\n        semantic := incompleteSemanticStatus first observed finishDeadline, route := .lexical\\n        semanticMs := observed - started, lexicalMs := (← IO.monoMsNow) - lexicalStarted\\n        warmMs := lexicalStarted - observed, warmRequests }\\n      pure (result, trace)\\n    else do\\n      let trace : SearchTrace := {\\n        semantic := if semantic then .completed else .notRequested, route := .configured\\n        semanticMs := if semantic then observed - started else 0\\n        lexicalMs := if semantic then 0 else observed - started }\\n      pure (first, trace)\\n  let (handoff, disposition) ← withHookSession input session fun files => do\\n    let some state ← readState? files | return (none, \\\"missing-state\\\")\\n    let some current ← readPendingBase? files | return (none, \\\"missing-turn\\\")\\n    let now ← IO.monoMsNow\\n    if !state.enabled then return (none, \\\"disabled\\\")\\n    if current.closed || current.finalMessage.isSome then return (none, \\\"closed-turn\\\")\\n    match Worker.SearchDelivery.ofReply stamp current.turnId state.epoch now\\n        pending.handoffChars result with\\n    | .obsolete => return (none, \\\"obsolete\\\")\\n    | .empty _ => return (some (emptySearchResult trace), \\\"empty\\\")\\n    | .incomplete _ _ => return (some {pendingSearch with search := some trace}, \\\"incomplete\\\")\\n    | .found _ handoff _ _ => do\\n        -- Linearize only publication, never the search or semantic matcher.\\n        -- Concurrent offers subtract the same original ranges under this short lock.\\n        let some reconciled := handoff.reconcileDelivery\\n            (state.deliveryClaims current.turnId now) pending.handoffChars Config.nativeHandoffBytes |\\n          return (none, \\\"reconciled-empty\\\")\\n        let handoff := {reconciled.handoff with search := some trace}\\n        let checkpoints := handoff.sourceCheckpoints.map (·.key)\\n        let id := (optionalString input \\\"_eggshell_receipt\\\").getD \\\"direct\\\"\\n        let offer : DeliveryOffer := {\\n          id, stamp, graphs := handoff.deliveredGraphs, text := handoff.text\\n          reason := handoff.reason, search := handoff.search }\\n        if state.offers.any (fun previous => previous.id == id ||\\n            !previous.stamp.accepts current.turnId state.epoch now) || state.offers.length ≥ 15 then\\n          Synapses.Live.unconfirmed files\\n        writeJson files.state {\\n          (addDeliveredGraphs state checkpoints) with\\n          offers := offer :: (state.offers.filter fun (offer : DeliveryOffer) =>\\n            offer.id != id && offer.stamp.accepts current.turnId state.epoch now).take 15 }\\n        pure (some handoff, \\\"offered\\\")\\n  Receipt.observe (optionalString input \\\"_eggshell_receipt\\\") \\\"search\\\" (Json.mkObj [\\n    (\\\"turn\\\", toJson pending.turnId), (\\\"epoch\\\", toJson initial.epoch),\\n    (\\\"deadlineMs\\\", toJson deadline), (\\\"initialSearch\\\", toJson (!initial.searchStarted)),\\n    (\\\"semanticDeadlineMs\\\", toJson firstDeadline), (\\\"searchStartedMs\\\", toJson started),\\n    (\\\"semanticReadyMs\\\", toJson (← readyAt.get)),\\n    (\\\"semanticFinishDeadlineMs\\\", toJson finishDeadline),\\n    (\\\"finishReadyWithinHook\\\", toJson policy.finishReady),\\n    (\\\"trace\\\", toJson trace), (\\\"disposition\\\", toJson disposition),\\n    (\\\"reason\\\", toJson (handoff.map (·.reason))),\\n    (\\\"completed\\\", toJson (handoff.map (·.completed))),\\n    (\\\"localUnions\\\", toJson (handoff.map (·.localUnions))),\\n    (\\\"equalityOrigin\\\", if handoff.any (fun h => h.completed > 0 || h.blocksCurrent) then\\n      Json.mkObj [(\\\"status\\\", toJson (if handoff.any (·.equalitySelection.isSome) then \\\"partial\\\" else \\\"untracked\\\")),\\n        (\\\"selection\\\", toJson (handoff.bind (·.equalitySelection))),\\n        (\\\"deliveryAncestry\\\", toJson \\\"untracked\\\")]\\n      else Json.null)])\\n  pure handoff\\n\\ndef userPromptSubmit (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  let turn ← IO.ofExcept (requiredString input \\\"turn_id\\\")\\n  let cwd := System.FilePath.mk (← IO.ofExcept (requiredString input \\\"cwd\\\"))\\n  let prompt ← IO.ofExcept (requiredString input \\\"prompt\\\")\\n  let some config ← configFromHook input cwd | return emptyHook\\n  let prepared ← withHookSession input session fun files => do\\n    let mut state := (← readState? files).getD (defaultState config)\\n    if !state.enabled then return none\\n    if let some pending ← readPendingBase? files then\\n      if pending.turnId == turn then return none\\n      deferPending files pending\\n    let selection ← IO.ofExcept (Config.resolve config (state.nextProfile.getD state.profile))\\n    let pending : PendingTurn := {\\n      sessionId := session, turnId := turn, cwd := cwd.toString, prompt,\\n      profile := selection.label, semanticMatcher := selection.semanticMatcher,\\n      read := selection.read.map (·.path.toString), write := selection.write.map (·.path.toString),\\n      handoffChars := selection.handoffChars, localUnion := selection.localUnion,\\n      projection := state.nextProjection.getD .automatic }\\n    state := { state with\\n      epoch := state.epoch + 1\\n      offers := []\\n      deliveredGraphs := state.deliveredGraphs.filter (fun key => !key.startsWith \\\"d:\\\"),\\n      nextProfile := none, nextProjection := none }\\n    writeJson files.state state\\n    writeJson files.pending pending\\n    pure (some pending)\\n  let some pending := prepared | return emptyHook\\n  Worker.cancel session \\\"search\\\"\\n  let handoff ← deliverForWork input pending prompt false\\n  let context := handoff.map (·.text) |>.getD \\\"\\\"\\n  pure <| withSearchNotice handoff (if context == \\\"\\\" then emptyHook else hookContext \\\"UserPromptSubmit\\\" context)\\n\\ndef toolFromHook (input : Json) (withResponse : Bool) : Except String ToolEvent := do\\n  pure {\\n    name := ← requiredString input \\\"tool_name\\\"\\n    useId := ← requiredString input \\\"tool_use_id\\\"\\n    input := jsonField input \\\"tool_input\\\"\\n    response := if withResponse then jsonField input \\\"tool_response\\\" else \\\"\\\"\\n  }\\n\\ninductive PreToolState where\\n  | ignore\\n  | reserved (pending : PendingTurn)\\n\\ninductive PostToolState where\\n  | ignore\\n  | completed (pending : PendingTurn)\\n\\ndef localSourceTool (name : String) : Bool :=\\n  [\\\"Bash\\\", \\\"bash\\\", \\\"shell\\\", \\\"exec_command\\\", \\\"functions.exec_command\\\"].contains name\\n\\n/-- A path argument of an arbitrary MCP/provider does not establish that the\\nprovider read a local file. Only literal local read/search commands supply\\nthis adapter's dependency capture. Preserve directory fields for validation,\\nbut obtain every file from the actual command, never unrelated extra fields. -/\\ndef nativeSourceInput? (tool : ToolEvent) : Option Json := do\\n  if !localSourceTool tool.name then return ← none\\n  let input ← (Json.parse tool.input).toOption\\n  let command ← ((input.getObjValAs? String \\\"cmd\\\").toOption).orElse\\n    (fun _ => (input.getObjValAs? String \\\"command\\\").toOption)\\n  if (SourceEvidence.observedCommandFiles command).isEmpty then return ← none\\n  let directories := [\\\"workdir\\\", \\\"cwd\\\"].filterMap fun key =>\\n    (input.getObjVal? key).toOption.map (fun value => (key, value))\\n  pure (Json.mkObj ((\\\"command\\\", toJson command) :: directories))\\n\\ntheorem unknown_native_source_input_rejected (tool : ToolEvent)\\n    (unknown : localSourceTool tool.name = false) : nativeSourceInput? tool = none := by\\n  simp [nativeSourceInput?, unknown]\\n\\ndef preToolUse (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  let turn ← IO.ofExcept (requiredString input \\\"turn_id\\\")\\n  let initial ← IO.ofExcept (toolFromHook input false)\\n  let files ← sessionFiles session\\n  -- Probe outside the session lock. This optional observation spends at most\\n  -- a small part of the native hook window; incomplete provenance has no\\n  -- authority and never prevents the requested operation from proceeding.\\n  let captured ← try\\n      let base ← (readJson? files.pending pendingJsonDefaults : IO (Option PendingTurn))\\n      match base with\\n      | some pending =>\\n          if pending.turnId != turn then pure none else do\\n            let deadline ← hookDeadline input\\n            let budget := min deadline ((← IO.monoMsNow)+250)\\n            let workspace := System.FilePath.mk pending.cwd\\n            let primary ← (nativeSourceInput? initial).mapM fun sourceInput =>\\n              SourceEvidence.capture workspace sourceInput budget\\n            let sourceInput := (Json.parse initial.input).toOption.getD (.str initial.input)\\n            let content ← ContentCapture.captureInputs workspace sourceInput primary budget\\n            pure (some (pending.cwd,primary,content))\\n      | none => pure none\\n    catch _ => pure none\\n  let tool := {initial with source := captured.bind (·.2.1),contentInputs := captured.map (·.2.2)}\\n  let preflight ← withHookSession input session fun files => do\\n    let some state ← readState? files |\\n      pure PreToolState.ignore\\n    if !state.enabled then\\n      do\\n        removeIfExists files.pending\\n        pure PreToolState.ignore\\n    else\\n      let some pending ← readPendingBase? files |\\n        pure PreToolState.ignore\\n      if pending.turnId != turn || (pending.closed || pending.finalMessage.isSome) then\\n        pure PreToolState.ignore\\n      else\\n        let tool := if captured.any (fun previous => previous.1 != pending.cwd) then\\n          {tool with source := none,contentInputs := none} else tool\\n        let reserved := reserveTool pending tool\\n        writeJson files.pending reserved\\n        Synapses.Live.start input files reserved state tool\\n        pure (.reserved reserved)\\n  match preflight with\\n  | .ignore => pure emptyHook\\n  | .reserved pending =>\\n      try\\n        let handoff ← deliverForWork input pending\\n          (canonicalToolWork tool) true none true\\n        if handoff.any (·.blocksCurrent) then\\n          withHookSession input session fun files => do\\n            if let some current ← readPendingBase? files then\\n              if current.turnId = turn then\\n                writeJson files.pending (cancelTool current tool.useId)\\n          let text := handoff.map (·.text) |>.getD \\\"\\\"\\n          let fragments := handoff.map (fun candidate =>\\n            candidate.coveredFragments)\\n            |>.getD [] |>.map fun fragment =>\\n            \\\"- \\\" ++ treeWork (.text fragment)\\n          let matched := if fragments.isEmpty then \\\"\\\" else\\n            \\\"\\\\n\\\\nREMOVE ONLY THESE COMPLETED FRAGMENTS:\\\\n\\\" ++\\n              \\\"\\\\n\\\".intercalate fragments ++\\n              \\\"\\\\nEVERY OTHER SUBCOMMAND, PATH, SYMBOL, RANGE, AND REQUESTED FACT REMAINS OPEN.\\\"\\n          let instruction :=\\n            \\\"Eggshell found completed prior native Work before this operation ran. Replan \\\" ++\\n            \\\"the call to omit only the covered Work and issue any genuinely uncovered \\\" ++\\n            \\\"remainder. Do not repeat covered Work merely to verify, cite, narrow, \\\" ++\\n            \\\"reformat, or reconstruct it.\\\\n\\\\n\\\" ++ evidenceGapGuidance\\n          pure <| withSearchNotice handoff (hookDeny (instruction ++ matched ++ \\\"\\\\n\\\\n\\\" ++\\n            (if text = \\\"\\\" then\\n              \\\"The Outcome is already present in this native context; Eggshell did not resend it.\\\"\\n            else \\\"Newly connected prior graph:\\\\n\\\\n\\\" ++ text)))\\n        else\\n          let text := handoff.map (·.text) |>.getD \\\"\\\"\\n          pure <| withSearchNotice handoff (if text = \\\"\\\" then emptyHook else hookContext \\\"PreToolUse\\\" text)\\n      catch error =>\\n        withHookSession input session fun files => do\\n          if let some current ← readPendingBase? files then\\n            if current.turnId = turn then\\n              writeJson files.pending (cancelTool current tool.useId)\\n        throw error\\n\\n/-- Retain the original read's certificate in both active and archived turns.\\nAn existing companion is immutable; a new companion is sealed against the\\npre-tool capture, never inferred from the command's output or a later hash. -/\\ndef sealRecordedSource (pending : PendingTurn) (tool : ToolEvent) : IO ToolEvent := do\\n  if tool.source.isSome then return tool\\n  let previous := pending.inFlight.find? fun previous =>\\n    previous.useId == tool.useId && previous.name == tool.name &&\\n      canonicalJson previous.input == canonicalJson tool.input\\n  let source ← (previous.bind (·.source)).mapM fun capture => do\\n    let record ← SourceEvidence.sealCapture (System.FilePath.mk pending.cwd) capture ((← IO.monoMsNow) + 250)\\n    pure {capture with record}\\n  pure {tool with source}\\n\\ntheorem existing_read_certificate_retained (pending : PendingTurn) (tool : ToolEvent)\\n    (capture : SourceEvidence.Capture) (hasCertificate : tool.source = some capture) :\\n    sealRecordedSource pending tool = pure tool := by\\n  simp [sealRecordedSource, hasCertificate]\\n\\n/-- Native bytes are already journaled. Optional content matches use the\\npre-call input fingerprints, and are sealed before their checkpoint is queued.\\nInterrupted/unsupported captures retain an explicit unavailable result. -/\\ndef sealRecordedRead (pending : PendingTurn) (tool : ToolEvent) : IO ToolEvent := do\\n  let tool ← sealRecordedSource pending tool\\n  if tool.correspondence.isSome then return tool\\n  let previous := pending.inFlight.find? fun previous =>\\n    previous.useId == tool.useId && previous.name == tool.name &&\\n      canonicalJson previous.input == canonicalJson tool.input\\n  let captured ← match previous.bind (·.contentInputs) with\\n    | none => pure ({\\n        implementation := ContentCapture.implementation\\n        inputs := #[]\\n        complete := false\\n        aliases := #[]\\n        failure := some \\\"input-not-captured\\\"} : ContentCapture.Captured)\\n    | some inputs => do\\n        let deadline := (← IO.monoMsNow)+250\\n        ContentCapture.finish (System.FilePath.mk pending.cwd) inputs (canonicalJson tool.response) deadline\\n  return {tool with contentInputs := none,correspondence := some captured}\\n\\n/-- Journal native results before contacting the manager or doing any search. -/\\ndef captureTerminal (input : Json) : IO Unit := do\\n  if optionalString input \\\"hook_event_name\\\" != some \\\"PostToolUse\\\" then return\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  let turn ← IO.ofExcept (requiredString input \\\"turn_id\\\")\\n  let tool ← IO.ofExcept (toolFromHook input true)\\n  let files ← sessionFiles session\\n  -- Explicitly disabled memory retains no new observation. Invalid control\\n  -- metadata must preserve the native result before reporting unconfirmed work.\\n  let state ← try\\n    (readJson? files.state stateJsonDefaults : IO (Option ThreadState))\\n    catch error =>\\n      recordTool files turn tool\\n      throw error\\n  if let some state := state then\\n    if !state.enabled then return\\n  let tool := (← recordedTool? files turn tool).getD tool\\n  recordTool files turn tool\\n  if let some pending ← (readJson? files.pending pendingJsonDefaults : IO (Option PendingTurn)) then\\n    if pending.turnId == turn && !pending.closed && pending.finalMessage.isNone then\\n      let tool ← sealRecordedRead pending tool\\n      -- The native result was already durable before provenance validation.\\n      -- A crash here can lose only the optional source certificate, not work.\\n      recordTool files turn tool\\n      let paths := (Json.parse tool.input).toOption.map\\n        (SourceObservation.targets (System.FilePath.mk pending.cwd) tool.name) |>.getD []\\n      queueCheckpoint files {pending with tools := [tool], inFlight := [], sources := paths.map (fun relative => ⟨relative, none⟩)}\\n      return\\n  if let some pending ← readClosedTurn? files turn then\\n    unless pending.sessionId == session do throw (IO.userError \\\"closed receipt belongs to another chat\\\")\\n    let tool ← sealRecordedRead pending tool\\n    recordTool files turn tool\\n    let paths := (Json.parse tool.input).toOption.map\\n      (SourceObservation.targets (System.FilePath.mk pending.cwd) tool.name) |>.getD []\\n    queueCheckpoint files {pending with tools := [tool], inFlight := [], sources := paths.map (fun relative => ⟨relative, none⟩), finalMessage := none, closed := false}\\n\\ndef postToolUse (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  let turn ← IO.ofExcept (requiredString input \\\"turn_id\\\")\\n  let initial ← IO.ofExcept (toolFromHook input true)\\n  let files ← sessionFiles session\\n  let tool := (← recordedTool? files turn initial).getD initial\\n  let postflight ← withHookSession input session fun files => do\\n    let some state ← readState? files |\\n      pure PostToolState.ignore\\n    if state.enabled then\\n      let active ← readPendingBase? files\\n      let recorded ← if active.any (·.turnId == turn) then pure active else readClosedTurn? files turn\\n      if let some pending := recorded then\\n        Synapses.Live.finish input pending tool\\n    if !state.enabled then\\n      do\\n        removeIfExists files.pending\\n        pure PostToolState.ignore\\n    else\\n      let some pending ← readPendingBase? files |\\n        pure PostToolState.ignore\\n      if pending.turnId != turn || (pending.closed || pending.finalMessage.isSome) then\\n        pure PostToolState.ignore\\n      else\\n        recordTool files turn tool\\n        queueCheckpoint files { pending with tools := [tool], inFlight := [] }\\n        let pending := cancelTool pending tool.useId\\n        writeJson files.pending pending\\n        let roots := observedRoots { pending with tools := [tool] }\\n        writeJson files.state (addDeliveredGraphs state (roots.map nativeHistoryKey))\\n        pure (.completed pending)\\n  match postflight with\\n  | .ignore => pure emptyHook\\n  | .completed pending =>\\n      try\\n        let handoff ← deliverForWork input pending\\n          (canonicalToolWork tool) false\\n          (if tool.response.trimAscii.isEmpty then none else some (canonicalJson tool.response))\\n        let text := handoff.map (·.text) |>.getD \\\"\\\"\\n        pure <| withSearchNotice handoff (if text = \\\"\\\" then emptyHook else hookContext \\\"PostToolUse\\\" text)\\n      catch error =>\\n        IO.eprintln s!\\\"Eggshell recorded the native result but omitted its handoff: {error}\\\"\\n        pure (hookContext \\\"PostToolUse\\\" pendingSearch.text)\\n\\ndef postCompact (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  withHookSession input session fun files => do\\n    if let some state ← readState? files then\\n      if state.enabled then\\n        writeJson files.state (compactState state)\\n        Synapses.Live.reset files\\n  Worker.cancel session \\\"search\\\"\\n  pure emptyHook\\n\\ndef stop (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  let turn := optionalString input \\\"turn_id\\\"\\n  let finalMessage := optionalString input \\\"last_assistant_message\\\"\\n  let current ← withHookSession input session fun files => do\\n    let some state ← readState? files | return false\\n    if !state.enabled then return false\\n    let active ← readPendingBase? files\\n    let current := active.any (matchesHookTurn · turn)\\n    let pending ← if current then pure active else do\\n      pure ((← turn.mapM (readClosedTurn? files)).join)\\n    let some pending := pending | return false\\n    unless pending.sessionId == session do throw (IO.userError \\\"terminal receipt belongs to another chat\\\")\\n    let sealed := sealPending pending finalMessage\\n    -- Queue first. A crash while updating lifecycle metadata cannot discard\\n    -- the already durable final answer, and replay is idempotent in the DB.\\n    queueCheckpoint files sealed\\n    Synapses.Live.answer input files sealed state\\n    if current then\\n      writeJson files.pending sealed\\n      writeJson files.state { state with epoch := state.epoch + 1, offers := [] }\\n    else writeJson (closedTurnPath files pending.turnId) sealed\\n    pure current\\n  if current then Worker.cancel session \\\"search\\\"\\n  pure emptyHook\\n\\ndef interrupt (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  withHookSession input session fun files => do\\n    if let some state ← readState? files then\\n      writeJson files.state { state with epoch := state.epoch + 1, offers := [] }\\n  Worker.cancel session \\\"search\\\"\\n  pure emptyHook\\n\\ndef sessionEnd (input : Json) : IO String := do\\n  let session ← IO.ofExcept (requiredString input \\\"session_id\\\")\\n  withHookSession input session fun files => do\\n    if let some pending ← readPendingBase? files then deferPending files pending\\n    if let some state ← readState? files then\\n      writeJson files.state { state with epoch := state.epoch + 1, offers := [] }\\n  Worker.cancel session \\\"search\\\"\\n  pure emptyHook\\n\\ndef dispatchHook (input : Json) : IO String := do\\n  let event ← IO.ofExcept (requiredString input \\\"hook_event_name\\\")\\n  match event with\\n  | \\\"SessionStart\\\" => sessionStart input\\n  | \\\"UserPromptSubmit\\\" => userPromptSubmit input\\n  | \\\"PreToolUse\\\" => preToolUse input\\n  | \\\"PostToolUse\\\" => postToolUse input\\n  | \\\"PostCompact\\\" => postCompact input\\n  | \\\"Stop\\\" => stop input\\n  | \\\"Interrupt\\\" => interrupt input\\n  | \\\"SessionEnd\\\" => sessionEnd input\\n  | other => throw (IO.userError s!\\\"unsupported Codex hook {other}\\\")\\n\\nend Eggshell.Plugin\\n\",[]]"],["Eggshell.PluginModel","[\"module\\n\\npublic import Eggshell.Config\\npublic import Eggshell.Blake3\\npublic import Eggshell.Lifecycle\\npublic import Eggshell.Receipt\\npublic import Eggshell.SourceEvidence\\npublic import Eggshell.SourceObservation\\npublic import Eggshell.ContentCapture\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin\\n\\nopen Lean\\n\\ninductive Projection where\\n  | automatic\\n  | none\\n  | roots (values : List String)\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\ninductive SemanticSearchStatus where\\n  | notRequested | completed | pending | timedOut | failed\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\ninductive SearchRoute where\\n  | configured | lexical\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\n/-- Runtime observations do not authorize equality or completion. -/\\nstructure SearchTrace where\\n  semantic : SemanticSearchStatus\\n  route : SearchRoute\\n  semanticMs : Nat\\n  lexicalMs : Nat\\n  warmMs : Nat := 0\\n  warmRequests : Nat := 0\\n  deriving Repr, ToJson, FromJson\\n\\nstructure DeliveryOffer where\\n  id : String\\n  stamp : RequestStamp\\n  graphs : List String\\n  text : String\\n  reason : String\\n  search : Option SearchTrace := none\\n  deriving Repr, ToJson, FromJson\\n\\nstructure ThreadState where\\n  profile : String\\n  /-- When false, hooks neither stage work nor read or send graph context. -/\\n  enabled : Bool := true\\n  nextProfile : Option String := none\\n  nextProjection : Option Projection := none\\n  deliveredGraphs : List String := []\\n  /-- Native history may have discarded previously visible staged Outcomes. -/\\n  afterCompaction : Bool := false\\n  lastHandoff : String := \\\"\\\"\\n  lastReason : String := \\\"\\\"\\n  lastSearch : Option SearchTrace := none\\n  /-- Record first versus subsequent eligible searches, including failed or empty results.\\n  This diagnostic marker is independent of acknowledgement, compaction and deadline allocation. -/\\n  searchStarted : Bool := false\\n  epoch : Nat := 0\\n  offers : List DeliveryOffer := []\\n  deriving Repr, ToJson, FromJson\\n\\n/-- Temporary claims expire; only client acknowledgements persist delivery. -/\\ndef ThreadState.deliveryClaims (state : ThreadState) (turn : String) (now : Nat) : List String :=\\n  (state.deliveredGraphs ++ (state.offers.filter (fun offer =>\\n    offer.stamp.accepts turn state.epoch now)).flatMap (·.graphs)).eraseDups\\n\\ntheorem expired_offer_is_not_a_claim (state : ThreadState) (turn : String) (now : Nat)\\n    (expired : ∀ offer ∈ state.offers, offer.stamp.accepts turn state.epoch now = false) :\\n    state.deliveryClaims turn now = state.deliveredGraphs.eraseDups := by\\n  have empty : state.offers.filter (fun offer => offer.stamp.accepts turn state.epoch now) = [] := by\\n    apply List.filter_eq_nil_iff.mpr\\n    intro offer present\\n    simp [expired offer present]\\n  simp [ThreadState.deliveryClaims, empty]\\n\\nstructure ToolEvent where\\n  name : String\\n  useId : String\\n  input : String\\n  response : String\\n  source : Option SourceEvidence.Capture := none\\n  contentInputs : Option SourceEvidence.Capture := none\\n  correspondence : Option ContentCapture.Captured := none\\n  deriving Repr, ToJson, FromJson\\n\\nstructure PendingTurn where\\n  sessionId : String\\n  turnId : String\\n  cwd : String\\n  prompt : String\\n  profile : String\\n  semanticMatcher : Option (List String)\\n  read : List String\\n  write : Option String\\n  handoffChars : Nat\\n  localUnion : Bool := true\\n  projection : Projection\\n  /--\\n  Native occurrences awaiting a possible PostToolUse result. Codex may omit the\\n  terminal hook, so this state is correlation only and never execution authority.\\n  -/\\n  inFlight : List ToolEvent := []\\n  tools : List ToolEvent := []\\n  /-- Related dependency descriptors, queued for the independent observer.\\n  These are locators/previous fingerprints, never evidence of new contents. -/\\n  sources : List SourceEvidence.File := []\\n  finalMessage : Option String := none\\n  closed : Bool := false\\n  deriving Repr, ToJson, FromJson\\n\\nstructure Promotion where\\n  outcomeRelations : List Value\\n\\n/-- The indexer receives the bounded owner view returned after DB publication,\\n    never from a merely compiled or staged turn. It is not a whole DB image. -/\\nstructure CommittedPromotion where\\n  snapshot : Graph\\n  outcomeRelations : List Value\\n  owners_in_snapshot : ∀ owner ∈ outcomeRelations, owner ∈ snapshot.values\\n\\ndef committedPromotion? (snapshot : Graph) (promotion : Promotion) :\\n    Option CommittedPromotion :=\\n  if members : promotion.outcomeRelations ⊆ snapshot.values then\\n    some {\\n      snapshot := snapshot\\n      outcomeRelations := promotion.outcomeRelations\\n      owners_in_snapshot := members }\\n  else none\\n\\ntheorem committedPromotion?_identity {snapshot : Graph} {promotion : Promotion}\\n    {committed : CommittedPromotion}\\n    (accepted : committedPromotion? snapshot promotion = some committed) :\\n    committed.snapshot = snapshot ∧\\n      committed.outcomeRelations = promotion.outcomeRelations := by\\n  unfold committedPromotion? at accepted\\n  split at accepted\\n  · cases accepted\\n    exact ⟨rfl, rfl⟩\\n  · cases accepted\\n\\ntheorem committed_index_owner_present (promotion : CommittedPromotion)\\n    (owner : Value) (present : owner ∈ promotion.outcomeRelations) :\\n    owner ∈ promotion.snapshot.values := promotion.owners_in_snapshot owner present\\n\\ndef prepareCommitted (snapshot : Graph)\\n    (promotion : Promotion) : IO CommittedPromotion := do\\n  let some committed := committedPromotion? snapshot promotion |\\n    throw (IO.userError \\\"published snapshot is missing a promoted outcome\\\")\\n  pure committed\\n\\nstructure SessionFiles where\\n  directory : System.FilePath\\n  state : System.FilePath\\n  pending : System.FilePath\\n  lock : System.FilePath\\n\\ndef safeSession (session : String) : Except String String :=\\n  if session != \\\"\\\" && session.toList.all fun character =>\\n      character.isAlphanum || character == '-' || character == '_' then\\n    pure session\\n  else throw \\\"Codex session ID contains a path-unsafe character\\\"\\n\\n/--\\nShared control-plane state must be visible to both Codex hooks and `!egg`.\\n`PLUGIN_DATA` is hook-only on some hosts, so using it would split one session\\nacross two directories. This root stores session state, daemon coordination,\\nand disposable matcher data; project-selected `.egg` authorities remain the\\nper-turn paths snapshotted in `PendingTurn`.\\n-/\\ndef dataRoot : IO System.FilePath := do\\n  Paths.dataRoot\\n\\ndef sessionFiles (session : String) : IO SessionFiles := do\\n  let safe ← match safeSession session with\\n    | .ok safe => pure safe\\n    | .error message => throw (IO.userError message)\\n  let directory := (← dataRoot) / \\\"sessions\\\" / safe\\n  pure {\\n    directory\\n    state := directory / \\\"state.json\\\"\\n    pending := directory / \\\"pending.json\\\"\\n    lock := directory / \\\"state\\\"\\n  }\\n\\ndef stateJsonDefaults : List (String × Json) :=\\n  [(\\\"searchStarted\\\", toJson false), (\\\"epoch\\\", toJson (0 : Nat)), (\\\"offers\\\", toJson ([] : List DeliveryOffer))]\\n\\ndef pendingJsonDefaults : List (String × Json) := [(\\\"closed\\\", toJson false)]\\n\\n/-- Add only fields introduced by this runtime. Existing malformed fields must\\n    still fail validation rather than being silently replaced. -/\\ndef readJson? [FromJson α] (path : System.FilePath)\\n    (defaults : List (String × Json) := []) : IO (Option α) := do\\n  if !(← path.pathExists) then pure none\\n  else\\n    let text ← IO.FS.readFile path\\n    let parsed ← match Json.parse text with\\n      | .ok json => pure json\\n      | .error message => throw (IO.userError s!\\\"{path}: {message}\\\")\\n    let parsed := match parsed with\\n      | .obj _ => defaults.foldl (fun json (key, value) =>\\n          if (json.getObjVal? key).isOk then json else json.setObjVal! key value) parsed\\n      | _ => parsed\\n    match fromJson? parsed with\\n    | .ok value => pure (some value)\\n    | .error message => throw (IO.userError s!\\\"{path}: {message}\\\")\\n\\ndef writeJson [ToJson α] (path : System.FilePath) (value : α) : IO Unit := do\\n  let path := ((← IO.currentDir) / path).normalize\\n  if let some parent := path.parent then Persistence.privateDirectory parent\\n  -- The receipt must survive a client or manager exit before its queued work\\n  -- is consumed. Publish only after the temporary bytes have been synced.\\n  FileSystem.atomicBytes path (toJson value |>.compress |>.toUTF8)\\n\\ndef readBoundedJson [FromJson α] (path : System.FilePath) (limit : Nat) : IO α := do\\n  let bytes ← FileSystem.boundedBytes path limit\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid JSON text encoding\\\")\\n  IO.ofExcept (Json.parse text >>= fromJson?)\\n\\ndef removeIfExists (path : System.FilePath) : IO Unit := do\\n  if ← path.pathExists then IO.FS.removeFile path\\n\\ndef withSession (session : String) (action : SessionFiles → IO α) : IO α := do\\n  let files ← sessionFiles session\\n  Persistence.privateDirectory files.directory\\n  Persistence.withLockWithin files.lock 100 (action files)\\n\\n/-- Corrupt control state is retained for diagnosis, never repeatedly parsed. -/\\ndef quarantine (path : System.FilePath) : IO Unit := do\\n  if ← path.pathExists then\\n    let suffix := toString (← IO.monoNanosNow)\\n    IO.FS.rename path (.mk (path.toString ++ \\\".corrupt-\\\" ++ suffix))\\n\\ndef readState? (files : SessionFiles) : IO (Option ThreadState) := do\\n  try readJson? files.state stateJsonDefaults\\n  catch error =>\\n    quarantine files.state\\n    let disabled : ThreadState := {\\n      profile := \\\"work\\\", enabled := false,\\n      lastReason := s!\\\"memory disabled after invalid session state: {error}\\\" }\\n    writeJson files.state disabled\\n    pure (some disabled)\\n\\ndef readPendingBase? (files : SessionFiles) : IO (Option PendingTurn) := do\\n  try readJson? files.pending pendingJsonDefaults\\n  catch error =>\\n    quarantine files.pending\\n    IO.eprintln s!\\\"Eggshell preserved an unreadable staged turn: {error}\\\"\\n    pure none\\n\\ndef toolDirectory (files : SessionFiles) (turn : String) : System.FilePath :=\\n  files.directory / \\\"tools\\\" / (Blake3.hex (Blake3.digest \\\"eggshell.turn\\\".toUTF8 [turn.toUTF8]))\\n\\n/-- Point-addressed lifecycle metadata, retained after a save job is consumed.\\nA late Stop/result must still have its original turn's destination and scope;\\nit must never borrow the currently active turn's metadata. -/\\ndef closedTurnPath (files : SessionFiles) (turn : String) : System.FilePath :=\\n  files.directory / \\\"closed\\\" /\\n    ((Blake3.hex (Blake3.digest \\\"eggshell.closed-turn\\\".toUTF8 [turn.toUTF8])) ++ \\\".json\\\")\\n\\ndef readClosedTurn? (files : SessionFiles) (turn : String) : IO (Option PendingTurn) := do\\n  let record ← (readJson? (closedTurnPath files turn) pendingJsonDefaults : IO (Option PendingTurn))\\n  pure (record.filter (fun pending => pending.turnId == turn && pending.closed))\\n\\ndef toolReceiptPath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  toolDirectory files turn /\\n    (Blake3.hex (Blake3.digest \\\"eggshell.tool\\\".toUTF8 [useId.toUTF8]) ++ \\\".json\\\")\\n\\ndef ToolEvent.native (tool : ToolEvent) : ToolEvent :=\\n  {tool with source := none,contentInputs := none,correspondence := none}\\n\\ntheorem native_receipt_ignores_source (tool : ToolEvent) (source : Option SourceEvidence.Capture) :\\n    ({tool with source}.native) = tool.native := rfl\\n\\ntheorem native_receipt_ignores_correspondence (tool : ToolEvent)\\n    (contentInputs : Option SourceEvidence.Capture) (correspondence : Option ContentCapture.Captured) :\\n    ({tool with contentInputs,correspondence}.native) = tool.native := rfl\\n\\nstructure SourceCertificate where\\n  stamp : String\\n  bytes : Nat\\n  source : SourceEvidence.Capture\\n  deriving ToJson, FromJson\\n\\nstructure ContentCertificate where\\n  stamp : String\\n  bytes : Nat\\n  captured : ContentCapture.Captured\\n  deriving ToJson, FromJson\\n\\ndef contentCertificatePath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  files.directory / \\\"correspondence\\\" / (toolDirectory files turn).fileName.getD \\\"\\\" /\\n    (toolReceiptPath files turn useId).fileName.getD \\\"\\\"\\n\\ndef sourceCertificatePath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  files.directory / \\\"sources\\\" / (toolDirectory files turn).fileName.getD \\\"\\\" /\\n    (toolReceiptPath files turn useId).fileName.getD \\\"\\\"\\n\\n/-- Parse bytes and observe their version through the same held descriptor.\\nA replaced or concurrently edited native receipt cannot authorize a companion. -/\\ndef readNativeTool? (path : System.FilePath) : IO (Option (ToolEvent × FileSystem.ReadVersion)) := do\\n  if (← FileSystem.regularMetadata? path).isNone then return none\\n  let handle ← FileSystem.openRead path.toString\\n  let before ← FileSystem.readVersion handle\\n  let mut bytes := ByteArray.empty\\n  while bytes.size < before.bytes do\\n    let count := min 4096 (before.bytes - bytes.size)\\n    let page ← FileSystem.readPage handle bytes.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    if page.size != count then throw (IO.userError \\\"short native receipt read\\\")\\n    bytes := bytes ++ page\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\\n  unless FileSystem.stableRead before after current bytes.size do\\n    throw (IO.userError \\\"native receipt changed during read\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"native receipt is not UTF-8\\\")\\n  let tool ← IO.ofExcept (Json.parse text >>= fromJson? (α := ToolEvent))\\n  pure (some (tool.native, before))\\n\\ndef attachCertificate (files : SessionFiles) (turn : String)\\n    (tool : ToolEvent) (version : FileSystem.ReadVersion) : IO ToolEvent := do\\n  let mut result := tool.native\\n  try\\n    if let some certificate ← (readJson? (sourceCertificatePath files turn tool.useId) :\\n        IO (Option SourceCertificate)) then\\n      if certificate.stamp == version.stamp && certificate.bytes == version.bytes then\\n        result := {result with source := some certificate.source}\\n  catch _ => pure () -- Optional provenance never discards the native result.\\n  try\\n    if let some certificate ← (readJson? (contentCertificatePath files turn tool.useId) :\\n        IO (Option ContentCertificate)) then\\n      if certificate.stamp == version.stamp && certificate.bytes == version.bytes then\\n        result := {result with correspondence := some certificate.captured}\\n  catch _ => pure ()\\n  return result\\n\\n/-- Journal the immutable body first; provenance is a small, version-bound\\ncompanion. An identical replay performs no body publication. Reusing a native\\nID for different bytes is an error, never replacement of an earlier result. -/\\ndef recordTool (files : SessionFiles) (turn : String) (tool : ToolEvent) : IO Unit := do\\n  let path := toolReceiptPath files turn tool.useId\\n  if let some (previous, _) ← readNativeTool? path then\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"conflicting native tool receipt ID\\\")\\n  else\\n    if let some parent := path.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes path (toJson tool.native |>.compress |>.toUTF8)\\n  if let some source := tool.source then\\n    let some (previous, version) ← readNativeTool? path |\\n      throw (IO.userError \\\"native receipt disappeared before source publication\\\")\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"source certificate belongs to another native result\\\")\\n    let certificate : SourceCertificate := ⟨version.stamp, version.bytes, source⟩\\n    let certificatePath := sourceCertificatePath files turn tool.useId\\n    if let some parent := certificatePath.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes certificatePath (toJson certificate |>.compress |>.toUTF8)\\n  if let some captured := tool.correspondence then\\n    let some (previous,version) ← readNativeTool? path |\\n      throw (IO.userError \\\"native receipt disappeared before content publication\\\")\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"content correspondence belongs to another native result\\\")\\n    let certificate : ContentCertificate := ⟨version.stamp,version.bytes,captured⟩\\n    let certificatePath := contentCertificatePath files turn tool.useId\\n    if let some parent := certificatePath.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes certificatePath (toJson certificate |>.compress |>.toUTF8)\\n\\ndef recordedTool? (files : SessionFiles) (turn : String) (tool : ToolEvent) : IO (Option ToolEvent) := do\\n  let some (previous, version) ← readNativeTool? (toolReceiptPath files turn tool.useId) | return none\\n  unless toJson previous == toJson tool.native do return none\\n  some <$> attachCertificate files turn previous version\\n\\n/-- Tool bodies are separate immutable receipts, not a growing JSON rewrite per hook. -/\\ndef loadToolReceipts (files : SessionFiles) (pending : PendingTurn) : IO PendingTurn := do\\n  let directory := toolDirectory files pending.turnId\\n  let mut tools := pending.tools\\n  if ← directory.pathExists then\\n    let entries := (← directory.readDir).toList.mergeSort (fun a b => a.fileName ≤ b.fileName)\\n    for entry in entries do\\n      if entry.fileName.endsWith \\\".json\\\" then\\n        try\\n          if let some (native, version) ← readNativeTool? entry.path then\\n            let tool ← attachCertificate files pending.turnId native version\\n            tools := tools.filter (·.useId != tool.useId) ++ [tool]\\n        catch error =>\\n          IO.eprintln s!\\\"Eggshell retained an unreadable tool receipt: {error}\\\"\\n  pure { pending with tools }\\n\\ndef readPending? (files : SessionFiles) : IO (Option PendingTurn) := do\\n  (← readPendingBase? files).mapM (loadToolReceipts files)\\n\\n/-- Immutable queue entries are removed only after the .egg commit succeeds. -/\\ndef queueCheckpoint (files : SessionFiles) (pending : PendingTurn) : IO Unit := do\\n  let key := Blake3.hex (Blake3.digest \\\"eggshell.checkpoint\\\".toUTF8\\n    [(toJson pending).compress.toUTF8])\\n  writeJson (files.directory / \\\"checkpoints\\\" / (key ++ \\\".json\\\")) pending\\n\\n/-- Independent observations have their own immutable identity. No native\\nresult or earlier source certificate is refreshed or attributed a later state. -/\\ndef observationTool (observation : SourceObservation.Observation limit) : ToolEvent :=\\n  let response := (SourceObservation.observationJson observation).compress\\n  let input := (Json.mkObj [(\\\"files\\\", toJson (observation.capture.record.files.map (·.relative)))]).compress\\n  { name := \\\"eggshell.observe_file\\\"\\n    useId := \\\"eggshell-observation:\\\" ++ Blake3.hex (Blake3.digest \\\"eggshell.observation.record\\\".toUTF8\\n      [input.toUTF8, response.toUTF8])\\n    input, response, source := some observation.capture }\\n\\ntheorem observation_binds_new_record (observation : SourceObservation.Observation limit) :\\n    (observationTool observation).source = some observation.capture ∧\\n      (observationTool observation).response = (SourceObservation.observationJson observation).compress :=\\n  ⟨rfl, rfl⟩\\n\\n/-- This save-worker operation observes registered related files regardless of\\nwhich command, program, editor or local provider changed them. The hook never\\ncalls it. Pending scans retain their queue entry and resume at a page cursor. -/\\ndef observeRelatedFiles (files : SessionFiles) (pending : PendingTurn) (deadline : Nat) : IO Bool := do\\n  let workspace := System.FilePath.mk pending.cwd\\n  let dependencies := (pending.tools.flatMap\\n    (fun tool => tool.source.map (·.record.files) |>.getD []) ++ pending.sources).eraseDups\\n  for file in dependencies do SourceObservation.register files.directory workspace file\\n  let mut finished := true\\n  for path in ← SourceObservation.entries files.directory workspace do\\n    if (← IO.monoMsNow) ≥ deadline then return false\\n    let observed ← try SourceObservation.step path workspace (128 * 1024) 256 deadline\\n      catch error =>\\n        IO.eprintln s!\\\"Eggshell retained source history; observation unavailable: {error}\\\"\\n        pure .unverified\\n    match observed with\\n    | .pending => finished := false\\n    | .unverified => pure ()\\n    | .complete snapshot observation =>\\n        if let some observation := observation then\\n          let tool := observationTool observation\\n          -- This durable queue contains the actual data and its certificate.\\n          -- It is not a native tool receipt: the running model has not seen\\n          -- this independent observation and it cannot bind its final answer.\\n          queueCheckpoint files {pending with tools := [tool], sources := [], inFlight := [], finalMessage := none, closed := false}\\n        SourceObservation.acknowledge path snapshot\\n  pure finished\\n\\ndef pendingSelection (pending : PendingTurn) : Config.Selection := {\\n  label := pending.profile\\n  semanticMatcher := pending.semanticMatcher\\n  read := pending.read.map fun raw => { name := raw, path := System.FilePath.mk raw }\\n  write := pending.write.map fun raw => { name := raw, path := System.FilePath.mk raw }\\n  handoffChars := pending.handoffChars\\n  localUnion := pending.localUnion\\n}\\n\\ndef valueEncoding (value : Value) : String :=\\n  Persistence.valueToJson value |>.compress\\n\\ndef indexOwnerKey (owner : Value) : String :=\\n  \\\"owner:\\\" ++ toString (hash owner)\\n\\ndef indexProviderKey (command : List String) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.index-provider\\\".toUTF8 [(toJson command).compress.toUTF8])\\n\\n/-- Executables belong to private installation configuration, never an imported DB. -/\\nstructure IndexTarget where\\n  owner : DB.Sidecar.Owner\\n  command : List String\\n  storage : DB.Sidecar.Storage := .database\\n  deriving Repr, BEq, ToJson, FromJson\\n\\ndef IndexTarget.key (target : IndexTarget) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.index-target\\\".toUTF8 [(toJson target).compress.toUTF8])\\n\\ndef IndexTarget.indexes (target : IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO System.FilePath := do\\n  pure ((← DB.Sidecar.locate snapshot target.storage).indexes / indexProviderKey target.command)\\n\\ndef indexRegistry : IO System.FilePath := do pure ((← dataRoot) / \\\"index-targets\\\")\\n\\ndef registerIndexTarget (snapshot : DB.PageMap.Snapshot) (command : List String)\\n    (writable : Bool := true) : IO IndexTarget := do\\n  if command.isEmpty then throw (IO.userError \\\"index provider must name an executable\\\")\\n  let owner := DB.Sidecar.Owner.ofSnapshot snapshot\\n  let (storage, _) ← DB.Sidecar.destination owner writable\\n  let target : IndexTarget := {owner, command, storage}\\n  let directory ← indexRegistry\\n  Persistence.rejectSymlinkAncestors directory\\n  Persistence.privateDirectory directory\\n  let path := directory / (target.key ++ \\\".json\\\")\\n  let bytes := (toJson target).compress.toUTF8\\n  unless bytes.size ≤ 65536 do throw (IO.userError \\\"index target exceeds metadata bound\\\")\\n  if ← path.pathExists then\\n    let previous ← FileSystem.boundedBytes path 65536\\n    if previous == bytes then return target\\n    let parsed : Except String IndexTarget := match String.fromUTF8? previous with\\n      | none => .error \\\"invalid index target encoding\\\"\\n      | some text => Json.parse text >>= fromJson?\\n    match parsed with\\n    | .ok _ => throw (IO.userError \\\"conflicting index target digest\\\")\\n    | .error error =>\\n        IO.eprintln s!\\\"Eggshell repairing a damaged index target: {error}\\\"\\n        quarantine path\\n  FileSystem.immutableBytes path bytes\\n  pure target\\n\\ndef registeredIndexTargets : IO (List (System.FilePath × IndexTarget)) := do\\n  let directory ← indexRegistry\\n  if !(← directory.pathExists) then return []\\n  let mut targets := []\\n  for entry in ((← directory.readDir).toList.mergeSort (fun a b => a.fileName ≤ b.fileName)) do\\n    if !entry.fileName.endsWith \\\".json\\\" then continue\\n    try\\n      let target ← (readBoundedJson entry.path 65536 : IO IndexTarget)\\n      unless entry.fileName == target.key ++ \\\".json\\\" && !target.command.isEmpty do\\n        throw (IO.userError \\\"index registry entry disagrees with its identity\\\")\\n      targets := targets ++ [(entry.path, target)]\\n    catch error => IO.eprintln s!\\\"Eggshell retained unreadable index target: {error}\\\"\\n  pure targets\\n\\n/-- Portable, data-only work. Provider hashes select locally registered lanes;\\nno executable or absolute destination is imported with a DB. -/\\nstructure IndexTicket where\\n  database : String\\n  provider : String\\n  authority : String\\n  roots : List String\\n  deriving ToJson, FromJson, BEq\\n\\ndef indexTicket (database provider : String)\\n    (promotion : CommittedPromotion) : IndexTicket := {\\n  database, provider\\n  authority := valueEncoding promotion.snapshot.authority\\n  roots := promotion.outcomeRelations.map indexOwnerKey |>.eraseDups\\n}\\n\\ntheorem index_ticket_root_is_published (database provider : String)\\n    (promotion : CommittedPromotion) (key : String)\\n    (present : key ∈ (indexTicket database provider promotion).roots) :\\n    ∃ owner ∈ promotion.snapshot.values, indexOwnerKey owner = key := by\\n  simp only [indexTicket, List.mem_eraseDups, List.mem_map] at present\\n  obtain ⟨owner, member, equal⟩ := present\\n  exact ⟨owner, promotion.owners_in_snapshot owner member, equal⟩\\n\\ndef queueIndex (target : String) (command : List String)\\n    (promotion : CommittedPromotion) : IO Unit := do\\n  let snapshot ← DB.PageMap.pin (.mk target)\\n  unless snapshot.head.authority == valueEncoding promotion.snapshot.authority do\\n    throw (IO.userError \\\"index publication belongs to another authority\\\")\\n  let target ← registerIndexTarget snapshot command\\n  let sidecar ← DB.Sidecar.prepare target.owner target.storage\\n  let directory ← DB.Sidecar.childDirectory sidecar.indexes (indexProviderKey command)\\n  let ticket := indexTicket snapshot.head.identity (indexProviderKey command) promotion\\n  let bytes := (toJson ticket).compress.toUTF8\\n  unless bytes.size ≤ 1048576 do throw (IO.userError \\\"index ticket exceeds metadata bound\\\")\\n  let key := Blake3.hex (Blake3.digest \\\"eggshell.index-ticket\\\".toUTF8\\n    [(toJson ticket).compress.toUTF8])\\n  FileSystem.immutableExistingBytes (directory / (key ++ \\\".json\\\")) bytes\\n\\ndef resolveIndexTicket (snapshot : Graph) (ticket : IndexTicket) : IO CommittedPromotion := do\\n  if valueEncoding snapshot.authority != ticket.authority then\\n    throw (IO.userError \\\"index ticket belongs to a different authority\\\")\\n  let candidates := snapshot.values.map fun owner => (indexOwnerKey owner, owner)\\n  let owners ← ticket.roots.mapM fun key => do\\n    match candidates.filter (fun candidate => candidate.1 == key) with\\n    | [(_, owner)] => pure owner\\n    | [] => throw (IO.userError \\\"published index owner is missing\\\")\\n    | _ => throw (IO.userError \\\"ambiguous index owner digest\\\")\\n  prepareCommitted snapshot { outcomeRelations := owners }\\n\\ndef valueKey (value : Value) : String :=\\n  Persistence.selectionKey value\\n\\ndef allNodes (composite : Persistence.Composite) : List Value :=\\n  composite.values.flatMap Value.nodes |>.eraseDups\\n\\ndef resolveKey (composite : Persistence.Composite) (key : String) : Except String Value :=\\n  match (allNodes composite).filter (valueKey · == key) with\\n  | [value] => pure value\\n  | [] => throw s!\\\"unknown Value {key}\\\"\\n  | _ => throw s!\\\"ambiguous display key {key}; inspect the full graph\\\"\\n\\n/-\\nNative JSON is identity-bearing data, not display framing. Lean's JSON object is\\nan ordered map, so parse-and-compress preserves keys, types, containers, array\\norder, and null while making object-key order irrelevant.\\n-/\\ndef canonicalJson (encoded : String) : String :=\\n  match Json.parse encoded with\\n  | .ok json => json.compress\\n  | .error _ => encoded\\n\\n/--\\nThe whole native invocation remains the reservation identity. Object-key order\\nis normalized, while every semantic distinction in the native input is retained.\\n-/\\ndef canonicalToolWork (tool : ToolEvent) : String :=\\n  tool.name ++ \\\"\\\\n\\\" ++ canonicalJson tool.input\\n\\n/--\\nRemember an admitted native occurrence for later PostToolUse correlation.\\nReservations never control execution because Codex does not emit a terminal\\nhook for every failed or externally blocked tool.\\n-/\\ndef reserveTool (pending : PendingTurn) (tool : ToolEvent) : PendingTurn :=\\n  { pending with\\n    inFlight := pending.inFlight.filter (·.useId != tool.useId) ++ [tool] }\\n\\n/-- Close exactly one native occurrence and retain one completed tool record. -/\\ndef finishTool (pending : PendingTurn) (tool : ToolEvent) : PendingTurn :=\\n  { pending with\\n    inFlight := pending.inFlight.filter (fun current => current.useId != tool.useId)\\n    tools := pending.tools.filter (fun current => current.useId != tool.useId) ++ [tool] }\\n\\n/-- A denied or failed PreToolUse releases only its own transient reservation. -/\\ndef cancelTool (pending : PendingTurn) (useId : String) : PendingTurn :=\\n  { pending with inFlight := pending.inFlight.filter (·.useId != useId) }\\n\\n/-- A session owns one pending turn; an omitted hook turn ID denotes that turn. -/\\ndef matchesHookTurn (pending : PendingTurn) : Option String → Bool\\n  | none => true\\n  | some turn => turn == pending.turnId\\n\\n@[simp] theorem matchesHookTurn_omitted (pending : PendingTurn) :\\n    matchesHookTurn pending none = true := rfl\\n\\ntheorem cancelTool_removes_useId (pending : PendingTurn) (useId : String) :\\n    (cancelTool pending useId).inFlight.all (·.useId != useId) := by\\n  simp [cancelTool]\\n\\ndef relation? (operator : Operator) (arguments : List Ref) : Except String Value :=\\n  match Relation.apply? operator arguments with\\n  | some relation => pure relation\\n  | none => throw s!\\\"invalid {Persistence.operatorName operator} relation\\\"\\n\\n/-- One native invocation owns exactly one observed Work→Outcome edge. -/\\ndef observedWorkOutcome (work observed occurrence : Value) : Value × Value :=\\n  let edge := OutcomeEdge.make work observed [occurrence]\\n    (by simp) (by simp [maxOutcomeObservations])\\n  (work, edge.relation)\\n\\n@[simp]\\ntheorem observedWorkOutcome_work (work observed occurrence : Value) :\\n    (observedWorkOutcome work observed occurrence).1 = work := rfl\\n\\n/--\\nOne native occurrence cites its Work and Outcome once. Session, turn, and the\\nnative tool-use ID are the exact occurrence identity; repeating the raw input\\nand response here would retain the same payload twice without adding authority.\\n-/\\ndef nativeOccurrenceArguments (session turn : Value) (tool : ToolEvent) : List Ref :=\\n  [\\n    .semantic (.text (canonicalJson tool.response)),\\n    .semantic (.text (canonicalToolWork tool)),\\n    .exact session,\\n    .exact turn,\\n    .exact (.text tool.useId)]\\n\\ndef nativeOccurrence (session turn : Value) (tool : ToolEvent) : Value :=\\n  .applyList .occurrence (nativeOccurrenceArguments session turn tool)\\n\\ntheorem nativeOccurrence_valid (session turn : Value) (tool : ToolEvent) :\\n    Relation.validArguments .occurrence\\n      (nativeOccurrenceArguments session turn tool) := by\\n  have semantic : (Authority.semantic == Authority.semantic) = true := by decide\\n  have exact : (Authority.exact == Authority.semantic) = false := by decide\\n  simp [nativeOccurrenceArguments, Relation.validArguments,\\n    Relation.splitOccurrence, Relation.semanticValues, Relation.exactValues,\\n    Ref.semantic, Ref.exact, List.takeWhile, semantic, exact]\\n\\ntheorem nativeOccurrence_exactFootprint (session turn : Value) (tool : ToolEvent) :\\n    (nativeOccurrence session turn tool).exactFootprint =\\n      session :: session.exactFootprint ++\\n      turn :: turn.exactFootprint ++ [.text tool.useId] := by\\n  simp [nativeOccurrence, nativeOccurrenceArguments, Value.applyList,\\n    Refs.ofList, Value.exactFootprint, Value.refsExactFootprint,\\n    Ref.semantic, Ref.exact, Value.text]\\n\\n/-\\nNative tool facts have one compiler regardless of whether they are still\\nstaged or are being promoted.  The active turn can therefore join the same\\nrun-local WorkGraph as committed `.egg` authorities without inventing a\\nsecond trace format or granting the stage persistent authority.\\n-/\\ndef compileOperationOutcomes (session turn : Value) (tool : ToolEvent) :\\n    Value × Value :=\\n  let work := Value.text (canonicalToolWork tool)\\n  let observed := Value.text (canonicalJson tool.response)\\n  observedWorkOutcome work observed (nativeOccurrence session turn tool)\\n\\ndef operationChildren (pending : PendingTurn) : List Value :=\\n  ((pending.tools.map fun tool =>\\n    (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).1).eraseDups) ++\\n    [HandoffRemainder.value pending.prompt]\\n\\ntheorem operation_checkpoint_keeps_open_remainder (pending : PendingTurn) :\\n    HandoffRemainder.value pending.prompt ∈ operationChildren pending := by\\n  simp [operationChildren]\\n\\ndef compileOperationGraph (pending : PendingTurn) : Except String (List Value × Value) := do\\n  let facts := pending.tools.map (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId))\\n  let all ← relation? .all\\n    (.semantic (.text pending.prompt) :: (operationChildren pending).map Ref.semantic)\\n  pure (facts.map (·.2), all)\\n\\ndef operationSourceReceipts (pending : PendingTurn) : List Value :=\\n  pending.tools.filterMap fun tool => tool.source.map fun capture =>\\n    let owner := (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).2\\n    SourceEvidence.receipt (.text pending.sessionId) (.text pending.turnId)\\n      (.text tool.useId) owner capture.record\\n\\ntheorem operation_owner_ignores_source (session turn : Value) (tool : ToolEvent)\\n    (source : Option SourceEvidence.Capture) :\\n    compileOperationOutcomes session turn {tool with source} =\\n      compileOperationOutcomes session turn tool := rfl\\n\\ntheorem operation_owner_ignores_correspondence (session turn : Value) (tool : ToolEvent)\\n    (contentInputs : Option SourceEvidence.Capture) (correspondence : Option ContentCapture.Captured) :\\n    compileOperationOutcomes session turn {tool with contentInputs,correspondence} =\\n      compileOperationOutcomes session turn tool := rfl\\n\\n/--\\nAn unresolved native occurrence and a missing final message cannot affect the\\nobserved operation graph.  Recovery may therefore retain exactly the terminal\\ntool outcomes while leaving the parent Work open.\\n-/\\ntheorem compileOperationGraph_ignores_unobserved (pending : PendingTurn)\\n    (inFlight : List ToolEvent) (finalMessage : Option String) :\\n    compileOperationGraph {\\n      pending with inFlight := inFlight, finalMessage := finalMessage\\n    } = compileOperationGraph pending := by\\n  rfl\\n\\n/-- The active turn joins the same positive graph shape later promoted to `.egg`. -/\\ndef stagedGraphValues (pending : PendingTurn) : Except String (List Value) := do\\n  let (outcomes, all) ← compileOperationGraph pending\\n  pure (outcomes ++ [all] ++ operationSourceReceipts pending)\\n\\ndef turnSources (pending : PendingTurn) : SourceEvidence.Record :=\\n  let records := pending.tools.map fun tool =>\\n    tool.source.map (·.record) |>.getD SourceEvidence.unverified\\n  { workspace := (System.FilePath.mk pending.cwd).fileName.getD pending.cwd\\n    files := records.flatMap (·.files) |>.eraseDups\\n    uris := records.flatMap (·.uris) |>.eraseDups\\n    -- A listing or provider with no file observations does not erase the\\n    -- independently sealed file state. The answer still has an open domain\\n    -- and therefore cannot complete a later native operation.\\n    complete := records.any (fun record => !record.files.isEmpty) &&\\n      (records.filter (fun record => !record.files.isEmpty)).all (·.complete)\\n    closed := !records.isEmpty && records.all (fun record => record.complete && record.closed) }\\n\\nstructure CompiledTurn (source : Graph) where\\n  transaction : Transaction\\n  promotion : Promotion\\n  transaction_authority : transaction.authority = source.authority\\n  transaction_revision : transaction.baseRevision = source.revision\\n\\ndef compile (graph : Graph) (pending : PendingTurn) (target : String) :\\n    Except String (CompiledTurn graph) := do\\n  let session := Value.text pending.sessionId\\n  let turn := Value.text pending.turnId\\n  let cwd := Value.text pending.cwd\\n  let task := Value.text pending.prompt\\n  let (outcomeRelations, all) ← compileOperationGraph pending\\n  let targetValue := Value.text target\\n  let (values, promotedOutcomes) ← match pending.finalMessage with\\n    | some finalMessage =>\\n        let result := Value.text finalMessage\\n        let turnOccurrence ← relation? .occurrence [\\n          .semantic task, .semantic result, .exact session, .exact turn, .exact cwd]\\n        let parentOutcome ← relation? .outcome [\\n          .semantic task, .semantic result, .exact turnOccurrence]\\n        let receipt ← relation? .receipt [\\n          .exact session, .exact turn, .exact task, .exact result,\\n          .exact parentOutcome, .exact all, .exact targetValue]\\n        let sourceReceipts := if pending.tools.any (·.source.isSome) then\\n          [SourceEvidence.receipt session turn (.text \\\"parent\\\") parentOutcome (turnSources pending)] else []\\n        pure\\n          ((outcomeRelations ++ [all, parentOutcome, receipt] ++ sourceReceipts ++ operationSourceReceipts pending).eraseDups,\\n            outcomeRelations ++ [parentOutcome])\\n    | none =>\\n        if pending.tools.isEmpty then\\n          throw \\\"cannot promote an interrupted turn without observed outcomes\\\"\\n        let receipt ← relation? .receipt [\\n          .exact session, .exact turn, .exact task, .exact cwd,\\n          .exact all, .exact targetValue, .exact (.text \\\"interrupted before final response\\\")]\\n        pure ((outcomeRelations ++ [all, receipt] ++ operationSourceReceipts pending).eraseDups, outcomeRelations)\\n  /-\\n  Only authoritative relation roots are stored. Their structural Values contain\\n  every Atom and occurrence, so duplicating that closure as top-level records\\n  changes no semantics and only inflates `.egg`.\\n  -/\\n  match accepted : (Transaction.begin graph).stageValues? (values.filter (!graph.values.contains ·)) with\\n  | none => throw \\\"turn compiler produced an invalid Value\\\"\\n  | some transaction =>\\n      have source := Transaction.stageValues?_preserves_source accepted\\n      pure {\\n        transaction\\n        promotion := {\\n          outcomeRelations := promotedOutcomes\\n        }\\n        transaction_authority := source.1\\n        transaction_revision := source.2\\n      }\\n\\ntheorem compiled_transaction_belongs_to_source {graph pending target compiled}\\n    (_accepted : compile graph pending target = .ok compiled) :\\n    compiled.transaction.authority = graph.authority ∧\\n      compiled.transaction.baseRevision = graph.revision :=\\n  ⟨compiled.transaction_authority, compiled.transaction_revision⟩\\n\\ntheorem compiled_values_are_well_formed {graph : Graph}\\n    (compiled : CompiledTurn graph) :\\n    ∀ value, value ∈ compiled.transaction.stagedValues →\\n      Relation.wellFormed value :=\\n  compiled.transaction.stagedValues_wellFormed\\n\\n/-- Outcome roots in a live checkpoint come only from observed native operations. -/\\ndef observedRoots (pending : PendingTurn) : List Value :=\\n  pending.tools.map fun tool =>\\n    (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).2\\n\\ntheorem checkpoint_ignores_parent_status (pending : PendingTurn)\\n    (finalMessage : Option String) (inFlight : List ToolEvent) :\\n    observedRoots { pending with finalMessage, inFlight } = observedRoots pending := by\\n  rfl\\n\\ntheorem checkpoint_has_only_observed_roots (pending : PendingTurn) (root : Value)\\n    (present : root ∈ observedRoots pending) :\\n    ∃ tool ∈ pending.tools,\\n      (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).2 = root := by\\n  simpa [observedRoots] using present\\n\\nend Eggshell.Plugin\\n\",[]]"],["Eggshell.PreparationDebt","[\"module\\npublic import Eggshell.DB.Sidecar\\npublic import Eggshell.Receipt\\n\\n@[expose] public section\\nnamespace Eggshell.PreparationDebt\\nopen Lean DB\\n\\n/-- Actual cache observations only; a search deadline is not repair debt. -/\\ninductive Reason where\\n  | unavailableInput\\n  deriving BEq, ToJson, FromJson\\n\\nstructure Event where\\n  database : String\\n  model : String\\n  encoder : String\\n  reason : Reason\\n  windows : Nat\\n  deriving ToJson, FromJson\\n\\ndef directory (owner : Sidecar.Owner) (model encoder : String) : IO System.FilePath := do\\n  unless Receipt.validId owner.database do throw (IO.userError \\\"invalid repair owner\\\")\\n  return (← Paths.dataRoot) / \\\"repair\\\" / owner.database /\\n    Sha256.hex (toJson [model,encoder]).compress.toUTF8\\n\\n/-- Each immutable event has a unique id. Acknowledge only captured ids, so\\nan event arriving during repair cannot be erased with the old requests.\\nNo query, tool arguments, output text or original path is persisted here. -/\\ndef record (owner : Sidecar.Owner) (model encoder : String) (reason : Reason)\\n    (windows : Nat) : IO Unit := do\\n  if windows == 0 then return\\n  let path ← directory owner model encoder\\n  FileSystem.privateDirectory path\\n  let event : Event := ⟨owner.database,model,encoder,reason,windows⟩\\n  FileSystem.immutableExistingBytes (path / (← Receipt.fresh)) (toJson event).compress.toUTF8\\n\\ndef pending (owner : Sidecar.Owner) (model encoder : String) : IO Bool := do\\n  let path ← directory owner model encoder\\n  FileSystem.rejectSymlinkAncestors path\\n  if (← FileSystem.symlinkMetadata? path).isNone then return false\\n  return !(← path.readDir).isEmpty\\n\\ndef capture (owner : Sidecar.Owner) (model encoder : String) : IO (List String) := do\\n  let path ← directory owner model encoder\\n  FileSystem.rejectSymlinkAncestors path\\n  if (← FileSystem.symlinkMetadata? path).isNone then return []\\n  let entries ← path.readDir\\n  let mut ids := []\\n  for entry in entries.toList.take 4096 do\\n    unless Receipt.validId entry.fileName do throw (IO.userError \\\"invalid repair event identity\\\")\\n    let bytes ← FileSystem.boundedBytes entry.path 2048\\n    let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid repair event encoding\\\")\\n    let event : Event ← IO.ofExcept (Json.parse text >>= fromJson?)\\n    unless event.database == owner.database && event.model == model && event.encoder == encoder &&\\n        event.windows > 0 do throw (IO.userError \\\"foreign or empty repair event\\\")\\n    ids := entry.fileName :: ids\\n  return ids\\n\\ndef acknowledge (owner : Sidecar.Owner) (model encoder : String) (ids : List String) : IO Unit := do\\n  let path ← directory owner model encoder\\n  for id in ids do\\n    unless Receipt.validId id do throw (IO.userError \\\"invalid acknowledged repair event\\\")\\n    let file := path / id\\n    FileSystem.rejectSymlinkAncestors file\\n    if (← FileSystem.symlinkMetadata? file).isSome then IO.FS.removeFile file\\n  if !ids.isEmpty then FileSystem.syncPath path.toString true\\n\\ntheorem different_event_not_acknowledged (captured : List String) (newEvent : String)\\n    (fresh : newEvent ∉ captured) : captured.contains newEvent = false := by\\n  apply Bool.eq_false_iff.mpr\\n  intro present\\n  exact fresh (List.contains_iff_mem.mp present)\\n\\nend Eggshell.PreparationDebt\\n\",[]]"],["Eggshell.PublicationClient","[\"module\\n\\npublic import Eggshell.PublicationWire\\npublic import Eggshell.Numerical\\npublic import Eggshell.CanonicalSourcePrepared\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin.Publication.Client\\nopen Lean DB\\n\\nstructure SourceReference where\\n  endpoint : Daemon.Endpoint\\n  access : Synapses.CanonicalSource.Shared.Access\\n\\ndef SourceReference.metadata (reference : SourceReference) := reference.access.metadata\\n\\ndef SourceReference.identity (reference : SourceReference) : Json := reference.access.identity\\n\\ndef liveBudget (deadline : Nat) : IO Nat := do\\n  let now ← IO.monoMsNow\\n  unless now < deadline do throw (IO.userError \\\"prepared source request expired\\\")\\n  return min maxBudgetMs (deadline-now)\\n\\n/-- An explicitly supplied data-side owner is useful to native clients and\\ndoes not require a writer registration for a read-only source. -/\\ndef prepareSourceUsing (endpoint : Daemon.Endpoint) (source : PageMap.Snapshot)\\n    (storage : Sidecar.Storage) (deadline : Nat) : IO (Option SourceReference) := do\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange endpoint \\\"prepare-source\\\" (Json.mkObj [\\n    (\\\"directory\\\",toJson source.directory.toString),(\\\"source\\\",toJson source.head),(\\\"storage\\\",toJson storage),\\n    (\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let value ← IO.ofExcept (Json.parse response)\\n  if value == Json.null then return none\\n  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)\\n  unless access.database == source.head.identity && access.source == source.head &&\\n      access.metadata.source.identity == source.head.identity && Synapses.digest access.scope &&\\n      Synapses.digest access.capability &&\\n      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do\\n    throw (IO.userError \\\"prepared source reply changed its scope or source\\\")\\n  return some ⟨{endpoint with secret := access.capability},access⟩\\n\\n/-- After local administration grants a read scope, refreshing it needs only\\nthat scope's read capability, including when the publisher is another owner. -/\\ndef SourceReference.refresh (reference : SourceReference) (source : PageMap.Head)\\n    (deadline : Nat) : IO (Option SourceReference) := do\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange reference.endpoint \\\"refresh-source\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson reference.access.database),(\\\"scope\\\",toJson reference.access.scope),\\n    (\\\"source\\\",toJson (some source)),(\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let value ← IO.ofExcept (Json.parse response)\\n  if value == Json.null then return none\\n  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)\\n  unless access.database == reference.access.database && access.scope == reference.access.scope &&\\n      access.capability == reference.access.capability && access.source == source &&\\n      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do\\n    throw (IO.userError \\\"prepared source refresh changed its read authority\\\")\\n  return some ⟨reference.endpoint,access⟩\\n\\ndef sourceRows (reference : SourceReference) (owners : Array String) (deadline : Nat) :\\n    IO Synapses.CanonicalSource.Shared.Projection := do\\n  let access := reference.access\\n  let owners := (hashDistinct owners.toList).toArray\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange reference.endpoint \\\"source-rows\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson access.database),(\\\"scope\\\",toJson access.scope),(\\\"source\\\",toJson access.source),\\n    (\\\"metadata\\\",toJson access.metadata),(\\\"owners\\\",toJson owners),(\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let result ← IO.ofExcept (Json.parse response >>= fromJson? (α := Synapses.CanonicalSource.Shared.Projection))\\n  unless result.identity == reference.identity && result.rows.map Prod.fst == owners do\\n    throw (IO.userError \\\"prepared source projection changed its owner domain\\\")\\n  for (owner,rows) in result.rows do\\n    unless rows.all (fun row => row.origins.all (fun origin =>\\n        origin.binding.database == access.database && origin.binding.owner == owner)) do\\n      throw (IO.userError \\\"prepared source projection crossed its owner scope\\\")\\n    let _ ← IO.ofExcept (Synapses.CanonicalSource.load access.database rows)\\n    pure ()\\n  return result\\n\\ndef endpoint? : IO (Option Daemon.Endpoint) := do\\n  readJson? ((← directory) / \\\"endpoint.json\\\") []\\n\\ndef sourceRecords (reference : SourceReference) (owners : Array String) (deadline : Nat) :\\n    IO (Array (String × Option Synapses.ObservedRecordView.View)) := do\\n  let access := reference.access\\n  let owners := (hashDistinct owners.toList).toArray\\n  let budget ← liveBudget deadline\\n  let response ← Daemon.exchange reference.endpoint \\\"source-records\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson access.database),(\\\"scope\\\",toJson access.scope),(\\\"source\\\",toJson access.source),\\n    (\\\"metadata\\\",toJson access.metadata),(\\\"owners\\\",toJson owners),(\\\"budgetMs\\\",toJson budget)]) (budget := budget)\\n  let (head,rows) ← IO.ofExcept (Json.parse response >>=\\n    fromJson? (α := PageMap.Head × Array (String × Option Synapses.ObservedRecordView.View)))\\n  unless head == access.source && rows.map Prod.fst == owners do\\n    throw (IO.userError \\\"original record projection changed its requested source or owner domain\\\")\\n  for (owner,found) in rows do\\n    if let some view := found then\\n      unless view.header.database == access.database && view.header.owner == owner do\\n        throw (IO.userError \\\"original record view crossed its read scope\\\")\\n  return rows\\n\\ndef ready (endpoint : Daemon.Endpoint) : IO Unit := do\\n  unless endpoint.session == \\\"publisher\\\" && endpoint.compatible (← generation) do\\n    throw (IO.userError \\\"publisher executable identity differs from this caller\\\")\\n  let _ ← Daemon.exchange endpoint \\\"ping\\\" (budget := 500)\\n  pure ()\\n\\ndef resolve : IO Daemon.Endpoint := do\\n  let root ← directory\\n  if let some endpoint ← endpoint? then\\n    if endpoint.compatible (← generation) then\\n      let reachable ← try ready endpoint; pure true catch _ => pure false\\n      if reachable then return endpoint\\n  Persistence.withLockWithin (root / \\\"starting\\\") 10000 do\\n    if let some endpoint ← endpoint? then\\n      let live ← Numerical.alive endpoint.pid\\n      if live then\\n        if endpoint.compatible (← generation) then\\n          ready endpoint\\n          return endpoint\\n        throw (IO.userError \\\"shared data service uses another implementation; explicitly stop its owner before replacement\\\")\\n      else removeIfExists (root / \\\"endpoint.json\\\")\\n    let child ← IO.Process.spawn {\\n      cmd := (← IO.appPath).toString,args := #[\\\"codex-publication-daemon\\\"]\\n      stdin := .null,stdout := .null,stderr := .inherit,setsid := true }\\n    let deadline := (← IO.monoMsNow)+10000\\n    repeat\\n      unless (← child.tryWait).isNone do throw (IO.userError \\\"publisher exited during startup\\\")\\n      if let some endpoint ← endpoint? then\\n        unless endpoint.pid == child.pid.toNat do throw (IO.userError \\\"publisher startup returned another owner\\\")\\n        ready endpoint\\n        return endpoint\\n      unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"publisher startup expired\\\")\\n      IO.sleep 5\\n    throw (IO.userError \\\"unreachable publisher startup\\\")\\n\\ndef prepareSource (source : PageMap.Snapshot) (storage : Sidecar.Storage)\\n    (deadline : Nat) : IO (Option SourceReference) := do\\n  prepareSourceUsing (← resolve) source storage deadline\\n\\ndef register (endpoint : Daemon.Endpoint) (path : System.FilePath) (identity : String) : IO Project := do\\n  let response ← Daemon.exchange endpoint \\\"register\\\" (Json.mkObj [\\n    (\\\"directory\\\",toJson path.toString),(\\\"database\\\",toJson identity)]) (budget := 5000)\\n  let project ← IO.ofExcept (Json.parse response >>= fromJson? (α := Project))\\n  unless project.database == identity && Synapses.digest project.capability do\\n    throw (IO.userError \\\"publisher granted another database\\\")\\n  return project\\n\\ndef submit (endpoint : Daemon.Endpoint) (project : Project) (capsule : Capsule) : IO NativePublication.SourceReceipt := do\\n  let peer := {endpoint with secret := project.capability}\\n  let response ← Daemon.exchange peer \\\"publish\\\" (Json.mkObj [\\n    (\\\"database\\\",toJson project.database),(\\\"capsule\\\",toJson capsule)]) (budget := maxBudgetMs)\\n  let receipt ← IO.ofExcept (Json.parse response >>= fromJson? (α := NativePublication.SourceReceipt))\\n  unless receipt.accounted && receipt.head.identity == project.database do\\n    throw (IO.userError \\\"publisher returned an unrelated source ACK\\\")\\n  return receipt\\n\\n/-- Reconstruct only the submitted view from the authenticated durable ACK.\\nThe service does not send the whole DB or duplicate every graph Value. -/\\ndef restore (request : NativePublication.Prepared) (receipt : NativePublication.SourceReceipt) : IO NativePublication.Published := do\\n  let expected := NativePublication.receipt request.items receipt.head\\n  unless (toJson expected).compress == (toJson receipt).compress do\\n    throw (IO.userError \\\"publisher source coverage differs from the native request\\\")\\n  let authority ← IO.ofExcept (Json.parse receipt.head.authority >>=\\n    Persistence.valueFromJson (receipt.head.authority.length+1))\\n  let header := {Graph.empty authority with revision := receipt.head.revision}\\n  let (transaction,promotion) ← IO.ofExcept (NativePublication.compilePrepared header request.target request)\\n  let submitted : Graph := {\\n    authority,revision := receipt.head.revision,values := transaction.stagedValues,unions := []\\n    values_wellFormed := transaction.stagedValues_wellFormed }\\n  return ⟨← prepareCommitted submitted promotion,receipt⟩\\n\\ndef run (pending : PendingTurn) (target : System.FilePath) (checkpoint : Bool) : IO NativePublication.Published := do\\n  let target ← PageMap.absolute target\\n  let source ← match ← PageMap.open? target with\\n    | some source => pure source\\n    | none => Persistence.withLock target (Persistence.ensureSnapshot target)\\n  let request ← NativePublication.prepare pending target checkpoint\\n  let endpoint ← resolve\\n  let project ← register endpoint target source.head.identity\\n  let receipt ← submit endpoint project (Capsule.ofPrepared request)\\n  restore request receipt\\n\\ndef control (kind : String) : IO String := do\\n  unless #[\\\"stats\\\",\\\"shutdown\\\"].contains kind do throw (IO.userError \\\"unknown publication control operation\\\")\\n  let some endpoint ← endpoint? | return \\\"null\\\"\\n  Daemon.exchange endpoint kind (budget := 5000)\\n\\nend Eggshell.Plugin.Publication.Client\\n\\nnamespace Eggshell.Plugin\\n\\ndef promote (pending : PendingTurn) (target : System.FilePath) : IO NativePublication.Published :=\\n  Publication.Client.run pending target false\\n\\ndef promoteObservations (pending : PendingTurn) (target : System.FilePath) : IO NativePublication.Published :=\\n  Publication.Client.run pending target true\\n\\nend Eggshell.Plugin\\n\",[]]"],["Eggshell.PublicationWire","[\"module\\n\\npublic import Eggshell.NativePublication\\npublic import Eggshell.DaemonWire\\npublic import Eggshell.CanonicalSourcePrepared\\npublic import Eggshell.ObservedRecordVie
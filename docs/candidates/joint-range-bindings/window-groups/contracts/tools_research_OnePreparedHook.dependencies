ans. -/\\ndef Prepared.catalog (prepared : Prepared doc) (database : String) : Catalog := Id.run do\\n  let mut catalog : Catalog := {located := (recordedReads database doc).toOption.getD #[]}\\n  let files := (catalog.located.flatMap (·.originalRows)).qsort (fun a b => a.binding.limit < b.binding.limit)\\n  if let some index := prepared.json then\\n    for leaf in index.leaves do\\n      let scalar := leaf.scalar\\n      let member := String.ofList (prepared.rawChars.extract scalar.contextFirst scalar.limit).toList\\n      let aliases := #[scalar.literal,member] ++ scalar.text.toArray\\n      catalog := catalog.add prepared database files scalar.contextFirst scalar.limit aliases\\n      if let some text := scalar.text then\\n        if text.contains '\\\\n' then\\n          for line in textLines text do\\n            let some first := scalar.offsets[line.first]? | continue\\n            let some limit := scalar.offsets[line.limit]? | continue\\n            let raw := String.ofList (prepared.rawChars.extract first limit).toList\\n            catalog := catalog.add prepared database files first limit #[line.text,raw]\\n    if index.leaves.isEmpty then\\n      catalog := catalog.add prepared database files 0 prepared.rawChars.size #[prepared.raw]\\n  else\\n    for line in textLines prepared.raw do\\n      let payload := String.ofList (prepared.rawChars.extract line.first line.limit).toList\\n      catalog := catalog.add prepared database files line.first line.limit #[line.text,payload]\\n  return catalog\\n\\ndef recorded (database : String) (doc : Document) : Option Catalog := do\\n  return (← prepare? doc).catalog database\\n\\n/-- File certification remains optional. General rows are located only when\\nthe actual completed call has the complete saved invocation and output. -/\\ndef locateUsing (database : String) (doc : Document) (trace : Trace)\\n    (catalog : Catalog) : Array LocatedRead := Id.run do\\n  let mut result := (locateReads database doc trace).toOption.getD #[]\\n  let some raw := doc.source | return result\\n  let .ok (input,format) := invocationData (doc.workText.getD \\\"\\\") | return result\\n  let native := catalog.located.filter (·.read.source.file?.isNone)\\n  for occurrence in doc.occurrences do\\n    let some started := trace.starts[occurrence]? | continue\\n    if started.command != input || started.format != format || trace.finished[occurrence]? != some raw then continue\\n    for located in native do\\n      let read := {located.read with occurrence}\\n      result := result.push {located with read,originalRows := #[read]}\\n  return result\\n\\ndef locate (database : String) (doc : Document) (trace : Trace) : Array LocatedRead :=\\n  locateUsing database doc trace ((recorded database doc).getD {})\\n\\n/-- Exact quoted spellings provide advisory support/coquotation. The caller\\nrestricts the catalog to the answer's actual All-reachable source owners.\\nThis records an observed citation, not the truth or causality of a claim. -/\\ndef addQuotedAnswer (database : String) (doc : Document) (spellings : Array Quotation)\\n    (graph : Graph) : Except String Graph := do\\n  let decoded ← layout (doc.source.getD \\\"\\\")\\n  let byText := spellings.foldl (fun (map : Std.HashMap String (Array Read)) item =>\\n    map.insert item.text (map[item.text]?.getD #[] |>.push item.read)) {}\\n  let mut graph := graph\\n  let mut position := 0\\n  for paragraph in decoded.text.splitOn \\\"\\\\n\\\\n\\\" do\\n    let limit := position+paragraph.length\\n    if position < limit then\\n      let claim : Claim := ⟨database,doc.owner,decoded.offsets[position]!,decoded.offsets[limit]!⟩\\n      for quote in Quotes.extract paragraph do\\n        for read in byText[quote.text]?.getD #[] do\\n          graph ← graph.insert (.read read)\\n          let support ← Support.checked read read.source claim\\n          graph ← graph.insert (.supports support)\\n          graph ← graph.insert (.coquoted (.claim claim) read.source)\\n          graph ← graph.insert (.coquoted (.answer database doc.owner) read.source)\\n    position := limit+2\\n  return graph\\n\\nend Eggshell.Synapses.ObservationContext\\n\"],[\"Sha256.lean\",\"module\\n\\npublic import Eggshell.Blake3\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Sha256\\n\\ndef constants : Array UInt32 := #[\\n  0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\\n  0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\\n  0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\\n  0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\\n  0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\\n  0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\\n  0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\\n  0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]\\n\\ndef rotate (x : UInt32) (n : UInt32) : UInt32 := (x >>> n) ||| (x <<< (32-n))\\n\\ndef compress (state : Array UInt32) (bytes : ByteArray) (offset : Nat) : Array UInt32 := Id.run do\\n  let mut words := #[]\\n  for i in [0:16] do\\n    let p := offset + i*4\\n    words := words.push ((bytes[p]!.toUInt32 <<< 24) ||| (bytes[p+1]!.toUInt32 <<< 16) |||\\n      (bytes[p+2]!.toUInt32 <<< 8) ||| bytes[p+3]!.toUInt32)\\n  for i in [16:64] do\\n    let x := words[i-15]!\\n    let y := words[i-2]!\\n    words := words.push (words[i-16]! +\\n      (rotate x 7 ^^^ rotate x 18 ^^^ (x >>> 3)) + words[i-7]! +\\n      (rotate y 17 ^^^ rotate y 19 ^^^ (y >>> 10)))\\n  let mut a := state[0]!\\n  let mut b := state[1]!\\n  let mut c := state[2]!\\n  let mut d := state[3]!\\n  let mut e := state[4]!\\n  let mut f := state[5]!\\n  let mut g := state[6]!\\n  let mut h := state[7]!\\n  for i in [0:64] do\\n    let t1 := h + (rotate e 6 ^^^ rotate e 11 ^^^ rotate e 25) +\\n      ((e &&& f) ^^^ (~~~e &&& g)) + constants[i]! + words[i]!\\n    let t2 := (rotate a 2 ^^^ rotate a 13 ^^^ rotate a 22) +\\n      ((a &&& b) ^^^ (a &&& c) ^^^ (b &&& c))\\n    h := g; g := f; f := e; e := d + t1\\n    d := c; c := b; b := a; a := t1 + t2\\n  return (state.zip #[a,b,c,d,e,f,g,h]).map fun (x,y) => x+y\\n\\ndef digest (input : ByteArray) : ByteArray := Id.run do\\n  let mut bytes := input.push 0x80\\n  let padding := (64 - ((bytes.size + 8) % 64)) % 64\\n  for _ in [0:padding] do bytes := bytes.push 0\\n  let bits := input.size.toUInt64 * 8\\n  for i in [0:8] do bytes := bytes.push ((bits >>> ((7-i)*8).toUInt64).toUInt8)\\n  let mut state := Blake3.iv\\n  for block in [0:bytes.size/64] do state := compress state bytes (block*64)\\n  let mut result := ByteArray.empty\\n  for word in state do\\n    for i in [0:4] do result := result.push ((word >>> ((3-i)*8).toUInt32).toUInt8)\\n  return result\\n\\ndef hex (bytes : ByteArray) : String := Blake3.hex (digest bytes)\\n\\nend Eggshell.Sha256\\n\"],[\"QuotationContext.lean\",\"module\\npublic import Eggshell.SynapseSource\\npublic import Eggshell.Sha256\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.QuotationContext\\nopen Lean _root_.Eggshell.Synapses.Extraction\\n\\nstructure Source where\\n  raw : String\\n  characters : Array Char\\n  exact : characters = raw.toList.toArray\\n  fingerprint : String\\n  fingerprintExact : fingerprint = Sha256.hex raw.toUTF8\\n\\ndef Source.make (raw : String) : Source := ⟨raw,raw.toList.toArray,rfl,Sha256.hex raw.toUTF8,rfl⟩\\ndef Source.slice (source : Source) (first limit : Nat) : String :=\\n  String.ofList (source.characters.extract first limit).toList\\n\\ntheorem Source.slice_exact (source : Source) (first limit : Nat) :\\n    source.slice first limit = String.ofList (source.raw.toList.drop first |>.take (limit-first)) := by\\n  simp [Source.slice,source.exact]\\n\\ndef encoded (text : String) : String :=\\n  String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast)\\n\\nstructure Projection (source : Source) (text : String) where\\n  characters : Array Char\\n  exact : characters = text.toList.toArray\\n  offsets : Array Nat\\n  count : offsets.size = characters.size+1\\n  lines : Array TextLine\\n  multiline : Bool\\n  first : Nat\\n  limit : Nat\\n\\n/-- A projection is recognized by exact bytes, not by a tool/provider name.\\nJSON member prefixes and a trimmed final newline remain in the containing\\nrecord; the offset map refers only to this checked spelling. -/\\ndef prepare? (source : Source) (first limit : Nat) (text : String) : Option (Projection source text) := do\\n  if first ≥ limit || limit > source.characters.size then none else do\\n    let raw := source.slice first limit\\n    let (base,escaped) ←\\n      if raw == text || raw == text ++ \\\"\\\\n\\\" then some (first,false)\\n      else do\\n        let quoted := (toJson text).compress\\n        if raw == quoted then some (first+1,true)\\n        else if raw == encoded text || raw == encoded (text ++ \\\"\\\\n\\\") then some (first,true)\\n        else if raw.endsWith quoted then some (limit-quoted.length+1,true)\\n        else if !text.isEmpty && raw.endsWith text then some (limit-text.length,false)\\n        else none\\n    let characters := text.toList.toArray\\n    let mut offsets := #[base]\\n    let mut position := base\\n    for character in characters do\\n      position := position + if escaped then (encoded (String.singleton character)).length else 1\\n      offsets := offsets.push position\\n    if position > limit || base < first then none else do\\n      if count : offsets.size = characters.size+1 then\\n        some ⟨characters,rfl,offsets,count,textLines text,text.contains '\\\\n',first,limit⟩\\n      else none\\n\\nstructure Located (source : Source) (quote : String) where\\n  first : Nat\\n  limit : Nat\\n  contextFirst : Nat\\n  contextLimit : Nat\\n  within : contextFirst ≤ first ∧ first < limit ∧ limit ≤ contextLimit ∧\\n    contextLimit ≤ source.characters.size\\n  literal : source.slice first limit = quote ∨ source.slice first limit = encoded quote\\n\\n/-- The enclosing logical rows are already prepared. A multiline quote\\nkeeps every intervening row; this is independent of source language. -/\\ndef row? (lines : Array TextLine) (position : Nat) : Option TextLine := Id.run do\\n  let mut lower := 0\\n  let mut upper := lines.size\\n  while lower < upper do\\n    let middle := lower+(upper-lower)/2\\n    if (lines[middle]?).any (fun line => line.limit ≤ position) then lower := middle+1\\n    else upper := middle\\n  return (lines[lower]?).filter fun line => line.first ≤ position && position < line.limit\\n\\ndef Projection.locate? (projection : Projection source text) (first limit : Nat) :\\n    Option (Located source (String.ofList (projection.characters.extract first limit).toList)) := do\\n  if first ≥ limit || limit > projection.characters.size then none else do\\n    let a ← projection.offsets[first]?\\n    let b ← projection.offsets[limit]?\\n    let (c,d) ← if projection.multiline then do\\n        let start ← row? projection.lines first\\n        let stop ← row? projection.lines (limit-1)\\n        some (← projection.offsets[start.first]?,← projection.offsets[stop.limit]?)\\n      else some (projection.first,projection.limit)\\n    let quote := String.ofList (projection.characters.extract first limit).toList\\n    if within : c ≤ a ∧ a < b ∧ b ≤ d ∧ d ≤ source.characters.size then\\n      if literal : source.slice a b = quote ∨ source.slice a b = encoded quote then\\n        some ⟨a,b,c,d,within,literal⟩ else none\\n    else none\\n\\ntheorem Located.literal_is_original {source : Source} {text : String} (located : Located source text) :\\n    source.slice located.first located.limit = text ∨\\n      source.slice located.first located.limit = encoded text := located.literal\\n\\ntheorem Located.context_contains_match {source : Source} {text : String} (located : Located source text) :\\n    located.contextFirst ≤ located.first ∧ located.limit ≤ located.contextLimit :=\\n  ⟨located.within.1,located.within.2.2.1⟩\\n\\nend Eggshell.Synapses.QuotationContext\\n\"],[\"ObservedRecords.lean\",\"module\\npublic import Eggshell.GraphStore\\npublic import Eggshell.ObservationContext\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.ObservedRecords\\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\\n\\n/-- These describe literal representations, not tools or source semantics. -/\\ninductive Projection where\\n  | raw | rawLine | string | stringBody | stringBodyLine\\n  deriving Repr, DecidableEq, BEq, Hashable, ToJson, FromJson\\n\\nstructure Spelling where\\n  first : Nat\\n  limit : Nat\\n  projection : Projection\\n  deriving Repr, DecidableEq, BEq, Hashable\\n\\ninstance : ToJson Spelling where\\n  toJson spelling := toJson (spelling.first,spelling.limit,spelling.projection)\\ninstance : FromJson Spelling where\\n  fromJson? json := do\\n    let (first,limit,projection) ← fromJson? (α := Nat × Nat × Projection) json\\n    return ⟨first,limit,projection⟩\\n\\nstructure Record where\\n  first : Nat\\n  limit : Nat\\n  field : Option Nat := none\\n  spellings : Array Spelling := #[]\\n  deriving BEq, Inhabited\\n\\ninstance : ToJson Record where\\n  toJson record := toJson (record.first,record.limit,record.field,record.spellings)\\ninstance : FromJson Record where\\n  fromJson? json := do\\n    let (first,limit,field,spellings) ← fromJson? (α := Nat × Nat × Option Nat × Array Spelling) json\\n    return ⟨first,limit,field,spellings⟩\\n\\ndef project (characters : Array Char) (spelling : Spelling) : Option String := do\\n  if spelling.first ≥ spelling.limit || spelling.limit > characters.size then none else do\\n    let raw := String.ofList (characters.extract spelling.first spelling.limit).toList\\n    let line := fun text : String => if text.endsWith \\\"\\\\n\\\" then (text.dropEnd 1).copy else text\\n    let body := do\\n      let text ← (Json.parse (\\\"\\\\\\\"\\\" ++ raw ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption\\n      if String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) == raw then some text else none\\n    match spelling.projection with\\n    | .raw => some raw\\n    | .rawLine => some (line raw)\\n    | .string => do\\n        let text ← (Json.parse raw >>= Json.getStr?).toOption\\n        if (toJson text).compress == raw then some text else none\\n    | .stringBody => body\\n    | .stringBodyLine => line <$> body\\n\\ndef chunkChars : Nat := 2048\\n\\n/-- The base partition always retains every original character. Detailed\\nrecords add selectable structure; none can delete a base interval. -/\\ndef base (size : Nat) : Array Record :=\\n  (Array.range (size/chunkChars+1)).filterMap fun index =>\\n    let first := index*chunkChars\\n    let limit := min size (first+chunkChars)\\n    if first < limit then some ⟨first,limit,none,#[]⟩ else none\\n\\ntheorem base_covers (size position : Nat) (inside : position < size) :\\n    ∃ record ∈ base size, record.first ≤ position ∧ position < record.limit := by\\n  let index := position/chunkChars\\n  have quotient : index < size/chunkChars+1 := by\\n    have := Nat.div_le_div_right (c := chunkChars) (Nat.le_of_lt inside)\\n    dsimp [index] at *\\n    omega\\n  have positive : 0 < chunkChars := by decide\\n  have divide := Nat.mod_add_div position chunkChars\\n  rw [Nat.mul_comm chunkChars (position/chunkChars)] at divide\\n  have remainder := Nat.mod_lt position positive\\n  have lower : index*chunkChars ≤ position := by dsimp [index]; omega\\n  have upper : position < index*chunkChars+chunkChars := by dsimp [index]; omega\\n  let record : Record := ⟨index*chunkChars,min size (index*chunkChars+chunkChars),none,#[]⟩\\n  have ordered : index*chunkChars < min size (index*chunkChars+chunkChars) := by omega\\n  refine ⟨record,?_,by dsimp [record]; omega⟩\\n  apply Array.mem_filterMap.mpr\\n  refine ⟨index,by simpa using quotient,?_⟩\\n  simp only [record,if_pos ordered]\\n\\ndef add (records : Array Record) (directory : Std.HashMap (Nat × Nat) Nat)\\n    (record : Record) : Array Record × Std.HashMap (Nat × Nat) Nat :=\\n  match directory[(record.first,record.limit)]? with\\n  | none => (records.push record,directory.insert (record.first,record.limit) records.size)\\n  | some index =>\\n      (records.modify index fun old => {\\n        old with\\n        field := old.field.or record.field\\n        spellings := hashDistinct (old.spellings.toList ++ record.spellings.toList) |>.toArray },directory)\\n\\n/-- Only the original data determines record layout. No shell/input parser,\\nfile alias, current question, model or external workspace is consulted. -/\\ndef normalize (raw : String) : Array Record := Id.run do\\n  let characters := raw.toList.toArray\\n  let mut records := base characters.size\\n  let mut directory : Std.HashMap (Nat × Nat) Nat := {}\\n  for index in [:records.size] do\\n    directory := directory.insert (records[index]!.first,records[index]!.limit) index\\n  if let some json := JsonScalars.prepare? raw then\\n    for index in List.finRange json.leaves.size do\\n      let scalar := json.leaves[index].scalar\\n      let spellings := #[⟨scalar.contextFirst,scalar.limit,.raw⟩,\\n        ⟨scalar.first,scalar.limit,.raw⟩] ++\\n        (if scalar.text.isSome then #[⟨scalar.first,scalar.limit,.string⟩] else #[])\\n      let next := add records directory ⟨scalar.contextFirst,scalar.limit,some index.val,spellings⟩\\n      records := next.1; directory := next.2\\n      if let some text := scalar.text then\\n        if text.contains '\\\\n' then\\n          for line in textLines text do\\n            let some first := scalar.offsets[line.first]? | continue\\n            let some limit := scalar.offsets[line.limit]? | continue\\n            let next := add records directory ⟨first,limit,some index.val,\\n              #[⟨first,limit,.raw⟩,⟨first,limit,.stringBodyLine⟩]⟩\\n            records := next.1; directory := next.2\\n  else\\n    for line in textLines raw do\\n      let next := add records directory ⟨line.first,line.limit,none,\\n        #[⟨line.first,line.limit,.raw⟩,⟨line.first,line.limit,.rawLine⟩]⟩\\n      records := next.1; directory := next.2\\n  return records\\n\\nstructure Prepared (raw : String) where\\n  records : Array Record\\n\\ndef prepare (raw : String) : Except String (Prepared raw) := do\\n  let records := normalize raw\\n  let characters := raw.toList.toArray\\n  for record in records do\\n    unless record.first < record.limit && record.limit ≤ characters.size do throw \\\"invalid original record\\\"\\n    for spelling in record.spellings do\\n      unless record.first ≤ spelling.first && spelling.limit ≤ record.limit do throw \\\"foreign spelling interval\\\"\\n      match project characters spelling with\\n      | some _ => pure ()\\n      | none => throw \\\"spelling is not an original data projection\\\"\\n  return ⟨records⟩\\n\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.observed-records\\\".toUTF8 [\\n  (include_str \\\"ObservedRecords.lean\\\").toUTF8,(include_str \\\"JsonScalars.lean\\\").toUTF8,\\n  (include_str \\\"SynapseSource.lean\\\").toUTF8])\\n\\nstructure Header where\\n  database : String\\n  owner : String\\n  work : String\\n  original : Original\\n  implementation : String\\n  records : Nat\\n  chunks : Array String\\n  deriving BEq, ToJson, FromJson\\n\\ndef keyPrefix := \\\"memo:observed-record:\\\"\\ndef ownerKey (id : Nat) := keyPrefix ++ \\\"owner:\\\" ++ toString id\\ndef chunkKey (digest : String) := keyPrefix ++ \\\"chunk:\\\" ++ digest\\ndef chunkRecords : Nat := 64\\n\\ndef decode [ToJson α] [FromJson α] (bytes : ByteArray) : IO α := do\\n  unless bytes.size ≤ 262144 do throw (IO.userError \\\"original record metadata exceeds its block bound\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid original metadata UTF-8\\\")\\n  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))\\n  unless (toJson value).compress.toUTF8 == bytes do throw (IO.userError \\\"noncanonical original metadata\\\")\\n  return value\\n\\ndef stage (writer : PageMap.Writer) (id : Nat) (doc : Document) : IO Bool := do\\n  unless doc.native do throw (IO.userError \\\"record publication requires its original native owner\\\")\\n  let some raw := doc.source | throw (IO.userError \\\"native record publication lost its original body\\\")\\n  let prepared ← IO.ofExcept (prepare raw)\\n  let mut chunks := #[]\\n  let mut changed := false\\n  for index in [: (prepared.records.size+chunkRecords-1)/chunkRecords] do\\n    let records := prepared.records.extract (index*chunkRecords) ((index+1)*chunkRecords)\\n    let bytes := (toJson records).compress.toUTF8\\n    unless bytes.size ≤ 262144 do throw (IO.userError \\\"original record block exceeds its byte bound\\\")\\n    let digest := Sha256.hex bytes\\n    let key := chunkKey digest\\n    if let some old ← writer.get key then\\n      unless old == bytes do throw (IO.userError \\\"conflicting original record block\\\")\\n    else writer.put key (some bytes); changed := true\\n    chunks := chunks.push digest\\n  let pinned ← writer.snapshot\\n  let header : Header := ⟨pinned.head.identity,doc.owner,doc.work,\\n    ObservationContext.originalSubject doc.work raw,implementation,prepared.records.size,chunks⟩\\n  let bytes := (toJson header).compress.toUTF8\\n  unless bytes.size ≤ 262144 do throw (IO.userError \\\"original record directory exceeds its bound\\\")\\n  if (← writer.get (ownerKey id)) != some bytes then\\n    writer.put (ownerKey id) (some bytes)\\n    changed := true\\n  return changed\\n\\ndef catalog (database : String) (doc : Document) (records : Array Record) : Except String ObservationContext.Catalog := do\\n  let some raw := doc.source | throw \\\"missing native record body\\\"
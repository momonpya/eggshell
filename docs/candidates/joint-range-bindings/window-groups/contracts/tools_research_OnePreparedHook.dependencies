nce then return prepared\\n  let saved ← reader.get (binding query target)\\n  return prepared.addUsing saved weights query target source\\n\\n/-- Append changed demanded slots to the caller's single publication batch.\\nThe caller seals one derived-only change after every lane is ready. -/\\ndef publishUsing (writer : Store.Writer) (saved : Saved) (lane : Lane := .rank) : IO Bool := do\\n    let mut changed := false\\n    let mut written : Std.HashSet Slot := {}\\n    for entry in saved do\\n      let slot := slotOf entry.1\\n      let tag := slotRow slot lane\\n      -- A single publication selects the first demanded key per slot.\\n      if written.contains slot then continue\\n      written := written.insert slot\\n      let bytes := (codec.encode [entry]).toByteArray\\n      if bytes.size > allowance then continue\\n      if let some _ ← writer.get tag then\\n        let size ← Store.getNat writer.get tag\\n        let payloadSize ← Store.getNat writer.get (Store.key tag 0)\\n        if size ≤ allowance && payloadSize == size then\\n          let previous ← Store.readChunks (← writer.snapshot) writer.get tag 0\\n          if previous == bytes then continue\\n      Store.putChunks writer tag 0 bytes\\n      Store.putNat writer tag bytes.size\\n      changed := true\\n    pure changed\\n\\n/-- Only changed, demanded slots are written. Other requests stay untouched,\\nincluding their old orders after a frequency change; repair happens on demand.\\nBusy writers win immediately. No whole memo frontier is rewritten. -/\\ndef publish (path : System.FilePath) (saved : Saved) (lane : Lane := .rank) : IO _root_.Unit := do\\n  if saved.isEmpty then return\\n  let snapshot ← DB.PageMap.pin path\\n  let _ ← DB.PageMap.withWriter snapshot fun writer => do\\n    if ← publishUsing writer saved lane then\\n      Store.writeChange writer {added := [],removed := [],unionsChanged := false}\\n  pure ()\\n\\nend Eggshell.Matcher.RankMemo\\n\",[]]"],["Eggshell.Receipt","[\"module\\n\\npublic import Eggshell.FileSystem\\npublic import Eggshell.Paths\\npublic import Eggshell.Blake3\\npublic import Eggshell.Sha256\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Receipt\\nopen Lean\\n\\ndef validId (id : String) : Bool :=\\n  id.length == 64 && id.toList.all (fun c =>\\n    ('0' ≤ c && c ≤ '9') || ('a' ≤ c && c ≤ 'f'))\\n\\ndef fresh : IO String := do pure (Blake3.hex (← IO.getRandomBytes 32))\\n\\n/-- Every writer publishes its own stage atomically. No shared append lock,\\n    graph write, session lifetime or provider command identifies a receipt. -/\\ndef write (id stage : String) (data : Json) : IO Unit := do\\n  unless validId id && !stage.isEmpty && stage.length ≤ 96 &&\\n      stage.toList.all (fun c => c.isAlphanum || c == '-' || c == '_') do\\n    throw (IO.userError \\\"invalid hook receipt identity or stage\\\")\\n  let directory := (← Paths.dataRoot) / \\\"receipts\\\" / id\\n  FileSystem.rejectSymlinkAncestors directory\\n  FileSystem.privateDirectory directory\\n  let record := Json.mkObj [(\\\"receipt\\\", toJson id), (\\\"stage\\\", toJson stage),\\n    (\\\"pid\\\", toJson (← IO.Process.getPID).toNat), (\\\"observedMs\\\", toJson (← IO.monoMsNow)), (\\\"data\\\", data)]\\n  let bytes := record.compress.toUTF8\\n  unless bytes.size ≤ 8 * 1024 * 1024 do\\n    throw (IO.userError \\\"hook receipt exceeds the native frame bound\\\")\\n  FileSystem.atomicExistingBytes (directory / (stage ++ \\\".json\\\")) bytes\\n\\n/-- Diagnostics cannot grant authority or turn a storage error into a miss. -/\\ndef observe (id : Option String) (stage : String) (data : Json) : IO Unit := do\\n  let some id := id | return\\n  try write id stage data\\n  catch error => IO.eprintln s!\\\"Eggshell could not record {stage}: {error}\\\"\\n\\nend Eggshell.Receipt\\n\",[]]"],["Eggshell.Relation","[\"module\\n\\npublic import Eggshell.Union\\n\\n@[expose] public section\\n\\nnamespace Eggshell\\n\\ndef maxOutcomeObservations : Nat := 1024\\n\\nnamespace Relation\\n\\ndef semanticValues {α : Type} : List (Authority × α) → Option (List α)\\n  | [] => some []\\n  | (.semantic, value) :: tail => (value :: ·) <$> semanticValues tail\\n  | (.exact, _) :: _ => none\\n\\ntheorem semanticValues_sound {α : Type} {references : List (Authority × α)} {values : List α}\\n    (decoded : semanticValues references = some values) :\\n    references = values.map (Authority.semantic, ·) := by\\n  induction references generalizing values with\\n  | nil => simp [semanticValues] at decoded; simp [decoded]\\n  | cons head tail induction =>\\n      rcases head with ⟨authority, value⟩\\n      cases authority with\\n      | exact => simp [semanticValues] at decoded\\n      | semantic =>\\n          simp only [semanticValues] at decoded\\n          cases decodedTail : semanticValues tail with\\n          | none => simp [decodedTail] at decoded\\n          | some tailValues =>\\n              simp [decodedTail] at decoded\\n              subst values\\n              simp [induction decodedTail]\\n\\ndef exactValues {α : Type} : List (Authority × α) → Option (List α)\\n  | [] => some []\\n  | (.exact, value) :: tail => (value :: ·) <$> exactValues tail\\n  | (.semantic, _) :: _ => none\\n\\ntheorem exactValues_sound {α : Type} {references : List (Authority × α)} {values : List α}\\n    (decoded : exactValues references = some values) :\\n    references = values.map (Authority.exact, ·) := by\\n  induction references generalizing values with\\n  | nil => simp [exactValues] at decoded; simp [decoded]\\n  | cons head tail induction =>\\n      rcases head with ⟨authority, value⟩\\n      cases authority with\\n      | semantic => simp [exactValues] at decoded\\n      | exact =>\\n          simp only [exactValues] at decoded\\n          cases decodedTail : exactValues tail with\\n          | none => simp [decodedTail] at decoded\\n          | some tailValues =>\\n              simp [decodedTail] at decoded\\n              subst values\\n              simp [induction decodedTail]\\n\\ndef splitOccurrence {α : Type} : List (Authority × α) → Option (List α × List α)\\n  | [] => none\\n  | references =>\\n      let semantic := references.takeWhile (fun reference => reference.1 == .semantic)\\n      let exact := references.drop semantic.length\\n      match semanticValues semantic, exactValues exact with\\n      | some [], _ => none\\n      | some meanings, some occurrences => some (meanings, occurrences)\\n      | _, _ => none\\n\\ntheorem semanticValues_map {α β : Type} (f : α → β) (references : List (Authority × α)) :\\n    semanticValues (references.map fun ref => (ref.1, f ref.2)) =\\n      (semanticValues references).map (List.map f) := by\\n  induction references with\\n  | nil => rfl\\n  | cons head tail ih =>\\n      rcases head with ⟨authority, value⟩\\n      cases authority <;> simp [semanticValues, ih, Option.map_map, Function.comp_def]\\n\\ntheorem exactValues_map {α β : Type} (f : α → β) (references : List (Authority × α)) :\\n    exactValues (references.map fun ref => (ref.1, f ref.2)) =\\n      (exactValues references).map (List.map f) := by\\n  induction references with\\n  | nil => rfl\\n  | cons head tail ih =>\\n      rcases head with ⟨authority, value⟩\\n      cases authority <;> simp [exactValues, ih, Option.map_map, Function.comp_def]\\n\\n/-- Reading payload values cannot change observation orientation or authority\\npositions. The same parser is used on persisted ids and resolved Values. -/\\ntheorem splitOccurrence_map {α β : Type} (f : α → β) (references : List (Authority × α)) :\\n    splitOccurrence (references.map fun ref => (ref.1, f ref.2)) =\\n      (splitOccurrence references).map (fun pair => (pair.1.map f, pair.2.map f)) := by\\n  cases references with\\n  | nil => rfl\\n  | cons head tail =>\\n      simp only [List.map_cons, splitOccurrence]\\n      have leading :\\n          ((head.1, f head.2) :: tail.map (fun ref => (ref.1, f ref.2))).takeWhile\\n            (fun ref => ref.1 == .semantic) =\\n          ((head :: tail).takeWhile (fun ref => ref.1 == .semantic)).map\\n            (fun ref => (ref.1, f ref.2)) := by\\n        change ((head :: tail).map (fun ref => (ref.1, f ref.2))).takeWhile _ = _\\n        exact List.takeWhile_map\\n      have suffix (count : Nat) :\\n          ((head.1, f head.2) :: tail.map (fun ref => (ref.1, f ref.2))).drop count =\\n          ((head :: tail).drop count).map (fun ref => (ref.1, f ref.2)) := by\\n        simpa only [List.map_cons] using\\n          (List.map_drop (f := fun ref : Authority × α => (ref.1, f ref.2))\\n            (l := head :: tail) (i := count)).symm\\n      rw [leading, List.length_map, suffix, semanticValues_map, exactValues_map]\\n      cases sem : semanticValues ((head :: tail).takeWhile (fun ref => ref.1 == .semantic)) with\\n      | none => simp\\n      | some meanings =>\\n          cases meanings with\\n          | nil => simp\\n          | cons first rest =>\\n              cases exact : exactValues ((head :: tail).drop\\n                ((head :: tail).takeWhile (fun ref => ref.1 == .semantic)).length) <;> simp\\n\\ndef observesOutcomeWork (outcome work : Value) : Value → Bool\\n  | .apply .occurrence arguments =>\\n      match splitOccurrence arguments.toList with\\n      | some ([observed, invoked], _) => observed == outcome && invoked == work\\n      | _ => false\\n  | _ => false\\n\\ndef validArguments : Operator → List Ref → Bool\\n  | .all, (.semantic, parent) :: children =>\\n      !children.isEmpty && children.all fun reference =>\\n        reference.1 == .semantic && reference.2 != parent\\n  | .outcome, (.semantic, _) :: (.semantic, _) :: observations =>\\n      observations.length ≤ maxOutcomeObservations &&\\n        (exactValues observations).isSome && decide observations.Nodup\\n  | .occurrence, arguments => (splitOccurrence arguments).isSome\\n  | .inquiry,\\n      (.exact, _) :: (.exact, _) :: (.semantic, _) ::\\n        (.exact, _) :: (.exact, _) :: (.exact, _) :: _ => true\\n  | .receipt, arguments => 7 ≤ arguments.length && (exactValues arguments).isSome\\n  | _, _ => false\\n\\ndef apply? (operator : Operator) (arguments : List Ref) : Option Value :=\\n  if validArguments operator arguments then\\n    some (.applyList operator arguments)\\n  else\\n    none\\n\\ntheorem apply?_sound {operator arguments value}\\n    (accepted : apply? operator arguments = some value) :\\n    value = .applyList operator arguments ∧ validArguments operator arguments := by\\n  unfold apply? at accepted\\n  split at accepted\\n  case isTrue valid =>\\n    simp only [Option.some.injEq] at accepted\\n    exact ⟨accepted.symm, by simpa using valid⟩\\n  case isFalse => simp at accepted\\n\\ntheorem apply?_complete {operator arguments}\\n    (valid : validArguments operator arguments) :\\n    apply? operator arguments = some (.applyList operator arguments) := by\\n  simp [apply?, valid]\\n\\nmutual\\n\\n/-- Every stored constructor and every structurally nested constructor is valid. -/\\ndef wellFormed : Value → Bool\\n  | .atom _ => true\\n  | .apply operator arguments =>\\n      validArguments operator arguments.toList && refsWellFormed arguments\\n\\ndef refsWellFormed : Refs → Bool\\n  | .nil => true\\n  | .semantic value tail | .exact value tail =>\\n      wellFormed value && refsWellFormed tail\\n\\nend\\n\\n@[simp]\\ntheorem atom_wellFormed (bytes : ByteArray) : wellFormed (.atom bytes) := rfl\\n\\nend Relation\\n\\nstructure AllEdge where\\n  relation : Value\\n  parent : Value\\n  children : List Value\\n  children_nonempty : children ≠ []\\n  excludes_parent : parent ∉ children\\n  relation_eq : relation = .applyList .all\\n    ((.semantic, parent) :: children.map Ref.semantic)\\n\\nstructure OutcomeEdge where\\n  relation : Value\\n  work : Value\\n  outcome : Value\\n  observations : List Value\\n  observations_nodup : observations.Nodup\\n  observation_bound : observations.length ≤ maxOutcomeObservations\\n  relation_eq : relation = .applyList .outcome\\n    ((.semantic, work) :: (.semantic, outcome) :: observations.map Ref.exact)\\n\\nderiving instance DecidableEq for AllEdge, OutcomeEdge\\n\\nnamespace AllEdge\\n\\ndef make (parent : Value) (children : List Value)\\n    (children_nonempty : children ≠ [])\\n    (excludes_parent : parent ∉ children) : AllEdge where\\n  relation := .applyList .all\\n    ((.semantic, parent) :: children.map Ref.semantic)\\n  parent\\n  children\\n  children_nonempty\\n  excludes_parent\\n  relation_eq := rfl\\n\\n@[simp]\\ntheorem make_parent (parent children nonempty excludes) :\\n    (make parent children nonempty excludes).parent = parent := rfl\\n\\n@[simp]\\ntheorem make_children (parent children nonempty excludes) :\\n    (make parent children nonempty excludes).children = children := rfl\\n\\ndef fromValue? : Value → Option AllEdge\\n  | .apply .all arguments =>\\n      match argumentList : arguments.toList with\\n      | (.semantic, parent) :: encodedChildren =>\\n          match decoded : Relation.semanticValues encodedChildren with\\n          | some children =>\\n              if nonempty : children ≠ [] then\\n                if excludes : parent ∉ children then\\n                  some {\\n                    relation := .apply .all arguments\\n                    parent\\n                    children\\n                    children_nonempty := nonempty\\n                    excludes_parent := excludes\\n                    relation_eq := by\\n                      apply congrArg (Value.apply .all)\\n                      rw [← Refs.ofList_toList arguments]\\n                      rw [argumentList]\\n                      simp only [Refs.ofList]\\n                      rw [Relation.semanticValues_sound decoded]\\n                      rfl\\n                  }\\n                else none\\n              else none\\n          | none => none\\n      | _ => none\\n  | _ => none\\n\\nend AllEdge\\n\\nnamespace OutcomeEdge\\n\\ndef make (work outcome : Value) (observations : List Value)\\n    (observations_nodup : observations.Nodup)\\n    (observation_bound : observations.length ≤ maxOutcomeObservations) : OutcomeEdge where\\n  relation := .applyList .outcome\\n    ((.semantic, work) :: (.semantic, outcome) :: observations.map Ref.exact)\\n  work\\n  outcome\\n  observations\\n  observations_nodup\\n  observation_bound\\n  relation_eq := rfl\\n\\ndef fromValue? : Value → Option OutcomeEdge\\n  | .apply .outcome arguments =>\\n      match argumentList : arguments.toList with\\n      | (.semantic, work) :: (.semantic, outcome) :: encodedObservations =>\\n          match decoded : Relation.exactValues encodedObservations with\\n          | some observations =>\\n              if nodup : observations.Nodup then\\n                if bound : observations.length ≤ maxOutcomeObservations then\\n                  some {\\n                    relation := .apply .outcome arguments\\n                    work\\n                    outcome\\n                    observations\\n                    observations_nodup := nodup\\n                    observation_bound := bound\\n                    relation_eq := by\\n                      apply congrArg (Value.apply .outcome)\\n                      rw [← Refs.ofList_toList arguments]\\n                      rw [argumentList]\\n                      simp only [Refs.ofList]\\n                      rw [Relation.exactValues_sound decoded]\\n                      rfl\\n                  }\\n                else none\\n              else none\\n          | none => none\\n      | _ => none\\n  | _ => none\\n\\nend OutcomeEdge\\n\\nend Eggshell\\n\",[]]"],["Eggshell.SaturationMemo","[\"module\\n\\npublic import Eggshell.GraphStore\\npublic import Eggshell.IncrementalQuotient\\n\\n@[expose] public section\\nnamespace Eggshell.Plugin.SaturationMemo\\nopen Persistence DB QuotientBuilder\\n\\n/-- Only ordinals and shallow signatures are durable. The current source\\nvalues supply the bodies; a memo never stores another copy of an Outcome. -/\\nstructure RowHint where\\n  source : Nat\\n  operator : Nat\\n  references : List (Nat × Nat)\\n  prior : Option Nat\\n  deriving BEq, DecidableEq\\n\\nabbrev Saved := List RowHint\\ndef allowance : Nat := 65536\\ndef row : String := \\\"memo:saturation-demand\\\"\\ndef rowCodec : Wire.Codec RowHint :=\\n  (Wire.natural.product (Wire.natural.product\\n    ((Wire.list (Wire.natural.product Wire.natural)).product\\n      (Wire.optional Wire.natural)))).iso\\n    (fun r => (r.source, r.operator, r.references, r.prior))\\n    (fun (source, operator, references, prior) => ⟨source, operator, references, prior⟩)\\n    (by intro r; cases r; rfl)\\ndef codec : Wire.Codec Saved := Wire.list rowCodec\\n\\ntheorem codec_roundtrip (saved : Saved) (tail : List UInt8) :\\n    codec.decode (codec.encode saved ++ tail) = .ok (saved, tail) := codec.roundtrip saved tail\\n\\nstructure Basis where\\n  values : Array Value\\n  positions : Std.HashMap Value Nat\\n\\ndef Basis.make (values : List Value) : Basis :=\\n  let values := hashDistinct (values ++ values.flatMap fun value => match value with\\n    | .atom _ => []\\n    | .apply _ references => references.toList.map Prod.snd)\\n  let positions := values.zipIdx.foldl (fun found (value, index) => found.insert value index) {}\\n  ⟨values.toArray, positions⟩\\n\\n/-- The hash table only nominates an ordinal. Check its exact current value. -/\\ndef Basis.find? (basis : Basis) (value : Value) : Option Nat := do\\n  let index ← basis.positions[value]?\\n  let present ← basis.values[index]?\\n  if present == value then some index else none\\n\\ndef kernelValues (roots : List Value) (edges : List UnionEdge) : List Value :=\\n  QuotientBuilder.kernelValues roots edges\\n\\ndef operatorCode : Operator → Nat\\n  | .all => 0 | .outcome => 1 | .occurrence => 2 | .inquiry => 3 | .receipt => 4\\n\\ndef operator? : Nat → Option Operator\\n  | 0 => some .all | 1 => some .outcome | 2 => some .occurrence\\n  | 3 => some .inquiry | 4 => some .receipt | _ => none\\n\\ndef encodeRow? (basis : Basis) (record : CongruenceMemo.Row × Option Value) : Option RowHint := do\\n  let source ← basis.find? record.1.2\\n  let (.apply operator references) := record.1.1.value | none\\n  let references ← references.toList.mapM fun (authority, value) => do\\n    let index ← basis.find? value\\n    pure (match authority with | .semantic => 0 | .exact => 1, index)\\n  let prior ← match record.2 with\\n    | none => pure none\\n    | some value => some <$> basis.find? value\\n  pure ⟨source, operatorCode operator, references, prior⟩\\n\\ndef decodeRow? (basis : Basis) (hint : RowHint) : Option (CongruenceMemo.Row × Option Value) := do\\n  let source ← basis.values[hint.source]?\\n  let (.apply ..) := source | none\\n  let operator ← operator? hint.operator\\n  let references ← hint.references.mapM fun (authority, index) => do\\n    let value ← basis.values[index]?\\n    match authority with\\n    | 0 => pure (Ref.semantic value)\\n    | 1 => pure (Ref.exact value)\\n    | _ => none\\n  let prior ← match hint.prior with\\n    | none => pure none\\n    | some index => some <$> basis.values[index]?\\n  pure ((CongruenceMemo.Key.make (.applyList operator references), source), prior)\\n\\n/-- Stop at the first nonportable dependency, preserving the valid ordered\\nprefix. Only this demanded generation is retained. The byte budget is optional\\nacceleration capacity, never a source, user or graph-size limit. -/\\ndef pack (basis : Basis) (remaining : Nat) :\\n    List (CongruenceMemo.Row × Option Value) → Saved\\n  | [] => []\\n  | record :: rest => match encodeRow? basis record with\\n    | none => []\\n    | some hint =>\\n        let cost := 1 + rowCodec.encodedSize hint\\n        if cost ≤ remaining then hint :: pack basis (remaining - cost) rest else []\\n\\ntheorem pack_bounded (basis : Basis) (remaining : Nat)\\n    (records : List (CongruenceMemo.Row × Option Value)) :\\n    codec.encodedSize (pack basis remaining records) ≤ remaining + 1 := by\\n  induction records generalizing remaining with\\n  | nil => simp [pack, codec, Wire.list, Wire.encodedListSize]\\n  | cons record rest ih =>\\n      simp only [pack]\\n      split\\n      · simp [codec, Wire.list, Wire.encodedListSize]\\n      · split\\n        · rename_i hint _found fits\\n          have bound := ih (remaining - (1 + rowCodec.encodedSize hint))\\n          simp only [codec, Wire.list, Wire.encodedListSize] at bound ⊢\\n          omega\\n        · simp [codec, Wire.list, Wire.encodedListSize]\\n\\n/-- Persist the last generation actually returned by the checked view build.\\nNo signature normalization or join discovery is repeated to make this row. -/\\ndef capturePlan (basis : Basis) (plan : CongruenceMemo.Entry) : Saved :=\\n  pack basis (allowance - 1) (plan.rows.zip plan.script.instructions)\\n\\ntheorem capturePlan_bounded (basis : Basis) (plan : CongruenceMemo.Entry) :\\n    codec.encodedSize (capturePlan basis plan) ≤ allowance :=\\n  pack_bounded basis (allowance - 1) _\\n\\ntheorem capturePlan_producer (basis : Basis) (plan : CongruenceMemo.Entry) :\\n    capturePlan basis plan = pack basis (allowance - 1)\\n      (plan.rows.zip (CongruenceMemo.instructions {} plan.rows)) := by\\n  simp only [capturePlan, plan.script.exact]\\n\\n/-- A decoder supplies no erased producer proof. Certify the complete decoded\\nscript before reuse, including negative joins and earliest prior application.\\nA changed basis can invalidate a hint; even a valid differently bound hint is\\nonly a certified old plan, and current full rows still decide prefix reuse. -/\\ndef restore (basis : Basis) (saved : Saved) : Option CongruenceMemo.Entry := do\\n  let decoded ← saved.mapM (decodeRow? basis)\\n  let rows := decoded.map Prod.fst\\n  let script ← CongruenceMemo.Script.check? {} rows (decoded.map Prod.snd)\\n  pure ⟨rows, script⟩\\n\\n/-- Arbitrary disk hints, not merely well-behaved producer output, preserve\\nthe actual fresh quotient. Removing explicit edges always rebuilds from the\\ncurrent explicit partition. No hash injectivity or old-result premise. -/\\ntheorem restored_build_exact (basis : Basis) (saved : Saved) (roots : List Value)\\n    (persistent runLocal : List UnionEdge) :\\n    (plannedBuild? roots persistent runLocal (restore basis saved)).quotient =\\n      build? roots persistent runLocal := plannedBuild_exact ..\\n\\n/-- Rebind hints to the actual demanded roots at each view boundary. An old\\ncomplete workspace is never needed to restore a join plan. The dependent\\nprovider still returns exactly today's fresh view for arbitrary disk hints. -/\\ndef viewProvider (saved : Saved) : IncrementalQuotient.ViewProvider :=\\n  fun graph roots persistent runLocal index =>\\n    if IncrementalQuotient.atomWork graph && index.isSome then\\n      IncrementalQuotient.ViewProvider.reference graph roots persistent runLocal index\\n    else\\n      let basis := Basis.make (kernelValues roots (persistent ++ runLocal))\\n      IncrementalQuotient.ViewProvider.withPlan (restore basis saved)\\n        graph roots persistent runLocal index\\n\\n/-- The persistence observer receives the generation of this exact current\\nbuild, not a second scan of the final quotient or an unchecked disk script. -/\\ntheorem viewProvider_generation (saved : Saved) (graph : WorkGraph) (roots : List Value)\\n    (persistent runLocal : List UnionEdge)\\n    (index : Option (QuotientBuilder.AtomQuotient.Index (persistent ++ runLocal)))\\n    (general : IncrementalQuotient.atomWork graph = false ∨ index = none) :\\n    (viewProvider saved graph roots persistent runLocal index).plan =\\n      (plannedBuild? roots persistent runLocal\\n        (restore (Basis.make (kernelValues roots (persistent ++ runLocal))) saved)).plan := by\\n  unfold viewProvider\\n  have notFast : (IncrementalQuotient.atomWork graph && index.isSome) = false := by\\n    cases general with\\n    | inl atoms => simp [atoms]\\n    | inr absent => simp [absent]\\n  simp only [notFast, Bool.false_eq_true, ↓reduceIte]\\n  exact IncrementalQuotient.ViewProvider.withPlan_generation _ graph roots persistent runLocal index general\\n\\ntheorem viewProvider_exact (saved : Saved) :\\n    IncrementalQuotient.ViewProvider.observed (viewProvider saved) =\\n      IncrementalQuotient.make? :=\\n  IncrementalQuotient.ViewProvider.observed_exact _\\n\\n/-- Even an arbitrary persisted hint cannot supply an equality whose\\nderivation requires withdrawn or foreign edges. The current production view\\nretains its generated-equality certificate, including the Atom fast lane. -/\\ntheorem viewProvider_generated (saved : Saved) (graph : WorkGraph) (roots : List Value)\\n    (persistent runLocal : List UnionEdge)\\n    (index : Option (QuotientBuilder.AtomQuotient.Index (persistent ++ runLocal)))\\n    (view : RunView)\\n    (found : IncrementalQuotient.ViewProvider.observed (viewProvider saved)\\n      graph roots persistent runLocal index = some view) :\\n    CongruenceSound.QuotientSound (persistent ++ runLocal) view.quotient :=\\n  IncrementalQuotient.ViewProvider.generated _ graph roots persistent runLocal index view found\\n\\n/-- The exact production disk-hint provider also preserves general\\ncomparisons when source bodies outside the demanded closed domain are not\\nloaded. Different or corrupted hints do not weaken this contract. -/\\ntheorem viewProvider_domain_independent (firstSaved secondSaved : Saved)\\n    (firstGraph secondGraph : WorkGraph) (roots otherRoots : List Value)\\n    (persistent runLocal : List UnionEdge)\\n    (firstIndex secondIndex : Option (QuotientBuilder.AtomQuotient.Index (persistent ++ runLocal)))\\n    (firstGeneral : IncrementalQuotient.atomWork firstGraph = false ∨ firstIndex = none)\\n    (secondGeneral : IncrementalQuotient.atomWork secondGraph = false ∨ secondIndex = none)\\n    (first second : RunView)\\n    (firstBuilt : IncrementalQuotient.ViewProvider.observed (viewProvider firstSaved)\\n      firstGraph roots persistent runLocal firstIndex = some first)\\n    (secondBuilt : IncrementalQuotient.ViewProvider.observed (viewProvider secondSaved)\\n      secondGraph otherRoots persistent runLocal secondIndex = some second)\\n    (left right : Value)\\n    (firstLeft : left ∈ QuotientBuilder.kernelValues roots (persistent ++ runLocal))\\n    (firstRight : right ∈ QuotientBuilder.kernelValues roots (persistent ++ runLocal))\\n    (secondLeft : left ∈ QuotientBuilder.kernelValues otherRoots (persistent ++ runLocal))\\n    (secondRight : right ∈ QuotientBuilder.kernelValues otherRoots (persistent ++ runLocal)) :\\n    first.quotient.toEquality.same left right = second.quotient.toEquality.same left right :=\\n  IncrementalQuotient.ViewProvider.domain_independent _ _ firstGraph secondGraph roots otherRoots\\n    persistent runLocal firstIndex secondIndex firstGeneral secondGeneral first second firstBuilt secondBuilt\\n    left right firstLeft firstRight secondLeft secondRight\\n\\ndef read (snapshot : Store.Snapshot) : IO Saved := do\\n  let some _ ← snapshot.get row | return []\\n  let size ← Store.getNat snapshot.get row\\n  unless size ≤ allowance do throw (IO.userError \\\"saturation memo exceeds its encoded allowance\\\")\\n  let payloadSize ← Store.getNat snapshot.get (Store.key row 0)\\n  unless payloadSize == size do throw (IO.userError \\\"saturation memo payload differs from marker\\\")\\n  let bytes ← Store.readChunks snapshot snapshot.get row 0\\n  let (saved, tail) ← IO.ofExcept (codec.decode bytes.toList)\\n  unless tail.isEmpty && (codec.encode saved).toByteArray == bytes do\\n    throw (IO.userError \\\"noncanonical saturation memo\\\")\\n  pure saved\\n\\n/-- This is the same compact row writer for standalone and discovery-wide\\npublications. It neither opens another writer nor seals an incomplete batch. -/\\ndef publishUsing (writer : Store.Writer) (saved : Saved) : IO Bool := do\\n  if codec.encodedSize saved > allowance then return false\\n  let bytes := (codec.encode saved).toByteArray\\n  if let some _ ← writer.get row then\\n    let size ← Store.getNat writer.get row\\n    let payloadSize ← Store.getNat writer.get (Store.key row 0)\\n    if size ≤ allowance && size == payloadSize then\\n      let previous ← Store.readChunks (← writer.snapshot) writer.get row 0\\n      if previous == bytes then return false\\n  else if saved.isEmpty then return false\\n  Store.putChunks writer row 0 bytes\\n  Store.putNat writer row bytes.size\\n  pure true\\n\\ndef publish (path : System.FilePath) (saved : Saved) : IO Unit := do\\n  let snapshot ← PageMap.pin path\\n  let _ ← PageMap.withWriter snapshot fun writer => do\\n    if ← publishUsing writer saved then\\n      Store.writeChange writer {added := [],removed := [],unionsChanged := false}\\n  pure ()\\n\\nend Eggshell.Plugin.SaturationMemo\\n\",[]]"],["Eggshell.SearchProvider","[\"module\\npublic import Eggshell.PreparationDebt\\n\\npublic import Eggshell.SearchRank\\npublic import Eggshell.MiniLM\\npublic import Eggshell.Sha256\\npublic import Eggshell.Persistence\\npublic import Eggshell.SemanticMatcher\\npublic import Eggshell.Receipt\\npublic import tools.DirectoryReads\\npublic import tools.WindowCentroid\\npublic import Eggshell.VectorMatrix\\npublic import Eggshell.BlockScore\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SearchProvider\\nopen Lean\\n\\nstructure EncodingCoverage where\\n  characters : Nat\\n  visibleCharacters : Nat\\n  tokenizerMappedCharacters : Nat\\n  embeddedCharacters : Nat\\n  sourceTokens : Nat\\n  segments : Nat\\n  contextTokens : Nat\\n  overlapTokens : Nat\\n  completeTokenOffsets : Bool\\n  deriving ToJson, FromJson\\n\\ndef EncodingCoverage.valid (c : EncodingCoverage) : Bool :=\\n  c.characters ≤ 512 && c.embeddedCharacters == c.tokenizerMappedCharacters &&\\n  c.tokenizerMappedCharacters ≤ c.visibleCharacters && c.visibleCharacters ≤ c.characters &&\\n  0 < c.segments && c.segments ≤ 512 && 2 < c.contextTokens &&\\n  c.overlapTokens < c.contextTokens - 2 && c.sourceTokens ≤ c.segments * c.contextTokens &&\\n  c.completeTokenOffsets\\n\\n/-- Counts window/reference positions, not unique whole-document characters. -/\\nstructure InputTotals where\\n  windows : Nat := 0\\n  characters : Nat := 0\\n  visibleCharacters : Nat := 0\\n  tokenizerMappedCharacters : Nat := 0\\n  embeddedCharacters : Nat := 0\\n  vectors : Nat := 0\\n  tokens : Nat := 0\\n  deriving ToJson\\n\\ndef InputTotals.add (t : InputTotals) (c : EncodingCoverage) : InputTotals := {\\n  windows := t.windows + 1, characters := t.characters + c.characters\\n  visibleCharacters := t.visibleCharacters + c.visibleCharacters\\n  tokenizerMappedCharacters := t.tokenizerMappedCharacters + c.tokenizerMappedCharacters\\n  embeddedCharacters := t.embeddedCharacters + c.embeddedCharacters\\n  vectors := t.vectors + c.segments, tokens := t.tokens + c.sourceTokens }\\n\\nstructure CacheProbes where\\n  hit : Nat := 0\\n  absent : Nat := 0\\n  unusable : Nat := 0\\n  deriving ToJson\\n\\nstructure EncoderSample where\\n  startupUs : Nat\\n  leaseUs : Nat\\n  initializeUs : Nat\\n  encodeUs : Nat\\n  scoreUs : Nat\\n  requestUs : Nat\\n  modelLoaded : Bool\\n  deriving FromJson\\n\\nstructure EncoderTiming where\\n  replies : Nat := 0\\n  startupUs : Nat := 0\\n  leaseUs : Nat := 0\\n  initializeUs : Nat := 0\\n  queryEncodeUs : Nat := 0\\n  sourceEncodeUs : Nat := 0\\n  scoreUs : Nat := 0\\n  requestUs : Nat := 0\\n  modelLoaded : Bool := false\\n  deriving ToJson\\n\\nstructure IndexedMetrics where\\n  scoringPolicy : String := \\\"window centroid weighted by newly covered source tokens\\\"\\n  source : CacheProbes := {}\\n  query : CacheProbes := {}\\n  cacheMs : Nat := 0\\n  queryMs : Nat := 0\\n  scoreMs : Nat := 0\\n  scoredWindows : Nat := 0\\n  projectionReadMsWithinScore : Nat := 0\\n  projectionHits : Nat := 0\\n  projectionMisses : Nat := 0\\n  projectionRetainedBytes : Nat := 0\\n  matrixRows : Nat := 0\\n  matrixOpens : Nat := 0\\n  matrixOpenMs : Nat := 0\\n  sourceInput : InputTotals := {}\\n  queryInput : InputTotals := {}\\n  encoder : Option EncoderTiming := none\\n  phase : String := \\\"source-cache\\\"\\n  deriving ToJson\\n\\nstructure MetricsSink where\\n  receipt : Option String\\n  stage : String\\n  started : Nat\\n  corpus : Json\\n  state : IO.Ref IndexedMetrics\\n\\ndef MetricsSink.flush (sink : MetricsSink) (status : String) : IO Unit := do\\n  Receipt.observe sink.receipt sink.stage (Json.mkObj [\\n    (\\\"status\\\", toJson status), (\\\"elapsedMs\\\", toJson ((← IO.monoMsNow) - sink.started)),\\n    (\\\"corpus\\\", sink.corpus), (\\\"counters\\\", toJson (← sink.state.get))])\\n\\nstructure Options where\\n  cache : System.FilePath\\n  fallback : Option System.FilePath := none\\n  privateWrite : Option System.FilePath := none\\n  owner : Option DB.Sidecar.Owner := none\\n  models : System.FilePath\\n  model : String := MiniLM.model\\n  mode : String := \\\"hybrid\\\"\\n  topK : Nat := 8\\n  anchorK : Nat := 2\\n  threshold : Float := 0.38\\n  trace : Option System.FilePath := none\\n  lane : SemanticMatcher.Lane := .search\\n  metrics : Option MetricsSink := none\\n  directories : Option DirectoryReads := none\\n  matrices : Option (IO.Ref (Std.HashMap String (Option VectorMatrix.Ready))) := none\\n\\ndef observeInput (options : Options) (query : Bool) (c : EncodingCoverage) : IO Unit := do\\n  let some sink := options.metrics | return\\n  sink.state.modify fun s => if query then {s with queryInput := s.queryInput.add c}\\n    else {s with sourceInput := s.sourceInput.add c}\\n\\ndef encoderContract : String := Sha256.hex MiniLM.embeddingSource.toUTF8\\n\\ndef number (json : Json) : Except String Float := do\\n  match json with\\n  | .num value =>\\n    let result := value.toFloat\\n    if result.isFinite then pure result else throw \\\"expected finite JSON number\\\"\\n  | _ => throw \\\"expected finite JSON number\\\"\\n\\ndef natural (value : String) : Except String Nat :=\\n  match value.toNat? with\\n  | some n => .ok n\\n  | none => .error \\\"expected a natural number\\\"\\n\\ndef parse (defaults : Options) : List String → Except String Options\\n  | [] => .ok defaults\\n  | \\\"--cache\\\" :: v :: rest => parse { defaults with cache := .mk v } rest\\n  | \\\"--model-cache\\\" :: v :: rest => parse { defaults with models := .mk v } rest\\n  | \\\"--model\\\" :: v :: rest => parse { defaults with model := v } rest\\n  | \\\"--mode\\\" :: v :: rest =>\\n      if [\\\"lexical\\\", \\\"semantic\\\", \\\"hybrid\\\"].contains v then parse { defaults with mode := v } rest\\n      else .error \\\"unsupported search mode\\\"\\n  | \\\"--top-k\\\" :: v :: rest => do parse { defaults with topK := ← natural v } rest\\n  | \\\"--anchor-k\\\" :: v :: rest => do parse { defaults with anchorK := ← natural v } rest\\n  | \\\"--threshold\\\" :: v :: rest => do parse { defaults with threshold := ← number (← Json.parse v) } rest\\n  | \\\"--trace\\\" :: v :: rest => parse { defaults with trace := some (.mk v) } rest\\n  | \\\"--lane\\\" :: \\\"index\\\" :: rest => parse { defaults with lane := .index } rest\\n  | \\\"--lane\\\" :: \\\"search\\\" :: rest => parse { defaults with lane := .search } rest\\n  | _ => .error \\\"invalid search-provider arguments\\\"\\n\\n/-- A requesting pinned document/index batch supplies its DB-owned cache.\\nRequests without a durable owner retain only the process's temporary hints. -/\\ndef cacheOptions (options : Options) (request : Json)\\n    (write : Option DB.Sidecar.Storage := none) : IO Options := do\\n  match (request.getObjVal? \\\"cache\\\").toOption with\\n  | none | some .null => pure options\\n  | some value =>\\n      let owner ← IO.ofExcept (fromJson? value : Except String DB.Sidecar.Owner)\\n      let snapshot ← owner.pin\\n      DB.Sidecar.observe snapshot\\n      let primary := DB.Sidecar.ofSnapshot snapshot\\n      let overlay ← DB.Sidecar.locate snapshot .user\\n      match write with\\n      | some storage =>\\n          let sidecar ← DB.Sidecar.prepare owner storage\\n          pure {options with\\n            cache := sidecar.semantic, owner := some owner\\n            fallback := some (if storage == .database then overlay.semantic else primary.semantic)\\n            privateWrite := none}\\n      | none =>\\n          pure {options with\\n            cache := primary.semantic, fallback := some overlay.semantic\\n            privateWrite := some overlay.semantic, owner := some owner}\\n\\ndef queryOptions (options : Options) : IO Options := do\\n  pure {options with\\n    cache := (← Paths.dataRoot) / \\\"queries\\\"\\n    owner := none, fallback := none, privateWrite := none}\\n\\nabbrev Encoder := IO.Process.Child { stdin := .piped, stdout := .piped, stderr := .inherit }\\n\\ndef encoder (options : Options) : IO Encoder := do\\n  let layout := MiniLM.layout (← Paths.installRoot)\\n  let python ← (MiniLM.runtimePython? layout) >>= fun\\n    | some python => pure python\\n    | none => throw (IO.userError \\\"MiniLM runtime is not installed\\\")\\n  let binary ← IO.appPath\\n  IO.Process.spawn {\\n    cmd := binary.toString\\n    args := #[\\\"codex-numerical-client\\\",options.model,options.models.toString,python.toString]\\n    stdin := .piped,stdout := .piped,stderr := .inherit }\\n\\ndef stopEncoder (child : Encoder) : IO Unit := do\\n  child.stdin.putStr \\\"C\\\\n\\\"\\n  child.stdin.flush\\n  let deadline := (← IO.monoMsNow)+10000\\n  repeat\\n    if let some code ← child.tryWait then\\n      unless code == 0 do throw (IO.userError \\\"numerical client exited unsuccessfully\\\")\\n      return\\n    unless (← IO.monoMsNow) < deadline do\\n      child.kill\\n      let _ ← child.wait\\n      throw (IO.userError \\\"numerical client did not close\\\")\\n    IO.sleep 5\\n\\ndef exchange (child : Encoder) (input : Json)\\n    (observe : Json → IO Unit := fun _ => pure ()) : IO Json := do\\n  child.stdin.putStr (if (input.getObjVal? \\\"texts\\\").isOk then \\\"E\\\"\\n    else if (input.getObjVal? \\\"blockRows\\\").isOk then \\\"B\\\" else \\\"S\\\")\\n  child.stdin.putStrLn input.compress\\n  child.stdin.flush\\n  let result ← IO.ofExcept (Json.parse (← child.stdout.getLine))\\n  observe result\\n  if let .ok error := result.getObjValAs? String \\\"error\\\" then throw (IO.userError error)\\n  pure result\\n\\ndef measuredExchange (options : Options) (child : Encoder) (input : Json)\\n    (phase : String) : IO Json := do\\n  if let some sink := options.metrics then\\n    sink.state.modify fun state => {state with phase}\\n    if phase != \\\"score\\\" || (← sink.state.get).encoder.isNone then sink.flush \\\"running\\\"\\n  exchange child input fun result => do\\n    let some sink := options.metrics | return\\n    let .ok sample := result.getObjValAs? EncoderSample \\\"timing\\\" | return\\n    let previous ← sink.state.get\\n    let before := previous.encoder.getD {}\\n    let after : EncoderTiming := {\\n      replies := before.replies + 1\\n      startupUs := before.startupUs + sample.startupUs\\n      leaseUs := before.leaseUs + sample.leaseUs\\n      initializeUs := before.initializeUs + sample.initializeUs\\n      queryEncodeUs := before.queryEncodeUs + if phase == \\\"query-embedding\\\" then sample.encodeUs else 0\\n      sourceEncodeUs := before.sourceEncodeUs + if phase == \\\"source-embedding\\\" then sample.encodeUs else 0\\n      scoreUs := before.scoreUs + sample.scoreUs\\n      requestUs := before.requestUs + sample.requestUs\\n      modelLoaded := before.modelLoaded || sample.modelLoaded }\\n    sink.state.modify fun state => {state with encoder := some after, phase := \\\"encoder-reply\\\"}\\n    if before.replies == 0 || phase != \\\"score\\\" then sink.flush \\\"running\\\"\\n\\n/-- Numerical hints retain only model/window digests and bounded vectors.\\n    They never establish source identity or completion authority. -/\\nstructure CachedVector where\\n  model : String\\n  window : String\\n  contract : String\\n  coverage : EncodingCoverage\\n  vector : Array String\\n  deriving ToJson, FromJson\\n\\n/-- Canonical little-endian IEEE binary64, two lowercase hexadecimal digits\\nper byte. JSON transports a string rather than reparsing decimal coefficients.\\nThe exponent occupies the last byte's low seven bits and its neighbor's high\\nnibble; all-ones rejects both infinities and every NaN payload. -/\\ndef packedFinite (encoded : String) : Bool := Id.run do\\n  let bytes := encoded.toUTF8\\n  if bytes.size == 0 || bytes.size > 4096 * 16 || bytes.size % 16 != 0 then return false\\n  for index in [:bytes.size] do\\n    let byte := bytes[index]!\\n    unless (48 ≤ byte && byte ≤ 57) || (97 ≤ byte && byte ≤ 102) do return false\\n  for word in [:bytes.size / 16] do\\n    let last := bytes[word * 16 + 14]!\\n    if (last == 55 || last == 102) && bytes[word * 16 + 15]! == 102 &&\\n        bytes[word * 16 + 12]! == 102 then return false\\n  return true\\n\\ndef packVector (vector : Json) : Except String String := do\\n  let .arr values := vector | throw \\\"expected numerical vector array\\\"\\n  unless 0 < values.size && values.size ≤ 4096 do throw \\\"invalid numerical vector dimension\\\"\\n  let mut bytes := ByteArray.empty\\n  for value in values do\\n    let bits := (← number value).toBits\\n    for index in [:8] do bytes := bytes.push ((bits >>> (index * 8).toUInt64).toUInt8)\\n  pure (Blake3.hex bytes)\\n\\nstructure CheckedVector (cached : CachedVector) : Type where\\n  valid : Receipt.validId cached.window = true ∧\\n    cached.contract = encoderContract ∧ cached.coverage.valid = true ∧\\n    cached.vector.size = cached.coverage.segments ∧\\n    cached.vector.all packedFinite = true\\n\\ndef CheckedVector.make? (cached : CachedVector) : Option (CheckedVector cached) :=\\n  if valid : Receipt.validId cached.window = true ∧\\n      cached.contract = encoderContract ∧ cached.coverage.valid = true ∧\\n      cached.vector.size = cached.coverage.segments ∧ cached.vector.all packedFinite = true then\\n    some ⟨valid⟩ else none\\n\\ntheorem CheckedVector.source_shape (checked : CheckedVector cached) :\\n    ∃ encodings : Array String, cached.vector = encodings ∧ encodings.all packedFinite = true :=\\n  ⟨cached.vector, rfl, checked.valid.2.2.2.2⟩\\n\\n\\ndef cacheMatches (model text : String) (cached : CachedVector) : Bool :=\\n  decide (cached.model = model ∧ cached.window = Persistence.Store.windowKey text)\\n\\ntheorem accepted_cache_identity (model text : String) (cached : CachedVector)\\n    (h : cacheMatches model text cached = true) :\\n    cached.model = model ∧ cached.window = Persistence.Store.windowKey text := by\\n  exact of_decide_eq_true h\\n\\ntheorem changed_cache_window_rejected (model text : String) (cached : CachedVector)\\n    (h : cached.window ≠ Persistence.Store.windowKey text) : cacheMatches model text cached = false := by\\n  simp [cacheMatches, h]\\n\\ntheorem changed_cache_model_rejected (model text : String) (cached : CachedVector)\\n    (h : cached.model ≠ model) : cacheMatches model text cached = false := by\\n  simp [cacheMatches, h]\\n\\ndef windowCacheKey (model window : String) : String :=\\n  Sha256.hex (model.toUTF8 ++ encoderContract.toUTF8) ++ \\\"-\\\" ++ window\\n\\ndef cacheKey (model text : String) : String :=\\n  windowCacheKey model (Persistence.Store.windowKey text)\\n\\ndef vectorPaths (options : Options) (key : String) : List System.FilePath :=\\n  (options.cache :: options.fallback.toList).map (· / \\\"vectors\\\" / (key ++ \\\".json\\\"))\\n\\n/-- Count the actual initial availability probes, including repeated window\\nreferences. These are not DB coverage or an inferred whole-corpus hit rate. -/\\ndef observeProbe (options : Options) (query hit : Bool) (path : System.FilePath)\\n    (elapsed : Nat) : IO Unit := do\\n  let some sink := options.metrics | return\\n  let absent ← if hit then pure false else\\n    try\\n      let paths := path :: options.fallback.toList.map (· / \\\"vectors\\\" / path.fileName.getD \\\"\\\")\\n      pure (← paths.allM fun path => return (← FileSystem.symlinkMetadata? path).isNone)\\n    catch _ => pure false\\n  sink.state.modify fun state =>\\n    let before := if query then state.query else state.source\\n    let after : CacheProbes := {\\n      hit := before.hit + if hit then 1 else 0\\n      absent := before.absent + if !hit && absent then 1 else 0\\n      unusable := before.unusable + if !hit && !absent then 1 else 0 }\\n    if query then {state with query := after, cacheMs := state.cacheMs + elapsed}\\n    else {state with source := after, cacheMs := state.cacheMs + elapsed}\\n  let state ← sink.state.get\\n  let count := state.source.hit + state.source.absent + state.source.unusable\\n  if query || count == 1 || count % 32 == 0 then sink.flush \\\"running\\\"\\n\\n/-- Cache records are bounded numerical windows, never arbitrary-size source\\nbodies. Read through one secure descriptor so replacement cannot grow a\\nchecked record between stat and allocation. Damage is a miss/pending search. -/\\ndef loadVector (path : System.FilePath) : IO CachedVector := do\\n  let bytes ← FileSystem.boundedBytes path 1048576\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid embedding cache text\\\")\\n  let cached ← IO.ofExcept (fromJson? (← IO.ofExcept (Json.parse text)) : Except String CachedVector)\\n  let some _ := CheckedVector.make? cached |\\n    throw (IO.userError \\\"embedding window or dimension exceeds its resource contract\\\")\\n  pure cached\\n\\ndef decodeVectorBytes (bytes : ByteArray) : IO CachedVector := do\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid embedding cache text\\\")\\n  let cached ← IO.ofExcept (fromJson? (← IO.ofExcept (Json.parse text)) : Except String CachedVector)\\n  let some _ := CheckedVector.make? cached |\\n    throw (IO.userError \\\"embedding window or dimension exceeds its resource contract\\\")\\n  pure cached\\n\\ntheorem load_vector_original (path : System.FilePath) :\\n    loadVector path = (do decodeVectorBytes (← FileSystem.boundedBytes path 1048576)) := by\\n  rfl\\n\\ndef loadIndexedVector (options : Options) (path : System.FilePath) : IO CachedVector := do\\n  let bytes ← match options.directories with\\n    | none => FileSystem.boundedBytes path 1048576\\n    | some reads => FileSystem.boundedRead (← reads.open path) 1048576\\n  decodeVectorBytes bytes\\n\\ndef readCachedVector (options : Options) (text : String) : IO (Option CachedVector) := do\\n  for path in vectorPaths options (cacheKey options.model text) do\\n    try\\n      let cached ← loadVector path\\n      if cacheMatches options.model text cached then return some cached\\n    catch _ => pure ()\\n  pure none\\n\\ndef readVector (options : Options) (text : String) : IO (Option Json) := do\\n  pure ((← readCachedVector options text).map (fun c => toJson c.vector))\\n\\ndef saveVector (options : Options) (text : String) (vector : Json)\\n    (coverage : EncodingCoverage) : IO Unit := do\\n  unless text.length ≤ 512 do throw (IO.userError \\\"index window exceeds source contract\\\")\\n  unless coverage.characters == text.length do throw (IO.userError \\\"embedding coverage source mismatch\\\")\\n  let group ← IO.ofExcept vector.getArr?\\n  let encodings ← IO.ofExcept (group.mapM packVector)\\n  let cached : CachedVector := {\\n    model := options.model, window := Persistence.Store.windowKey text\\n    contract := encoderContract, coverage, vector := encodings}\\n  let some _ := CheckedVector.make? cached | throw (IO.userError \\\"invalid numerical window for indexing\\\")\\n  let encoded := (toJson cached).compress\\n  unless encoded.utf8ByteSize ≤ 1048576 do throw (IO.userError \\\"oversized numerical window for indexing\\\")\\n  let root := options.privateWrite.getD options.cache / \\\"vectors\\\"\\n  let path := root / (cacheKey options.model text ++ \\\".json\\\")\\n  if let some owner := options.owner then\\n    let _ ← owner.pin\\n    if options.privateWrite.isSome then\\n      let _ ← DB.Sidecar.prepare owner .user\\n      pure ()\\n    FileSystem.atomicExistingBytes path encoded.toUTF8\\n  else\\n    Persistence.rejectSymlinkAncestors root\\n    Persistence.privateDirectory (options.privateWrite.getD options.cache)\\n    Persistence.privateDirectory root\\n    FileSystem.atomicBytes path encoded.toUTF8\\n  if let some reads := options.directories then reads.invalidate path\\n\\ndef storeWindows (options : Options) (child : Encoder) (windows : List String)\\n    (queryProbe : Bool := false) : IO Unit := do\\n  let parts := windows.eraseDups\\n  let mut missing := []\\n  for part in parts do\\n    unless part.length ≤ 512 do throw (IO.userError \\\"index window exceeds the original-window contract\\\")\\n    let started ← IO.monoMsNow\\n    let available ← readCachedVector options part\\n    if queryProbe then\\n      observeProbe options true available.isSome\\n        (options.cache / \\\"vectors\\\" / (cacheKey options.model part ++ \\\".json\\\")) ((← IO.monoMsNow) - started)\\n    if available.isNone then missing := missing ++ [part]\\n  if missing.isEmpty then return\\n  let response ← measuredExchange options child (Json.mkObj [(\\\"texts\\\", toJson missing)])\\n    (if queryProbe then \\\"query-embedding\\\" else \\\"source-embedding\\\")\\n  let vectors ← IO.ofExcept (response.getObjValAs? (Array Json) \\\"vectors\\\")\\n  if vectors.size != missing.length then throw (IO.userError \\\"embedding count mismatch\\\")\\n  let coverage ← IO.ofExcept (response.getObjValAs? (Array EncodingCoverage) \\\"coverage\\\")\\n  unless coverage.size == vectors.size do throw (IO.userError \\\"embedding coverage count mismatch\\\")\\n  for ((text, vector), measured) in (missing.zip vectors.toList).zip coverage.toList do\\n    saveVector options text vector measured\\n\\ndef store (options : Options) (child : Encoder) (texts : List String)\\n    (queryProbe : Bool := false) : IO Unit :=\\n  storeWindows options child (texts.flatMap SearchRank.windows) queryProbe\\n\\ndef vectors (options : Options) (text : String) : IO Json := do\\n  let values ← (SearchRank.windows text).mapM fun part => do\\n    let some cached ← readCachedVector options part | throw (IO.userError \\\"missing indexed embedding\\\")\\n    observeInput options true cached.coverage\\n    let pooled ← IO.ofExcept (Eggshell.WindowCentroid.project cached.vector\\n      cached.coverage.sourceTokens (cached.coverage.contextTokens - 2) cached.coverage.overlapTokens)\\n    pure #[Json.str pooled]\\n  pure (.arr values.toArray.flatten)\\n\\n/-- Window hashes only nominate numerical hints. A hint cannot establish Work\\nidentity or completion. Original graph owners are hydrated and checked by the\\nrequesting pinned reader after selection. No source body is opened here. -/\\ndef indexedWindow (options : Options) (window : String) : IO CachedVector := do\\n  unless Receipt.validId window do throw (IO.userError \\\"invalid indexed vector locator\\\")\\n  for path in vectorPaths options (windowCacheKey options.model window) do\\n    try\\n      let cached ← loadIndexedVector options path\\n      if cached.model == options.model && cached.window == window then return cached\\n    catch _ => pure ()\\n  throw (IO.userError \\\"missing or unusable indexed embedding\\\")\\n\\ndef indexedVectors (options : Options) (windows : List String) : IO Json := do\\n  let load := fun root => do\\n    let started ← IO.monoMsNow\\n    let ready ← try VectorMatrix.open? root options.model encoderContract catch _ => pure none\\n    if let some sink := options.metrics then\\n      let elapsed := (← IO.monoMsNow) - started\\n      sink.state.modify fun state => {state with\\n        matrixOpens := state.matrixOpens + 1\\n        matrixOpenMs := state.matrixOpenMs + elapsed}\\n    pure ready\\n  let values ← windows.mapM fun window => do\\n    if options.owner.isSome then\\n      for root in options.cache :: options.fallback.toList do\\n        try\\n          let ready ← match options.matrices with\\n            | none => load root\\n            | some known =>\\n                match (← known.get)[root.toString]? with\\n                | some ready => pure ready\\n                | none => do\\n                    let ready ← load root\\n                    known.modify (·.insert root.toString ready)\\n                    pure ready\\n          if let some ready := ready then\\n            if let some (metadata,pooled) ← VectorMatrix.read ready window then\\n              let coverage ← IO.ofExcept (Json.parse metadata >>= fromJson? (α := EncodingCoverage))\\n              unless coverage.valid && packedFinite pooled do throw (IO.userError \\\"invalid projected numerical row\\\")\\n              observeInput options false coverage\\n              if let some sink := options.metrics then\\n                sink.state.modify fun state => {state with matrixRows := state.matrixRows + 1}\\n              return #[Json.str pooled]\\n        catch _ => pure ()\\n    let cached ← indexedWindow options window\\n    observeInput options false cached.coverage\\n    let pooled ← IO.ofExcept (Eggshell.WindowCentroid.project cached.vector\\n      cached.coverage.sourceTokens (cached.coverage.contextTokens - 2) cached.coverage.overlapTokens)\\n    pure #[Json.str pooled]\\n  pure (.arr values.toArray.flatten)\\n\\n/-- Prepare source-only pooled hints after raw-cache coverage is checked.\\nQuestions remain private and do not enter this DB-owned matrix. -/\\ndef prepareMatrix (options : Options) (keys : List String) : IO VectorMatrix.Result := do\\n  let keys := hashDistinct keys\\n  VectorMatrix.ensureUsing options.cache options.model encoderContract keys fun key => do\\n    let cached ← indexedWindow options key\\n    let pooled ← IO.ofExcept (Eggshell.WindowCentroid.project cached.vector\\n      cached.coverage.sourceTokens (cached.coverage.contextTokens - 2) cached.coverage.overlapTokens)\\n    return ⟨key,(toJson cached.coverage).compress,pooled⟩\\n\\n\\nabbrev RepairWindows := Nat → List (Nat × String) → IO (List String)\\n\\ndef unavailableRepair : RepairWindows := fun _ _ => throw (IO.userError \\\"missing indexed embedding\\\")\\n\\n/-- Only missing windows are re-encoded. Exact locator verification precedes\\ninference and acknowledgement; a corrupted/missing hint cannot omit evidence\\nor substitute another source. The batch makes one repair attempt. -/\\ndef repairBatch (options : Options) (child : Encoder) (document offset : Nat)\\n    (windows : List String) (repair : RepairWindows) : IO (Array BlockScore.Input) := do\\n  if let some owner := options.owner then\\n    return windows.toArray.map (BlockScore.Input.indexed owner)\\n  let mut missing : List (Nat × String) := []\\n  let mut retained : Array (Option Json) := #[]\\n  for (window, index) in windows.zipIdx do\\n    let started ← IO.monoMsNow\\n    let available ← try some <$> indexedVectors options [window] catch _ => pure none\\n    observeProbe options false available.isSome\\n      (options.cache / \\\"vectors\\\" / (windowCacheKey options.model window ++ \\\".json\\\")) ((← IO.monoMsNow) - started)\\n    retained := retained.push available\\n    if available.isNone then missing := (offset + index, window) :: missing\\n  missing := missing.reverse\\n  unless missing.isEmpty do\\n    if let some owner := options.owner then\\n      PreparationDebt.record owner options.model encoderContract .unavailableInput missing.length\\n    let texts ← repair document missing\\n    unless texts.length == missing.length do throw (IO.userError \\\"numerical window repair count mismatch\\\")\\n    for (text, (_, digest)) in texts.zip missing do\\n      unless text.length ≤ 512 && Persistence.Store.windowKey text == digest do\\n        throw (IO.userError \\\"numerical window repair source mismatch\\\")\\n    storeWindows options child texts\\n  -- Each valid numerical window is already checked and read. Hold only this\\n  -- bounded batch; reread repaired misses, never all successful cache hits.\\n  windows.zipIdx.toArray.mapM fun (window, index) => do\\n    let vector ← match retained[index]?.getD none with\\n      | some vector => pure vector\\n      | none => indexedVectors options [window]\\n    let values ← IO.ofExcept (fromJson? vector : Except String (Array String))\\n    unless values.size == 1 do throw (IO.userError \\\"transient projection count disagrees\\\")\\n    return .projected values[0]!\\n\\ndef trace (options : Options) (record : Json) : IO Unit := do\\n  if let some path := options.trace then\\n    try\\n      if let some parent := path.parent then Persistence.privateDirectory parent\\n      let file ← IO.FS.Handle.mk path .append\\n      Persistence.privateFile path\\n      file.putStrLn record.compress\\n      file.flush\\n    catch error => IO.eprintln s!\\\"Eggshell trace: {error}\\\"\\n\\n/-- This is optional process-local acceleration, not a source-data limit.\\nKeeping the previous input permits delta frequency repair on a repeated\\nprovider request. Large requests are still evaluated, then not retained. -/\\ndef corpusBytes (texts : List String) : Nat := (texts.map String.utf8ByteSize).sum\\n\\nstructure RetainedCorpus where\\n  texts : List String\\n  corpus : SearchRank.Corpus texts\\n  bounded : corpusBytes texts ≤ 1048576\\n\\ndef retainCorpus (texts : List String) (corpus : SearchRank.Corpus texts) : Option RetainedCorpus :=\\n  if bounded : corpusBytes texts ≤ 1048576 then some ⟨texts, corpus, bounded⟩ else none\\n\\ntheorem oversized_corpus_not_retained (texts : List String) (corpus : SearchRank.Corpus texts)\\n    (large : 1048576 < corpusBytes texts) : retainCorpus texts corpus = none := by\\n  have outside : ¬ corpusBytes texts ≤ 1048576 := by omega\\n  simp only [retainCorpus, dif_neg outside]\\n\\ndef selection (options : Options) (candidates : Array Json) (lexical anchors : List Nat)\\n    (scored : List (Float × Nat)) : IO Json := do\\n  let ordered := scored.mergeSort SearchRank.scoreOrder\\n  let semantic := (ordered.filter (·.1 ≥ options.threshold)).map (·.2)\\n  let hybrid := (SearchRank.fused [lexical, semantic]).take options.topK\\n  let base := if options.mode == \\\"hybrid\\\" then hybrid else if options.mode == \\\"lexical\\\" then lexical else semantic\\n  let selected := SearchRank.select candidates.size options.topK (anchors.take options.anchorK) base\\n  trace options (Json.mkObj [(\\\"mode\\\", .str options.mode), (\\\"candidate_count\\\", toJson candidates.size),\\n    (\\\"candidate_ids\\\", .arr (candidates.map (·.getObjValD \\\"id\\\"))),\\n    (\\\"lexical_rank\\\", toJson lexical), (\\\"anchor_rank\\\", toJson anchors),\\n    (\\\"semantic_rank\\\", toJson (ordered.map (·.2))), (\\\"semantic_threshold_rank\\\", toJson semantic),\\n    (\\\"hybrid_rank\\\", toJson hybrid), (\\\"selected\\\", toJson selected)])\\n  pure (Json.mkObj [(\\\"related\\\", toJson selected)])\\n\\nstructure WindowBatch (source : List String) where\\n  front : List String\\n  rest : List String\\n  complete : front ++ rest = source\\n  bounded : front.length ≤ 32\\n  decreases : source ≠ [] → rest.length < source.length\\n\\ndef WindowBatch.make (source : List String) : WindowBatch source := {\\n  front := source.take 32, rest := source.drop 32\\n  complete := List.take_append_drop 32 source\\n  bounded := by simp only [List.length_take]; exact Nat.min_le_left _ _\\n  decreases := by\\n    intro nonempty\\n    have positive := List.length_pos_iff.mpr nonempty\\n    simp only [List.length_drop]\\n    omega }\\n\\ntheorem WindowBatch.existing (batch : WindowBatch source) (window : String)\\n    (present : window ∈ batch.front) : window ∈ source := by\\n  rw [← batch.complete]\\n  exact List.mem_append_left _ present\\n\\n/-- Presentation keeps the configured retrieval policy throughout the\\nadmitted graph, instead of reverting to a purely numerical order after hybrid\\nretrieval. Admission anchors do not override the current-question fusion.\\nNo owner is excluded by this order; nominations are computed separately. -/\\ndef presentationRanking (mode : String) (count : Nat) (semantic lexical : List Nat) : List Nat :=\\n  let combined := if mode == \\\"lexical\\\" then lexical\\n    else if mode == \\\"semantic\\\" then semantic\\n    else SearchRank.fused [semantic, lexical]\\n  (combined ++ semantic ++ lexical ++ List.range count).eraseDups.filter (· < count)\\n\\ndef presentationRankingIndexed (mode : String) (count : Nat) (semantic lexical : List Nat) : List Nat :=\\n  let combined := if mode == \\\"lexical\\\" then lexical\\n    else if mode == \\\"semantic\\\" then semantic\\n    else SearchRank.fused [semantic, lexical]\\n  (hashDistinct (combined ++ semantic ++ lexical ++ List.range count)).filter (· < count)\\n\\n@[csimp] theorem presentation_ranking_compiled : presentationRanking = presentationRankingIndexed := by\\n  funext mode count semantic lexical\\n  simp only [presentationRanking, presentationRankingIndexed, HashDistinct.reference]\\n\\ntheorem presentation_ranking_original (mode : String) (count : Nat)\\n    (semantic lexical : List Nat) (index : Nat)\\n    (present : index ∈ presentationRanking mode count semantic lexical) : index < count := by\\n  exact of_decide_eq_true (List.mem_filter.mp present).2\\n\\ntheorem presentation_ranking_complete (mode : String) (count : Nat)\\n    (semantic lexical : List Nat) (index : Nat) (valid : index < count) :\\n    index ∈ presentationRanking mode count semantic lexical := by\\n  apply List.mem_filter.mpr\\n  refine ⟨List.mem_eraseDups.mpr ?_, by simpa using valid⟩\\n  exact List.mem_append_right _ (List.mem_range.mpr valid)\\n\\ntheorem presentation_ranking_no_duplicates (mode : String) (count : Nat)\\n    (semantic lexical : List Nat) :\\n    (presentationRanking mode count semantic lexical).Nodup :=\\n  List.filter_sublist.nodup (SearchRank.deduplicated_nodup _)\\n\\nstructure WindowScore where\\n  best : Option Float := none\\n  positions : List (Float × Nat) := []\\n\\ndef WindowScore.add (state : WindowScore) (score : Float) (position : Nat) : WindowScore := {\\n  best := some (state.best.map (fun previous => if score > previous then score else previous) |>.getD score)\\n  positions := ((score, position) :: state.positions).mergeSort SearchRank.scoreOrder |>.take 16 }\\n\\n/-- Focus accumulates once and sorts once. It does not discard already scored\\noriginal positions or repeatedly sort an ever-growing list for every row. -/\\ndef WindowScore.addComplete (state : WindowScore) (score : Float) (position : Nat) : WindowScore := {\\n  best := (state.add score position).best\\n  positions := (score,position) :: state.positions }\\n\\ntheorem WindowScore.complete_best_unchanged (state : WindowScore) (score : Float) (position : Nat) :\\n    (state.addComplete score position).best = (state.add score position).best := rfl\\n\\ntheorem WindowScore.complete_retains (state : WindowScore) (score : Float) (position : Nat)\\n    (prior : Float × Nat) (present : prior ∈ state.positions) :\\n    prior ∈ (state.addComplete score position).positions := List.mem_cons_of_mem _ present\\n\\nstructure ScoringWindow where\\n  document : Nat\\n  position : Nat\\n  vector : BlockScore.Input\\n\\n/-- Scoring transport is independent of the encoder's 32-segment inference\\nbatch. Every window keeps its original document/position, and NumPy still\\nevaluates each original dot product independently in the same order. -/\\ndef scoreWindows (options : Options) (child : Encoder) (queries : Json)\\n    (batch : Array ScoringWindow) (totals : Array WindowScore)\\n    (completeEvidence : Bool := false) : IO (Array WindowScore) := do\\n  unless !batch.isEmpty && batch.size ≤ 256 do throw (IO.userError \\\"invalid numerical scoring batch\\\")\\n  let started ← IO.monoMsNow\\n  let response ← measuredExchange options child (Json.mkObj [\\n    (\\\"queries\\\", queries), (\\\"blockRows\\\", toJson (batch.map (·.vector)))]) \\\"score\\\"\\n  let coverages ← IO.ofExcept (response.getObjValAs? (Array (Option String)) \\\"coverage\\\")\\n  unless coverages.size == batch.size do throw (IO.userError \\\"block coverage count mismatch\\\")\\n  for metadata in coverages do\\n    if let some metadata := metadata then\\n      let coverage ← IO.ofExcept (Json.parse metadata >>= fromJson? (α := EncodingCoverage))\\n      unless coverage.valid do throw (IO.userError \\\"invalid blocked projection coverage\\\")\\n      observeInput options false coverage\\n  if let some sink := options.metrics then\\n    let reads ← IO.ofExcept (response.getObjValAs? Nat \\\"sourceReadMs\\\")\\n    let hits ← IO.ofExcept (response.getObjValAs? Nat \\\"projectionHits\\\")\\n    let misses ← IO.ofExcept (response.getObjValAs? Nat \\\"projectionMisses\\\")\\n    let retained ← IO.ofExcept (response.getObjValAs? Nat \\\"retainedBytes\\\")\\n    let durable := coverages.toList.countP Option.isSome\\n    sink.state.modify fun state => {state with\\n      projectionReadMsWithinScore := state.projectionReadMsWithinScore + reads\\n      projectionHits := state.projectionHits + hits\\n      projectionMisses := state.projectionMisses + misses\\n      projectionRetainedBytes := retained\\n      matrixRows := state.matrixRows + durable\\n      source := {state.source with hit := state.source.hit + durable}}\\n  let scores ← IO.ofExcept (response.getObjValAs? (Array Json) \\\"scores\\\")\\n  unless scores.size == batch.size do throw (IO.userError \\\"indexed similarity count mismatch\\\")\\n  if let some sink := options.metrics then\\n    let elapsed := (← IO.monoMsNow) - started\\n    sink.state.modify fun state => {state with\\n      scoreMs := state.scoreMs + elapsed, scoredWindows := state.scoredWindows + batch.size}\\n  let mut totals := totals\\n  for (value, window) in scores.toList.zip batch.toList do\\n    let score ← IO.ofExcept (number value)\\n    unless window.document < totals.size do throw (IO.userError \\\"numerical score names a foreign document\\\")\\n    totals := totals.modify window.document fun state =>\\n      if completeEvidence then state.addComplete score window.position else state.add score window.position\\n  pure totals\\n\\ndef indexedEvidenceWindows (evidence : List (Nat × List Nat))\\n    (ranked : List Nat) : List SemanticMatcher.WindowChoice :=\\n  ranked.filterMap fun index =>\\n    (evidence.find? (·.1 == index)).map fun row => ⟨row.1, row.2⟩\\n\\ndef indexedEvidenceWindowsUsing (evidence : List (Nat × List Nat))\\n    (ranked : List Nat) : List SemanticMatcher.WindowChoice :=\\n  let directory := FirstIndex.make Prod.fst evidence\\n  ranked.filterMap fun index => (directory.read index).map fun row => ⟨row.1, row.2⟩\\n\\n@[csimp] theorem indexed_evidence_windows_compiled : indexedEvidenceWindows = indexedEvidenceWindowsUsing := by\\n  funext evidence ranked\\n  simp only [indexedEvidenceWindows, indexedEvidenceWindowsUsing, FirstIndex.read_exact]\\n\\n/-- Candidate payloads never cross this protocol. Numerical scoring uses\\nbounded batches of pre-indexed vectors and the identical selection kernel.\\nMissing vectors fail explicitly; the search cannot silently omit a candidate. -/\\ndef handleIndexedUsing (options : Options) (child : Option Encoder) (query : String)\\n    (request : Json) (repair : RepairWindows := unavailableRepair) : IO Json := do\\n  let options := {options with directories := some (← DirectoryReads.new), matrices := some (← IO.mkRef {})}\\n  let candidates ← IO.ofExcept (request.getObjValAs? (Array Json) \\\"documents\\\")\\n  let lexical ← IO.ofExcept (request.getObjValAs? (List Nat) \\\"lexical\\\")\\n  let anchors ← IO.ofExcept (request.getObjValAs? (List Nat) \\\"anchors\\\")\\n  let completeEvidence := (request.getObjValAs? String \\\"purpose\\\").toOption == some \\\"focus\\\"\\n  let mut scored : List (Float × Nat) := []\\n  let mut evidence : List (Nat × List Nat) := []\\n  if let some child := child then\\n    -- Questions belong to the user, independently of every shared source DB.\\n    let prepared ← IO.mkRef ({} : Std.HashMap String Options)\\n    let resolve := fun candidate => do\\n      let key := candidate.getObjValD \\\"cache\\\" |>.compress\\n      if let some known := (← prepared.get)[key]? then return known\\n      let known ← cacheOptions options candidate\\n      prepared.modify (·.insert key known)\\n      pure known\\n    let queryOptions ← queryOptions options\\n    let queryVectors ← IO.mkRef (none : Option Json)\\n    let queries := do\\n      match ← queryVectors.get with\\n      | some queries => pure queries\\n      | none => do\\n          let started ← IO.monoMsNow\\n          store queryOptions child [query] true\\n          let queries ← vectors queryOptions query\\n          if let some sink := options.metrics then\\n            let elapsed := (← IO.monoMsNow) - started\\n            sink.state.modify fun state => {state with queryMs := state.queryMs + elapsed}\\n          queryVectors.set (some queries)\\n          pure queries\\n    let mut totals := Array.replicate candidates.size ({} : WindowScore)\\n    let mut pending : Array ScoringWindow := #[]\\n    for (candidate, index) in candidates.toList.zipIdx do\\n      let documentOptions ← resolve candidate\\n      let windows ← IO.ofExcept (candidate.getObjValAs? (List String) \\\"windows\\\")\\n      if windows.isEmpty then throw (IO.userError \\\"empty indexed window directory\\\")\\n      let mut remaining := windows\\n      while !remaining.isEmpty do\\n        let offset := windows.length - remaining.length\\n        let batch := WindowBatch.make remaining\\n        remaining := batch.rest\\n        let candidateVectors ← repairBatch documentOptions child index offset batch.front repair\\n        for (vector, localIndex) in candidateVectors.toList.zipIdx do\\n          pending := pending.push ⟨index, offset + localIndex, vector⟩\\n          if pending.size == 256 then\\n            -- A cold source is rejected before this batch starts inference.\\n            totals ← scoreWindows options child (← queries) pending totals completeEvidence\\n            pending := #[]\\n    if !pending.isEmpty then totals ← scoreWindows options child (← queries) pending totals completeEvidence\\n    for (result, index) in totals.toList.zipIdx do\\n      let some score := result.best | throw (IO.userError \\\"indexed candidate has no numerical score\\\")\\n      scored := (score, index) :: scored\\n      let positions := if completeEvidence then result.positions.mergeSort SearchRank.scoreOrder else result.positions\\n      evidence := (index, positions.map Prod.snd) :: evidence\\n  else if completeEvidence then\\n    -- Lexical-only providers have no numerical ranking. Preserve the actual\\n    -- source directory; the caller's lexical fusion orders these originals.\\n    for (candidate,index) in candidates.toList.zipIdx do\\n      let windows ← IO.ofExcept (candidate.getObjValAs? (List String) \\\"windows\\\")\\n      evidence := (index,List.range windows.length) :: evidence\\n  let selected ← selection options candidates lexical anchors scored.reverse\\n  let related ← IO.ofExcept (selected.getObjValAs? (List Nat) \\\"related\\\")\\n  -- All cached similarities were already computed. Keep their complete order\\n  -- for graph-neighbor budgeting; this does not change relatedness admission.\\n  let ranked := presentationRanking options.mode candidates.size\\n    ((scored.reverse.mergeSort SearchRank.scoreOrder).map (·.2)) lexical\\n  let windows := indexedEvidenceWindows evidence ranked\\n  trace options (Json.mkObj [(\\\"evidence_windows\\\", toJson windows)])\\n  pure (Json.mkObj [(\\\"related\\\", toJson related), (\\\"ranked\\\", toJson ranked), (\\\"evidence\\\", toJson windows)])\\n\\ndef handleIndexed (options : Options) (child : Option Encoder) (query : String)\\n    (request : Json) (repair : RepairWindows := unavailableRepair) : IO Json := do\\n  let receipt := (request.getObjValAs? String \\\"receipt\\\").toOption.filter Receipt.validId\\n  if receipt.isNone then return ← handleIndexedUsing options child query request repair\\n  let documents ← IO.ofExcept (request.getObjValAs? (Array Json) \\\"documents\\\")\\n  let windows ← documents.toList.mapM fun document =>\\n    IO.ofExcept (document.getObjValAs? (List String) \\\"windows\\\")\\n  let sink : MetricsSink := {\\n    receipt, stage := s!\\\"numerical-{← IO.Process.getPID}-{← IO.monoNanosNow}\\\"\\n    started := ← IO.monoMsNow, state := ← IO.mkRef {}\\n    corpus := Json.mkObj [(\\\"documents\\\", toJson documents.size),\\n      (\\\"purpose\\\", (request.getObjValAs? String \\\"purpose\\\").toOption.map toJson |>.getD Json.null),\\n      (\\\"numerical\\\", toJson child.isSome),\\n      (\\\"windowReferences\\\", toJson (windows.map List.length).sum),\\n      (\\\"durableDocuments\\\", toJson (documents.filter (fun document =>\\n        document.getObjValD \\\"cache\\\" != Json.null)).size)] }\\n  sink.flush \\\"running\\\"\\n  try\\n    let result ← handleIndexedUsing {options with metrics := some sink} child query request repair\\n    sink.flush \\\"completed\\\"\\n    pure result\\n  catch error =>\\n    sink.flush \\\"failed\\\"\\n    throw error\\n\\ndef handle (options : Options) (child : Option Encoder)\\n    (previous : IO.Ref (Option RetainedCorpus)) (request : Json)\\n    (repair : RepairWindows := unavailableRepair) : IO (Option Json) := do\\n  if let .ok index := request.getObjValAs? (Array Json) \\\"index_windows\\\" then\\n    if let some child := child then\\n      let options ← cacheOptions options request\\n        (some ((request.getObjValAs? DB.Sidecar.Storage \\\"cache_storage\\\").toOption.getD .database))\\n      let texts ← IO.ofExcept (index.toList.mapM (·.getObjValAs? String \\\"text\\\"))\\n      storeWindows options child texts\\n    let ids ← IO.ofExcept (index.toList.mapM (·.getObjValAs? String \\\"id\\\"))\\n    return some (Json.mkObj [(\\\"indexed\\\", toJson ids)])\\n  if let .ok index := request.getObjValAs? (Array Json) \\\"index\\\" then\\n    if let some child := child then\\n      let options ← cacheOptions options request\\n        (some ((request.getObjValAs? DB.Sidecar.Storage \\\"cache_storage\\\").toOption.getD .database))\\n      let texts ← IO.ofExcept (index.toList.mapM (·.getObjValAs? String \\\"text\\\"))\\n      store options child texts\\n    let ids ← IO.ofExcept (index.toList.mapM (·.getObjValAs? String \\\"id\\\"))\\n    return some (Json.mkObj [(\\\"indexed\\\", toJson ids)])\\n  let query ← IO.ofExcept ((request.getObjValD \\\"query\\\").getObjValAs? String \\\"text\\\")\\n  if (request.getObjVal? \\\"documents\\\").isOk then\\n    return some (← handleIndexed options child query request repair)\\n  let candidates ← IO.ofExcept (request.getObjValAs? (Array Json) \\\"candidates\\\")\\n  let texts ← IO.ofExcept (candidates.toList.mapM (·.getObjValAs? String \\\"text\\\"))\\n  let corpus := match ← previous.get with\\n    | some retained => retained.corpus.revise texts\\n    | none => SearchRank.Corpus.build texts\\n  previous.set (retainCorpus texts corpus)\\n  let lexical := corpus.rank query\\n  let anchors := corpus.rank query true\\n  let mut scored : List (Float × Nat) := []\\n  if let some child := child then\\n    let queryOptions ← queryOptions options\\n    store options child texts\\n    store queryOptions child [query]\\n    let response ← exchange child (Json.mkObj [(\\\"queries\\\", ← vectors queryOptions query),\\n      (\\\"candidates\\\", .arr (← texts.toArray.mapM (vectors options)))])\\n    let scores ← IO.ofExcept (response.getObjValAs? (Array Json) \\\"scores\\\")\\n    if scores.size != candidates.size then throw (IO.userError \\\"similarity count mismatch\\\")\\n    scored ← IO.ofExcept (scores.toList.zipIdx.mapM fun (value, index) => do pure (← number value, index))\\n  let selected ← selection options candidates lexical anchors scored\\n  let related ← IO.ofExcept (selected.getObjValAs? (List Nat) \\\"related\\\")\\n  let ranked := presentationRanking options.mode candidates.size\\n    ((scored.mergeSort SearchRank.scoreOrder).map (·.2)) lexical\\n  pure (some (Json.mkObj [(\\\"related\\\", toJson related), (\\\"ranked\\\", toJson ranked)]))\\n\\ndef run (args : List String) : IO UInt32 := IO.FS.withTempDir fun scratch => do\\n  let scratch ← IO.FS.realPath scratch\\n  let layout := MiniLM.layout (← Paths.installRoot)\\n  let options ← IO.ofExcept (parse { cache := scratch, models := layout.models } args)\\n  let child ← if options.mode == \\\"lexical\\\" then pure none else some <$> encoder options\\n  let previous ← IO.mkRef (none : Option RetainedCorpus)\\n  try\\n    let stdin ← IO.getStdin\\n    let stdout ← IO.getStdout\\n    let repair : RepairWindows := fun document windows => do\\n      stdout.putStrLn (Json.mkObj [(\\\"need_windows\\\", Json.mkObj [\\n        (\\\"document\\\", toJson document), (\\\"indices\\\", toJson (windows.map Prod.fst))])]).compress\\n      stdout.flush\\n      let response ← IO.ofExcept (Json.parse (← stdin.getLine))\\n      IO.ofExcept (response.getObjValAs? (List String) \\\"windows\\\")\\n    repeat\\n      let line ← stdin.getLine\\n      if line.isEmpty then break\\n      try\\n        let request ← IO.ofExcept (Json.parse line)\\n        if let some result ← handle options child previous request repair then\\n          stdout.putStrLn result.compress\\n          stdout.flush\\n      catch error =>\\n        IO.eprintln s!\\\"Eggshell search: {error}\\\"\\n        stdout.putStrLn (Json.mkObj [(\\\"error\\\", .str (toString error))]).compress\\n        stdout.flush\\n    pure 0\\n  finally\\n    if let some child := child then\\n      stopEncoder child\\n\\nend Eggshell.SearchProvider\\n\",[]]"],["Eggshell.SearchRank","[\"module\\n\\npublic import Eggshell.SearchUnicode\\npublic import Eggshell.HashDistinct\\npublic import tools.RetrievalGrams\\npublic import Eggshell.Frequency\\npublic import tools.FirstIndex\\npublic import Lean.Data.Json\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SearchRank\\n\\ndef log1p (x : Float) : Float := RetrievalResearch.log1p x\\n\\ndef asciiTerm (c : Char) : Bool := RetrievalResearch.asciiTerm c\\n\\ndef rawTerms (text : String) : List String := RetrievalResearch.tokens text\\n\\ndef terms (text : String) : List String := hashDistinct (rawTerms text)\\n\\ntheorem deduplicated_nodup [BEq α] [LawfulBEq α] (xs : List α) : xs.eraseDups.Nodup := by\\n  match xs with\\n  | [] => simp\\n  | x :: tail =>\\n    rw [List.eraseDups_cons, List.nodup_cons]\\n    constructor\\n    · simp\\n    · exact deduplicated_nodup (tail.filter fun y => !y == x)\\ntermination_by xs.length\\ndecreasing_by\\n  have := List.length_filter_le (fun y => !y == x) tail\\n  simp only [List.length_cons]\\n  omega\\n\\ntheorem terms_nodup (text : String) : (terms text).Nodup :=\\n  HashDistinct.nodup (rawTerms text)\\n\\ndef anchor (term : String) : Bool := RetrievalResearch.anchor term\\n\\ndef scoreOrder (a b : Float × Nat) : Bool :=\\n  a.1 > b.1 || (a.1 == b.1 && a.2 ≤ b.2)\\n\\ndef rankRows (query : String) (rows : List α) (contains : α → String → Bool)\\n    (frequency : String → Nat) (anchors : Bool) (population : Nat := rows.length) : List Nat :=\\n  RetrievalResearch.rankRows query rows contains frequency anchors population\\n\\ndef rankDocuments (query : String) (documents : List (List String))\\n    (frequency : String → Nat) (anchors : Bool) : List Nat :=\\n  rankRows query documents List.contains frequency anchors\\n\\n/-- The indexed reader supplies complete query-term postings and global\\ncounts. Row enumeration preserves the provider's existing stable tie-break;\\nsource text and every unrelated document term remain unread. -/\\ntheorem rankRows_map (query : String) (rows : List α) (project : α → β)\\n    (contains : β → String → Bool) (frequency : String → Nat) (anchors : Bool) :\\n    rankRows query (rows.map project) contains frequency anchors =\\n      rankRows query rows (fun row term => contains (project row) term) frequency anchors := by\\n  simp only [rankRows, RetrievalResearch.rankRows, List.length_map, List.zipIdx_map, List.filterMap_map]\\n  rfl\\n\\n/-- The oracle preserves query-term order, floating-point operations and the\\nstable index tie-break. No mathematical rearrangement of Float sums is used. -/\\ndef referenceLexical (query : String) (candidates : List String)\\n    (anchors := false) : List Nat :=\\n  let documents := candidates.map terms\\n  rankDocuments query documents (fun term => (documents.filter (·.contains term)).length) anchors\\n\\ntheorem document_count_exact (candidates : List String) (term : String) :\\n    Frequency.count (candidates.map terms) term =\\n      ((candidates.map terms).filter (·.contains term)).length := by\\n  induction candidates with\\n  | nil => rfl\\n  | cons text rest ih =>\\n      simp only [List.map_cons, Frequency.count_cons, (terms_nodup text).count, ih,\\n        List.filter_cons, List.contains_eq_mem]\\n      split <;> simp_all [Nat.add_comm]\\n\\ntheorem document_frequency_append (left right : List (List String)) (term : String) :\\n    ((left ++ right).filter (·.contains term)).length =\\n      (left.filter (·.contains term)).length + (right.filter (·.contains term)).length := by\\n  simp\\n\\n/-- Reusable document compilation and a certified signed frequency index.\\nIts candidate sequence includes deletions, corrections and order changes. -/\\nstructure Corpus (candidates : List String) where\\n  documents : List (List String)\\n  exact : documents = candidates.map terms\\n  frequencies : Frequency.Index documents\\n\\ndef Corpus.build (candidates : List String) : Corpus candidates :=\\n  let documents := candidates.map terms\\n  ⟨documents, rfl, Frequency.Index.empty.replace documents [] documents (by intro term; simp)⟩\\n\\n/-- Unchanged prefix/suffix terms are reused. Only the changed region is\\nparsed, subtracted and added; zero counts disappear from the signed map. -/\\ndef Corpus.revise {before : List String} (previous : Corpus before)\\n    (after : List String) : Corpus after :=\\n  let region := Frequency.affectedRegion before after\\n  let left := previous.documents.take region.left.length\\n  let removed := (previous.documents.drop region.left.length).take region.removed.length\\n  let right := previous.documents.drop (region.left.length + region.removed.length)\\n  have leftExact : left = region.left.map terms := by\\n    simp [left, previous.exact, region.old, List.map_append]\\n  have removedExact : removed = region.removed.map terms := by\\n    simp [removed, previous.exact, region.old, List.map_append, List.append_assoc]\\n  have rightExact : right = region.right.map terms := by\\n    simp [right, previous.exact, region.old, List.map_append, List.append_assoc,\\n      ← List.drop_drop]\\n  let added := region.added.map terms\\n  let documents := left ++ added ++ right\\n  have exact : documents = after.map terms := by\\n    simp [documents, leftExact, rightExact, added, region.current, List.map_append]\\n  let frequencies := previous.frequencies.replace documents removed added (by\\n    intro term\\n    rw [previous.exact, exact, removedExact]\\n    simp only [region.old, region.current, List.map_append, Frequency.count_append]\\n    dsimp only [added]\\n    omega)\\n  ⟨documents, exact, frequencies⟩\\n\\ndef Corpus.rank {candidates : List String} (corpus : Corpus candidates) (query : String)\\n    (anchors := false) : List Nat :=\\n  rankDocuments query corpus.documents (fun term => (corpus.frequencies.counts.getD term 0).toNat) anchors\\n\\ntheorem Corpus.rank_exact {candidates : List String} (corpus : Corpus candidates)\\n    (query : String) (anchors : Bool) : corpus.rank query anchors = referenceLexical query candidates anchors := by\\n  have frequencies : (fun term => (corpus.frequencies.counts.getD term 0).toNat) =\\n      fun term => ((candidates.map terms).filter (·.contains term)).length := by\\n    funext term\\n    rw [corpus.frequencies.exact, corpus.exact, document_count_exact]\\n    simp\\n  simp only [rank, referenceLexical, corpus.exact, frequencies]\\n\\ndef lexical (query : String) (candidates : List String) (anchors := false) : List Nat :=\\n  (Corpus.build candidates).rank query anchors\\n\\ntheorem lexical_exact (query : String) (candidates : List String) (anchors : Bool) :\\n    lexical query candidates anchors = referenceLexical query candidates anchors :=\\n  Corpus.rank_exact _ query anchors\\n\\ndef fused (rankings : List (List Nat)) : List Nat :=\\n  let ids := rankings.flatten.eraseDups\\n  let scores := ids.map fun id =>\\n    (rankings.foldl (fun score ranking =>\\n      match (ranking.zipIdx.find? (·.1 == id)) with\\n      | some (_, rank) => score + 1 / (61 + rank).toFloat\\n      | none => score) (0 : Float), id)\\n  (scores.mergeSort scoreOrder).map (·.2)\\n\\n/-- Build each first-position directory once. Floating-point additions keep\\ntheir original ranking order, including duplicated ids within a ranking. -/\\ndef fusedIndexed (rankings : List (List Nat)) : List Nat :=\\n  let directories := rankings.map fun ranking => firstTable Prod.fst ranking.zipIdx\\n  let ids := hashDistinct rankings.flatten\\n  let scores := ids.map fun id =>\\n    (directories.foldl (fun score directory =>\\n      match directory[id]? with\\n      | some (_, rank) => score + 1 / (61 + rank).toFloat\\n      | none => score) (0 : Float), id)\\n  (scores.mergeSort scoreOrder).map (·.2)\\n\\n@[csimp] theorem fused_compiled : fused = fusedIndexed := by\\n  funext rankings\\n  simp only [fused, fusedIndexed, HashDistinct.reference, List.foldl_map,\\n    firstTable_exact]\\n\\n/-- All provider output goes through this constructor. It cannot invent an\\n    index, duplicate an outcome, or exceed the selected context budget. -/\\ndef select (count limit : Nat) (anchors ranking : List Nat) : List Nat :=\\n  ((anchors ++ ranking).eraseDups.filter (· < count)).take limit\\n\\ndef selectIndexed (count limit : Nat) (anchors ranking : List Nat) : List Nat :=\\n  ((hashDistinct (anchors ++ ranking)).filter (· < count)).take limit\\n\\n@[csimp] theorem select_compiled : select = selectIndexed := by\\n  funext count limit anchors ranking\\n  simp only [select, selectIndexed, HashDistinct.reference]\\n\\ntheorem selected_no_duplicates (n k : Nat) (a r : List Nat) : (select n k a r).Nodup := by\\n  exact (List.take_sublist k _).nodup (List.filter_sublist.nodup (deduplicated_nodup (a ++ r)))\\n\\ntheorem selected_within_budget (n k : Nat) (a r : List Nat) :\\n    (select n k a r).length ≤ k := by simp [select, List.length_take, Nat.min_le_left]\\n\\ntheorem selected_is_existing (n k : Nat) (a r : List Nat) (id : Nat)\\n    (member : id ∈ select n k a r) : id < n := by\\n  have h := List.mem_of_mem_take member\\n  have filtered := List.mem_filter.mp h\\n  simpa using filtered.2\\n\\ntheorem selected_was_ranked (n k : Nat) (a r : List Nat) (id : Nat)\\n    (member : id ∈ select n k a r) : id ∈ a ∨ id ∈ r := by\\n  have h := List.mem_of_mem_take member\\n  have filtered := (List.mem_filter.mp h).1\\n  simpa using filtered\\n\\ntheorem zero_budget_is_empty (n : Nat) (a r : List Nat) : select n 0 a r = [] := rfl\\n\\ndef windowsFrom : Nat → List Char → List String\\n  | 0, _ => []\\n  | count + 1, characters => String.ofList (characters.take 512) :: windowsFrom count (characters.drop 384)\\n\\ntheorem windowsFrom_exact (count : Nat) (characters : List Char) :\\n    windowsFrom count characters = (List.range count).map (fun index =>\\n      String.ofList ((characters.drop (index * 384)).take 512)) := by\\n  induction count generalizing characters with\\n  | zero => rfl\\n  | succ count ih =>\\n      simp only [windowsFrom, List.range_succ_eq_map, List.map_cons, Nat.zero_mul,\\n        List.drop_zero, List.map_map, ih]\\n      apply congrArg (List.cons (String.ofList (characters.take 512)))\\n      apply List.map_congr_left\\n      intro index _\\n      dsimp only [Function.comp_def]\\n      rw [List.drop_drop]\\n      have offset : 384 + index * 384 = index.succ * 384 := by omega\\n      rw [offset]\\n\\ndef windows (text : String) : List String :=\\n  let characters := text.toList\\n  windowsFrom ((max 1 characters.length + 383) / 384) characters\\n\\n/-- Byte offsets advance with the consumed prefix, rather than rescanning\\nthe original text. The projection is the very same window sequence. -/\\ndef locatedWindowsFrom : Nat → Nat → List Char → List (Nat × String)\\n  | 0, _, _ => []\\n  | count + 1, offset, characters =>\\n      (offset, String.ofList (characters.take 512)) ::\\n        locatedWindowsFrom count\\n          (offset + (String.ofList (characters.take 384)).utf8ByteSize)\\n          (characters.drop 384)\\n\\ntheorem locatedWindowsFrom_exact (count offset : Nat) (characters : List Char) :\\n    (locatedWindowsFrom count offset characters).map Prod.snd = windowsFrom count characters := by\\n  induction count generalizing offset characters with\\n  | zero => rfl\\n  | succ count ih => simp only [locatedWindowsFrom, List.map_cons, windowsFrom, ih]\\n\\ndef locatedWindows (text : String) : List (Nat × String) :=\\n  locatedWindowsFrom ((max 1 text.toList.length + 383) / 384) 0 text.toList\\n\\ntheorem locatedWindows_exact (text : String) :\\n    (locatedWindows text).map Prod.snd = windows text :=\\n  locatedWindowsFrom_exact _ _ _\\n\\ntheorem windows_exact (text : String) :\\n    windows text = (List.range ((max 1 text.toList.length + 383) / 384)).map (fun index =>\\n      String.ofList ((text.toList.drop (index * 384)).take 512)) :=\\n  windowsFrom_exact _ _\\n\\nend Eggshell.SearchRank\\n\",[]]"],["Eggshell.SearchUnicode","[\"module\\n\\npublic import Std\\n\\n@[expose] public se
bounded : bytes ≤ 4096\\n\\n/-- The native adapter accepts at most one page. Larger objects must use the\\nsame descriptor in bounded steps; a caller cannot silently exceed this API. -/\\nopaque readPage (handle : ReadHandle) (offset : UInt64) (count : ReadSize) : IO ByteArray :=\\n  readPageRaw handle offset count.bytes.toUSize\\n\\ntheorem ReadSize.native_bound (count : ReadSize) : count.bytes ≤ 4096 := count.bounded\\n\\n/-- An unbuffered, regular-file descriptor for the exclusively owned writer.\\nThe OS adapter checks the expected EOF before writing at explicit offsets.\\nAn IO failure cannot leave a stdio buffer to flush after ownership ends. -/\\nopaque AppendHandle : Type\\n@[extern \\\"eggshell_append_open\\\"] opaque openAppend (path : @& String) : IO AppendHandle\\n@[extern \\\"eggshell_append_write\\\"] opaque appendAt (handle : @& AppendHandle)\\n    (offset : UInt64) (bytes : @& ByteArray) : IO Unit\\n@[extern \\\"eggshell_append_sync\\\"] opaque syncAppend (handle : @& AppendHandle) : IO Unit\\n@[extern \\\"eggshell_append_close\\\"] opaque closeAppend (handle : @& AppendHandle) : IO Unit\\n\\n/-- Non-waiting advisory reader-cohort guards on securely opened files.\\nThe OS releases these locks on descriptor close, including process death. -/\\n@[extern \\\"eggshell_read_try_lock\\\"] opaque tryReadLock (handle : @& ReadHandle)\\n    (exclusive : Bool) : IO Bool\\n@[extern \\\"eggshell_read_unlock\\\"] opaque unlockRead (handle : @& ReadHandle) : IO Unit\\n\\n/-- Atomic no-replacement rename of a completed DB directory. Parent\\nresolution and fsync use held descriptors at the native boundary. -/\\n@[extern \\\"eggshell_publish_directory\\\"] opaque publishDirectory\\n    (source target : @& String) : IO Unit\\n\\nstructure PruneSize where\\n  entries : Nat\\n  bounded : 0 < entries ∧ entries ≤ 128\\n\\n@[extern \\\"eggshell_prune_directory\\\"] private opaque pruneDirectoryRaw\\n    (path : @& String) (entries : USize) : IO Bool\\n\\n/-- One bounded, descriptor-relative step over an already retired derived\\ndirectory. Leaf symlinks are unlinked; directory links are never followed. -/\\nopaque pruneDirectory (path : String) (count : PruneSize) : IO Bool :=\\n  pruneDirectoryRaw path count.entries.toUSize\\n\\n/-- Shrink to the caller's committed boundary iff the descriptor still has the\\nexpected EOF, then fsync. The caller must hold exclusive writer ownership. -/\\n@[extern \\\"eggshell_append_truncate\\\"] opaque truncateAppend (handle : @& AppendHandle)\\n    (expectedEnd retainedEnd : UInt64) : IO Unit\\n\\n/-- The complete bytes must come from the still-current file object. -/\\ndef stableRead (before after current : ReadVersion) (bytes : Nat) : Bool :=\\n  decide (before = after) && decide (after = current) && decide (bytes = current.bytes)\\n\\ntheorem stable_read_identity {before after current : ReadVersion} {bytes : Nat}\\n    (accepted : stableRead before after current bytes = true) :\\n    before = after ∧ after = current ∧ bytes = current.bytes := by\\n  simpa [stableRead, and_assoc] using accepted\\n\\ntheorem replaced_read_rejected {before after current : ReadVersion} (bytes : Nat)\\n    (replaced : after ≠ current) : stableRead before after current bytes = false := by\\n  simp [stableRead, replaced]\\n\\ntheorem mutated_read_rejected {before after current : ReadVersion} (bytes : Nat)\\n    (mutated : before ≠ after) : stableRead before after current bytes = false := by\\n  simp [stableRead, mutated]\\n\\n/-- Native filesystem primitive: Lean does not expose POSIX fsync. -/\\n@[extern \\\"eggshell_sync_path\\\"] opaque syncPath (path : @& String)\\n    (directory : Bool) : IO Unit\\n\\ndef directoryWithin : Nat → System.FilePath → IO Unit\\n  | 0, _ => throw (IO.userError \\\"directory ancestor traversal did not terminate\\\")\\n  | fuel + 1, path => do\\n    FileSystem.rejectSymlinkAncestors path\\n    let existed ← path.isDir\\n    if !existed then\\n      if let some parent := path.parent then\\n        if parent != path && !(← parent.isDir) then directoryWithin fuel parent\\n      FileSystem.privateDirectory path\\n      syncPath path.toString true\\n      if let some parent := path.parent then syncPath parent.toString true\\n\\ndef durableDirectory (path : System.FilePath) : IO Unit :=\\n  directoryWithin (path.toString.length + 1) path.normalize\\n\\n/-- The writers and streaming directory readers share one namespace for\\nobjects which have not reached their atomic publication point. -/\\ninductive PublicationKind where\\n  | replace\\n  | immutable\\n  deriving BEq, DecidableEq, Repr\\n\\ndef publicationTemporary (kind : PublicationKind) (suffix : String) : String :=\\n  (match kind with | .replace => \\\".egg-tmp-\\\" | .immutable => \\\".egg-object-\\\") ++ suffix\\n\\ndef isPublicationTemporary (name : String) : Bool :=\\n  name.startsWith \\\".egg-tmp-\\\" || name.startsWith \\\".egg-object-\\\"\\n\\ntheorem publication_temporary_recognized (kind : PublicationKind) (suffix : String) :\\n    isPublicationTemporary (publicationTemporary kind suffix) = true := by\\n  cases kind <;> simp [publicationTemporary, isPublicationTemporary]\\n\\nprivate opaque PublicationHandle : Type\\n@[extern \\\"eggshell_publication_open\\\"] private opaque openPublication\\n    (path temporary : @& String) : IO PublicationHandle\\n@[extern \\\"eggshell_publication_write\\\"] private opaque writePublication\\n    (handle : @& PublicationHandle) (bytes : @& ByteArray) : IO Unit\\n@[extern \\\"eggshell_publication_sync_data\\\"] private opaque syncPublicationData\\n    (handle : @& PublicationHandle) : IO Unit\\n@[extern \\\"eggshell_publication_install\\\"] private opaque installPublication\\n    (handle : @& PublicationHandle) (immutable : Bool) : IO Bool\\n@[extern \\\"eggshell_publication_target\\\"] private opaque readPublicationTarget\\n    (handle : @& PublicationHandle) : IO ReadHandle\\n@[extern \\\"eggshell_publication_sync_parent\\\"] private opaque syncPublicationParent\\n    (handle : @& PublicationHandle) : IO Unit\\n@[extern \\\"eggshell_publication_close\\\"] private opaque closePublication\\n    (handle : @& PublicationHandle) : IO Unit\\n\\n/-- One securely opened parent and one exclusively created temporary file.\\nThe indexed phases make the executed write/sync/install order mandatory. OS\\ndescriptor identity, fsync and namespace atomicity remain native premises. -/\\nprivate inductive PublicationPhase where\\n  | opened | written | synced | installed | durable\\n\\ninductive PublicationBoundary where\\n  | written | synced | installed | durable\\n  deriving BEq, DecidableEq, Repr\\n\\n/-- Agreement is about the same current file object and exact bytes, never\\nonly a name, hash or matching length. This is the immutable collision gate. -/\\ndef publicationAgreement (before after current : ReadVersion)\\n    (existing expected : ByteArray) : Bool :=\\n  stableRead before after current existing.size && decide (existing = expected)\\n\\ntheorem publication_agreement_exact {before after current : ReadVersion}\\n    {existing expected : ByteArray}\\n    (accepted : publicationAgreement before after current existing expected = true) :\\n    before = after ∧ after = current ∧ existing = expected ∧ expected.size = current.bytes := by\\n  have parts : stableRead before after current existing.size = true ∧ existing = expected := by\\n    simpa [publicationAgreement] using accepted\\n  obtain ⟨same, now, sized⟩ := stable_read_identity parts.1\\n  exact ⟨same, now, parts.2, parts.2 ▸ sized⟩\\n\\ntheorem publication_replacement_rejected {before after current : ReadVersion}\\n    (existing expected : ByteArray) (replaced : after ≠ current) :\\n    publicationAgreement before after current existing expected = false := by\\n  simp [publicationAgreement, replaced_read_rejected existing.size replaced]\\n\\nprivate structure Publication (path : System.FilePath) (bytes : ByteArray)\\n    (phase : PublicationPhase) where\\n  mk ::\\n  handle : PublicationHandle\\n\\nprivate def Publication.write (publication : Publication path bytes .opened) :\\n    IO (Publication path bytes .written) := do\\n  writePublication publication.handle bytes\\n  pure ⟨publication.handle⟩\\n\\nprivate def Publication.syncData (publication : Publication path bytes .written) :\\n    IO (Publication path bytes .synced) := do\\n  syncPublicationData publication.handle\\n  pure ⟨publication.handle⟩\\n\\nprivate def Publication.install (publication : Publication path bytes .synced)\\n    (kind : PublicationKind) : IO (Publication path bytes .installed × Bool) := do\\n  let created ← installPublication publication.handle (kind == .immutable)\\n  pure (⟨publication.handle⟩, created)\\n\\nprivate def Publication.syncParent (publication : Publication path bytes .installed) :\\n    IO (Publication path bytes .durable) := do\\n  syncPublicationParent publication.handle\\n  pure ⟨publication.handle⟩\\n\\nprivate def Publication.agree (publication : Publication path bytes .installed) : IO Unit := do\\n  let target ← readPublicationTarget publication.handle\\n  let before ← readVersion target\\n  unless before.bytes == bytes.size do\\n    throw (IO.userError \\\"immutable object collision or concurrent replacement\\\")\\n  let mut existing := ByteArray.empty\\n  while existing.size < bytes.size do\\n    let count := min 4096 (bytes.size - existing.size)\\n    let part ← readPage target existing.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    unless part.size == count do\\n      throw (IO.userError \\\"immutable object collision or concurrent replacement\\\")\\n    existing := existing ++ part\\n  let after ← readVersion target\\n  let current ← readVersion (← readPublicationTarget publication.handle)\\n  unless publicationAgreement before after current existing bytes do\\n    throw (IO.userError \\\"immutable object collision or concurrent replacement\\\")\\n\\nprivate def publishExistingBytes (kind : PublicationKind) (path : System.FilePath)\\n    (bytes : ByteArray) (observe : PublicationBoundary → IO Unit) : IO Unit := do\\n  let temporary := publicationTemporary kind s!\\\"{← IO.Process.getPID}-{← IO.monoNanosNow}\\\"\\n  let initial : Publication path bytes .opened := ⟨← openPublication path.toString temporary⟩\\n  try\\n    let written ← initial.write\\n    observe .written\\n    let synced ← written.syncData\\n    observe .synced\\n    let (installed, created) ← synced.install kind\\n    if kind == .immutable && !created then installed.agree\\n    observe .installed\\n    let _ ← installed.syncParent\\n    observe .durable\\n    pure ()\\n  finally closePublication initial.handle\\n\\nprivate def publishBytes (kind : PublicationKind) (path : System.FilePath)\\n    (bytes : ByteArray) (observe : PublicationBoundary → IO Unit) : IO Unit := do\\n  durableDirectory (path.parent.getD \\\".\\\")\\n  publishExistingBytes kind path bytes observe\\n\\n/-- Never recreate an owner which was removed during background work. -/\\nopaque atomicExistingBytesWith (path : System.FilePath) (bytes : ByteArray)\\n    (observe : PublicationBoundary → IO Unit) : IO Unit :=\\n  publishExistingBytes .replace path bytes observe\\n\\ndef atomicExistingBytes (path : System.FilePath) (bytes : ByteArray) : IO Unit :=\\n  atomicExistingBytesWith path bytes (fun _ => pure ())\\n\\nopaque immutableExistingBytes (path : System.FilePath) (bytes : ByteArray) : IO Unit :=\\n  publishExistingBytes .immutable path bytes (fun _ => pure ())\\n\\nopaque atomicBytesWith (path : System.FilePath) (bytes : ByteArray)\\n    (observe : PublicationBoundary → IO Unit) : IO Unit :=\\n  publishBytes .replace path bytes observe\\n\\ndef atomicBytes (path : System.FilePath) (bytes : ByteArray) : IO Unit :=\\n  atomicBytesWith path bytes (fun _ => pure ())\\n\\ndef boundedBytes (path : System.FilePath) (limit : Nat) : IO ByteArray := do\\n  let handle ← openRead path.toString\\n  let before ← readVersion handle\\n  if before.bytes > limit then throw (IO.userError \\\"storage object exceeds byte budget\\\")\\n  let mut bytes := ByteArray.empty\\n  while bytes.size < before.bytes do\\n    let count := min 4096 (before.bytes - bytes.size)\\n    let part ← readPage handle bytes.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    unless part.size == count do throw (IO.userError \\\"truncated storage object\\\")\\n    bytes := bytes ++ part\\n  unless (← readVersion handle) == before do throw (IO.userError \\\"storage object mutated during read\\\")\\n  pure bytes\\n\\ndef boundedRead (handle : ReadHandle) (limit : Nat) : IO ByteArray := do\\n  let before ← readVersion handle\\n  if before.bytes > limit then throw (IO.userError \\\"storage object exceeds byte budget\\\")\\n  let mut bytes := ByteArray.empty\\n  while bytes.size < before.bytes do\\n    let count := min 4096 (before.bytes - bytes.size)\\n    let part ← readPage handle bytes.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    unless part.size == count do throw (IO.userError \\\"truncated storage object\\\")\\n    bytes := bytes ++ part\\n  unless (← readVersion handle) == before do throw (IO.userError \\\"storage object mutated during read\\\")\\n  pure bytes\\n\\ntheorem bounded_read_original (path : System.FilePath) (limit : Nat) :\\n    boundedBytes path limit = (do boundedRead (← openRead path.toString) limit) := by\\n  rfl\\n\\n/-- Atomic create-if-absent: concurrent publishers can agree on existing bytes,\\nbut cannot overwrite them after a failed existence check. -/\\nopaque immutableBytesWith (path : System.FilePath) (bytes : ByteArray)\\n    (observe : PublicationBoundary → IO Unit) : IO Unit :=\\n  publishBytes .immutable path bytes observe\\n\\ndef immutableBytes (path : System.FilePath) (bytes : ByteArray) : IO Unit :=\\n  immutableBytesWith path bytes (fun _ => pure ())\\n\\nend Eggshell.FileSystem\\n\",[]]"],["Eggshell.Frequency","[\"module\\n\\npublic import Std.Data.HashMap.Lemmas\\n\\n@[expose] public section\\nnamespace Eggshell.Frequency\\n\\n/-- The reference counts every occurrence in an already deduplicated document\\nrow. Empty rows represent owners that do not compile to searchable text. -/\\ndef count (rows : List (List String)) (unit : String) : Nat :=\\n  (rows.map (List.count unit)).sum\\n\\n@[simp] theorem count_nil (unit : String) : count [] unit = 0 := rfl\\n\\n@[simp] theorem count_cons (row : List String) (rows : List (List String)) (unit : String) :\\n    count (row :: rows) unit = row.count unit + count rows unit := by\\n  simp [count]\\n\\ntheorem count_append (left right : List (List String)) (unit : String) :\\n    count (left ++ right) unit = count left unit + count right unit := by\\n  simp [count, List.sum_append]\\n\\n/-- Full Nat-map computation retained as the search semantics oracle. -/\\ndef fullUnits (counts : Std.HashMap String Nat) (units : List String) : Std.HashMap String Nat :=\\n  units.foldl (fun counts unit => counts.insert unit (counts.getD unit 0 + 1)) counts\\n\\ndef full (rows : List (List String)) : Std.HashMap String Nat :=\\n  rows.foldl fullUnits {}\\n\\ntheorem fullUnits_exact (counts : Std.HashMap String Nat) (units : List String) (unit : String) :\\n    (fullUnits counts units).getD unit 0 = counts.getD unit 0 + units.count unit := by\\n  induction units generalizing counts with\\n  | nil => simp [fullUnits]\\n  | cons head tail ih =>\\n      simp only [fullUnits, List.foldl_cons]\\n      rw [← fullUnits, ih, Std.HashMap.getD_insert]\\n      by_cases same : head = unit\\n      · subst head; simp [Nat.add_assoc, Nat.add_comm]\\n      · simp [same, beq_iff_eq]\\n\\ntheorem full_rows_exact (rows : List (List String)) (counts : Std.HashMap String Nat)\\n    (unit : String) :\\n    (rows.foldl fullUnits counts).getD unit 0 = counts.getD unit 0 + count rows unit := by\\n  induction rows generalizing counts with\\n  | nil => simp\\n  | cons row rest ih =>\\n      simp only [List.foldl_cons]\\n      rw [ih, fullUnits_exact, count_cons]\\n      omega\\n\\ntheorem full_exact (rows : List (List String)) (unit : String) :\\n    (full rows).getD unit 0 = count rows unit := by\\n  simp [full, full_rows_exact]\\n\\n/-- Signed intermediate counts permit exact subtraction without silently\\nclamping an invalid intermediate state to zero. Final nonnegativity follows\\nfrom the certified current owner sequence. -/\\ndef change (counts : Std.HashMap String Int) (delta : Int) (unit : String) :\\n    Std.HashMap String Int :=\\n  let next := counts.getD unit 0 + delta\\n  if next = 0 then counts.erase unit else counts.insert unit next\\n\\ntheorem change_exact (counts : Std.HashMap String Int) (delta : Int) (key unit : String) :\\n    (change counts delta key).getD unit 0 =\\n      if key == unit then counts.getD unit 0 + delta else counts.getD unit 0 := by\\n  by_cases zero : counts.getD key 0 + delta = 0\\n  · have update : change counts delta key = counts.erase key := if_pos zero\\n    rw [update, Std.HashMap.getD_erase]\\n    by_cases same : key = unit\\n    · subst key; simp [zero]\\n    · simp [same]\\n  · have update : change counts delta key = counts.insert key (counts.getD key 0 + delta) :=\\n      if_neg zero\\n    rw [update, Std.HashMap.getD_insert]\\n    by_cases same : key = unit\\n    · subst key; simp\\n    · simp [same]\\n\\ndef NoZeros (counts : Std.HashMap String Int) : Prop :=\\n  ∀ (unit : String) (value : Int), counts[unit]? = some value → value ≠ 0\\n\\ntheorem change_no_zeros (counts : Std.HashMap String Int) (valid : NoZeros counts)\\n    (delta : Int) (key : String) : NoZeros (change counts delta key) := by\\n  intro unit value found\\n  dsimp [change] at found\\n  split at found <;> rename_i zero\\n  · rw [Std.HashMap.getElem?_erase] at found\\n    by_cases same : key = unit\\n    · subst key; simp at found\\n    · simp [same] at found\\n      exact valid unit value found\\n  · rw [Std.HashMap.getElem?_insert] at found\\n    by_cases same : key = unit\\n    · subst key; simp at found\\n      simpa [← found] using zero\\n    · simp [same] at found\\n      exact valid unit value found\\n\\ndef adjustUnits (counts : Std.HashMap String Int) (delta : Int) (units : List String) :\\n    Std.HashMap String Int := units.foldl (fun counts unit => change counts delta unit) counts\\n\\ndef adjust (counts : Std.HashMap String Int) (delta : Int) (rows : List (List String)) :\\n    Std.HashMap String Int := rows.foldl (fun counts row => adjustUnits counts delta row) counts\\n\\ntheorem adjustUnits_exact (counts : Std.HashMap String Int) (delta : Int)\\n    (units : List String) (unit : String) :\\n    (adjustUnits counts delta units).getD unit 0 =\\n      counts.getD unit 0 + delta * (units.count unit : Int) := by\\n  induction units generalizing counts with\\n  | nil => simp [adjustUnits]\\n  | cons head tail ih =>\\n      simp only [adjustUnits, List.foldl_cons]\\n      rw [← adjustUnits, ih, change_exact]\\n      by_cases same : head = unit\\n      · subst head\\n        simp [Int.mul_add, Int.add_assoc, Int.add_comm, Int.add_left_comm]\\n      · simp [same, beq_iff_eq]\\n\\ntheorem adjust_exact (counts : Std.HashMap String Int) (delta : Int)\\n    (rows : List (List String)) (unit : String) :\\n    (adjust counts delta rows).getD unit 0 =\\n      counts.getD unit 0 + delta * (count rows unit : Int) := by\\n  induction rows generalizing counts with\\n  | nil => simp [adjust]\\n  | cons row rest ih =>\\n      simp only [adjust, List.foldl_cons]\\n      rw [← adjust, ih, adjustUnits_exact, count_cons]\\n      simp [Int.mul_add, Int.add_assoc]\\n\\ntheorem adjustUnits_no_zeros (counts : Std.HashMap String Int) (valid : NoZeros counts)\\n    (delta : Int) (units : List String) : NoZeros (adjustUnits counts delta units) := by\\n  induction units generalizing counts with\\n  | nil => exact valid\\n  | cons head tail ih =>\\n      exact ih _ (change_no_zeros counts valid delta head)\\n\\ntheorem adjust_no_zeros (counts : Std.HashMap String Int) (valid : NoZeros counts)\\n    (delta : Int) (rows : List (List String)) : NoZeros (adjust counts delta rows) := by\\n  induction rows generalizing counts with\\n  | nil => exact valid\\n  | cons head tail ih =>\\n      exact ih _ (adjustUnits_no_zeros counts valid delta head)\\n\\nstructure Index (rows : List (List String)) where\\n  counts : Std.HashMap String Int\\n  exact : ∀ unit, counts.getD unit 0 = (count rows unit : Int)\\n  noZeros : NoZeros counts\\n\\ndef Index.empty : Index [] := ⟨{}, by intro unit; simp, by intro unit value found; simp at found⟩\\n\\n/-- A frequency update requires an exact multiset difference, rather than\\ndepending on a hash-table traversal order or a monotone-only insertion API. -/\\ndef Index.replace {before : List (List String)} (previous : Index before)\\n    (after removed added : List (List String))\\n    (difference : ∀ unit, count before unit + count added unit =\\n      count after unit + count removed unit) : Index after where\\n  counts := adjust (adjust previous.counts (-1) removed) 1 added\\n  exact := by\\n    intro unit\\n    rw [adjust_exact, adjust_exact, previous.exact]\\n    have equation := difference unit\\n    simp\\n    omega\\n  noZeros := adjust_no_zeros _ (adjust_no_zeros _ previous.noZeros _ _) _ _\\n\\nstructure CommonPrefix (before after : List α) where\\n  retained : List α\\n  removed : List α\\n  added : List α\\n  old : before = retained ++ removed\\n  current : after = retained ++ added\\n\\ndef commonPrefix [DecidableEq α] : (before after : List α) → CommonPrefix before after\\n  | [], after => ⟨[], [], after, rfl, rfl⟩\\n  | head :: tail, [] => ⟨[], head :: tail, [], rfl, rfl⟩\\n  | head :: tail, next :: rest =>\\n      if same : head = next then\\n        let continued := commonPrefix tail rest\\n        ⟨head :: continued.retained, continued.removed, continued.added,\\n          congrArg (List.cons head) continued.old,\\n          by simpa only [same, List.cons_append] using congrArg (List.cons head) continued.current⟩\\n      else ⟨[], head :: tail, next :: rest, rfl, rfl⟩\\ntermination_by before _ => before.length\\n\\n/-- Unchanged prefix and suffix never have their terms rescanned. The affected\\nmiddle may be larger than the minimal edit set, but retains exact semantics for\\narbitrary reorderings, duplicates, insertions, removals and corrections. -/\\nstructure Region (before after : List α) where\\n  left : List α\\n  removed : List α\\n  added : List α\\n  right : List α\\n  old : before = left ++ removed ++ right\\n  current : after = left ++ added ++ right\\n\\ndef affectedRegion [DecidableEq α] (before after : List α) : Region before after :=\\n  let start := commonPrefix before after\\n  let ending := commonPrefix start.removed.reverse start.added.reverse\\n  { left := start.retained\\n    removed := ending.removed.reverse\\n    added := ending.added.reverse\\n    right := ending.retained.reverse\\n    old := by\\n      have rest := congrArg List.reverse ending.old\\n      simp only [List.reverse_reverse, List.reverse_append] at rest\\n      exact start.old.trans ((congrArg (start.retained ++ ·) rest).trans\\n        (List.append_assoc _ _ _).symm)\\n    current := by\\n      have rest := congrArg List.reverse ending.current\\n      simp only [List.reverse_reverse, List.reverse_append] at rest\\n      exact start.current.trans ((congrArg (start.retained ++ ·) rest).trans\\n        (List.append_assoc _ _ _).symm) }\\n\\n/-- Reuse a certified prefix, subtract the old suffix and add the new suffix.\\nNo prefix terms are traversed. This also handles duplicate owners and arbitrary\\nreordering; reordering can repair a larger suffix, but never changes semantics. -/\\ndef Index.revise {before : List (List String)} (previous : Index before)\\n    (retained removed added : List (List String)) (same : before = retained ++ removed) :\\n    Index (retained ++ added) :=\\n  { counts := adjust (adjust previous.counts (-1) removed) 1 added\\n    exact := by\\n      intro unit\\n      rw [adjust_exact, adjust_exact, previous.exact, same, count_append, count_append]\\n      simp\\n      omega\\n    noZeros := adjust_no_zeros _ (adjust_no_zeros _ previous.noZeros _ _) _ _ }\\n\\ntheorem Index.read_exact (rows : List (List String)) (index : Index rows) (unit : String) :\\n    (index.counts.getD unit 0).toNat = (full rows).getD unit 0 := by\\n  rw [index.exact, full_exact]; simp\\n\\nend Eggshell.Frequency\\n\",[]]"],["Eggshell.GeometryMemo","[\"module\\n\\npublic import Eggshell.RankMemo\\npublic import Eggshell.SelectionReplay\\n\\n@[expose] public section\\nnamespace Eggshell.Matcher.GeometryMemo\\nopen LogicalText\\n\\n/-- Complete inputs to coverage ranking. A changed document count, relevant\\nterm frequency, original span, or normalized spelling changes this key.\\nUnion representatives and unrelated owner text are not coverage inputs. -/\\nstructure Input where\\n  past : LogicalText.T\\n  current : LogicalText.T\\n  pastWeights : List Nat\\n  currentWeights : List Nat\\n  novelty : Nat\\n  pastLocator : UInt64 := hash past\\n  currentLocator : UInt64 := hash current\\n  deriving DecidableEq, BEq\\n\\n/-- The expensive immutable logical text is hashed at compilation, once.\\nThese small addresses only locate candidates; equality below still checks\\nall original bytes, spans, weights and count before semantic reuse. -/\\nabbrev Locator := UInt64 × UInt64 × UInt64 × UInt64 × Nat\\n\\ndef Input.locator (input : Input) : Locator :=\\n  (input.pastLocator, input.currentLocator, hash input.pastWeights,\\n    hash input.currentWeights, input.novelty)\\n\\ndef reference (input : Input) : List (Coverage × Coverage) :=\\n  pairedCoverages (makePattern input.past) (makePattern input.current)\\n    input.pastWeights input.currentWeights input.novelty\\n\\nstructure Entry where\\n  input : Input\\n  result : List (Coverage × Coverage)\\n  exact : result = reference input\\n\\nabbrev Cache := Std.HashMap Locator Entry\\n\\nstructure Result (input : Input) where\\n  result : List (Coverage × Coverage)\\n  reused : Bool\\n  exact : result = reference input\\n\\n/-- A hash only selects a bucket. Full input equality is checked again before\\ntransporting the stored proof. Empty alignments are reusable too. -/\\ndef lookup (cache : Cache) (input : Input) : Option (Result input) := do\\n  let entry ← cache[input.locator]?\\n  if same : entry.input = input then\\n    pure ⟨entry.result, true, same ▸ entry.exact⟩\\n  else none\\n\\ndef get (cache : Cache) (input : Input) : Result input :=\\n  match lookup cache input with\\n  | some found => found\\n  | none => ⟨reference input, false, rfl⟩\\n\\ndef provider (cache : Cache) : CoverageProvider := fun past current pw cw novelty =>\\n  (get cache ⟨past.logical, current.logical, pw, cw, novelty, past.locator, current.locator⟩).result\\n\\ntheorem provider_exact (cache : Cache) : provider cache = pairedCoverages := by\\n  funext past current pw cw novelty\\n  change (get cache _).result = _\\n  rw [(get cache _).exact]\\n  simp only [reference, ← Pattern.canonical past, ← Pattern.canonical current]\\n\\nstructure Prepared where\\n  cache : Cache\\n  reused : Nat\\n  computed : Nat\\n\\n/-- Retain only the demanded keys. An old result with changed ranking inputs\\nis recomputed; unused past demands are never refreshed. -/\\ndef prepareUsing (previous : Cache) (ranks : RankMemo.Cache) : List Input → Prepared\\n  | [] => ⟨{}, 0, 0⟩\\n  | input :: rest =>\\n      let found : Result input := match lookup previous input with\\n        | some found => found\\n        | none =>\\n            let result := pairedCoveragesUsing (RankMemo.provider ranks)\\n              (makePattern input.past) (makePattern input.current)\\n              input.pastWeights input.currentWeights input.novelty\\n            ⟨result, false, by\\n              change pairedCoveragesUsing (RankMemo.provider ranks) _ _ _ _ _ = _\\n              rw [RankMemo.provider_exact]; rfl⟩\\n      let tail := prepareUsing previous ranks rest\\n      ⟨tail.cache.insert input.locator ⟨input, found.result, found.exact⟩,\\n        tail.reused + if found.reused then 1 else 0,\\n        tail.computed + if found.reused then 0 else 1⟩\\n\\ndef prepare (previous : Cache) := prepareUsing previous {}\\n\\nstructure Persistent where\\n  prepared : Prepared\\n  saved : RankMemo.Saved := []\\n  charged : Nat := 0\\n  bounded : charged ≤ RankMemo.allowance := by decide\\n  replayed : Nat := 0\\n  repaired : Nat := 0\\n\\ndef Persistent.retain (state : Persistent) (key : String) (positions : List Nat)\\n    (reused : Bool) : Persistent :=\\n  let state := {state with\\n    replayed := state.replayed + if reused then 1 else 0\\n    repaired := state.repaired + if reused then 0 else 1}\\n  if state.saved.any (·.1 == key) then state else\\n  let cost := RankMemo.codec.encodedSize [(key, positions)]\\n  if fits : state.charged + cost ≤ RankMemo.allowance then\\n    {state with\\n      saved := (key, positions) :: state.saved\\n      charged := state.charged + cost\\n      bounded := fits}\\n  else state\\n\\n/-- Selection traces are checked against every current ranked candidate.\\nChanged frequency may leave the same trace valid, while scores are always\\nreconstructed from current weights and population. No serialized Coverage\\nor evidence payload becomes authoritative. -/\\ndef obtainCoverage (reader : Option (RankMemo.Reader .selection)) (state : Persistent)\\n    (query target : Pattern) (weights : List Nat) (novelty : Nat) (ranked : List Evidence) :\\n    IO ({ cover : Option Coverage // cover = workCoverage query weights novelty ranked } × Persistent) := do\\n  let key := RankMemo.binding query target\\n  let eligible := reader.isSome && 32 ≤ ranked.length && ranked.length ≤ RankMemo.frontierAllowance\\n  let saved ← if eligible then\\n      match reader with\\n      | some reader => pure ((← reader.get key).head?.map (·.2))\\n      | none => pure none\\n    else pure none\\n  let found := SelectionReplay.obtain ranked saved\\n  let cover : { cover : Option Coverage // cover = workCoverage query weights novelty ranked } :=\\n    ⟨coverageOf query weights novelty found.1.val, by rw [found.1.property]; rfl⟩\\n  let state := if eligible then state.retain key found.2.1 found.2.2 else state\\n  return (cover, state)\\n\\ndef obtainPair (reader : Option (RankMemo.Reader .selection)) (state : Persistent)\\n    (ranks : RankMemo.Cache) (input : Input) : IO (Result input × Persistent) := do\\n  let past := makePattern input.past\\n  let current := makePattern input.current\\n  if empty : LogicalText.isEmpty input.past || LogicalText.isEmpty input.current ||\\n      input.pastWeights.length != input.past.units.length ||\\n      input.currentWeights.length != input.current.units.length then\\n    return (⟨[], false, by\\n      simp only [reference, pairedCoverages, pairedCoveragesUsing,\\n        show (makePattern input.past).logical = input.past from rfl,\\n        show (makePattern input.current).logical = input.current from rfl, empty, ↓reduceIte]⟩, state)\\n  else\\n    if same : sameLogicalUnits past current then\\n      return (⟨[(completeCoverage past input.pastWeights input.novelty,\\n        completeCoverage current input.currentWeights input.novelty)], false, by\\n          change _ = pairedCoveragesUsing referenceRank past current input.pastWeights input.currentWeights input.novelty\\n          simp only [pairedCoveragesUsing,\\n            show past.logical = input.past from rfl,\\n            show current.logical = input.current from rfl,\\n            empty, same, Bool.false_eq_true, ↓reduceIte]⟩, state)\\n    else\\n      let forward := RankMemo.provider ranks input.pastWeights past current\\n      let reverse := RankMemo.provider ranks input.currentWeights current past\\n      let (first, state) ← obtainCoverage reader state past current input.pastWeights input.novelty forward\\n      let (second, state) ← obtainCoverage reader state current past input.currentWeights input.novelty reverse\\n      let result := match first.val, second.val with\\n        | some forward, some reverse => [(forward, reverse)]\\n        | _, _ => []\\n      return (⟨result, false, by\\n        have forwardExact : forward = referenceRank input.pastWeights past current := by\\n          simp only [forward, RankMemo.provider_exact]\\n        have reverseExact : reverse = referenceRank input.currentWeights current past := by\\n          simp only [reverse, RankMemo.provider_exact]\\n        calc result = (match workCoverage past input.pastWeights input.novelty forward,\\n            workCoverage current input.currentWeights input.novelty reverse with\\n            | some a, some b => [(a, b)] | _, _ => []) := by\\n              dsimp only [result]; rw [first.property, second.property]; rfl\\n          _ = reference input := by\\n            rw [forwardExact, reverseExact]\\n            change _ = pairedCoveragesUsing referenceRank past current input.pastWeights input.currentWeights input.novelty\\n            simp only [pairedCoveragesUsing,\\n              show past.logical = input.past from rfl,\\n              show current.logical = input.current from rfl,\\n              empty, same, Bool.false_eq_true, ↓reduceIte]\\n            cases workCoverage past input.pastWeights input.novelty (referenceRank input.pastWeights past current) <;>\\n              cases workCoverage current input.currentWeights input.novelty (referenceRank input.currentWeights current past) <;> rfl⟩, state)\\n\\n/-- Only active demands repair traces. Entry carries the whole canonical\\ncoverage equality into the actual existing matcher API. -/\\ndef prepareUsingM (previous : Cache) (ranks : RankMemo.Cache)\\n    (reader : Option (RankMemo.Reader .selection)) (initial : Persistent) (inputs : List Input) :\\n    IO Persistent := do\\n  let mut state := {initial with prepared := ⟨{}, 0, 0⟩}\\n  for input in inputs.reverse do\\n    let (found, updated) ← match lookup previous input with\\n      | some found => pure (found, state)\\n      | none => obtainPair reader state ranks input\\n    state := updated\\n    let prepared := state.prepared\\n    state := {state with prepared :=\\n      ⟨prepared.cache.insert input.locator ⟨input, found.result, found.exact⟩,\\n       prepared.reused + if found.reused then 1 else 0,\\n       prepared.computed + if found.reused then 0 else 1⟩}\\n  return state\\n\\n/-- Current complete ranking dependencies nominate the only persisted orders\\nto validate. Equal logical units and empty inputs use the cheap direct path. -/\\ndef addRanks (coverage : Cache) (previous : RankMemo.Saved)\\n    (input : Input) (prepared : RankMemo.Prepared) : RankMemo.Prepared :=\\n  let needsJoin := !LogicalText.isEmpty input.past && !LogicalText.isEmpty input.current &&\\n    input.pastWeights.length == input.past.units.length &&\\n    input.currentWeights.length == input.current.units.length &&\\n    input.past.units.map (·.text) != input.current.units.map (·.text)\\n  if (lookup coverage input).isSome || !needsJoin then prepared else\\n    let past := makePattern input.past\\n    let current := makePattern input.current\\n    (prepared.add previous input.pastWeights past current).add previous\\n      input.currentWeights current past\\n\\n/-- A discovery pass adds only its current demands to the same bounded rank\\nfrontier. It does not refresh other persisted queries or publish per pass. -/\\ndef prepareRanksFrom (prepared : RankMemo.Prepared) (coverage : Cache)\\n    (previous : RankMemo.Saved) (inputs : List Input) : RankMemo.Prepared :=\\n  inputs.foldr (addRanks coverage previous) prepared\\n\\ndef prepareRanks (coverage : Cache) (previous : RankMemo.Saved) (inputs : List Input) :\\n    RankMemo.Prepared := prepareRanksFrom {} coverage previous inputs\\n\\n/-- The real indexed controller loads only the orders required by the current\\npass. Persisted bytes supply advice, never Entry proofs: `addRanks` constructs\\neach exact current-domain certificate, even after a collision or corruption.\\nThe reader retains positive and negative loads for this pinned request. -/\\ndef prepareRanksFromM (reader : Option RankMemo.Reader) (prepared : RankMemo.Prepared)\\n    (coverage : Cache) (previous : RankMemo.Saved) (inputs : List Input) :\\n    IO RankMemo.Prepared := do\\n  let some reader := reader | return prepareRanksFrom prepared coverage previous inputs\\n  let mut prepared := prepared\\n  for input in inputs.reverse do\\n    let needsJoin := !LogicalText.isEmpty input.past && !LogicalText.isEmpty input.current &&\\n      input.pastWeights.length == input.past.units.length &&\\n      input.currentWeights.length == input.current.units.length &&\\n      input.past.units.map (·.text) != input.current.units.map (·.text)\\n    if (lookup coverage input).isSome || !needsJoin then continue\\n    let past := makePattern input.past\\n    let current := makePattern input.current\\n    prepared ← prepared.addM reader input.pastWeights past current\\n    prepared ← prepared.addM reader input.currentWeights current past\\n  return prepared\\n\\n/-- Every IO outcome still inhabits the existing proof-carrying cache. This\\ncontract covers arbitrary advice, not a premise that persisted hints are good. -/\\ntheorem prepared_provider_exact (prepared : RankMemo.Prepared) :\\n    RankMemo.provider prepared.cache = referenceRank := RankMemo.provider_exact _\\n\\ntheorem prepareRanksFrom_bounded (prepared : RankMemo.Prepared) (coverage : Cache)\\n    (previous : RankMemo.Saved) (inputs : List Input) :\\n    (prepareRanksFrom prepared coverage previous inputs).charged ≤ RankMemo.allowance :=\\n  (prepareRanksFrom prepared coverage previous inputs).bounded\\n\\n/-- Only candidates admitted to the demanded Work enter the rank cache.\\nIncludes failed comparisons, so absence does not become a permanent miss. -/\\ndef inputsPrepared (corpus : Corpus) (current : String)\\n    (semantic : SemanticNominations) (native : Bool)\\n    (prepared : CompiledDemand normalize current native) : List Input :=\\n  let demand := Value.text current\\n  let query := prepared.pattern\\n  let queryPatterns := prepared.workPatterns\\n  (admittedCandidates query corpus semantic).flatMap fun candidate =>\\n    (candidate.intrinsicPairs Quotient.literal demand query queryPatterns).map fun pair =>\\n      ⟨pair.past.logical, pair.current.logical,\\n        corpus.informationWeights pair.past candidate.native,\\n        corpus.informationWeights pair.current native, corpus.population + 1,\\n        pair.past.locator, pair.current.locator⟩\\n\\n/-- Ranking inputs for the shallow Work lane, without an Outcome edge. -/\\ndef inputsWork (corpus : Corpus) (work : WorkView) (current : String) (native : Bool)\\n    (prepared : CompiledDemand normalize current native) : List Input :=\\n  if !sharesSurface prepared.pattern work.pattern then [] else\\n    (work.intrinsicPairs Quotient.literal (.text current) prepared.pattern prepared.workPatterns).map fun pair =>\\n      ⟨pair.past.logical, pair.current.logical,\\n        corpus.informationWeights pair.past work.native,\\n        corpus.informationWeights pair.current native, corpus.population + 1,\\n        pair.past.locator, pair.current.locator⟩\\n\\ntheorem inputsWork_exact (corpus : Corpus) (candidate : Candidate) (current : String)\\n    (native : Bool) (prepared : CompiledDemand normalize current native) :\\n    inputsWork corpus candidate.workView current native prepared =\\n      inputsPrepared {corpus with candidates := [candidate]} current {} native prepared := by\\n  by_cases shared : sharesSurface prepared.pattern candidate.work\\n  <;> simp [inputsWork, inputsPrepared, admittedCandidates, nominated,\\n    SemanticNominations.contains, externallyNominated, Candidate.workView,\\n    Candidate.intrinsicPairs, shared, Corpus.informationWeights]\\n  intro pair _\\n  constructor <;> rfl\\n\\ndef inputs (normalize : Normalizer) (corpus : Corpus) (current : String)\\n    (semantic : SemanticNominations) (native : Bool) : List Input :=\\n  inputsPrepared corpus current semantic native (CompiledDemand.make normalize current native)\\n\\ntheorem changed_input_rejected (entry : Entry) (input : Input)\\n    (different : entry.input ≠ input) (cache : Cache) (found : cache[input.locator]? = some entry) :\\n    lookup cache input = none := by simp [lookup, found, different]\\n\\nnamespace Context\\n\\n/-- Geometry depends on complete normalized bytes/spans in both directions,\\nincluding missing units. Frequency and population are score dependencies. -/\\nstructure Input where\\n  query : LogicalText.T\\n  target : LogicalText.T\\n  queryLocator : UInt64\\n  targetLocator : UInt64\\n  deriving DecidableEq\\n\\ndef Input.locator (input : Input) : UInt64 × UInt64 :=\\n  (input.queryLocator, input.targetLocator)\\n\\ndef reference (input : Input) : ContextPlan.Instructions :=\\n  ContextPlan.generate input.query.units\\n    ((makePattern input.target).contextDirectory (makePattern input.query))\\n\\nstructure Entry where\\n  input : Input\\n  instructions : ContextPlan.Instructions\\n  exact : instructions = reference input\\n\\nabbrev Cache := Std.HashMap (UInt64 × UInt64) Entry\\n\\ndef lookup (cache : Cache) (input : Input) : Option { plan : ContextPlan.Instructions // plan = reference input } := do\\n  let entry ← cache[input.locator]?\\n  if same : entry.input = input then pure ⟨entry.instructions, same ▸ entry.exact⟩\\n  else none\\n\\ndef provider (cache : Cache) : ContextProvider := fun query target weights novelty =>\\n  let input : Input := ⟨query.logical, target.logical, query.locator, target.locator⟩\\n  match lookup cache input with\\n  | none => surfaceContextCover query target weights novelty\\n  | some plan => surfaceContextCoverPlan plan.val query target weights novelty\\n\\ntheorem provider_exact (cache : Cache) : provider cache = surfaceContextCover := by\\n  funext query target weights novelty\\n  simp on
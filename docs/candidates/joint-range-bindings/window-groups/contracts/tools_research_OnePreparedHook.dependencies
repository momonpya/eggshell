 let payload := Json.mkObj [(\\\"receipt\\\", toJson receipt), (\\\"publication\\\", publication),\\n      (\\\"ack\\\", if reply.isComplete then json.map (·.getObjValD \\\"ack\\\") |>.getD Json.null else Json.null)]\\n    let recorded ← try boundedRpc \\\"receipt\\\" payload deadline\\n      catch error => do\\n        IO.eprintln s!\\\"Eggshell publication receipt failed: {error}\\\"\\n        pure none\\n    unless recorded.bind (Json.parse · |>.toOption) |>.bind (optionalString · \\\"output\\\") |>.isSome do\\n      IO.eprintln s!\\\"Eggshell publication receipt was not confirmed: {receipt}\\\"\\n    pure 0\\n  catch error =>\\n    IO.eprintln s!\\\"Eggshell hook failed open: {error}\\\"\\n    IO.println (incompleteHook \\\"\\\")\\n    pure 0\\n\\ndef awaitStopped (endpoint : Endpoint) : IO Unit := do\\n  let deadline := (← IO.monoMsNow) + 3000\\n  repeat\\n    let status ← IO.Process.output {\\n      cmd := \\\"/bin/kill\\\", args := #[\\\"-0\\\", toString endpoint.pid]\\n      stdin := .null }\\n    if status.exitCode != 0 then return\\n    if (← IO.monoMsNow) ≥ deadline then\\n      throw (IO.userError \\\"eggshelld acknowledged shutdown but has not exited\\\")\\n    IO.sleep 5\\n\\ndef shutdown : IO Unit := do\\n  let root ← dataRoot\\n  let directory := root / \\\"sessions\\\"\\n  let paths ← if ← directory.pathExists then do\\n      (← directory.readDir).toList.mapM fun entry => pure (entry.path / \\\"daemon.json\\\")\\n    else pure []\\n  for path in root / \\\"daemon.json\\\" :: paths do\\n    if let some endpoint ← (readJson? path endpointJsonDefaults : IO (Option Endpoint)) then\\n      try\\n        let _ ← exchange endpoint \\\"shutdown\\\" (budget := 500)\\n      catch _ => pure ()\\n      -- Receipt of the RPC reply is not proof that its workers have exited.\\n      -- Do not report successful teardown until the manager really exits.\\n      awaitStopped endpoint\\n\\nend Eggshell.Plugin.Daemon\\n\",[]]"],["Eggshell.DaemonWire","[\"module\\n\\npublic import Eggshell.PluginModel\\npublic import Std.Async.TCP\\npublic import Std.Async.Timer\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin.Daemon\\n\\nopen Lean Std Async TCP\\n\\ndef maxFrameBytes : Nat := 8 * 1024 * 1024\\ndef startupAttempts : Nat := 80\\n\\nstructure Endpoint where\\n  session : String := \\\"\\\"\\n  pid : Nat := 0\\n  port : Nat\\n  secret : String\\n  /-- Identity of the daemon executable selected by the current Plugin bundle. -/\\n  generation : String\\n  deriving ToJson, FromJson\\n\\ndef endpointJsonDefaults : List (String × Json) :=\\n  [(\\\"session\\\", toJson \\\"\\\"), (\\\"pid\\\", toJson (0 : Nat))]\\n\\nnamespace Endpoint\\n\\ndef compatible (endpoint : Endpoint) (generation : String) : Bool :=\\n  endpoint.generation == generation\\n\\ntheorem incompatible_generation_rejected {endpoint : Endpoint} {generation : String}\\n    (different : endpoint.generation ≠ generation) :\\n    endpoint.compatible generation = false := by\\n  simp [compatible, different]\\n\\nend Endpoint\\n\\ndef endpointPath (session : String) : IO System.FilePath := do\\n  pure ((← sessionFiles session).directory / \\\"daemon.json\\\")\\n\\ndef startupLock (session : String) : IO System.FilePath := do\\n  pure ((← sessionFiles session).directory / \\\"daemon-start\\\")\\n\\ndef daemonExecutable : IO System.FilePath := do\\n  match ← IO.getEnv \\\"PLUGIN_ROOT\\\" with\\n  | some root =>\\n      let bundled := System.FilePath.mk root / \\\"bin\\\" / \\\"eggshelld\\\"\\n      if ← bundled.pathExists then pure bundled else IO.appPath\\n  | none => IO.appPath\\n\\n/--\\nThe endpoint is valid only for the executable selected by this Plugin bundle.\\nFile metadata is a private lifecycle generation, not semantic authority; it\\nkeeps a reinstalled Plugin from silently talking to an older resident daemon.\\n-/\\ndef executableGeneration (path : System.FilePath) : IO String := do\\n  let metadata ← path.metadata\\n  pure s!\\\"{metadata.byteSize}:{repr metadata.modified}\\\"\\n\\ndef desiredGeneration : IO String := do\\n  executableGeneration (← daemonExecutable)\\n\\ndef loopback (port : UInt16) : Net.SocketAddress :=\\n  .v4 ⟨.ofParts 127 0 0 1, port⟩\\n\\ndef frameLength (bytes : ByteArray) : ByteArray :=\\n  let value := bytes.size.toUInt32\\n  .mk #[\\n    (value >>> 24).toUInt8,\\n    (value >>> 16).toUInt8,\\n    (value >>> 8).toUInt8,\\n    value.toUInt8]\\n\\ndef decodeLength (bytes : ByteArray) : Nat :=\\n  ((bytes.get! 0).toNat <<< 24) |||\\n    ((bytes.get! 1).toNat <<< 16) |||\\n    ((bytes.get! 2).toNat <<< 8) ||| (bytes.get! 3).toNat\\n\\npartial def receiveExactly (client : Socket.Client) (remaining : Nat)\\n    (deadline : Nat) (received : ByteArray := ByteArray.empty) : IO ByteArray := do\\n  if remaining = 0 then return received\\n  let now ← IO.monoMsNow\\n  if now ≥ deadline then throw (IO.userError \\\"daemon receive deadline expired\\\")\\n  let chunk ← (do\\n    let timer ← Selector.sleep (.ofNat (deadline - now))\\n    Selectable.one #[\\n      .case (client.recvSelector remaining.toUInt64) pure,\\n      .case timer (fun _ => throw (IO.userError \\\"daemon receive deadline expired\\\"))]).block\\n  let some chunk := chunk |\\n    throw (IO.userError \\\"eggshelld closed an incomplete frame\\\")\\n  if chunk.isEmpty then\\n    throw (IO.userError \\\"eggshelld returned an empty frame\\\")\\n  receiveExactly client (remaining - chunk.size) deadline (received.append chunk)\\n\\ndef receiveFrameBefore (client : Socket.Client) (deadline : Nat) : IO ByteArray := do\\n  let header ← receiveExactly client 4 deadline\\n  let length := decodeLength header\\n  if length > maxFrameBytes then\\n    throw (IO.userError \\\"eggshelld frame exceeds the transport bound\\\")\\n  receiveExactly client length deadline\\n\\ndef receiveFrame (client : Socket.Client) (budget : Nat := 24000) : IO ByteArray := do\\n  receiveFrameBefore client ((← IO.monoMsNow) + budget)\\n\\ndef sendFrame (client : Socket.Client) (payload : ByteArray) : IO Unit := do\\n  if payload.size > maxFrameBytes then\\n    throw (IO.userError \\\"eggshelld frame exceeds the transport bound\\\")\\n  (client.sendAll #[frameLength payload, payload]).block\\n\\ndef response (output : Except String String) : Json :=\\n  match output with\\n  | .ok value => Json.mkObj [(\\\"ok\\\", true), (\\\"output\\\", value)]\\n  | .error message => Json.mkObj [(\\\"ok\\\", false), (\\\"error\\\", message)]\\n\\ndef request (secret kind : String) (payload : Json := Json.null) : Json :=\\n  Json.mkObj [(\\\"secret\\\", secret), (\\\"kind\\\", kind), (\\\"payload\\\", payload)]\\n\\ndef connect (endpoint : Endpoint) : IO Socket.Client := do\\n  if endpoint.port > 65535 then\\n    throw (IO.userError \\\"invalid eggshelld port\\\")\\n  let client ← Socket.Client.mk\\n  (client.connect (loopback endpoint.port.toUInt16)).block\\n  pure client\\n\\ndef exchangeBefore (endpoint : Endpoint) (kind : String)\\n    (payload : Json) (deadline : Nat) : IO String := do\\n  let client ← connect endpoint\\n  sendFrame client (request endpoint.secret kind payload |>.compress |>.toUTF8)\\n  let bytes ← receiveFrameBefore client deadline\\n  let text ← match String.fromUTF8? bytes with\\n    | some text => pure text\\n    | none => throw (IO.userError \\\"daemon response is not UTF-8\\\")\\n  let json ← match Json.parse text with\\n    | .ok json => pure json\\n    | .error message => throw (IO.userError message)\\n  if json.getObjValD \\\"ok\\\" == true then\\n    pure ((json.getObjValAs? String \\\"output\\\").toOption.getD \\\"\\\")\\n  else throw (IO.userError ((json.getObjValAs? String \\\"error\\\").toOption.getD \\\"daemon failure\\\"))\\n\\ndef exchange (endpoint : Endpoint) (kind : String)\\n    (payload : Json := Json.null) (budget : Nat := 24000) : IO String := do\\n  exchangeBefore endpoint kind payload ((← IO.monoMsNow) + budget)\\n\\nend Eggshell.Plugin.Daemon\\n\",[]]"],["Eggshell.Deadline","[\"module\\n\\npublic import Lean\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Deadline\\n\\ndef minimumDeliveryMs : Nat := 250\\n\\n/-- Verification shares the existing absolute deadline. Reserve at least half\\nof the remaining interval and, when available, a small publication floor.\\nWhen only that floor remains, do not start another verification probe. -/\\ndef verification (now deadline : Nat) : Nat :=\\n  min deadline (now + min ((deadline-now)/2) (deadline-now-minimumDeliveryMs))\\n\\ntheorem never_extends (now deadline : Nat) : verification now deadline ≤ deadline :=\\n  Nat.min_le_left _ _\\n\\ntheorem reserves_delivery (now deadline : Nat) (live : now ≤ deadline) :\\n    (deadline-now)/2 ≤ deadline-verification now deadline := by\\n  simp only [verification]\\n  omega\\n\\ntheorem reserves_minimum (now deadline : Nat) (live : now ≤ deadline) :\\n    min minimumDeliveryMs (deadline-now) ≤ deadline-verification now deadline := by\\n  simp only [verification,minimumDeliveryMs]\\n  omega\\n\\ntheorem expired_stays_expired (now deadline : Nat) (expired : deadline ≤ now) :\\n    verification now deadline = deadline := by\\n  simp only [verification]\\n  omega\\n\\nend Eggshell.Deadline\\n\",[]]"],["Eggshell.DemandMemo","[\"module\\n\\npublic import Eggshell.GraphStore\\n\\n@[expose] public section\\nnamespace Eggshell.Plugin.DemandMemo\\nopen Lean Persistence DB\\n\\n/-- Physical snapshot capabilities also cover negative membership, population,\\nfrequencies, root order, topology and source authority. A digest nominates a\\ncache slot; complete request bytes and every source capability decide reuse. -/\\nabbrev Source := String × Option PageMap.Head\\n\\nstructure Record where\\n  request : String\\n  sources : List Source\\n  response : String\\n  /-- Captured by the production snapshot reader, never inferred from hits. -/\\n  reads : Option (List (List PageMap.ReadObservation)) := none\\n  /-- `none` means that no external nomination was used. `some []` is an\\n  actual, completed negative observation and must not be confused with it. -/\\n  nominations : Option (List Nat) := none\\n  deriving BEq, DecidableEq\\n\\ndef sourceCodec : Wire.Codec Source := Wire.text.product (Wire.optional PageMap.headCodec)\\ndef codec : Wire.Codec Record :=\\n  (Wire.text.product ((Wire.list sourceCodec).product (Wire.text.product\\n    ((Wire.optional (Wire.list (Wire.list PageMap.readObservationCodec))).product\\n      (Wire.optional (Wire.list Wire.natural)))))).iso\\n    (fun r => (r.request, r.sources, r.response, r.reads, r.nominations))\\n    (fun (request, sources, response, reads, nominations) =>\\n      ⟨request, sources, response, reads, nominations⟩)\\n    (by intro r; cases r; rfl)\\n\\ntheorem codec_roundtrip (record : Record) (tail : List UInt8) :\\n    codec.decode (codec.encode record ++ tail) = .ok (record, tail) := codec.roundtrip record tail\\n\\ndef allowance : Nat := 65536\\ndef slots : Nat := 8\\ndef chainAllowance : Nat := 32\\ndef publicationAllowance : Nat := 16384\\ndef row (request : String) : String := \\\"memo:handoff:\\\" ++ toString (hash request % slots)\\n\\ndef requestMatches (record : Record) (request : String) : Bool := record.request == request\\n\\ntheorem changed_request_rejected (record : Record) (request : String)\\n    (different : record.request ≠ request) : requestMatches record request = false := by\\n  simp [requestMatches, different]\\n\\n/-- A slot hash never establishes request identity. -/\\ndef requestedRecord? (record : Record) (request : String) :\\n    Option { record : Record // record.request = request } :=\\n  if exact : requestMatches record request then\\n    some ⟨record, by simpa [requestMatches] using exact⟩ else none\\n\\ntheorem requested_record_rejects_another_request (record : Record) (request : String)\\n    (different : record.request ≠ request) : requestedRecord? record request = none := by\\n  simp [requestedRecord?, requestMatches, different]\\n\\n/-- Retain both the checked request and current external observation. -/\\nstructure ObservedRecord (request : String) (nominations : Option (List Nat)) where\\n  record : Record\\n  requestExact : record.request = request\\n  agrees : record.nominations = nominations\\n\\ndef observedRecord? (requested : { record : Record // record.request = request })\\n    (nominations : Option (List Nat)) : Option (ObservedRecord request nominations) :=\\n  if same : requested.val.nominations = nominations then\\n    some ⟨requested.val, requested.property, same⟩ else none\\n\\ntheorem changed_nominations_rejected\\n    (requested : { record : Record // record.request = request }) (nominations : Option (List Nat))\\n    (changed : requested.val.nominations ≠ nominations) :\\n    observedRecord? requested nominations = none := by\\n  simp [observedRecord?, changed]\\n\\ntheorem observed_record_has_current_request (checked : ObservedRecord request nominations) :\\n    checked.record.request = request := checked.requestExact\\n\\ntheorem observed_record_has_current_nominations (checked : ObservedRecord request nominations) :\\n    checked.record.nominations = nominations := checked.agrees\\n\\n/-- The publisher binds the actual computed payload to its request and\\nobservation. These proof fields erase; the stored Record codec is unchanged. -/\\nstructure CapturedRecord (request payload : String) (nominations : Option (List Nat)) where\\n  observed : ObservedRecord request nominations\\n  responseExact : observed.record.response = payload\\n\\ndef capture (request : String) (sources : List Source) (payload : String)\\n    (reads : Option (List (List PageMap.ReadObservation))) (nominations : Option (List Nat)) :\\n    CapturedRecord request payload nominations :=\\n  ⟨⟨⟨request, sources, payload, reads, nominations⟩, rfl, rfl⟩, rfl⟩\\n\\n/-- Canonical persistence preserves the computed response, request, nominations\\nand complete source/read program together; a slot cannot exchange one field. -/\\ntheorem captured_decode_keeps_origin (captured : CapturedRecord request payload nominations)\\n    (decoded : Record) (tail : List UInt8)\\n    (restored : codec.decode (codec.encode captured.observed.record ++ tail) = .ok (decoded, tail)) :\\n    decoded.request = request ∧ decoded.nominations = nominations ∧ decoded.response = payload ∧\\n      decoded.sources = captured.observed.record.sources ∧ decoded.reads = captured.observed.record.reads := by\\n  have same := Except.ok.inj ((codec_roundtrip captured.observed.record tail).symm.trans restored)\\n  have recordSame := congrArg Prod.fst same\\n  cases recordSame\\n  exact ⟨captured.observed.requestExact, captured.observed.agrees, captured.responseExact, rfl, rfl⟩\\n\\n/-- Cache metadata is not a graph input. Give its reader a separate disabled\\nobserver while retaining the exact immutable file/root and resource counters.\\nOtherwise a lookup performed after semantic retrieval records its own empty\\nmemo slot and invalidates itself as soon as that slot is published. -/\\nstructure MetadataReader (origin : Store.Snapshot) where\\n  snapshot : Store.Snapshot\\n  sameDirectory : snapshot.directory = origin.directory\\n  sameHead : snapshot.head = origin.head\\n  sameHandle : snapshot.handle = origin.handle\\n  sameReadCount : snapshot.reads = origin.reads\\n  sameByteCount : snapshot.readBytes = origin.readBytes\\n\\ndef MetadataReader.make (origin : Store.Snapshot) : IO (MetadataReader origin) := do\\n  let quiet ← PageMap.QuietReader.make origin\\n  pure ⟨quiet.snapshot, quiet.sameDirectory, quiet.sameHead, quiet.sameHandle,\\n    quiet.sameCounts.1, quiet.sameCounts.2⟩\\n\\ntheorem metadata_reader_uses_pinned_file {origin : Store.Snapshot} (reader : MetadataReader origin) :\\n    reader.snapshot.head = origin.head ∧ reader.snapshot.handle = origin.handle :=\\n  ⟨reader.sameHead, reader.sameHandle⟩\\n\\ntheorem metadata_reader_counts_actual_io {origin : Store.Snapshot} (reader : MetadataReader origin) :\\n    reader.snapshot.reads = origin.reads ∧ reader.snapshot.readBytes = origin.readBytes :=\\n  ⟨reader.sameReadCount, reader.sameByteCount⟩\\n\\n/-- A chain cannot jump over a changed record or accept another branch having\\nthe same revision counter. Each edge checks the complete predecessor head. -/\\ninductive NeutralChain : PageMap.Head → PageMap.Head → Prop\\n  | refl (head) : NeutralChain head head\\n  | step {first parent last} (earlier : NeutralChain first parent)\\n      (publication : Store.Publication) (linked : publication.parent = parent)\\n      (neutral : publication.change.neutral = true)\\n      (successor : last.revision = parent.revision + 1)\\n      (identity : last.identity = parent.identity)\\n      (authority : last.authority = parent.authority) : NeutralChain first last\\n\\n/-- Refinement boundary: a graph-store producer must publish an empty delta\\nonly for a graph-neutral operation. Under that invariant, the entire source\\nmeaning, rather than just its previously selected positive roots, is preserved.\\nThis is a theorem about the actual checked chain, not a filesystem axiom. -/\\ntheorem NeutralChain.preserves {first last : PageMap.Head}\\n    (chain : NeutralChain first last) (meaning : PageMap.Head → α)\\n    (producer : ∀ parent child (publication : Store.Publication),\\n      publication.parent = parent → publication.change.neutral = true →\\n      child.revision = parent.revision + 1 → child.identity = parent.identity →\\n      child.authority = parent.authority → meaning parent = meaning child) :\\n    meaning first = meaning last := by\\n  induction chain with\\n  | refl => rfl\\n  | step earlier publication linked neutral successor identity authority ih =>\\n      exact ih.trans (producer _ _ publication linked neutral successor identity authority)\\n\\n/-- The semantic effect replayed by the graph store. Both removed and newly\\nmatching roots are included; a nonempty delta is never a cache hit. -/\\ndef replay (change : Store.Change) (roots : List Value) (unions : List UnionEdge)\\n    (resolve : Nat → Value) (newUnions : List UnionEdge) : List Value × List UnionEdge :=\\n  (Store.reviseValues roots (change.removed.map resolve) (change.added.map resolve),\\n    if change.unionsChanged then newUnions else unions)\\n\\ntheorem neutral_replay (change : Store.Change) (neutral : change.neutral = true)\\n    (roots : List Value) (unions : List UnionEdge) (resolve : Nat → Value)\\n    (newUnions : List UnionEdge) : replay change roots unions resolve newUnions = (roots, unions) := by\\n  obtain ⟨added, removed, unionsSame, _affected⟩ := (Store.Change.neutral_exact change).mp neutral\\n  simp [replay, added, removed, unionsSame, Store.reviseValues]\\n\\nstructure Agreed (old current : PageMap.Head) : Type where\\n  chain : NeutralChain old current\\n\\ndef agreement (snapshot : Store.Snapshot) (old : PageMap.Head) :\\n    (fuel : Nat) → (current : PageMap.Head) → IO (Option (Agreed old current))\\n  | 0, current =>\\n      if same : old = current then pure (some ⟨same ▸ NeutralChain.refl old⟩) else pure none\\n  | fuel + 1, current => do\\n      if same : old = current then return some ⟨same ▸ NeutralChain.refl old⟩\\n      unless current.identity == old.identity && current.authority == old.authority &&\\n          old.revision < current.revision do return none\\n      -- Check sizes before following any chunk counter from an optional memo.\\n      let size ← Store.getNat snapshot.get (Store.key \\\"change\\\" current.revision)\\n      if size == 0 || size > publicationAllowance then return none\\n      let publication ← Store.readPublication snapshot current.revision\\n      if neutral : publication.change.neutral = true then\\n        if successor : current.revision = publication.parent.revision + 1 then\\n          if identity : current.identity = publication.parent.identity then\\n            if authority : current.authority = publication.parent.authority then\\n              let some earlier ← agreement snapshot old fuel publication.parent | return none\\n              return some ⟨.step earlier.chain publication rfl neutral successor identity authority⟩\\n      return none\\n\\ndef agree (snapshot : Store.Snapshot) (old : PageMap.Head) : IO Bool := do\\n  if snapshot.head.revision - old.revision > chainAllowance then return false\\n  pure (← agreement snapshot old chainAllowance snapshot.head).isSome\\n\\ndef sourcesAgree (sources : List Source) (paths : List System.FilePath)\\n    (snapshots : List (Option Store.Snapshot)) : IO Bool := do\\n  if sources.length != paths.length || snapshots.length != paths.length then return false\\n  for ((path, snapshot), source) in (paths.zip snapshots).zip sources do\\n    if source.1 != path.normalize.toString then return false\\n    match source.2, snapshot with\\n    | none, none => pure ()\\n    | some old, some current =>\\n        let reader ← MetadataReader.make current\\n        if !(← agree reader.snapshot old) then return false\\n    | _, _ => return false\\n  return true\\n\\n/-- A changed publication need not repair an unused request. Recheck the\\nactual read domain, including absent keys, complete candidate intervals,\\npopulation/frequency rows, topology, origins and selected payloads. The pinned\\nincarnation and authority still belong to the same readable source. -/\\ndef dependenciesAgree (record : Record) (paths : List System.FilePath)\\n    (snapshots : List (Option Store.Snapshot)) : IO Bool := do\\n  -- An unchanged source, or a certified graph-neutral append chain, preserves\\n  -- its committed prefix. Do not read every immutable body just to reuse a\\n  -- completed demand. Actual body reads still perform their checksum checks.\\n  if ← sourcesAgree record.sources paths snapshots then return true\\n  let some reads := record.reads | return false\\n  if record.sources.length != paths.length || snapshots.length != paths.length ||\\n      reads.length != paths.length then return false\\n  for (((path, snapshot), source), observations) in ((paths.zip snapshots).zip record.sources).zip reads do\\n    if source.1 != path.normalize.toString then return false\\n    match source.2, snapshot with\\n    | none, none => if !observations.isEmpty then return false\\n    | some old, some current =>\\n        unless old.identity == current.head.identity && old.authority == current.head.authority &&\\n            old.revision ≤ current.head.revision do return false\\n        let reader ← MetadataReader.make current\\n        if (← reader.snapshot.verifyReads? old observations).isNone then return false\\n    | _, _ => return false\\n  return true\\n\\ndef readChecked (snapshot : Store.Snapshot) (request : String) :\\n    IO (Option { record : Record // record.request = request }) := do\\n  let snapshot := (← MetadataReader.make snapshot).snapshot\\n  let tag := row request\\n  if (← snapshot.get tag).isNone then return none\\n  let size ← Store.getNat snapshot.get tag\\n  if size > allowance then return none\\n  let payloadSize ← Store.getNat snapshot.get (Store.key tag 0)\\n  if payloadSize != size then return none\\n  let bytes ← Store.readChunks snapshot snapshot.get tag 0\\n  let (record, tail) ← IO.ofExcept (codec.decode bytes.toList)\\n  unless tail.isEmpty && (codec.encode record).toByteArray == bytes do\\n    throw (IO.userError \\\"noncanonical demand memo\\\")\\n  return requestedRecord? record request\\n\\ndef read (snapshot : Store.Snapshot) (request : String) : IO (Option Record) := do\\n  pure ((← readChecked snapshot request).map (·.val))\\n\\ndef readObserved (snapshot : Store.Snapshot) (request : String)\\n    (nominations : Option (List Nat)) : IO (Option (ObservedRecord request nominations)) := do\\n  pure ((← readChecked snapshot request).bind fun requested => observedRecord? requested nominations)\\n\\n/-- A cache write never waits for the authoritative writer. Cache slots and\\nencoded records bound live optional data; they do not cap source data or users.\\nNeither an error nor a pending-search notice may be published by the caller. -/\\ndef publish (snapshot : Store.Snapshot) (record : Record) : IO Unit := do\\n  if codec.encodedSize record > allowance then return\\n  let tag := row record.request\\n  let bytes := (codec.encode record).toByteArray\\n  -- Computing may itself have published graph-neutral rank metadata. Use the\\n  -- current writer capability; the record still names the pinned search heads.\\n  -- A concurrently changed source makes this record a future cache miss.\\n  let current ← PageMap.pin snapshot.directory\\n  let _ ← PageMap.withWriter current fun writer => do\\n    if let some _ ← writer.get tag then\\n      let size ← Store.getNat writer.get tag\\n      let payloadSize ← Store.getNat writer.get (Store.key tag 0)\\n      if size ≤ allowance && size == payloadSize then\\n        let previous ← Store.readChunks (← writer.snapshot) writer.get tag 0\\n        if previous == bytes then return\\n    Store.putChunks writer tag 0 bytes\\n    Store.putNat writer tag bytes.size\\n    Store.writeChange writer {added := [],removed := [],unionsChanged := false}\\n  pure ()\\n\\n/-- Production publication receives a captured computation, with its exact\\npayload and current observation, rather than reconstructing an unrelated row. -/\\ndef publishCaptured (snapshot : Store.Snapshot)\\n    (captured : CapturedRecord request payload nominations) : IO Unit :=\\n  publish snapshot captured.observed.record\\n\\nend Eggshell.Plugin.DemandMemo\\n\",[]]"],["Eggshell.DiscoveryAudit","[\"module\\n\\npublic import Eggshell.Matcher\\npublic import Eggshell.SelectionDependency\\npublic import Eggshell.GraphCodec\\n\\n@[expose] public section\\n\\nnamespace Eggshell.DiscoveryAudit\\nopen Lean\\n\\ndef roleName : SelectionDependency.Role → String\\n  | .decomposition => \\\"decomposition\\\"\\n  | .deduplicatedChild => \\\"deduplicatedChild\\\"\\n  | .completedOutcome => \\\"completedOutcome\\\"\\n  | .advisoryOutcome => \\\"advisoryOutcome\\\"\\n\\nstructure ComparisonRow where\\n  role : String\\n  left : Json\\n  right : Json\\n  deriving BEq, ToJson, FromJson\\n\\ndef ComparisonRow.encode (comparison : SelectionDependency.Comparison) : ComparisonRow := {\\n  role := roleName comparison.role\\n  left := Persistence.valueToJson comparison.left\\n  right := Persistence.valueToJson comparison.right }\\n\\ndef atPrefix (before after : List UnionEdge) : Bool :=\\n  decide (before = after.take before.length)\\n\\nstructure AllUse where\\n  relation : Json\\n  generated : Bool\\n  deriving ToJson, FromJson\\n\\nstructure ScheduleSnapshot where\\n  pass : Nat\\n  kind : String\\n  localCount : Nat\\n  current : Json\\n  discovery : List Json\\n  tasks : List Json\\n  runAll : List Json\\n  premises : List ComparisonRow\\n  uses : List AllUse\\n  deriving ToJson, FromJson\\n\\nstructure Schedule where\\n  pass : Nat\\n  kind : String := \\\"discovery\\\"\\n  localUnions : List UnionEdge\\n  current : Value\\n  discovery : List Value\\n  tasks : List Value\\n  runAll : List AllEdge\\n  premises : List SelectionDependency.Comparison\\n  uses : List (AllEdge × Bool)\\n\\ndef Schedule.observe (event : Matcher.ScheduleObservation) : Schedule := {\\n  pass := event.pass, localUnions := event.view.localUnions, current := event.current\\n  discovery := event.extraction.discovery, tasks := event.tasks, runAll := event.runAll\\n  premises := (SelectionDependency.Report.ofValid event.valid).premises\\n  uses := event.extraction.selection.decompositionEdges.map fun edge =>\\n    (edge, event.runAll.any (fun prior => prior.relation == edge.relation)) }\\n\\n/-- The certified terminal path has the same unadmitted root demand as the\\nfirst reference pass. It does not run another extraction for telemetry. -/\\ndef Schedule.terminal {view : RunView} {current : Value} {text : String}\\n    (_terminal : Matcher.TerminalRoot view current text) : Schedule := {\\n  pass := 0, kind := \\\"terminal\\\", localUnions := view.localUnions, current\\n  discovery := [current], tasks := [current], runAll := [], premises := [], uses := [] }\\n\\ndef Schedule.snapshot? (after : List UnionEdge) (schedule : Schedule) : Option ScheduleSnapshot := do\\n  unless atPrefix schedule.localUnions after do none\\n  pure {\\n    pass := schedule.pass, kind := schedule.kind, localCount := schedule.localUnions.length\\n    current := Persistence.valueToJson schedule.current\\n    discovery := schedule.discovery.map Persistence.valueToJson\\n    tasks := schedule.tasks.map Persistence.valueToJson\\n    runAll := schedule.runAll.map (fun edge => Persistence.valueToJson edge.relation)\\n    premises := schedule.premises.map ComparisonRow.encode\\n    uses := schedule.uses.map fun (edge, generated) =>\\n      {relation := Persistence.valueToJson edge.relation, generated} }\\n\\nstructure SupportSnapshot where\\n  child : Nat\\n  localCount : Option Nat\\n  schedule : Option Nat\\n  demand : Json\\n  work : Json\\n  currentFragment : Json\\n  pastFragment : Json\\n  wholeIdentity : Bool\\n  fragmentIdentity : Bool\\n  retrieved : Bool\\n  automatic : Bool\\n  subwork : Bool\\n  deriving ToJson, FromJson\\n\\nstructure Support where\\n  child : Nat\\n  matched : Matcher.Match\\n  observed : Option (Nat × Option Nat)\\n\\nstructure ContinuationSnapshot where\\n  pass : Nat\\n  localCount : Nat\\n  current : Json\\n  text : String\\n  relation : Json\\n  support : List SupportSnapshot\\n  deriving ToJson, FromJson\\n\\nstructure Continuation where\\n  pass : Nat\\n  localUnions : List UnionEdge\\n  current : Value\\n  text : String\\n  edge : AllEdge\\n  support : List Support\\n\\ndef Continuation.observe (event : Matcher.ContinuationObservation)\\n    (locate : Matcher.Match → Option (Nat × Option Nat)) : Continuation := {\\n  pass := event.pass, localUnions := event.localUnions, current := event.current\\n  text := event.text, edge := event.edge\\n  support := event.edge.children.zipIdx.filterMap fun (child, index) => do\\n    if child == HandoffRemainder.value event.text then none else do\\n      let matched ← event.hits.find? fun matched => matched.demand == event.current &&\\n        matched.automatic && matched.work.subwork && matched.continuationWork == child\\n      pure ⟨index, matched, locate matched⟩ }\\n\\ndef Continuation.snapshot? (after : List UnionEdge) (event : Continuation) : Option ContinuationSnapshot := do\\n  unless atPrefix event.localUnions after do none\\n  pure {\\n    pass := event.pass, localCount := event.localUnions.length\\n    current := Persistence.valueToJson event.current, text := event.text\\n    relation := Persistence.valueToJson event.edge.relation\\n    support := event.support.map fun support => {\\n      child := support.child, localCount := support.observed.map (·.1)\\n      schedule := support.observed.bind (·.2)\\n      demand := Persistence.valueToJson support.matched.demand\\n      work := Persistence.valueToJson support.matched.edge.work\\n      currentFragment := Persistence.valueToJson support.matched.work.currentFragment\\n      pastFragment := Persistence.valueToJson support.matched.work.pastFragment\\n      wholeIdentity := support.matched.work.wholeWorkIdentity\\n      fragmentIdentity := support.matched.work.fragmentIdentity\\n      retrieved := support.matched.retrieved, automatic := support.matched.automatic\\n      subwork := support.matched.work.subwork } }\\n\\n/-- The callback retains Value references, not quotients or reader caches.\\nOnly a completed handoff serializes this trail. -/\\nstructure Trail where\\n  current : Option Nat := none\\n  schedules : List Schedule := []\\n  continuations : List Continuation := []\\n\\ndef Trail.observe (trail : Trail) (event : Matcher.DiscoveryTrace)\\n    (locate : Matcher.Match → Option (Nat × Option Nat)) : Trail :=\\n  match event with\\n  | .scheduled event => {trail with\\n      current := some event.pass, schedules := Schedule.observe event :: trail.schedules}\\n  | .continued event => {trail with\\n      continuations := Continuation.observe event locate :: trail.continuations}\\n\\nend Eggshell.DiscoveryAudit\\n\",[]]"],["Eggshell.DiscoveryCounters","[\"module\\npublic import Eggshell.Receipt\\npublic import Lean.Data.Json.FromToJson\\n@[expose] public section\\n\\nnamespace Eggshell.DiscoveryCounters\\nopen Lean\\n\\nstructure Count where\\n  calls : Nat := 0\\n  nanos : Nat := 0\\n  deriving ToJson\\n\\nstructure Recorder where\\n  receipt : Option String\\n  counts : IO.Ref (Std.HashMap String Count)\\n  failed : IO.Ref Bool\\n\\ndef create (receipt : Option String) : IO Recorder := do\\n  return ⟨receipt,← IO.mkRef {},← IO.mkRef false⟩\\n\\n/-- Counts contain durations and call counts only, never source/query data.\\nThe result and exception of the observed action are returned unchanged. -/\\ndef timed (recorder : Recorder) (name : String) (action : IO α) : IO α := do\\n  if recorder.receipt.isNone then return ← action\\n  let started ← IO.monoNanosNow\\n  try action\\n  finally\\n    try\\n      let elapsed := (← IO.monoNanosNow)-started\\n      recorder.counts.modify fun counts =>\\n        let previous := counts.getD name {}\\n        counts.insert name ⟨previous.calls+1,previous.nanos+elapsed⟩\\n    catch _ => recorder.failed.set true\\n\\ndef emit (recorder : Recorder) (outcomes : Nat) : IO Unit := do\\n  if recorder.receipt.isNone then return\\n  let values := (← recorder.counts.get).toList.mergeSort (fun a b => a.1 ≤ b.1)\\n  Receipt.observe recorder.receipt s!\\\"discovery-counters-{← IO.monoNanosNow}\\\" (Json.mkObj [\\n    (\\\"complete\\\",toJson (!(← recorder.failed.get))),\\n    (\\\"scope\\\",toJson \\\"overlapping counters; do not sum admission with nested frequency IO\\\"),\\n    (\\\"graphOutcomes\\\",toJson outcomes),\\n    (\\\"counters\\\",Json.mkObj (values.map fun (name,value) => (name,toJson value)))])\\n\\nend Eggshell.DiscoveryCounters\\n\",[]]"],["Eggshell.DiscoveryMemo","[\"module\\n\\npublic import Eggshell.RankMemo\\npublic import Eggshell.SaturationMemo\\n\\n@[expose] public section\\nnamespace Eggshell.Plugin.DiscoveryMemo\\nopen Persistence DB Matcher\\n\\n/-- Only completed unweighted geometry, ranking permutations and certified\\njoin instructions. This is optional advice in the existing DB, never a\\npartial answer, an Outcome, or serialized source body. -/\\nstructure Packet where\\n  ranks : RankMemo.Saved := []\\n  selections : RankMemo.Saved := []\\n  contexts : RankMemo.Saved := []\\n  saturation : Option SaturationMemo.Saved := none\\n  deriving DecidableEq\\n\\ndef Packet.empty (packet : Packet) : Bool :=\\n  packet.ranks.isEmpty && packet.selections.isEmpty && packet.contexts.isEmpty &&\\n    packet.saturation.isNone\\n\\n/-- The observed producer supplies the actual checked join generation.\\nOrdinal hints are not assumed to retain a proof on disk; the current-domain\\ncertifier checks them again on the next request. -/\\ndef Packet.withPlan (packet : Packet) (roots : List Value) (edges : List UnionEdge)\\n    (plan : Option QuotientBuilder.CongruenceMemo.Entry) : Packet :=\\n  {packet with saturation := plan.map (fun plan => SaturationMemo.capturePlan\\n      (SaturationMemo.Basis.make (SaturationMemo.kernelValues roots edges)) plan)}\\n\\ntheorem captured_producer (packet : Packet) (roots : List Value) (edges : List UnionEdge)\\n    (plan : QuotientBuilder.CongruenceMemo.Entry) :\\n    (packet.withPlan roots edges (some plan)).saturation = some\\n      (SaturationMemo.pack\\n        (SaturationMemo.Basis.make (SaturationMemo.kernelValues roots edges))\\n        (SaturationMemo.allowance - 1)\\n        (plan.rows.zip (QuotientBuilder.CongruenceMemo.instructions {} plan.rows))) := by\\n  change some (SaturationMemo.capturePlan _ plan) = _\\n  rw [SaturationMemo.capturePlan_producer]\\n\\ntheorem captured_bounded (packet : Packet) (roots : List Value) (edges : List UnionEdge)\\n    (plan : QuotientBuilder.CongruenceMemo.Entry) :\\n    (packet.withPlan roots edges (some plan)).saturation.all\\n      (fun saved => decide (SaturationMemo.codec.encodedSize saved ≤ SaturationMemo.allowance)) = true := by\\n  change decide (SaturationMemo.codec.encodedSize (SaturationMemo.capturePlan _ plan) ≤\\n    SaturationMemo.allowance) = true\\n  rw [decide_eq_true_eq]\\n  exact SaturationMemo.capturePlan_bounded _ _\\n\\n/-- A checkpoint from any earlier boundary is certified against today's\\ninput. Correction, deletion and a different ordinal basis cannot import an\\nold equality into the actual current quotient producer. -/\\ntheorem captured_restore_exact (packet : Packet) (roots : List Value) (edges : List UnionEdge)\\n    (plan : QuotientBuilder.CongruenceMemo.Entry) (currentBasis : SaturationMemo.Basis)\\n    (currentRoots : List Value) (persistent runLocal : List UnionEdge) :\\n    ((packet.withPlan roots edges (some plan)).saturation.map fun saved =>\\n      (QuotientBuilder.plannedBuild? currentRoots persistent runLocal\\n        (SaturationMemo.restore currentBasis saved)).quotient) =\\n      some (QuotientBuilder.build? currentRoots persistent runLocal) := by\\n  exact congrArg some (SaturationMemo.restored_build_exact currentBasis\\n    (SaturationMemo.capturePlan (SaturationMemo.Basis.make\\n      (SaturationMemo.kernelValues roots edges)) plan) currentRoots persistent runLocal)\\n\\n/-- One fail-fast writer ownership and one publication for the complete\\nboundary. Unchanged slots append nothing. The existing writer enforces a\\nderived-only trace before accepting the empty graph delta. -/\\ndef publish (path : System.FilePath) (packet : Packet) : IO Unit := do\\n  if packet.empty then return\\n  let snapshot ← PageMap.pin path\\n  let _ ← PageMap.withWriter snapshot fun writer => do\\n    let ranks ← RankMemo.publishUsing writer packet.ranks\\n    let selections ← RankMemo.publishUsing writer packet.selections .selection\\n    let contexts ← RankMemo.publishUsing writer packet.contexts .context\\n    let saturation ← match packet.saturation with\\n      | none => pure false\\n      | some saved => SaturationMemo.publishUsing writer saved\\n    if ranks || selections || contexts || saturation then\\n      Store.writeChange writer {added := [],removed := [],unionsChanged := false}\\n  pure ()\\n\\n/-- A busy optional publisher is retried only at another completed boundary,\\nnever in a wait loop. A failed attempt cannot acknowledge lost work. -/\\nstructure Publisher where\\n  path : System.FilePath\\n  acknowledged : IO.Ref (Option Packet)\\n\\ndef Publisher.new (path : System.FilePath) : IO Publisher :=\\n  return ⟨path, ← IO.mkRef none⟩\\n\\ndef Publisher.checkpoint (publisher : Publisher) (packet : Packet) : IO Unit := do\\n  if (← publisher.acknowledged.get) = some packet then return\\n  try\\n    publish publisher.path packet\\n    publisher.acknowledged.set (some packet)\\n  catch _ => pure ()\\n\\nend Eggshell.Plugin.DiscoveryMemo\\n\",[]]"],["Eggshell.EqualityDependency","[\"module\\n\\npublic import Eggshell.CongruenceSound\\npublic import Eggshell.QuotientAuthority\\n\\n@[expose] public section\\n\\nnamespace Eggshell.EqualityDependency\\n\\nopen QuotientBuilder QuotientBuilder.Partition\\n\\n/-- Literal equality and current explicit Union edges, without Apply congruence. -/\\ninductive UnionPath (edges : List UnionEdge) : Value → Value → Prop where\\n  | refl (value) : UnionPath edges value value\\n  | edge (edge) : edge ∈ edges → UnionPath edges edge.left edge.right\\n  | symm : UnionPath edges left right → UnionPath edges right left\\n  | trans : UnionPath edges left middle → UnionPath edges middle right → UnionPath edges left right\\n\\ntheorem UnionPath.generated {edges left right} (path : UnionPath edges left right) :\\n    Eggshell.Equivalent edges left right := by\\n  induction path with\\n  | refl value => exact .refl value\\n  | edge edge member => exact .union edge member\\n  | symm _ ih => exact .symm ih\\n  | trans _ _ first second => exact .trans first second\\n\\nprivate def Paths (edges : List UnionEdge) (partition : RawPartition) : Prop :=\\n  ∀ query, ∀ member ∈ lookup partition query, UnionPath edges member query\\n\\nprivate theorem paths_empty (edges : List UnionEdge) : Paths edges [] := by\\n  intro query member present\\n  have same : member = query := by simpa [lookup, takeClass] using present\\n  subst member\\n  exact .refl query\\n\\nprivate theorem paths_merge {edges : List UnionEdge} {partition : RawPartition}\\n    (valid : Valid partition) (paths : Paths edges partition) (left right : Value)\\n    (joined : UnionPath edges left right) : Paths edges (merge partition left right) := by\\n  intro query member present\\n  rw [merge_lookup valid] at present\\n  split at present\\n  · exact paths query member present\\n  · split at present\\n    · rename_i _ inside\\n      have toLeft : UnionPath edges query left := by\\n        rcases List.mem_append.mp inside with first | second\\n        · exact paths left query first\\n        · exact .trans (paths right query second) (.symm joined)\\n      apply UnionPath.trans _ (.symm toLeft)\\n      rcases List.mem_append.mp present with first | second\\n      · exact paths left member first\\n      · exact .trans (paths right member second) (.symm joined)\\n    · exact paths query member present\\n\\nprivate theorem paths_explicit {edges : List UnionEdge} {partition : RawPartition}\\n    (valid : Valid partition) (paths : Paths edges partition) (updates : List UnionEdge)\\n    (current : ∀ edge ∈ updates, edge ∈ edges) : Paths edges (mergeExplicit partition updates) := by\\n  induction updates generalizing partition with\\n  | nil => exact paths\\n  | cons edge tail ih =>\\n    exact ih (merge_valid valid edge.left edge.right)\\n      (paths_merge valid paths edge.left edge.right (.edge edge (current edge (by simp))))\\n      (fun next member => current next (by simp [member]))\\n\\n/-- This partition accepts mixed Atom/Apply generators as well as atomic ones.\\nIt is a diagnostic reference, not an additional build on the hook's hot path. -/\\nstructure DirectIndex (edges : List UnionEdge) where\\n  quotient : Quotient\\n  exact : certify (mergeExplicit [] edges) = some quotient\\n\\ndef DirectIndex.make (edges : List UnionEdge) : DirectIndex edges :=\\n  match found : certify (mergeExplicit [] edges) with\\n  | some quotient => ⟨quotient, found⟩\\n  | none => False.elim (by\\n      obtain ⟨quotient, certified⟩ := Authority.certify_exists\\n        (explicit_valid valid_nil edges) (Authority.explicit_safe valid_nil Authority.empty_safe edges)\\n      rw [found] at certified\\n      contradiction)\\n\\n/-- The executable comparison is exactly explicit-edge reachability. In\\nparticular, a negative result rules out every Union-only proof, not just a\\nparticular parent pointer or a sampled path. -/\\ntheorem DirectIndex.same_iff (index : DirectIndex edges) (left right : Value) :\\n    index.quotient.toEquality.same left right = true ↔ UnionPath edges left right := by\\n  constructor\\n  · intro same\\n    have heads : (lookup (mergeExplicit [] edges) left).headD left =\\n        (lookup (mergeExplicit [] edges) right).headD right := by\\n      simpa only [Quotient.same_iff_canonical_eq,\\n        certify_lookup (explicit_valid valid_nil edges) index.exact] using same\\n    exact .symm (paths_explicit valid_nil (paths_empty edges) edges\\n      (fun _ member => member) left right\\n        ((heads_equal (explicit_valid valid_nil edges) left right).mp heads))\\n  · intro path\\n    induction path with\\n    | refl value => exact index.quotient.toEquality.reflexive value\\n    | edge edge member =>\\n      have connected := CongruenceComplete.explicit_connected [] valid_nil edges edge member\\n      simpa only [Quotient.same_iff_canonical_eq,\\n        certify_lookup (explicit_valid valid_nil edges) index.exact,\\n        CongruenceComplete.canonical] using connected\\n    | symm _ ih => exact index.quotient.toEquality.symmetric ih\\n    | trans _ _ first second => exact index.quotient.toEquality.transitive first second\\n\\ntheorem DirectIndex.generated (index : DirectIndex edges) :\\n    CongruenceSound.QuotientSound edges index.quotient :=\\n  fun left right same => ((index.same_iff left right).mp same).generated\\n\\ninductive Kind where\\n  | notEquivalent\\n  | literal\\n  | persistentUnion\\n  /-- A current local edge is needed for this direct path. Its causal ancestry\\n  remains unresolved; it must not be counted as a congruence-free delivery. -/\\n  | localUnion\\n  | congruence\\n  deriving BEq, DecidableEq, Repr\\n\\ndef classify (full : Equality) (stored : DirectIndex persistent)\\n    (current : DirectIndex (persistent ++ runLocal)) (left right : Value) : Kind :=\\n  if !full.same left right then .notEquivalent\\n  else if left == right then .literal\\n  else if stored.quotient.toEquality.same left right then .persistentUnion\\n  else if current.quotient.toEquality.same left right then .localUnion\\n  else .congruence\\n\\ntheorem persistent_has_union_path (full : Equality) (stored : DirectIndex persistent)\\n    (current : DirectIndex (persistent ++ runLocal)) (left right : Value)\\n    (kind : classify full stored current left right = .persistentUnion) :\\n    UnionPath persistent left right := by\\n  unfold classify at kind\\n  split at kind <;> try contradiction\\n  split at kind <;> try contradiction\\n  split at kind\\n  · exact (stored.same_iff left right).mp (by assumption)\\n  · split at kind <;> contradiction\\n\\ntheorem local_has_current_union_path (full : Equality) (stored : DirectIndex persistent)\\n    (current : DirectIndex (persistent ++ runLocal)) (left right : Value)\\n    (kind : classify full stored current left right = .localUnion) :\\n    UnionPath (persistent ++ runLocal) left right ∧ ¬ UnionPath persistent left right := by\\n  unfold classify at kind\\n  split at kind <;> try contradiction\\n  split at kind <;> try contradiction\\n  split at kind <;> try contradiction\\n  split at kind\\n  · constructor\\n    · exact (current.same_iff left right).mp (by assumption)\\n    · intro path\\n      have same := (stored.same_iff left right).mpr path\\n      contradiction\\n  · contradiction\\n\\n/-- A generated positive comparison outside explicit closure requires an Apply\\nstep in any explanation. This is about one comparison, not a whole delivery. -/\\ntheorem congruence_is_necessary (full : Equality) (stored : DirectIndex persistent)\\n    (current : DirectIndex (persistent ++ runLocal))\\n    (generated : ∀ left right, full.same left right = true →\\n      Eggshell.Equivalent (persistent ++ runLocal) left right)\\n    (left right : Value) (kind : classify full stored current left right = .congruence) :\\n    Eggshell.Equivalent (persistent ++ runLocal) left right ∧\\n      ¬ UnionPath (persistent ++ runLocal) left right := by\\n  unfold classify at kind\\n  split at kind <;> try contradiction\\n  next positive =>\\n    have same : full.same left right = true := by simpa using positive\\n    split at kind <;> try contradiction\\n    split at kind <;> try contradiction\\n    split at kind <;> try contradiction\\n    constructor\\n    · exact generated left right same\\n    · intro path\\n      have connected := (current.same_iff left right).mpr path\\n      contradiction\\n\\nend Eggshell.EqualityDependency\\n\",[]]"],["Eggshell.EvidenceReplay","[\"module\\n\\npublic import Eggshell.Matcher\\npublic import Eggshell.HashDistinct\\npublic import Init.Data.Array.Sort.Lemmas\\npublic import Init.Data.List.Sort.Lemmas\\nimport all Init.Data.List.Sort.Basic\\n\\n@[expose] public section\\nnamespace Eggshell.Matcher.EvidenceReplay\\n\\nlocal instance : BEq Evidence := ⟨fun a b => decide (a = b)⟩\\nlocal instance : LawfulBEq Evidence where\\n  rfl := by intro a; simp [BEq.beq]\\n  eq_of_beq := by intro a b h; exact of_decide_eq_true h\\n\\ndef lex (a b : Nat) (rest : Bool) : Bool :=\\n  if a == b then rest else a ≤ b\\n\\ntheorem lex_trans (a b c : Nat) (ab bc ac : Bool)\\n    (tail : ab → bc → ac) : lex a b ab → lex b c bc → lex a c ac := by\\n  intro first second\\n  by_cases h : a = b <;> by_cases k : b = c <;> by_cases j : a = c <;>\\n    simp_all [lex] <;> omega\\n\\ntheorem lex_reverse_trans (a b c : Nat) (ab bc ac : Bool)\\n    (tail : ab → bc → ac) : lex b a ab → lex c b bc → lex c a ac := by\\n  intro first second\\n  exact lex_trans c b a bc ab ac (fun x y => tail y x) second first\\n\\ntheorem lex_total (a b : Nat) (ab ba : Bool) (tail : ab || ba) :\\n    lex a b ab || lex b a ba := by\\n  by_cases h : a = b\\n  · subst b; simpa [lex] using tail\\n  · simp [lex, h, Ne.symm h]; omega\\n\\ndef order (weights : Array Nat) (a b : Evidence) : Bool :=\\n  lex (evidenceWeight weights b) (evidenceWeight weights a)\\n    (lex b.query.units.length a.query.units.length\\n      (lex a.target.units.length b.target.units.length\\n        (lex a.target.span.start b.target.span.start (a.query.span.start ≤ b.query.span.start))))\\n\\ntheorem order_reference (weights : Array Nat) (a b : Evidence) :\\n    order weights a b = !preferredEvidence weights b a := by\\n  by_cases w : evidenceWeight weights b = evidenceWeight weights a <;>\\n  by_cases q : b.query.units.length = a.query.units.length <;>\\n  by_cases t : b.target.units.length = a.target.units.length <;>\\n  by_cases s : b.target.span.start = a.target.span.start <;>\\n    simp [order, lex, preferredEvidence, w, q, t, s, Ne.symm, ← decide_not, Nat.not_lt]\\n\\ntheorem order_trans (weights : Array Nat) (a b c : Evidence) :\\n    order weights a b → order weights b c → order weights a c := by\\n  unfold order\\n  apply lex_reverse_trans\\n  · apply lex_reverse_trans\\n    · apply lex_trans\\n      · apply lex_trans\\n        · simpa only [decide_eq_true_eq] using\\n            (@Nat.le_trans a.query.span.start b.query.span.start c.query.span.start)\\n\\ntheorem order_total (weights : Array Nat) (a b : Evidence) :\\n    order weights a b || order weights b a := by\\n  apply lex_total\\n  apply lex_total\\n  apply lex_total\\n  apply lex_total\\n  simpa using Nat.le_total a.query.span.start b.query.span.start\\n\\n/-- Linear adjacent-order verification. Transitivity closes the all-pairs\\ncontract in Lean; the executable does not compare every pair. -/\\ndef chain (le : α → α → Bool) : List α → Bool\\n  | [] | [_] => true\\n  | a :: b :: rest => le a b && chain le (b :: rest)\\n\\ntheorem chain_pairwise (le : α → α → Bool)\\n    (trans : ∀ a b c, le a b → le b c → le a c) (items : List α)\\n    (accepted : chain le items) : items.Pairwise (fun a b => le a b = true) := by\\n  induction items with\\n  | nil => simp\\n  | cons a rest ih =>\\n    cases rest with\\n    | nil => simp\\n    | cons b rest =>\\n      have h : le a b = true ∧ chain le (b :: rest) = true := by\\n        simpa [chain] using accepted\\n      have tail := ih h.2\\n      apply List.pairwise_cons.mpr\\n      refine ⟨?_, tail⟩\\n      intro c member\\n      rcases List.mem_cons.mp member with equal | member\\n      · subst c; exact h.1\\n      · exact trans a b c h.1 ((List.pairwise_cons.mp tail).1 c member)\\n\\n/-- Hash deduplication and indexed array access bound verification to a\\nlinear frontier. No serialized body, result or erased proof is trusted. -/\\ndef replay (items : List α) [BEq α] [Hashable α] (positions : List Nat) : List (α × Nat) :=\\n  let source := items.toArray\\n  (hashDistinct positions).filterMap (fun i => source[i]?.map (fun item => (item, i)))\\n\\n/-- A current, complete evidence domain. Its list parameter and correctness\\nproofs erase; lookup may address a virtual product without allocating it. -/\\nstructure Indexed (items : List Evidence) where\\n  count : Nat\\n  lookup : Nat → Option Evidence\\n  countExact : count = items.length\\n  lookupExact : ∀ position, lookup position = items[position]?\\n\\ndef replayIndexed (source : Indexed items) (positions : List Nat) : List (Evidence × Nat) :=\\n  (hashDistinct positions).filterMap fun i => (source.lookup i).map (fun item => (item, i))\\n\\ntheorem replayIndexed_reference (source : Indexed items) (positions : List Nat) :\\n    replayIndexed source positions = replay items positions := by\\n  simp only [replayIndexed, replay, source.lookupExact, List.getElem?_toArray,\\n    ]\\n\\ntheorem replay_subset [BEq α] [LawfulBEq α] [Hashable α]\\n    (items : List α) (positions : List Nat) : replay items positions ⊆ items.zipIdx := by\\n  intro item member\\n  obtain ⟨i, _, found⟩ := List.mem_filterMap.mp member\\n  have found : items.zipIdx[i]? = some item := by\\n    simpa only [List.getElem?_toArray, List.getElem?_zipIdx, Nat.zero_add] using found\\n  exact List.mem_of_getElem? found\\n\\ntheorem replay_nodup [BEq α] [Hashable α] (items : List α) (positions : List Nat) :\\n    (replay items positions).Nodup := by\\n  dsimp only [replay]\\n  refine List.Pairwise.filterMap _ ?_ (HashDistinct.nodup positions)\\n  intro i j different a first b second same\\n  have ordinal (i : Nat) (item : α × Nat)\\n      (found : (items.toArray[i]?).map (fun value => (value, i)) = some item) : item.2 = i := by\\n    cases value : items.toArray[i]? <;> simp_all\\n    exact (congrArg Prod.snd found).symm\\n  exact different ((ordinal i a first).symm.trans (congrArg Prod.snd same) |>.trans\\n    (ordinal j b second))\\n\\ntheorem full_subset_perm [BEq α] [LawfulBEq α] {a b : List α}\\n    (unique : a.Nodup) (sourceUnique : b.Nodup) (subset : a ⊆ b)\\n    (size : a.length = b.length) : a.Perm b := by\\n  apply (List.perm_ext_iff_of_nodup unique sourceUnique).mpr\\n  intro x\\n  refine ⟨fun member => subset member, ?_⟩\\n  intro member\\n  apply Decidable.byContradiction\\n  intro absent\\n  have smaller : a ⊆ b.erase x := by\\n    intro y hy\\n    exact (List.mem_erase_of_ne (by intro equal; subst y; exact absent hy)).mpr (subset hy)\\n  have length := unique.length_le_of_subset smaller\\n  have positive := List.length_pos_of_mem member\\n  rw [List.length_erase_of_mem member] at length\\n  omega\\n\\ntheorem replay_perm (items : List Evidence) (positions : List Nat)\\n    (size : (replay items positions).length = items.length) :\\n    (replay items positions).Perm items.zipIdx := by\\n  have unique : (items.zipIdx.map Prod.snd).Nodup := by\\n    rw [List.zipIdx_map_snd]; exact List.nodup_range' _\\n  have sourceUnique : items.zipIdx.Nodup :=\\n    List.Pairwise.of_map Prod.snd (fun _ _ different equal => different (congrArg Prod.snd equal)) unique\\n  exact full_subset_perm (replay_nodup items positions) sourceUnique\\n    (replay_subset items positions) (by simpa using size)\\n\\ndef stableOrder (weights : List Nat) := List.zipIdxLE (order weights.toArray)\\n\\nstructure RankKey where\\n  weight : Nat\\n  queryWidth : Nat\\n  targetWidth : Nat\\n  targetStart : Nat\\n  queryStart : Nat\\n\\ndef RankKey.of (weights : Array Nat) (item : Evidence) : RankKey :=\\n  ⟨evidenceWeight weights item, item.query.units.length, item.target.units.length,\\n    item.target.span.start, item.query.span.start⟩\\n\\ndef RankKey.order (a b : RankKey) : Bool :=\\n  lex b.weight a.weight (lex b.queryWidth a.queryWidth\\n    (lex a.targetWidth b.targetWidth (lex a.targetStart b.targetStart (a.queryStart ≤ b.queryStart))))\\n\\n/-- Compute the dependency-sensitive weight once per source ordinal, rather\\nthan once per comparison. The equality field ties that key to this request. -/\\nstructure Keyed (weights : List Nat) where\\n  original : Evidence × Nat\\n  key : RankKey\\n  exact : key = RankKey.of weights.toArray original.1\\n\\ndef Keyed.make (weights : List Nat) (array : Array Nat) (exact : array = weights.toArray)\\n    (item : Evidence × Nat) : Keyed weights :=\\n  ⟨item, RankKey.of array item.1, by rw [exact]⟩\\n\\ndef Keyed.order (a b : Keyed weights) : Bool :=\\n  List.zipIdxLE RankKey.order (a.key, a.original.2) (b.key, b.original.2)\\n\\ntheorem Keyed.order_exact (a b : Keyed weights) :\\n    Keyed.order a b = stableOrder weights a.original b.original := by\\n  simp only [Keyed.order, a.exact, b.exact, stableOrder, List.zipIdxLE, RankKey.of,\\n    RankKey.order, EvidenceReplay.order]\\n  rfl\\n\\ntheorem Keyed.order_trans (a b c : Keyed weights) :\\n    Keyed.order a b → Keyed.order b c → Keyed.order a c := by\\n  simp only [Keyed.order_exact]\\n  exact List.zipIdxLE_trans (EvidenceReplay.order_trans weights.toArray) a.original b.original c.original\\n\\ntheorem Keyed.chain_sorted (parts : List (Keyed weights)) (accepted : chain Keyed.order parts = true) :\\n    (parts.map (·.original)).Pairwise (fun a b => stableOrder weights a b = true) := by\\n  rw [List.pairwise_map]\\n  exact (chain_pairwise _ Keyed.order_trans parts accepted).imp (fun {_ _} good =>\\n    by simpa only [Keyed.order_exact] using good)\\n\\ntheorem sorted_exact (weights : List Nat) (items : List Evidence)\\n    (ranked : List (Evidence × Nat)) (perm : ranked.Perm items.zipIdx)\\n    (sorted : ranked.Pairwise (fun a b => stableOrder weights a b = true)) :\\n    ranked.map Prod.fst = rankedEvidence weights items := by\\n  have equal : ranked = items.zipIdx.mergeSort (stableOrder weights) := by\\n    apply List.Perm.eq_of_pairwise (le := fun a b => stableOrder weights a b = true)\\n    · rintro ⟨a, i⟩ ⟨b, j⟩ ha hb ab ba\\n      have ma := perm.subset ha\\n      have mb := List.mem_mergeSort.mp hb\\n      simp only [stableOrder, List.zipIdxLE] at ab ba\\n      have ai : i ≤ j := by\\n        split at ab <;> split at ba <;> simp_all\\n      have bj : j ≤ i := by\\n        split at ab <;> split at ba <;> simp_all\\n      have same := Nat.le_antisymm ai bj\\n      subst j\\n      have := List.mem_zipIdx ma\\n      have := List.mem_zipIdx mb\\n      simp_all\\n    · exact sorted\\n    · exact List.pairwise_mergeSort (List.zipIdxLE_trans (order_trans _))\\n        (List.zipIdxLE_total (order_total _)) _\\n    · exact perm.trans (List.mergeSort_perm _ _).symm\\n  rw [equal]\\n  change (items.zipIdx.mergeSort (List.zipIdxLE (order weights.toArray))).map (·.1) = _\\n  rw [List.mergeSort_zipIdx]\\n  simp only [rankedEvidence, Array.toList_mergeSort]\\n  congr 1\\n  funext a b\\n  exact order_reference _ a b\\n\\n/-- Arbitrary persisted positions can only produce an exact current result.\\nA stale/corrupt certificate is a miss, never approximate evidence. -/\\ndef certify (weights : List Nat) (items : List Evidence) (positions : List Nat) :\\n    Option {ranked : List Evidence // ranked = rankedEvidence weights items} :=\\n  let ranked := replay items positions\\n  if size : ranked.length = items.length then\\n    if sorted : chain (stableOrder weights) ranked = true then\\n      some ⟨ranked.map Prod.fst,\\n        sorted_exact weights items ranked (replay_perm items positions size)\\n          (chain_pairwise _ (List.zipIdxLE_trans (order_trans _)) _ sorted)⟩\\n    else none\\n  else none\\n\\n/-- Certify an existing order directly against the current source index.\\nNo full join list is evaluated on this path. Complete count, permutation and\\nstable ordering remain mandatory, including every newly matching anchor. -/\\n@[inline] def certifyIndexed (weights : List Nat) (source : Indexed items) (positions : List Nat) :\\n    Option {ranked : List Evidence // ranked = rankedEvidence weights items} :=\\n  let ranked := replayIndexed source positions\\n  if size : ranked.length = source.count then\\n    if sorted : chain (stableOrder weights) ranked = true then\\n      some ⟨ranked.map Prod.fst,\\n        sorted_exact weights items ranked\\n          (by\\n            have complete : (replay items positions).length = items.length := by\\n              simpa only [ranked, replayIndexed_reference, source.countExact] using size\\n            simpa only [ranked, replayIndexed_reference] using replay_perm items positions complete)\\n          (chain_pairwise _ (List.zipIdxLE_trans (order_trans _)) _ sorted)⟩\\n    else none\\n  else none\\n\\ntheorem certify_exact (weights : List Nat) (source : Indexed items) (positions : List Nat)\\n    (ranked : {ranked : List Evidence // ranked = rankedEvidence weights items})\\n    (_accepted : certifyIndexed weights source positions = some ranked) :\\n    ranked.val = rankedEvidence weights items := ranked.property\\n\\n/-- Reuse ascending runs after a dependency changes. Only the boundaries\\nthat changed order cause merges; an unchanged order needs no sort. -/\\ndef runs (le : α → α → Bool) : List α → List (List α)\\n  | [] => []\\n  | head :: tail =>\\n      match runs le tail with\\n      | [] => [[head]]\\n      | [] :: rest => [head] :: [] :: rest\\n      | (next :: following) :: rest =>\\n          if le head next then (head :: next :: following) :: rest\\n          else [head] :: (next :: following) :: rest\\n\\ntheorem runs_flatten (le : α → α → Bool) (items : List α) :\\n    (runs le items).flatten = items := by\\n  induction items with\\n  | nil => rfl\\n  | cons head tail ih =>\\n      simp only [runs]\\n      split <;> simp_all\\n      split <;> simp_all\\n\\ndef mergePairs (le : α → α → Bool) : List (List α) → List (List α)\\n  | first :: second :: rest => List.merge first second le :: mergePairs le rest\\n  | rest => rest\\n\\ntheorem mergePairs_perm (le : α → α → Bool) (parts : List (List α)) :\\n    (mergePairs le parts).flatten.Perm parts.flatten := by\\n  match parts with\\n  | [] => rfl\\n  | [part] => rfl\\n  | first :: second :: rest =>\\n      simpa only [mergePairs, List.flatten_cons, List.append_assoc] using\\n        (List.merge_perm_append (le := le) (xs := first) (ys := second)).append\\n          (mergePairs_perm le rest)\\ntermination_by parts.length\\n\\ndef mergeRuns (le : α → α → Bool) : Nat → List (List α) → List α\\n  | 0, parts => parts.flatten\\n  | _ + 1, [] => []\\n  | _ + 1, [part] => part\\n  | fuel + 1, parts => mergeRuns le fuel (mergePairs le parts)\\n\\ntheorem mergeRuns_perm (le : α → α → Bool) (fuel : Nat) (parts : List (List α)) :\\n    (mergeRuns le fuel parts).Perm parts.flatten := by\\n  induction fuel generalizing parts with\\n  | zero => rfl\\n  | succ fuel ih =>\\n      cases parts with\\n      | nil => rfl\\n      | cons first tail =>\\n          cases tail with\\n          | nil => simp [mergeRuns]\\n          | cons second rest =>\\n              exact (ih _).trans (mergePairs_perm le _)\\n\\n/-- Current complete ordinals are mandatory even for differential repair.\\nThe output's permutation and final order certify the exact stable reference;\\nthe previous order has no authority to suppress newly matching evidence. -/\\ndef repairIndexed (weights : List Nat) (source : Indexed items) (positions : List Nat) :\\n    Option ({ranked : List Evidence // ranked = rankedEvidence weights items} × List Nat) :=\\n  let previous := replayIndexed source positions\\n  if size : previous.length = source.count then\\n    have original : previous.Perm items.zipIdx := by\\n      have complete : (replay items positions).length = items.length := by\\n        simpa only [previous, replayIndexed_reference, source.countExact] using size\\n      simpa only [previous, replayIndexed_reference] using replay_perm items positions complete\\n    let prepared := previous.map (Keyed.make weights weights.toArray rfl)\\n    have preparedExact : prepared.map (·.original) = previous := by\\n      simp only [prepared, List.map_map, Function.comp_def, Keyed.make]\\n      exact List.map_id previous\\n    if sorted : chain Keyed.order prepared = true then\\n      some (⟨previous.map Prod.fst, sorted_exact weights items previous original\\n        (by simpa only [preparedExact] using Keyed.chain_sorted prepared sorted)⟩,\\n        previous.map Prod.snd)\\n    else\\n      let parts := runs Keyed.order prepared\\n      let ranked := mergeRuns Keyed.order parts.length parts\\n      let ordinals := ranked.map (·.original)\\n      if sorted : chain Keyed.order ranked = true then\\n        some (⟨ordinals.map Prod.fst, sorted_exact weights items ordinals\\n          (by\\n            have retained := (mergeRuns_perm Keyed.order parts.length parts).map Keyed.original\\n            simp only [parts, runs_flatten, preparedExact] at retained\\n            exact retained.trans original)\\n          (Keyed.chain_sorted ranked sorted)⟩,\\n          ordinals.map Prod.snd)\\n      else none\\n  else none\\n\\ndef positions (weights : List Nat) (items : List Evidence) : List Nat :=\\n  ((items.zipIdx.toArray.mergeSort (stableOrder weights)).toList).map Prod.snd\\n\\ntheorem generated_exact (weights : List Nat) (items : List Evidence) :\\n    ((items.zipIdx.toArray.mergeSort (stableOrder weights)).toList).map Prod.fst =\\n      rankedEvidence weights items := by\\n  simp only [Array.toList_mergeSort]\\n  change (items.zipIdx.mergeSort (List.zipIdxLE (order weights.toArray))).map (·.1) = _\\n  rw [List.mergeSort_zipIdx]\\n  simp only [rankedEvidence, Array.toList_mergeSort]\\n  congr 1\\n  funext a b\\n  exact order_reference _ a b\\n\\n/-- Sort once on a miss. The result and replay positions share this ordered\\nlist; no verification sort or second sorting pass is performed. -/\\ndef generate (weights : List Nat) (items : List Evidence) :\\n    {ranked : List Evidence // ranked = rankedEvidence weights items} × List Nat :=\\n  let indexed := (items.zipIdx.toArray.mergeSort (stableOrder weights)).toList\\n  (⟨indexed.map Prod.fst, generated_exact weights items⟩, indexed.map Prod.snd)\\n\\nend Eggshell.Matcher.EvidenceReplay\\n\",[]]"],["Eggshell.Extract","[\"module\\n\\npublic import Eggshell.Graph\\n\\n@[expose] public section\\n\\nnamespace Eggshell\\n\\n/-- A finite executable equality together with the laws the kernel relies on. -/\\nstructure Equality where\\n  same : Value → Value → Bool\\n  reflexive : ∀ value, same value value\\n  symmetric : ∀ {left right}, same left right → same right left\\n  transitive : ∀ {left middle right}, same left middle → same middle right →\\n    same left right\\n  preservesExact : ∀ {left right}, same left right →\\n    Value.SameExactFootprint left right\\n\\nnamespace Equality\\n\\ndef exact : Equality where\\n  same left right := decide (left = right)\\n  reflexive value := by simp\\n  symmetric := by simp_all\\n  transitive := by simp_all\\n  preservesExact := by\\n    intro left right same\\n    simp only [decide_eq_true_eq] at same\\n    subst right\\n    exact Value.sameExactFootprint_refl left\\n\\n@[simp]\\ntheorem exact_same_iff {left right} : exact.same left right ↔ left = right := by\\n  simp [exact]\\n\\nend Equality\\n\\n/-- The two positive relations evaluated by the kernel. -/\\nstructure WorkGraph where\\n  all : List AllEdge := []\\n  outcomes : List OutcomeEdge := []\\n  deriving DecidableEq\\n\\nnamespace WorkGraph\\n\\n/-- Stable quotient deduplication. Equality, not insertion identity, owns the lane. -/\\ndef distinct (equality : Equality) : List Value → List Value\\n  | values => (values.foldl (fun kept value =>\\n      if kept.any (equality.same value) then kept else value :: kept) []).reverse\\n\\ndef fromValues (values : List Value) : WorkGraph where\\n  all := values.filterMap AllEdge.fromValue?\\n  outcomes := values.filterMap OutcomeEdge.fromValue?\\n\\ndef outcomesFor (graph : WorkGraph) (equality : Equality) (work : Value) :\\n    List OutcomeEdge :=\\n  graph.outcomes.filter fun edge => equality.same edge.work work\\n\\ndef decompositionsFor (graph : WorkGraph) (equality : Equality) (parent : Value) :\\n    List AllEdge :=\\n  graph.all.filter fun edge => equality.same edge.parent parent\\n\\n/-- An `All` edge is an AND-set over e-classes, not a bag of spellings. -/\\ndef childrenFor (_graph : WorkGraph) (equality : Equality) (edge : AllEdge) :\\n    List Value :=\\n  distinct equality edge.children\\n\\n/--\\nWork is reusable completion only when it occupies a child position in the\\npositive graph. A root Outcome is useful history, but cannot erase a smaller\\noperation merely because its prose mentions the same words.\\n-/\\ndef subworks (graph : WorkGraph) : List Value :=\\n  graph.all.flatMap (·.children) |>.eraseDups\\n\\ndef isSubwork (graph : WorkGraph) (equality : Equality) (work : Value) : Bool :=\\n  graph.subworks.any (equality.same work)\\n\\nend WorkGraph\\n\\n/-\\nAn open handoff is ordinary natural-language data.  The shared constructor only\\nprevents the turn compiler and matcher from inventing two spellings for the same\\ncontinuation, and lets saturation leave an internal remainder open until that\\nremainder itself becomes the external Demand.\\n-/\\nnamespace HandoffRemainder\\n\\ndef identityPrefix : String :=\\n  \\\"Use the selected prior WORK→OUTCOME graph as completed or advisory history. \\\"\\n\\ndef marker : String :=\\n  identityPrefix ++ \\\"Do not repeat prior work merely to verify it or because evidence is missing. \\\" ++\\n  \\\"Do not reread evidence for line numbers or citation formatting; cite the \\\" ++\\n  \\\"recorded source without line numbers when they are unavailable. \\\" ++\\n  \\\"Missing from this graph is not unavailable evidence. Inspect the smallest \\\" ++\\n  \\\"accessible source for an unsupported requirement; distinguish unknown \\\" ++\\n  \\\"external state from rules that available code or documentation can establish. \\\" ++\\n  \\\"Do not declare exhaustion solely from a missing excerpt or runtime test. \\\" ++\\n  \\\"Use the smallest useful check for uncovered work. If relevant local and available \\\" ++\\n  \\\"MCP sources are exhausted, report supported facts and missing evidence, mark the \\\" ++\\n  \\\"conclusion UNRESOLVED, and stop. Resume only after new evidence, changed inputs \\\" ++\\n  \\\"or access, or a concrete contradiction. Current uncovered request: \\\"\\n\\ndef text (work : String) : String := marker ++ work\\n\\ndef value (work : String) : Value := .text (text work)\\n\\ndef isValue : Value → Bool\\n  | .atom bytes =>\\n      match String.fromUTF8? bytes with\\n      | some content => content.startsWith identityPrefix\\n      | none => false\\n  | .apply _ _ => false\\n\\nend HandoffRemainder\\n\\n/-- Runtime delivery judgment; it is never persisted as graph authority. -/\\ninductive Applicability where\\n  | completed\\n  | advisory\\n  | irrelevant\\n  deriving Repr, DecidableEq, BEq\\n\\ninductive CoverageDirection where\\n  | pastWorkInsideCurrentDemand\\n  | currentDemandInsidePastWork\\n  | overlapping\\n  | ambiguous\\n  deriving Repr, DecidableEq, BEq\\n\\n/--\\nThe matcher may be permissive. Only forward containment plus a reusable\\noutcome may erase small work; every other match remains visible advice.\\n-/\\nstructure ApplicabilityJudgment where\\n  direction : CoverageDirection\\n  /-- Structural eligibility for completion under the matcher policy. This is\\n  not a proof that the observed result or an answer is semantically correct,\\n  and does not establish source freshness; delivery checks that IO boundary. -/\\n  reusableOutcome : Bool\\n\\nnamespace ApplicabilityJudgment\\n\\ndef delivery (judgment : ApplicabilityJudgment) : Applicability :=\\n  if decide (judgment.direction = .pastWorkInsideCurrentDemand) &&\\n      judgment.reusableOutcome then\\n    .completed\\n  else\\n    .advisory\\n\\ntheorem completed_only_for_forward_reusable {judgment : ApplicabilityJudgment}\\n    (completed : judgment.delivery = .completed) :\\n    judgment.direction = .pastWorkInsideCurrentDemand ∧\\n      judgment.reusableOutcome = true := by\\n  simp only [delivery] at completed\\n  split at completed\\n  · rename_i accepted\\n    simp only [Bool.and_eq_true, decide_eq_true_eq] at accepted\\n    exact accepted\\n  · contradiction\\n\\nend ApplicabilityJudgment\\n\\nstructure OutcomeAdmission where\\n  demand : Value\\n  relation : Value\\n  judgment : ApplicabilityJudgment\\n\\nstructure OutcomePolicy where\\n  classify : Value → OutcomeEdge → Applicability\\n\\nnamespace OutcomePolicy\\n\\ndef allCompleted : OutcomePolicy where\\n  classify _ _ := .completed\\n\\ndef admitted (admissions : List OutcomeAdmission) : OutcomePolicy where\\n  classify demand edge :=\\n    match admissions.find? (fun admission =>\\n        admission.demand == demand && admission.relation == edge.relation) with\\n    | some admission => admission.judgment.delivery\\n    | none => .irrelevant\\n\\ntheorem admitted_delivery_witness {admissions demand edge delivery}\\n    (classified : (admitted admissions).classify demand edge = delivery)\\n    (visible : delivery ≠ .irrelevant) :\\n    ∃ admission ∈ admissions,\\n      admission.demand = demand ∧ admission.relation = edge.relation ∧\\n        admission.judgment.delivery = delivery := by\\n  change (match admissions.find? (fun admission =>\\n      admission.demand == demand && admission.relation == edge.relation) with\\n    | some admission => admission.judgment.delivery\\n    | none => .irrelevant) = delivery at classified\\n  cases found : admissions.find? (fun admission =>\\n      admission.demand == demand && admission.relation == edge.relation) with\\n  | none =>\\n      simp only [found] at classified\\n      exact (visible classified.symm).elim\\n  | some admission =>\\n      have member := List.mem_of_find?_eq_some found\\n      have accepted := List.find?_some found\\n      simp only [Bool.and_eq_true, beq_iff_eq] at accepted\\n      simp only [found] at classified\\n      exact ⟨admission, member, accepted.1, accepted.2, classified⟩\\n\\nend OutcomePolicy\\n\\ninductive Selection where\\n  | residual (work : Value) (advisory : List OutcomeEdge)\\n  | outcomes (work : Value) (completed advisory : List OutcomeEdge)\\n  | decomposed (work : Value) (edge : AllEdge) (completed advisory : List OutcomeEdge)\\n      (children : List Selection)\\n  | handoff (work : Value) (prior : Selection)\\n\\nnamespace Selection\\n\\ndef outcomeUses : Selection → List (Applicability × Value × OutcomeEdge)\\n  | .residual work advisory =>\\n      advisory.map fun edge => (.advisory, work, edge)\\n  | .outcomes work completed advisory =>\\n      completed.map (fun edge => (.completed, work, edge)) ++\\n        advisory.map fun edge => (.advisory, work, edge)\\n  | .decomposed work _ completed advisory children =>\\n      completed.map (fun edge => (.completed, work, edge)) ++\\n        advisory.map (fun edge => (.advisory, work, edge)) ++\\n        children.flatMap outcomeUses\\n  | .handoff _ prior => prior.outcomeUses\\n\\ndef usesFor (delivery : Applicability) (selection : Selection) :\\n    List (Value × OutcomeEdge) :=\\n  selection.outcomeUses.filterMap fun use =>\\n    if use.1 == delivery then some (use.2.1, use.2.2) else none\\n\\ndef completedUses (selection : Selection) : List (Value × OutcomeEdge) :=\\n  usesFor .completed selection\\n\\ndef advisoryUses (selection : Selection) : List (Value × OutcomeEdge) :=\\n  usesFor .advisory selection\\n\\ndef priorOutcomes (selection : Selection) : List Value :=\\n  selection.completedUses.map (fun use => use.2.outcome)\\n\\ndef completedEdges (selection : Selection) : List OutcomeEdge :=\\n  selection.completedUses.map Prod.snd\\n\\ndef advisoryOutcomes (selection : Selection) : List Value :=\\n  selection.advisoryUses.map (fun use => use.2.outcome)\\n\\ndef advisoryEdges (selection : Selection) : List OutcomeEdge :=\\n  selection.advisoryUses.map Prod.snd\\n\\ndef openWork : Selection → List Value\\n  | .residual work _ => [work]\\n  | .outcomes _ _ _ => []\\n  | .decomposed _ _ _ _ children => children.flatMap openWork\\n  | .handoff work _ => [work]\\n\\n/-- Every selected Work node before quotient sharing is applied. -/\\ndef workValues : Selection → List Value\\n  | .residual work _ | .outcomes work _ _ => [work]\\n  | .decomposed work _ _ _ children => work :: children.flatMap workValues\\n  | .handoff work prior => work :: prior.workValues\\n\\ndef decompositionEdges : Selection → List AllEdge\\n  | .residual _ _ | .outcomes _ _ _ => []\\n  | .decomposed _ edge _ _ children =>\\n      edge :: children.flatMap decompositionEdges\\n  | .handoff _ prior => prior.decompositionEdges\\n\\n/-- The relation closure is derived from the two structural projections, never re-walked. -/\\ndef relationValues (selection : Selection) : List Value :=\\n  selection.decompositionEdges.map (·.relation) ++\\n    selection.outcomeUses.map (·.2.2.relation)\\n\\n/-- Every Outcome selected for either delivery class remains in the structural handoff. -/\\ntheorem outcomeUse_relation_mem {selection : Selection} {delivery : Applicability}\\n    {demand : Value} {edge : OutcomeEdge}\\n    (used : (delivery, demand, edge) ∈ selection.outcomeUses) :\\n    edge.relation ∈ selection.relationValues := by\\n  apply List.mem_append_right\\n  exact List.mem_map.mpr ⟨(delivery, demand, edge), used, rfl⟩\\n\\ntheorem completedEdge_relation_mem {selection : Selection} {edge : OutcomeEdge}\\n    (used : edge ∈ selection.completedEdges) :\\n    edge.relation ∈ selection.relationValues := by\\n  simp only [completedEdges, List.mem_map] at used\\n  obtain ⟨entry, entryUsed, rfl⟩ := used\\n  simp only [completedUses, usesFor, List.mem_filterMap] at entryUsed\\n  obtain ⟨use, useUsed, accepted⟩ := entryUsed\\n  split at accepted\\n  · simp only [Option.some.injEq] at accepted\\n    subst entry\\n    exact outcomeUse_relation_mem useUsed\\n  · contradiction\\n\\ntheorem advisoryEdge_relation_mem {selection : Selection} {edge : OutcomeEdge}\\n    (used : edge ∈ selection.advisoryEdges) :\\n    edge.relation ∈ selection.relationValues := by\\n  simp only [advisoryEdges, List.mem_map] at used\\n  obtain ⟨entry, entryUsed, rfl⟩ := used\\n  simp only [advisoryUses, usesFor, List.mem_filterMap] at entryUsed\\n  obtain ⟨use, useUsed, accepted⟩ := entryUsed\\n  split at accepted\\n  · simp only [Option.some.injEq] at accepted\\n    subst entry\\n    exact outcomeUse_relation_mem useUsed\\n  · contradiction\\n\\n/-- Completed Work is removed only while its Outcome remains in the handoff. -/\\ntheorem completedUse_outcome_is_prior {selection : Selection} {demand : Value}\\n    {edge : OutcomeEdge}\\n    (used : (demand, edge) ∈ selection.completedUses) :\\n    edge.outcome ∈ selection.priorOutcomes := by\\n  exact List.mem_map.mpr ⟨(demand, edge), used, rfl⟩\\n\\ndef containsOutcome (graph : WorkGraph) (edge : OutcomeEdge) : Bool :=\\n  graph.outcomes.any (fun stored => stored.relation == edge.relation)\\n\\ndef containsAll (graph : WorkGraph) (edge : AllEdge) : Bool :=\\n  graph.all.any (fun stored => stored.relation == edge.relation)\\n\\nmutual\\n\\n/--\\nAn executable proof boundary for Extract.  It checks graph provenance,\\nclassification, and the exact child order of every selected decomposition.\\nInvalid solver output degrades to one open residual instead of escaping.\\n-/\\ndef structurallyValidAt (graph : WorkGraph) (equality : Equality) :\\n    Value → Selection → Bool\\n  | work, .residual selected _ | work, .outcomes selected _ _ =>\\n      selected == work\\n  | work, .decomposed selected edge _ _ children =>\\n      selected == work && equality.same edge.parent work &&\\n        structurallyValidChildren graph equality\\n          (graph.childrenFor equality edge) children\\n  | work, .handoff selected prior =>\\n      selected == work && structurallyValidAt graph equality work prior\\n\\ndef structurallyValidChildren (graph : WorkGraph) (equality : Equality) :\\n    List Value → List Selection → Bool\\n  | work :: works, child :: children =>\\n      structurallyValidAt graph equality work child &&\\n        structurallyValidChildren graph equality works children\\n  | [], [] => true\\n  | _, _ => false\\n\\nend\\n\\nmutual\\n\\ntheorem structurallyValidAt_same_topology (selection : Selection)\\n    (left right : WorkGraph) (equality : Equality) (work : Value) :\\n    selection.structurallyValidAt left equality work =\\n      selection.structurallyValidAt right equality work := by\\n  cases selection with\\n  | residual _ _ | outcomes _ _ _ => rfl\\n  | handoff _ prior =>\\n      simp only [structurallyValidAt,\\n        structurallyValidAt_same_topology prior left right equality work]\\n  | decomposed _ edge _ _ children =>\\n      simp only [structurallyValidAt, WorkGraph.childrenFor,\\n        structurallyValidChildren_same_topology children left right equality]\\n\\ntheorem structurallyValidChildren_same_topology (children : List Selection)\\n    (left right : WorkGraph) (equality : Equality) (works : List Value) :\\n    structurallyValidChildren left equality works children =\\n      structurallyValidChildren right equality works children := by\\n  cases children with\\n  | nil => cases works <;> rfl\\n  | cons child tail =>\\n      cases works with\\n      | nil => rfl\\n      | cons work rest =>\\n          simp only [structurallyValidChildren,\\n            structurallyValidAt_same_topology child left right equality work,\\n            structurallyValidChildren_same_topology tail left right equality rest]\\n\\nend\\n\\ndef validFor (graph : WorkGraph) (equality : Equality)\\n    (policy : OutcomePolicy) (work : Value) (selection : Selection) : Bool :=\\n  (selection.structurallyValidAt graph equality work &&\\n    selection.decompositionEdges.all (containsAll graph)) &&\\n    (selection.completedUses.all fun use =>\\n      containsOutcome graph use.2 && equality.same use.2.work use.1 &&\\n        decide (policy.classify use.1 use.2 = .completed)) &&\\n    (selection.advisoryUses.all fun use =>\\n      containsOutcome graph use.2 && equality.same use.2.work use.1 &&\\n        decide (policy.classify use.1 use.2 = .advisory))\\n\\n/-- Exact graph membership of every selected edge, including all descendants.\\nThis is independent of the policy and the executable rejection gate. -/\\nstructure Provenance (graph : WorkGraph) (selection : Selection) : Prop where\\n  decompositions : ∀ edge ∈ selection.decompositionEdges, edge ∈ graph.all\\n  outcomes : ∀ use ∈ selection.outcomeUses, use.2.2 ∈ graph.outcomes\\n\\ntheorem Provenance.residual (graph : WorkGraph) (work : Value) (advisory : List OutcomeEdge)\\n    (present : ∀ edge ∈ advisory, edge ∈ graph.outcomes) :\\n    Provenance graph (.residual work advisory) := by\\n  constructor\\n  · simp [decompositionEdges]\\n  · intro use member\\n    simp only [outcomeUses, List.mem_map] at member\\n    obtain ⟨edge, member, rfl⟩ := member\\n    exact present edge member\\n\\ntheorem Provenance.completed (graph : WorkGraph) (work : Value)\\n    (completed advisory : List OutcomeEdge)\\n    (first : ∀ edge ∈ completed, edge ∈ graph.outcomes)\\n    (second : ∀ edge ∈ advisory, edge ∈ graph.outcomes) :\\n    Provenance graph (.outcomes work completed advisory) := by\\n  constructor\\n  · simp [decompositionEdges]\\n  · intro use member\\n    simp only [outcomeUses, List.mem_append, List.mem_map] at member\\n    rcases member with ⟨edge, member, rfl⟩ | ⟨edge, member, rfl⟩\\n    · exact first edge member\\n    · exact second edge member\\n\\ntheorem Provenance.decomposed (graph : WorkGraph) (work : Value) (edge : AllEdge)\\n    (completed advisory : List OutcomeEdge) (children : List Selection)\\n    (parent : edge ∈ graph.all)\\n    (first : ∀ owner ∈ completed, owner ∈ graph.outcomes)\\n    (second : ∀ owner ∈ advisory, owner ∈ graph.outcomes)\\n    (descendants : ∀ child ∈ children, Provenance graph child) :\\n    Provenance graph (.decomposed work edge completed advisory children) := by\\n  constructor\\n  · intro chosen member\\n    simp only [decompositionEdges, List.mem_cons, List.mem_flatMap] at member\\n    rcases member with rfl | ⟨child, member, used⟩\\n    · exact parent\\n    · exact (descendants child member).decompositions chosen used\\n  · intro use member\\n    simp only [outcomeUses, List.mem_append, List.mem_map, List.mem_flatMap] at member\\n    rcases member with (⟨owner, member, rfl⟩ | ⟨owner, member, rfl⟩) | ⟨child, member, used⟩\\n    · exact first owner member\\n    · exact second owner member\\n    · exact (descendants child member).outcomes use used\\n\\ntheorem Provenance.used_owner (known : Provenance graph selection)\\n    (delivery : Applicability) (use : Value × OutcomeEdge)\\n    (member : use ∈ selection.usesFor delivery) : use.2 ∈ graph.outcomes := by\\n  simp only [usesFor, List.mem_filterMap] at member\\n  obtain ⟨entry, member, chosen⟩ := member\\n  split at chosen\\n  · simp only [Option.some.injEq] at chosen\\n    subst use\\n    exact known.outcomes entry member\\n  · contradiction\\n\\n/-- The real final provenance checker agrees after demand pruning, not just\\nthe recursive solver. Both graphs must contain the actually selected edges;\\npolicy and structural checks are retained verbatim. -/\\ntheorem validFor_provenance_congr (selected : Selection) (left right : WorkGraph)\\n    (equality : Equality) (policy : OutcomePolicy) (root : Value)\\n    (first : Provenance left selected) (second : Provenance right selected) :\\n    selected.validFor left equality policy root = selected.validFor right equality policy root := by\\n  have allPresent (graph : WorkGraph) (known : Provenance graph selected) :\\n      selected.decompositionEdges.all (containsAll graph) = true := by\\n    apply List.all_eq_true.mpr\\n    intro edge member\\n    apply List.any_eq_true.mpr\\n    exact ⟨edge, known.decompositions edge member, by simp⟩\\n  have uses (delivery : Applicability) :\\n      (selected.usesFor delivery).all (fun use =>\\n        containsOutcome left use.2 && equality.same use.2.work use.1 &&\\n          decide (policy.classify use.1 use.2 = delivery)) =\\n      (selected.usesFor delivery).all (fun use =>\\n        containsOutcome right use.2 && equality.same use.2.work use.1 &&\\n          decide (policy.classify use.1 use.2 = delivery)) := by\\n    apply Bool.eq_iff_iff.mpr\\n    simp only [List.all_eq_true]\\n    apply forall_congr'\\n    intro use\\n    apply forall_congr'\\n    intro member\\n    have present (graph : WorkGraph) (known : Provenance graph selected) :\\n        containsOutcome graph use.2 = true :=\\n      List.any_eq_true.mpr ⟨use.2, known.used_owner delivery use member, by simp⟩\\n    rw [present left first, present right second]\\n  simp only [validFor, completedUses, advisoryUses, allPresent left first,\\n    allPresent right second, uses, structurallyValidAt_same_topology selected left right equality root]\\n\\n/-- Keeping every relation which can be admitted preserves the real\\nprovenance checker, not merely the solver's list of selected ids. The keep\\npredicate is over the entire relation, including Exact evidence positions. -/\\ntheorem validFor_selected (graph : WorkGraph) (keep : Value → Bool)\\n    (policy : OutcomePolicy) (equality : Equality) (root : Value) (selected : Selection)\\n    (complete : ∀ work edge, policy.classify work edge ≠ .irrelevant →\\n      keep edge.relation = true) :\\n    selected.validFor { graph with outcomes := graph.outcomes.filter (fun edge => keep edge.relation) }\\n      equality policy root = selected.validFor graph equality policy root := by\\n  let smaller : WorkGraph := { graph with outcomes := graph.outcomes.filter (fun edge => keep edge.relation) }\\n  have contained (edge : OutcomeEdge) (kept : keep edge.relation = true) :\\n      containsOutcome smaller edge = containsOutcome graph edge := by\\n    simp only [containsOutcome, smaller, List.any_filter]\\n    apply List.any_congr rfl\\n    intro stored\\n    cases same : stored.relation == edge.relation with\\n    | false => simp\\n    | true =>\\n        have equal := beq_iff_eq.mp same\\n        simp [equal, kept]\\n  have uses (items : List (Value × OutcomeEdge)) (delivery : Applicability)\\n      (visible : delivery ≠ .irrelevant) :\\n      (items.all fun use => containsOutcome smaller use.2 &&\\n        equality.same use.2.work use.1 && decide (policy.classify use.1 use.2 = delivery)) =\\n      (items.all fun use => containsOutcome graph use.2 &&\\n        equality.same use.2.work use.1 && decide (policy.classify use.1 use.2 = delivery)) := by\\n    apply congrArg (fun predicate => items.all predicate)\\n    funext use\\n    by_cases classified : policy.classify use.1 use.2 = delivery\\n    · rw [contained use.2 (complete use.1 use.2 (by simpa [classified] using visible))]\\n    · simp [classified]\\n  change selected.validFor smaller equality policy root = _\\n  simp only [validFor, structurallyValidAt_same_topology selected smaller graph equality root,\\n    uses selected.completedUses .completed (by decide),\\n    uses selected.advisoryUses .advisory (by decide)]\\n  rfl\\n\\ntheorem completedUse_sound {graph equality policy work selection demand edge}\\n    (valid : validFor graph equality policy work selection)\\n    (used : (demand, edge) ∈ selection.completedUses) :\\n    containsOutcome graph edge = true ∧ equality.same edge.work demand = true ∧\\n      policy.classify demand edge = .completed := by\\n  simp only [validFor, Bool.and_eq_true, List.all_eq_true] at valid\\n  obtain ⟨⟨present, same⟩, classified⟩ := valid.1.2 (demand, edge) used\\n  exact ⟨present, same, of_decide_eq_true classified⟩\\n\\ntheorem advisoryUse_sound {graph equality policy work selection demand edge}\\n    (valid : validFor graph equality policy work selection)\\n    (used : (demand, edge) ∈ selection.advisoryUses) :\\n    containsOutcome graph edge = true ∧ equality.same edge.work demand = true ∧\\n      policy.classify demand edge = .advisory := by\\n  simp only [validFor, Bool.and_eq_true, List.all_eq_true] at valid\\n  obtain ⟨⟨present, same⟩, classified⟩ := valid.2 (demand, edge) used\\n  exact ⟨present, same, of_decide_eq_true classified⟩\\n\\ntheorem decompositionEdge_sound {graph equality policy work selection edge}\\n    (valid : validFor graph equality policy work selection)\\n    (used : edge ∈ selection.decompositionEdges) :\\n    containsAll graph edge = true := by\\n  simp only [validFor, Bool.and_eq_true, List.all_eq_true] at valid\\n  exact valid.1.1.2 edge used\\n\\ntheorem residual_valid (graph equality policy work) :\\n    validFor graph equality policy work (.residual work []) := by\\n  simp [validFor, structurallyValidAt, decompositionEdges,\\n    completedUses, advisoryUses, usesFor, outcomeUses]\\n\\ntheorem handoff_valid {graph equality policy work selection}\\n    (valid : validFor graph equality policy work selection) :\\n    validFor graph equality policy work (.handoff work selection) := by\\n  simpa [validFor, structurallyValidAt, decompositionEdges,\\n    completedUses, advisoryUses, usesFor, outcomeUses]\\n    using valid\\n\\nend Selection\\n\\nstructure Extraction where\\n  priorOutcomes : List Value\\n  advisoryOutcomes : List Value\\n  residual : List Value\\n  /-- Open semantic leaves before they are collapsed into one external handoff. -/\\n  discovery : List Value\\n  support : List Value\\n  selection : Selection\\n  prior_visible : ∀ outcome, outcome ∈ selection.priorOutcomes →\\n    outcome ∈ priorOutcomes\\n  one_open_handoff : ∃ work, residual = [work]\\n\\nnamespace Extraction\\n\\ndef finalize (root : Value) (selection : Selection) : Selection :=\\n  match selection.openWork with\\n  | [_] => selection\\n  | _ => .handoff root selection\\n\\ntheorem finalize_valid {graph equality policy root selection}\\n    (valid : selection.validFor graph equality policy root) :\\n    (finalize root selection).validFor graph equality policy root := by\\n  unfold finalize\\n  cases selection.openWork with\\n  | nil => exact Selection.handoff_valid valid\\n  | cons head tail =>\\n      cases tail with\\n      | nil => exact valid\\n      | cons next rest => exact Selection.handoff_valid valid\\n\\ndef fromSelection (root : Value) (selection : Selection) : Extraction :=\\n  let pending := selection.openWork\\n  let finalSelection := finalize root selection\\n  {\\n    priorOutcomes := finalSelection.priorOutcomes.eraseDups\\n    advisoryOutcomes := finalSelection.advisoryOutcomes.eraseDups\\n    residual := finalSelection.openWork\\n    discovery := if pending.isEmpty then [root] else pending.eraseDups\\n    support := finalSelection.relationValues.eraseDups\\n    selection := finalSelection\\n    prior_visible := fun _ member => List.mem_eraseDups.mpr member\\n    one_open_handoff := by\\n      cases pendingEq : selection.openWork with\\n      | nil =>\\n          exact ⟨root, by simp [finalSelection, finalize, pendingEq, Selection.openWork]⟩\\n      | cons head tail =>\\n          cases tail with\\n          | nil => exact ⟨head, by simp [finalSelection, finalize, pendingEq]⟩\\n          | cons next rest =>\\n              exact ⟨root, by simp [finalSelection, finalize, pendingEq, Selection.openWork]⟩\\n  }\\n\\ntheorem residual_nonempty (extraction : Extraction) : extraction.residual ≠ [] := by\\n  rcases extraction.one_open_handoff with ⟨work, equals⟩\\n  simp [equals]\\n\\ntheorem residual_length (extraction : Extraction) : extraction.residual.length = 1 := by\\n  rcases extraction.one_open_handoff with ⟨work, equals⟩\\n  simp [equals]\\n\\ntheorem fromSelection_valid {graph equality policy root selection}\\n    (valid : selection.validFor graph equality policy root) :\\n    (fromSelection root selection).selection.validFor graph equality policy root := by\\n  change (finalize root selection).validFor graph equality policy root\\n  exact finalize_valid valid\\n\\nend Extraction\\n\\nnamespace Extract\\n\\n/-- Open Work dominates; equal frontiers choose the smaller transport surface. -/\\nstructure Cost where\\n  openCount : Nat\\n  byteCount : Nat\\n  nodeCount : Nat\\n  deriving Repr, DecidableEq\\n\\nnamespace Cost\\n\\ndef LE (left right : Cost) : Prop :=\\n  left.openCount < right.openCount ∨\\n    left.openCount = right.openCount ∧\\n      (left.byteCount < right.byteCount ∨\\n        left.byteCount = right.byteCount ∧ left.nodeCount ≤ right.nodeCount)\\n\\ninstance : DecidableRel LE := fun _ _ => by\\n  unfold LE\\n  infer_instance\\n\\ntheorem le_refl (cost : Cost) : cost.LE cost := by\\n  simp [LE]\\n\\ntheorem le_total (left right : Cost) : left.LE right ∨ right.LE left := by\\n  unfold LE\\n  omega\\n\\ntheorem le_trans {left middle right : Cost}\\n    (leftMiddle : left.LE middle) (middleRight : middle.LE right) :\\n    left.LE right := by\\n  unfold LE at *\\n  omega\\n\\nend Cost\\n\\nstructure Solution where\\n  selection : Selection\\n\\nnamespace Solution\\n\\ndef residual (work : Value) (advisory : List OutcomeEdge := []) : Solution :=\\n  ⟨.residual work advisory⟩\\n\\ndef outcomes (work : Value) (completed advisory : List OutcomeEdge) : Solution :=\\n  ⟨.outcomes work completed advisory⟩\\n\\ndef cost (solution : Solution) : Cost :=\\n  let graph := solution.selection.workValues ++ solution.selection.relationValues\\n  {\\n    openCount := solution.selection.openWork.length\\n    byteCount := graph.foldl (fun total value => total + value.structuralSize) 0\\n    nodeCount := graph.length\\n  }\\n\\ndef combine (work : Value) (edge : AllEdge) (completed advisory : List OutcomeEdge)\\n    (children : List Solution) : Solution :=\\n  ⟨.decomposed work edge completed advisory\\n    (children.map (fun child => child.selection))⟩\\n\\nend Solution\\n\\ndef chooseBetter (left right : Solution) : Solution :=\\n  if left.cost.LE right.cost then left else right\\n\\ntheorem chooseBetter_le_left (left right : Solution) :\\n    (chooseBetter left right).cost.LE left.cost := by\\n  unfold chooseBetter\\n  split\\n  · exact Cost.le_refl _\\n  · rename_i notLeft\\n    exact (Cost.le_total left.cost right.cost).resolve_left notLeft\\n\\ntheorem chooseBetter_le_right (left right : Solution) :\\n    (chooseBetter left right).cost.LE right.cost := by\\n  unfold chooseBetter\\n  split\\n  · assumption\\n  · exact Cost.le_refl _\\n\\ndef chooseBest : List Solution → Option Solution\\n  | [] => none\\n  | head :: tail =>\\n      match chooseBest tail with\\n      | none => some head\\n      | some best => some (chooseBetter head best)\\n\\n@[simp]\\ntheorem chooseBest_eq_none_iff (solutions : List Solution) :\\n    chooseBest solutions = none ↔ solutions = [] := by\\n  cases solutions with\\n  | nil => simp [chooseBest]\\n  | cons head tail =>\\n      simp only [chooseBest]\\n      cases chooseBest tail <;> simp\\n\\ntheorem chooseBest_mem {solutions : List Solution} {best : Solution}\\n    (found : chooseBest solutions = some best) : best ∈ solutions := by\\n  induction solutions generalizing best with\\n  | nil => simp [chooseBest] at found\\n  | cons head tail ih =>\\n      simp only [chooseBest] at found\\n      cases chosen : chooseBest tail with\\n      | none =>\\n          rw [chosen] at found\\n          injection found with equal\\n          subst best\\n          exact List.mem_cons_self\\n      | some later =>\\n          rw [chosen] at found\\n          injection found with equal\\n          subst best\\n          unfold chooseBetter\\n          split\\n          · exact List.mem_cons_self\\n          · exact List.mem_cons_of_mem head (ih chosen)\\n\\n/-- The chosen explanation is minimum among the supplied candidate derivations. -/\\ntheorem chooseBest_minimal {solutions : List Solution} {best candidate : Solution}\\n    (found : chooseBest solutions = some best)\\n    (present : candidate ∈ solutions) :\\n    best.cost.LE candidate.cost := by\\n  induction solutions generalizing best candidate with\\n  | nil => simp at present\\n  | cons head tail induction =>\\n      simp only [chooseBest] at found\\n      cases tailFound : chooseBest tail with\\n      | none =>\\n          rw [tailFound] at found\\n          have empty : tail = [] := (chooseBest_eq_none_iff tail).mp tailFound\\n          subst tail\\n          simp only [List.mem_singleton] at present\\n          subst candidate\\n          injection found with found\\n          subst best\\n          exact Cost.le_refl _\\n      | some tailBest =>\\n          rw [tailFound] at found\\n          injection found with found\\n          subst best\\n          cases present with\\n          | head => exact chooseBetter_le_left head tailBest\\n          | tail _ inTail =>\\n              exact Cost.le_trans (chooseBetter_le_right head tailBest)\\n                (induction tailFound inTail)\\n\\n/--\\nFuel is a totality witness only. Cycles are cut by `active`; quotient-equivalent\\nchildren are visited once before the existing recursive extractor is reused.\\n-/\\ndef solve (graph : WorkGraph) (equality : Equality) (policy : OutcomePolicy) :\\n    Nat → List Value → Value → Option Solution\\n  | 0, _, work => some (Solution.residual work)\\n  | fuel + 1, active, work =>\\n      if active.contains work then none\\n      else\\n        let outcomes := graph.outcomesFor equality work\\n        let completed := outcomes.filter fun edge => policy.classify work edge == .completed\\n        let advisory := outcomes.filter fun edge => policy.classify work edge == .advisory\\n        let candidates := (graph.decompositionsFor equality work).filterMap fun edge =>\\n          ((graph.childrenFor equality edge).mapM\\n            (solve graph equality policy fuel (work :: active))).map\\n            (Solution.combine work edge completed advisory)\\n        match chooseBest candidates with\\n        | some best => some best\\n        | none =>\\n            if completed.isEmpty then some (Solution.residual work advisory)\\n            else some (Solution.outcomes work completed advisory)\\n\\nprivate theorem mapM_provenance (items : List α) (f : α → Option β) (results : List β)\\n    (found : items.mapM f = some results) (property : β → Prop)\\n    (produced : ∀ item ∈ items, ∀ result, f item = some result → property result) :\\n    ∀ result ∈ results, property result := by\\n  induction items generalizing results with\\n  | nil =>\\n      change (some [] : Option (List β)) = some results at found\\n      injection found with equal\\n      subst results\\n      simp\\n  | cons head tail ih =>\\n      cases first : f head with\\n      | none => simp [List.mapM_cons, first] at found\\n      | some value =>\\n          cases later : tail.mapM f with\\n          | none => simp [List.mapM_cons, first, later] at found\\n          | some rest =>\\n              simp [List.mapM_cons, first, later] at found\\n              subst results\\n              intro result member\\n              rcases List.mem_cons.mp member with equal | member\\n              · subst result\\n                exact produced head List.mem_cons_self value first\\n              · exact ih rest later\\n                  (fun item member => produced item (List.mem_cons_of_mem head member)) result member\\n\\n/-- Every edge returned by the real recursive solver belongs to its input\\ngraph. This includes all descendants of the chosen ordered alternative;\\nneither the later checker nor a storage-loader assertion is a premise. -/\\ntheorem solve_provenance (graph : WorkGraph) (equality : Equality) (policy : OutcomePolicy)\\n    (fuel : Nat) (active : List Value) (work : Value) (solution : Solution)\\n    (found : solve graph equality policy fuel active work = some solution) :\\n    Selection.Provenance graph solution.selection := by\\n  induction fuel generalizing active work solution with\\n  | zero =>\\n      simp only [solve, Option.some.injEq] at found\\n      subst solution\\n      exact Selection.Provenance.residual graph work [] (by simp)\\n  | succ fuel ih =>\\n      simp only [solve] at found\\n      split at found\\n      · contradiction\\n      · let completed := (graph.outcomesFor equality work).filter\\n          (fun edge => policy.classify work edge == .completed)\\n        let advisory := (graph.outcomesFor equality work).filter\\n          (fun edge => policy.classify work edge == .advisory)\\n        let candidates := (graph.decompositionsFor equality work).filterMap fun edge =>\\n          ((graph.childrenFor equality edge).mapM\\n            (solve graph equality policy fuel (work :: active))).map\\n            (Solution.combine work edge completed advisory)\\n        have owners (delivery : Applicability) :\\n            ∀ edge ∈ (graph.outcomesFor equality work).filter\\n              (fun edge => policy.classify work edge == delivery), edge ∈ graph.outcomes := by\\n          intro edge member\\n          exact (List.mem_filter.mp (List.mem_filter.mp member).1).1\\n        change (match chooseBest candidates with\\n          | some best => some best\\n          | none => if completed.isEmpty then some (Solution.residual work advisory)\\n              else some (Solution.outcomes work completed advisory)) = some solution at found\\n        cases chosen : chooseBest candidates with\\n        | none =>\\n            rw [chosen] at found\\n            change (if completed.isEmpty then some (Solution.residual work advisory)\\n              else some (Solution.outcomes work completed advisory)) = some solution at found\\n            split at found\\n            · injection found with equal\\n              subst solution\\n              exact Selection.Provenance.residual graph work advisory (owners .advisory)\\n            · injection found with equal\\n              subst solution\\n              exact Selection.Provenance.completed graph work completed advisory\\n                (owners .completed) (owners .advisory)\\n        | some best =>\\n            rw [chosen] at found\\n            injection found with equal\\n            subst solution\\n            have member := chooseBest_mem chosen\\n            simp only [candidates, List.mem_filterMap] at member\\n            obtain ⟨edge, parent, produced⟩ := member\\n            cases childrenFound : (graph.childrenFor equality edge).mapM\\n                (solve graph equality policy fuel (work :: active)) with\\n            | none => simp [childrenFound] at produced\\n            | some children =>\\n                simp only [childrenFound, Option.map_some, Option.some.injEq] at produced\\n                subst best\\n                apply Selection.Provenance.decomposed graph work edge completed advisory\\n                  (children.map (·.selection)) (List.mem_filter.mp parent).1\\n                  (owners .completed) (owners .advisory)\\n                intro child member\\n                obtain ⟨result, resultMember, rfl⟩ := List.mem_map.mp member\\n                exact mapM_provenance _ _ children childrenFound\\n                  (fun result => Selection.Provenance graph result.selection)\\n                  (fun next _ result recorded => ih (work :: active) next result recorded) result resultMember\\n\\nprivate theorem filterMap_on_domain (items : List α) (first second : α → Option β)\\n    (same : ∀ item ∈ items, first item = second item) :\\n    items.filterMap first = items.filterMap second := by\\n  induction items with\\n  | nil => rfl\\n  | cons head tail ih =>\\n      simp only [List.filterMap_cons, same head (by simp)]\\n      rw [ih (fun item member => same item (by simp [member]))]\\n\\nprivate theorem mapM_on_domain (items : List α) (first second : α → Option β)\\n    (same : ∀ item ∈ items, first item = second item) :\\n    items.mapM first = items.mapM second := by\\n  induction items with\\n  | nil => rfl\\n  | cons head tail ih =>\\n      simp only [List.mapM_cons, same head (by simp),\\n        ih (fun item member => same item (by simp [member]))]\\n\\n/-- Demand pruning preserves the actual recursive solver, including ordered\\nalternatives, cycles and open work. The domain must include every child of\\nevery reachable alternative; retaining only previously selected evidence is\\nnot sufficient. This is independent of how the storage index finds edges. -/\\ntheorem solve_demand_exact (left right : WorkGraph) (equality : Equality)\\n    (policy : OutcomePolicy) (domain : Value → Prop)\\n    (owners : ∀ work, domain work →\\n      left.outcomesFor equality work = right.outcomesFor equality work)\\n    (parents : ∀ work, domain work →\\n      left.decompositionsFor equality work = right.decompositionsFor equality work)\\n    (closed : ∀ work, domain work → ∀ edge ∈ left.decompositionsFor equality work,\\n      ∀ child ∈ left.childrenFor equality edge, domain child)\\n    (fuel : Nat) (active : List Value) (work : Value) (member : domain work) :\\n    solve left equality policy fuel active work = solve right equality policy fuel active work := by\\n  induction fuel generalizing active work with\\n  | zero => rfl\\n  | succ fuel ih =>\\n      simp only [solve]\\n      by_cases cycle : active.contains work = true\\n      · simp only [cycle, ↓reduceIte]\\n      · simp only [cycle, Bool.false_eq_true, ↓reduceIte, owners work member, parents work member]\\n        have candidates :\\n            (right.decompositionsFor equality work).filterMap (fun edge =>\\n              ((left.childrenFor equality edge).mapM (solve left equality policy fuel (work :: active))).map\\n                (Solution.combine work edge\\n                  ((right.outcomesFor equality work).filter (fun edge => policy.classify work edge == .completed))\\n                  ((right.outcomesFor equality work).filter (fun edge => policy.classify work edge == .advisory)))) =\\n            (right.decompositionsFor equality work).filterMap (fun edge =>\\n              ((right.childrenFor equality edge).mapM (solve right equality policy fuel (work :: active))).map\\n                (Solution.combine work edge\\n                  ((right.outcomesFor equality work).filter (fun edge => policy.classify work edge == .completed))\\n                  ((right.outcomesFor equality work).filter (fun edge => policy.classify work edge == .advisory)))) := by\\n          apply filterMap_on_domain\\n          intro edge edgeMember\\n          have before : edge ∈ left.decompositionsFor equality work := by\\n            rw [parents work member]\\n            exact edgeMember\\n          have sameChildren : left.childrenFor equality edge = right.childrenFor equality edge := rfl\\n          rw [sameChildren]\\n          apply congrArg (Option.map _)\\n          apply mapM_on_domain\\n          intro child childMember\\n          apply ih (work :: active) child\\n          exact closed work member edge before child childMember\\n        rw [candidates]\\n\\ndef runWithPolicyFuel (graph : WorkGraph) (equality : Equality)\\n    (policy : OutcomePolicy) (fuel : Nat) (root : Value) : Extraction :=\\n  let solution := (solve graph equality policy fuel [] root).getD (Solution.residual root)\\n  let checked := if solution.selection.validFor graph equality policy root then\\n    solution.selection else .residual root []\\n  .fromSelection root checked\\n\\n/-- Complete extraction, including the final rejection gate and all evidence\\nprojections, is equal under the same demand-domain observations. The explicit\\nreference fuel must be retained when pruning source topology or bodies. -/\\ntheorem runWithPolicyFuel_demand_exact (left right : WorkGraph) (equality : Equality)\\n    (policy : OutcomePolicy) (domain : Value → Prop)\\n    (owners : ∀ work, domain work →\\n      left.outcomesFor equality work = right.outcomesFor equality work)\\n    (parents : ∀ work, domain work →\\n      left.decompositionsFor equality work = right.decompositionsFor equality work)\\n    (closed : ∀ work, domain work → ∀ edge ∈ left.decompositionsFor equality work,\\n      ∀ child ∈ left.childrenFor equality edge, domain child)\\n    (fuel : Nat) (root : Value) (member : domain root) :\\n    runWithPolicyFuel left equality policy fuel root = runWithPolicyFuel right equality policy fuel root := by\\n  have same := solve_demand_exact left right equality policy domain owners parents closed fuel [] root member\\n  have provenance (graph : WorkGraph) :\\n      Selection.Provenance graph\\n        ((solve graph equality policy fuel [] root).getD (Solution.residual root)).selection := by\\n    cases recorded : solve graph equality policy fuel [] root with\\n    | none => exact Selection.Provenance.residual graph root [] (by simp)\\n    | some solution => exact solve_provenance graph equality policy fuel [] root solution recorded\\n  have other : Selection.Provenance right\\n      ((solve left equality policy fuel [] root).getD (Solution.residual root)).selection := by\\n    rw [same]; exact provenance right\\n  have gate := Selection.validFor_provenance_congr _ left right equality policy root\\n    (provenance left) other\\n  unfold runWithPolicyFuel\\n  rw [← same]\\n  dsimp only\\n  rw [gate]\\n\\ndef runWithPolicy (graph : WorkGraph) (equality : Equality)\\n    (policy : OutcomePolicy) (root : Value) : Extraction :=\\n  runWithPolicyFuel graph equality policy (graph.all.length + graph.outcomes.length + 1) root\\n\\ndef run (graph : WorkGraph) (equality : Equality) (root : Value) : Extraction :=\\n  runWithPolicy graph equality .allCompleted root\\n\\n/-- Before any admission, unrelated Outcome owners cannot create another\\nDemand. If the complete topology has no decomposition for this root, the\\nfull extraction is exactly one unresolved root, regardless of body count. -/\\ntheorem runWithPolicy_unadmitted_root (graph : WorkGraph) (equality : Equality)\\n    (root : Value) (noChoice : graph.decompositionsFor equality root = []) :\\n    runWithPolicy graph equality (.admitted []) root =\\n      Extraction.fromSelection root (.residual root []) := by\\n  have drop (edges : List OutcomeEdge) : edges.filter (fun _ => false) = [] :=\\n    List.filter_eq_nil_iff.mpr (by intro edge member; simp)\\n  simp [runWithPolicy, runWithPolicyFuel, solve, noChoice, OutcomePolicy.admitted,\\n    show (Applicability.irrelevant == Applicability.completed) = false from rfl,\\n    show (Applicability.irrelevant == Applicability.advisory) = false from rfl,\\n    chooseBest, drop, Solution.residual]\\n\\n/-- At a root with no decomposition, recursion depth and irrelevant owners\\ncannot affect extraction. The selected completion/advice lists and their\\nvalidation against the original graph completely determine the result. -/\\ntheorem runWithPolicy_terminal_exact (left right : WorkGraph) (equality : Equality)\\n    (policy : OutcomePolicy) (root : Value)\\n    (leftChoice : left.decompositionsFor equality root = [])\\n    (rightChoice : right.decompositionsFor equality root = [])\\n    (completed : (left.outcomesFor equality root).filter\\n        (fun edge => policy.classify root edge == .completed) =\\n      (right.outcomesFor equality root).filter\\n        (fun edge => policy.classify root edge == .completed))\\n    (advisory : (left.outcomesFor equality root).filter\\n        (fun edge => policy.classify root edge == .advisory) =\\n      (right.outcomesFor equality root).filter\\n        (fun edge => policy.classify root edge == .advisory))\\n    (validation : ∀ selected : Selection,\\n      selected.validFor left equality policy root =\\n        selected.validFor right equality policy root) :\\n    runWithPolicy left equality policy root = runWithPolicy right equality policy root := by\\n  simp only [runWithPolicy, runWithPolicyFuel, solve,\\n    List.contains_nil, Bool.false_eq_true, ↓reduceIte,\\n    leftChoice, rightChoice, List.filterMap_nil, chooseBest, completed, advisory]\\n  simp only [validation]\\n\\n/-- A terminal root's extraction has no decomposition node. Removing All\\nedges elsewhere therefore preserves the complete checked Selection, not\\nonly the Outcome lists or the amount of rendered evidence. -/\\ntheorem runWithPolicy_terminal_all_irrelevant (graph : WorkGraph) (equality : Equality)\\n    (policy : OutcomePolicy) (root : Value)\\n    (noChoice : graph.decompositionsFor equality root = []) :\\n    runWithPolicy {graph with all := []} equality policy root =\\n      runWithPolicy graph equality policy root := by\\n  have emptyChoice : ({graph with all := []} : WorkGraph).decompositionsFor equality root = [] := rfl\\n  simp only [runWithPolicy, runWithPolicyFuel, solve, List.contains_nil,\\n    Bool.false_eq_true, ↓reduceIte, noChoice, emptyChoice,\\n    List.filterMap_nil, chooseBest, WorkGraph.outcomesFor]\\n  by_cases missing : ((graph.outcomes.filter fun edge => equality.same edge.work root).filter\\n    (fun edge => policy.classify root edge == .completed)).isEmpty = true\\n  all_goals\\n    simp only [missing, ↓reduceIte, Option.getD_some]\\n    simp [Solution.residual, Solution.outcomes, Selection.validFor,\\n      Selection.structurallyValidAt, Selection.decompositionEdges,\\n      Selection.completedUses, Selection.advisoryUses, Selection.usesFor,\\n      Selection.outcomeUses, Selection.containsOutcome]\\n\\n/-- A selected owner projection preserves the classified list in its original\\norder, including duplicate evidence. This is independent of topology. -/\\ntheorem classified_selected (graph : WorkGraph) (keep : Value → Bool)\\n    (policy : OutcomePolicy) (equality : Equality) (root : Value)\\n    (delivery : Applicability) (notIrrelevant : delivery ≠ .irrelevant)\\n    (complete : ∀ work edge, policy.classify work edge ≠ .irrelevant →\\n      keep edge.relation = true) :\\n    (WorkGraph.outcomesFor\\n        { graph with outcomes := graph.outcomes.filter (fun edge => keep edge.relation) }\\n        equality root).filter (fun edge => policy.classify root edge == delivery) =\\n      (graph.outcomesFor equality root).filter (fun edge => policy.classify root edge == delivery) := by\\n    simp only [WorkGraph.outcomesFor, List.filter_filter]\\n    apply List.filter_congr\\n    intro edge member\\n    cases delivery with\\n    | irrelevant => contradiction\\n    | completed =>\\n        cases classified : policy.classify root edge with\\n        | irrelevant =>\\n            simp only [show (Applicability.irrelevant == Applicability.completed) = false from rfl,\\n              Bool.false_and]\\n        | advisory =>\\n            simp only [show (Applicability.advisory == Applicability.completed) = false from rfl,\\n              Bool.false_and]\\n        | completed => simp [complete root edge (by simp [classified])]\\n    | advisory =>\\n        cases classified : policy.classify root edge with\\n        | irrelevant =>\\n            simp only [show (Applicability.irrelevant == Applicability.advisory) = false from rfl,\\n              Bool.false_and]\\n        | completed =>\\n            simp only [show (Applicability.completed == Applicability.advisory) = false from rfl,\\n              Bool.false_and]\\n        | advisory => simp [complete root edge (by simp [classified])]\\n/-- The real recursive solver is insensitive to policy-irrelevant bodies at\\nthe SAME depth. Keeping the depth explicit is necessary for cyclic graphs:\\nthe number of hydrated owners must never shorten the reference traversal. -/\\ntheorem solve_selected (graph : WorkGraph) (keep : Value → Bool)\\n    (policy : OutcomePolicy) (equality : Equality)\\n    (complete : ∀ work edge, policy.classify work edge ≠ .irrelevant →\\n      keep edge.relation = true) (fuel : Nat) (active : List Value) (root : Value) :\\n    solve { graph with outcomes := graph.outcomes.filter (fun edge => keep edge.relation) }\\n      equality policy fuel active root = solve graph equality policy fuel active root := by\\n  induction fuel generalizing active root with\\n  | zero => rfl\\n  | succ fuel ih =>\\n      simp only [solve]\\n      by_cases cycle : active.contains root = true\\n      · simp only [cycle, ↓reduceIte]\\n      · simp only [cycle,\\n          classified_selected graph keep policy equality root .completed (by decide) complete,\\n          classified_selected graph keep policy equality root .advisory (by decide) complete]\\n        have visit : solve\\n            { graph with outcomes := graph.outcomes.filter (fun edge => keep edge.relation) }\\n            equality policy fuel (root :: active) = solve graph equality policy fuel (root :: active) :=\\n          funext (ih (root :: active))\\n        simp only [WorkGraph.decompositionsFor, WorkGraph.childrenFor, visit]\\n\\n/-- Complete ordered extraction and provenance validation for arbitrary\\nAll/Union topology, including cycles, at the authoritative traversal depth. -/\\ntheorem runWithPolicyFuel_selected (graph : WorkGraph) (keep : Value → Bool)\\n    (policy : OutcomePolicy) (equality : Equality) (fuel : Nat) (root : Value)\\n    (complete : ∀ work edge, policy.classify work edge ≠ .irrelevant →\\n      keep edge.relation = true) :\\n    runWithPolicyFuel\\n      { graph with outcomes := graph.outcomes.filter (fun edge => keep edge.relation) }\\n      equality policy fuel root = runWithPolicyFuel graph equality policy fuel root := by\\n  simp only [runWithPolicyFuel, solve_selected graph keep policy equality complete,\\n    Selection.validFor_selected graph keep policy equality root _ complete]\\n\\n/-- Removing policy-irrelevant Outcome bodies preserves complete ordered\\nterminal extraction, including its provenance validation. -/\\ntheorem runWithPolicy_terminal_selected (graph : WorkGraph) (keep : Value → Bool)\\n    (policy : OutcomePolicy) (equality : Equality) (root : Value)\\n    (noChoice : graph.decompositionsFor equality root = [])\\n    (complete : ∀ work edge, policy.classify work edge ≠ .irrelevant →\\n      keep edge.relation = true) :\\n    runWithPolicy { graph with outcomes := graph.outcomes.filter (fun edge => keep edge.relation) }\\n      equality policy root = runWithPolicy graph equality policy root := by\\n  exact runWithPolicy_terminal_exact _ graph equality policy root noChoice noChoice\\n    (classified_selected graph keep policy equality root .completed (by decide) complete)\\n    (classified_selected graph keep policy equality root .advisory (by decide) complete)\\n    (fun selection => Selection.validFor_selected graph keep policy equality root selection complete)\\n\\ntheorem run_always_hands_off (graph equality root) :\\n    (run graph equality root).residual.length = 1 :=\\n  Extraction.residual_length _\\n\\ntheorem run_never_finishes_the_inquiry (graph equality root) :\\n    (run graph equality root).residual ≠ [] :=\\n  Extraction.residual_nonempty _\\n\\n/-- Every edge returned by Extract has passed the general graph/policy checker. -/\\ntheorem runWithPolicyFuel_sound (graph equality policy fuel root) :\\n    (runWithPolicyFuel graph equality policy fuel root).selection.validFor\\n      graph equality policy root := by\\n  simp only [runWithPolicyFuel]\\n  split\\n  · exact Extraction.fromSelection_valid (by assumption)\\n  · apply Extraction.fromSelection_valid\\n    exact Selection.residual_valid graph equality policy root\\n\\ntheorem runWithPolicy_sound (graph equality policy root) :\\n    (runWithPolicy graph equality policy root).selection.validFor\\n      graph equality policy root :=\\n  runWithPolicyFuel_sound graph equality policy _ root\\n\\nend Extract\\n\\nend Eggshell\\n\",[]]"],["Eggshell.FederatedSearch","[\"module\\n\\npublic import Eggshell.SemanticMatcher\\npublic import tools.RetrievalIndex\\n\\n@[expose] public section\\nnamespace Eggshell.Persistence.Store.Federated\\n\\n/-- Exact unique owner accounting for the emitted posting stream. The index\\nand the ordered owner witnesses cannot drift during differential aggregation. -/\\nstructure PostingSet where\\n  index : Std.HashMap Nat Unit\\n  owners : List Nat\\n  seen : HashDistinct.Seen index owners\\n  unique : owners.Nodup\\n\\ndef PostingSet.empty : PostingSet := ⟨{}, [], by intro id; simp, by simp⟩\\ninstance : EmptyCollection PostingSet := ⟨PostingSet.empty⟩\\n\\ndef PostingSet.add (known : PostingSet) (id : Nat) : PostingSet :=\\n  if present : known.index.contains id then known else\\n    ⟨known.index.insert id (), id :: known.owners,\\n      HashDistinct.seen_insert _ _ known.seen id, by\\n        refine List.nodup_cons.mpr ⟨?_, known.unique⟩\\n        intro member\\n        have contained : known.owners.contains id = true := List.contains_iff_mem.mpr member\\n        rw [← known.seen id] at contained\\n        simp [contained] at present⟩\\n\\ndef PostingSet.contains (known : PostingSet) (id : Nat) : Bool := known.index.contains id\\ndef PostingSet.size (known : PostingSet) : Nat := known.owners.length\\ndef PostingSet.toList (known : PostingSet) : List Nat := known.owners.reverse\\ndef PostingSet.raw (known : PostingSet) : Std.HashMap Nat Unit × List Nat := (known.index, known.owners)\\n\\ntheorem PostingSet.raw_add (known : PostingSet) (id : Nat) :\\n    (known.add id).raw = HashDistinct.step known.raw id := by\\n  unfold add HashDistinct.step raw\\n  split <;> rfl\\n\\ntheorem PostingSet.raw_fold (known : PostingSet) (ids : List Nat) :\\n    (ids.foldl PostingSet.add known).raw = ids.foldl HashDistinct.step known.raw := by\\n  induction ids generalizing known with\\n  | nil => rfl\\n  | cons id rest ih => simpa only [List.foldl_cons, raw_add] using ih (known.add id)\\n\\ntheorem PostingSet.complete_stream (ids : List Nat) :\\n    (ids.foldl PostingSet.add {}).toList = ids.eraseDups := by\\n  change (ids.foldl PostingSet.add PostingSet.empty).raw.2.reverse = _\\n  rw [raw_fold]\\n  exact HashDistinct.loop_reference ids {} [] (by intro id; simp)\\n\\ntheorem PostingSet.membership (known : PostingSet) (id : Nat) :\\n    known.contains id = true ↔ id ∈ known.owners := by\\n  rw [contains, known.seen]\\n  exact List.contains_iff_mem\\n\\n/-- A reference is meaningful only in this request's closed snapshot table.\\nNeither a path supplied by a provider nor a naked foreign node id is accepted. -/\\nstructure Node (sources : Array Snapshot) where\\n  source : Fin sources.size\\n  id : Nat\\n\\ndef Node.snapshot (node : Node sources) : Snapshot := sources[node.source]\\n\\n/-- Structural equality of applications is equality of the operator and the\\ncomplete ordered, authority-tagged canonical child sequence. Atom digests\\nare deliberately absent: only checked byte comparisons assign Atom ids. -/\\nstructure ApplicationKey where\\n  operator : Operator\\n  arguments : List (Authority × Nat)\\n  deriving DecidableEq, BEq, Hashable\\n\\ndef ApplicationKey.denote (key : ApplicationKey) (children : Nat → Value) : Value :=\\n  Value.applyList key.operator (key.arguments.map fun ref => (ref.1, children ref.2))\\n\\n/-- Canonical child ids must denote distinct complete Values, including Exact\\npositions. Under that invariant the executable key is a complete equality\\ntest, not just a hash or a semantic-footprint approximation. -/\\ntheorem ApplicationKey.denote_injective (children : Nat → Value)\\n    (distinct : Function.Injective children) :\\n    Function.Injective (fun key : ApplicationKey => key.denote children) := by\\n  intro first second same\\n  have applications := Value.apply_injective.mp same\\n  have references := congrArg Refs.toList applications.2\\n  simp only [Refs.toList_ofList] at references\\n  have injective : Function.Injective (fun ref : Authority × Nat => (ref.1, children ref.2)) := by\\n    intro left right equal\\n    change (left.1, children left.2) = (right.1, children right.2) at equal\\n    exact Prod.ext (congrArg (fun pair : Authority × Value => pair.1) equal)\\n      (distinct (congrArg (fun pair : Authority × Value => pair.2) equal))\\n  have sameRefs := (List.map_inj_right (fun _ _ same => injective same)).mp references\\n  cases first\\n  cases second\\n  simp_all\\n\\ndef ApplicationKey.rebind (operator : Operator) (references : List (Authority × Nat))\\n    (canonical : Nat → Nat) : ApplicationKey :=\\n  ⟨operator, references.map fun ref => (ref.1, canonical ref.2)⟩\\n\\n/-- The actual child substitution preserves the entire source application.\\nThis is the interpreter contract used by bottom-up canonicalization; a\\ndifferent arity, reference order, operator or authority cannot be erased. -/\\ntheorem ApplicationKey.rebind_exact (operator : Operator) (references : List (Authority × Nat))\\n    (canonical : Nat → Nat) (source children : Nat → Value)\\n    (same : ∀ ref ∈ references, children (canonical ref.2) = source ref.2) :\\n    (rebind operator references canonical).denote children =\\n      Value.applyList operator (references.map fun ref => (ref.1, source ref.2)) := by\\n  unfold rebind denote\\n  simp only [List.map_map, Function.comp_def]\\n  congr 1\\n  apply List.map_congr_left\\n  intro ref member\\n  exact Prod.ext rfl (same ref member)\\n\\ntheorem ApplicationKey.equality_exact (first second : ApplicationKey)\\n    (children : Nat → Value) (distinct : Function.Injective children) :\\n    first = second ↔ first.denote children = second.denote children :=\\n  ⟨fun equal => congrArg (fun key => key.denote children) equal,\\n    fun equal => ApplicationKey.denote_injective children distinct equal⟩\\n\\n/-- The runtime substitution is paired with its original source frame. In\\naddition to full position/authority preservation, every canonical child must\\nalready exist before its parent can be registered. -/\\nstructure ReboundApplication (operator : Operator) (source : List (Authority × Nat)) (size : Nat) where\\n  key : ApplicationKey\\n  operatorExact : key.operator = operator\\n  pairs : ReferencePairs source key.arguments\\n  before : ∀ ref ∈ key.arguments, ref.2 < size\\n\\ndef ReboundApplication.make? (operator : Operator) (source target : List (Authority × Nat))\\n    (size : Nat) : Option (ReboundApplication operator source size) := do\\n  let pairs ← ReferencePairs.check? source target\\n  if before : ∀ ref ∈ target, ref.2 < size then\\n    pure ⟨⟨operator, target⟩, rfl, pairs, before⟩\\n  else none\\n\\ntheorem ReboundApplication.resolved (application : ReboundApplication operator references size)\\n    (source children : Nat → Value)\\n    (same : ∀ pair ∈ application.pairs.pairs, source pair.1.2 = children pair.2.2) :\\n    application.key.denote children =\\n      Value.applyList operator (references.map fun ref => (ref.1, source ref.2)) := by\\n  unfold ApplicationKey.denote\\n  rw [application.operatorExact, ← application.pairs.resolved source children same]\\n\\ntheorem ReboundApplication.parent_bound (application : ReboundApplication operator source size)\\n    (child : Authority × Nat) (present : child ∈ application.key.arguments) : child.2 < size :=\\n  application.before child present\\n\\n/-- This table is tied to the request's immutable source tuple. Exact-only\\ndescendants are canonicalized too, but are not semantic population members. -/\\nstructure CanonicalNode (sources : Array Snapshot) where\\n  original : Node sources\\n  application : Option ApplicationKey\\n\\nstructure Identity (sources : Array Snapshot) where\\n  nodes : Array (CanonicalNode sources) := #[]\\n  aliases : Std.HashMap (Nat × Nat) Nat := {}\\n  buckets : Std.HashMap Nat (List Nat) := {}\\n  applications : Std.HashMap ApplicationKey Nat := {}\\n\\n/-- Interpret each source DAG node once. Atom identity uses complete streamed\\nbytes; applications use already canonical children, avoiding a fresh walk of\\nthe same giant Atom for every enclosing relation. Checked backward references\\ngive termination independently of body size or guessed traversal fuel. -/\\ndef Identity.add (index : Identity sources) (node : Node sources) : IO (Identity sources × Nat) := do\\n  let key := (node.source.val, node.id)\\n  if let some known := index.aliases[key]? then return (index, known)\\n  let digest ← nodeHash node.snapshot node.id\\n  let checked ← readFrame node.snapshot node.snapshot.get node.id\\n  match _shape : checked.frame with\\n  | .atom =>\\n      for candidate in index.buckets.getD digest [] do\\n        let some entry := index.nodes[candidate]? |\\n          throw (IO.userError \\\"federated Atom bucket exceeds its request table\\\")\\n        unless entry.application.isNone do\\n          throw (IO.userError \\\"federated Atom bucket contains an application\\\")\\n        let original := entry.original\\n        if original.snapshot.directory == node.snapshot.directory &&\\n            original.snapshot.head == node.snapshot.head && original.id == node.id then\\n          return ({index with aliases := index.aliases.insert key candidate}, candidate)\\n        if ← bodiesEqual original.snapshot original.id node.snapshot node.id then\\n          return ({index with aliases := index.aliases.insert key candidate}, candidate)\\n      let id := index.nodes.size\\n      pure ({index with\\n        nodes := index.nodes.push ⟨node, none⟩\\n        aliases := index.aliases.insert key id\\n        buckets := index.buckets.insert digest (id :: index.buckets.getD digest [])}, id)\\n  | .apply operator references =>\\n      let (index, reversed) ← references.attach.foldlM (init := (index, [])) fun (index, previous) reference => do\\n        let (index, child) ← index.add ⟨node.source, reference.val.2⟩\\n        pure (index, (reference.val.1, child) :: previous)\\n      let some rebound := ReboundApplication.make? operator references reversed.reverse index.nodes.size |\\n        throw (IO.userError \\\"federated child substitution lost a position, authority or prior node\\\")\\n      let application := rebound.key\\n      if let some id := index.applications[application]? then\\n        let some original := index.nodes[id]? |\\n          throw (IO.userError \\\"federated application key exceeds its request table\\\")\\n        unless original.application == some application do\\n          throw (IO.userError \\\"federated application key disagrees with its original node\\\")\\n        return ({index with aliases := index.aliases.insert key id}, id)\\n      let id := index.nodes.size\\n      pure ({index with\\n        nodes := index.nodes.push ⟨node, some application⟩\\n        aliases := index.aliases.insert key id\\n        applications := index.applications.insert application id}, id)\\ntermination_by node.id\\ndecreasing_by\\n  exact checked.before reference.val (by simpa [_shape, NodeFrame.arguments] using reference.property)\\n\\ndef Identity.lookup (index : Identity sources) (source : Fin sources.size) (id : Nat) : IO Nat := do\\n  let some canonical := index.aliases[(source.val, id)]? |\\n    throw (IO.userError \\\"live reference is absent from the federated semantic index\\\")\\n  pure canonical\\n\\nstructure Document (sources : Array Snapshot) where\\n  node : Node sources\\n  original : SearchDocument\\n  owner : Nat\\n  work : Nat\\n  ordinal : Nat\\n\\nstructure Catalogue (sources : Array Snapshot) where\\n  readers : NodeReaders sources\\n  identity : Identity sources\\n  roots : List Nat\\n  orders : Std.HashMap Nat Nat\\n  owners : Std.HashMap Nat (Node sources)\\n  ownerOrigins : Std.HashMap Nat (List (Node sources)) := {}\\n  documents : List (Document sources)\\n  all : List AllEdge\\n  unions : List UnionEdge\\n  semanticPopulation : Nat\\n\\n/-- Only numeric membership and node nomination directories are enumerated.\\nNo original body is hydrated to obtain populations, deduplicated source order\\nor lexical frequencies. Overlapping sources share one structural owner. -/\\ndef prepare (sources : Array Snapshot) : IO (Catalogue sources) := do\\n  let readers ← NodeReaders.new sources\\n  let mut identity : Identity sources := {}\\n  let mut semantic : Std.HashSet Nat := {}\\n  let mut topology := []\\n  let mut unions := []\\n  for source in List.finRange sources.size do\\n    let snapshot := sources[source]\\n    let reader := readers.at source\\n    let edges ← reader.topology\\n    topology := topology ++ edges\\n    let edges ← reader.unions (← authority snapshot)\\n    unions := unions ++ edges.map (·.edge)\\n    let nodes ← directory snapshot \\\"semanticUses\\\"\\n    unless nodes.length == (← getNat snapshot.get \\\"semanticPopulation\\\") &&\\n        nodes.all (fun row => row.2 > 0) do\\n      throw (IO.userError \\\"federated semantic population is incomplete\\\")\\n    for (id, _) in nodes do\\n      let (next, canonical) ← identity.add ⟨source, id⟩\\n      identity := next\\n      semantic := semantic.insert canonical\\n  let mut roots := []\\n  let mut owners : Std.HashMap Nat (Node sources) := {}\\n  let mut ownerOrigins : Std.HashMap Nat (List (Node sources)) := {}\\n  let mut documents : List (Document sources) := []\\n  let mut known : Std.HashSet Nat := {}\\n  for source in List.finRange sources.size do\\n    let snapshot := sources[source]\\n    for (_, id) in (← rootDirectory snapshot) do\\n      roots := roots ++ [← identity.lookup source id]\\n    let rows ← directory snapshot \\\"outcome\\\"\\n    unless rows.length == (← getNat snapshot.get \\\"liveOutcomes\\\") do\\n      throw (IO.userError \\\"federated Outcome population is incomplete\\\")\\n    for (_, id) in rows do\\n      let _ ← locateOutcome snapshot id\\n      let canonical ← identity.lookup source id\\n      ownerOrigins := ownerOrigins.insert canonical (ownerOrigins.getD canonical [] ++ [⟨source, id⟩])\\n      unless owners.contains canonical do owners := owners.insert canonical ⟨source, id⟩\\n    for document in (← searchDocuments snapshot) do\\n      let owner ← identity.lookup source document.owner\\n      unless owners.contains owner do throw (IO.userError \\\"federated candidate is not an Outcome\\\")\\n      unless known.contains owner do\\n        known := known.insert owner\\n        documents := documents ++ [⟨⟨source, document.owner⟩, document, owner,\\n          ← identity.lookup source document.work, 0⟩]\\n  roots := hashDistinct roots\\n  let orders := Std.HashMap.ofList (roots.zipIdx)\\n  documents ← documents.mapM fun document => do\\n    let some ordinal := orders[document.owner]? |\\n      throw (IO.userError \\\"federated document has no live source root\\\")\\n    pure {document with ordinal}\\n  let result : Catalogue sources := {\\n    readers, identity, roots, orders, owners, ownerOrigins\\n    documents := documents.mergeSort (fun first second => first.ordinal ≤ second.ordinal)\\n    all := topology.eraseDups\\n    unions, semanticPopulation := semantic.size }\\n  pure result\\n\\n/-- A complete point/range lookup is done in every source, including negative\\nmembership. Frequencies count canonical owners once, not source copies. -/\\ndef postings (catalogue : Catalogue sources) (unit : String) (semantic : Bool) : IO PostingSet := do\\n  let mut owners : PostingSet := {}\\n  for source in List.finRange sources.size do\\n    let snapshot := sources[source]\\n    let ids ← if semantic then pure (← RetrievalResearch.Index.strictPosting snapshot unit).1 else do\\n      let ids ← Store.postings snapshot unit\\n      unless ids.length == (← frequency snapshot unit) do\\n        throw (IO.userError \\\"federated term frequency disagrees with its complete posting\\\")\\n      pure ids\\n    for id in ids do\\n      let canonical ← catalogue.identity.lookup source id\\n      unless catalogue.owners.contains canonical do\\n        throw (IO.userError \\\"federated posting refers to a foreign Outcome\\\")\\n      owners := owners.add canonical\\n  pure owners\\n\\ndef retrievalLookup (catalogue : Catalogue sources) (strict : Bool)\\n    (receipt : Option String) : IO (String → IO PostingSet) := do\\n  let lookups ← (List.finRange sources.size).mapM fun source => do\\n    let read ← if strict then RetrievalResearch.Index.strictLookup sources[source]\\n      else RetrievalResearch.Index.coarseLookup sources[source] receipt\\n    pure (source, read)\\n  pure fun unit => do\\n    let mut owners : PostingSet := {}\\n    for (source, read) in lookups do\\n      let (ids, _) ← read unit\\n      for id in ids do\\n        let canonical ← catalogue.identity.lookup source id\\n        unless catalogue.owners.contains canonical do\\n          throw (IO.userError \\\"lexical posting names a foreign canonical owner\\\")\\n        owners := owners.add canonical\\n    pure owners\\n\\ndef frequency (catalogue : Catalogue sources) (unit : String) : IO Nat :=\\n  (·.size) <$> postings catalogue unit false\\n\\ndef live? (sources : Array Snapshot) (value : Value) : IO Bool := do\\n  for snapshot in sources do\\n    if (← liveRoot? snapshot value).isSome then return true\\n  pure false\\n\\ndef semanticPresent (sources : Array Snapshot) (value : Value) : IO Bool := do\\n  for snapshot in sources do\\n    if let some id ← findNode? snapshot value then\\n      if (← getNat snapshot.get (key \\\"semanticUses\\\" id)) > 0 then return true\\n  pure false\\n\\ndef works (catalogue : Catalogue sources) (value : Value) : IO (Std.HashSet Nat) := do\\n  let mut found : Std.HashSet Nat := {}\\n  for source in List.finRange sources.size do\\n    if let some id ← findNode? sources[source] value then\\n      if let some canonical := catalogue.identity.aliases[(source.val, id)]? then\\n        found := found.insert canonical\\n  pure found\\n\\nend Eggshell.Persistence.Store.Federated\\n\",[]]"],["Eggshell.FileSystem","[\"module\\n\\npublic import Std\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\nnamespace Eggshell.FileSystem\\n\\ndef privateFile (path : System.FilePath) : IO Unit :=\\n  IO.setAccessRights path {\\n    user := { read := true, write := true }, group := {}, other := {} }\\n\\ndef privateDirectory (path : System.FilePath) : IO Unit := do\\n  IO.FS.createDirAll path\\n  IO.setAccessRights path {\\n    user := { read := true, write := true, execution := true }, group := {}, other := {} }\\n\\n/-- Permission and device failures are not evidence that a file is absent. -/\\ndef symlinkMetadata? (path : System.FilePath) : IO (Option IO.FS.Metadata) := do\\n  try pure (some (← path.symlinkMetadata))\\n  catch error => match error with\\n    | .noFileOrDirectory .. => pure none\\n    | _ => throw error\\n\\ndef rejectSymlinkAncestors (path : System.FilePath) : IO Unit := do\\n  let rec visit : Nat → System.FilePath → IO Unit\\n    | 0, _ => throw (IO.userError s!\\\"authority path is too deep: {path}\\\")\\n    | fuel + 1, current => do\\n        if let some metadata ← symlink
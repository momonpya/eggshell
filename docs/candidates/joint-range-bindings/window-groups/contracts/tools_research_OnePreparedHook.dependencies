 deriving Repr, ToJson, FromJson\\n\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.content-capture\\\".toUTF8 [\\n  (include_str \\\"ContentCapture.lean\\\").toUTF8,\\n  (include_str \\\"ContentMetadata.lean\\\").toUTF8,(include_str \\\"SourceEvidence.lean\\\").toUTF8,\\n  (include_str \\\"FileSystem.lean\\\").toUTF8,\\n  (include_str \\\"../tools/ContentCorrespondence.lean\\\").toUTF8,\\n  Synapses.ObservedRecords.implementation.toUTF8])\\n\\nstructure Output where\\n  spelling : Synapses.ObservedRecords.Spelling\\n  text : String\\n\\n/-- Index actual data projections, never a command or provider name. Base\\npartitions remain in ObservedRecords even if no file correspondence exists. -/\\ndef outputs (raw : String) : Array Output := Id.run do\\n  let characters := raw.toList.toArray\\n  let mut result := #[]\\n  let mut seen : Std.HashSet (Nat × Nat × Synapses.ObservedRecords.Projection) := {}\\n  for record in Synapses.ObservedRecords.normalize raw do\\n    for spelling in record.spellings do\\n      unless [Synapses.ObservedRecords.Projection.rawLine,.stringBodyLine,.string].contains spelling.projection do continue\\n      let key := (spelling.first,spelling.limit,spelling.projection)\\n      if seen.contains key then continue\\n      seen := seen.insert key\\n      let some text := Synapses.ObservedRecords.project characters spelling | continue\\n      unless !text.isEmpty && !text.contains '\\\\n' do continue\\n      result := result.push ⟨spelling,text⟩\\n  return result\\n\\nstructure Trie where\\n  outputs : Array Output\\n  characters : Array (Array Char)\\n  edges : Std.HashMap (Nat × Char) Nat := {}\\n  -- Each node is a suffix of one immutable output projection. No input\\n  -- text or unbounded posting list is retained during the file scan.\\n  nodes : Array (Nat × Nat) := #[(0,0)]\\n\\ndef Trie.prepare (rows : Array Output) : Trie := Id.run do\\n  let mut trie : Trie := {outputs := rows,characters := rows.map (fun row => row.text.toList.toArray)}\\n  for row in [:rows.size] do\\n    let some output := rows[row]? | continue\\n    let mut node := 0\\n    let mut depth := 0\\n    for char in output.text.toList.reverse do\\n      depth := depth+1\\n      match trie.edges[(node,char)]? with\\n      | some next => node := next\\n      | none =>\\n        let next := trie.nodes.size\\n        trie := {trie with\\n          edges := trie.edges.insert (node,char) next\\n          nodes := trie.nodes.push (row,depth)}\\n        node := next\\n  return trie\\n\\ndef suffix (text : String) (chars : Nat) : String :=\\n  String.ofList (text.toList.drop (text.length-chars))\\n\\ndef Trie.key? (trie : Trie) (node : Nat) : Option String := do\\n  let (row,depth) ← trie.nodes[node]?\\n  let characters ← trie.characters[row]?\\n  if depth == 0 || characters.size < depth then none else\\n    some (String.ofList (characters.extract (characters.size-depth) characters.size).toList)\\n\\ndef Trie.find? (trie : Trie) (text : String) : Option Nat := do\\n  if text.isEmpty then none else do\\n    let node ← text.toList.reverse.foldlM (fun node char => trie.edges[(node,char)]?) 0\\n    if trie.key? node == some text then some node else none\\n\\nabbrev State := Array Candidate\\n\\ndef Trie.start (trie : Trie) : State := Array.replicate trie.nodes.size .absent\\n\\ndef Trie.observe (trie : Trie) (state : State) (position : Position) (text : String) : State :=\\n  match trie.find? text with\\n  | none => state\\n  | some node => state.modify node (fun previous => previous.join (.one position))\\n\\ntheorem Trie.observe_size (trie : Trie) (state : State) (position : Position) (text : String) :\\n    (trie.observe state position text).size = state.size := by\\n  simp only [observe]\\n  split <;> simp\\n\\ntheorem Trie.find_checked (trie : Trie) (text : String) (node : Nat)\\n    (found : trie.find? text = some node) : trie.key? node = some text := by\\n  cases vacant : text.isEmpty with\\n  | true => simp [find?,vacant] at found\\n  | false =>\\n    cases traced : text.toList.reverse.foldlM (fun node char => trie.edges[(node,char)]?) 0 with\\n    | none => simp [find?,vacant,traced] at found\\n    | some selected =>\\n      simp [find?,vacant,traced] at found\\n      simpa [found.2] using found.1\\n\\ndef Trie.selected? (trie : Trie) (state : State) (output : Output) : Option (Position × Nat) := Id.run do\\n  let mut node := 0\\n  let mut depth := 0\\n  let characters := output.text.toList.toArray\\n  let mut found : Option (Candidate × Nat) := none\\n  for char in output.text.toList.reverse do\\n    let some next := trie.edges[(node,char)]? | break\\n    node := next\\n    depth := depth+1\\n    let candidate := state[node]?.getD .absent\\n    let expected := fun _ => String.ofList (characters.extract (characters.size-depth) characters.size).toList\\n    if candidate != .absent && trie.key? node == some (expected ()) then\\n      found := some (candidate,depth)\\n  match found with\\n  | some (.one position,count) => return some (position,count)\\n  | _ => return none\\n\\ndef escapedWidth (text : String) : Nat := (toJson text).compress.length-2\\n\\ndef alias? (inputs : Array SourceEvidence.File) (characters : Array Char) (output : Output)\\n    (position : Position) (chars : Nat) : Option Alias := do\\n  let file ← inputs[position.1]?\\n  let content ← file.content\\n  if chars == 0 || output.text.length < chars || position.2 == 0 then none else do\\n    let code := suffix output.text chars\\n    let preceding := String.ofList (output.text.toList.take (output.text.length-chars))\\n    let encoded := match output.spelling.projection with\\n      | .string | .stringBody | .stringBodyLine => true\\n      | _ => false\\n    let base := output.spelling.first + if output.spelling.projection == .string then 1 else 0\\n    let first := base + if encoded then escapedWidth preceding else preceding.length\\n    let limit := first + if encoded then escapedWidth code else code.length\\n    let literal := String.ofList (characters.extract first limit).toList\\n    let expected := if encoded then String.ofList ((toJson code).compress.toList.drop 1 |>.dropLast) else code\\n    if first < limit && limit ≤ output.spelling.limit && literal == expected then\\n      some ⟨⟨file.relative,content.root,content.bytes⟩,position.2,output.spelling,chars,first,limit⟩\\n    else none\\n\\n/-- JSON leaves and a general literal lexer supply path hints. The executable\\nname is not a discriminator. Only regular files inside the workspace survive;\\nthese hints never establish complete execution dependencies. -/\\npartial def inputStrings : Json → Array String\\n  | .str value => #[value]\\n  | .arr values => values.flatMap inputStrings\\n  | .obj values => values.toArray.flatMap (inputStrings ∘ Prod.snd)\\n  | _ => #[]\\n\\ndef candidates (workspace : System.FilePath) (input : Json) : Array SourceEvidence.Relative := Id.run do\\n  let some directory := SourceEvidence.inputDirectory? workspace input | return #[]\\n  let mut result := #[]\\n  let mut seen : Std.HashSet String := {}\\n  for value in inputStrings input do\\n    for word in #[value] ++ ((shellWords value).toOption.getD #[]) do\\n      if word.contains \\\"://\\\" then continue\\n      let some relative := SourceEvidence.relative? workspace directory word | continue\\n      if seen.contains relative.text then continue\\n      seen := seen.insert relative.text\\n      result := result.push relative\\n  return result\\n\\ndef captureInputs (workspace : System.FilePath) (input : Json)\\n    (known : Option SourceEvidence.Capture) (deadline : Nat) : IO SourceEvidence.Capture := do\\n  let mut probes := []\\n  for relative in candidates workspace input do\\n    if (← IO.monoMsNow) ≥ deadline then return SourceEvidence.unknown workspace\\n    let path := workspace / relative.text\\n    try\\n      FileSystem.rejectSymlinkAncestors path\\n      if (← FileSystem.regularMetadata? path).isNone then continue\\n      un
ts must be literally equal; only Semantic arguments recurse.\\n-/\\ninductive Equivalent (edges : List UnionEdge) : Value → Value → Prop where\\n  | refl (value) : Equivalent edges value value\\n  | union (edge) : edge ∈ edges → Equivalent edges edge.left edge.right\\n  | symm : Equivalent edges left right → Equivalent edges right left\\n  | trans : Equivalent edges left middle → Equivalent edges middle right →\\n      Equivalent edges left right\\n  | apply (operator) : RefsEquivalent edges leftArgs rightArgs →\\n      Equivalent edges (.apply operator leftArgs) (.apply operator rightArgs)\\n\\ninductive RefsEquivalent (edges : List UnionEdge) : Refs → Refs → Prop where\\n  | nil : RefsEquivalent edges .nil .nil\\n  | semantic : Equivalent edges left right → RefsEquivalent edges lefts rights →\\n      RefsEquivalent edges (.semantic left lefts) (.semantic right rights)\\n  | exact : RefsEquivalent edges lefts rights →\\n      RefsEquivalent edges (.exact value lefts) (.exact value rights)\\n\\nend\\n\\ntheorem Equivalent.exactAuthority {edges left right}\\n    (equivalent : Equivalent edges left right) :\\n    Value.SameExactFootprint left right :=\\n  Equivalent.rec\\n    (motive_1 := fun left right _ => Value.SameExactFootprint left right)\\n    (motive_2 := fun left right _ => ∀ exact,\\n      exact ∈ Value.refsExactFootprint left ↔\\n        exact ∈ Value.refsExactFootprint right)\\n    (fun value => Value.sameExactFootprint_refl value)\\n    (fun edge _ => edge.exactAuthority)\\n    (fun _ induction => Value.sameExactFootprint_symm induction)\\n    (fun _ _ leftMiddle middleRight =>\\n      Value.sameExactFootprint_trans leftMiddle middleRight)\\n    (fun _ _ induction => induction)\\n    (by intro exact; simp [Value.refsExactFootprint])\\n    (fun _ _ head tail exact => by\\n      simp only [Value.refsExactFootprint, List.mem_append]\\n      exact or_congr (head exact) (tail exact))\\n    (fun _ tail exact => by\\n      simp only [Value.refsExactFootprint, List.mem_cons, List.mem_append]\\n      exact or_congr Iff.rfl (tail exact))\\n    equivalent\\n\\n/-- With no generating edges, congruence cannot identify distinct Values.\\nThis includes nested Semantic applications and every Exact position. -/\\ntheorem Equivalent.without_edges {left right : Value}\\n    (equivalent : Equivalent [] left right) : left = right :=\\n  Equivalent.rec\\n    (motive_1 := fun left right _ => left = right)\\n    (motive_2 := fun left right _ => left = right)\\n    (fun _ => rfl)\\n    (fun _ member => False.elim (List.not_mem_nil member))\\n    (fun _ equal => equal.symm)\\n    (fun _ _ first second => first.trans second)\\n    (fun operator _ equal => congrArg (Value.apply operator) equal)\\n    rfl\\n    (fun _ _ head tail => by cases head; cases tail; rfl)\\n    (fun _ tail => by cases tail; rfl)\\n    equivalent\\n\\nend Eggshell\\n\",[]]"],["Eggshell.Value","[\"module\\n\\npublic import Std\\npublic import Std.Data.HashMap.Basic\\n\\n@[expose] public section\\n\\nnamespace Eggshell\\n\\n/-- Stable first-occurrence deduplication; hashes nominate, lawful `BEq` decides. -/\\ndef hashDistinct [BEq α] [Hashable α] (values : List α) : List α :=\\n  let (_, reversed) := values.foldl (fun (state : Std.HashMap α Unit × List α) value =>\\n    let (seen, result) := state\\n    if seen.contains value then (seen, result)\\n    else (seen.insert value (), value :: result)) ({}, [])\\n  reversed.reverse\\n\\n/-- The complete semantic operator vocabulary. Roles are positions, never Atom kinds. -/\\ninductive Operator where\\n  | all\\n  | outcome\\n  | occurrence\\n  | inquiry\\n  | receipt\\n  deriving Repr, DecidableEq, BEq, Hashable\\n\\nnamespace Operator\\n\\ndef allValues : List Operator :=\\n  [.all, .outcome, .occurrence, .inquiry, .receipt]\\n\\ntheorem mem_allValues (operator : Operator) : operator ∈ allValues := by\\n  cases operator <;> simp [allValues]\\n\\ntheorem allValues_nodup : allValues.Nodup := by\\n  simp [allValues]\\n\\nend Operator\\n\\n/-- Semantic references may follow equality; Exact references never do. -/\\ninductive Authority where\\n  | semantic\\n  | exact\\n  deriving Repr, DecidableEq, BEq, Hashable\\n\\nmutual\\n\\n/--\\nA Value is its own exact structural content address. This removes the unprovable\\nassumption that a finite digest is globally injective. Hashes may still index or\\ndisplay Values, but they never decide semantic identity.\\n-/\\ninductive Value where\\n  | atom (bytes : ByteArray)\\n  | apply (operator : Operator) (arguments : Refs)\\n\\n/-- A finite sequence of authority-tagged references. -/\\ninductive Refs where\\n  | nil\\n  | semantic (value : Value) (tail : Refs)\\n  | exact (value : Value) (tail : Refs)\\n\\nend\\n\\nnamespace Value\\n\\nmutual\\n\\n/--\\nThe quotient follows only substitutable structure. Exact provenance is compared\\nliterally by congruence and never becomes an equivalence-search lane.\\n-/\\ndef semanticNodes : Value → List Value\\n  | value@(.atom _) => [value]\\n  | value@(.apply _ arguments) => value :: refsSemanticNodes arguments\\n\\ndef refsSemanticNodes : Refs → List Value\\n  | .nil => []\\n  | .semantic value tail => value.semanticNodes ++ refsSemanticNodes tail\\n  | .exact _ tail => refsSemanticNodes tail\\n\\nend\\n\\n\\nmutual\\n\\n/-- A semantics-independent extraction cost for one structural Value. -/\\ndef structuralSize : Value → Nat\\n  | .atom bytes => bytes.size + 1\\n  | .apply _ arguments => refsStructuralSize arguments + 1\\n\\ndef refsStructuralSize : Refs → Nat\\n  | .nil => 0\\n  | .semantic value tail | .exact value tail =>\\n      value.structuralSize + refsStructuralSize tail + 1\\n\\nend\\n\\n\\ntheorem structuralSize_positive (value : Value) : 0 < value.structuralSize := by\\n  cases value <;> simp [structuralSize]\\n\\nend Value\\n\\nderiving instance DecidableEq for Value, Refs\\nderiving instance Hashable for Value, Refs\\n\\n/-- A single reference view used at API boundaries. -/\\nabbrev Ref := Authority × Value\\n\\nnamespace Refs\\n\\ndef ofList : List Ref → Refs\\n  | [] => .nil\\n  | (.semantic, value) :: tail => .semantic value (ofList tail)\\n  | (.exact, value) :: tail => .exact value (ofList tail)\\n\\ndef toList : Refs → List Ref\\n  | .nil => []\\n  | .semantic value tail => (.semantic, value) :: tail.toList\\n  | .exact value tail => (.exact, value) :: tail.toList\\n\\n@[simp]\\ntheorem toList_ofList (references : List Ref) : (ofList references).toList = references := by\\n  induction references with\\n  | nil => rfl\\n  | cons head tail induction =>\\n      rcases head with ⟨authority, value⟩\\n      cases authority <;> simp [ofList, toList, induction]\\n\\n@[simp]\\ntheorem ofList_toList : ∀ references : Refs, ofList references.toList = references\\n  | .nil => rfl\\n  | .semantic value tail => by simp [toList, ofList, ofList_toList tail]\\n  | .exact value tail => by simp [toList, ofList, ofList_toList tail]\\n\\nend Refs\\n\\nnamespace Value\\n\\ndef text (value : String) : Value :=\\n  .atom value.toUTF8\\n\\ndef applyList (operator : Operator) (arguments : List Ref) : Value :=\\n  .apply operator (.ofList arguments)\\n\\ntheorem atom_injective {left right : ByteArray} :\\n    Value.atom left = Value.atom right ↔ left = right := by\\n  simp\\n\\ntheorem apply_injective {leftOperator rightOperator : Operator} {leftArgs rightArgs : Refs} :\\n    Value.apply leftOperator leftArgs = Value.apply rightOperator rightArgs ↔\\n      leftOperator = rightOperator ∧ leftArgs = rightArgs := by\\n  simp\\n\\nmutual\\n\\n/-- Every Exact occurrence reachable from a Value, including nested authority. -/\\ndef exactFootprint : Value → List Value\\n  | .atom _ => []\\n  | .apply _ arguments => refsExactFootprint arguments\\n\\ndef refsExactFootprint : Refs → List Value\\n  | .nil => []\\n  | .semantic value tail => value.exactFootprint ++ refsExactFootprint tail\\n  | .exact value tail => value :: value.exactFootprint ++ refsExactFootprint tail\\n\\nend\\n\\nmutual\\n\\n/-- Every structurally contained Value, used to rebuild finite indexes. -/\\ndef nodes : Value → List Value\\n  | value@(.atom _) => [value]\\n  | value@(.apply _ arguments) => value :: refsNodes arguments\\n\\ndef refsNodes : Refs → List Value\\n  | .nil => []\\n  | .semantic value tail | .exact value tail => value.nodes ++ refsNodes tail\\n\\nend\\n\\nmutual\\n\\n/-- Preorder structural traversal without an intermediate flattened node\\nlist. The accumulator may retain only unique nodes or numerical metadata. -/\\ndef foldNodes (step : α → Value → α) (initial : α) : Value → α\\n  | value@(.atom _) => step initial value\\n  | value@(.apply _ arguments) => foldRefsNodes step (step initial value) arguments\\n\\ndef foldRefsNodes (step : α → Value → α) (initial : α) : Refs → α\\n  | .nil => initial\\n  | .semantic value tail | .exact value tail =>\\n      foldRefsNodes step (foldNodes step initial value) tail\\n\\nend\\n\\nmutual\\n\\ntheorem foldNodes_exact (step : α → Value → α) (initial : α) (value : Value) :\\n    foldNodes step initial value = value.nodes.foldl step initial := by\\n  cases value with\\n  | atom => rfl\\n  | apply => simp only [foldNodes, nodes, List.foldl_cons, foldRefsNodes_exact]\\n\\ntheorem foldRefsNodes_exact (step : α → Value → α) (initial : α) (refs : Refs) :\\n    foldRefsNodes step initial refs = (refsNodes refs).foldl step initial := by\\n  cases refs with\\n  | nil => rfl\\n  | semantic value tail | exact value tail =>\\n      simp only [foldRefsNodes, refsNodes, List.foldl_append,\\n        foldNodes_exact, foldRefsNodes_exact]\\n\\nend\\n\\nmutual\\n\\n/-- Follow only Semantic references, preserving the same root-first order.\\nAn Exact-only subtree never acquires semantic membership through traversal. -/\\ndef foldSemanticNodes (step : α → Value → α) (initial : α) : Value → α\\n  | value@(.atom _) => step initial value\\n  | value@(.apply _ arguments) => foldRefsSemanticNodes step (step initial value) arguments\\n\\ndef foldRefsSemanticNodes (step : α → Value → α) (initial : α) : Refs → α\\n  | .nil => initial\\n  | .semantic value tail =>\\n      foldRefsSemanticNodes step (foldSemanticNodes step initial value) tail\\n  | .exact _ tail => foldRefsSemanticNodes step initial tail\\n\\nend\\n\\nmutual\\n\\ntheorem foldSemanticNodes_exact (step : α → Value → α) (initial : α) (value : Value) :\\n    foldSemanticNodes step initial value = value.semanticNodes.foldl step initial := by\\n  cases value with\\n  | atom => rfl\\n  | apply => simp only [foldSemanticNodes, semanticNodes, List.foldl_cons,\\n      foldRefsSemanticNodes_exact]\\n\\ntheorem foldRefsSemanticNodes_exact (step : α → Value → α) (initial : α) (refs : Refs) :\\n    foldRefsSemanticNodes step initial refs = (refsSemanticNodes refs).foldl step initial := by\\n  cases refs with\\n  | nil => rfl\\n  | semantic value tail =>\\n      simp only [foldRefsSemanticNodes, refsSemanticNodes, List.foldl_append,\\n        foldSemanticNodes_exact, foldRefsSemanticNodes_exact]\\n  | exact value tail =>\\n      simp only [foldRefsSemanticNodes, refsSemanticNodes, foldRefsSemanticNodes_exact]\\n\\nend\\n\\nmutual\\n\\ntheorem semanticNodes_subset_nodes (root : Value) : root.semanticNodes ⊆ root.nodes := by\\n  cases root with\\n  | atom bytes => exact List.Subset.refl _\\n  | apply operator refs =>\\n      intro value member\\n      simp only [semanticNodes, nodes, List.mem_cons] at member ⊢\\n      exact member.elim Or.inl (fun member => Or.inr (refsSemanticNodes_subset_refsNodes refs member))\\n\\ntheorem refsSemanticNodes_subset_refsNodes (refs : Refs) : refsSemanticNodes refs ⊆ refsNodes refs := by\\n  cases refs with\\n  | nil => exact List.Subset.refl _\\n  | semantic value tail =>\\n      intro node member\\n      simp only [refsSemanticNodes, refsNodes, List.mem_append] at member ⊢\\n      exact member.elim (fun member => Or.inl (semanticNodes_subset_nodes value member))\\n        (fun member => Or.inr (refsSemanticNodes_subset_refsNodes tail member))\\n  | exact value tail =>\\n      intro node member\\n      exact List.mem_append_right _ (refsSemanticNodes_subset_refsNodes tail member)\\n\\nend\\n\\ndef SameExactFootprint (left right : Value) : Prop :=\\n  ∀ exact, exact ∈ left.exactFootprint ↔ exact ∈ right.exactFootprint\\n\\ndef sameExactFootprint (left right : Value) : Bool :=\\n  left.exactFootprint.all right.exactFootprint.contains &&\\n    right.exactFootprint.all left.exactFootprint.contains\\n\\ntheorem sameExactFootprint_sound {left right}\\n    (accepted : sameExactFootprint left right) : SameExactFootprint left right := by\\n  intro exact\\n  simp only [sameExactFootprint, Bool.and_eq_true, List.all_eq_true] at accepted\\n  constructor\\n  · intro present\\n    exact List.contains_iff_mem.mp (accepted.1 exact present)\\n  · intro present\\n    exact List.contains_iff_mem.mp (accepted.2 exact present)\\n\\ntheorem sameExactFootprint_refl (value : Value) : SameExactFootprint value value := by\\n  intro exact\\n  rfl\\n\\ntheorem sameExactFootprint_symm {left right : Value}\\n    (same : SameExactFootprint left right) : SameExactFootprint right left := by\\n  intro exact\\n  exact (same exact).symm\\n\\ntheorem sameExactFootprint_trans {left middle right : Value}\\n    (leftMiddle : SameExactFootprint left middle)\\n    (middleRight : SameExactFootprint middle right) : SameExactFootprint left right := by\\n  intro exact\\n  exact (leftMiddle exact).trans (middleRight exact)\\n\\nend Value\\n\\nnamespace Ref\\n\\ndef semantic (value : Value) : Ref :=\\n  (.semantic, value)\\n\\ndef exact (value : Value) : Ref :=\\n  (.exact, value)\\n\\ndef target (reference : Ref) : Value :=\\n  reference.2\\n\\ndef normalize (representative : Value → Value) : Ref → Ref\\n  | (.semantic, value) => semantic (representative value)\\n  | (.exact, value) => exact value\\n\\n@[simp]\\ntheorem normalize_exact (representative : Value → Value) (value : Value) :\\n    normalize representative (exact value) = exact value := by\\n  rfl\\n\\n@[simp]\\ntheorem normalize_semantic (representative : Value → Value) (value : Value) :\\n    normalize representative (semantic value) = semantic (representative value) := by\\n  rfl\\n\\nend Ref\\n\\nend Eggshell\\n\",[]]"],["Eggshell.VectorMatrix","[\"module\\npublic import Eggshell.DB.Sidecar\\npublic import Eggshell.DB.Wire\\npublic import Eggshell.Receipt\\npublic import Eggshell.Sha256\\npublic import tools.WindowCentroid\\n\\n@[expose] public section\\n\\nnamespace Eggshell.VectorMatrix\\nopen Lean DB\\n\\n/-- Numerical hints only. Original observation and Work authority remain\\noutside this store, even when identical inputs share a projection. -/\\nstructure Row where\\n  coverage : String\\n  bytes : Nat\\n  chunks : List PageMap.Blob\\n\\ndef rowCodec := (Wire.text.product (Wire.natural.product (Wire.list PageMap.blobCodec))).iso\\n  (fun row : Row => (row.coverage,row.bytes,row.chunks))\\n  (fun (coverage,bytes,chunks) => Row.mk coverage bytes chunks)\\n  (by intro row; cases row; rfl)\\n\\ntheorem row_roundtrip (row : Row) (tail : List UInt8) :\\n    rowCodec.decode (rowCodec.encode row ++ tail) = .ok (row,tail) := rowCodec.roundtrip row tail\\n\\n/-- Reuse the original committed byte references, not a copied old matrix.\\nAppend-only IO is an explicit premise, not a claim about arbitrary file writes. -/\\ntheorem row_chunks_preserved_by_append (row : Row) (before added : ByteArray)\\n    (committed : ∀ blob ∈ row.chunks, blob.offset + blob.bytes ≤ before.size) :\\n    ∀ blob ∈ row.chunks,\\n      (before ++ added).extract blob.offset (blob.offset + blob.bytes) =\\n        before.extract blob.offset (blob.offset + blob.bytes) := by\\n  intro blob member\\n  exact PageMap.blob_bytes_preserved_by_append before added blob (committed blob member)\\n\\ndef implementation := Sha256.hex ((include_str \\\"VectorMatrix.lean\\\").toUTF8 ++\\n  (include_str \\\"../tools/WindowCentroid.lean\\\").toUTF8)\\n\\ndef maxRowBytes : Nat := 4096*8\\n\\ndef contract (model encoder : String) :=\\n  Sha256.hex (toJson [model,encoder,implementation]).compress.toUTF8\\n\\ndef authority (model encoder : String) := \\\"eggshell.projected-matrix:\\\" ++ contract model encoder\\n\\ndef folder (root : System.FilePath) (model encoder : String) :=\\n  root / \\\"projections\\\" / contract model encoder\\n\\n/-- Counts and directory share one atomic PageMap publication. -/\\nstructure Stats where\\n  rows : Nat := 0\\n  bytes : Nat := 0\\n  deriving ToJson\\n\\ndef statsCodec := (Wire.natural.product Wire.natural).iso\\n  (fun stats : Stats => (stats.rows,stats.bytes))\\n  (fun (rows,bytes) => Stats.mk rows bytes)\\n  (by intro stats; cases stats; rfl)\\n\\ntheorem stats_roundtrip (stats : Stats) (tail : List UInt8) :\\n    statsCodec.decode (statsCodec.encode stats ++ tail) = .ok (stats,tail) := statsCodec.roundtrip stats tail\\n\\nstructure Manifest where\\n  rows : Nat\\n  bytes : Nat\\n\\nstructure Ready where\\n  metadata : Manifest\\n  snapshot : PageMap.Snapshot\\n\\ndef statistics (snapshot : PageMap.Snapshot) : IO Stats := do\\n  if snapshot.head.root.isNone then return {}\\n  let some encoded ← snapshot.get \\\"stats\\\" | throw (IO.userError \\\"missing projection statistics\\\")\\n  let (stats,tail) ← IO.ofExcept (statsCodec.decode encoded.toList)\\n  unless tail.isEmpty && (statsCodec.encode stats).toByteArray == encoded &&\\n      0 < stats.rows && 0 < stats.bytes &&\\n      snapshot.head.root.any (·.rows == stats.rows+1) do\\n    throw (IO.userError \\\"projection statistics disagree with publication\\\")\\n  return stats\\n\\n/-- One head and one bounded directory path, never the complete population. -/\\ndef open? (root : System.FilePath) (model encoder : String) : IO (Option Ready) := do\\n  let some snapshot ← PageMap.open? (folder root model encoder) | return none\\n  unless snapshot.head.authority == authority model encoder do\\n    throw (IO.userError \\\"foreign projection authority\\\")\\n  if snapshot.head.root.isNone then return none\\n  let stats ← statistics snapshot\\n  return some ⟨⟨stats.rows,stats.bytes⟩,snapshot⟩\\n\\ndef ready (root : System.FilePath) (model encoder : String) : IO Bool := do\\n  try return (← open? root model encoder).isSome catch _ => return false\\n\\ndef decodeRow (encoded : ByteArray) : IO Row := do\\n  let (row,tail) ← IO.ofExcept (rowCodec.decode encoded.toList)\\n  unless tail.isEmpty && (rowCodec.encode row).toByteArray == encoded &&\\n      0 < row.bytes && row.bytes ≤ maxRowBytes && row.bytes % 8 == 0 &&\\n      row.coverage.utf8ByteSize ≤ 4096 && row.chunks.length == (row.bytes+4095)/4096 do\\n    throw (IO.userError \\\"invalid numerical projection row\\\")\\n  return row\\n\\ndef readRow (snapshot : PageMap.Snapshot) (row : Row) : IO (String × String) := do\\n  unless (← FileSystem.readVersion snapshot.handle).bytes ≥ snapshot.head.bytes do\\n    throw (IO.userError \\\"projection committed prefix was truncated\\\")\\n  let mut bytes := ByteArray.empty\\n  for chunk in row.chunks do\\n    unless chunk.bytes == min 4096 (row.bytes-bytes.size) do\\n      throw (IO.userError \\\"invalid projection chunk shape\\\")\\n    bytes := bytes ++ (← snapshot.readBlob chunk)\\n  unless bytes.size == row.bytes &&\\n      (← FileSystem.readVersion snapshot.handle).bytes ≥ snapshot.head.bytes do\\n    throw (IO.userError \\\"projection committed prefix changed\\\")\\n  return (row.coverage,Blake3.hex bytes)\\n\\n/-- Pinned heads never gain references to a concurrent/unpublished suffix. -/\\ndef read (ready : Ready) (key : String) : IO (Option (String × String)) := do\\n  unless Receipt.validId key do throw (IO.userError \\\"invalid projection key\\\")\\n  let some encoded ← ready.snapshot.get (\\\"row:\\\" ++ key) | return none\\n  some <$> readRow ready.snapshot (← decodeRow encoded)\\n\\ndef decodeHex (encoded : String) : Except String ByteArray := do\\n  let input := encoded.toUTF8\\n  unless 0 < input.size && input.size % 16 == 0 && input.size ≤ maxRowBytes*2 do\\n    throw \\\"invalid projected numerical shape\\\"\\n  let mut bytes := ByteArray.empty\\n  for index in [:input.size / 2] do\\n    let high ← WindowCentroid.digit input[index*2]!\\n    let low ← WindowCentroid.digit input[index*2+1]!\\n    bytes := bytes.push (high*16+low).toUInt8\\n  return bytes\\n\\nstructure Entry where\\n  key : String\\n  coverage : String\\n  projected : String\\n\\nstructure Result where\\n  mode : String\\n  rows : Nat\\n  bytes : Nat\\n  elapsedMs : Nat\\n  requested : Nat := 0\\n  produced : Nat := 0\\n  added : Nat := 0\\n  reused : Nat := 0\\n  writtenBytes : Nat := 0\\n  deriving ToJson\\n\\n/-- Bulk construction buffers new rows only. -/\\nstructure Level where\\n  refs : List PageMap.Ref\\n  bounded : refs.length < 32\\n\\ndef buffered (levels : List Level) : Nat := (levels.map (·.refs.length)).sum\\n\\ntheorem buffered_bound (levels : List Level) : buffered levels ≤ 31*levels.length := by\\n  induction levels with\\n  | nil => simp [buffered]\\n  | cons level rest ih =>\\n      have := level.bounded\\n      simp only [buffered,List.map_cons,List.sum_cons,List.length_cons] at *\\n      omega\\n\\ndef carry (writer : PageMap.Writer) (ref : PageMap.Ref) : List Level → IO (List Level)\\n  | [] => return [⟨[ref],by simp⟩]\\n  | level :: rest => do\\n      if fits : level.refs.length < 31 then\\n        return ⟨ref :: level.refs,by simp; omega⟩ :: rest\\n      else\\n        let parent ← writer.appendPage (.branch (ref :: level.refs).reverse)\\n        return ⟨[],by simp⟩ :: (← carry writer parent rest)\\n\\ndef flushLeaves (writer : PageMap.Writer) (rows : List PageMap.Row)\\n    (levels : List Level) : IO (List Level) := do\\n  if rows.isEmpty then return levels\\n  let mut levels := levels\\n  for ref in ← writer.leaves rows.reverse do levels ← carry writer ref levels\\n  return levels\\n\\ndef finish (writer : PageMap.Writer) (levels : List Level) : IO PageMap.Ref := do\\n  let mut pending : Option PageMap.Ref := none\\n  for (level,index) in levels.zipIdx do\\n    let children := (pending.toList ++ level.refs).reverse\\n    if index+1 == levels.length then return ← writer.finishRoots children\\n    if !children.isEmpty then pending := some (← writer.appendPage (.branch children))\\n  throw (IO.userError \\\"empty numerical projections\\\")\\n\\ndef appendRow (writer : PageMap.Writer) (entry : Entry) : IO (PageMap.Row × Nat) := do\\n  unless Receipt.validId entry.key && entry.coverage.utf8ByteSize ≤ 4096 do\\n    throw (IO.userError \\\"invalid numerical projection entry\\\")\\n  let bytes ← IO.ofExcept (decodeHex entry.projected)\\n  unless (← writer.extent.get)+bytes.size+65536 < 2^63 do\\n    throw (IO.userError \\\"projections exceed filesystem extent\\\")\\n  let mut chunks := []\\n  let mut offset := 0\\n  while offset < bytes.size do\\n    let part := bytes.extract offset (min bytes.size (offset+4096))\\n    if valid : 0 < part.size ∧ part.size ≤ 4096 then\\n      chunks := (← writer.appendBlob part valid.1 valid.2) :: chunks\\n    else throw (IO.userError \\\"invalid numerical projection chunk\\\")\\n    offset := offset+part.size\\n  let row : Row := ⟨entry.coverage,bytes.size,chunks.reverse⟩\\n  return ((\\\"row:\\\" ++ entry.key,some (rowCodec.encode row).toByteArray),bytes.size)\\n\\nprivate def ensureClaimed (root : System.FilePath) (model encoder : String) (keys : List String)\\n    (produce : String → IO Entry) (started : Nat) : IO Result := do\\n  let path := folder root model encoder\\n  let snapshot ← match ← PageMap.open? path with\\n    | some snapshot => pure snapshot\\n    | none => PageMap.create path (authority model encoder)\\n  unless snapshot.head.authority == authority model encoder do\\n    throw (IO.userError \\\"foreign projection authority\\\")\\n  let before ← statistics snapshot\\n  let initial := snapshot.head.root.isNone\\n  let ((stats,produced,added),_,written) ← PageMap.withWriter snapshot fun writer => do\\n    let mut stats := before\\n    let mut produced := 0\\n    let mut added := 0\\n    let mut levels := []\\n    let mut rows := []\\n    for key in keys do\\n      let previous ← (← snapshot.get (\\\"row:\\\" ++ key)).mapM decodeRow\\n      let valid ← match previous with\\n        | none => pure false\\n        | some row => try let _ ← readRow snapshot row; pure true catch _ => pure false\\n      if valid then continue\\n      let entry ← produce key\\n      unless entry.key == key do throw (IO.userError \\\"projection producer returned a different key\\\")\\n      let (row,bytes) ← appendRow writer entry\\n      let previousBytes := previous.map (·.bytes) |>.getD 0\\n      unless previousBytes ≤ stats.bytes do throw (IO.userError \\\"projection byte accounting disagrees\\\")\\n      stats := ⟨stats.rows+(if previous.isNone then 1 else 0),stats.bytes-previousBytes+bytes⟩\\n      produced := produced+1\\n      if previous.isNone then added := added+1\\n      if initial then\\n        rows := row :: rows\\n        if produced % 64 == 0 then\\n          levels ← flushLeaves writer rows levels\\n          rows := []\\n      else\\n        writer.put row.1 row.2\\n        if produced % 64 == 0 then writer.flush\\n    if produced > 0 then\\n      if initial then\\n        levels ← flushLeaves writer rows levels\\n        writer.root.set (some (← finish writer levels))\\n      writer.put \\\"stats\\\" (some (statsCodec.encode stats).toByteArray)\\n    return (stats,produced,added)\\n  let mode := if produced == 0 then \\\"warm\\\" else if initial then \\\"prepared\\\" else \\\"incremental\\\"\\n  return {\\n    mode := mode\\n    rows := stats.rows\\n    bytes := stats.bytes\\n    elapsedMs := (← IO.monoMsNow)-started\\n    requested := keys.length\\n    produced := produced\\n    added := added\\n    reused := keys.length-produced\\n    writtenBytes := written }\\n\\n/-- Complete or delta key requests never reproduce valid old projections.\\nThe claim covers creation, suffix recovery, checking and publication. Input\\nenumeration remains proportional to requested keys; no full owner scan is here. -/\\nopaque ensureUsing (root : System.FilePath) (model encoder : String) (keys : List String)\\n    (produce : String → IO Entry) : IO Result := do\\n  let started ← IO.monoMsNow\\n  if keys.isEmpty then return {mode := \\\"empty\\\",rows := 0,bytes := 0,elapsedMs := 0}\\n  let keys := keys.mergeSort\\n  let mut previous : Option String := none\\n  for key in keys do\\n    unless Receipt.validId key && previous.all (· < key) do\\n      throw (IO.userError \\\"duplicate or invalid numerical projection key\\\")\\n    previous := some key\\n  let path ← Sidecar.childDirectory root \\\"projections\\\"\\n  let lock := path / (contract model encoder ++ \\\".writer\\\")\\n  FileSystem.immutableExistingBytes lock ByteArray.empty\\n  let guard ← FileSystem.openRead lock.toString\\n  unless ← FileSystem.tryReadLock guard true do throw (IO.userError \\\"projection preparer is busy\\\")\\n  try ensureClaimed root model encoder keys produce started\\n  finally FileSystem.unlockRead guard\\n\\nend Eggshell.VectorMatrix\\n\",[[\"VectorMatrix.lean\",\"module\\npublic import Eggshell.DB.Sidecar\\npublic import Eggshell.DB.Wire\\npublic import Eggshell.Receipt\\npublic import Eggshell.Sha256\\npublic import tools.WindowCentroid\\n\\n@[expose] public section\\n\\nnamespace Eggshell.VectorMatrix\\nopen Lean DB\\n\\n/-- Numerical hints only. Original observation and Work authority remain\\noutside this store, even when identical inputs share a projection. -/\\nstructure Row where\\n  coverage : String\\n  bytes : Nat\\n  chunks : List PageMap.Blob\\n\\ndef rowCodec := (Wire.text.product (Wire.natural.product (Wire.list PageMap.blobCodec))).iso\\n  (fun row : Row => (row.coverage,row.bytes,row.chunks))\\n  (fun (coverage,bytes,chunks) => Row.mk coverage bytes chunks)\\n  (by intro row; cases row; rfl)\\n\\ntheorem row_roundtrip (row : Row) (tail : List UInt8) :\\n    rowCodec.decode (rowCodec.encode row ++ tail) = .ok (row,tail) := rowCodec.roundtrip row tail\\n\\n/-- Reuse the original committed byte references, not a copied old matrix.\\nAppend-only IO is an explicit premise, not a claim about arbitrary file writes. -/\\ntheorem row_chunks_preserved_by_append (row : Row) (before added : ByteArray)\\n    (committed : ∀ blob ∈ row.chunks, blob.offset + blob.bytes ≤ before.size) :\\n    ∀ blob ∈ row.chunks,\\n      (before ++ added).extract blob.offset (blob.offset + blob.bytes) =\\n        before.extract blob.offset (blob.offset + blob.bytes) := by\\n  intro blob member\\n  exact PageMap.blob_bytes_preserved_by_append before added blob (committed blob member)\\n\\ndef implementation := Sha256.hex ((include_str \\\"VectorMatrix.lean\\\").toUTF8 ++\\n  (include_str \\\"../tools/WindowCentroid.lean\\\").toUTF8)\\n\\ndef maxRowBytes : Nat := 4096*8\\n\\ndef contract (model encoder : String) :=\\n  Sha256.hex (toJson [model,encoder,implementation]).compress.toUTF8\\n\\ndef authority (model encoder : String) := \\\"eggshell.projected-matrix:\\\" ++ contract model encoder\\n\\ndef folder (root : System.FilePath) (model encoder : String) :=\\n  root / \\\"projections\\\" / contract model encoder\\n\\n/-- Counts and directory share one atomic PageMap publication. -/\\nstructure Stats where\\n  rows : Nat := 0\\n  bytes : Nat := 0\\n  deriving ToJson\\n\\ndef statsCodec := (Wire.natural.product Wire.natural).iso\\n  (fun stats : Stats => (stats.rows,stats.bytes))\\n  (fun (rows,bytes) => Stats.mk rows bytes)\\n  (by intro stats; cases stats; rfl)\\n\\ntheorem stats_roundtrip (stats : Stats) (tail : List UInt8) :\\n    statsCodec.decode (statsCodec.encode stats ++ tail) = .ok (stats,tail) := statsCodec.roundtrip stats tail\\n\\nstructure Manifest where\\n  rows : Nat\\n  bytes : Nat\\n\\nstructure Ready where\\n  metadata : Manifest\\n  snapshot : PageMap.Snapshot\\n\\ndef statistics (snapshot : PageMap.Snapshot) : IO Stats := do\\n  if snapshot.head.root.isNone then return {}\\n  let some encoded ← snapshot.get \\\"stats\\\" | throw (IO.userError \\\"missing projection statistics\\\")\\n  let (stats,tail) ← IO.ofExcept (statsCodec.decode encoded.toList)\\n  unless tail.isEmpty && (statsCodec.encode stats).toByteArray == encoded &&\\n      0 < stats.rows && 0 < stats.bytes &&\\n      snapshot.head.root.any (·.rows == stats.rows+1) do\\n    throw (IO.userError \\\"projection statistics disagree with publication\\\")\\n  return stats\\n\\n/-- One head and one bounded directory path, never the complete population. -/\\ndef open? (root : System.FilePath) (model encoder : String) : IO (Option Ready) := do\\n  let some snapshot ← PageMap.open? (folder root model encoder) | return none\\n  unless snapshot.head.authority == authority model encoder do\\n    throw (IO.userError \\\"foreign projection authority\\\")\\n  if snapshot.head.root.isNone then return none\\n  let stats ← statistics snapshot\\n  return some ⟨⟨stats.rows,stats.bytes⟩,snapshot⟩\\n\\ndef ready (root : System.FilePath) (model encoder : String) : IO Bool := do\\n  try return (← open? root model encoder).isSome catch _ => return false\\n\\ndef decodeRow (encoded : ByteArray) : IO Row := do\\n  let (row,tail) ← IO.ofExcept (rowCodec.decode encoded.toList)\\n  unless tail.isEmpty && (rowCodec.encode row).toByteArray == encoded &&\\n      0 < row.bytes && row.bytes ≤ maxRowBytes && row.bytes % 8 == 0 &&\\n      row.coverage.utf8ByteSize ≤ 4096 && row.chunks.length == (row.bytes+4095)/4096 do\\n    throw (IO.userError \\\"invalid numerical projection row\\\")\\n  return row\\n\\ndef readRow (snapshot : PageMap.Snapshot) (row : Row) : IO (String × String) := do\\n  unless (← FileSystem.readVersion snapshot.handle).bytes ≥ snapshot.head.bytes do\\n    throw (IO.userError \\\"projection committed prefix was truncated\\\")\\n  let mut bytes := ByteArray.empty\\n  for chunk in row.chunks do\\n    unless chunk.bytes == min 4096 (row.bytes-bytes.size) do\\n      throw (IO.userError \\\"invalid projection chunk shape\\\")\\n    bytes := bytes ++ (← snapshot.readBlob chunk)\\n  unless bytes.size == row.bytes &&\\n      (← FileSystem.readVersion snapshot.handle).bytes ≥ snapshot.head.bytes do\\n    throw (IO.userError \\\"projection committed prefix changed\\\")\\n  return (row.coverage,Blake3.hex bytes)\\n\\n/-- Pinned heads never gain references to a concurrent/unpublished suffix. -/\\ndef read (ready : Ready) (key : String) : IO (Option (String × String)) := do\\n  unless Receipt.validId key do throw (IO.userError \\\"invalid projection key\\\")\\n  let some encoded ← ready.snapshot.get (\\\"row:\\\" ++ key) | return none\\n  some <$> readRow ready.snapshot (← decodeRow encoded)\\n\\ndef decodeHex (encoded : String) : Except String ByteArray := do\\n  let input := encoded.toUTF8\\n  unless 0 < input.size && input.size % 16 == 0 && input.size ≤ maxRowBytes*2 do\\n    throw \\\"invalid projected numerical shape\\\"\\n  let mut bytes := ByteArray.empty\\n  for index in [:input.size / 2] do\\n    let high ← WindowCentroid.digit input[index*2]!\\n    let low ← WindowCentroid.digit input[index*2+1]!\\n    bytes := bytes.push (high*16+low).toUInt8\\n  return bytes\\n\\nstructure Entry where\\n  key : String\\n  coverage : String\\n  projected : String\\n\\nstructure Result where\\n  mode : String\\n  rows : Nat\\n  bytes : Nat\\n  elapsedMs : Nat\\n  requested : Nat := 0\\n  produced : Nat := 0\\n  added : Nat := 0\\n  reused : Nat := 0\\n  writtenBytes : Nat := 0\\n  deriving ToJson\\n\\n/-- Bulk construction buffers new rows only. -/\\nstructure Level where\\n  refs : List PageMap.Ref\\n  bounded : refs.length < 32\\n\\ndef buffered (levels : List Level) : Nat := (levels.map (·.refs.length)).sum\\n\\ntheorem buffered_bound (levels : List Level) : buffered levels ≤ 31*levels.length := by\\n  induction levels with\\n  | nil => simp [buffered]\\n  | cons level rest ih =>\\n      have := level.bounded\\n      simp only [buffered,List.map_cons,List.sum_cons,List.length_cons] at *\\n      omega\\n\\ndef carry (writer : PageMap.Writer) (ref : PageMap.Ref) : List Level → IO (List Level)\\n  | [] => return [⟨[ref],by simp⟩]\\n  | level :: rest => do\\n      if fits : level.refs.length < 31 then\\n        return ⟨ref :: level.refs,by simp; omega⟩ :: rest\\n      else\\n        let parent ← writer.appendPage (.branch (ref :: level.refs).reverse)\\n        return ⟨[],by simp⟩ :: (← carry writer parent rest)\\n\\ndef flushLeaves (writer : PageMap.Writer) (rows : List PageMap.Row)\\n    (levels : List Level) : IO (List Level) := do\\n  if rows.isEmpty then return levels\\n  let mut levels := levels\\n  for ref in ← writer.leaves rows.reverse do levels ← carry writer ref levels\\n  return levels\\n\\ndef finish (writer : PageMap.Writer) (levels : List Level) : IO PageMap.Ref := do\\n  let mut pending : Option PageMap.Ref := none\\n  for (level,index) in levels.zipIdx do\\n    let children := (pending.toList ++ level.refs).reverse\\n    if index+1 == levels.length then return ← writer.finishRoots children\\n    if !children.isEmpty then pending := some (← writer.appendPage (.branch children))\\n  throw (IO.userError \\\"empty numerical projections\\\")\\n\\ndef appendRow (writer : PageMap.Writer) (entry : Entry) : IO (PageMap.Row × Nat) := do\\n  unless Receipt.validId entry.key && entry.coverage.utf8ByteSize ≤ 4096 do\\n    throw (IO.userError \\\"invalid numerical projection entry\\\")\\n  let bytes ← IO.ofExcept (decodeHex entry.projected)\\n  unless (← writer.extent.get)+bytes.size+65536 < 2^63 do\\n    throw (IO.userError \\\"projections exceed filesystem extent\\\")\\n  let mut chunks := []\\n  let mut offset := 0\\n  while offset < bytes.size do\\n    let part := bytes.extract offset (min bytes.size (offset+4096))\\n    if valid : 0 < part.size ∧ part.size ≤ 4096 then\\n      chunks := (← writer.appendBlob part valid.1 valid.2) :: chunks\\n    else throw (IO.userError \\\"invalid numerical projection chunk\\\")\\n    offset := offset+part.size\\n  let row : Row := ⟨entry.coverage,bytes.size,chunks.reverse⟩\\n  return ((\\\"row:\\\" ++ entry.key,some (rowCodec.encode row).toByteArray),bytes.size)\\n\\nprivate def ensureClaimed (root : System.FilePath) (model encoder : String) (keys : List String)\\n    (produce : String → IO Entry) (started : Nat) : IO Result := do\\n  let path := folder root model encoder\\n  let snapshot ← match ← PageMap.open? path with\\n    | some snapshot => pure snapshot\\n    | none => PageMap.create path (authority model encoder)\\n  unless snapshot.head.authority == authority model encoder do\\n    throw (IO.userError \\\"foreign projection authority\\\")\\n  let before ← statistics snapshot\\n  let initial := snapshot.head.root.isNone\\n  let ((stats,produced,added),_,written) ← PageMap.withWriter snapshot fun writer => do\\n    let mut stats := before\\n    let mut produced := 0\\n    let mut added := 0\\n    let mut levels := []\\n    let mut rows := []\\n    for key in keys do\\n      let previous ← (← snapshot.get (\\\"row:\\\" ++ key)).mapM decodeRow\\n      let valid ← match previous with\\n        | none => pure false\\n        | some row => try let _ ← readRow snapshot row; pure true catch _ => pure false\\n      if valid then continue\\n      let entry ← produce key\\n      unless entry.key == key do throw (IO.userError \\\"projection producer returned a different key\\\")\\n      let (row,bytes) ← appendRow writer entry\\n      let previousBytes := previous.map (·.bytes) |>.getD 0\\n      unless previousBytes ≤ stats.bytes do throw (IO.userError \\\"projection byte accounting disagrees\\\")\\n      stats := ⟨stats.rows+(if previous.isNone then 1 else 0),stats.bytes-previousBytes+bytes⟩\\n      produced := produced+1\\n      if previous.isNone then added := added+1\\n      if initial then\\n        rows := row :: rows\\n        if produced % 64 == 0 then\\n          levels ← flushLeaves writer rows levels\\n          rows := []\\n      else\\n        writer.put row.1 row.2\\n        if produced % 64 == 0 then writer.flush\\n    if produced > 0 then\\n      if initial then\\n        levels ← flushLeaves writer rows levels\\n        writer.root.set (some (← finish writer levels))\\n      writer.put \\\"stats\\\" (some (statsCodec.encode stats).toByteArray)\\n    return (stats,produced,added)\\n  let mode := if produced == 0 then \\\"warm\\\" else if initial then \\\"prepared\\\" else \\\"incremental\\\"\\n  return {\\n    mode := mode\\n    rows := stats.rows\\n    bytes := stats.bytes\\n    elapsedMs := (← IO.monoMsNow)-started\\n    requested := keys.length\\n    produced := produced\\n    added := added\\n    reused := keys.length-produced\\n    writtenBytes := written }\\n\\n/-- Complete or delta key requests never reproduce valid old projections.\\nThe claim covers creation, suffix recovery, checking and publication. Input\\nenumeration remains proportional to requested keys; no full owner scan is here. -/\\nopaque ensureUsing (root : System.FilePath) (model encoder : String) (keys : List String)\\n    (produce : String → IO Entry) : IO Result := do\\n  let started ← IO.monoMsNow\\n  if keys.isEmpty then return {mode := \\\"empty\\\",rows := 0,bytes := 0,elapsedMs := 0}\\n  let keys := keys.mergeSort\\n  let mut previous : Option String := none\\n  for key in keys do\\n    unless Receipt.validId key && previous.all (· < key) do\\n      throw (IO.userError \\\"duplicate or invalid numerical projection key\\\")\\n    previous := some key\\n  let path ← Sidecar.childDirectory root \\\"projections\\\"\\n  let lock := path / (contract model encoder ++ \\\".writer\\\")\\n  FileSystem.immutableExistingBytes lock ByteArray.empty\\n  let guard ← FileSystem.openRead lock.toString\\n  unless ← FileSystem.tryReadLock guard true do throw (IO.userError \\\"projection preparer is busy\\\")\\n  try ensureClaimed root model encoder keys produce started\\n  finally FileSystem.unlockRead guard\\n\\nend Eggshell.VectorMatrix\\n\"],[\"../tools/WindowCentroid.lean\",\"module\\n\\npublic import Eggshell.Blake3\\n\\n@[expose] public section\\n\\nnamespace Eggshell.WindowCentroid\\n\\n/-- Experimental scoring projection. Keep every encoded segment, but give one\\noriginal DB window one normalized vector. Weights count newly covered source\\ntokens, so a short overflow tail cannot acquire the weight of a full segment.\\nNo cache or source bytes change. Adoption requires matched token/quality trials. -/\\ndef weights (tokens capacity overlap count : Nat) : Except String (Array Nat) := do\\n  unless 0 < capacity && overlap < capacity && 0 < count && count ≤ 512 do\\n    throw \\\"invalid segment geometry\\\"\\n  let step := capacity - overlap\\n  let expected := if tokens ≤ capacity then 1 else 1 + (tokens - capacity + step - 1) / step\\n  unless count == expected do throw \\\"segment count disagrees with source token coverage\\\"\\n  if tokens == 0 then return #[1]\\n  let mut result := #[]\\n  for index in [:count] do\\n    let length := min capacity (tokens - index * step)\\n    let carried := if index == 0 then 0 else overlap\\n    unless carried < length do throw \\\"segment adds no source tokens\\\"\\n    result := result.push (length - carried)\\n  unless result.foldl (· + ·) 0 == tokens do throw \\\"source token weights are incomplete\\\"\\n  return result\\n\\ndef digit (byte : UInt8) : Except String UInt64 :=\\n  if 48 ≤ byte && byte ≤ 57 then .ok (byte - 48).toUInt64\\n  else if 97 ≤ byte && byte ≤ 102 then .ok (byte - 87).toUInt64\\n  else .error \\\"noncanonical packed vector\\\"\\n\\ndef unpack (packed : String) : Except String (Array Float) := do\\n  let bytes := packed.toUTF8\\n  unless 0 < bytes.size && bytes.size % 16 == 0 && bytes.size / 16 ≤ 4096 do\\n    throw \\\"invalid packed vector shape\\\"\\n  let mut values := #[]\\n  for word in [:bytes.size / 16] do\\n    let mut bits : UInt64 := 0\\n    for byte in [:8] do\\n      let offset := word * 16 + byte * 2\\n      let value := (← digit bytes[offset]!) * 16 + (← digit bytes[offset + 1]!)\\n      bits := bits ||| (value <<< (byte * 8).toUInt64)\\n    let value := Float.ofBits bits\\n    unless !value.isNaN && !value.isInf do throw \\\"nonfinite packed vector\\\"\\n    values := values.push value\\n  return values\\n\\ndef pack (values : Array Float) : String := Id.run do\\n  let mut bytes := ByteArray.empty\\n  for value in values do\\n    for byte in [:8] do bytes := bytes.push ((value.toBits >>> (byte * 8).toUInt64).toUInt8)\\n  return Blake3.hex bytes\\n\\ndef project (vectors : Array String) (tokens capacity overlap : Nat) : Except String String := do\\n  let counts ← weights tokens capacity overlap vectors.size\\n  let decoded ← vectors.mapM unpack\\n  let dimension := decoded[0]!.size\\n  unless decoded.all (·.size == dimension) do throw \\\"segment dimensions disagree\\\"\\n  -- A one-segment window retains its exact original numerical representation.\\n  if vectors.size == 1 then return vectors[0]!\\n  let mut sum := Array.replicate dimension (0.0 : Float)\\n  for index in [:vectors.size] do\\n    let weight := counts[index]!.toFloat\\n    for coordinate in [:dimension] do\\n      sum := sum.set! coordinate (sum[coordinate]! + weight * decoded[index]![coordinate]!)\\n  let norm := Float.sqrt (sum.foldl (fun total value => total + value * value) 0.0)\\n  unless 0.0 < norm && !norm.isInf && !norm.isNaN do throw \\\"undefined window centroid\\\"\\n  return pack (sum.map (· / norm))\\n\\nend Eggshell.WindowCentroid\\n\"]]]"],["Eggshell.Warm","[\"module\\npublic import Eggshell.CanonicalSourceCache\\npublic import SourceCatalogue\\npublic import Eggshell.SourceDelta\\npublic import Eggshell.WindowOwners\\npublic import PartitionBuild\\n\\npublic import Eggshell.PluginModel\\npublic import Eggshell.SearchProvider\\npublic import Eggshell.SynapseJournal\\npublic import tools.FocusWindows\\npublic import tools.RetrievalIndex\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Warm\\nopen Lean\\n\\ndef planningContract := Sha256.hex ((include_str \\\"Warm.lean\\\").toUTF8 ++\\n  (include_str \\\"SourceDelta.lean\\\").toUTF8 ++ PartitionBuild.implementation.toUTF8 ++\\n  VectorPartition.implementation.toUTF8 ++ ProjectionCursor.implementation.toUTF8)\\n\\nstructure Checkpoint where\\n  source : DB.PageMap.Head\\n  change : Nat\\n  roots : Nat\\n  candidates : Nat\\n  model : String\\n  encoderContract : String\\n  focusContract : String\\n  projectionContract : String\\n  planningContract : String\\n  projection : Option DB.PageMap.Head\\n  deriving BEq, ToJson, FromJson\\n\\ndef model (command : List String) : IO String := do\\n  let _ :: \\\"search-provider\\\" :: args := command | throw (IO.userError \\\"unsupported warm provider\\\")\\n  let parsed ← IO.ofExcept (SearchProvider.parse {cache := .mk \\\".\\\", models := .mk \\\".\\\"} args)\\n  return parsed.model\\n\\ndef checkpoint (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO Checkpoint := do\\n  let model ← model target.command\\n  let sidecar ← DB.Sidecar.locate snapshot target.storage\\n  let projection ← try VectorMatrix.open? sidecar.semantic model SearchProvider.encoderContract catch _ => pure none\\n  return {\\n    source := snapshot.head\\n    change := ← Persistence.Store.getNat snapshot.get \\\"sourceChange\\\"\\n    roots := ← Persistence.Store.getNat snapshot.get \\\"roots\\\"\\n    candidates := ← Persistence.Store.getNat snapshot.get \\\"candidates\\\"\\n    model := model\\n    encoderContract := SearchProvider.encoderContract\\n    focusContract := Plugin.focusWindowContract\\n    projectionContract := VectorMatrix.implementation\\n    planningContract := planningContract\\n    projection := projection.map (·.snapshot.head) }\\n\\ndef Checkpoint.sameContract (previous current : Checkpoint) : Bool :=\\n  previous.source.identity == current.source.identity && previous.source.authority == current.source.authority &&\\n    previous.model == current.model && previous.encoderContract == current.encoderContract &&\\n    previous.focusContract == current.focusContract && previous.projectionContract == current.projectionContract &&\\n    previous.planningContract == current.planningContract\\n\\n/-- Root ordinals grow on insertion; the live candidate count also detects\\ndeletion. Derived query/matcher memo writes do not change these source counters. -/\\ndef Checkpoint.sameSources (previous current : Checkpoint) : Bool :=\\n  previous.sameContract current && previous.change == current.change &&\\n    previous.roots == current.roots && previous.candidates == current.candidates\\n\\ndef Checkpoint.retainsProjection (previous current : Checkpoint) : Bool :=\\n  match previous.projection, current.projection with\\n  | some before, some after =>\\n    before.identity == after.identity && before.authority == after.authority &&\\n      before.revision ≤ after.revision && before.bytes ≤ after.bytes\\n  | none, _ => previous.candidates == 0\\n  | _, _ => false\\n\\ndef checkpointPath (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO System.FilePath := do\\n  let key := Sha256.hex (toJson [← model target.command, SearchProvider.encoderContract,\\n    Plugin.focusWindowContract, VectorMatrix.implementation, planningContract]).compress.toUTF8\\n  return (← DB.Sidecar.locate snapshot target.storage).indexes / \\\"warm\\\" / key\\n\\ndef lexicalOnly (command : List String) : Bool :=\\n  match command with\\n  | _ :: \\\"search-provider\\\" :: args =>\\n    match SearchProvider.parse {cache := .mk \\\".\\\", models := .mk \\\".\\\"} args with\\n    | .ok options => options.mode == \\\"lexical\\\"\\n    | .error _ => false\\n  | _ => false\\n\\n/-- A rebuildable scheduling hint only. Actual numerical reads validate their\\ninputs and record private repair events; search deadlines leave it intact. -/\\ndef required (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO Bool := do\\n  unless ← Synapses.CanonicalSource.Cache.ready snapshot do return true\\n  unless (← WindowOwners.openShared? snapshot).isSome do return true\\n  unless ← RetrievalResearch.Index.ready snapshot do return true\\n  if lexicalOnly target.command then return false\\n  let _ :: \\\"search-provider\\\" :: _ := target.command | return false\\n  try\\n    let previous ← (Plugin.readBoundedJson (← checkpointPath target snapshot) 65536 : IO Checkpoint)\\n    let current ← checkpoint target snapshot\\n    unless previous.sameSources current && previous.retainsProjection current do return true\\n    if previous.source != current.source then\\n      let some delta ← SourceDelta.read? snapshot previous.source | return true\\n      unless delta.owners.isEmpty do return true\\n    if ← PreparationDebt.pending target.owner current.model SearchProvider.encoderContract then return true\\n    -- An empty publication has no numerical rows to prepare. Its completed\\n    -- checkpoint must not enqueue the same impossible matrix forever.\\n    if previous.candidates == 0 then return false\\n    let sidecar ← DB.Sidecar.locate snapshot target.storage\\n    let some matrix ← VectorMatrix.open? sidecar.semantic current.model SearchProvider.encoderContract | return true\\n    return (← PartitionBuild.open? sidecar.semantic current.model SearchProvider.encoderContract snapshot matrix).isNone\\n  catch _ => pure true\\n\\ndef mark (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO Unit := do\\n  let sidecar ← DB.Sidecar.prepare target.owner target.storage\\n  let _ ← DB.Sidecar.childDirectory sidecar.indexes \\\"warm\\\"\\n  let path ← checkpointPath target snapshot\\n  let value ← checkpoint target snapshot\\n  unless value.candidates == 0 || value.projection.isSome do\\n    throw (IO.userError \\\"cannot mark unprepared projections\\\")\\n  let previous ← try some <$> (Plugin.readBoundedJson path 65536 : IO Checkpoint) catch _ => pure none\\n  if previous.any (fun old => (old.source == value.source && old.sameSources value && old.retainsProjection value) ||\\n      (old.sameContract value && old.source.revision > value.source.revision)) then return\\n  FileSystem.atomicExistingBytes path (toJson value).compress.toUTF8\\n\\nstructure Window where\\n  document : Persistence.Store.SearchDocument\\n  index : Nat\\n  key : String\\n  start : Nat\\n\\ninductive InputState where\\n  | missing\\n  | invalid\\n  | valid (coverage : SearchProvider.EncodingCoverage)\\n\\nstructure WindowCoverage where\\n  windows : Nat := 0\\n  valid : Nat := 0\\n  missing : Nat := 0\\n  invalid : Nat := 0\\n  input : SearchProvider.InputTotals := {}\\n  deriving ToJson\\n\\ndef WindowCoverage.observe (counts : WindowCoverage) (state : InputState) : WindowCoverage :=\\n  let counts := {counts with windows := counts.windows + 1}\\n  match state with\\n  | .missing => {counts with missing := counts.missing + 1}\\n  | .invalid => {counts with invalid := counts.invalid + 1}\\n  | .valid coverage => {counts with valid := counts.valid + 1, input := counts.input.add coverage}\\n\\nstructure Coverage where\\n  database : DB.Sidecar.Owner\\n  revision : Nat\\n  model : String\\n  windows : Nat\\n  valid : Nat\\n  missing : Nat\\n  invalid : Nat\\n  encoderContract : String\\n  input : SearchProvider.InputTotals\\n  focusContract : String\\n  discovery : WindowCoverage\\n  focus : WindowCoverage\\n  deriving ToJson\\n\\nstructure Inspection where\\n  coverage : Coverage\\n  needed : List Window\\n\\n/-- Read the configured numerical cache format without starting the provider.\\nThe DB owner overrides a command's process scratch path, as at indexed search. -/\\ndef options (snapshot : DB.PageMap.Snapshot) (command : List String)\\n    (storage : DB.Sidecar.Storage := .database) : IO SearchProvider.Options := do\\n  let _ :: \\\"search-provider\\\" :: arguments := command |\\n    throw (IO.userError \\\"cache inspection requires the Eggshell numerical provider\\\")\\n  DB.Sidecar.observe snapshot\\n  let sidecar ← DB.Sidecar.locate snapshot storage\\n  let other ← DB.Sidecar.locate snapshot (if storage == .database then .user else .database)\\n  let parsed ← IO.ofExcept (SearchProvider.parse {\\n    cache := sidecar.semantic, models := (MiniLM.layout (← Paths.installRoot)).models } arguments)\\n  if parsed.mode == \\\"lexical\\\" then\\n    throw (IO.userError \\\"lexical-only providers do not maintain numerical window caches\\\")\\n  pure {parsed with\\n    cache := sidecar.semantic, fallback := some other.semantic\\n    owner := some (DB.Sidecar.Owner.ofSnapshot snapshot)}\\n\\ndef inspectInput (options : SearchProvider.Options) (key : String) : IO InputState := do\\n  let paths := SearchProvider.vectorPaths options (SearchProvider.windowCacheKey options.model key)\\n  if ← paths.allM (fun path => return (← FileSystem.symlinkMetadata? path).isNone) then return .missing\\n  try\\n    let cached ← SearchProvider.indexedWindow options key\\n    pure (.valid cached.coverage)\\n  catch _ => pure .invalid\\n\\ndef planDocuments (snapshot : DB.PageMap.Snapshot) (documents : List Persistence.Store.SearchDocument)\\n    (work : Persistence.Store.SearchDocument → IO Value) : IO (List Window × List Window) := do\\n  let mut discovery : Array Window := #[]\\n  let mut focus : Array Window := #[]\\n  for document in documents do\\n    let some text := Matcher.atomText? (← work document) | throw (IO.userError \\\"warm Work is not indexed text\\\")\\n    for (key, index) in document.windows.zipIdx do\\n      let original : Window := ⟨document, index, key, 0⟩\\n      discovery := discovery.push original\\n      let start := Plugin.evidenceWindowStart text.length index\\n      if start == 0 then focus := focus.push original else\\n        let originalText ← Persistence.Store.readSearchWindow snapshot document index\\n        let view := Plugin.evidenceWindowText text.length index originalText\\n        focus := focus.push ⟨document, index, Persistence.Store.windowKey view, start⟩\\n  pure (discovery.toList, focus.toList)\\n\\n/-- Only prefixes intersecting Work need an original bounded read. -/\\ndef planWindows (snapshot : DB.PageMap.Snapshot) : IO (List Window × List Window) := do\\n  let (discovery,focus) ← SourceCatalogue.fold snapshot (fun (discovery,focus) ordinal document => do\\n    let windows ← planDocuments snapshot [document] fun document => Persistence.Store.readNode snapshot snapshot.get document.work\\n    return (discovery.push (ordinal,windows.1),focus.push (ordinal,windows.2))) (#[],#[])\\n  -- Original numeric order still determines bounded embedding batches.\\n  let ordered := fun rows : Array (Nat × List Window) =>\\n    ((rows.toList.mergeSort fun a b => a.1 ≤ b.1).flatMap Prod.snd)\\n  pure (ordered discovery,ordered focus)\\n\\nstructure Plan where\\n  scope : String\\n  reason : String\\n  publications : Nat := 0\\n  owners : Nat := 0\\n  windows : List Window × List Window\\n\\n/-- Reuse requires the same source/storage/encoding contract and retained\\nprojection incarnation. A discontinuous journal always selects full planning. -/\\ndef plan (snapshot : DB.PageMap.Snapshot) (target : Plugin.IndexTarget)\\n    (verify : Bool) (repair : Bool) : IO Plan := do\\n  let current ← checkpoint target snapshot\\n  let previous ← try some <$> (Plugin.readBoundedJson (← checkpointPath target snapshot) 65536 : IO Checkpoint)\\n    catch _ => pure none\\n  if !verify && !repair then\\n    if let some previous := previous then\\n      if previous.sameContract current && previous.retainsProjection current then\\n        if previous.source == current.source && previous.sameSources current then\\n          return {scope := \\\"publication-delta\\\",reason := \\\"source-unchanged\\\",windows := ([],[])}\\n        if let some delta ← SourceDelta.read? snapshot previous.source then\\n          let some history ← DB.PageMap.HistoryReader.make? snapshot previous.source |\\n            throw (IO.userError \\\"verified warm history was not retained\\\")\\n          if previous.roots == (← Persistence.Store.getNat history.snapshot.get \\\"roots\\\") &&\\n              previous.candidates == (← Persistence.Store.getNat history.snapshot.get \\\"candidates\\\") &&\\n              previous.change == (← Persistence.Store.getNat history.snapshot.get \\\"sourceChange\\\") then\\n            let documents ← SourceDelta.documents snapshot delta.owners\\n            let reader ← Persistence.Store.NodeReader.new snapshot\\n            let windows ← planDocuments snapshot documents fun document => reader.read document.work\\n            return {\\n              scope := \\\"publication-delta\\\"\\n              reason := \\\"verified-source-history\\\"\\n              publications := delta.records\\n              owners := documents.length\\n              windows := windows }\\n  return {\\n    scope := \\\"full-source\\\"\\n    reason := if verify then \\\"explicit-verification\\\" else if repair then \\\"observed-unavailable-input\\\" else \\\"no-usable-history\\\"\\n    windows := ← planWindows snapshot }\\n\\ndef viewCoverage (known : Std.HashMap String InputState) (windows : List Window) : IO WindowCoverage := do\\n  let mut seen : Std.HashSet String := {}\\n  let mut result : WindowCoverage := {}\\n  for window in windows do\\n    unless seen.contains window.key do\\n      seen := seen.insert window.key\\n      let some state := known[window.key]? | throw (IO.userError \\\"warm input coverage lost a planned key\\\")\\n      result := result.observe state\\n  pure result\\n\\n/-- All original and focus-view keys are inspected once. Query vectors and\\nretired keys do not enter either live-view denominator. -/\\ndef inspectWindows (snapshot : DB.PageMap.Snapshot) (options : SearchProvider.Options)\\n    (discovery focus : List Window) : IO Inspection := do\\n  let mut known : Std.HashMap String InputState := {}\\n  let mut needed : Array Window := #[]\\n  let mut union : WindowCoverage := {}\\n  for window in discovery ++ focus do\\n    unless known.contains window.key do\\n      let state ← inspectInput options window.key\\n      known := known.insert window.key state\\n      union := union.observe state\\n      match state with\\n      | .valid _ => pure ()\\n      | _ => needed := needed.push window\\n  pure {\\n    coverage := {\\n      database := DB.Sidecar.Owner.ofSnapshot snapshot, revision := snapshot.head.revision\\n      model := options.model, windows := union.windows, valid := union.valid\\n      missing := union.missing, invalid := union.invalid, input := union.input\\n      encoderContract := SearchProvider.encoderContract, focusContract := Plugin.focusWindowContract\\n      discovery := ← viewCoverage known discovery, focus := ← viewCoverage known focus }\\n    needed := needed.toList }\\n\\ndef inspect (snapshot : DB.PageMap.Snapshot) (options : SearchProvider.Options) : IO Inspection := do\\n  let (discovery,focus) ← planWindows snapshot\\n  inspectWindows snapshot options discovery focus\\n\\n\\nstructure Result where\\n  before : Coverage\\n  after : Coverage\\n  requested : Nat\\n  batches : Nat\\n  elapsedMs : Nat\\n  lexical : RetrievalResearch.Index.Result\\n  canonical : Synapses.CanonicalSource.Cache.Result\\n  scope : String := \\\"full-source\\\"\\n  planReason : String := \\\"full-source\\\"\\n  changedOwners : Nat := 0\\n  publications : Nat := 0\\n  projections : Option VectorMatrix.Result := none\\n  windowOwners : Option WindowOwners.Result := none\\n  partition : Option PartitionBuild.Preparation := none\\n  deriving ToJson\\n\\n/-- Preparation consumes exactly the captured source publication. A concurrent\\nsource commit creates later debt; it does not invalidate completed prefix work\\nor let a view claim coverage beyond the bytes it actually consumed. -/\\ndef refreshSource (snapshot : DB.PageMap.Snapshot) (storage : DB.Sidecar.Storage)\\n    (deadline : Nat) : IO (DB.PageMap.Snapshot × Synapses.Journal.Result) := do\\n  let result ← Synapses.Journal.refresh snapshot storage deadline\\n  return (snapshot,result)\\n\\n/-- Preparation uses verified publication deltas; an explicit verification request\\ninspects the complete source. Neither runs inside a cold search hook.\\nHydrate missing original windows in bounded batches and require exact ACKs. A\\nfailed batch leaves completed cache writes for a subsequent invocation. -/\\ndef runTarget (snapshot : DB.PageMap.Snapshot) (target : Plugin.IndexTarget)\\n    (verify : Bool := false) : IO Result := do\\n  let started ← IO.monoMsNow\\n  let (snapshot,_) ← refreshSource snapshot target.storage ((← IO.monoMsNow)+60000)\\n  let canonical ← Synapses.CanonicalSource.Cache.refresh snapshot target.storage\\n  let windowOwners ← WindowOwners.refresh snapshot target.storage\\n  let lexical ← RetrievalResearch.Index.warm snapshot target.storage\\n  if lexicalOnly target.command then\\n    let empty : Coverage := {\\n      database := DB.Sidecar.Owner.ofSnapshot snapshot\\n      revision := snapshot.head.revision, model := \\\"lexical-only\\\", windows := 0\\n      valid := 0, missing := 0, invalid := 0\\n      encoderContract := SearchProvider.encoderContract, input := {}\\n      focusContract := Plugin.focusWindowContract, discovery := {}, focus := {}}\\n    return {\\n      before := empty\\n      after := empty\\n      requested := 0\\n      batches := 0\\n      elapsedMs := (← IO.monoMsNow)-started\\n      lexical := lexical\\n      canonical := canonical\\n      windowOwners := some windowOwners\\n      scope := \\\"lexical-only\\\" }\\n  let settings ← options snapshot target.command target.storage\\n  DB.Sidecar.withIndexClaim (DB.Sidecar.Owner.ofSnapshot snapshot) (fun _ => do\\n    let debt ← PreparationDebt.capture target.owner settings.model SearchProvider.encoderContract\\n    let selected ← plan snapshot target verify (!debt.isEmpty)\\n    let (discovery,focus) := selected.windows\\n    let before ← inspectWindows snapshot settings discovery focus\\n    let batches ← if before.needed.isEmpty then pure 0 else\\n      SemanticMatcher.withIndexProvider target.command fun running => do\\n        let mut remaining := before.needed\\n        let mut batches := 0\\n        while !remaining.isEmpty do\\n          let batch := remaining.take 32\\n          remaining := remaining.drop 32\\n          let items ← batch.mapM fun window => do\\n            let original ← Persistence.Store.readSearchWindow snapshot window.document window.index\\n            let text := (original.drop window.start).copy\\n            unless Persistence.Store.windowKey text == window.key do\\n              throw (IO.userError \\\"warm input disagrees with its pinned original suffix\\\")\\n            pure ({id := window.key, text} : SemanticMatcher.Item)\\n          let _ ← SemanticMatcher.indexWindows running items (DB.Sidecar.Owner.ofSnapshot snapshot) target.storage\\n          batches := batches + 1\\n        pure batches\\n    let after ← if before.needed.isEmpty then pure before else inspectWindows snapshot settings discovery focus\\n    unless after.needed.isEmpty do throw (IO.userError \\\"provider acknowledged windows without valid DB cache records\\\")\\n    let projections ← SearchProvider.prepareMatrix settings ((discovery ++ focus).map (·.key))\\n    let partition ← match ← VectorMatrix.open? settings.cache settings.model SearchProvider.encoderContract with\\n      | none =>\\n        if (← Persistence.Store.getNat snapshot.get \\\"candidates\\\") == 0 then pure none\\n        else throw (IO.userError \\\"warm did not publish projections\\\")\\n      | some matrix => do\\n        let prepared ← PartitionBuild.prepare settings.cache settings.model SearchProvider.encoderContract snapshot matrix\\n        let some _ ← PartitionBuild.open? settings.cache settings.model SearchProvider.encoderContract snapshot matrix |\\n          throw (IO.userError \\\"warm did not publish its assignment model\\\")\\n        pure (some prepared)\\n    mark target snapshot\\n    PreparationDebt.acknowledge target.owner settings.model SearchProvider.encoderContract debt\\n    return {\\n      before := before.coverage\\n      after := after.coverage\\n      requested := before.needed.length\\n      batches := batches\\n      elapsedMs := (← IO.monoMsNow)-started\\n      lexical := lexical\\n      canonical := canonical\\n      scope := selected.scope\\n      planReason := selected.reason\\n      changedOwners := selected.owners\\n      publications := selected.publications\\n      projections := some projections\\n      windowOwners := some windowOwners\\n      partition := partition }) target.storage\\n\\ndef run (snapshot : DB.PageMap.Snapshot) (command : List String) (writable : Bool := true) : IO Result := do\\n  let target ← Plugin.registerIndexTarget snapshot command writable\\n  runTarget snapshot target\\n\\nend Eggshell.Warm\\n\",[[\"Warm.lean\",\"module\\npublic import Eggshell.CanonicalSourceCache\\npublic import SourceCatalogue\\npublic import Eggshell.SourceDelta\\npublic import Eggshell.WindowOwners\\npublic import PartitionBuild\\n\\npublic import Eggshell.PluginModel\\npublic import Eggshell.SearchProvider\\npublic import Eggshell.SynapseJournal\\npublic import tools.FocusWindows\\npublic import tools.RetrievalIndex\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Warm\\nopen Lean\\n\\ndef planningContract := Sha256.hex ((include_str \\\"Warm.lean\\\").toUTF8 ++\\n  (include_str \\\"SourceDelta.lean\\\").toUTF8 ++ PartitionBuild.implementation.toUTF8 ++\\n  VectorPartition.implementation.toUTF8 ++ ProjectionCursor.implementation.toUTF8)\\n\\nstructure Checkpoint where\\n  source : DB.PageMap.Head\\n  change : Nat\\n  roots : Nat\\n  candidates : Nat\\n  model : String\\n  encoderContract : String\\n  focusContract : String\\n  projectionContract : String\\n  planningContract : String\\n  projection : Option DB.PageMap.Head\\n  deriving BEq, ToJson, FromJson\\n\\ndef model (command : List String) : IO String := do\\n  let _ :: \\\"search-provider\\\" :: args := command | throw (IO.userError \\\"unsupported warm provider\\\")\\n  let parsed ← IO.ofExcept (SearchProvider.parse {cache := .mk \\\".\\\", models := .mk \\\".\\\"} args)\\n  return parsed.model\\n\\ndef checkpoint (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO Checkpoint := do\\n  let model ← model target.command\\n  let sidecar ← DB.Sidecar.locate snapshot target.storage\\n  let projection ← try VectorMatrix.open? sidecar.semantic model SearchProvider.encoderContract catch _ => pure none\\n  return {\\n    source := snapshot.head\\n    change := ← Persistence.Store.getNat snapshot.get \\\"sourceChange\\\"\\n    roots := ← Persistence.Store.getNat snapshot.get \\\"roots\\\"\\n    candidates := ← Persistence.Store.getNat snapshot.get \\\"candidates\\\"\\n    model := model\\n    encoderContract := SearchProvider.encoderContract\\n    focusContract := Plugin.focusWindowContract\\n    projectionContract := VectorMatrix.implementation\\n    planningContract := planningContract\\n    projection := projection.map (·.snapshot.head) }\\n\\ndef Checkpoint.sameContract (previous current : Checkpoint) : Bool :=\\n  previous.source.identity == current.source.identity && previous.source.authority == current.source.authority &&\\n    previous.model == current.model && previous.encoderContract == current.encoderContract &&\\n    previous.focusContract == current.focusContract && previous.projectionContract == current.projectionContract &&\\n    previous.planningContract == current.planningContract\\n\\n/-- Root ordinals grow on insertion; the live candidate count also detects\\ndeletion. Derived query/matcher memo writes do not change these source counters. -/\\ndef Checkpoint.sameSources (previous current : Checkpoint) : Bool :=\\n  previous.sameContract current && previous.change == current.change &&\\n    previous.roots == current.roots && previous.candidates == current.candidates\\n\\ndef Checkpoint.retainsProjection (previous current : Checkpoint) : Bool :=\\n  match previous.projection, current.projection with\\n  | some before, some after =>\\n    before.identity == after.identity && before.authority == after.authority &&\\n      before.revision ≤ after.revision && before.bytes ≤ after.bytes\\n  | none, _ => previous.candidates == 0\\n  | _, _ => false\\n\\ndef checkpointPath (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO System.FilePath := do\\n  let key := Sha256.hex (toJson [← model target.command, SearchProvider.encoderContract,\\n    Plugin.focusWindowContract, VectorMatrix.implementation, planningContract]).compress.toUTF8\\n  return (← DB.Sidecar.locate snapshot target.storage).indexes / \\\"warm\\\" / key\\n\\ndef lexicalOnly (command : List String) : Bool :=\\n  match command with\\n  | _ :: \\\"search-provider\\\" :: args =>\\n    match SearchProvider.parse {cache := .mk \\\".\\\", models := .mk \\\".\\\"} args with\\n    | .ok options => options.mode == \\\"lexical\\\"\\n    | .error _ => false\\n  | _ => false\\n\\n/-- A rebuildable scheduling hint only. Actual numerical reads validate their\\ninputs and record private repair events; search deadlines leave it intact. -/\\ndef required (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO Bool := do\\n  unless ← Synapses.CanonicalSource.Cache.ready snapshot do return true\\n  unless (← WindowOwners.openShared? snapshot).isSome do return true\\n  unless ← RetrievalResearch.Index.ready snapshot do return true\\n  if lexicalOnly target.command then return false\\n  let _ :: \\\"search-provider\\\" :: _ := target.command | return false\\n  try\\n    let previous ← (Plugin.readBoundedJson (← checkpointPath target snapshot) 65536 : IO Checkpoint)\\n    let current ← checkpoint target snapshot\\n    unless previous.sameSources current && previous.retainsProjection current do return true\\n    if previous.source != current.source then\\n      let some delta ← SourceDelta.read? snapshot previous.source | return true\\n      unless delta.owners.isEmpty do return true\\n    if ← PreparationDebt.pending target.owner current.model SearchProvider.encoderContract then return true\\n    -- An empty publication has no numerical rows to prepare. Its completed\\n    -- checkpoint must not enqueue the same impossible matrix forever.\\n    if previous.candidates == 0 then return false\\n    let sidecar ← DB.Sidecar.locate snapshot target.storage\\n    let some matrix ← VectorMatrix.open? sidecar.semantic current.model SearchProvider.encoderContract | return true\\n    return (← PartitionBuild.open? sidecar.semantic current.model SearchProvider.encoderContract snapshot matrix).isNone\\n  catch _ => pure true\\n\\ndef mark (target : Plugin.IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO Unit := do\\n  let sidecar ← DB.Sidecar.prepare target.owner target.storage\\n  let _ ← DB.Sidecar.childDirectory sidecar.indexes \\\"warm\\\"\\n  let path ← checkpointPath target snapshot\\n  let value ← checkpoint target snapshot\\n  unless value.candidates == 0 || value.projection.isSome do\\n    throw (IO.userError \\\"cannot mark unprepared projections\\\")\\n  let previous ← try some <$> (Plugin.readBoundedJson path 65536 : IO Checkpoint) catch _ => pure none\\n  if previous.any (fun old => (old.source == value.source && old.sameSources value && old.retainsProjection value) ||\\n      (old.sameContract value && old.source.revision > value.source.revision)) then return\\n  FileSystem.atomicExistingBytes path (toJson value).compress.toUTF8\\n\\nstructure Window where\\n  document : Persistence.Store.SearchDocument\\n  index : Nat\\n  key : String\\n  start : Nat\\n\\ninductive InputState where\\n  | missing\\n  | invalid\\n  | valid (coverage : SearchProvider.EncodingCoverage)\\n\\nstructure WindowCoverage where\\n  windows : Nat := 0\\n  valid : Nat := 0\\n  missing : Nat := 0\\n  invalid : Nat := 0\\n  input : SearchProvider.InputTotals := {}\\n  deriving ToJson\\n\\ndef WindowCoverage.observe (counts : WindowCoverage) (state : InputState) : WindowCoverage :=\\n  let counts := {counts with windows := counts.windows + 1}\\n  match state with\\n  | .missing => {counts with missing := counts.missing + 1}\\n  | .invalid => {counts with invalid := counts.invalid + 1}\\n  | .valid coverage => {counts with valid := counts.valid + 1, input := counts.input.add coverage}\\n\\nstructure Coverage where\\n  database : DB.Sidecar.Owner\\n  revision : Nat\\n  model : String\\n  windows : Nat\\n  valid : Nat\\n  missing : Nat\\n  invalid : Nat\\n  encoderContract : String\\n  input : SearchProvider.InputTotals\\n  focusContract : String\\n  discovery : WindowCoverage\\n  focus : WindowCoverage\\n  deriving ToJson\\n\\nstructure Inspection where\\n  coverage : Coverage\\n  needed : List Window\\n\\n/-- Read the configured numerical cache format without starting the provider.\\nThe DB owner overrides a command's process scratch path, as at indexed search. -/\\ndef options (snapshot : DB.PageMap.Snapshot) (command : List String)\\n    (storage : DB.Sidecar.Storage := .database) : IO SearchProvider.Options := do\\n  let _ :: \\\"search-provider\\\" :: arguments := command |\\n    throw (IO.userError \\\"cache inspection requires the Eggshell numerical provider\\\")\\n  DB.Sidecar.observe snapshot\\n  let sidecar ← DB.Sidecar.locate snapshot storage\\n  let other ← DB.Sidecar.locate snapshot (if storage == .database then .user else .database)\\n  let parsed ← IO.ofExcept (SearchProvider.parse {\\n    cache := sidecar.semantic, models := (MiniLM.layout (← Paths.installRoot)).models } arguments)\\n  if parsed.mode == \\\"lexical\\\" then\\n    throw (IO.userError \\\"lexical-only providers do not maintain numerical window caches\\\")\\n  pure {parsed with\\n    cache := sidecar.semantic, fallback := some other.semantic\\n    owner := some (DB.Sidecar.Owner.ofSnapshot snapshot)}\\n\\ndef inspectInput (options : SearchProvider.Options) (key : String) : IO InputState := do\\n  let paths := SearchProvider.vectorPaths options (SearchProvider.windowCacheKey options.model key)\\n  if ← paths.allM (fun path => return (← FileSystem.symlinkMetadata? path).isNone) then return .missing\\n  try\\n    let cached ← SearchProvider.indexedWindow options key\\n    pure (.valid cached.coverage)\\n  catch _ => pure .invalid\\n\\ndef planDocuments (snapshot : DB.PageMap.Snapshot) (documents : List Persistence.Store.SearchDocument)\\n    (work : Persistence.Store.SearchDocument → IO Value) : IO (List Window × List Window) := do\\n  let mut discovery : Array Window := #[]\\n  let mut focus : Array Window := #[]\\n  for document in documents do\\n    let some text := Matcher.atomText? (← work document) | throw (IO.userError \\\"warm Work is not indexed text\\\")\\n    for (key, index) in document.windows.zipIdx do\\n      let original : Window := ⟨document, index, key, 0⟩\\n      discovery := discovery.push original\\n      let start := Plugin.evidenceWindowStart text.length index\\n      if start == 0 then focus := focus.push original else\\n        let originalText ← Persistence.Store.readSearchWindow snapshot document index\\n        let view := Plugin.evidenceWindowText text.length index originalText\\n        focus := focus.push ⟨document, index, Persistence.Store.windowKey view, start⟩\\n  pure (discovery.toList, focus.toList)\\n\\n/-- Only prefixes intersecting Work need an original bounded read. -/\\ndef planWindows (snapshot : DB.PageMap.Snapshot) : IO (List Window × List Window) := do\\n  let (discovery,focus) ← SourceCatalogue.fold snapshot (fun (discovery,focus) ordinal document => do\\n    let windows ← planDocuments snapshot [document] fun document => Persistence.Store.readNode snapshot snapshot.get document.work\\n    return (discovery.push (ordinal,windows.1),focus.push (ordinal,windows.2))) (#[],#[])\\n  -- Original numeric order still determines bounded embedding batches.\\n  let ordered := fun rows : Array (Nat × List Window) =>\\n    ((rows.toList.mergeSort fun a b => a.1 ≤ b.1).flatMap Prod.snd)\\n  pure (ordered discovery,ordered focus)\\n\\nstructure Plan where\\n  scope : String\\n  reason : String\\n  publications : Nat := 0\\n  owners : Nat := 0\\n  windows : List Window × List Window\\n\\n/-- Reuse requires the same source/storage/encoding contract and retained\\nprojection incarnation. A discontinuous journal always selects full planning. -/\\ndef plan (snapshot : DB.PageMap.Snapshot) (target : Plugin.IndexTarget)\\n    (verify : Bool) (repair : Bool) : IO Plan := do\\n  let current ← checkpoint target snapshot\\n  let previous ← try some <$> (Plugin.readBoundedJson (← checkpointPath target snapshot) 65536 : IO Checkpoint)\\n    catch _ => pure none\\n  if !verify && !repair then\\n    if let some previous := previous then\\n      if previous.sameContract current && previous.retainsProjection current then\\n        if previous.source == current.source && previous.sameSources current then\\n          return {scope := \\\"publication-delta\\\",reason := \\\"source-unchanged\\\",windows := ([],[])}\\n        if let some delta ← SourceDelta.read? snapshot previous.source then\\n          let some history ← DB.PageMap.HistoryReader.make? snapshot previous.source |\\n            throw (IO.userError \\\"verified warm history was not retained\\\")\\n          if previous.roots == (← Persistence.Store.getNat history.snapshot.get \\\"roots\\\") &&\\n              previous.candidates == (← Persistence.Store.getNat history.snapshot.get \\\"candidates\\\") &&\\n              previous.change == (← Persistence.Store.getNat history.snapshot.get \\\"sourceChange\\\") then\\n            let documents ← SourceDelta.documents snapshot delta.owners\\n            let reader ← Persistence.Store.NodeReader.new snapshot\\n            let windows ← planDocuments snapshot documents fun document => reader.read document.work\\n            return {\\n              scope := \\\"publication-delta\\\"\\n              reason := \\\"verified-source-history\\\"\\n              publications := delta.records\\n              owners := documents.length\\n              windows := windows }\\n  return {\\n    scope := \\\"full-source\\\"\\n    reason := if verify then \\\"explicit-verification\\\" else if repair then \\\"observed-unavailable-input\\\" else \\\"no-usable-history\\\"\\n    windows := ← planWindows snapshot }\\n\\ndef viewCoverage (known : Std.HashMap String InputState) (windows : List Window) : IO WindowCoverage := do\\n  let mut seen : Std.HashSet String := {}\\n  let mut result : WindowCoverage := {}\\n  for window in windows do\\n    unless seen.contains window.key do\\n      seen := seen.insert window.key\\n      let some state := known[window.key]? | throw (IO.userError \\\"warm input coverage lost a planned key\\\")\\n      result := result.observe state\\n  pure result\\n\\n/-- All original and focus-view keys are inspected once. Query vectors and\\nretired keys do not enter either live-view denominator. -/\\ndef inspectWindows (snapshot : DB.PageMap.Snapshot) (options : SearchProvider.Options)\\n    (discovery focus : List Window) : IO Inspection := do\\n  let mut known : Std.HashMap String InputState := {}\\n  let mut needed : Array Window := #[]\\n  let mut union : WindowCoverage := {}\\n  for window in discovery ++ focus do\\n    unless known.contains window.key do\\n      let state ← inspectInput options window.key\\n      known := known.insert window.key state\\n      union := union.observe state\\n      match state with\\n      | .valid _ => pure ()\\n      | _ => needed := needed.push window\\n  pure {\\n    coverage := {\\n      database := DB.Sidecar.Owner.ofSnapshot snapshot, revision := snapshot.head.revision\\n      model := options.model, windows := union.windows, valid := union.valid\\n      missing := union.missing, invalid := union.invalid, input := union.input\\n      encoderContract := SearchProvider.encoderContract, focusContract := Plugin.focusWindowContract\\n      discovery := ← viewCoverage known discovery, focus := ← viewCoverage known focus }\\n    needed := needed.toList }\\n\\ndef inspect (snapshot : DB.PageMap.Snapshot) (options : SearchProvider.Options) : IO Inspection := do\\n  let (discovery,focus) ← planWindows snapshot\\n  inspectWindows snapshot options discovery focus\\n\\n\\nstructure Result where\\n  before : Coverage\\n  after : Coverage\\n  requested : Nat\\n  batches : Nat\\n  elapsedMs : Nat\\n  lexical : RetrievalResearch.Index.Result\\n  canonical : Synapses.CanonicalSource.Cache.Result\\n  scope : String := \\\"full-source\\\"\\n  planReason : String := \\\"full-source\\\"\\n  changedOwners : Nat := 0\\n  publications : Nat := 0\\n  projections : Option VectorMatrix.Result := none\\n  windowOwners : Option WindowOwners.Result := none\\n  partition : Option PartitionBuild.Preparation := none\\n  deriving ToJson\\n\\n/-- Preparation consumes exactly the captured source publication. A concurrent\\nsource commit creates later debt; it does not invalidate completed prefix work\\nor let a view claim coverage beyond the bytes it actually consumed. -/\\ndef refreshSource (snapshot : DB.PageMap.Snapshot) (storage : DB.Sidecar.Storage)\\n    (deadline : Nat) : IO (DB.PageMap.Snapshot × Synapses.Journal.Result) := do\\n  let result ← Synapses.Journal.refresh snapshot storage deadline\\n  return (snapshot,result)\\n\\n/-- Preparation uses verified publication deltas; an explicit verification request\\ninspects the complete source. Neither runs inside a cold search hook.\\nHydrate missing original windows in bounded batches and require exact ACKs. A\\nfailed batch leaves completed cache writes for a subsequent invocation. -/\\ndef runTarget (snapshot : DB.PageMap.Snapshot) (target : Plugin.IndexTarget)\\n    (verify : Bool := false) : IO Result := do\\n  let started ← IO.monoMsNow\\n  let (snapshot,_) ← refreshSource snapshot target.storage ((← IO.monoMsNow)+60000)\\n  let canonical ← Synapses.CanonicalSource.Cache.refresh snapshot target.storage\\n  let windowOwners ← WindowOwners.refresh snapshot target.storage\\n  let lexical ← RetrievalResearch.Index.warm snapshot target.storage\\n  if lexicalOnly target.command then\\n    let empty : Coverage := {\\n      database := DB.Sidecar.Owner.ofSnapshot snapshot\\n      revision := snapshot.head.revision, model := \\\"lexical-only\\\", windows := 0\\n      valid := 0, missing := 0, invalid := 0\\n      encoderContract := SearchProvider.encoderContract, input := {}\\n      focusContract := Plugin.focusWindowContract, discovery := {}, focus := {}}\\n    return {\\n      before := empty\\n      after := empty\\n      requested := 0\\n      batches := 0\\n      elapsedMs := (← IO.monoMsNow)-started\\n      lexical := lexical\\n      canonical := canonical\\n      windowOwners := some windowOwners\\n      scope := \\\"lexical-only\\\" }\\n  let settings ← options snapshot target.command target.storage\\n  DB.Sidecar.withIndexClaim (DB.Sidecar.Owner.ofSnapshot snapshot) (fun _ => do\\n    let debt ← PreparationDebt.capture target.owner settings.model SearchProvider.encoderContract\\n    let selected ← plan snapshot target verify (!debt.isEmpty)\\n    let (discovery,focus) := selected.windows\\n    let before ← inspectWindows snapshot settings discovery focus\\n    let batches ← if before.needed.isEmpty then pure 0 else\\n      SemanticMatcher.withIndexProvider target.command fun running => do\\n        let mut remaining := before.needed\\n        let mut batches := 0\\n        while !remaining.isEmpty do\\n          let batch := remaining.take 32\\n          remaining := remaining.drop 32\\n          let items ← batch.mapM fun window => do\\n            let original ← Persistence.Store.readSearchWindow snapshot window.document window.index\\n            let text := (original.drop window.start).copy\\n            unless Persistence.Store.windowKey text == window.key do\\n              throw (IO.userError \\\"warm input disagrees with its pinned original suffix\\\")\\n            pure ({id := window.key, text} : SemanticMatcher.Item)\\n          let _ ← SemanticMatcher.indexWindows running items (DB.Sidecar.Owner.ofSnapshot snapshot) target.storage\\n          batches := batches + 1\\n        pure batches\\n    let after ← if before.needed.isEmpty then pure before else inspectWindows snapshot settings discovery focus\\n    unless after.needed.isEmpty do throw (IO.userError \\\"provider acknowledged windows without valid DB cache records\\\")\\n    let projections ← SearchProvider.prepareMatrix settings ((discovery ++ focus).map (·.key))\\n    let partition ← match ← VectorMatrix.open? settings.cache settings.model SearchProvider.encoderContract with\\n      | none =>\\n        if (← Persistence.Store.getNat snapshot.get \\\"candidates\\\") == 0 then pure none\\n        else throw (IO.userError \\\"warm did not publish projections\\\")\\n      | some matrix => do\\n        let prepared ← PartitionBuild.prepare settings.cache settings.model SearchProvider.encoderContract snapshot matrix\\n        let some _ ← PartitionBuild.open? settings.cache settings.model SearchProvider.encoderContract snapshot matrix |\\n          throw (IO.userError \\\"warm did not publish its assignment model\\\")\\n        pure (some prepared)\\n    mark target snapshot\\n    PreparationDebt.acknowledge target.owner settings.model SearchProvider.encoderContract debt\\n    return {\\n      before := before.coverage\\n      after := after.coverage\\n      requested := before.needed.length\\n      batches := batches\\n      elapsedMs := (← IO.monoMsNow)-started\\n      lexical := lexical\\n      canonical := canonical\\n      scope := selected.scope\\n      planReason := selected.reason\\n      changedOwners := selected.owners\\n      publications := selected.publications\\n      projections := some projections\\n      windowOwners := some windowOwners\\n      partition := partition }) target.storage\\n\\ndef run (snapshot : DB.PageMap.Snapshot) (command : List String) (writable : Bool := true) : IO Result := do\\n  let target ← Plugin.registerIndexTarget snapshot command writable\\n  runTarget snapshot target\\n\\nend Eggshell.Warm\\n\"],[\"SourceDelta.lean\",\"module\\npublic import Eggshell.GraphStore\\n\\n@[expose] public section\\nnamespace Eggshell.SourceDelta\\nopen DB Persistence.Store\\n\\ndef linked (parent child : PageMap.Head) : Bool :=\\n  parent.identity == child.identity && parent.authority == child.authority &&\\n    parent.revision+1 == child.revision && parent.bytes < child.bytes\\n\\ninductive Lineage : PageMap.Head → PageMap.Head → Prop where\\n  | same (head) : Lineage head head\\n  | step {first parent child} : Lineage first parent → linked parent child = true → Lineage first child\\n\\ntheorem Lineage.same_identity (chain : Lineage first last) : first.identity = last.identity := by\\n  induction chain with\\n  | same => rfl\\n  | step _ link ih =>\\n    simp only [linked, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at link\\n    exact ih.trans link.1.1.1\\n\\ntheorem Lineage.revision_le (chain : Lineage first last) : first.revision ≤ last.revision := by\\n  induction chain with\\n  | same => omega\\n  | step _ link ih =>\\n    simp only [linked, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at link\\n    omega\\n\\nstructure Delta (first last : PageMap.Head) where\\n  owners : List Nat\\n  records : Nat\\n  bytes : Nat\\n  lineage : Lineage first last\\n\\n/-- The pinned target authenticates every publication. Replay follows actual\\nparent heads back to the exact saved head, not just matching revision numbers.\\nBounds apply before decoding each journal payload. Failure is a full-plan\\ndecision, never a claim that there were no source changes. -/\\nprivate def walk (source : PageMap.Snapshot) (first current : PageMap.Head)\\n    (remaining : Nat) (byteBudget : Nat) : IO (Option (Delta first current)) := do\\n  if same : first = current then return some ⟨[],0,0,by rw [← same]; exact .same first⟩\\n  match remaining with\\n  | 0 => return none\\n  | remaining+1 =>\\n    if current.revision ≤ first.revision then return none\\n    let historical := {source with head := current}\\n    let bytes ← IO.ofExcept (payloadSize (← historical.get (key \\\"change\\\" current.revision)))\\n    if bytes > byteBudget then return none\\n    -- Read this record through its own child head. A later revision must not\\n    -- replace an older journal entry and thereby rewrite the replayed past.\\n    let publication ← readPublication historical current.revision\\n    if publication.change.added.length + publication.change.removed.length + publication.change.affected.length > 8192 then return none\\n    if valid : linked publication.parent current = true then\\n      let some previous ← walk source first publication.parent remaining (byteBudget-bytes) | return none\\n      let owners := hashDistinct (publication.change.added ++ publication.change.removed ++\\n        publication.change.affected ++ previous.owners)\\n      if owners.length > 4096 then return none\\n      return some ⟨owners,previous.records+1,previous.bytes+bytes,.step previous.lineage valid⟩\\n    else return none\\n\\nopaque read? (source : PageMap.Snapshot) (basis : PageMap.Head) : IO (Option (Delta basis source.head)) := do\\n  try\\n    unless basis.identity == source.head.identity && basis.authority == source.head.authority &&\\n        basis.revision ≤ source.head.revision && basis.bytes ≤ source.head.bytes do return none\\n    let result ← walk source basis source.head 4096 (8*1024*1024)\\n    let nodes ← getNat source.get \\\"nodes\\\"\\n    if result.any (fun delta => !delta.owners.all (· < nodes)) then return none\\n    return result\\n  catch _ => return none\\n\\n/-- Only nominated live candidates are read; no directory of all owners and\\nno complete candidate-domain payload is opened by this path. -/\\ndef documents (source : PageMap.Snapshot) (owners : List Nat) : IO (List SearchDocument) := do\\n  let mut rows := []\\n  for owner in owners do\\n    let candidate ← source.get (key \\\"candidate\\\" owner)\\n    if candidate.isNone then continue\\n    unless (← IO.ofExcept (payloadSize candidate)) == 1 do\\n      throw (IO.userError \\\"invalid changed search candidate\\\")\\n    let located ← locateOutcome source owner\\n    let ordinal ← getNat source.get (key \\\"member\\\" owner)\\n    unless (← IO.ofExcept (payloadSize (← source.get (key \\\"searchCandidate\\\" ordinal)))) == owner do\\n      throw (IO.userError \\\"changed search candidate disagrees with its reverse directory\\\")\\n    let encoded ← readChunks source source.get \\\"searchWindows\\\" owner\\n    let (windows,tail) ← IO.ofExcept (windowCodec.decode encoded.toList)\\n    unless tail.isEmpty && !windows.isEmpty &&\\n        windows.all (fun value => PageMap.validIdentity value) do\\n      throw (IO.userError \\\"invalid changed window directory\\\")\\n    rows := ⟨owner,located.header.work,windows,some (Sidecar.Owner.ofSnapshot source)⟩ :: rows\\n  return rows.reverse\\n\\nend Eggshell.SourceDelta\\n\"]]]"],["Eggshell.WindowOwners","[\"module\\npublic import Eggshell.SourceDelta\\npublic import SourceCatalogue\\npublic import Eggshell.VectorMatrix\\n\\n@[expose] public section\\nnamespace Eggshell.WindowOwners\\nopen Lean DB Persistence.Store\\n\\n/-- A nomination retains the original DB-local identity and window position.\\nIt carries neither equality nor permission to reuse an observation. -/\\nstructure Occurrence where\\n  owner : Nat\\n  work : Nat\\n  ordinal : Nat\\n  position : Nat\\n  deriving BEq, Repr, ToJson, FromJson\\n\\ndef occurrenceCodec : Wire.Codec Occurrence :=\\n  (Wire.natural.product (Wire.natural.product (Wire.natural.product Wire.natural))).iso\\n    (fun row => (row.owner,row.work,row.ordinal,row.position))\\n    (fun (owner,work,ordinal,position) => ⟨owner,work,ordinal,position⟩)\\n    (by intro row; cases row; rfl)\\n\\ntheorem occurrence_roundtrip (row : Occurrence) (tail : List UInt8) :\\n    occurrenceCodec.decode (occurrenceCodec.encode row ++ tail) = .ok (row,tail) :=\\n  occurrenceCodec.roundtrip row tail\\n\\ndef entries (document : SearchDocument) (ordinal : Nat) : List (String × Occurrence) :=\\n  document.windows.zipIdx.map fun (key,position) =>\\n    (key,⟨document.owner,document.work,ordinal,position⟩)\\n\\ntheorem entries_original (document : SearchDocument) (ordinal : Nat)\\n    (key : String) (row : Occurrence) (member : (key,row) ∈ entries document ordinal) :\\n    row.owner = document.owner ∧ row.work = document.work ∧ row.ordinal = ordinal ∧\\n      document.windows[row.position]? = some key := by\\n  simp only [entries, List.mem_map] at member\\n  obtain ⟨⟨value,position⟩,present,same⟩ := member\\n  cases same\\n  exact ⟨rfl,rfl,rfl,List.mk_mem_zipIdx_iff_getElem?.mp present⟩\\n\\ndef postingKey (window : String) (row : Occurrence) : String :=\\n  \\\"w:\\\" ++ window ++ \\\":\\\" ++ toString row.owner ++ \\\":\\\" ++ toString row.position\\n\\ndef postingRange (window : String) : PageMap.KeyRange :=\\n  ⟨\\\"w:\\\" ++ window ++ \\\":\\\", \\\"w:\\\" ++ window ++ \\\";\\\"⟩\\n\\ndef implementation : String := Sha256.hex (\\n  (include_str \\\"WindowOwners.lean\\\").toUTF8 ++\\n  (include_str \\\"SourceDelta.lean\\\").toUTF8 ++\\n  (include_str \\\"GraphStore.lean\\\").toUTF8 ++\\n  (include_str \\\"SearchRank.lean\\\").toUTF8)\\n\\ndef authority (database : String) := \\\"eggshell.window-owners:\\\" ++ database ++ \\\":\\\" ++ implementation\\n\\nstructure Manifest where\\n  source : PageMap.Head\\n  stamp : SourceCatalogue.Stamp\\n  occurrences : Nat\\n  deriving ToJson, FromJson\\n\\nstructure Ready where\\n  snapshot : PageMap.Snapshot\\n  manifest : Manifest\\n\\ndef folder (source : Snapshot) (storage : Sidecar.Storage) : IO System.FilePath := do\\n  return (← Sidecar.locate source storage).indexes / \\\"window-owners\\\" / implementation\\n\\ndef load? (source : Snapshot) (storage : Sidecar.Storage) : IO (Option Ready) := do\\n  let some index ← PageMap.open? (← folder source storage) | return none\\n  unless index.head.authority == authority source.head.identity do\\n    throw (IO.userError \\\"foreign window-owner index authority\\\")\\n  let some bytes ← index.get \\\"manifest\\\" | return none\\n  unless bytes.size ≤ 16384 do throw (IO.userError \\\"oversized window-owner manifest\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid window-owner manifest UTF-8\\\")\\n  let manifest ← IO.ofExcept (Json.parse text >>= fromJson? (α := Manifest))\\n  unless manifest.source.identity == source.head.identity &&\\n      manifest.source.authority == source.head.authority &&\\n      manifest.stamp.database == source.head.identity do\\n    throw (IO.userError \\\"foreign window-owner source\\\")\\n  return some ⟨index,manifest⟩\\n\\n/-- A cold, divergent or changed source is unavailable, never a successful\\nempty search. Neutral publications are checked against their real parent chain.\\nNo original candidate directory is opened by this foreground operation. -/\\ndef open? (source : Snapshot) (storage : Sidecar.Storage) : IO (Option Ready) := do\\n  let some ready ← load? source storage | return none\\n  unless ready.manifest.stamp == (← SourceCatalogue.stamp source) do return none\\n  if ready.manifest.source != source.head then\\n    let some delta ← SourceDelta.read? source ready.manifest.source | return none\\n    unless delta.owners.isEmpty do return none\\n  return some ready\\n\\ndef openShared? (source : Snapshot) : IO (Option Ready) := do\\n  for storage in [.database,.user] do\\n    if let some ready ← try open? source storage catch _ => pure none then return some ready\\n  return none\\n\\nstructure Slice where\\n  rows : List PageMap.Row := []\\n  remaining : Nat\\n  incomplete : Bool := false\\n\\ndef Slice.consume (state : Slice) (selected : List PageMap.Row) : Slice :=\\n  let taken := selected.take state.remaining\\n  ⟨taken.reverse ++ state.rows,state.remaining-taken.length,\\n    state.incomplete || selected.length > state.remaining⟩\\n\\n/-- The exact leaf operation spends one physical slot for every retained row;\\nneither tombstones nor oversized fanout can create an uncharged nomination. -/\\ntheorem Slice.consume_conserves (state : Slice) (selected : List PageMap.Row) :\\n    (state.consume selected).rows.length + (state.consume selected).remaining =\\n      state.rows.length + state.remaining := by\\n  simp only [consume,List.length_append,List.length_reverse,List.length_take]\\n  omega\\n\\n/-- Stop traversal, rather than merely ignoring rows after exhausting a quota.\\nTombstones spend the same physical-row budget as live entries. Checked parent\\nfences prune children, while the root itself is authenticated even on a miss. -/\\ndef scanAt (snapshot : PageMap.Snapshot) (ref : PageMap.Ref) (range : PageMap.KeyRange)\\n    (state : Slice) : IO Slice := do\\n  let loaded ← snapshot.load ref\\n  unless range.overlaps ref do return state\\n  match loaded.page with\\n  | .leaf rows =>\\n    return state.consume (range.select rows)\\n  | .branch children =>\\n    let mut state := state\\n    for child in children do\\n      if range.overlaps child then\\n        if state.remaining == 0 then return {state with incomplete := true}\\n        if _smaller : child.height < ref.height then\\n          state ← scanAt snapshot child range state\\n        else throw (IO.userError \\\"window-owner index height did not decrease\\\")\\n        if state.incomplete then return state\\n    return state\\ntermination_by ref.height\\n\\nstructure Lookup where\\n  occurrences : List (String × Occurrence)\\n  physicalRows : Nat\\n  requestedKeys : Nat\\n  visitedKeys : Nat\\n  partialKeys : List String\\n  deriving ToJson\\n\\n/-- The result exposes lost coverage from a common key or an exhausted global\\nbudget. Its subtype bounds actual physical rows, including deleted postings. -/\\ndef lookup (ready : Ready) (keys : List String) (budget : Nat) :\\n    IO {result : Lookup // result.physicalRows ≤ budget ∧ result.occurrences.length ≤ result.physicalRows} := do\\n  unless keys.length ≤ 4096 && budget ≤ 8192 &&\\n      keys.all PageMap.validIdentity && (Std.HashSet.ofList keys).size == keys.length do\\n    throw (IO.userError \\\"invalid window-owner lookup allowance or keys\\\")\\n  let mut remaining := budget\\n  let mut found := []\\n  let mut visited := 0\\n  let mut partialKeys := []\\n  for key in keys do\\n    if remaining == 0 then\\n      partialKeys := key :: partialKeys\\n      continue\\n    let state ← match ready.snapshot.head.root with\\n      | none => pure (Slice.mk [] remaining false)\\n      | some root => scanAt ready.snapshot root (postingRange key) ⟨[],remaining,false⟩\\n    let rows := state.rows.reverse\\n    unless rows.length ≤ remaining && state.remaining == remaining-rows.length do\\n      throw (IO.userError \\\"window-owner physical allowance disagrees\\\")\\n    remaining := state.remaining\\n    visited := visited+1\\n    if state.incomplete then\\n      partialKeys := key :: partialKeys\\n      ready.snapshot.trace.modify (·.map fun _ => {complete := false})\\n    else ready.snapshot.observe (.range (postingRange key).lower (postingRange key).upper rows)\\n    for (stored,encoded) in rows do\\n      let some encoded := encoded | continue\\n      let (row,tail) ← IO.ofExcept (occurrenceCodec.decode encoded.toList)\\n      unless tail.isEmpty && (occurrenceCodec.encode row).toByteArray == encoded &&\\n          stored == postingKey key row do\\n        throw (IO.userError \\\"window-owner posting disagrees with original identity\\\")\\n      found := (key,row) :: found\\n  let result : Lookup := ⟨found.reverse,budget-remaining,keys.length,visited,partialKeys.reverse⟩\\n  if bounded : result.physicalRows ≤ budget ∧ result.occurrences.length ≤ result.physicalRows then\\n    return ⟨result,bounded⟩\\n  throw (IO.userError \\\"window-owner lookup exceeded its checked allowance\\\")\\n\\ntheorem lookup_rows_bounded (result : {result : Lookup //\\n    result.physicalRows ≤ budget ∧ result.occurrences.length ≤ result.physicalRows}) :\\n    result.val.occurrences.length ≤ budget := Nat.le_trans result.property.2 result.property.1\\n\\n/-- Cache rows are hints. Validate each nominated owner and each original\\nposition against the pinned source, never against a fabricated compact ordinal.\\nOriginal text and freshness remain the delivery producer's responsibility. -/\\ndef resolve (source : Snapshot) (result : Lookup) : IO (List SearchDocument) := do\\n  let owners := hashDistinct (result.occurrences.map (·.2.owner))\\n  let documents ← SourceDelta.documents source owners\\n  let table := documents.foldl (fun table doc => table.insert doc.owner doc)\\n    ({} : Std.HashMap Nat SearchDocument)\\n  for (key,row) in result.occurrences do\\n    let some document := table[row.owner]? | throw (IO.userError \\\"nominated window owner is no longer live\\\")\\n    unless document.work == row.work && document.windows[row.position]? == some key &&\\n        (← getNat source.get (Persistence.Store.key \\\"member\\\" row.owner)) == row.ordinal do\\n      throw (IO.userError \\\"nominated window disagrees with original source\\\")\\n  return documents\\n\\nstructure Result where\\n  mode : String\\n  changedOwners : Nat\\n  removed : Nat\\n  added : Nat\\n  occurrences : Nat\\n  writtenBytes : Nat\\n  elapsedMs : Nat\\n  deriving ToJson\\n\\ndef documentEntries (source : Snapshot) (documents : List SearchDocument) :\\n    IO (List (String × Occurrence)) := do\\n  let mut rows := []\\n  for document in documents do\\n    let ordinal ← getNat source.get (Persistence.Store.key \\\"member\\\" document.owner)\\n    rows := (entries document ordinal).reverse ++ rows\\n  return rows.reverse\\n\\n/-- Warm-only maintenance. Existing publication journals provide both the old\\nand new original windows of changed owners. Retraction needs no second reverse\\ndirectory. Data and coverage basis switch in one atomic PageMap head. -/\\ndef refresh (source : Snapshot) (storage : Sidecar.Storage) : IO Result := do\\n  let started ← IO.monoMsNow\\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun sidecar => do\\n    unless (← (Sidecar.Owner.ofSnapshot source).pin).head == source.head do\\n      throw (IO.userError \\\"source changed before window-owner preparation\\\")\\n    let previous ← load? source storage\\n    if let some previous := previous then\\n      if previous.manifest.source == source.head then\\n        return ⟨\\\"warm\\\",0,0,0,previous.manifest.occurrences,0,(← IO.monoMsNow)-started⟩\\n    let delta : Option (List Nat) ← match previous with\\n      | none => pure none\\n      | some previous => do pure ((← SourceDelta.read? source previous.manifest.source).map (·.owners))\\n    let (mode,changed,removed,added,occurrences) ← match previous,delta with\\n      | some previous,some delta => do\\n        let before := {source with head := previous.manifest.source}\\n        let removed ← documentEntries before (← SourceDelta.documents before delta)\\n        let added ← documentEntries source (← SourceDelta.documents source delta)\\n        unless removed.length ≤ previous.manifest.occurrences do\\n          throw (IO.userError \\\"window-owner retraction exceeds saved coverage\\\")\\n        pure (\\\"publication-delta\\\",delta.length,removed,added,\\n          previous.manifest.occurrences-removed.length+added.length)\\n      | _,_ => do\\n        let documents ← searchDocuments source\\n        let added ← documentEntries source documents\\n        pure (\\\"full-source\\\",documents.length,[],added,added.length)\\n    let parent ← Sidecar.childDirectory sidecar.indexes \\\"window-owners\\\"\\n    let directory := parent / implementation\\n    let index ← match previous with\\n      | some previous => pure previous.snapshot\\n      | none => PageMap.create directory (authority source.head.identity)\\n    let metadata : Manifest := ⟨source.head,← SourceCatalogue.stamp source,occurrences⟩\\n    let (_,_,written) ← PageMap.withWriter index fun writer => do\\n      if mode == \\\"full-source\\\" then\\n        let rows := List.mergeSort ((\\\"manifest\\\",some (toJson metadata).compress.toUTF8) ::\\n          added.map (fun (key,row) => (postingKey key row,some (occurrenceCodec.encode row).toByteArray)))\\n          (fun a b => a.1 ≤ b.1)\\n        unless PageMap.ordered rows do throw (IO.userError \\\"duplicate original window occurrence\\\")\\n        let mut levels := []\\n        let mut buffered := []\\n        for row in rows do\\n          buffered := row :: buffered\\n          if buffered.length == 64 then\\n            levels ← VectorMatrix.flushLeaves writer buffered levels\\n            buffered := []\\n        levels ← VectorMatrix.flushLeaves writer buffered levels\\n        writer.root.set (some (← VectorMatrix.finish writer levels))\\n      else\\n        for (key,row) in removed do writer.put (postingKey key row) none\\n        for (key,row) in added do\\n          writer.put (postingKey key row) (some (occurrenceCodec.encode row).toByteArray)\\n        writer.put \\\"manifest\\\" (some (toJson metadata).compress.toUTF8)\\n      unless (← (Sidecar.Owner.ofSnapshot source).pin).head == source.head do\\n        throw (IO.userError \\\"source changed during window-owner preparation\\\")\\n    return ⟨mode,changed,removed.length,added.length,occurrences,written,(← IO.monoMsNow)-started⟩) storage\\n\\nend Eggshell.WindowOwners\\n\",[[\"WindowOwners.lean\",\"module\\npublic import Eggshell.SourceDelta\\npublic import SourceCatalogue\\npublic import Eggshell.VectorMatrix\\n\\n@[expose] public section\\nnamespace Eggshell.WindowOwners\\nopen Lean DB Persistence.Store\\n\\n/-- A nomination retains the original DB-local identity and window position.\\nIt carries neither equality nor permission to reuse an observation. -/\\nstructure Occurrence where\\n  owner : Nat\\n  work : Nat\\n  ordinal : Nat\\n  position : Nat\\n  deriving BEq, Repr, ToJson, FromJson\\n\\ndef occurrenceCodec : Wire.Codec Occurrence :=\\n  (Wire.natural.product (Wire.natural.product (Wire.natural.product Wire.natural))).iso\\n    (fun row => (row.owner,row.work,row.ordinal,row.position))\\n    (fun (owner,work,ordinal,position) => ⟨owner,work,ordinal,position⟩)\\n    (by intro row; cases row; rfl)\\n\\ntheorem occurrence_roundtrip (row : Occurrence) (tail : List UInt8) :\\n    occurrenceCodec.decode (occurrenceCodec.encode row ++ tail) = .ok (row,tail) :=\\n  occurrenceCodec.roundtrip row tail\\n\\ndef entries (document : SearchDocument) (ordinal : Nat) : List (String × Occurrence) :=\\n  document.windows.zipIdx.map fun (key,position) =>\\n    (key,⟨document.owner,document.work,ordinal,position⟩)\\n\\ntheorem entries_original (document : SearchDocument) (ordinal : Nat)\\n    (key : String) (row : Occurrence) (member : (key,row) ∈ entries document ordinal) :\\n    row.owner = document.owner ∧ row.work = document.work ∧ row.ordinal = ordinal ∧\\n      document.windows[row.position]? = some key := by\\n  simp only [entries, List.mem_map] at member\\n  obtain ⟨⟨value,position⟩,present,same⟩ := member\\n  cases same\\n  exact ⟨rfl,rfl,rfl,List.mk_mem_zipIdx_iff_getElem?.mp present⟩\\n\\ndef postingKey (window : String) (row : Occurrence) : String :=\\n  \\\"w:\\\" ++ window ++ \\\":\\\" ++ toString row.owner ++ \\\":\\\" ++ toString row.position\\n\\ndef postingRange (window : String) : PageMap.KeyRange :=\\n  ⟨\\\"w:\\\" ++ window ++ \\\":\\\", \\\"w:\\\" ++ window ++ \\\";\\\"⟩\\n\\ndef implementation : String := Sha256.hex (\\n  (include_str \\\"WindowOwners.lean\\\").toUTF8 ++\\n  (include_str \\\"SourceDelta.lean\\\").toUTF8 ++\\n  (include_str \\\"GraphStore.lean\\\").toUTF8 ++\\n  (include_str \\\"SearchRank.lean\\\").toUTF8)\\n\\ndef authority (database : String) := \\\"eggshell.window-owners:\\\" ++ database ++ \\\":\\\" ++ implementation\\n\\nstructure Manifest where\\n  source : PageMap.Head\\n  stamp : SourceCatalogue.Stamp\\n  occurrences : Nat\\n  deriving ToJson, FromJson\\n\\nstructure Ready where\\n  snapshot : PageMap.Snapshot\\n  manifest : Manifest\\n\\ndef folder (source : Snapshot) (storage : Sidecar.Storage) : IO System.FilePath := do\\n  return (← Sidecar.locate source storage).indexes / \\\"window-owners\\\" / implementation\\n\\ndef load? (source : Snapshot) (storage : Sidecar.Storage) : IO (Option Ready) := do\\n  let some index ← PageMap.open? (← folder source storage) | return none\\n  unless index.head.authority == authority source.head.identity do\\n    throw (IO.userError \\\"foreign window-owner index authority\\\")\\n  let some bytes ← index.get \\\"manifest\\\" | return none\\n  unless bytes.size ≤ 16384 do throw (IO.userError \\\"oversized window-owner manifest\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid window-owner manifest UTF-8\\\")\\n  let manifest ← IO.ofExcept (Json.parse text >>= fromJson? (α := Manifest))\\n  unless manifest.source.identity == source.head.identity &&\\n      manifest.source.authority == source.head.authority &&\\n      manifest.stamp.database == source.head.identity do\\n    throw (IO.userError \\\"foreign window-owner source\\\")\\n  return some ⟨index,manifest⟩\\n\\n/-- A cold, divergent or changed source is unavailable, never a successful\\nempty search. Neutral publications are checked against their real parent chain.\\nNo original candidate directory is opened by this foreground operation. -/\\ndef open? (source : Snapshot) (storage : Sidecar.Storage) : IO (Option Ready) := do\\n  let some ready ← load? source storage | return none\\n  unless ready.manifest.stamp == (← SourceCatalogue.stamp source) do return none\\n  if ready.manifest.source != source.head then\\n    let some delta ← SourceDelta.read? source ready.manifest.source | return none\\n    unless delta.owners.isEmpty do return none\\n  return some ready\\n\\ndef openShared? (source : Snapshot) : IO (Option Ready) := do\\n  for storage in [.database,.user] do\\n    if let some ready ← try open? source storage catch _ => pure none then return some ready\\n  return none\\n\\nstructure Slice where\\n  rows : List PageMap.Row := []\\n  remaining : Nat\\n  incomplete : Bool := false\\n\\ndef Slice.consume (state : Slice) (selected : List PageMap.Row) : Slice :=\\n  let taken := selected.take state.remaining\\n  ⟨taken.reverse ++ state.rows,state.remaining-taken.length,\\n    state.incomplete || selected.length > state.remaining⟩\\n\\n/-- The exact leaf operation spends one physical slot for every retained row;\\nneither tombstones nor oversized fanout can create an uncharged nomination. -/\\ntheorem Slice.consume_conserves (state : Slice) (selected : List PageMap.Row) :\\n    (state.consume selected).rows.length + (state.consume selected).remaining =\\n      state.rows.length + state.remaining := by\\n  simp only [consume,List.length_append,List.length_reverse,List.length_take]\\n  omega\\n\\n/-- Stop traversal, rather than merely ignoring rows after exhausting a quota.\\nTombstones spend the same physical-row budget as live entries. Checked parent\\nfences prune children, while the root itself is authenticated even on a miss. -/\\ndef scanAt (snapshot : PageMap.Snapshot) (ref : PageMap.Ref) (range : PageMap.KeyRange)\\n    (state : Slice) : IO Slice := do\\n  let loaded ← snapshot.load ref\\n  unless range.overlaps ref do return state\\n  match loaded.page with\\n  | .leaf rows =>\\n    return state.consume (range.select rows)\\n  | .branch children =>\\n    let mut state := state\\n    for child in children do\\n      if range.overlaps child then\\n        if state.remaining == 0 then return {state with incomplete := true}\\n        if _smaller : child.height < ref.height then\\n          state ← scanAt snapshot child range state\\n        else throw (IO.userError \\\"window-owner index height did not decrease\\\")\\n        if state.incomplete then return state\\n    return state\\ntermination_by ref.height\\n\\nstructure Lookup where\\n  occurrences : List (String × Occurrence)\\n  physicalRows : Nat\\n  requestedKeys : Nat\\n  visitedKeys : Nat\\n  partialKeys : List String\\n  deriving ToJson\\n\\n/-- The result exposes lost coverage from a common key or an exhausted global\\nbudget. Its subtype bounds actual physical rows, including deleted postings. -/\\ndef lookup (ready : Ready) (keys : List String) (budget : Nat) :\\n    IO {result : Lookup // result.physicalRows ≤ budget ∧ result.occurrences.length ≤ result.physicalRows} := do\\n  unless keys.length ≤ 4096 && budget ≤ 8192 &&\\n      keys.all PageMap.validIdentity && (Std.HashSet.ofList keys).size == keys.length do\\n    throw (IO.userError \\\"invalid window-owner lookup allowance or keys\\\")\\n  let mut remaining := budget\\n  let mut found := []\\n  let mut visited := 0\\n  let mut partialKeys := []\\n  for key in keys do\\n    if remaining == 0 then\\n      partialKeys := key :: partialKeys\\n      continue\\n    let state ← match ready.snapshot.head.root with\\n      | none => pure (Slice.mk [] remaining false)\\n      | some root => scanAt ready.snapshot root (postingRange key) ⟨[],remaining,false⟩\\n    let rows := state.rows.reverse\\n    unless rows.length ≤ remaining && state.remaining == remaining-rows.length do\\n      throw (IO.userError \\\"window-owner physical allowance disagrees\\\")\\n    remaining := state.remaining\\n    visited := visited+1\\n    if state.incomplete then\\n      partialKeys := key :: partialKeys\\n      ready.snapshot.trace.modify (·.map fun _ => {complete := false})\\n    else ready.snapshot.observe (.range (postingRange key).lower (postingRange key).upper rows)\\n    for (stored,encoded) in rows do\\n      let some encoded := encoded | continue\\n      let (row,tail) ← IO.ofExcept (occurrenceCodec.decode encoded.toList)\\n      unless tail.isEmpty && (occurrenceCodec.encode row).toByteArray == encoded &&\\n          stored == postingKey key row do\\n        throw (IO.userError \\\"window-owner posting disagrees with original identity\\\")\\n      found := (key,row) :: found\\n  let result : Lookup := ⟨found.reverse,budget-remaining,keys.length,visited,partialKeys.reverse⟩\\n  if bounded : result.physicalRows ≤ budget ∧ result.occurrences.length ≤ result.physicalRows then\\n    return ⟨result,bounded⟩\\n  throw (IO.userError \\\"window-owner lookup exceeded its checked allowance\\\")\\n\\ntheorem lookup_rows_bounded (result : {result : Lookup //\\n    result.physicalRows ≤ budget ∧ result.occurrences.length ≤ result.physicalRows}) :\\n    result.val.occurrences.length ≤ budget := Nat.le_trans result.property.2 result.property.1\\n\\n/-- Cache rows are hints. Validate each nominated owner and each original\\nposition against the pinned source, never against a fabricated compact ordinal.\\nOriginal text and freshness remain the delivery producer's responsibility. -/\\ndef resolve (source : Snapshot) (result : Lookup) : IO (List SearchDocument) := do\\n  let owners := hashDistinct (result.occurrences.map (·.2.owner))\\n  let documents ← SourceDelta.documents source owners\\n  let table := documents.foldl (fun table doc => table.insert doc.owner doc)\\n    ({} : Std.HashMap Nat SearchDocument)\\n  for (key,row) in result.occurrences do\\n    let some document := table[row.owner]? | throw (IO.userError \\\"nominated window owner is no longer live\\\")\\n    unless document.work == row.work && document.windows[row.position]? == some key &&\\n        (← getNat source.get (Persistence.Store.key \\\"member\\\" row.owner)) == row.ordinal do\\n      throw (IO.userError \\\"nominated window disagrees with original source\\\")\\n  return documents\\n\\nstructure Result where\\n  mode : String\\n  changedOwners : Nat\\n  removed : Nat\\n  added : Nat\\n  occurrences : Nat\\n  writtenBytes : Nat\\n  elapsedMs : Nat\\n  deriving ToJson\\n\\ndef documentEntries (source : Snapshot) (documents : List SearchDocument) :\\n    IO (List (String × Occurrence)) := do\\n  let mut rows := []\\n  for document in documents do\\n    let ordinal ← getNat source.get (Persistence.Store.key \\\"member\\\" document.owner)\\n    rows := (entries document ordinal).reverse ++ rows\\n  return rows.reverse\\n\\n/-- Warm-only maintenance. Existing publication journals provide both the old\\nand new original windows of changed owners. Retraction needs no second reverse\\ndirectory. Data and coverage basis switch in one atomic PageMap head. -/\\ndef refresh (source : Snapshot) (storage : Sidecar.Storage) : IO Result := do\\n  let started ← IO.monoMsNow\\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun sidecar => do\\n    unless (← (Sidecar.Owner.ofSnapshot source).pin).head == source.head do\\n      throw (IO.userError \\\"source changed before window-owner preparation\\\")\\n    let previous ← load? source storage\\n    if let some previous := previous then\\n      if previous.manifest.source == source.head then\\n        return ⟨\\\"warm\\\",0,0,0,previous.manifest.occurrences,0,(← IO.monoMsNow)-started⟩\\n    let delta : Option (List Nat) ← match previous with\\n      | none => pure none\\n      | some previous => do pure ((← SourceDelta.read? source previous.manifest.source).map (·.owners))\\n    let (mode,changed,removed,added,occurrences) ← match previous,delta with\\n      | some previous,some delta => do\\n        let before := {source with head := previous.manifest.source}\\n        let removed ← documentEntries before (← SourceDelta.documents before delta)\\n        let added ← documentEntries source (← SourceDelta.documents source delta)\\n        unless removed.length ≤ previous.manifest.occurrences do\\n          throw (IO.userError \\\"window-owner retraction exceeds saved coverage\\\")\\n        pure (\\\"publication-delta\\\",delta.length,removed,added,\\n          previous.manifest.occurrences-removed.length+added.length)\\n      | _,_ => do\\n        let documents ← searchDocuments source\\n        let added ← documentEntries source documents\\n        pure (\\\"full-source\\\",documents.length,[],added,added.length)\\n    let parent ← Sidecar.childDirectory sidecar.indexes \\\"window-owners\\\"\\n    let directory := parent / implementation\\n    let index ← match previous with\\n      | some previous => pure previous.snapshot\\n      | none => PageMap.create directory (authority source.head.identity)\\n    let metadata : Manifest := ⟨source.head,← SourceCatalogue.stamp source,occurrences⟩\\n    let (_,_,written) ← PageMap.withWriter index fun writer => do\\n      if mode == \\\"full-source\\\" then\\n        let rows := List.mergeSort ((\\\"manifest\\\",some (toJson metadata).compress.toUTF8) ::\\n          added.map (fun (key,row) => (postingKey key row,some (occurrenceCodec.encode row).toByteArray)))\\n          (fun a b => a.1 ≤ b.1)\\n        unless PageMap.ordered rows do throw (IO.userError \\\"duplicate original window occurrence\\\")\\n        let mut levels := []\\n        let mut buffered := []\\n        for row in rows do\\n          buffered := row :: buffered\\n          if buffered.length == 64 then\\n            levels ← VectorMatrix.flushLeaves writer buffered levels\\n            buffered := []\\n        levels ← VectorMatrix.flushLeaves writer buffered levels\\n        writer.root.set (some (← VectorMatrix.finish writer levels))\\n      else\\n        for (key,row) in removed do writer.put (postingKey key row) none\\n        for (key,row) in added do\\n          writer.put (postingKey key row) (some (occurrenceCodec.encode row).toByteArray)\\n        writer.put \\\"manifest\\\" (some (toJson metadata).compress.toUTF8)\\n      unless (← (Sidecar.Owner.ofSnapshot source).pin).head == source.head do\\n        throw (IO.userError \\\"source changed during window-owner preparation\\\")\\n    return ⟨mode,changed,removed.length,added.length,occurrences,written,(← IO.monoMsNow)-started⟩) storage\\n\\nend Eggshell.WindowOwners\\n\"],[\"SourceDelta.lean\",\"module\\npublic import Eggshell.GraphStore\\n\\n@[expose] public section\\nnamespace Eggshell.SourceDelta\\nopen DB Persistence.Store\\n\\ndef linked (parent child : PageMap.Head) : Bool :=\\n  parent.identity == child.identity && parent.authority == child.authority &&\\n    parent.revision+1 == child.revision && parent.bytes < child.bytes\\n\\ninductive Lineage : PageMap.Head → PageMap.Head → Prop where\\n  | same (head) : Lineage head head\\n  | step {first parent child} : Lineage first parent → linked parent child = true → Lineage first child\\n\\ntheorem Lineage.same_identity (chain : Lineage first last) : first.identity = last.identity := by\\n  induction chain with\\n  | same => rfl\\n  | step _ link ih =>\\n    simp only [linked, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at link\\n    exact ih.trans link.1.1.1\\n\\ntheorem Lineage.revision_le (chain : Lineage first last) : first.revision ≤ last.revision := by\\n  induction chain with\\n  | same => omega\\n  | step _ link ih =>\\n    simp only [linked, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at link\\n    omega\\n\\nstructure Delta (first last : PageMap.Head) where\\n  owners : List Nat\\n  records : Nat\\n  bytes : Nat\\n  lineage : Lineage first last\\n\\n/-- The pinned target authenticates every publication. Replay follows actual\\nparent heads back to the exact saved head, not just matching revision numbers.\\nBounds apply before decoding each journal payload. Failure is a full-plan\\ndecision, never a claim that there were no source changes. -/\\nprivate def walk (source : PageMap.Snapshot) (first current : PageMap.Head)\\n    (remaining : Nat) (byteBudget : Nat) : IO (Option (Delta first current)) := do\\n  if same : first = current then return some ⟨[],0,0,by rw [← same]; exact .same first⟩\\n  match remaining with\\n  | 0 => return none\\n  | remaining+1 =>\\n    if current.revision ≤ first.revision then return none\\n    let historical := {source with head := current}\\n    let bytes ← IO.ofExcept (payloadSize (← historical.get (key \\\"change\\\" current.revision)))\\n    if bytes > byteBudget then return none\\n    -- Read this record through its own child head. A later revision must not\\n    -- replace an older journal entry and thereby rewrite the replayed past.\\n    let publication ← readPublication historical current.revision\\n    if publication.change.added.length + publication.change.removed.length + publication.change.affected.length > 8192 then return none\\n    if valid : linked publication.parent current = true then\\n      let some previous ← walk source first publication.parent remaining (byteBudget-bytes) | return none\\n      let owners := hashDistinct (publication.change.added ++ publication.change.removed ++\\n        publication.change.affected ++ previous.owners)\\n      if owners.length > 4096 then return none\\n      return some ⟨owners,previous.records+1,previous.bytes+bytes,.step previous.lineage valid⟩\\n    else return none\\n\\nopaque read? (source : PageMap.Snapshot) (basis : PageMap.Head) : IO (Option (Delta basis source.head)) := do\\n  try\\n    unless basis.identity == source.head.identity && basis.authority == source.head.authority &&\\n        basis.revision ≤ source.head.revision && basis.bytes ≤ source.head.bytes do return none\\n    let result ← walk source basis source.head 4096 (8*1024*1024)\\n    let nodes ← getNat source.get \\\"nodes\\\"\\n    if result.any (fun delta => !delta.owners.all (· < nodes)) then return none\\n    return result\\n  catch _ => return none\\n\\n/-- Only nominated live candidates are read; no directory of all owners and\\nno complete candidate-domain payload is opened by this path. -/\\ndef documents (source : PageMap.Snapshot) (owners : List Nat) : IO (List SearchDocument) := do\\n  let mut rows := []\\n  for owner in owners do\\n    let candidate ← source.get (key \\\"candidate\\\" owner)\\n    if candidate.isNone then continue\\n    unless (← IO.ofExcept (payloadSize candidate)) == 1 do\\n      throw (IO.userError \\\"invalid changed search candidate\\\")\\n    let located ← locateOutcome source owner\\n    let ordinal ← getNat source.get (key \\\"member\\\" owner)\\n    unless (← IO.ofExcept (payloadSize (← source.get (key \\\"searchCandidate\\\" ordinal)))) == owner do\\n      throw (IO.userError \\\"changed search candidate disagrees with its reverse directory\\\")\\n    let encoded ← readChunks source source.get \\\"searchWindows\\\" owner\\n    let (windows,tail) ← IO.ofExcept (windowCodec.decode encoded.toList)\\n    unless tail.isEmpty && !windows.isEmpty &&\\n        windows.all (fun value => PageMap.validIdentity value) do\\n      throw (IO.userError \\\"invalid changed window directory\\\")\\n    rows := ⟨owner,located.header.work,windows,some (Sidecar.Owner.ofSnapshot source)⟩ :: rows\\n  return rows.reverse\\n\\nend Eggshell.SourceDelta\\n\"],[\"GraphStore.lean\",\"module\\n\\npublic import Eggshell.GraphCodec\\npublic import Eggshell.AtomQuotient\\npublic import Eggshell.DB.PageMap\\npublic import Eggshell.DB.Sidecar\\npublic import Eggshell.LogicalText\\npublic import Eggshell.SearchRank\\npublic import Eggshell.Sha256\\npublic import Eggshell.HashDistinct\\npublic import Eggshell.SourceEvidence\\npublic import Std.Data.HashSet.Lemmas\\n\\n@[expose] public section\\nnamespace Eggshell.Persistence.Store\\nopen Lean DB\\n\\nabbrev Snapshot := PageMap.Snapshot\\nabbrev Writer := PageMap.Writer\\n\\ndef key (tag : String) (index : Nat) : String := tag ++ \\\":\\\" ++ toString index\\n\\ndef getNat (read : String → IO (Option ByteArray)) (name : String) : IO Nat := do\\n  let some bytes ← read name | return 0\\n  let (value, tail) ← IO.ofExcept (Wire.natural.decode bytes.toList)\\n  unless tail.isEmpty do throw (IO.userError \\\"trailing bytes in DB counter\\\")\\n  pure value\\n\\ndef putNat (writer : Writer) (name : String) (value : Nat) : IO Unit :=\\n  writer.put name (some (Wire.natural.encode value).toByteArray)\\n\\ndef getIds (read : String → IO (Option ByteArray)) (name : String) : IO (List Nat) := do\\n  let some bytes ← read name | return []\\n  let (ids, tail) ← IO.ofExcept ((Wire.list Wire.natural).decode bytes.toList)\\n  unless tail.isEmpty do throw (IO.userError \\\"trailing bytes in DB id bucket\\\")\\n  pure ids\\n\\ndef putIds (writer : Writer) (name : String) (ids : List Nat) : IO Unit :=\\n  writer.put name (some ((Wire.list Wire.natural).encode ids).toByteArray)\\n\\n/-- Semantic uses are a subset of all structural uses, including Exact-only\\nreferences. The executable add/retract transition preserves that invariant. -/\\nstructure NodeMembership where\\n  total : Nat\\n  semantic : Nat\\n  within : semantic ≤ total\\n\\ndef NodeMembership.add (current : NodeMembership) (semantic : Bool) : NodeMembership :=\\n  ⟨current.total + 1, current.semantic + if semantic then 1 else 0, by\\n    have := current.within\\n    cases semantic <;> simp <;> omega⟩\\n\\ndef NodeMembership.retract? (current : NodeMembership) (semantic : Bool) : Option NodeMembership :=\\n  if present : (if semantic then 0 < current.semantic else current.semantic < current.total) then\\n    some ⟨current.total - 1, current.semantic - if semantic then 1 else 0, by\\n      have := current.within\\n      cases semantic <;> simp at present ⊢ <;> omega⟩\\n  else none\\n\\ntheorem NodeMembership.retract_add (current : NodeMembership) (semantic : Bool) :\\n    (current.add semantic).retract? semantic = some current := by\\n  have present : (if semantic then 0 < (current.add semantic).semantic\\n      else (current.add semantic).semantic < (current.add semantic).total) := by\\n    have := current.within\\n    cases semantic <;> simp [add] <;> omega\\n  rw [retract?, dif_pos present]\\n  cases current\\n  cases semantic <;> simp [add]\\n\\ndef NodeMembership.read (get : String → IO (Option ByteArray)) (node : Nat) : IO NodeMembership := do\\n  let total ← getNat get (key \\\"nodeUses\\\" node)\\n  let semantic ← getNat get (key \\\"semanticUses\\\" node)\\n  if within : semantic ≤ total then pure ⟨total, semantic, within⟩\\n  else throw (IO.userError \\\"semantic membership exceeds structural membership\\\")\\n\\ndef NodeMembership.write (writer : Writer) (node : Nat) (membership : NodeMembership) : IO Unit := do\\n  if membership.total == 0 then writer.put (key \\\"nodeUses\\\" node) none\\n  else putNat writer (key \\\"nodeUses\\\" node) membership.total\\n  if membership.semantic == 0 then writer.put (key \\\"semanticUses\\\" node) none\\n  else putNat writer (key \\\"semanticUses\\\" node) membership.semantic\\n\\n/-- Positions and maximum payload size are checked by construction. The\\nwriter cannot pass a larger body row through the chunk interface. -/\\nstructure Chunk (source : ByteArray) where\\n  start : Nat\\n  stop : Nat\\n  ordered : start ≤ stop\\n  within : stop ≤ source.size\\n  bounded : stop - start ≤ 4096\\n\\ndef Chunk.atOffset (source : ByteArray) (offset : Nat) : Chunk source :=\\n  ⟨min offset source.size, min source.size (offset + 4096), by omega, by omega, by omega⟩\\n\\ndef Chunk.bytes (chunk : Chunk source) : ByteArray := source.extract chunk.start chunk.stop\\n\\ntheorem Chunk.payload_bounded (chunk : Chunk source) : chunk.bytes.size ≤ 4096 := by\\n  rw [Chunk.bytes, ByteArray.size_extract, Nat.min_eq_left chunk.within]\\n  exact chunk.bounded\\n\\ntheorem Chunk.adjacent_exact (source : ByteArray) (first middle last : Nat)\\n    (ordered : first ≤ middle) (within : middle ≤ last) :\\n    source.extract first middle ++ source.extract middle last = source.extract first last := by\\n  rw [ByteArray.extract_append_extract, Nat.min_eq_left ordered, Nat.max_eq_right within]\\n\\nstructure RetainedChunk (requested : ByteArray) where\\n  blob : PageMap.Blob\\n  observed : ByteArray\\n  exact : observed = requested\\n\\ndef retainChunk? (blob : PageMap.Blob) (observed requested : ByteArray) :\\n    Option (RetainedChunk requested) :=\\n  if exact : observed = requested then some ⟨blob, observed, exact⟩ else none\\n\\ntheorem different_chunk_rejected (blob : PageMap.Blob) (observed requested : ByteArray)\\n    (different : observed ≠ requested) : retainChunk? blob observed requested = none := by\\n  simp [retainChunk?, different]\\n\\n/-- Opaque bodies and long reference lists are bounded rows. A shared\\nstructural node has one payload; owner indexes only contain numeric ids. -/\\ndef putChunks (writer : Writer) (tag : String) (index : Nat) (bytes : ByteArray) : IO Unit := do\\n  putNat writer (key tag index) bytes.size\\n  for chunk in [:((bytes.size + 4095) / 4096)] do\\n    let part := Chunk.atOffset bytes (chunk * 4096)\\n    let name := key (key tag index) chunk\\n    -- A stable extent may already contain this exact chunk. The digest only\\n    -- nominates it; compare all bytes before reusing its descriptor. A changed\\n    -- rank page or reverse index must not recopy every unchanged body chunk.\\n    if let some encoded ← writer.get name then\\n      let old ← IO.ofExcept (PageMap.decodeBlob encoded)\\n      if old.bytes == part.bytes.size && old.checksum == PageMap.digest part.bytes then\\n        let actual ← (← writer.snapshot).readBlob old\\n        if (retainChunk? old actual part.bytes).isSome then continue\\n    let blob ← if nonempty : 0 < part.bytes.size then\\n      writer.appendBlob part.bytes nonempty part.payload_bounded\\n      else throw (IO.userError \\\"empty body chunk in a nonempty chunk range\\\")\\n    writer.put name\\n      (some (PageMap.blobCodec.encode blob).toByteArray)\\n\\nabbrev payloadSize := PageMap.payloadSize\\n\\ntheorem payloadSize_missing_rejected : payloadSize none = .error \\\"missing node byte count\\\" := rfl\\n\\ntheorem payloadSize_encoded (size : Nat) :\\n    payloadSize (some (Wire.natural.encode size).toByteArray) = .ok size := by\\n  have decoded := Wire.natural.roundtrip size []\\n  simp only [List.append_nil] at decoded\\n  simp [PageMap.payloadSize, decoded, bind, Except.bind, pure, Except.pure]\\n\\ndef readChunks (snapshot : Snapshot) (read : String → IO (Option ByteArray))\\n    (tag : String) (index : Nat) : IO ByteArray :=\\n  snapshot.readPayloadUsing read (key tag index)\\n\\n/-- Exact comparison keeps only one persisted chunk in memory. A collision\\nprobe never reconstructs an old, potentially huge, Atom merely to compare it\\nwith bytes which are already available to the caller. -/\\ndef chunksEqual (snapshot : Snapshot) (read : String → IO (Option ByteArray))\\n    (tag : String) (index : Nat) (requested : ByteArray) : IO Bool := do\\n  let size ← IO.ofExcept (payloadSize (← read (key tag index)))\\n  if size != requested.size then return false\\n  for chunk in [:((size + 4095) / 4096)] do\\n    let some descriptor ← read (key (key tag index) chunk) | throw (IO.userError \\\"missing node chunk\\\")\\n    let part ← snapshot.readBlob (← IO.ofExcept (PageMap.decodeBlob descriptor))\\n    unless part.size == min 4096 (size - chunk * 4096) do throw (IO.userError \\\"invalid node chunk size\\\")\\n    if part != (Chunk.atOffset requested (chunk * 4096)).bytes then return false\\n  pure true\\n\\n/-- Structural frames contain only reference ids. Atom bytes live in separate\\nchunks and are not needed to decide which nodes or owners a query must read. -/\\ninductive NodeFrame where\\n  | atom\\n  | apply (operator : Operator) (arguments : List (Authority × Nat))\\n  deriving DecidableEq, BEq\\n\\ndef NodeFrame.arguments : NodeFrame → List (Authority × Nat)\\n  | .atom => []\\n  | .apply _ arguments => arguments\\n\\ndef NodeFrame.toJson : NodeFrame → Json\\n  | .atom => .arr #[.str \\\"atom\\\"]\\n  | .apply operator arguments =>\\n      .arr #[.str \\\"apply\\\", .str (operatorName operator),\\n        .arr (arguments.toArray.map storedRefToJson)]\\n\\ndef NodeFrame.fromJson (json : Json) : Except String NodeFrame := do\\n  match (← json.getArr?).toList with\\n  | [.str \\\"atom\\\"] => pure .atom\\n  | [.str \\\"apply\\\", .str operator, .arr arguments] =>\\n      pure (.apply (← operatorFromName operator)\\n        (← arguments.toList.mapM storedRefFromJson))\\n  | _ => throw \\\"invalid DB node frame\\\"\\n\\n/-- The bound belongs to the same node whose frame was read. Both semantic\\nand Exact references must point backwards; authority does not waive safety. -/\\nstructure NodeFrame.Checked (index : Nat) where\\n  frame : NodeFrame\\n  before : ∀ reference ∈ frame.arguments, reference.2 < index\\n\\ndef NodeFrame.check (index : Nat) (frame : NodeFrame) :\\n    Option (NodeFrame.Checked index) :=\\n  if valid : ∀ reference ∈ frame.arguments, reference.2 < index then\\n    some ⟨frame, valid⟩ else none\\n\\ntheorem NodeFrame.check_exact (index : Nat) (frame : NodeFrame) :\\n    (frame.check index).isSome = true ↔\\n      ∀ reference ∈ frame.arguments, reference.2 < index := by\\n  simp [check]\\n\\ntheorem NodeFrame.forward_rejected (index : Nat) (frame : NodeFrame)\\n    (reference : Authority × Nat) (present : reference ∈ frame.arguments)\\n    (forward : index ≤ reference.2) : frame.check index = none := by\\n  have invalid : ¬ ∀ ref ∈ frame.arguments, ref.2 < index := by\\n    intro valid\\n    have := valid reference present\\n    omega\\n  simp only [check, dif_neg invalid]\\n\\n/-- A shallow read follows the very same chunk checks as hydration, but does\\nnot touch an Atom body or any descendant. The dependent result is the only\\nframe accepted by recursive resolution. -/\\ndef readFrame (snapshot : Snapshot) (read : String → IO (Option ByteArray))\\n    (index : Nat) : IO (NodeFrame.Checked index) := do\\n  let bytes ← readChunks snapshot read \\\"node\\\" index\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid node frame encoding\\\")\\n  let frame ← IO.ofExcept (Json.parse text >>= NodeFrame.fromJson)\\n  unless frame.toJson.compress.toUTF8 == bytes do\\n    throw (IO.userError \\\"noncanonical DB node frame\\\")\\n  let some checked := frame.check index\\n    | throw (IO.userError \\\"DB reference is not earlier than its node\\\")\\n  pure checked\\n\\ndef putFrame (writer : Writer) (index : Nat) (checked : NodeFrame.Checked index) : IO Unit :=\\n  putChunks writer \\\"node\\\" index checked.frame.toJson.compress.toUTF8\\n\\ndef exactIds : List (Authority × Nat) → Option (List Nat)\\n  | [] => some []\\n  | (.exact, index) :: tail => (index :: ·) <$> exactIds tail\\n  | (.semantic, _) :: _ => none\\n\\ntheorem exactIds_sound {references ids} (decoded : exactIds references = some ids) :\\n    references = ids.map (Authority.exact, ·) := by\\n  induction references generalizing ids with\\n  | nil => simp [exactIds] at decoded; simp [decoded]\\n  | cons head tail ih =>\\n      rcases head with ⟨authority, index⟩\\n      cases authority with\\n      | semantic => simp [exactIds] at decoded\\n      | exact =>\\n          simp only [exactIds] at decoded\\n          cases decodedTail : exactIds tail with\\n          | none => simp [decodedTail] at decoded\\n          | some tailIds =>\\n              simp [decodedTail] at decoded\\n              subst ids\\n              simp [ih decodedTail]\\n\\ndef semanticIds : List (Authority × Nat) → Option (List Nat)\\n  | [] => some []\\n  | (.semantic, index) :: tail => (index :: ·) <$> semanticIds tail\\n  | (.exact, _) :: _ => none\\n\\ntheorem semanticIds_sound {references ids} (decoded : semanticIds references = some ids) :\\n    references = ids.map (Authority.semantic, ·) := by\\n  induction references generalizing ids with\\n  | nil => simp [semanticIds] at decoded; simp [decoded]\\n  | cons head tail ih =>\\n      rcases head with ⟨authority, index⟩\\n      cases authority with\\n      | exact => simp [semanticIds] at decoded\\n      | semantic =>\\n          simp only [semanticIds] at decoded\\n          cases decodedTail : semanticIds tail with\\n          | none => simp [decodedTail] at decoded\\n          | some tailIds =>\\n              simp [decodedTail] at decoded\\n              subst ids\\n              simp [ih decodedTail]\\n\\n/-- A positional All directory entry supplies numeric references only. It\\ndoes not assert that arbitrary resolved Values form a valid All judgment. -/\\nstructure AllHeader (index : Nat) where\\n  checked : NodeFrame.Checked index\\n  parent : Nat\\n  children : List Nat\\n  positional : checked.frame = .apply .all\\n    ((.semantic, parent) :: children.map (Authority.semantic, ·))\\n  nonempty : children ≠ []\\n  excludes : parent ∉ children\\n\\ndef AllHeader.fromFrame? (checked : NodeFrame.Checked index) : Option (AllHeader index) :=\\n  match shape : checked.frame with\\n  | .apply .all ((.semantic, parent) :: encoded) =>\\n      match decoded : semanticIds encoded with\\n      | some children =>\\n          if nonempty : children ≠ [] then\\n            if excludes : parent ∉ children then\\n              some ⟨checked, parent, children,\\n                by rw [shape, semanticIds_sound decoded], nonempty, excludes⟩\\n            else none\\n          else none\\n      | none => none\\n  | _ => none\\n\\ntheorem AllHeader.parent_before (header : AllHeader index) : header.parent < index := by\\n  apply header.checked.before (.semantic, header.parent)\\n  simp [header.positional, NodeFrame.arguments]\\n\\ntheorem AllHeader.child_before (header : AllHeader index) (child : Nat)\\n    (present : child ∈ header.children) : child < index := by\\n  apply header.checked.before (.semantic, child)\\n  simp [header.positional, NodeFrame.arguments, present]\\n\\n/-- With the producer's canonical node interpretation, numeric references\\nare precisely the original All parent and children; no Atom bytes enter this\\nprojection. The interpretation premise is explicit, not an OS axiom. -/\\ndef AllHeader.interpret (header : AllHeader index) (resolve : Nat → Value)\\n    (canonical : Function.Injective resolve) : AllEdge :=\\n  AllEdge.make (resolve header.parent) (header.children.map resolve)\\n    (by simpa using header.nonempty)\\n    (by\\n      intro present\\n      obtain ⟨child, member, same⟩ := List.mem_map.mp present\\n      exact header.excludes (canonical same ▸ member))\\n\\ntheorem AllHeader.interpret_parent (header : AllHeader index) (resolve : Nat → Value)\\n    (canonical : Function.Injective resolve) :\\n    (header.interpret resolve canonical).parent = resolve header.parent := rfl\\n\\ntheorem AllHeader.interpret_children (header : AllHeader index) (resolve : Nat → Value)\\n    (canonical : Function.Injective resolve) :\\n    (header.interpret resolve canonical).children = header.children.map resolve := rfl\\n\\n/-- The save-time parent posting comes from the checked source frame. It\\ncontains no child list or body; the same record names its reverse directory. -/\\nstructure AllParentPosting where\\n  parent : Nat\\n  ordinal : Nat\\n  root : Nat\\n  deriving DecidableEq\\n\\ndef AllParentPosting.fromHeader (ordinal : Nat) (header : AllHeader index) : AllParentPosting :=\\n  ⟨header.parent, ordinal, index⟩\\n\\ndef AllParentPosting.name (posting : AllParentPosting) : String :=\\n  key (key \\\"allParent\\\" posting.parent) posting.ordinal\\n\\ndef AllParentPosting.matches (posting : AllParentPosting) (query : Nat) : Bool :=\\n  decide (posting.parent = query)\\n\\n/-- Numeric parent lookup is exactly literal decomposition under the\\nproducer's injective interpretation. No approximation of a Work is used. -/\\ntheorem AllParentPosting.matches_exact (header : AllHeader index) (ordinal query : Nat)\\n    (resolve : Nat → Value) (canonical : Function.Injective resolve) :\\n    (fromHeader ordinal header).matches query =\\n      decide ((header.interpret resolve canonical).parent = resolve query) := by\\n  simp only [AllParentPosting.matches, fromHeader, AllHeader.interpret_parent]\\n  congr 1\\n  exact propext ⟨fun same => congrArg resolve same, fun same => canonical same⟩\\n\\ndef AllParentPosting.write (posting : AllParentPosting) (writer : Writer) : IO Unit := do\\n  putNat writer posting.name posting.root\\n  putNat writer (key \\\"allParentOf\\\" posting.root) posting.parent\\n\\n/-- Both reference roles are published from this one checked frame. Child\\nmembership cannot be inferred from generic semantic reachability: an Outcome\\nmay mention a Work without putting it in an All child position. -/\\ndef AllHeader.writeIndex (header : AllHeader index) (ordinal : Nat) (writer : Writer) : IO Unit := do\\n  (AllParentPosting.fromHeader ordinal header).write writer\\n  for child in header.children.eraseDups do\\n    putNat writer (key (key \\\"allChild\\\" child) ordinal) index\\n\\ntheorem AllHeader.child_membership_exact (header : AllHeader index) (query : Nat)\\n    (resolve : Nat → Value) (canonical : Function.Injective resolve) :\\n    query ∈ header.children.eraseDups ↔\\n      resolve query ∈ (header.interpret resolve canonical).children := by\\n  rw [List.mem_eraseDups, interpret_children, List.mem_map]\\n  constructor\\n  · intro member\\n    exact ⟨query, member, rfl⟩\\n  · rintro ⟨child, member, same⟩\\n    exact canonical same ▸ member\\n\\n/-- An owner header is a positional directory entry, not an Outcome judgment.\\nOnly hydration and OutcomeEdge.fromValue? can provide that authority. Exact\\nobservation positions cannot be treated as substitutable Work references. -/\\nstructure OutcomeHeader (index : Nat) where\\n  checked : NodeFrame.Checked index\\n  work : Nat\\n  outcome : Nat\\n  observations : List Nat\\n  positional : checked.frame = .apply .outcome\\n    ((.semantic, work) :: (.semantic, outcome) :: observations.map (Authority.exact, ·))\\n  distinct : observations.Nodup\\n  bounded : observations.length ≤ maxOutcomeObservations\\n\\ndef OutcomeHeader.fromFrame? (checked : NodeFrame.Checked index) :\\n    Option (OutcomeHeader index) :=\\n  match shape : checked.frame with\\n  | .apply .outcome ((.semantic, work) :: (.semantic, outcome) :: encoded) =>\\n      match decoded : exactIds encoded with\\n      | some observations =>\\n          if distinct : observations.Nodup then\\n            if bounded : observations.length ≤ maxOutcomeObservations then\\n              some ⟨checked, work, outcome, observations,\\n                by rw [shape, exactIds_sound decoded], distinct, bounded⟩\\n            else none\\n          else none\\n      | none => none\\n  | _ => none\\n\\ntheorem OutcomeHeader.work_before (header : OutcomeHeader index) : header.work < index := by\\n  apply header.checked.before (.semantic, header.work)\\n  simp [header.positional, NodeFrame.arguments]\\n\\ntheorem OutcomeHeader.outcome_before (header : OutcomeHeader index) : header.outcome < index := by\\n  apply header.checked.before (.semantic, header.outcome)\\n  simp [header.positional, NodeFrame.arguments]\\n\\ntheorem OutcomeHeader.observation_before (header : OutcomeHeader index)\\n    (observation : Nat) (present : observation ∈ header.observations) : observation < index := by\\n  apply header.checked.before (.exact, observation)\\n  simp [header.positional, NodeFrame.arguments, present]\\n\\n/-- The save-time Work directory is derived from the original positional\\nOutcome frame. It is an association index, not a relevance or equality gate.\\nThe payload and its root insertion ordinal are identical on both sides. -/\\nstructure WorkOwnerPosting where\\n  work : Nat\\n  ordinal : Nat\\n  owner : Nat\\n  deriving DecidableEq, BEq\\n\\ndef WorkOwnerPosting.fromHeader (ordinal : Nat) (header : OutcomeHeader index) :\\n    WorkOwnerPosting := ⟨header.work, ordinal, index⟩\\n\\ndef WorkOwnerPosting.name (posting : WorkOwnerPosting) : String :=\\n  key (key \\\"searchWork\\\" posting.work) posting.ordinal\\n\\ndef WorkOwnerPosting.matches (posting : WorkOwnerPosting) (work : Nat) : Bool :=\\n  decide (posting.work = work)\\n\\ntheorem WorkOwnerPosting.matches_original (ordinal query : Nat) (header : OutcomeHeader index)\\n    (resolve : Nat → Value) (canonical : Function.Injective resolve) :\\n    (fromHeader ordinal header).matches query = decide (resolve header.work = resolve query) := by\\n  simp only [WorkOwnerPosting.fromHeader, WorkOwnerPosting.matches]\\n  congr 1\\n  exact propext ⟨fun same => congrArg resolve same, fun same => canonical same⟩\\n\\ndef WorkOwnerPosting.write (posting : WorkOwnerPosting) (writer : Writer) : IO Unit :=\\n  putNat writer posting.name posting.owner\\n\\ndef WorkOwnerPosting.retract (posting : WorkOwnerPosting) (writer : Writer) : IO Unit := do\\n  unless (← IO.ofExcept (payloadSize (← writer.get posting.name))) == posting.owner do\\n    throw (IO.userError \\\"Work owner retraction disagrees with its original posting\\\")\\n  writer.put posting.name none\\n\\n/-- A decoded directory row acquires its Work binding only after checking\\nthe same immutable live Outcome frame used by the producer. -/\\nstructure CheckedWorkOwner (work ordinal owner : Nat) where\\n  header : OutcomeHeader owner\\n  originalWork : header.work = work\\n\\ndef checkedWorkOwner? (work ordinal : Nat) (header : OutcomeHeader owner) :\\n    Option (CheckedWorkOwner work ordinal owner) :=\\n  if same : header.work = work then some ⟨header, same⟩ else none\\n\\ntheorem checked_work_owner_original (checked : CheckedWorkOwner work ordinal owner) :\\n    WorkOwnerPosting.fromHeader ordinal checked.header = ⟨work, ordinal, owner⟩ := by\\n  simp [WorkOwnerPosting.fromHeader, checked.originalWork]\\n\\ntheorem foreign_work_owner_rejected (work ordinal : Nat) (header : OutcomeHeader owner)\\n    (different : header.work ≠ work) : checkedWorkOwner? work ordinal header = none := by\\n  simp [checkedWorkOwner?, different]\\n\\n/-- Reference projection of this same producer. The runtime directory lookup\\nreads the demanded buckets instead of filtering every source window list. -/\\ndef workOwnerBucket (rows : List WorkOwnerPosting) (work : Nat) : List WorkOwnerPosting :=\\n  rows.filter (·.matches work)\\n\\ntheorem work_owner_bucket_complete (rows : List WorkOwnerPosting) (work : Nat)\\n    (posting : WorkOwnerPosting) :\\n    posting ∈ workOwnerBucket rows work ↔ posting ∈ rows ∧ posting.work = work := by\\n  simp [workOwnerBucket, WorkOwnerPosting.matches]\\n\\ntheorem work_owner_retraction_exact (rows : List WorkOwnerPosting) (owner work : Nat) :\\n    workOwnerBucket (rows.filter fun row => row.owner != owner) work =\\n      (workOwnerBucket rows work).filter (fun row => row.owner != owner) := by\\n  simp only [workOwnerBucket, List.filter_filter]\\n  congr 1\\n  funext row\\n  simp only [Bool.and_comm]\\n\\ndef readOutcomeHeader (snapshot : Snapshot) (index : Nat) : IO (OutcomeHeader index) := do\\n  -- Immutability of a node does not mean its owner remains live. Check both\\n  -- inverse directories before following the frame; old bytes left after a\\n  -- retraction are not a candidate in this publication.\\n  unless index < (← getNat snapshot.get \\\"nodes\\\") do\\n    throw (IO.userError \\\"Outcome id is outside its pinned node population\\\")\\n  let rootOrdinal ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"member\\\" index)))\\n  unless rootOrdinal < (← getNat snapshot.get \\\"roots\\\") do\\n    throw (IO.userError \\\"Outcome membership is outside its root directory\\\")\\n  let rootId ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"root\\\" rootOrdinal)))\\n  unless rootId == index do throw (IO.userError \\\"Outcome membership disagrees with its root\\\")\\n  let outcomeOrdinal ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"outcomeOrdinal\\\" index)))\\n  unless outcomeOrdinal < (← getNat snapshot.get \\\"outcomes\\\") do\\n    throw (IO.userError \\\"Outcome ordinal is outside its live directory\\\")\\n  let outcomeId ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"outcome\\\" outcomeOrdinal)))\\n  unless outcomeId == index do throw (IO.userError \\\"Outcome directory disagrees with its owner\\\")\\n  let checked ← readFrame snapshot snapshot.get index\\n  let some header := OutcomeHeader.fromFrame? checked\\n    | throw (IO.userError \\\"invalid Outcome directory frame\\\")\\n  pure header\\n\\n/-- The node number is local to one complete immutable publication. Keeping\\nit with the Head prevents a nomination from another DB or an older live set\\nfrom reaching hydration through the same numeric id. The directory checks\\nare performed by locateOutcome, not inferred from the frame's shape. -/\\nstructure LocatedOutcome (index : Nat) where\\n  head : PageMap.Head\\n  header : OutcomeHeader index\\n\\ndef LocatedOutcome.atHead? (entry : LocatedOutcome index) (head : PageMap.Head) :\\n    Option { checked : LocatedOutcome index // checked.head = head } :=\\n  if same : entry.head = head then some ⟨entry, same⟩ else none\\n\\ntheorem LocatedOutcome.foreign_head_rejected (entry : LocatedOutcome index) (head : PageMap.Head)\\n    (different : entry.head ≠ head) : entry.atHead? head = none := by\\n  simp [atHead?, different]\\n\\ndef locateOutcome (snapshot : Snapshot) (index : Nat) : IO (LocatedOutcome index) := do\\n  pure ⟨snapshot.head, ← readOutcomeHeader snapshot index⟩\\n\\n/-- Resolution recurses on a strictly smaller certified node id. No guessed\\nrecursion fuel, body length, or historical allocation count controls safety. -/\\ndef resolveUsing (snapshot : Snapshot) (read : String → IO (Option ByteArray))\\n    (payload : String → Nat → IO ByteArray)\\n    (known : IO.Ref (Std.HashMap Nat Value)) (index : Nat) : IO Value := do\\n  if let some value := (← known.get)[index]? then return value\\n  let checked ← readFrame snapshot read index\\n  let value ← match shape : checked.frame with\\n    | .atom => pure (.atom (← payload \\\"body\\\" index))\\n    | .apply operator arguments => do\\n        let refs ← arguments.attach.mapM fun reference => do\\n          pure (reference.val.1, ← resolveUsing snapshot read payload known reference.val.2)\\n        pure (.applyList operator refs)\\n  known.modify (·.insert index value)\\n  pure value\\ntermination_by index\\ndecreasing_by\\n  exact checked.before reference.val (by simpa [shape, NodeFrame.arguments] using reference.property)\\n\\ndef resolve (snapshot : Snapshot) (read : String → IO (Option ByteArray))\\n    (known : IO.Ref (Std.HashMap Nat Value)) (index : Nat) : IO Value :=\\n  resolveUsing snapshot read (readChunks snapshot read) known index\\n\\ndef readNode (snapshot : Snapshot) (read : String → IO (Option ByteArray)) (index : Nat) : IO Value := do\\n  resolve snapshot read (← IO.mkRef {}) index\\n\\nstructure WorkOrigin where\\n  work : Value\\n  native : Bool\\n\\nprivate structure NodeMemo where\\n  values : IO.Ref (Std.HashMap Nat Value)\\n  owners : IO.Ref (Std.HashMap Nat (Sigma LocatedOutcome))\\n  origins : IO.Ref (Std.HashMap Nat WorkOrigin)\\n\\nprivate def NodeMemo.new : IO NodeMemo :=\\n  return ⟨← IO.mkRef {}, ← IO.mkRef {}, ← IO.mkRef {}⟩\\n\\n/-- A request-local DAG reader belongs to one complete immutable snapshot.\\nIts constructor and mutable tables are private: callers cannot seed it with a\\nforeign Value, change the publication or reuse it with a writer snapshot.\\nDecoded nodes share their original children and Atom buffers across owners. -/\\nstructure NodeReader (snapshot : Snapshot) where\\n  private mk ::\\n  private memo : NodeMemo\\n\\n@[no_expose] def NodeReader.new (snapshot : Snapshot) : IO (NodeReader snapshot) :=\\n  return NodeReader.mk (← NodeMemo.new)\\n\\n@[no_expose] def NodeReader.read (reader : NodeReader snapshot) (index : Nat) : IO Value :=\\n  resolveUsing snapshot snapshot.get (fun tag index => snapshot.readPayload (key tag index))\\n    (NodeReader.memo reader).values index\\n\\n/-- Live membership and the complete positional frame are validated once per\\nimmutable request. The private table cannot be seeded by a nomination or\\nshared with another source/publication. -/\\n@[no_expose] def NodeReader.locateOutcome (reader : NodeReader snapshot) (index : Nat) :\\n    IO (LocatedOutcome index) := do\\n  let memo := NodeReader.memo reader\\n  if let some cached := (← memo.owners.get)[index]? then\\n    if same : cached.1 = index then return same ▸ cached.2\\n  let entry ← Eggshell.Persistence.Store.locateOutcome snapshot index\\n  memo.owners.modify (·.insert index ⟨index, entry⟩)\\n  pure entry\\n\\n/-- A source certificate nominates exactly this Outcome id. Exact authority\\nand positional binding are checked before reading any certificate payload;\\nthe referenced Outcome body is never hydrated a second time. -/\\ndef sourceHeaderReferences (fields : SourceEvidence.ReceiptFields Nat) : List (Authority × Nat) :=\\n  [.exact, .exact, .exact, .exact, .exact, .exact, .exact].zip\\n    [fields.marker, fields.session, fields.turn, fields.tag, fields.owner, fields.data, fields.purpose]\\n\\nstructure SourceHeader (owner index : Nat) where\\n  checked : NodeFrame.Checked index\\n  fields : SourceEvidence.ReceiptFields Nat\\n  parsed : checked.frame = .apply .receipt (sourceHeaderReferences fields)\\n  bound : fields.owner = owner\\n\\ndef sourceHeader? (owner index : Nat) (checked : NodeFrame.Checked index) :\\n    Option (SourceHeader owner index) := do\\n  match checked.frame with\\n  | .apply .receipt references =>\\n      match SourceEvidence.receiptFields? references with\\n      | none => none\\n      | some fields =>\\n          if bound : fields.owner = owner then\\n            if parsed : checked.frame = .apply .receipt (sourceHeaderReferences fields) then\\n              some ⟨checked, fields, parsed, bound⟩ else none\\n          else none\\n  | _ => none\\n\\ntheorem source_header_bound (header : SourceHeader owner index) : header.fields.owner = owner :=\\n  header.bound\\n\\ndef sourceRange (owner : Nat) : PageMap.KeyRange :=\\n  ⟨key \\\"sourceReceipt\\\" owner ++ \\\":\\\", key \\\"sourceReceipt\\\" owner ++ \\\";\\\"⟩\\n\\ndef NodeReader.sources (reader : NodeReader snapshot) (owner : Nat) :\\n    IO (List SourceEvidence.Record) := do\\n  let _ ← readOutcomeHeader snapshot owner\\n  snapshot.foldRange (sourceRange owner) (fun records (name, value) => do\\n    let some encoded := value | return records\\n    let index ← IO.ofExcept (payloadSize (some encoded))\\n    unless name == key (key \\\"sourceReceipt\\\" owner) index do\\n      throw (IO.userError \\\"source directory key disagrees with receipt\\\")\\n    let reverse ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"sourceOwner\\\" index)))\\n    unless reverse == owner do throw (IO.userError \\\"source directory has another owner\\\")\\n    let ordinal ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"member\\\" index)))\\n    let root ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"root\\\" ordinal)))\\n    unless ordinal < (← getNat snapshot.get \\\"roots\\\") && root == index do\\n      throw (IO.userError \\\"source receipt is not a live root\\\")\\n    let some header := sourceHeader? owner index (← readFrame snapshot snapshot.get index) |\\n      throw (IO.userError \\\"source receipt frame has another owner or authority\\\")\\n    unless (← reader.read header.fields.marker) == .text SourceEvidence.receiptMarker &&\\n        (← reader.read header.fields.purpose) == .text SourceEvidence.receiptPurpose do\\n      throw (IO.userError \\\"source receipt marker is invalid\\\")\\n    let .atom bytes ← reader.read header.fields.data |\\n      throw (IO.userError \\\"source record is not an Atom\\\")\\n    let some record := String.fromUTF8? bytes >>= SourceEvidence.decode? |\\n      throw (IO.userError \\\"source certificate is malformed\\\")\\n    pure (records ++ [record])) []\\n\\n/-- A positional family has one table per source, including sources with\\nequal local node numbers. Lookup is constant time and the dependent result\\ncannot be passed to a different source's node interpreter. -/\\nstructure NodeReaders (snapshots : Array Snapshot) where\\n  private mk ::\\n  private tables : Array NodeMemo\\n  private complete : tables.size = snapshots.size\\n\\n@[no_expose] def NodeReaders.new (snapshots : Array Snapshot) : IO (NodeReaders snapshots) := do\\n  let tables ← snapshots.mapM fun _ => NodeMemo.new\\n  if complete : tables.size = snapshots.size then pure (NodeReaders.mk tables complete)\\n  else throw (IO.userError \\\"source reader table is incomplete\\\")\\n\\n@[no_expose] def NodeReaders.at (readers : NodeReaders snapshots) (source : Fin snapshots.size) :\\n    NodeReader snapshots[source] :=\\n  NodeReader.mk ((NodeReaders.tables readers)[source.val]'(by\\n    simpa only [NodeReaders.complete readers] using source.isLt))\\n\\n/-- The publication is supplied by the reader's type, never a new current\\nhead or a locator-only lookup. This is source binding, not a complete IO\\nrefinement theorem for the external filesystem. -/\\ndef NodeReader.scope (_reader : NodeReader snapshot) : System.FilePath × PageMap.Head :=\\n  (snapshot.directory, snapshot.head)\\n\\ntheorem NodeReader.scope_exact (reader : NodeReader snapshot) :\\n    reader.scope = (snapshot.directory, snapshot.head) := rfl\\n\\ntheorem NodeReaders.at_scope (readers : NodeReaders snapshots) (source : Fin snapshots.size) :\\n    (readers.at source).scope = (snapshots[source].directory, snapshots[source].head) := rfl\\n\\ntheorem NodeReader.different_scope (reader : NodeReader snapshot)\\n    (directory : System.FilePath) (head : PageMap.Head)\\n    (different : (snapshot.directory, snapshot.head) ≠ (directory, head)) :\\n    reader.scope ≠ (directory, head) := different\\n\\n/-- Nomination does not establish evidence. Resolve the original owner from\\nthe same pinned publication, then let the relation parser check its complete\\nsemantic and Exact positions before returning it as an Outcome. -/\\ndef NodeReader.outcome (reader : NodeReader snapshot) (entry : LocatedOutcome index) : IO OutcomeEdge := do\\n  let some checked := entry.atHead? snapshot.head\\n    | throw (IO.userError \\\"Outcome nomination belongs to another pinned publication\\\")\\n  let observed := (← reader.locateOutcome index).header\\n  unless observed.checked.frame == checked.val.header.checked.frame do\\n    throw (IO.userError \\\"Outcome nomination disagrees with its published frame\\\")\\n  let value ← reader.read index\\n  let some edge := OutcomeEdge.fromValue? value\\n    | throw (IO.userError \\\"selected Outcome is not a well-formed relation\\\")\\n  pure edge\\n\\ndef readLocatedOutcome (snapshot : Snapshot) (entry : LocatedOutcome index) : IO OutcomeEdge := do\\n  (← NodeReader.new snapshot).outcome entry\\n\\n/-- Read the nominated Work lane before deciding whether its Outcome is\\nneeded. The complete immutable Head and live inverse directories are checked\\njust as for owner hydration; this never follows the Outcome reference. -/\\ndef NodeReader.work (reader : NodeReader snapshot) (entry : LocatedOutcome index) : IO Value := do\\n  let some checked := entry.atHead? snapshot.head\\n    | throw (IO.userError \\\"Work nomination belongs to another pinned publication\\\")\\n  let observed := (← reader.locateOutcome index).header\\n  unless observed.checked.frame == checked.val.header.checked.frame do\\n    throw (IO.userError \\\"Work nomination disagrees with its published frame\\\")\\n  reader.read observed.work\\n\\ndef readLocatedWork (snapshot : Snapshot) (entry : LocatedOutcome index) : IO Value := do\\n  (← NodeReader.new snapshot).work entry\\n\\nstructure Intern where\\n  writer : Writer\\n  known : IO.Ref (Std.HashMap Value Nat)\\n\\n/-- A hash nominates a small collision bucket. Complete structural equality\\nof decoded candidates decides identity, including Exact reference positions. -/\\ndef Intern.valueBound (intern : Intern) : Nat → Value → IO Nat\\n  | 0, _ => throw (IO.userError \\\"node allocation exceeded structural bound\\\")\\n  | fuel + 1, value => do\\n    if let some id := (← intern.known.get)[value]? then return id\\n    let frame ← match value with\\n      | .atom _ => pure NodeFrame.atom\\n      | .apply operator arguments =>\\n          let refs ← arguments.toList.mapM fun (authority, child) => do\\n            pure (authority, ← intern.valueBound fuel child)\\n          pure (NodeFrame.apply operator refs)\\n    let bucket := \\\"hash:\\\" ++ toString (hash value)\\n    let ids ← getIds intern.writer.get bucket\\n    for id in ids do\\n      let snapshot ← intern.writer.snapshot\\n      -- Child ids were individually interned above. Comparing this exact\\n      -- frame therefore does not recursively hydrate an old Outcome body.\\n      if (← readFrame snapshot intern.writer.get id).frame != frame then continue\\n      let same ← match value with\\n        | .atom bytes => chunksEqual snapshot intern.writer.get \\\"body\\\" id bytes\\n        | .apply .. => pure true\\n      if same then\\n        intern.known.modify (·.insert value id)\\n        return id\\n    let id ← getNat intern.writer.get \\\"nodes\\\"\\n    let some checked := frame.check id\\n      | throw (IO.userError \\\"node allocation does not follow its dependencies\\\")\\n    putNat intern.writer \\\"nodes\\\" (id + 1)\\n    putFrame intern.writer id checked\\n    if let .atom bytes := value then putChunks intern.writer \\\"body\\\" id bytes\\n    putNat intern.writer (key \\\"nodeHash\\\" id) (hash value).toNat\\n    putIds intern.writer bucket (ids ++ [id])\\n    intern.known.modify (·.insert value id)\\n    pure id\\n\\n\\ndef Intern.value (intern : Intern) (value : Value) : IO Nat :=\\n  intern.valueBound value.structuralSize value\\n\\n/-- Read-only structural identity lookup. Hashes nominate a bucket; complete\\nchild positions and streamed Atom bytes decide identity. Exact and Semantic\\nreferences remain different, and a missing node is never allocated by search. -/\\ndef findNodeBound? (snapshot : Snapshot) : Nat → Value → IO (Option Nat)\\n  | 0, _ => throw (IO.userError \\\"node lookup exceeded structural bound\\\")\\n  | fuel + 1, value => do\\n    let frame ← match value with\\n      | .atom _ => pure NodeFrame.atom\\n      | .apply operator arguments =>\\n          let mut refs := []\\n          for (authority, child) in arguments.toList do\\n            let some id ← findNodeBound? snapshot fuel child | return none\\n            refs := (authority, id) :: refs\\n          pure (.apply operator refs.reverse)\\n    for id in (← getIds snapshot.get (\\\"hash:\\\" ++ toString (hash value))) do\\n      unless id < (← getNat snapshot.get \\\"nodes\\\") do\\n        throw (IO.userError \\\"hash bucket exceeds its published node population\\\")\\n      if (← readFrame snapshot snapshot.get id).frame != frame then continue\\n      let same ← match value with\\n        | .atom bytes => chunksEqual snapshot snapshot.get \\\"body\\\" id bytes\\n        | .apply .. => pure true\\n      if same then return some id\\n    pure none\\n\\ndef findNode? (snapshot : Snapshot) (value : Value) : IO (Option Nat) :=\\n  findNodeBound? snapshot value.structuralSize value\\n\\n/-- Portable nomination metadata, checked against the same collision bucket\\nused by interning. This is not equality or source authority. -/\\ndef nodeHash (snapshot : Snapshot) (index : Nat) : IO Nat := do\\n  unless index < (← getNat snapshot.get \\\"nodes\\\") do\\n    throw (IO.userError \\\"portable node nomination exceeds allocation\\\")\\n  let hash ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"nodeHash\\\" index)))\\n  unless (← getIds snapshot.get (\\\"hash:\\\" ++ toString hash)).contains index do\\n    throw (IO.userError \\\"portable node nomination disagrees with its bucket\\\")\\n  pure hash\\n\\n/-- Cross-source comparison holds at most one checked payload chunk from each\\nsource. Neither a digest nor an equal byte count decides Atom identity. -/\\nstructure BodyChunk (size chunk : Nat) where\\n  bytes : ByteArray\\n  exactSize : bytes.size = min 4096 (size - chunk * 4096)\\n\\ntheorem BodyChunk.bounded (part : BodyChunk size chunk) : part.bytes.size ≤ 4096 := by\\n  rw [part.exactSize]\\n  exact Nat.min_le_left _ _\\n\\ndef bodyChunk (snapshot : Snapshot) (index size chunk : Nat) : IO (BodyChunk size chunk) := do\\n  let some encoded ← snapshot.get (key (key \\\"body\\\" index) chunk) |\\n    throw (IO.userError \\\"missing source comparison chunk\\\")\\n  let blob ← IO.ofExcept (PageMap.decodeBlob encoded)\\n  unless blob.bytes == min 4096 (size - chunk * 4096) do\\n    throw (IO.userError \\\"source comparison chunk exceeds original body\\\")\\n  let bytes ← snapshot.readBlob blob\\n  if valid : bytes.size = min 4096 (size - chunk * 4096) then pure ⟨bytes, valid⟩\\n  else throw (IO.userError \\\"incomplete source comparison chunk\\\")\\n\\ndef bodiesEqual (left : Snapshot) (leftId : Nat) (right : Snapshot) (rightId : Nat) : IO Bool := do\\n  let leftSize ← IO.ofExcept (payloadSize (← left.get (key \\\"body\\\" leftId)))\\n  let rightSize ← IO.ofExcept (payloadSize (← right.get (key \\\"body\\\" rightId)))\\n  if leftSize != rightSize then return false\\n  let first ← PageMap.QuietReader.make left\\n  let second ← PageMap.QuietReader.make right\\n  let comparison ← PageMap.checkPrefix (fun chunk => do\\n    pure ((← bodyChunk first.snapshot leftId leftSize chunk).bytes ==\\n      (← bodyChunk second.snapshot rightId rightSize chunk).bytes)) 0 ((leftSize + 4095) / 4096)\\n  left.observe (.payload (key \\\"body\\\" leftId) leftSize comparison.checked)\\n  right.observe (.payload (key \\\"body\\\" rightId) rightSize comparison.checked)\\n  pure comparison.accepted\\n\\n/-- Equal arity is required before any zip traversal. A shorter reference list\\nmust never be accepted because its common prefix happens to agree. -/\\nstructure ReferencePairs (left right : List (Authority × Nat)) where\\n  pairs : List ((Authority × Nat) × (Authority × Nat))\\n  leftExact : pairs.map Prod.fst = left\\n  rightExact : pairs.map Prod.snd = right\\n  authority : ∀ pair ∈ pairs, pair.1.1 = pair.2.1\\n\\ndef ReferencePairs.check? (left right : List (Authority × Nat)) : Option (ReferencePairs left right) :=\\n  if same : left.length = right.length then\\n    if tags : (left.zip right).all (fun pair => decide (pair.1.1 = pair.2.1)) = true then\\n      some { pairs := left.zip right\\n             leftExact := by simp [List.map_fst_zip, same]\\n             rightExact := by simp [List.map_snd_zip, same]\\n             authority := fun pair present => of_decide_eq_true ((List.all_eq_true.mp tags) pair present) }\\n    else none\\n  else none\\n\\ntheorem ReferencePairs.positions (pairs : ReferencePairs left right) :\\n    pairs.pairs.length = left.length ∧ pairs.pairs.length = right.length := by\\n  constructor\\n  · simpa only [List.length_map] using congrArg List.length pairs.leftExact\\n  · simpa only [List.length_map] using congrArg List.length pairs.rightExact\\n\\ntheorem ReferencePairs.unequal_arity (left right : List (Authority × Nat))\\n    (different : left.length ≠ right.length) : ReferencePairs.check? left right = none := by\\n  simp [check?, different]\\n\\n/-- The executable pairing certificate preserves the complete decoded\\napplication, including Exact positions. Child comparison must establish\\ncomplete equality; matching hashes or semantic footprints are insufficient. -/\\ntheorem ReferencePairs.resolved (paired : ReferencePairs left right)\\n    (first second : Nat → Value)\\n    (children : ∀ pair ∈ paired.pairs, first pair.1.2 = second pair.2.2) :\\n    left.map (fun ref => (ref.1, first ref.2)) =\\n      right.map (fun ref => (ref.1, second ref.2)) := by\\n  calc\\n    _ = paired.pairs.map (fun pair => (pair.1.1, first pair.1.2)) := by\\n      simpa only [List.map_map, Function.comp_def] using\\n        (congrArg (List.map (fun ref : Authority × Nat => (ref.1, first ref.2))) paired.leftExact).symm\\n    _ = paired.pairs.map (fun pair => (pair.2.1, second pair.2.2)) := by\\n      apply List.map_congr_left\\n      intro pair member\\n      exact Prod.ext (paired.authority pair member) (children pair member)\\n    _ = _ := by\\n      simpa only [List.map_map, Function.comp_def] using\\n        congrArg (List.map (fun ref : Authority × Nat => (ref.1, second ref.2))) paired.rightExact\\n\\ntheorem ReferencePairs.application_exact (paired : ReferencePairs left right)\\n    (operator : Operator) (first second : Nat → Value)\\n    (children : ∀ pair ∈ paired.pairs, first pair.1.2 = second pair.2.2) :\\n    Value.applyList operator (left.map (fun ref => (ref.1, first ref.2))) =\\n      Value.applyList operator (right.map (fun ref => (ref.1, second ref.2))) := by\\n  rw [paired.resolved first second children]\\n\\n/-- This interpreter compares two persisted DAGs without constructing either\\nstructural Value. Checked frames preserve every Exact/Semantic position. -/\\ndef nodesEqualBound (left : Snapshot) (right : Snapshot) : Nat → Nat → Nat → IO Bool\\n  | 0, _, _ => throw (IO.userError \\\"source identity exceeds its backward-reference bound\\\")\\n  | fuel + 1, leftId, rightId => do\\n      if (← nodeHash left leftId) != (← nodeHash right rightId) then return false\\n      if left.directory == right.directory && left.head == right.head && leftId == rightId then\\n        return true\\n      let first ← readFrame left left.get leftId\\n      let second ← readFrame right right.get rightId\\n      match first.frame, second.frame with\\n      | .atom, .atom => bodiesEqual left leftId right rightId\\n      | .apply firstOp firstRefs, .apply secondOp secondRefs =>\\n          if firstOp != secondOp then return false\\n          let some paired := ReferencePairs.check? firstRefs secondRefs | return false\\n          for ((_, firstId), (_, secondId)) in paired.pairs do\\n            unless ← nodesEqualBound left right fuel firstId secondId do return false\\n          pure true\\n      | _, _ => pure false\\n\\ndef nodesEqual (left : Snapshot) (leftId : Nat) (right : Snapshot) (rightId : Nat) : IO Bool :=\\n  nodesEqualBound left right (leftId + 1) leftId rightId\\n\\n/-- Observation orientation is derived from the same authority-position\\nparser used on Values. Atom bodies and Exact receipt payloads are not read. -/\\ndef NodeFrame.nativeEndpoints? : NodeFrame → Option (Nat × Nat)\\n  | .apply .occurrence arguments =>\\n      match Relation.splitOccurrence arguments with\\n      | some ([observed, invoked], _) => some (observed, invoked)\\n      | _ => none\\n  | _ => none\\n\\n/-- A frame's interpretation preserves every original authority position.\\nThe Atom payload is explicit; classifying an observation never consults it. -/\\ndef NodeFrame.resolveWith (resolve : Nat → Value) (body : ByteArray) : NodeFrame → Value\\n  | .atom => .atom body\\n  | .apply operator arguments =>\\n      .applyList operator (arguments.map fun ref => (ref.1, resolve ref.2))\\n\\ntheorem AllHeader.interpret_frame (header : AllHeader index) (resolve : Nat → Value)\\n    (canonical : Function.Injective resolve) (body : ByteArray) :\\n    (header.interpret resolve canonical).relation = header.checked.frame.resolveWith resolve body := by\\n  simp [AllHeader.interpret, AllEdge.make, header.positional, NodeFrame.resolveWith,\\n    List.map_map, Function.comp_def, Ref.semantic]\\n\\ndef NodeFrame.nativeResolved (frame : NodeFrame) (resolve : Nat → Value)\\n    (outcome work : Nat) : Bool :=\\n  match frame.nativeEndpoints? with\\n  | some (observed, invoked) => resolve observed == resolve outcome && resolve invoked == resolve work\\n  | none => false\\n\\n/-- Shallow positional classification is exactly the original Value parser\\nfor any consistent interpretation of the referenced nodes, including aliases\\nwith different ids but equal Values. This is not a claim about arbitrary IO. -/\\ntheorem NodeFrame.nativeResolved_exact (frame : NodeFrame) (resolve : Nat → Value)\\n    (body : ByteArray) (outcome work : Nat) :\\n    frame.nativeResolved resolve outcome work =\\n      Relation.observesOutcomeWork (resolve outcome) (resolve work) (frame.resolveWith resolve body) := by\\n  cases frame with\\n  | atom => rfl\\n  | apply operator arguments =>\\n      cases operator <;> try rfl\\n      simp only [nativeResolved, nativeEndpoints?, resolveWith, Value.applyList,\\n        Relation.observesOutcomeWork, Refs.toList_ofList, Relation.splitOccurrence_map]\\n      cases parsed : Relation.splitOccurrence arguments with\\n      | none => simp\\n      | some pair =>\\n          rcases pair with ⟨meanings, receipts⟩\\n          cases meanings with\\n          | nil => simp\\n          | cons observed tail =>\\n              cases tail with\\n              | nil => simp\\n              | cons invoked tail =>\\n                  cases tail <;> simp\\n\\n/-- Work and native occurrence orientation from one live pinned owner.\\nThis is nomination metadata, never a substitute Outcome or evidence payload.\\nDistinct but equal endpoint ids use bounded structural comparison. -/\\n@[no_expose] def NodeReader.workOrigin (reader : NodeReader snapshot) (entry : LocatedOutcome index) : IO WorkOrigin := do\\n  let some checked := entry.atHead? snapshot.head |\\n    throw (IO.userError \\\"Work origin belongs to another pinned publication\\\")\\n  let header := (← reader.locateOutcome index).header\\n  unless header.checked.frame == checked.val.header.checked.frame do\\n    throw (IO.userError \\\"Work origin disagrees with its published frame\\\")\\n  let memo := reader.memo\\n  if let some origin := (← memo.origins.get)[index]? then return origin\\n  let work ← reader.read header.work\\n  let mut native := false\\n  for observation in header.observations do\\n    let frame ← readFrame snapshot snapshot.get observation\\n    if let some (observed, invoked) := frame.frame.nativeEndpoints? then\\n      -- Equal ids in this same checked frame name the same original node.\\n      -- Distinct aliases still require the complete structural interpreter.\\n      let sameOutcome ← if observed == header.outcome then pure true\\n        else nodesEqual snapshot observed snapshot header.outcome\\n      let sameWork ← if invoked == header.work then pure true\\n        else nodesEqual snapshot invoked snapshot header.work\\n      if sameOutcome && sameWork then\\n        native := true\\n        break\\n  let origin : WorkOrigin := {work, native}\\n  memo.origins.modify (·.insert index origin)\\n  pure origin\\n\\ndef readLocatedWorkOrigin (snapshot : Snapshot) (entry : LocatedOutcome index) : IO WorkOrigin := do\\n  (← NodeReader.new snapshot).workOrigin entry\\n\\n/-- Only a structurally live node can be nominated for manual selection.\\nThe digest is checked against the existing allocation bucket; it establishes\\nneither equality nor uniqueness, which the caller must check separately. -/\\nstructure LiveSelectionNode where\\n  id : Nat\\n  uses : Nat\\n  active : 0 < uses\\n\\ndef selectionNodes (snapshot : Snapshot) (selected : SelectionKey spelling) :\\n    IO (List LiveSelectionNode) := do\\n  let mut found := []\\n  for id in (← getIds snapshot.get (\\\"hash:\\\" ++ toString selected.digest)) do\\n    unless (← nodeHash snapshot id) == selected.digest do\\n      throw (IO.userError \\\"selection nomination disagrees with its allocation\\\")\\n    let membership ← NodeMembership.read snapshot.get id\\n    let uses := membership.total\\n    if active : 0 < uses then found := ⟨id, uses, active⟩ :: found\\n  pure found.reverse\\n\\ndef liveRoot? (snapshot : Snapshot) (value : Value) : IO (Option (Nat × Nat)) := do\\n  let some id ← findNode? snapshot value | return none\\n  let some member ← snapshot.get (key \\\"member\\\" id) | return none\\n  let ordinal ← IO.ofExcept (payloadSize (some member))\\n  unless ordinal < (← getNat snapshot.get \\\"roots\\\") &&\\n      (← IO.ofExcept (payloadSize (← snapshot.get (key \\\"root\\\" ordinal)))) == id do\\n    throw (IO.userError \\\"root identity disagrees with live membership\\\")\\n  pure (some (ordinal, id))\\n\\n/-- These are exactly the owner-level document-frequency terms, rather than\\noccurrence counts. Only text Work creates a compiled candidate. -/\\ndef text? : Value → Option String\\n  | .atom bytes => String.fromUTF8? bytes\\n  | .apply .. => none\\n\\ndef ownerTermsFor (owner : OutcomeEdge) : List String :=\\n  match text? owner.work with\\n  | none => []\\n  | some work => hashDistinct\\n      ((LogicalText.logical work).units.map (·.text) ++\\n       ((text? owner.outcome).toList.flatMap fun text =>\\n          (LogicalText.logical text).units.map (·.text)))\\n\\ndef ownerTerms (value : Value) : List String :=\\n  (OutcomeEdge.fromValue? value).toList.flatMap ownerTermsFor\\n\\ndef ownerWorkSurfaces (owner : OutcomeEdge) : List String :=\\n  (text? owner.work).toList.flatMap LogicalText.surfaceNames\\n\\n/-- Search-only metadata is compiled while original bytes are available.\\nWindow digests locate optional numerical hints; they never authorize a graph\\nidentity, a completed Work, or an erased operation. -/\\ndef searchText (owner : OutcomeEdge) : String :=\\n  (text? owner.work |>.getD \\\"\\\") ++ \\\"\\\\n\\\" ++ (text? owner.outcome |>.getD \\\"\\\")\\n\\ndef windowKey (text : String) : String := Sha256.hex text.toUTF8\\n\\ndef searchWindows (owner : OutcomeEdge) : List String :=\\n  (SearchRank.windows (searchText owner)).map windowKey\\n\\ndef windowCodec : Wire.Codec (List String) := Wire.list Wire.text\\n\\ntheorem window_codec_roundtrip (windows : List String) (tail : List UInt8) :\\n    windowCodec.decode (windowCodec.encode windows ++ tail) = .ok (windows, tail) :=\\n  windowCodec.roundtrip windows tail\\n\\n/-- Checked positions refer to original immutable bytes, not a second copy\\nof the source. The source bounds and the extraction bound survive decoding. -/\\nstructure WindowRange (size : Nat) where\\n  start : Nat\\n  stop : Nat\\n  ordered : start ≤ stop\\n  within : stop ≤ size\\n  bounded : stop - start ≤ 2048\\n\\ndef WindowRange.make? (size start stop : Nat) : Option (WindowRange size) :=\\n  if valid : start ≤ stop ∧ stop ≤ size ∧ stop - start ≤ 2048 then\\n    some ⟨start, stop, valid.1, valid.2.1, valid.2.2⟩ else none\\n\\nstructure SourceWindow (source : ByteArray) (text : String) where\\n  range : WindowRange source.size\\n  exact : source.extract range.start range.stop = text.toUTF8\\n\\ndef SourceWindow.make? (source : ByteArray) (start : Nat) (text : String) :\\n    Option (SourceWindow source text) := do\\n  let range ← WindowRange.make? source.size start (start + text.utf8ByteSize)\\n  if exact : source.extract range.start range.stop = text.toUTF8 then\\n    some ⟨range, exact⟩ else none\\n\\ntheorem SourceWindow.source_exact (window : SourceWindow source text) :\\n    source.extract window.range.start window.range.stop = text.toUTF8 := window.exact\\n\\ntheorem WindowRange.extraction_bounded {source : ByteArray} (range : WindowRange source.size) :\\n    (source.extract range.start range.stop).size ≤ 2048 := by\\n  rw [ByteArray.size_extract, Nat.min_eq_left range.within]\\n  exact range.bounded\\n\\ntheorem WindowRange.chunks_bounded (range : WindowRange size) :\\n    (range.stop + 4095) / 4096 - range.start / 4096 ≤ 2 := by\\n  have := range.ordered\\n  have := range.bounded\\n  omega\\n\\ndef spanCodec : Wire.Codec (Nat × Nat) := Wire.natural.product Wire.natural\\ndef searchBodyCodec : Wire.Codec (Nat × Option Nat) := Wire.natural.product (Wire.optional Wire.natural)\\n\\ntheorem span_codec_roundtrip (span : Nat × Nat) (tail : List UInt8) :\\n    spanCodec.decode (spanCodec.encode span ++ tail) = .ok (span, tail) := spanCodec.roundtrip span tail\\n\\n/-- At most two 4KiB chunks intersect a window; source size does not control\\nthis loop. The caller supplies the bounds checked for this exact node. -/\\ndef readBodyRange (snapshot : Snapshot) (node size start stop : Nat)\\n    (_ordered : start ≤ stop) (_within : stop ≤ size) (_bounded : stop - start ≤ 2048) : IO ByteArray := do\\n  unless (← IO.ofExcept (payloadSize (← snapshot.get (key \\\"body\\\" node)))) == size do\\n    throw (IO.userError \\\"window body length disagrees with its pinned source\\\")\\n  let mut result := ByteArray.empty\\n  if start == stop then return result\\n  for chunk in [start / 4096 : (stop + 4095) / 4096] do\\n    let some encoded ← snapshot.get (key (key \\\"body\\\" node) chunk) |\\n      throw (IO.userError \\\"missing source window chunk\\\")\\n    let part ← snapshot.readBlob (← IO.ofExcept (PageMap.decodeBlob encoded))\\n    unless part.size == min 4096 (size - chunk * 4096) do\\n      throw (IO.userError \\\"invalid source window chunk length\\\")\\n    result := result ++ part.extract (start - chunk * 4096) (stop - chunk * 4096)\\n  unless result.size == stop - start do throw (IO.userError \\\"incomplete source window\\\")\\n  pure result\\n\\ndef termKey (space unit : String) : String := space ++ \\\":\\\" ++ (Json.str unit).compress\\n\\n/-- Search terms have their own dense dictionary. They are not graph nodes:\\nallocating an Atom frame, body descriptor, and graph hash row for every word\\nmultiplies metadata writes without adding graph information. -/\\ndef termPayloadCodec : Wire.Codec (Sum ByteArray Nat) := Wire.sum Wire.byteBlob Wire.natural\\n\\ntheorem term_payload_roundtrip (payload : Sum ByteArray Nat) (tail : List UInt8) :\\n    termPayloadCodec.decode (termPayloadCodec.encode payload ++ tail) = .ok (payload, tail) :=\\n  termPayloadCodec.roundtrip payload tail\\n\\ndef termBucket (unit : String) : String := \\\"termHash:\\\" ++ toString (hash unit)\\n\\nstructure Term (unit : String) where\\n  id : Nat\\n  spelling : String\\n  exact : spelling = unit\\n\\ndef term? (id : Nat) (spelling unit : String) : Option (Term unit) :=\\n  if exact : spelling = unit then some ⟨id, spelling, exact⟩ else none\\n\\ntheorem different_term_rejected (id : Nat) (spelling unit : String)\\n    (different : spelling ≠ unit) : term? id spelling unit = none := by\\n  simp [term?, different]\\n\\ndef readTerm (snapshot : Snapshot) (read : String → IO (Option ByteArray)) (id : Nat) : IO String := do\\n  let some bytes ← read (key \\\"term\\\" id) | throw (IO.userError \\\"missing term dictionary entry\\\")\\n  let (payload, tail) ← IO.ofExcept (termPayloadCodec.decode bytes.toList)\\n  unless tail.isEmpty && (termPayloadCodec.encode payload).toByteArray == bytes do\\n    throw (IO.userError \\\"invalid term dictionary entry\\\")\\n  let bytes ← match payload with\\n    | .inl bytes =>\\n        unless bytes.size ≤ 128 do throw (IO.userError \\\"oversized inline term\\\")\\n        pure bytes\\n    | .inr size =>\\n        unless size > 128 do throw (IO.userError \\\"noncanonical chunked term\\\")\\n        let bytes ← readChunks snapshot read \\\"termText\\\" id\\n        unless bytes.size == size do throw (IO.userError \\\"term dictionary size differs from its body\\\")\\n        pure bytes\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid term encoding\\\")\\n  pure text\\n\\n/-- A hash only nominates entries. The dependent result carries full spelling\\nequality, so a collision cannot combine frequencies for different words. -/\\ndef findTerm? (snapshot : Snapshot) (read : String → IO (Option ByteArray))\\n    (unit : String) : IO (Option (Term unit)) := do\\n  for id in (← getIds read (termBucket unit)) do\\n    if let some term := term? id (← readTerm snapshot read id) unit then return some term\\n  pure none\\n\\ndef Intern.term (intern : Intern) (unit : String) : IO Nat := do\\n  if let some term ← findTerm? (← intern.writer.snapshot) intern.writer.get unit then return term.id\\n  let id ← getNat intern.writer.get \\\"terms\\\"\\n  putNat intern.writer \\\"terms\\\" (id + 1)\\n  let bytes := unit.toUTF8\\n  let payload ← if bytes.size ≤ 128 then pure (.inl bytes) else do\\n    putChunks intern.writer \\\"termText\\\" id bytes\\n    pure (.inr bytes.size)\\n  intern.writer.put (key \\\"term\\\" id) (some (termPayloadCodec.encode payload).toByteArray)\\n  let bucket := termBucket unit\\n  putIds intern.writer bucket ((← getIds intern.writer.get bucket) ++ [id])\\n  pure id\\n\\nnamespace RootReach\\n\\n/-- One reverse directory contains every structural node exactly once.\\nSemantic membership is a separate role; an Exact-only observation is still\\nmanually selectable, but cannot enlarge the semantic discovery population. -/\\ndef compile (root : Value) : List (Value × Bool) :=\\n  let semantic := root.foldSemanticNodes\\n    (fun (known : Std.HashMap Value Unit) node => known.insert node ()) {}\\n  let structural := root.foldNodes HashDistinct.step\\n    (({} : Std.HashMap Value Unit), [])\\n  structural.2.reverse.map fun node => (node, semantic.contains node)\\n\\n/-- The actual save-time compiler preserves every node, its first-occurrence\\norder and its Semantic/Exact role. It does not build either flattened input\\nlist merely to discard duplicates afterwards. -/\\ntheorem compile_reference (root : Value) : compile root =\\n    (hashDistinct root.nodes).map (fun node =>\\n      (node, (Std.HashSet.ofList root.semanticNodes).contains node)) := by\\n  simp only [compile, Value.foldNodes_exact, Value.foldSemanticNodes_exact]\\n  change (hashDistinct root.nodes).map _ = _\\n  apply List.map_congr_left\\n  intro node _\\n  congr 1\\n  rw [HashDistinct.fold_contains]\\n  simp [Std.HashSet.contains_ofList]\\n\\ntheorem compile_nodes (root : Value) : (compile root).map Prod.fst = hashDistinct root.nodes := by\\n  simp [compile_reference, List.map_map, Function.comp_def]\\n\\ntheorem compile_unique (root : Value) : ((compile root).map Prod.fst).Nodup := by\\n  rw [compile_nodes]\\n  exact HashDistinct.nodup _\\n\\ntheorem compile_member (root node : Value) :\\n    node ∈ (compile root).map Prod.fst ↔ node ∈ root.nodes := by\\n  rw [compile_nodes, HashDistinct.mem]\\n\\ntheorem compile_role (root : Value) (row : Value × Bool) (member : row ∈ compile root) :\\n    row.2 = true ↔ row.1 ∈ root.semanticNodes := by\\n  rw [compile_reference] at member\\n  obtain ⟨node, _member, same⟩ := List.mem_map.mp member\\n  subst row\\n  simp [Std.HashSet.contains_ofList]\\n\\ntheorem compile_semantic_complete (root node : Value) (member : node ∈ root.semanticNodes) :\\n    (node, true) ∈ compile root := by\\n  rw [compile_reference]\\n  apply List.mem_map.mpr\\n  refine ⟨node, (HashDistinct.mem _ _).mpr (Value.semanticNodes_subset_nodes root member), ?_⟩\\n  simp [Std.HashSet.contains_ofList, member]\\n\\nabbrev Row := Sum Nat Nat\\ndef node : Row → Nat := Sum.elim id id\\ndef semantic : Row → Bool | .inl _ => true | .inr _ => false\\ndef codec : Wire.Codec (List Row) := Wire.list (Wire.sum Wire.natural Wire.natural)\\n\\ntheorem codec_roundtrip (rows : List Row) (tail : List UInt8) :\\n    codec.decode (codec.encode rows ++ tail) = .ok (rows, tail) := codec.roundtrip rows tail\\n\\nstructure Checked where\\n  rows : List Row\\n  unique : (rows.map node).Nodup\\n\\ndef check? (rows : List Row) : Option Checked :=\\n  if unique : HashDistinct.unique (rows.map node) = true then\\n    some ⟨rows, HashDistinct.unique_exact _ |>.mp unique⟩ else none\\n\\ntheorem check_exact (rows : List Row) :\\n    (check? rows).isSome = true ↔ (rows.map node).Nodup := by\\n  simp [check?, HashDistinct.unique_exact]\\n\\ndef read (snapshot : Snapshot) (get : String → IO (Option ByteArray)) (id : Nat) : IO Checked := do\\n  let bytes ← readChunks snapshot get \\\"rootReach\\\" id\\n  let (rows, tail) ← IO.ofExcept (codec.decode bytes.toList)\\n  unless tail.isEmpty && (codec.encode rows).toByteArray == bytes do\\n    throw (IO.userError \\\"noncanonical root reach directory\\\")\\n  let some checked := check? rows | throw (IO.userError \\\"duplicate root reach node\\\")\\n  let allocated ← getNat get \\\"nodes\\\"\\n  unless checked.rows.all (fun row => decide (node row < allocated)) do\\n    throw (IO.userError \\\"root reach node exceeds allocation\\\")\\n  pure checked\\n\\nend RootReach\\n\\n/-- Membership, stable insertion order, terms and frequency counters are in\\none batch/root. Replaying a root cannot increment any of these indexes twice. -/\\ndef Intern.root (intern : Intern) (value : Value) : IO Nat := do\\n  let id ← intern.value value\\n  if (← intern.writer.get (key \\\"member\\\" id)).isSome then return id\\n  let ordinal ← getNat intern.writer.get \\\"roots\\\"\\n  putNat intern.writer \\\"roots\\\" (ordinal + 1)\\n  putNat intern.writer (key \\\"root\\\" ordinal) id\\n  putNat intern.writer (key \\\"member\\\" id) ordinal\\n  let rows ← (RootReach.compile value).mapM fun (node, semantic) => do\\n    let id ← intern.value node\\n    pure (if semantic then Sum.inl id else Sum.inr id)\\n  let some reached := RootReach.check? rows |\\n    throw (IO.userError \\\"interned root reach contains duplicate node identities\\\")\\n  putChunks intern.writer \\\"rootReach\\\" id (RootReach.codec.encode reached.rows).toByteArray\\n  for row in reached.rows do\\n    let node := RootReach.node row\\n    let before ← NodeMembership.read intern.writer.get node\\n    NodeMembership.write intern.writer node (before.add (RootReach.semantic row))\\n    if RootReach.semantic row && before.semantic == 0 then\\n      putNat intern.writer \\\"semanticPopulation\\\" ((← getNat intern.writer.get \\\"semanticPopulation\\\") + 1)\\n  let owners := \\\"owner:\\\" ++ toString (hash value)\\n  let ownerIds ← getIds intern.writer.get owners\\n  unless ownerIds.contains id do putIds intern.writer owners (ownerIds ++ [id])\\n  let terms := ownerTerms value\\n  let mut termIds := []\\n  for unit in terms do\\n    let term ← intern.term unit\\n    termIds := term :: termIds\\n    let name := key \\\"frequency\\\" term\\n    putNat intern.writer name ((← getNat intern.writer.get name) + 1)\\n    putNat intern.writer (key (key \\\"posting\\\" term) ordinal) id\\n  putChunks intern.writer \\\"ownerTerms\\\" id\\n    ((Wire.list Wire.natural).encode termIds.reverse).toByteArray\\n  if let some owner := OutcomeEdge.fromValue? value then\\n    putNat intern.writer \\\"liveOutcomes\\\" ((← getNat intern.writer.get \\\"liveOutcomes\\\") + 1)\\n    if (text? owner.work).isSome then\\n      let some header := OutcomeHeader.fromFrame?\\n          (← readFrame (← intern.writer.snapshot) intern.writer.get id) |\\n        throw (IO.userError \\\"Work index producer disagrees with its original Outcome frame\\\")\\n      (WorkOwnerPosting.fromHeader ordinal header).write intern.writer\\n      putNat intern.writer \\\"indexedSearchWorks\\\"\\n        ((← getNat intern.writer.get \\\"indexedSearchWorks\\\") + 1)\\n      let surfaces ← (ownerWorkSurfaces owner).mapM intern.term\\n      putChunks intern.writer \\\"workSurfaces\\\" id\\n        ((Wire.list Wire.natural).encode surfaces).toByteArray\\n      for surface in surfaces do\\n        putNat intern.writer (key (key \\\"workSurface\\\" surface) ordinal) id\\n      putNat intern.writer \\\"indexedWorks\\\" ((← getNat intern.writer.get \\\"indexedWorks\\\") + 1)\\n      putNat intern.writer \\\"candidates\\\" ((← getNat intern.writer.get \\\"candidates\\\") + 1)\\n      putNat intern.writer (key \\\"candidate\\\" id) 1\\n      putNat intern.writer (key \\\"searchCandidate\\\" ordinal) id\\n      putChunks intern.writer \\\"searchWindows\\\" id\\n        (windowCodec.encode (searchWindows owner)).toByteArray\\n      let source := (searchText owner).toUTF8\\n      let shape := ((text? owner.work |>.getD \\\"\\\").utf8ByteSize,\\n        (text? owner.outcome).map String.utf8ByteSize)\\n      intern.writer.put (key \\\"searchBody\\\" id) (some (searchBodyCodec.encode shape).toByteArray)\\n      for ((offset, text), window) in (SearchRank.locatedWindows (searchText owner)).zipIdx do\\n        let some checked := SourceWindow.make? source offset text |\\n          throw (IO.userError \\\"window compiler disagrees with original source bytes\\\")\\n        intern.writer.put (key (key \\\"searchSpan\\\" id) window)\\n          (some (spanCodec.encode (checked.range.start, checked.range.stop)).toByteArray)\\n      let lexical ← (SearchRank.terms (searchText owner)).mapM intern.term\\n      putChunks intern.writer \\\"searchTerms\\\" id\\n        ((Wire.list Wire.natural).encode lexical).toByteArray\\n      for term in lexical do\\n        putNat intern.writer (key \\\"searchFrequency\\\" term)\\n          ((← getNat intern.writer.get (key \\\"searchFrequency\\\" term)) + 1)\\n        putNat intern.writer (key (key \\\"searchPosting\\\" term) ordinal) id\\n    let count ← getNat intern.writer.get \\\"outcomes\\\"\\n    putNat intern.writer (key \\\"outcome\\\" count) id\\n    putNat intern.writer (key \\\"outcomeOrdinal\\\" id) count\\n    putNat intern.writer \\\"outcomes\\\" (count + 1)\\n  if (AllEdge.fromValue? value).isSome then\\n    let count ← getNat intern.writer.get \\\"alls\\\"\\n    let some header := AllHeader.fromFrame?\\n        (← readFrame (← intern.writer.snapshot) intern.writer.get id) |\\n      throw (IO.userError \\\"All producer disagrees with its interned reference frame\\\")\\n    header.writeIndex count intern.writer\\n    putNat intern.writer \\\"indexedAllReferences\\\"\\n      ((← getNat intern.writer.get \\\"indexedAllReferences\\\") + 1)\\n    putNat intern.writer (key \\\"all\\\" count) id\\n    putNat intern.writer (key \\\"allOrdinal\\\" id) count\\n    putNat intern.writer \\\"alls\\\" (count + 1)\\n  if let .apply .receipt references := value then\\n    if let some fields := SourceEvidence.receiptFields? references.toList then\\n      if fields.marker == .text SourceEvidence.receiptMarker &&\\n          fields.purpose == .text SourceEvidence.receiptPurpose &&\\n          (OutcomeEdge.fromValue? fields.owner).isSome then\\n        let owner ← intern.value fields.owner\\n        putNat intern.writer (key \\\"sourceOwner\\\" id) owner\\n        putNat intern.writer (key (key \\\"sourceReceipt\\\" owner) id) id\\n  pure id\\n\\n/-- Retractions use the owner's reverse term index. Old bodies are immutable;\\nonly live membership, postings and exact document frequencies change. -/\\ndef removeRoot (writer : Writer) (id : Nat) : IO Unit := do\\n  if (← writer.get (key \\\"member\\\" id)).isNone then return\\n  let ordinal ← getNat writer.get (key \\\"member\\\" id)\\n  writer.put (key \\\"member\\\" id) none\\n  writer.put (key \\\"root\\\" ordinal) none\\n  if let some encoded ← writer.get (key \\\"sourceOwner\\\" id) then\\n    let owner ← IO.ofExcept (payloadSize (some encoded))\\n    writer.put (key (key \\\"sourceReceipt\\\" owner) id) none\\n    writer.put (key \\\"sourceOwner\\\" id) none\\n  let reached ← RootReach.read (← writer.snapshot) writer.get id\\n  for row in reached.rows do\\n    let node := RootReach.node row\\n    let before ← NodeMembership.read writer.get node\\n    let some after := before.retract? (RootReach.semantic row) |\\n      throw (IO.userError \\\"root reach membership role underflow\\\")\\n    NodeMembership.write writer node after\\n    if RootReach.semantic row && after.semantic == 0 then\\n      let population ← getNat writer.get \\\"semanticPopulation\\\"\\n      if population == 0 then throw (IO.userError \\\"semantic population underflow\\\")\\n      putNat writer \\\"semanticPopulation\\\" (population - 1)\\n  let termBytes ← readChunks (← writer.snapshot) writer.get \\\"ownerTerms\\\" id\\n  let (terms, tail) ← IO.ofExcept ((Wire.list Wire.natural).decode termBytes.toList)\\n  unless tail.isEmpty do throw (IO.userError \\\"trailing owner reverse-index bytes\\\")\\n  for term in terms do\\n    let count ← getNat writer.get (key \\\"frequency\\\" term)\\n    if count == 0 then throw (IO.userError \\\"frequency underflow during owner retraction\\\")\\n    putNat writer (key \\\"frequency\\\" term) (count - 1)\\n    writer.put (key (key \\\"posting\\\" term) ordinal) none\\n  if (← writer.get (key \\\"candidate\\\" id)).isSome then\\n    let some header := OutcomeHeader.fromFrame? (← readFrame (← writer.snapshot) writer.get id) |\\n      throw (IO.userError \\\"invalid retired Work owner frame\\\")\\n    (WorkOwnerPosting.fromHeader ordinal header).retract writer\\n    let indexed ← getNat writer.get \\\"indexedSearchWorks\\\"\\n    if indexed == 0 then throw (IO.userError \\\"Work owner index population underflow\\\")\\n    putNat writer \\\"indexedSearchWorks\\\" (indexed - 1)\\n    let lexicalBytes ← readChunks (← writer.snapshot) writer.get \\\"searchTerms\\\" id\\n    let (lexical, tail) ← IO.ofExcept ((Wire.list Wire.natural).decode lexicalBytes.toList)\\n    unless tail.isEmpty && lexical.eraseDups == lexical do\\n      throw (IO.userError \\\"invalid search term reverse directory\\\")\\n    for term in lexical do\\n      let count ← getNat writer.get (key \\\"searchFrequency\\\" term)\\n      if count == 0 then throw (IO.userError \\\"search frequency underflow\\\")\\n      putNat writer (key \\\"searchFrequency\\\" term) (count - 1)\\n      writer.put (key (key \\\"searchPosting\\\" term) ordinal) none\\n    writer.put (key \\\"searchCandidate\\\" ordinal) none\\n    let surfaceBytes ← readChunks (← writer.snapshot) writer.get \\\"workSurfaces\\\" id\\n    let (surfaces, tail) ← IO.ofExcept ((Wire.list Wire.natural).decode surfaceBytes.toList)\\n    unless tail.isEmpty do throw (IO.userError \\\"trailing Work surface reverse-index bytes\\\")\\n    for surface in surfaces do writer.put (key (key \\\"workSurface\\\" surface) ordinal) none\\n    let indexed ← getNat writer.get \\\"indexedWorks\\\"\\n    if indexed == 0 then throw (IO.userError \\\"Work surface population underflow\\\")\\n    putNat writer \\\"indexedWorks\\\" (indexed - 1)\\n    let count ← getNat writer.get \\\"candidates\\\"\\n    if count == 0 then throw (IO.userError \\\"candidate population underflow\\\")\\n    putNat writer \\\"candidates\\\" (count - 1)\\n    writer.put (key \\\"candidate\\\" id) none\\n  if (← writer.get (key \\\"outcomeOrdinal\\\" id)).isSome then\\n    let count ← getNat writer.get \\\"liveOutcomes\\\"\\n    if count == 0 then throw (IO.userError \\\"live Outcome population underflow\\\")\\n    putNat writer \\\"liveOutcomes\\\" (count - 1)\\n    let some _ := OutcomeHeader.fromFrame? (← readFrame (← writer.snapshot) writer.get id) |\\n      throw (IO.userError \\\"invalid retired Outcome header\\\")\\n    let ordinal ← getNat writer.get (key \\\"outcomeOrdinal\\\" id)\\n    writer.put (key \\\"outcome\\\" ordinal) none\\n    writer.put (key \\\"outcomeOrdinal\\\" id) none\\n  if (← writer.get (key \\\"allOrdinal\\\" id)).isSome then\\n    let ordinal ← getNat writer.get (key \\\"allOrdinal\\\" id)\\n    let parent ← IO.ofExcept (payloadSize (← writer.get (key \\\"allParentOf\\\" id)))\\n    let posting : AllParentPosting := ⟨parent, ordinal, id⟩\\n    unless (← IO.ofExcept (payloadSize (← writer.get posting.name))) == id do\\n      throw (IO.userError \\\"All retraction disagrees with its parent posting\\\")\\n    let some header := AllHeader.fromFrame? (← readFrame (← writer.snapshot) writer.get id) |\\n      throw (IO.userError \\\"invalid retired All header\\\")\\n    unless header.parent == parent do\\n      throw (IO.userError \\\"retired All header disagrees with its parent posting\\\")\\n    for child in header.children.eraseDups do\\n      let name := key (key \\\"allChild\\\" child) ordinal\\n      unless (← IO.ofExcept (payloadSize (← writer.get name))) == id do\\n        throw (IO.userError \\\"All retraction disagrees with its child posting\\\")\\n      writer.put name none\\n    writer.put posting.name none\\n    writer.put (key \\\"allParentOf\\\" id) none\\n    writer.put (key \\\"all\\\" ordinal) none\\n    writer.put (key \\\"allOrdinal\\\" id) none\\n\\nstructure MetadataChange where\\n  changed : Bool := false\\n  affected : List Nat := []\\n\\nstructure Change where\\n  added : List Nat\\n  removed : List Nat\\n  unionsChanged : Bool\\n  affected : List Nat := []\\n  deriving BEq, DecidableEq\\n\\ndef changeCodec : Wire.Codec Change :=\\n  ((Wire.list Wire.natural).product ((Wire.list Wire.natural).product\\n    ((Wire.natural.iso (fun b : Bool => if b then 1 else 0) (fun n => n != 0)\\n      (by intro b; cases b <;> rfl)).product (Wire.list Wire.natural)))).iso\\n    (fun c => (c.added, c.removed, c.unionsChanged,c.affected))\\n    (fun (added, removed, unionsChanged,affected) => ⟨added, removed, unionsChanged,affected⟩)\\n    (by intro c; cases c; rfl)\\n\\ntheorem change_codec_roundtrip (change : Change) (tail : List UInt8) :\\n    changeCodec.decode (changeCodec.encode change ++ tail) = .ok (change, tail) :=\\n  changeCodec.roundtrip change tail\\n\\nstructure Publication where\\n  parent : PageMap.Head\\n  change : Change\\n  deriving DecidableEq\\n\\ndef publicationCodec : Wire.Codec Publication :=\\n  (PageMap.headCodec.product changeCodec).iso\\n    (fun p => (p.parent, p.change)) (fun (parent, change) => ⟨parent, change⟩)\\n    (by intro p; cases p; rfl)\\n\\ntheorem publication_codec_roundtrip (publication : Publication) (tail : List UInt8) :\\n    publicationCodec.decode (publicationCodec.encode publication ++ tail) = .ok (publication, tail) :=\\n  publicationCodec.roundtrip publication tail\\n\\ndef Change.neutral (change : Change) : Bool :=\\n  change.added.isEmpty && change.removed.isEmpty && !change.unionsChanged && change.affected.isEmpty\\n\\ntheorem Change.neutral_exact (change : Change) : change.neutral = true ↔\\n    change.added = [] ∧ change.removed = [] ∧ change.unionsChanged = false ∧ change.affected = [] := by\\n  simp [neutral, Bool.and_eq_true, and_assoc]\\n\\nstructure CheckedChange (onlyDerived : Bool) where\\n  change : Change\\n  exact : change.neutral = true → onlyDerived = true\\n\\ndef Change.check? (change : Change) (onlyDerived : Bool) : Option (CheckedChange onlyDerived) :=\\n  if safe : change.neutral = true → onlyDerived = true then some ⟨change, safe⟩ else none\\n\\ntheorem Change.authoritative_neutral_rejected (change : Change)\\n    (neutral : change.neutral = true) : change.check? false = none := by\\n  simp [check?, neutral]\\n\\ntheorem CheckedChange.neutral_derived (checked : CheckedChange onlyDerived)\\n    (neutral : checked.change.neutral = true) : onlyDerived = true := checked.exact neutral\\n\\n/-- Source changes invalidate prepared nomination data; memo-only commits keep\\nthe existing source marker. This is a publication counter, not authority. -/\\ndef Change.sourceMarker (change : Change) (revision previous : Nat) : Nat :=\\n  if change.neutral then previous else revision + 1\\n\\ntheorem Change.neutral_keeps_marker (change : Change) (revision previous : Nat)\\n    (neutral : change.neutral = true) : change.sourceMarker revision previous = previous := by\\n  simp [sourceMarker, neutral]\\n\\ntheorem Change.changed_advances_marker (change : Change) (revision previous : Nat)\\n    (changed : change.neutral = false) (within : previous ≤ revision) :\\n    previous < change.sourceMarker revision previous := by\\n  simp [sourceMarker, changed]\\n  omega\\n\\ndef writeChange (writer : Writer) (change : Change) : IO Unit := do\\n  if ← writer.journalSealed.get then throw (IO.userError \\\"change journal was already sealed\\\")\\n  let some checked := change.check? (← writer.onlyDerived.get) |\\n    throw (IO.userError \\\"authoritative writes cannot publish an empty graph delta\\\")\\n  unless checked.change.neutral do\\n    putNat writer \\\"sourceChange\\\" (checked.change.sourceMarker writer.base.head.revision\\n      (← getNat writer.get \\\"sourceChange\\\"))\\n  putChunks writer \\\"change\\\" (writer.base.head.revision + 1)\\n    (publicationCodec.encode ⟨writer.base.head, checked.change⟩).toByteArray\\n  writer.journalSealed.set true\\n\\ndef readPublication (snapshot : Snapshot) (revision : Nat) : IO Publication := do\\n  if (← snapshot.get (key \\\"change\\\" revision)).isNone then\\n    throw (IO.userError \\\"published revision is missing its change record\\\")\\n  let bytes ← readChunks snapshot snapshot.get \\\"change\\\" revision\\n  let (publication, tail) ← IO.ofExcept (publicationCodec.decode bytes.toList)\\n  unless tail.isEmpty do throw (IO.userError \\\"trailing change record bytes\\\")\\n  unless (publicationCodec.encode publication).toByteArray == bytes do\\n    throw (IO.userError \\\"noncanonical change record\\\")\\n  unless publication.parent.identity == snapshot.head.identity &&\\n      publication.parent.authority == snapshot.head.authority &&\\n      publication.parent.revision + 1 == revision &&\\n      publication.parent.bytes < snapshot.head.bytes do\\n    throw (IO.userError \\\"change record does not follow its pinned publication\\\")\\n  pure publication\\n\\ndef readChange (snapshot : Snapshot) (revision : Nat) : IO Change :=\\n  (·.change) <$> readPublication snapshot revision\\n\\ndef authority (snapshot : Snapshot) : IO Value :=\\n  IO.ofExcept (Json.parse snapshot.head.authority >>= valueFromJson (snapshot.head.authority.length + 1))\\n\\ndef header (snapshot : Snapshot) : IO Graph := do\\n  pure { Graph.empty (← authority snapshot) with revision := snapshot.head.revision }\\n\\n/-- A selective published view resolves only requested owner ids. -/\\ndef owners (snapshot : Snapshot) (keys : List String) : IO Graph := do\\n  let values ← keys.mapM fun key => do\\n    let ids ← getIds snapshot.get key\\n    let live ← ids.filterM fun id => (snapshot.get (Store.key \\\"member\\\" id)).map Option.isSome\\n    match live with\\n    | [id] => do\\n        let entry ← locateOutcome snapshot id\\n        pure (← readLocatedOutcome snapshot entry).relation\\n    | [] => throw (IO.userError \\\"published owner is missing\\\")\\n    | _ => throw (IO.userError \\\"ambiguous published owner digest\\\")\\n  if valid : values.all Relation.wellFormed then\\n    let owner ← authority snapshot\\n    pure {\\n      authority := owner\\n      revision := snapshot.head.revision\\n      values := values\\n      unions := []\\n      values_wellFormed := fun value member => (List.all_eq_true.mp valid) value member }\\n  else throw (IO.userError \\\"invalid published owner\\\")\\n\\n/-- Read one numeric directory without probing every historical ordinal.\\nThe B-tree orders textual keys; numeric order is restored explicitly so a\\ndifferent page layout cannot change the Matcher's stable candidate order. -/\\ndef directory (snapshot : Snapshot) (tag : String) : IO (List (Nat × Nat)) := do\\n  let keyPrefix := tag ++ \\\":\\\"\\n  let entries ← snapshot.foldRange ⟨keyPrefix, tag ++ \\\";\\\"⟩ (fun entries row => do\\n    let some bytes := row.2 | return entries\\n    let some ordinal := (row.1.drop keyPrefix.length).toString.toNat? |\\n      throw (IO.userError \\\"invalid numeric directory key\\\")\\n    unless row.1 == key tag ordinal do\\n      throw (IO.userError \\\"noncanonical numeric directory key\\\")\\n    let (id, tail) ← IO.ofExcept (Wire.natural.decode bytes.toList)\\n    unless tail.isEmpty && (Wire.natural.encode id).toByteArray == bytes do\\n      throw (IO.userError \\\"invalid numeric directory value\\\")\\n    pure ((ordinal, id) :: entries)) []\\n  pure (entries.mergeSort fun a b => a.1 ≤ b.1)\\n\\ndef rootDirectory (snapshot : Snapshot) : IO (List (Nat × Nat)) := do\\n  let entries ← directory snapshot \\\"root\\\"\\n  let population ← getNat snapshot.get \\\"roots\\\"\\n  unless entries.all (fun entry => entry.1 < population) do\\n    throw (IO.userError \\\"root directory exceeds its published population\\\")\\n  pure entries\\n\\ndef rootsBetween (snapshot : Snapshot) (start stop : Nat) : IO (List Value) := do\\n  let known ← IO.mkRef {}\\n  let entries ← rootDirectory snapshot\\n  let mut values := []\\n  for (ordinal, id) in entries do\\n    if start ≤ ordinal && ordinal < stop then\\n      values := (← resolve snapshot snapshot.get known id) :: values\\n  pure values.reverse\\n\\ndef rootIds (snapshot : Snapshot) : IO (List Nat) :=\\n  (List.map Prod.snd) <$> rootDirectory snapshot\\n\\n/-- Demand reads use the persisted spelling-checked term dictionary and\\ncounter, never decode Outcome bodies to rediscover document frequency. -/\\ndef frequency (snapshot : Snapshot) (unit : String) : IO Nat := do\\n  let some term ← findTerm? snapshot snapshot.get unit | return 0\\n  getNat snapshot.get (key \\\"frequency\\\" term.id)\\n\\n/-- Read each dictionary layer in key order. Interleaving bucket, spelling and\\ncounter point reads for thousands of requested units thrashes a small page\\ncache even on a small corpus. These are the same checked point reads, from one\\npinned root, including absent buckets; no dictionary-wide scan is performed. -/\\ndef frequencies (snapshot : Snapshot) (units : List String) : IO (Std.HashMap String Nat) := do\\n  let units := hashDistinct units\\n  let mut buckets : Std.HashMap String (List Nat) := {}\\n  for bucket in (hashDistinct (units.map termBucket)).mergeSort (· ≤ ·) do\\n    buckets := buckets.insert bucket (← getIds snapshot.get bucket)\\n  let ids := hashDistinct (units.flatMap (fun unit => buckets.getD (termBucket unit) []))\\n  let mut spellings : Std.HashMap Nat String := {}\\n  for id in ids.mergeSort (fun left right => key \\\"term\\\" left ≤ key \\\"term\\\" right) do\\n    spellings := spellings.insert id (← readTerm snapshot snapshot.get id)\\n  let mut requested : List (String × Nat) := []\\n  let mut result : Std.HashMap String Nat := {}\\n  for unit in units do\\n    result := result.insert unit 0\\n    for id in buckets.getD (termBucket unit) [] do\\n      let some spelling := spellings[id]? | throw (IO.userError \\\"incomplete demanded term dictionary\\\")\\n      if let some term := term? id spelling unit then\\n        requested := (unit, term.id) :: requested\\n        break\\n  for (unit, id) in requested.mergeSort (fun left right =>\\n      key \\\"frequency\\\" left.2 ≤ key \\\"frequency\\\" right.2) do\\n    result := result.insert unit (← getNat snapshot.get (key \\\"frequency\\\" id))\\n  pure result\\n\\n/-- A term posting directory yields existing owner ids in root order. Missing\\nterms are a real index miss, not a scan through every root/body. -/\\ndef postings (snapshot : Snapshot) (unit : String) : IO (List Nat) := do\\n  let some term ← findTerm? snapshot snapshot.get unit | return []\\n  (List.map Prod.snd) <$> directory snapshot (key \\\"posting\\\" term.id)\\n\\nstructure SearchDocument where\\n  owner : Nat\\n  work : Nat\\n  windows : List String\\n  /-- Numerical hints for this pinned DB; unpublished documents use scratch. -/\\n  cache : Option DB.Sidecar.Owner := none\\n\\n/-- Repair an optional numerical hint by fetching its original bounded byte\\nrange from the requesting snapshot. No current head is reopened, and no\\nwhole Outcome body is decoded. Digest checks do not establish graph facts. -/\\ndef readSearchWindow (snapshot : Snapshot) (document : SearchDocument) (index : Nat) : IO String := do\\n  let some digest := document.windows[index]? | throw (IO.userError \\\"unknown source window\\\")\\n  let located ← locateOutcome snapshot document.owner\\n  unless located.header.work == document.work do throw (IO.userError \\\"foreign source window Work\\\")\\n  let workFrame ← readFrame snapshot snapshot.get document.work\\n  unless workFrame.frame == .atom do throw (IO.userError \\\"source window Work is not textual\\\")\\n  let some encoded ← snapshot.get (key \\\"searchBody\\\" document.owner) |\\n    throw (IO.userError \\\"missing source window body directory\\\")\\n  let ((workBytes, outcomeBytes), tail) ← IO.ofExcept (searchBodyCodec.decode encoded.toList)\\n  unless tail.isEmpty do throw (IO.userError \\\"invalid source window body directory\\\")\\n  let some span ← snapshot.get (key (key \\\"searchSpan\\\" document.owner) index) |\\n    throw (IO.userError \\\"missing source window position\\\")\\n  let ((start, stop), tail) ← IO.ofExcept (spanCodec.decode span.toList)\\n  unless tail.isEmpty do throw (IO.userError \\\"invalid source window position\\\")\\n  let total := workBytes + 1 + outcomeBytes.getD 0\\n  let some range := WindowRange.make? total start stop |\\n    throw (IO.userError \\\"source window exceeds original bytes or extraction budget\\\")\\n  let workStart := min range.start workBytes\\n  let workStop := min range.stop workBytes\\n  let work ← readBodyRange snapshot document.work workBytes workStart workStop\\n    (by have := range.ordered; omega) (by omega) (by have := range.bounded; omega)\\n  let separator := if range.start ≤ workBytes && workBytes < range.stop then\\n    ByteArray.mk #[10] else ByteArray.empty\\n  let mut outcome := ByteArray.empty\\n  if let some size := outcomeBytes then\\n    let frame ← readFrame snapshot snapshot.get located.header.outcome\\n    unless frame.frame == .atom do throw (IO.userError \\\"source window Outcome is not textual\\\")\\n    let base := workBytes + 1\\n    let first := min (range.start - base) size\\n    let last := min (range.stop - base) size\\n    outcome ← readBodyRange snapshot located.header.outcome size first last\\n      (by have := range.ordered; omega) (by omega) (by have := range.bounded; omega)\\n  let bytes := work ++ separator ++ outcome\\n  unless bytes.size == range.stop - range.start do throw (IO.userError \\\"source window is incomplete\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"source window splits UTF-8\\\")\\n  unless text.length ≤ 512 && windowKey text == digest do\\n    throw (IO.userError \\\"source window disagrees with its indexed locator\\\")\\n  pure text\\n\\n/-- Only immutable numeric headers and bounded search metadata are read.\\nAn incomplete live directory is pending/error, never a completed empty corpus. -/\\ndef searchDocuments (snapshot : Snapshot) : IO (List SearchDocument) := do\\n  let entries ← directory snapshot \\\"searchCandidate\\\"\\n  unless entries.length == (← getNat snapshot.get \\\"candidates\\\") do\\n    throw (IO.userError \\\"search candidate directory is incomplete\\\")\\n  entries.mapM fun (ordinal, id) => do\\n    let located ← locateOutcome snapshot id\\n    unless (← getNat snapshot.get (key \\\"member\\\" id)) == ordinal &&\\n        (← getNat snapshot.get (key \\\"candidate\\\" id)) == 1 do\\n      throw (IO.userError \\\"search document disagrees with live membership\\\")\\n    let encoded ← readChunks snapshot snapshot.get \\\"searchWindows\\\" id\\n    let (windows, tail) ← IO.ofExcept (windowCodec.decode encoded.toList)\\n    unless tail.isEmpty && !windows.isEmpty &&\\n        windows.all (fun value => value.length == 64 && value.toList.all (fun c =>\\n          ('0' ≤ c && c ≤ '9') || ('a' ≤ c && c ≤ 'f'))) do\\n      throw (IO.userError \\\"invalid search window directory\\\")\\n    pure ⟨id, located.header.work, windows, some (DB.Sidecar.Owner.ofSnapshot snapshot)⟩\\n\\n/-- No search-window directory or source body belongs to this read domain.\\nOriginal root order is restored before stable family/meaning ranking, so\\nunranked siblings retain the same order as the complete candidate oracle. -/\\ndef supportDocuments (snapshot : Snapshot) (works : List Nat) : IO (List SearchDocument) := do\\n  unless (← getNat snapshot.get \\\"indexedSearchWorks\\\") == (← getNat snapshot.get \\\"candidates\\\") do\\n    throw (IO.userError \\\"Work owner index is incomplete\\\")\\n  let mut rows : List (Nat × SearchDocument) := []\\n  for work in works.eraseDups do\\n    for (ordinal, id) in (← directory snapshot (key \\\"searchWork\\\" work)) do\\n      let located ← locateOutcome snapshot id\\n      let some checked := checkedWorkOwner? work ordinal located.header |\\n        throw (IO.userError \\\"Work owner directory points to a different original Work\\\")\\n      unless (← getNat snapshot.get (key \\\"member\\\" id)) == ordinal &&\\n          (← getNat snapshot.get (key \\\"candidate\\\" id)) == 1 &&\\n          (← getNat snapshot.get (key \\\"searchCandidate\\\" ordinal)) == id do\\n        throw (IO.userError \\\"Work owner directory disagrees with live candidate order\\\")\\n      rows := (ordinal, ⟨id, checked.header.work, [], some (DB.Sidecar.Owner.ofSnapshot snapshot)⟩) :: rows\\n  pure ((rows.mergeSort fun a b => a.1 ≤ b.1).map Prod.snd)\\n\\n/-- Source ranking reads bounded locator directories, not neighboring\\nOutcome bodies. Each document still belongs to the same pinned Work index. -/\\ndef supportWindowDocuments (snapshot : Snapshot) (works : List Value) :\\n    IO (List SearchDocument) := do\\n  let ids ← (hashDistinct works).filterMapM fun work => findNode? snapshot work\\n  (← supportDocuments snapshot ids).mapM fun document => do\\n    let encoded ← readChunks snapshot snapshot.get \\\"searchWindows\\\" document.owner\\n    let (windows, tail) ← IO.ofExcept (windowCodec.decode encoded.toList)\\n    unless tail.isEmpty && !windows.isEmpty &&\\n        windows.all (fun value => value.length == 64 && value.toList.all (fun c =>\\n          ('0' ≤ c && c ≤ '9') || ('a' ≤ c && c ≤ 'f'))) do\\n      throw (IO.userError \\\"invalid neighboring source window directory\\\")\\n    pure {document with windows}\\n\\n/-- Meaning rank orders hydration. Original family is a stable tie-break,\\nnot permission for an earlier investigation to consume another source's\\nbudget before its more relevant evidence can be considered. -/\\ndef supportRankBefore (leftRank rightRank leftFamily rightFamily : Nat) : Bool :=\\n  if leftRank == rightRank then decide (leftFamily ≤ rightFamily)\\n  else decide (leftRank < rightRank)\\n\\ntheorem source_rank_precedes_family (leftRank rightRank leftFamily rightFamily : Nat)\\n    (better : leftRank < rightRank) :\\n    supportRankBefore leftRank rightRank leftFamily rightFamily = true := by\\n  simp [supportRankBefore, Nat.ne_of_lt better, better]\\n\\ndef rankSupportDocuments (documents : List SearchDocument) (ranking : List Nat)\\n    (families : Std.HashMap Nat Nat := {}) : List SearchDocument :=\\n  let priorities : Std.HashMap Nat Nat := Std.HashMap.ofList (ranking.zipIdx)\\n  documents.mergeSort fun left right => supportRankBefore\\n    (priorities.getD left.owner ranking.length) (priorities.getD right.owner ranking.length)\\n    (families.getD left.work families.size) (families.getD right.work families.size)\\n\\ntheorem ranked_support_is_original (documents : List SearchDocument) (ranking : List Nat)\\n    (document : SearchDocument) (families : Std.HashMap Nat Nat := {}) :\\n    document ∈ rankSupportDocuments documents ranking families ↔ document ∈ documents := by\\n  simp [rankSupportDocuments]\\n\\ndef NodeReader.supportOwners (reader : NodeReader snapshot) (works : List Value)\\n    (excluded : List Value) (allowance : Nat) (ranking : List Nat := [])\\n    (priorities : List (Value × Nat) := []) : IO (List OutcomeEdge) := do\\n  let mut wanted : Std.HashSet Nat := {}\\n  let mut families : Std.HashMap Nat Nat := {}\\n  let priorityMap := Std.HashMap.ofList priorities\\n  for work in hashDistinct works do\\n    if let some id ← findNode? snapshot work then\\n      wanted := wanted.insert id\\n      families := families.insert id (priorityMap.getD work priorities.length)\\n  let documents := rankSupportDocuments (← supportDocuments snapshot wanted.toList) ranking families\\n  let mut remaining := allowance\\n  let mut owners := []\\n  for document in documents do\\n    unless wanted.contains document.work do continue\\n    let some encoded ← snapshot.get (key \\\"searchBody\\\" document.owner) |\\n      throw (IO.userError \\\"missing neighboring Outcome size directory\\\")\\n    let ((workBytes, outcomeBytes), tail) ← IO.ofExcept (searchBodyCodec.decode encoded.toList)\\n    unless tail.isEmpty do throw (IO.userError \\\"invalid neighboring Outcome size directory\\\")\\n    let some outcomeBytes := outcomeBytes | continue\\n    let size := workBytes + outcomeBytes\\n    if size > remaining then continue\\n    let owner ← reader.outcome (← reader.locateOutcome document.owner)\\n    unless owner.work ∈ works do throw (IO.userError \\\"neighbor Work identity disagrees with its source node\\\")\\n    let some work := text? owner.work | throw (IO.userError \\\"neighbor Work is not indexed text\\\")\\n    let some body := text? owner.outcome | throw (IO.userError \\\"neighbor Outcome is not indexed text\\\")\\n    unless work.utf8ByteSize == workBytes && body.utf8ByteSize == outcomeBytes do\\n      throw (IO.userError \\\"neighbor body disagrees with its pre-hydration size\\\")\\n    unless excluded.contains owner.relation do\\n      remaining := remaining - size\\n      owners := owners ++ [owner]\\n  pure owners\\n\\ndef searchPosting (snapshot : Snapshot) (unit : String) : IO (List Nat × Nat) := do\\n  let some term ← findTerm? snapshot snapshot.get unit | return ([], 0)\\n  let entries ← directory snapshot (key \\\"searchPosting\\\" term.id)\\n  let count ← getNat snapshot.get (key \\\"searchFrequency\\\" term.id)\\n  unless entries.length == count do throw (IO.userError \\\"search posting frequency disagrees\\\")\\n  for (ordinal, id) in entries do\\n    unless (← IO.ofExcept (payloadSize (← snapshot.get (key \\\"searchCandidate\\\" ordinal)))) == id do\\n      throw (IO.userError \\\"search posting names a retired candidate\\\")\\n  pure (entries.map Prod.snd, count)\\n\\n/-- Complete spelling-checked Work gram postings, in authoritative root\\norder. Neither Outcome text nor model scores are read during nomination.\\nAn incomplete index is an error, not a completed negative search. -/\\ndef workSurfaceCandidates (snapshot : Snapshot) (surfaces : List String) : IO (List Nat) := do\\n  unless (← getNat snapshot.get \\\"indexedWorks\\\") == (← getNat snapshot.get \\\"candidates\\\") do\\n    throw (IO.userError \\\"Work surface index is incomplete\\\")\\n  let mut found : Std.HashMap Nat Nat := {}\\n  for surface in surfaces do\\n    if let some term ← findTerm? snapshot snapshot.get surface then\\n      for (ordinal, id) in (← directory snapshot (key \\\"workSurface\\\" term.id)) do\\n        -- One owner can occur in many demanded gram postings. Its live\\n        -- membership is immutable in this pinned publication: validate the\\n        -- complete pair once, and reject any conflicting later nomination.\\n        if let some checked := found[ordinal]? then\\n          unless checked == id do\\n            throw (IO.userError \\\"Work postings disagree on their live root owner\\\")\\n          continue\\n        let live ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"member\\\" id)))\\n        let member ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"root\\\" ordinal)))\\n        let candidate ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"candidate\\\" id)))\\n        unless id < (← getNat snapshot.get \\\"nodes\\\") &&\\n            ordinal < (← getNat snapshot.get \\\"roots\\\") &&\\n            live == ordinal && member == id && candidate == 1 do\\n          throw (IO.userError \\\"Work posting disagrees with live root membership\\\")\\n        found := found.insert ordinal id\\n  pure ((found.toList.mergeSort fun a b => a.1 ≤ b.1).map Prod.snd)\\n\\n/-- Enumerate only published All relations, retaining their original order.\\nThe Atom-only probe may reject before hydration; the general reader resolves\\nthe same checked topology without visiting unrelated Outcome roots. -/\\nstructure LocatedAll (index : Nat) where\\n  head : PageMap.Head\\n  header : AllHeader index\\n\\ndef LocatedAll.atHead? (entry : LocatedAll index) (head : PageMap.Head) :\\n    Option { checked : LocatedAll index // checked.head = head } :=\\n  if same : entry.head = head then some ⟨entry, same⟩ else none\\n\\ntheorem LocatedAll.foreign_head_rejected (entry : LocatedAll index) (head : PageMap.Head)\\n    (different : entry.head ≠ head) : entry.atHead? head = none := by\\n  simp [atHead?, different]\\n\\n/-- Read the complete live All directory and its checked reference frames.\\nNo descendant is restored merely to order semantic search documents. -/\\ndef allHeaders (snapshot : Snapshot) : IO (List (Sigma LocatedAll)) := do\\n  let entries ← directory snapshot \\\"all\\\"\\n  let mut headers : List (Sigma LocatedAll) := []\\n  for (ordinal, id) in entries do\\n    let member ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"member\\\" id)))\\n    let root ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"root\\\" member)))\\n    let inverse ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"allOrdinal\\\" id)))\\n    unless id < (← getNat snapshot.get \\\"nodes\\\") &&\\n        member < (← getNat snapshot.get \\\"roots\\\") &&\\n        ordinal < (← getNat snapshot.get \\\"alls\\\") && root == id && inverse == ordinal do\\n      throw (IO.userError \\\"All topology disagrees with live root membership\\\")\\n    let frame ← readFrame snapshot snapshot.get id\\n    let some header := AllHeader.fromFrame? frame |\\n      throw (IO.userError \\\"invalid All topology frame\\\")\\n    headers := ⟨id, ⟨snapshot.head, header⟩⟩ :: headers\\n  pure headers.reverse\\n\\n/-- Lookup just one literal parent in the save-time relation index. Missing\\nor incomplete indexing is an error, never a completed negative result. The\\nallocation counters advance together; retiring a relation removes its exact\\nparent row without scanning children or rewriting the remaining directory. -/\\ndef literalAllParents (snapshot : Snapshot) (query : Value) : IO (List Nat) := do\\n  let population ← getNat snapshot.get \\\"alls\\\"\\n  unless (← getNat snapshot.get \\\"indexedAllReferences\\\") == population do\\n    throw (IO.userError \\\"All parent index is incomplete\\\")\\n  let some parent ← findNode? snapshot query | return []\\n  let rows ← directory snapshot (key \\\"allParent\\\" parent)\\n  let mut found := []\\n  for (ordinal, id) in rows do\\n    let member ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"member\\\" id)))\\n    let root ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"root\\\" member)))\\n    let inverse ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"allOrdinal\\\" id)))\\n    let indexed ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"all\\\" ordinal)))\\n    let actualParent ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"allParentOf\\\" id)))\\n    unless id < (← getNat snapshot.get \\\"nodes\\\") &&\\n        member < (← getNat snapshot.get \\\"roots\\\") && ordinal < population &&\\n        root == id && inverse == ordinal && indexed == id && actualParent == parent do\\n      throw (IO.userError \\\"All parent posting disagrees with its pinned live directories\\\")\\n    found := id :: found\\n  pure found.reverse\\n\\n/-- The source IO boundary has checked the live directories, the literal\\nnode binding and the original All frame. No sibling payload is hydrated. -/\\nstructure ChildObservation where\\n  requested : Value\\n  original : Value\\n  directory : String\\n  head : PageMap.Head\\n  child : Nat\\n  owner : Nat\\n  header : AllHeader owner\\n  position : child ∈ header.children\\n\\ntheorem ChildObservation.child_before (observation : ChildObservation) :\\n    observation.child < observation.owner :=\\n  observation.header.child_before observation.child observation.position\\n\\ndef ChildObservation.encode (observation : ChildObservation) : Json := Json.mkObj [\\n  (\\\"kind\\\", toJson \\\"indexed\\\"), (\\\"requested\\\", valueToJson observation.requested),\\n  (\\\"original\\\", valueToJson observation.original), (\\\"directory\\\", toJson observation.directory),\\n  (\\\"head\\\", toJson observation.head), (\\\"child\\\", toJson observation.child),\\n  (\\\"owner\\\", toJson observation.owner), (\\\"frame\\\", observation.header.checked.frame.toJson)]\\n\\n/-- Read only All reference frames in which the literal Work occupies a\\nchild position. Even a structured sibling is never hydrated by this lookup.\\nRetired references and frames from another publication are rejected. -/\\ndef literalAllChildren (snapshot : Snapshot) (query : Value)\\n    (observe : Option (ChildObservation → IO Unit) := none) : IO (List Nat) := do\\n  let population ← getNat snapshot.get \\\"alls\\\"\\n  unless (← getNat snapshot.get \\\"indexedAllReferences\\\") == population do\\n    throw (IO.userError \\\"All reference index is incomplete\\\")\\n  let some child ← findNode? snapshot query | return []\\n  let rows ← directory snapshot (key \\\"allChild\\\" child)\\n  let mut found := []\\n  for (ordinal, id) in rows do\\n    let member ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"member\\\" id)))\\n    let root ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"root\\\" member)))\\n    let inverse ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"allOrdinal\\\" id)))\\n    let indexed ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"all\\\" ordinal)))\\n    unless id < (← getNat snapshot.get \\\"nodes\\\") &&\\n        member < (← getNat snapshot.get \\\"roots\\\") && ordinal < population &&\\n        root == id && inverse == ordinal && indexed == id do\\n      throw (IO.userError \\\"All child posting disagrees with its pinned live directories\\\")\\n    let some header := AllHeader.fromFrame? (← readFrame snapshot snapshot.get id) |\\n      throw (IO.userError \\\"invalid indexed All child frame\\\")\\n    if position : child ∈ header.children then\\n      if found.isEmpty then\\n        if let some observe := observe then\\n          try observe ⟨query, query, snapshot.directory.toString, snapshot.head,\\n            child, id, header, position⟩\\n          catch error => IO.eprintln s!\\\"Eggshell could not record original All-child evidence: {error}\\\"\\n    else throw (IO.userError \\\"All child posting disagrees with its checked frame\\\")\\n    found := id :: found\\n  pure found.reverse\\n\\ndef NodeReader.readTopology (reader : NodeReader snapshot) (atomsOnly : Bool) : IO (Option (List AllEdge)) := do\\n  let headers ← allHeaders snapshot\\n  -- Decide the complete fast-lane domain before any descendant hydration.\\n  for entry in headers do\\n    if atomsOnly then\\n      for child in entry.2.header.parent :: entry.2.header.children do\\n        match (← readFrame snapshot snapshot.get child).frame with\\n        | .atom => pure ()\\n        | .apply .. => return none\\n  let mut edges := []\\n  for entry in headers do\\n    let some _ := entry.2.atHead? snapshot.head |\\n      throw (IO.userError \\\"All nomination belongs to another pinned publication\\\")\\n    let value ← reader.read entry.1\\n    let some edge := AllEdge.fromValue? value |\\n      throw (IO.userError \\\"invalid published All relation\\\")\\n    edges := edge :: edges\\n  pure (some edges.reverse)\\n\\ndef readTopology (snapshot : Snapshot) (atomsOnly : Bool) : IO (Option (List AllEdge)) := do\\n  (← NodeReader.new snapshot).readTopology atomsOnly\\n\\ndef NodeReader.atomTopology? (reader : NodeReader snapshot) : IO (Option (List AllEdge)) :=\\n  reader.readTopology true\\n\\ndef atomTopology? (snapshot : Snapshot) : IO (Option (List AllEdge)) := do\\n  (← NodeReader.new snapshot).atomTopology?\\n\\n/-- Structured Work is a topology dependency, not permission to materialize\\nevery Outcome in the DB. The general kernel consumes these original edges. -/\\ndef NodeReader.topology (reader : NodeReader snapshot) : IO (List AllEdge) := do\\n  let some edges ← reader.readTopology false |\\n    throw (IO.userError \\\"general topology read unexpectedly rejected its domain\\\")\\n  pure edges\\n\\ndef topology (snapshot : Snapshot) : IO (List AllEdge) := do\\n  (← NodeReader.new snapshot).topology\\n\\n/-- A request owns a pinned parent cache, not a second graph. Every pass\\nrevisits the demand closure under its current Union classes; new aliases can\\ntherefore expose a previously absent parent. Unrelated children stay on disk.\\nStructured equality still uses the complete reference kernel. -/\\nstructure DemandTopology (snapshot : Snapshot) where\\n  reader : NodeReader snapshot\\n  parents : IO.Ref (Std.HashMap Value (List Nat))\\n  loaded : IO.Ref (Std.HashMap Nat (Nat × AllEdge))\\n\\ndef DemandTopology.new (reader : NodeReader snapshot) : IO (DemandTopology snapshot) :=\\n  return ⟨reader, ← IO.mkRef {}, ← IO.mkRef {}⟩\\n\\ndef DemandTopology.parentIds (demand : DemandTopology snapshot) (work : Value) : IO (List Nat) := do\\n  if let some ids := (← demand.parents.get)[work]? then return ids\\n  let ids ← literalAllParents snapshot work\\n  demand.parents.modify (·.insert work ids)\\n  pure ids\\n\\ndef DemandTopology.edge (demand : DemandTopology snapshot) (id : Nat) : IO AllEdge := do\\n  if let some row := (← demand.loaded.get)[id]? then return row.2\\n  let ordinal ← IO.ofExcept (payloadSize (← snapshot.get (key \\\"allOrdinal\\\" id)))\\n  let value ← demand.reader.read id\\n  let some edge := AllEdge.fromValue? value |\\n    throw (IO.userError \\\"demanded All posting is not an original All relation\\\")\\n  demand.loaded.modify (·.insert id (ordinal, edge))\\n  pure edge\\n\\n/-- An indexed source hop must be an actual parent/child reference. The\\nchecked frame, rather than lexical matching or congruence, supplies the hop. -/\\nstructure IncidentAll (origin : Value) where\\n  edge : AllEdge\\n  touches : origin = edge.parent ∨ origin ∈ edge.children\\n\\ndef IncidentAll.check? (origin : Value) (edge : AllEdge) : Option (IncidentAll origin) :=\\n  if parent : origin = edge.parent then some ⟨edge, Or.inl parent⟩\\n  else if child : origin ∈ edge.children then some ⟨edge, Or.inr child⟩ else none\\n\\ndef IncidentAll.neighbors {origin : Value} (incident : IncidentAll origin) : List Value :=\\n  if origin = incident.edge.parent then incident.edge.children else [incident.edge.parent]\\n\\ntheorem IncidentAll.neighbor_is_original {origin : Value} (incident : IncidentAll origin) (work : Value)\\n    (present : work ∈ incident.neighbors) :\\n    (origin = incident.edge.parent ∧ work ∈ incident.edge.children) ∨\\n    (origin ∈ incident.edge.children ∧ work = incident.edge.parent) := by\\n  unfold neighbors at present\\n  split at present\\n  · exact Or.inl ⟨‹origin = incident.edge.parent›, present⟩\\n  · exact Or.inr ⟨incident.touches.resolve_left ‹origin ≠ incident.edge.parent›,\\n      List.mem_singleton.mp present⟩\\n\\ntheorem IncidentAll.disconnected_rejected (origin : Value) (edge : AllEdge)\\n    (notParent : origin ≠ edge.parent) (notChild : origin ∉ edge.children) :\\n    IncidentAll.check? origin edge = none := by\\n  simp [check?, notParent, notChild]\\n\\n/-- Traverse the saved source component from the requested entry points.\\nBoth parent/child postings and original Union endpoints extend the queue;\\neach Work is scheduled once. This is association traversal, independent of\\nsemantic equality, lexical admission and completion. Outcome bodies are\\nhydrated separately under the aggregate delivery budget. -/\\ndef DemandTopology.neighborhood (demand : DemandTopology snapshot) (edges : List UnionEdge)\\n    (requested : List Value) : IO (List AllEdge) := do\\n  let initial := hashDistinct requested\\n  let rec visit : Nat → Nat → Array Value → Std.HashSet Value → Std.HashMap Nat Unit →\\n      IO (Std.HashMap Nat Unit)\\n    | fuel, cursor, queue, scheduled, chosen => do\\n        let some work := queue[cursor]? | return chosen\\n        let remaining + 1 := fuel |\\n          throw (IO.userError \\\"source component exceeded its finite node domain\\\")\\n        let mut neighbors := edges.flatMap fun edge =>\\n          (if edge.left == work then [edge.right] else []) ++\\n          (if edge.right == work then [edge.left] else [])\\n        let mut chosen := chosen\\n        for id in (← demand.parentIds work) ++ (← literalAllChildren snapshot work) do\\n          let edge ← demand.edge id\\n          let some incident := IncidentAll.check? work edge |\\n            throw (IO.userError \\\"source posting does not reference its requested Work\\\")\\n          neighbors := incident.neighbors ++ neighbors\\n          chosen := chosen.insert id ()\\n        let mut queue := queue\\n        let mut scheduled := scheduled\\n        for neighbor in neighbors do\\n          unless scheduled.contains neighbor do\\n            scheduled := scheduled.insert neighbor\\n            queue := queue.push neighbor\\n        visit remaining (cursor + 1) queue scheduled chosen\\n  let chosen ← visit ((← getNat snapshot.get \\\"nodes\\\") + initial.length + edges.length * 2 + 1)\\n    0 initial.toArray (Std.HashSet.ofList initial) {}\\n  let loaded ← demand.loaded.get\\n  let rows ← chosen.toList.mapM fun (id, _) => do\\n    let some row := loaded[id]? | throw (IO.userError \\\"source neighborhood lost its original All\\\")\\n    pure row\\n  pure ((rows.mergeSort fun a b => a.1 ≤ b.1).map (·.2))\\n\\ndef DemandTopology.read (demand : DemandTopology snapshot) (edges : List UnionEdge)\\n    (requested : List Value) : IO (List AllEdge) := do\\n  let some classes := QuotientBuilder.AtomQuotient.prepare edges |\\n    return ← demand.reader.topology\\n  let rec visit : Nat → List Value → Std.HashMap Value Unit → Std.HashMap Nat Unit →\\n      IO (Option (Std.HashMap Nat Unit))\\n    | _, [], _, chosen => pure (some chosen)\\n    | 0, _ :: _, _, _ => throw (IO.userError \\\"All demand closure exceeded its finite node domain\\\")\\n    | fuel + 1, work :: pending, seen, chosen => do\\n        if seen.contains work then return ← visit fuel pending seen chosen\\n        let .atom bytes := work | return none\\n        let seen := seen.insert work ()\\n        let mut pending := pending\\n        let mut chosen := chosen\\n        for alias in classes.aliases bytes do\\n          for id in ← demand.parentIds alias do\\n            unless chosen.contains id do\\n              let edge ← demand.edge id\\n              chosen := chosen.insert id ()\\n              pending := hashDistinct (edge.children ++ pending) |>.filter (!seen.contains ·)\\n        visit fuel pending seen chosen\\n  let some chosen ← visit ((← getNat snapshot.get \\\"nodes\\\") + requested.length + 1)\\n      (hashDistinct requested) {} {} | return ← demand.reader.topology\\n  let loaded ← demand.loaded.get\\n  let rows ← chosen.toList.mapM fun (id, _) => do\\n    let some row := loaded[id]? | throw (IO.userError \\\"demanded All lost its original owner\\\")\\n    pure row\\n  pure ((rows.mergeSort fun a b => a.1 ≤ b.1).map (·.2))\\n\\n/-- Completion authority is global child membership, independent of which\\nparents the current demand happens to traverse. Build one certified inverse\\nquotient per pass, then read just the original child postings of its aliases.\\nThe pinned source and quotient are captured together by the returned reader;\\npositive and negative answers cannot survive into a later discovery pass. -/\\ndef DemandTopology.childLookup (_demand : DemandTopology snapshot) (view : RunView)\\n    (observe : Option (ChildObservation → IO Unit) := none) :\\n    IO (Value → IO Bool) := do\\n  let index := Quotient.AliasIndex.prepare view.quotient\\n  let known ← IO.mkRef ({} : Std.HashMap Value Bool)\\n  pure fun work => do\\n    if let some found := (← known.get)[work]? then return found\\n    let mut found := false\\n    for alias in index.aliases work do\\n      let owners ← literalAllChildren snapshot alias (observe.map fun observe observation =>\\n        observe {observation with requested := work})\\n      unless owners.isEmpty do\\n        found := true\\n        break\\n    known.modify (·.insert work found)\\n    pure found\\n\\ndef unionPairCodec : Wire.Codec (Nat × Nat) := Wire.natural.product Wire.natural\\n\\ndef decodeUnionPair (bytes : ByteArray) : IO (Nat × Nat) := do\\n  let (pair, tail) ← IO.ofExcept (unionPairCodec.decode bytes.toList)\\n  unless tail.isEmpty && (unionPairCodec.encode pair).toByteArray == bytes do\\n    throw (IO.userError \\\"noncanonical Union pair\\\")\\n  pure pair\\n\\n/-- A display digest locates a bucket, never establishes graph equality. -/\\ndef unionDisplayKey (left right : Value) : String :=\\n  let first := (valueToJson left).compress\\n  let second := (valueToJson right).compress\\n  let ordered := if first ≤ second then [first.toUTF8, second.toUTF8]\\n    else [second.toUTF8, first.toUTF8]\\n  \\\"u\\\" ++ Blake3.hex (Blake3.digest \\\"eggshell.union.ui\\\".toUTF8 ordered)\\n\\ndef unionPairKey (left right : Nat) : String :=\\n  key (key \\\"pair\\\" (min left right)) (max left right)\\n\\ntheorem union_pair_key_symmetric (left right : Nat) :\\n    unionPairKey left right = unionPairKey right left := by\\n  simp [unionPairKey, Nat.min_comm, Nat.max_comm]\\n\\n/-- Only live relation rows are read, in their original numeric order. A\\nhistory of retractions does not introduce missing ordinal point probes. -/\\ndef unionDirectory (snapshot : Snapshot) : IO (List (Nat × (Nat × Nat))) := do\\n  let population ← getNat snapshot.get \\\"unions\\\"\\n  let rows ← snapshot.foldRange ⟨\\\"union:\\\", \\\"union;\\\"⟩ (fun rows row => do\\n    let some bytes := row.2 | return rows\\n    let some ordinal := (row.1.drop 6).toString.toNat? |\\n      throw (IO.userError \\\"invalid Union directory key\\\")\\n    unless row.1 == key \\\"union\\\" ordinal && ordinal < population do\\n      throw (IO.userError \\\"Union directory exceeds its published population\\\")\\n    pure ((ordinal, ← decodeUnionPair bytes) :: rows)) []\\n  pure (rows.mergeSort fun a b => a.1 ≤ b.1)\\n\\ndef unionPairs (snapshot : Snapshot) : IO (List (Nat × Nat)) :=\\n  (List.map Prod.snd) <$> unionDirectory snapshot\\n\\n/-- The locator carries native node ids as well as the certified relation.\\nAll ids are checked against the pinned allocation and pair directory. -/\\nstructure LocatedUnion where\\n  head : PageMap.Head\\n  ordinal : Nat\\n  leftId : Nat\\n  rightId : Nat\\n  edge : UnionEdge\\n\\ndef LocatedUnion.atHead? (entry : LocatedUnion) (head : PageMap.Head) :\\n    Option { checked : LocatedUnion // checked.head = head } :=\\n  if same : entry.head = head then some ⟨entry, same⟩ else none\\n\\ntheorem LocatedUnion.foreign_head_rejected (entry : LocatedUnion) (head : PageMap.Head)\\n    (different : entry.head ≠ head) : entry.atHead? head = none := by\\n  simp [atHead?, different]\\n\\ndef locateUnion? (snapshot : Snapshot) (displayKey : String) : IO (Option LocatedUnion) := do\\n  let ordinals ← getIds snapshot.get (\\\"unionKey:\\\" ++ displayKey)\\n  let mut found := []\\n  let population ← getNat snapshot.get \\\"unions\\\"\\n  let nodePopulation ← getNat snapshot.get \\\"nodes\\\"\\n  let owner ← authority snapshot\\n  let known ← IO.mkRef {}\\n  for ordinal in ordinals do\\n    unless ordinal < population do throw (IO.userError \\\"Union locator exceeds its allocation\\\")\\n    let some bytes ← snapshot.get (key \\\"union\\\" ordinal) |\\n      throw (IO.userError \\\"Union locator points to a retired relation\\\")\\n    let (leftId, rightId) ← decodeUnionPair bytes\\n    unless leftId < nodePopulation && rightId < nodePopulation do\\n      throw (IO.userError \\\"Union locator points outside node allocation\\\")\\n    let some _ ← snapshot.get (unionPairKey leftId rightId) |\\n      throw (IO.userError \\\"Union locator is missing its pair directory\\\")\\n    unless (← getNat snapshot.get (unionPairKey leftId rightId)) == ordinal do\\n      throw (IO.userError \\\"Union locator disagrees with its pair directory\\\")\\n    let left ← resolve snapshot snapshot.get known leftId\\n    let right ← resolve snapshot snapshot.get known rightId\\n    unless unionDisplayKey left right == displayKey do\\n      throw (IO.userError \\\"Union locator disagrees with its native endpoints\\\")\\n    if safe : Value.sameExactFootprint left right then\\n      let edge : UnionEdge := ⟨left, right, .workspace owner,\\n        Value.sameExactFootprint_sound safe⟩\\n      found := ⟨snapshot.head, ordinal, leftId, rightId, edge⟩ :: found\\n    else throw (IO.userError \\\"stored Union changes Exact authority\\\")\\n  match found with\\n  | [] => pure none\\n  | [entry] => pure (some entry)\\n  | _ => throw (IO.userError \\\"ambiguous Union display key\\\")\\n\\n/-- Remove just the located relation and its two indexes. Root membership,\\nbody extents, postings and document frequencies are never rewritten. -/\\ndef removeUnion (writer : Writer) (entry : LocatedUnion) : IO Unit := do\\n  let some checked := entry.atHead? writer.base.head |\\n    throw (IO.userError \\\"Union retraction belongs to another pinned publication\\\")\\n  let entry := checked.val\\n  let pairKey := unionPairKey entry.leftId entry.rightId\\n  let some _ ← writer.get pairKey | throw (IO.userError \\\"Union was already retired\\\")\\n  unless (← getNat writer.get pairKey) == entry.ordinal do\\n    throw (IO.userError \\\"Union pair changed before retraction\\\")\\n  let some bytes ← writer.get (key \\\"union\\\" entry.ordinal) |\\n    throw (IO.userError \\\"Union pair has no relation row\\\")\\n  unless (← decodeUnionPair bytes) == (entry.leftId, entry.rightId) do\\n    throw (IO.userError \\\"Union relation changed before retraction\\\")\\n  let locator := \\\"unionKey:\\\" ++ unionDisplayKey entry.edge.left entry.edge.right\\n  let previous ← getIds writer.get locator\\n  unless previous.contains entry.ordinal do\\n    throw (IO.userError \\\"Union retraction is missing its display locator\\\")\\n  let remaining := previous.filter (· != entry.ordinal)\\n  writer.put pairKey none\\n  writer.put (key \\\"union\\\" entry.ordinal) none\\n  if remaining.isEmpty then writer.put locator none else putIds writer locator remaining\\n\\ndef NodeReader.unions (reader : NodeReader snapshot) (authority : Value) : IO (List (PersistentUnion authority)) := do\\n  unless (← Store.authority snapshot) == authority do throw (IO.userError \\\"foreign Union authority\\\")\\n  let mut unions : List (PersistentUnion authority) := []\\n  for (left, right) in (← unionPairs snapshot) do\\n    let left ← reader.read left\\n    let right ← reader.read right\\n    if same : Value.sameExactFootprint left right then\\n      unions := unions ++ [.make authority left right (Value.sameExactFootprint_sound same)]\\n    else throw (IO.userError \\\"stored Union changes Exact authority\\\")\\n  pure unions\\n\\ndef readUnions (snapshot : Snapshot) (authority : Value) : IO (List (PersistentUnion authority)) := do\\n  (← NodeReader.new snapshot).unions authority\\n\\n/-- Detect the general congruence lane from headers before resolving any\\nstructured Union endpoint. A rejected fast probe must not hydrate its large\\nOutcome descendants merely to learn that the atom index does not apply. -/\\ndef NodeReader.atomUnions? (reader : NodeReader snapshot) (authority : Value) :\\n    IO (Option (List (PersistentUnion authority))) := do\\n  for (left, right) in (← unionPairs snapshot) do\\n    for id in [left, right] do\\n      unless id < (← getNat snapshot.get \\\"nodes\\\") do\\n        throw (IO.userError \\\"Union endpoint exceeds its pinned node population\\\")\\n      match (← readFrame snapshot snapshot.get id).frame with\\n      | .atom => pure ()\\n      | .apply .. => return none\\n  some <$> reader.unions authority\\n\\ndef atomUnions? (snapshot : Snapshot) (authority : Value) :\\n    IO (Option (List (PersistentUnion authority))) := do\\n  (← NodeReader.new snapshot).atomUnions? authority\\n\\n/-- Explicit whole-graph inspection/oracle. Normal promotion/indexing uses\\nheader and selected-owner reads instead. Search replacement is separate. -/\\ndef materialize (snapshot : Snapshot) : IO Graph := do\\n  let values ← rootsBetween snapshot 0 (← getNat snapshot.get \\\"roots\\\")\\n  let authority ← authority snapshot\\n  let unions ← readUnions snapshot authority\\n  if valid : values.all Relation.wellFormed then\\n    pure {\\n      authority := authority\\n      revision := snapshot.head.revision\\n      values := values\\n      unions := unions\\n      values_wellFormed := fun value member => (List.all_eq_true.mp valid) value member }\\n  else throw (IO.userError \\\"invalid DB relation root\\\")\\n\\ndef reviseValues (previous removed added : List Value) : List Value :=\\n  previous.filter (!removed.contains ·) ++ added\\n\\ntheorem reviseValues_retired (previous removed added : List Value) (value : Value)\\n    (retired : value ∈ removed) (notAdded : value ∉ added) :\\n    value ∉ reviseValues previous removed added := by\\n  simp [reviseValues, retired, notAdded]\\n\\ntheorem reviseValues_new (previous removed added : List Value) (value : Value)\\n    (fresh : value ∈ added) : value ∈ reviseValues previous removed added := by\\n  simp [reviseValues, fresh]\\n\\n/-- Replay only publications after the previous view. The input revision is\\nchecked, and the returned view consumes exactly the pinned target revision.\\nRetractions are replayed before additions; changed equality is read separately.\\nNo unchanged root body is read by this path. -/\\ndef revise (snapshot : Snapshot) (previousHead : PageMap.Head) (previous : Graph) : IO Graph := do\\n  unless previousHead.identity == snapshot.head.identity &&\\n      previous.revision == previousHead.revision && previousHead.revision ≤ snapshot.head.revision &&\\n      previousHead.authority == snapshot.head.authority do\\n    throw (IO.userError \\\"change replay does not follow the same published DB\\\")\\n  if previousHead.revision == snapshot.head.revision && previousHead != snapshot.head then\\n    throw (IO.userError \\\"DB root changed without a new publication revision\\\")\\n  let mut values := previous.values\\n  let mut unionsChanged := false\\n  let known ← IO.mkRef {}\\n  for revision in [previousHead.revision + 1 : snapshot.head.revision + 1] do\\n    let change ← readChange snapshot revision\\n    let removed ← change.removed.mapM fun id => resolve snapshot snapshot.get known id\\n    let added ← change.added.mapM fun id => resolve snapshot snapshot.get known id\\n    values := reviseValues values removed added\\n    unionsChanged := unionsChanged || change.unionsChanged\\n  let unions ← if unionsChanged then readUnions snapshot previous.authority else pure previous.unions\\n  if valid : values.all Relation.wellFormed then\\n    pure {\\n      authority := previous.authority\\n      revision := snapshot.head.revision\\n      values := values\\n      unions := unions\\n      values_wellFormed := fun value member => (List.all_eq_true.mp valid) value member }\\n  else throw (IO.userError \\\"invalid root in a published change record\\\")\\n\\ndef addUnions (intern : Intern) (edges : List UnionEdge) : IO Unit := do\\n  for edge in edges do\\n    let left ← intern.value edge.left\\n    let right ← intern.value edge.right\\n    let name := unionPairKey left right\\n    if (← intern.writer.get name).isSome then continue\\n    let ordinal ← getNat intern.writer.get \\\"unions\\\"\\n    putNat intern.writer \\\"unions\\\" (ordinal + 1)\\n    putNat intern.writer name ordinal\\n    intern.writer.put (key \\\"union\\\" ordinal)\\n      (some (unionPairCodec.encode (left, right)).toByteArray)\\n    let locator := \\\"unionKey:\\\" ++ unionDisplayKey edge.left edge.right\\n    putIds intern.writer locator ((← getIds intern.writer.get locator) ++ [ordinal])\\n\\nend Eggshell.Persistence.Store\\n\"],[\"SearchRank.lean\",\"module\\n\\npublic import Eggshell.SearchUnicode\\npublic import Eggshell.HashDistinct\\npublic import tools.RetrievalGrams\\npublic import Eggshell.Frequency\\npublic import tools.FirstIndex\\npublic import Lean.Data.Json\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SearchRank\\n\\ndef log1p (x : Float) : Float := RetrievalResearch.log1p x\\n\\ndef asciiTerm (c : Char) : Bool := RetrievalResearch.asciiTerm c\\n\\ndef rawTerms (text : String) : List String := RetrievalResearch.tokens text\\n\\ndef terms (text : String) : List String := hashDistinct (rawTerms text)\\n\\ntheorem deduplicated_nodup [BEq α] [LawfulBEq α] (xs : List α) : xs.eraseDups.Nodup := by\\n  match xs with\\n  | [] => simp\\n  | x :: tail =>\\n    rw [List.eraseDups_cons, List.nodup_cons]\\n    constructor\\n    · simp\\n    · exact deduplicated_nodup (tail.filter fun y => !y == x)\\ntermination_by xs.length\\ndecreasing_by\\n  have := List.length_filter_le (fun y => !y == x) tail\\n  simp only [List.length_cons]\\n  omega\\n\\ntheorem terms_nodup (text : String) : (terms text).Nodup :=\\n  HashDistinct.nodup (rawTerms text)\\n\\ndef anchor (term : String) : Bool := RetrievalResearch.anchor term\\n\\ndef scoreOrder (a b : Float × Nat) : Bool :=\\n  a.1 > b.1 || (a.1 == b.1 && a.2 ≤ b.2)\\n\\ndef rankRows (query : String) (rows : List α) (contains : α → String → Bool)\\n    (frequency : String → Nat) (anchors : Bool) (population : Nat := rows.length) : List Nat :=\\n  RetrievalResearch.rankRows query rows contains frequency anchors population\\n\\ndef rankDocuments (query : String) (documents : List (List String))\\n    (frequency : String → Nat) (anchors : Bool) : List Nat :=\\n  rankRows query documents List.contains frequency anchors\\n\\n/-- The indexed reader supplies complete query-term postings and global\\ncounts. Row enumeration preserves the provider's existing stable tie-break;\\nsource text and every unrelated document term remain unread. -/\\ntheorem rankRows_map (query : String) (rows : List α) (project : α → β)\\n    (contains : β → String → Bool) (frequency : String → Nat) (anchors : Bool) :\\n    rankRows query (rows.map project) contains frequency anchors =\\n      rankRows query rows (fun row term => contains (project row) term) frequency anchors := by\\n  simp only [rankRows, RetrievalResearch.rankRows, List.length_map, List.zipIdx_map, List.filterMap_map]\\n  rfl\\n\\n/-- The oracle preserves query-term order, floating-point operations and the\\nstable index tie-break. No mathematical rearrangement of Float sums is used. -/\\ndef referenceLexical (query : String) (candidates : List String)\\n    (anchors := false) : List Nat :=\\n  let documents := candidates.map terms\\n  rankDocuments query documents (fun term => (documents.filter (·.contains term)).length) anchors\\n\\ntheorem document_count_exact (candidates : List String) (term : String) :\\n    Frequency.count (candidates.map terms) term =\\n      ((candidates.map terms).filter (·.contains term)).length := by\\n  induction candidates with\\n  | nil => rfl\\n  | cons text rest ih =>\\n      simp only [List.map_cons, Frequency.count_cons, (terms_nodup text).count, ih,\\n        List.filter_cons, List.contains_eq_mem]\\n      split <;> simp_all [Nat.add_comm]\\n\\ntheorem document_frequency_append (left right : List (List String)) (term : String) :\\n    ((left ++ right).filter (·.contains term)).length =\\n      (left.filter (·.contains term)).length + (right.filter (·.contains term)).length := by\\n  simp\\n\\n/-- Reusable document compilation and a certified signed frequency index.\\nIts candidate sequence includes deletions, corrections and order changes. -/\\nstructure Corpus (candidates : List String) where\\n  documents : List (List String)\\n  exact : documents = candidates.map terms\\n  frequencies : Frequency.Index documents\\n\\ndef Corpus.build (candidates : List String) : Corpus candidates :=\\n  let documents := candidates.map terms\\n  ⟨documents, rfl, Frequency.Index.empty.replace documents [] documents (by intro term; simp)⟩\\n\\n/-- Unchanged prefix/suffix terms are reused. Only the changed region is\\nparsed, subtracted and added; zero counts disappear from the signed map. -/\\ndef Corpus.revise {before : List String} (previous : Corpus before)\\n    (after : List String) : Corpus after :=\\n  let region := Frequency.affectedRegion before after\\n  let left := previous.documents.take region.left.length\\n  let removed := (previous.documents.drop region.left.length).take region.removed.length\\n  let right := previous.documents.drop (region.left.length + region.removed.length)\\n  have leftExact : left = region.left.map terms := by\\n    simp [left, previous.exact, region.old, List.map_append]\\n  have removedExact : removed = region.removed.map terms := by\\n    simp [removed, previous.exact, region.old, List.map_append, List.append_assoc]\\n  have rightExact : right = region.right.map terms := by\\n    simp [right, previous.exact, region.old, List.map_append, List.append_assoc,\\n      ← List.drop_drop]\\n  let added := region.added.map terms\\n  let documents := left ++ added ++ right\\n  have exact : documents = after.map terms := by\\n    simp [documents, leftExact, rightExact, added, region.current, List.map_append]\\n  let frequencies := previous.frequencies.replace documents removed added (by\\n    intro term\\n    rw [previous.exact, exact, removedExact]\\n    simp only [region.old, region.current, List.map_append, Frequency.count_append]\\n    dsimp only [added]\\n    omega)\\n  ⟨documents, exact, frequencies⟩\\n\\ndef Corpus.rank {candidates : List String} (corpus : Corpus candidates) (query : String)\\n    (anchors := false) : List Nat :=\\n  rankDocuments query corpus.documents (fun term => (corpus.frequencies.counts.getD term 0).toNat) anchors\\n\\ntheorem Corpus.rank_exact {candidates : List String} (corpus : Corpus candidates)\\n    (query : String) (anchors : Bool) : corpus.rank query anchors = referenceLexical query candidates anchors := by\\n  have frequencies : (fun term => (corpus.frequencies.counts.getD term 0).toNat) =\\n      fun term => ((candidates.map terms).filter (·.contains term)).length := by\\n    funext term\\n    rw [corpus.frequencies.exact, corpus.exact, document_count_exact]\\n    simp\\n  simp only [rank, referenceLexical, corpus.exact, frequencies]\\n\\ndef lexical (query : String) (candidates : List String) (anchors := false) : List Nat :=\\n  (Corpus.build candidates).rank query anchors\\n\\ntheorem lexical_exact (query : String) (candidates : List String) (anchors : Bool) :\\n    lexical query candidates anchors = referenceLexical query candidates anchors :=\\n  Corpus.rank_exact _ query anchors\\n\\ndef fused (rankings : List (List Nat)) : List Nat :=\\n  let ids := rankings.flatten.eraseDups\\n  let scores := ids.map fun id =>\\n    (rankings.foldl (fun score ranking =>\\n      match (ranking.zipIdx.find? (·.1 == id)) with\\n      | some (_, rank) => score + 1 / (61 + rank).toFloat\\n      | none => score) (0 : Float), id)\\n  (scores.mergeSort scoreOrder).map (·.2)\\n\\n/-- Build each first-position directory once. Floating-point additions keep\\ntheir original ranking order, including duplicated ids within a ranking. -/\\ndef fusedIndexed (rankings : List (List Nat)) : List Nat :=\\n  let directories := rankings.map fun ranking => firstTable Prod.fst ranking.zipIdx\\n  let ids := hashDistinct rankings.flatten\\n  let scores := ids.map fun id =>\\n    (directories.foldl (fun score directory =>\\n      match directory[id]? with\\n      | some (_, rank) => score + 1 / (61 + rank).toFloat\\n      | none => score) (0 : Float), id)\\n  (scores.mergeSort scoreOrder).map (·.2)\\n\\n@[csimp] theorem fused_compiled : fused = fusedIndexed := by\\n  funext rankings\\n  simp only [fused, fusedIndexed, HashDistinct.reference, List.foldl_map,\\n    firstTable_exact]\\n\\n/-- All provider output goes through this constructor. It cannot invent an\\n    index, duplicate an outcome, or exceed the selected context budget. -/\\ndef select (count limit : Nat) (anchors ranking : List Nat) : List Nat :=\\n  ((anchors ++ ranking).eraseDups.filter (· < count)).take limit\\n\\ndef selectIndexed (count limit : Nat) (anchors ranking : List Nat) : List Nat :=\\n  ((hashDistinct (anchors ++ ranking)).filter (· < count)).take limit\\n\\n@[csimp] theorem select_compiled : select = selectIndexed := by\\n  funext count limit anchors ranking\\n  simp only [select, selectIndexed, HashDistinct.reference]\\n\\ntheorem selected_no_duplicates (n k : Nat) (a r : List Nat) : (select n k a r).Nodup := by\\n  exact (List.take_sublist k _).nodup (List.filter_sublist.nodup (deduplicated_nodup (a ++ r)))\\n\\ntheorem selected_within_budget (n k : Nat) (a r : List Nat) :\\n    (select n k a r).length ≤ k := by simp [select, List.length_take, Nat.min_le_left]\\n\\ntheorem selected_is_existing (n k : Nat) (a r : List Nat) (id : Nat)\\n    (member : id ∈ select n k a r) : id < n := by\\n  have h := List.mem_of_mem_take member\\n  have filtered := List.mem_filter.mp h\\n  simpa using filtered.2\\n\\ntheorem selected_was_ranked (n k : Nat) (a r : List Nat) (id : Nat)\\n    (member : id ∈ select n k a r) : id ∈ a ∨ id ∈ r := by\\n  have h := List.mem_of_mem_take member\\n  have filtered := (List.mem_filter.mp h).1\\n  simpa using filtered\\n\\ntheorem zero_budget_is_empty (n : Nat) (a r : List Nat) : select n 0 a r = [] := rfl\\n\\ndef windowsFrom : Nat → List Char → List String\\n  | 0, _ => []\\n  | count + 1, characters => String.ofList (characters.take 512) :: windowsFrom count (characters.drop 384)\\n\\ntheorem windowsFrom_exact (count : Nat) (characters : List Char) :\\n    windowsFrom count characters = (List.range count).map (fun index =>\\n      String.ofList ((characters.drop (index * 384)).take 512)) := by\\n  induction count generalizing characters with\\n  | zero => rfl\\n  | succ count ih =>\\n      simp only [windowsFrom, List.range_succ_eq_map, List.map_cons, Nat.zero_mul,\\n        List.drop_zero, List.map_map, ih]\\n      apply congrArg (List.cons (String.ofList (characters.take 512)))\\n      apply List.map_congr_left\\n      intro index _\\n      dsimp only [Function.comp_def]\\n      rw [List.drop_drop]\\n      have offset : 384 + index * 384 = index.succ * 384 := by omega\\n      rw [offset]\\n\\ndef windows (text : String) : List String :=\\n  let characters := text.toList\\n  windowsFrom ((max 1 characters.length + 383) / 384) characters\\n\\n/-- Byte offsets advance with the consumed prefix, rather than rescanning\\nthe original text. The projection is the very same window sequence. -/\\ndef locatedWindowsFrom : Nat → Nat → List Char → List (Nat × String)\\n  | 0, _, _ => []\\n  | count + 1, offset, characters =>\\n      (offset, String.ofList (characters.take 512)) ::\\n        locatedWindowsFrom count\\n          (offset + (String.ofList (characters.take 384)).utf8ByteSize)\\n          (characters.drop 384)\\n\\ntheorem locatedWindowsFrom_exact (count offset : Nat) (characters : List Char) :\\n    (locatedWindowsFrom count offset characters).map Prod.snd = windowsFrom count characters := by\\n  induction count generalizing offset characters with\\n  | zero => rfl\\n  | succ count ih => simp only [locatedWindowsFrom, List.map_cons, windowsFrom, ih]\\n\\ndef locatedWindows (text : String) : List (Nat × String) :=\\n  locatedWindowsFrom ((max 1 text.toList.length + 383) / 384) 0 text.toList\\n\\ntheorem locatedWindows_exact (text : String) :\\n    (locatedWindows text).map Prod.snd = windows text :=\\n  locatedWindowsFrom_exact _ _ _\\n\\ntheorem windows_exact (text : String) :\\n    windows text = (List.range ((max 1 text.toList.length + 383) / 384)).map (fun index =>\\n      String.ofList ((text.toList.drop (index * 384)).take 512)) :=\\n  windowsFrom_exact _ _\\n\\nend Eggshell.SearchRank\\n\"]]]"],["Eggshell.WorkClassLookup","[\"module\\n\\npublic import Eggshell.GraphStore\\npublic import Eggshell.CongruenceSound\\n\\n@[expose] public section\\nnamespace Eggshell.WorkClassLookup\\nopen QuotientBuilder\\n\\n/-- Only the current generators determine a text Work's class. The source\\nWork catalogue is deliberately absent, including for mixed Atom/Apply edges.\\nThis is an equality query, not a similarity nomination or a completion. -/\\nstructure Prepared (persistent runLocal : List UnionEdge) where\\n  checked : CongruenceSound.Checked [] persistent runLocal\\n  aliases : Quotient.AliasIndex checked.quotient\\n\\ndef prepare? (persistent runLocal : List UnionEdge) : Option (Prepared persistent runLocal) :=\\n  (CongruenceSound.attach [] persistent runLocal (build? [] persistent runLocal) rfl).map\\n    fun checked => ⟨checked, Quotient.AliasIndex.prepare checked.quotient⟩\\n\\n/-- Stored compiled Work is textual. Structured aliases can connect text\\nmembers through congruence, but are not themselves textual Work owners. -/\\ndef Prepared.members (prepared : Prepared persistent runLocal) (query : ByteArray) : List Value :=\\n  (prepared.aliases.aliases (.atom query)).filter AtomQuotient.isAtom\\n\\ntheorem Prepared.member_iff (prepared : Prepared persistent runLocal)\\n    (query source : ByteArray) :\\n    Value.atom source ∈ prepared.members query ↔\\n      Eggshell.Equivalent (persistent ++ runLocal) (.atom query) (.atom source) := by\\n  simp only [Prepared.members, List.mem_filter, AtomQuotient.isAtom, and_true,\\n    prepared.aliases.aliases_exact]\\n  exact ⟨prepared.checked.generated _ _, fun equivalent =>\\n    CongruenceComplete.build_complete_atoms [] persistent runLocal prepared.checked.quotient\\n      prepared.checked.built query source equivalent⟩\\n\\n/-- Equality with the complete corpus-rooted oracle, not a top-K subset.\\nThe source may contain arbitrarily many unrelated Work roots. -/\\ntheorem Prepared.full_iff (prepared : Prepared persistent runLocal)\\n    (full : CongruenceSound.Checked roots persistent runLocal) (query source : ByteArray) :\\n    Value.atom source ∈ prepared.members query ↔\\n      full.quotient.toEquality.same (.atom query) (.atom source) = true := by\\n  rw [prepared.member_iff]\\n  exact ⟨fun equivalent => CongruenceComplete.build_complete_atoms roots persistent runLocal\\n      full.quotient full.built query source equivalent,\\n    full.generated _ _⟩\\n\\n/-- Specification of the existing Work-owner posting join, in original row\\norder. The executable reader below probes the selected Work buckets instead\\nof constructing this whole list. -/\\ndef Prepared.select (prepared : Prepared persistent runLocal) (query : ByteArray)\\n    (rows : List α) (work : α → Value) : List α :=\\n  rows.filter fun row => (prepared.members query).contains (work row)\\n\\ntheorem Prepared.select_full (prepared : Prepared persistent runLocal)\\n    (full : CongruenceSound.Checked roots persistent runLocal) (query : ByteArray)\\n    (rows : List α) (work : α → Value)\\n    (textual : ∀ row ∈ rows, AtomQuotient.isAtom (work row) = true) :\\n    prepared.select query rows work =\\n      rows.filter (fun row => full.quotient.toEquality.same (.atom query) (work row)) := by\\n  apply List.filter_congr\\n  intro row present\\n  have atom := textual row present\\n  cases original : work row with\\n  | apply operator arguments => simp [original, AtomQuotient.isAtom] at atom\\n  | atom bytes =>\\n      apply Bool.eq_iff_iff.mpr\\n      simpa only [original, List.contains_iff_mem] using prepared.full_iff full query bytes\\n\\n/-- This witness establishes only Work equality generated by today's edges.\\nChild membership, result grounding, freshness and extraction still decide\\nwhether any saved operation may actually be skipped. -/\\nstructure Owner (prepared : Prepared persistent runLocal) (query : ByteArray) where\\n  ordinal : Nat\\n  edge : OutcomeEdge\\n  same : prepared.checked.quotient.toEquality.same (.atom query) edge.work = true\\n\\ntheorem Owner.generated {prepared : Prepared persistent runLocal} (owner : Owner prepared query) :\\n    Eggshell.Equivalent (persistent ++ runLocal) (.atom query) owner.edge.work :=\\n  prepared.checked.generated _ _ owner.same\\n\\ntheorem Owner.preservesExact (owner : Owner prepared query) :\\n    Value.SameExactFootprint (.atom query) owner.edge.work :=\\n  prepared.checked.quotient.equality_preserves_exact owner.same\\n\\nend Eggshell.WorkClassLookup\\n\\nnamespace Eggshell.Persistence.Store\\nopen WorkClassLookup\\n\\n/-- Original live Work-owner buckets, followed by original Outcome frames.\\nThere is no source-body/window scan, candidate limit, derived owner, or saved\\nquotient here. The prepared class and pinned source are separate inputs. -/\\ndef NodeReader.classOwners (reader : NodeReader snapshot)\\n    (prepared : Prepared persistent runLocal) (query : ByteArray) :\\n    IO (List (Owner prepared query)) := do\\n  let ids ← (prepared.members query).filterMapM (findNode? snapshot)\\n  let documents ← supportDocuments snapshot ids\\n  documents.mapM fun document => do\\n    let located ← reader.locateOutcome document.owner\\n    unless located.header.work == document.work do\\n      throw (IO.userError \\\"class owner disagrees with original Work posting\\\")\\n    let edge ← reader.outcome located\\n    let work ← reader.read document.work\\n    unless edge.work == work do\\n      throw (IO.userError \\\"class owner disagrees with original Work value\\\")\\n    if same : prepared.checked.quotient.toEquality.same (.atom query) edge.work = true then\\n      return ⟨← getNat snapshot.get (key \\\"member\\\" document.owner), edge, same⟩\\n    else throw (IO.userError \\\"original Work owner is outside the demanded class\\\")\\n\\n/-- Source-local buckets also suffice for a fixed multi-DB query. Source\\nidentity remains attached; no complete cross-DB Work catalogue is built. -/\\ndef NodeReaders.classOwners (readers : NodeReaders snapshots)\\n    (prepared : Prepared persistent runLocal) (query : ByteArray) :\\n    IO (List (Fin snapshots.size × Owner prepared query)) := do\\n  let mut found := #[]\\n  for source in List.finRange snapshots.size do\\n    for owner in ← (readers.at source).classOwners prepared query do\\n      found := found.push (source, owner)\\n  return found.toList\\n\\nend Eggshell.Persistence.Store\\n\",[]]"],["Eggshell.WorkInference","[\"module\\npublic import Eggshell.GraphStore\\npublic import Eggshell.Matcher\\n\\n@[expose] public section\\nnamespace Eggshell.WorkInference\\nopen Matcher Persistence.Store\\n\\n/-- Opaque source references carry identity/provenance; they contain no invented\\nOutcome payload. Recommendation membership is an independent Boolean lane. -/\\nstructure Input (α : Type) where\\n  source : α\\n  view : WorkView\\n  retrieved : Bool\\n\\nstructure Prepared (α : Type) where\\n  source : α\\n  work : WorkAlignment\\n  retrieved : Bool\\n\\ndef prepareAlignments (input : Input α) (quotient : Quotient) (corpus : Corpus) (current : Value)\\n    (alignments : List (PatternPair × Coverage × Coverage)) : List (Prepared α) :=\\n  (alignments.filterMap fun alignment =>\\n    (input.view.prepare quotient corpus current alignment).map fun work => (work,alignment.1.retrieved)).map\\n    fun (work,retrieved) => ⟨input.source,work,retrieved⟩\\n\\ndef prepare (input : Input α) (cover : CoverageProvider) (quotient : Quotient)\\n    (corpus : Corpus) (current : Value) (pattern : Pattern) (patterns : List WorkPattern)\\n    (native : Bool) : List (Prepared α) :=\\n  prepareAlignments input quotient corpus current\\n    (input.view.alignments cover quotient corpus current pattern patterns input.retrieved native)\\n\\ndef pass (inputs : List (Input α)) (cover : CoverageProvider) (quotient : Quotient)\\n    (corpus : Corpus) (current : Value) (pattern : Pattern) (patterns : List WorkPattern)\\n    (native : Bool) : List (Prepared α) :=\\n  (inputs.filter fun input => Matcher.sharesSurface pattern input.view.pattern || input.retrieved).flatMap\\n    fun input => prepare input cover quotient corpus current pattern patterns native\\n\\n/-- The Work pass needs global weights and membership, but carries no candidate\\nOutcome payloads even inside its corpus argument. -/\\ntheorem pass_candidates_irrelevant (inputs : List (Input α)) (cover : CoverageProvider)\\n    (quotient : Quotient) (corpus : Corpus) (candidates : List Candidate) (current : Value)\\n    (pattern : Pattern) (patterns : List WorkPattern) (native : Bool) :\\n    pass inputs cover quotient {corpus with candidates := candidates} current pattern patterns native =\\n      pass inputs cover quotient corpus current pattern patterns native := rfl\\n\\ndef Prepared.propose (row : Prepared α) (quotient : Quotient) (inquiry : Value) : Option UnionEdge :=\\n  row.work.localUnion? quotient inquiry row.retrieved\\n\\n/-- A sufficient zero-effect test using the production delivery conditions,\\nnot a relevance threshold. Children are retained for result-grounded reuse. -/\\ndef Prepared.contextInert (row : Prepared α) : Bool :=\\n  !row.retrieved && !row.work.subwork && !row.work.wholeWorkIdentity &&\\n    !(row.work.priorInDemand.distinctiveAnchors > 1 || row.work.demandInPrior.distinctiveAnchors > 1)\\n\\ndef Prepared.inertWith (row : Prepared α) (quotient : Quotient) (inquiry : Value)\\n    (covered : UnionEdge → Bool) : Bool :=\\n  row.contextInert && match row.propose quotient inquiry with\\n    | none => true\\n    | some edge => covered edge\\n\\ndef Prepared.inert (row : Prepared α) (quotient : Quotient) (inquiry : Value) : Bool :=\\n  row.inertWith quotient inquiry (fun _ => false)\\n\\n/-- No possible result context can turn an inert Work comparison into delivery\\nor Union authority. This does not itself prove scheduler/quotient-domain pruning. -/\\ntheorem Prepared.inert_effects (row : Prepared α) (quotient : Quotient) (inquiry : Value)\\n    (matched : Match) (work : matched.work = row.work) (retrieved : matched.retrieved = row.retrieved)\\n    (inert : row.inert quotient inquiry = true) :\\n    matched.automatic = false ∧ Matcher.localUnion? quotient inquiry matched = none := by\\n  cases proposal : row.propose quotient inquiry with\\n  | some edge => simp [Prepared.inert,Prepared.inertWith,proposal] at inert\\n  | none =>\\n    cases nomination : row.retrieved <;> cases child : row.work.subwork <;>\\n      cases whole : row.work.wholeWorkIdentity <;>\\n      simp_all [Prepared.inert, Prepared.inertWith, Prepared.contextInert,\\n        Prepared.propose, Matcher.Match.automatic, Matcher.localUnion?, WorkEvidence.isIdentity,\\n        WorkEvidence.subwork, WorkEvidence.wholeWorkIdentity, WorkEvidence.fragmentIdentity,\\n        WorkEvidence.priorAnchors, WorkEvidence.demandAnchors, WorkEvidence.priorCoverage,\\n        WorkEvidence.demandCoverage, WorkEvidence.alignment?]\\n\\ntheorem Prepared.covered_effects (row : Prepared α) (quotient : Quotient) (inquiry : Value)\\n    (covered : UnionEdge → Bool) (matched : Match)\\n    (work : matched.work = row.work) (retrieved : matched.retrieved = row.retrieved)\\n    (inert : row.inertWith quotient inquiry covered = true) :\\n    matched.automatic = false ∧\\n      ∀ edge, Matcher.localUnion? quotient inquiry matched = some edge → covered edge = true := by\\n  have context := (Bool.and_eq_true_iff.mp inert).1\\n  have automatic : matched.automatic = false := by\\n    cases nomination : row.retrieved <;> cases child : row.work.subwork <;>\\n      cases whole : row.work.wholeWorkIdentity <;>\\n      simp_all [Prepared.contextInert, Matcher.Match.automatic, WorkEvidence.isIdentity,\\n        WorkEvidence.subwork, WorkEvidence.wholeWorkIdentity, WorkEvidence.fragmentIdentity,\\n        WorkEvidence.priorAnchors, WorkEvidence.demandAnchors, WorkEvidence.priorCoverage,\\n        WorkEvidence.demandCoverage, WorkEvidence.alignment?]\\n  refine ⟨automatic,?_⟩\\n  intro edge generated\\n  have same : row.propose quotient inquiry = some edge := by\\n    simpa only [Matcher.localUnion?, work, retrieved, Prepared.propose] using generated\\n  simpa only [Prepared.inertWith, same, Bool.and_eq_true, context, true_and] using inert\\n\\ninductive Decision where\\n  | reject\\n  | defer\\n  | hydrate (proposals : List UnionEdge)\\n\\n/-- Keep raw-admitted Work roots even if all their prepared comparisons are\\ninert. The contrast arm that makes every hit retrieved keeps its original IO. -/\\ndef decide (input : Input α) (cover : CoverageProvider) (quotient : Quotient)\\n    (corpus : Corpus) (current inquiry : Value) (pattern : Pattern) (patterns : List WorkPattern)\\n    (native : Bool) (enableLocalUnion : Bool) (covered : UnionEdge → Bool := fun _ => false) : Decision :=\\n  let raw := input.view.alignments cover quotient corpus current pattern patterns input.retrieved native\\n  if raw.isEmpty then .reject\\n  else if !enableLocalUnion then .hydrate []\\n  else\\n    let prepared := prepareAlignments input quotient corpus current raw\\n    if prepared.all (·.inertWith quotient inquiry covered) then .defer\\n    else .hydrate (prepared.filterMap (·.propose quotient inquiry))\\n\\ntheorem deferred_covered (input : Input α) (cover : CoverageProvider) (quotient : Quotient)\\n    (corpus : Corpus) (current inquiry : Value) (pattern : Pattern) (patterns : List WorkPattern)\\n    (native enableLocalUnion : Bool) (covered : UnionEdge → Bool)\\n    (deferred : decide input cover quotient corpus current inquiry pattern patterns native enableLocalUnion covered = .defer)\\n    (row : Prepared α) (present : row ∈ prepare input cover quotient corpus current pattern patterns native) :\\n    row.inertWith quotient inquiry covered = true := by\\n  unfold decide at deferred\\n  dsimp only at deferred\\n  split at deferred <;> try contradiction\\n  split at deferred <;> try contradiction\\n  split at deferred <;> try contradiction\\n  next inert => exact List.all_eq_true.mp inert row present\\n\\ntheorem deferred_inert (input : Input α) (cover : CoverageProvider) (quotient : Quotient)\\n    (corpus : Corpus) (current inquiry : Value) (pattern : Pattern) (patterns : List WorkPattern)\\n    (native enableLocalUnion : Bool)\\n    (deferred : decide input cover quotient corpus current inquiry pattern patterns native enableLocalUnion = .defer)\\n    (row : Prepared α) (present : row ∈ prepare input cover quotient corpus current pattern patterns native) :\\n    row.inert quotient inquiry = true :=\\n  deferred_covered input cover quotient corpus current inquiry pattern patterns native enableLocalUnion\\n    (fun _ => false) deferred row present\\n\\nabbrev Covered := Std.HashSet (Value × Value)\\n\\ndef Covered.has (known : Covered) (edge : UnionEdge) : Bool :=\\n  known.contains (edge.left,edge.right) || known.contains (edge.right,edge.left)\\n\\ndef Covered.add (known : Covered) (proposals : List UnionEdge) : Covered :=\\n  proposals.foldl (fun set edge => set.insert (edge.left,edge.right)) known\\n\\ndef unions (rows : List (Prepared α)) (quotient : Quotient) (inquiry : Value) : List UnionEdge :=\\n  Matcher.distinctLocalUnions (rows.filterMap (fun row => row.propose quotient inquiry))\\n\\ntheorem Prepared.retrieved_never_proposes (row : Prepared α) (quotient : Quotient)\\n    (inquiry : Value) (retrieved : row.retrieved = true) :\\n    row.propose quotient inquiry = none := by\\n  simp [propose, WorkAlignment.localUnion?, retrieved]\\n\\ntheorem Prepared.proposed_scope (row : Prepared α) (quotient : Quotient) (inquiry : Value)\\n    (edge : UnionEdge) (created : row.propose quotient inquiry = some edge) :\\n    edge.scope = .run inquiry := by\\n  simp only [propose, WorkAlignment.localUnion?] at created\\n  split at created <;> try contradiction\\n  split at created <;> try contradiction\\n  split at created <;> try contradiction\\n  split at created <;> try contradiction\\n  next exactSafe =>\\n    have same := Option.some.inj created\\n    subst edge\\n    rfl\\n\\ndef ofCandidate (source : α) (candidate : Candidate) (semantic : SemanticNominations) : Input α :=\\n  ⟨source,candidate.workView,Matcher.externallyNominated semantic.related candidate⟩\\n\\n/-- For the same admitted candidates and fixed quotient, every ordered proposal\\nequals the result of the actual matcher after full Outcome grounding. There is\\nno top-K premise and no dependence on result bytes or evidence text. This is a\\nsingle-pass refinement, not a theorem about the discovery scheduler's fixpoint. -/\\ntheorem complete_pass_exact (sources : List (α × Candidate)) (normalize : LogicalText.Normalizer)\\n    (cover : CoverageProvider) (view : RunView) (corpus : Corpus) (current : Value)\\n    (text : String) (native : Bool) (query : CompiledDemand normalize text native)\\n    (semantic : SemanticNominations) (evidence : Option String) (inquiry : Value) :\\n    unions (sources.flatMap fun (source,candidate) =>\\n      prepare (ofCandidate source candidate semantic) cover view.quotient corpus current\\n        query.pattern query.workPatterns native) view.quotient inquiry =\\n      Matcher.newLocalUnions view inquiry (sources.flatMap fun (_,candidate) =>\\n        candidate.findMatches normalize cover view.quotient corpus current text native query evidence semantic) := by\\n  unfold unions Matcher.newLocalUnions prepare prepareAlignments ofCandidate Candidate.findMatches\\n  simp only [Candidate.preparedWorks_work_only, WorkView.preparedWorks, List.filterMap_flatMap, List.filterMap_map]\\n  rfl\\n\\ntheorem complete_admitted_pass_exact (sources : List (α × Candidate))\\n    (normalize : LogicalText.Normalizer) (cover : CoverageProvider) (view : RunView)\\n    (corpus : Corpus) (current : Value) (text : String) (native : Bool)\\n    (query : CompiledDemand normalize text native) (semantic : SemanticNominations)\\n    (evidence : Option String) (inquiry : Value) :\\n    unions (pass (sources.map fun (source,candidate) => ofCandidate source candidate semantic)\\n      cover view.quotient corpus current query.pattern query.workPatterns native) view.quotient inquiry =\\n      Matcher.newLocalUnions view inquiry\\n        (Matcher.findInUsing normalize (Matcher.demandProvider normalize text native query) cover\\n          view.quotient {corpus with candidates := sources.map Prod.snd} current text evidence semantic native) := by\\n  have demand : Matcher.demandProvider normalize text native query text native = query := by\\n    simp [Matcher.demandProvider]\\n  unfold pass unions prepare prepareAlignments ofCandidate Matcher.newLocalUnions Matcher.findInUsing\\n    Matcher.admittedCandidates Matcher.nominated Matcher.SemanticNominations.contains\\n    Candidate.findMatches\\n  rw [demand]\\n  simp only [Candidate.preparedWorks_work_only, WorkView.preparedWorks,\\n    List.filter_map, List.flatMap_map, List.filterMap_flatMap, List.filterMap_map]\\n  rfl\\n\\n/-- A reference remains scoped to the full source head. A local numeric id is\\nnever a global/federated identity or a proof that another DB has the same Work. -/\\nstructure Address where\\n  head : DB.PageMap.Head\\n  owner : Nat\\n  work : Nat\\n  outcome : Nat\\n\\n/-- Reads original live membership, Work and occurrence structure, without\\ncalling NodeReader.outcome or fabricating an Outcome edge. These are the same\\nsource readers used by production Work admission; their IO is a trust boundary. -/\\ndef load (reader : NodeReader snapshot) (owner : Nat) (retrieved : Bool := false) :\\n    IO (Input Address) := do\\n  let located ← reader.locateOutcome owner\\n  unless located.head == snapshot.head do throw (IO.userError \\\"foreign Work inference origin\\\")\\n  let origin ← reader.workOrigin located\\n  let some view := WorkView.compile LogicalText.logicalNormalizer origin.work origin.native |\\n    throw (IO.userError \\\"nontextual Work inference origin\\\")\\n  return ⟨⟨snapshot.head,owner,located.header.work,located.header.outcome⟩,view,retrieved⟩\\n\\nend Eggshell.WorkInference\\n\",[]]"],["Eggshell.Worker","[\"module\\n\\npublic import Eggshell.Handoff\\npublic import Eggshell.Warm\\npublic import Std.Sync.Mutex\\npublic import Eggshell.WorkerLifetime\\npublic import Eggshell.PublicationClient\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin.Worker\\n\\nopen Lean\\n\\nabbrev Child := IO.Process.Child { stdin := .piped, stdout := .piped, stderr := .null }\\n\\nstructure Slot where\\n  gate : Std.Mutex Unit\\n  child : Std.Mutex (Lifetime.Cell (Option Child))\\n\\ninitialize slots : Std.Mutex (Lifetime.Cell (List (String × Slot))) ← Std.Mutex.new (.open [])\\n\\ndef slotFor (session role : String) : IO Slot := slots.atomically do\\n  let key := session ++ \\\":\\\" ++ role\\n  match ← get with\\n  | .closed => pure {gate := ← Std.Mutex.new (), child := ← Std.Mutex.new .closed}\\n  | .open current =>\\n      if let some (_, slot) := current.find? (·.1 == key) then return slot\\n      let slot := { gate := ← Std.Mutex.new (), child := ← Std.Mutex.new (.open none) }\\n      set (Lifetime.Cell.open ((key, slot) :: current))\\n      pure slot\\n\\n/-- Call only for a child spawned with `setsid := true`. -/\\ndef killGroup {cfg : IO.Process.StdioConfig} (child : IO.Process.Child cfg) : IO Unit := do\\n  let killer ← IO.Process.spawn {\\n    cmd := \\\"/bin/kill\\\", args := #[\\\"-KILL\\\", \\\"--\\\", \\\"-\\\" ++ toString child.pid]\\n    stdin := .null, stdout := .null, stderr := .null }\\n  let _ ← killer.wait\\n  try child.kill catch _ => pure ()\\n\\ndef cancelSlot (slot : Slot) : IO Unit := do\\n  let idle ← slot.gate.tryAtomically (pure ())\\n  if idle.isSome then return\\n  slot.child.atomically do\\n    match Lifetime.admit (← get) with\\n    | .reuse child => killGroup child\\n    | _ => pure ()\\n\\n/-- Independent pipes permit overlapping reads without sharing a reply or\\nrequest cancellation. This is a per-manager concurrency bound, not a limit on\\nchats, users, or stored memory. Numerical model lifetime remains device-wide. -/\\ndef readLaneCount : Nat := 4\\n\\nabbrev ReadLane := Fin readLaneCount\\n\\ndef readLanes (count : Nat := readLaneCount) : List (Fin count) := List.finRange count\\n\\ndef readLaneKey (lane : Fin count) : String := \\\"search-\\\" ++ toString lane.val\\n\\nstructure ReadPool (count : Nat := readLaneCount) where\\n  pipes : Vector Slot count\\n\\ndef ReadPool.slot (pool : ReadPool count) (lane : Fin count) : Slot :=\\n  pool.pipes[lane]\\n\\ndef readPoolFor (session : String) : IO ReadPool := do\\n  let pipes ← (Vector.ofFn (fun lane : ReadLane => lane)).mapM fun lane =>\\n    slotFor session (readLaneKey lane)\\n  pure {pipes}\\n\\ndef cancel (session role : String) : IO Unit := do\\n  if role == \\\"search\\\" then\\n    let pool ← readPoolFor session\\n    for lane in readLanes readLaneCount do cancelSlot (pool.slot lane)\\n  else cancelSlot (← slotFor session role)\\n\\ndef retire (slot : Slot) (child : Child) : IO Unit := do\\n  let owned ← slot.child.atomically do\\n    let (state, owned) := Lifetime.release (fun current => current.pid == child.pid) (← get)\\n    set state\\n    pure owned\\n  if let some owned := owned then\\n    killGroup owned\\n    let _ ← owned.wait\\n    pure ()\\n\\npartial def awaitUntil (task : Task (Except IO.Error α)) (deadline : Nat) : IO (Option α) := do\\n  if ← IO.hasFinished task then\\n    match ← IO.wait task with\\n    | .ok value => return some value\\n    | .error error => throw error\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  IO.sleep 5\\n  awaitUntil task deadline\\n\\nstructure Search where\\n  pending : PendingTurn\\n  state : ThreadState\\n  work : String\\n  enforce : Bool\\n  evidence : Option String := none\\n  staged : Bool := false\\n  deadline : Nat := 0\\n  route : SearchRoute := .configured\\n  receipt : Option String := none\\n  deriving ToJson, FromJson\\n\\n/-- Every search frame belongs to one native invocation, including its original\\ndeadline. Progress changes scheduling only; it has no Handoff payload. -/\\nstructure SearchIdentity where\\n  turn : String\\n  epoch : Nat\\n  deadline : Nat\\n  receipt : Option String\\n  deriving BEq, Repr, ToJson, FromJson\\n\\ninductive SearchFrame where\\n  | ready (identity : SearchIdentity)\\n  | reply (identity : SearchIdentity) (handoff : Option Handoff)\\n  deriving ToJson, FromJson\\n\\nstructure SearchPolicy where\\n  identity : SearchIdentity\\n  finishReady : Bool := false\\n  onReady : Nat → IO Unit := fun _ => pure ()\\n\\ndef Search.identity (request : Search) : SearchIdentity :=\\n  { turn := request.pending.turnId, epoch := request.state.epoch,\\n    deadline := request.deadline, receipt := request.receipt }\\n\\ndef readyDeadline (expected actual : SearchIdentity) (finishReady : Bool)\\n    (cutoff arrived : Nat) : Nat :=\\n  min expected.deadline (if finishReady && expected == actual && arrived < cutoff then\\n    expected.deadline else cutoff)\\n\\ntheorem ready_preserves_upstream (expected actual : SearchIdentity) (finishReady : Bool)\\n    (cutoff arrived : Nat) :\\n    readyDeadline expected actual finishReady cutoff arrived ≤ expected.deadline :=\\n  Nat.min_le_left _ _\\n\\ntheorem unready_preserves_cutoff (expected actual : SearchIdentity) (cutoff arrived : Nat) :\\n    readyDeadline expected actual false cutoff arrived ≤ cutoff := by\\n  simpa [readyDeadline] using (Nat.min_le_right expected.deadline cutoff)\\n\\ntheorem late_ready_preserves_cutoff (expected actual : SearchIdentity) (finishReady : Bool)\\n    (cutoff arrived : Nat) (late : cutoff ≤ arrived) :\\n    readyDeadline expected actual finishReady cutoff arrived ≤ cutoff := by\\n  simpa [readyDeadline, Nat.not_lt.mpr late] using (Nat.min_le_right expected.deadline cutoff)\\n\\ntheorem foreign_ready_preserves_cutoff (expected actual : SearchIdentity) (finishReady : Bool)\\n    (cutoff arrived : Nat) (foreign : (expected == actual) = false) :\\n    readyDeadline expected actual finishReady cutoff arrived ≤ cutoff := by\\n  simpa [readyDeadline, foreign] using (Nat.min_le_right expected.deadline cutoff)\\n\\n/-- One optional ready frame followed by one final reply. Repeated, foreign or\\nlate progress cannot restart or extend the upstream deadline. -/\\ndef readSearchReply (input : IO.FS.Handle) (policy : SearchPolicy)\\n    (window : Std.Mutex Nat) : IO Json := do\\n  let readFrame : IO SearchFrame := do\\n    IO.ofExcept (Json.parse (← input.getLine) >>= fromJson? (α := SearchFrame))\\n  let frame ← readFrame\\n  let reply ← match frame with\\n    | .ready identity => do\\n        let arrived ← window.atomically do\\n          let cutoff ← get\\n          let arrived ← IO.monoMsNow\\n          unless identity == policy.identity && arrived < cutoff do\\n            throw (IO.userError \\\"foreign or expired search progress\\\")\\n          set (readyDeadline policy.identity identity policy.finishReady cutoff arrived)\\n          pure arrived\\n        policy.onReady arrived\\n        readFrame\\n    | other => pure other\\n  match reply with\\n  | .reply identity result =>\\n      unless identity == policy.identity do throw (IO.userError \\\"foreign search reply\\\")\\n      unless (← IO.monoMsNow) < (← window.atomically get) do\\n        throw (IO.userError \\\"expired search reply\\\")\\n      return toJson result\\n  | .ready _ => throw (IO.userError \\\"repeated search progress\\\")\\n\\npartial def awaitSearch (task : Task (Except IO.Error α)) (window : Std.Mutex Nat) : IO (Option α) := do\\n  if ← IO.hasFinished task then\\n    match ← IO.wait task with\\n    | .ok value => return some value\\n    | .error error => throw error\\n  if (← IO.monoMsNow) ≥ (← window.atomically get) then return none\\n  IO.sleep 5\\n  awaitSearch task window\\n\\n/-- Execution permission is constructed from a fresh monotonic-clock sample\\ninside the worker gate, after any contention wait. -/\\nstructure OpenWindow (deadline : Nat) where\\n  now : Nat\\n  before : now < deadline\\n\\ndef OpenWindow.check (deadline now : Nat) : Option (OpenWindow deadline) :=\\n  if before : now < deadline then some ⟨now, before⟩ else none\\n\\ntheorem expired_window_cannot_start (deadline now : Nat) (expired : deadline ≤ now) :\\n    OpenWindow.check deadline now = none := by\\n  simp [OpenWindow.check, Nat.not_lt.mpr expired]\\n\\n/-- A busy gate is a continuation, distinct from a completed empty action. -/\\ninductive GateDecision (α : Type) where\\n  | expired\\n  | retry\\n  | finished (result : Option α)\\n\\ndef gateDecision (deadline now : Nat) (probe : Option (Option α)) : GateDecision α :=\\n  if now < deadline then\\n    match probe with\\n    | none => .retry\\n    | some result => .finished result\\n  else .expired\\n\\ntheorem busy_open_gate_retries (deadline now : Nat) (before : now < deadline) :\\n    gateDecision deadline now (none : Option (Option α)) = .retry := by\\n  simp [gateDecision, before]\\n\\ntheorem completed_empty_gate_is_finished (deadline now : Nat) (before : now < deadline) :\\n    gateDecision deadline now (some none : Option (Option α)) = .finished none := by\\n  simp [gateDecision, before]\\n\\n/-- Wait in the requesting task: no extra worker, abandoned queued action, or\\nblocking mutex acquisition. Contention consumes the same deadline as execution.\\nThe second clock check prevents an expired waiter from starting a pipe request. -/\\npartial def withGateWithin (gate : Std.Mutex Unit) (deadline : Nat)\\n    (action : OpenWindow deadline → IO α) : IO (Option α) := do\\n  if ← IO.checkCanceled then return none\\n  let now ← IO.monoMsNow\\n  if now ≥ deadline then return none\\n  let probe ← gate.tryAtomically do\\n    match OpenWindow.check deadline (← IO.monoMsNow) with\\n    | none => pure none\\n    | some window => some <$> action window\\n  match gateDecision deadline now probe with\\n  | .expired => pure none\\n  | .finished result => pure result\\n  | .retry =>\\n      IO.sleep (min 5 (deadline - now)).toUInt32\\n      withGateWithin gate deadline action\\n\\n/-- The admission records exactly which pipe owns execution and a fresh clock\\nsample after acquiring that pipe's gate. An expired waiter owns no pipe. -/\\nstructure ReadAdmission (deadline : Nat) (count : Nat := readLaneCount) where\\n  lane : Fin count\\n  window : OpenWindow deadline\\n\\ntheorem read_admission_is_live (admission : ReadAdmission deadline count) :\\n    admission.window.now < deadline := admission.window.before\\n\\ntheorem read_admission_is_bounded (admission : ReadAdmission deadline count) :\\n    admission.lane.val < count := admission.lane.isLt\\n\\n/-- Probe all pipes before sleeping. A completed `none` is still a completion;\\nonly a busy gate retries. No action is left queued after the caller expires. -/\\ndef probeReadPool (pool : ReadPool count) (deadline : Nat)\\n    (action : ReadAdmission deadline count → IO α) : IO (Option (Option α)) := do\\n  for lane in readLanes count do\\n    let probe ← (pool.slot lane).gate.tryAtomically do\\n      match OpenWindow.check deadline (← IO.monoMsNow) with\\n      | none => pure none\\n      | some window => some <$> action ⟨lane, window⟩\\n    if probe.isSome then return probe\\n  pure none\\n\\npartial def withReadPoolWithin (pool : ReadPool count) (deadline : Nat)\\n    (action : ReadAdmission deadline count → IO α) : IO (Option α) := do\\n  if ← IO.checkCanceled then return none\\n  let now ← IO.monoMsNow\\n  if now ≥ deadline then return none\\n  match gateDecision deadline now (← probeReadPool pool deadline action) with\\n  | .expired => pure none\\n  | .finished result => pure result\\n  | .retry =>\\n      IO.sleep (min 5 (deadline - now)).toUInt32\\n      withReadPoolWithin pool deadline action\\n\\n/-- Search contention waits within the hook's own deadline rather than dropping\\nthe request. Saving and indexing remain separate, independently scheduled lanes.\\nPipe writes and reads use the remaining deadline after admission. -/\\ndef exchange (session role : String) (payload : Json) (deadline : Nat)\\n    (searchPolicy : Option SearchPolicy := none) : IO (Option Json) := do\\n  let searchPolicy ← if role == \\\"search\\\" then\\n      match searchPolicy with\\n      | some policy => pure (some policy)\\n      | none => do\\n          let request ← IO.ofExcept (fromJson? payload : Except String Search)\\n          pure (some {identity := request.identity})\\n    else pure none\\n  let deadline := searchPolicy.map (fun policy => min deadline policy.identity.deadline) |>.getD deadline\\n  let execute := fun (slot : Slot) (_window : OpenWindow deadline) => do\\n    let child ← slot.child.atomically do\\n      match Lifetime.admit (← get) with\\n      | .refused => pure none\\n      | .reuse child => pure (some child)\\n      | .spawn =>\\n          let child ← IO.Process.spawn {\\n            cmd := (← IO.appPath).toString, args := #[\\\"codex-worker\\\", role]\\n            stdin := .piped, stdout := .piped, stderr := .null, setsid := true }\\n          set (Lifetime.Cell.open (some child))\\n          pure (some child)\\n    let some child := child | return none\\n    try\\n      let window ← Std.Mutex.new deadline\\n      let task ← IO.asTask (do\\n        child.stdin.putStr (payload.compress ++ \\\"\\\\n\\\")\\n        child.stdin.flush\\n        match searchPolicy with\\n        | some policy => readSearchReply child.stdout policy window\\n        | none => IO.ofExcept (Json.parse (← child.stdout.getLine))) .dedicated\\n      let result ← if role == \\\"save\\\" then do\\n        match ← IO.wait task with\\n        | .ok json => pure (some json)\\n        | .error error => throw error\\n        else if searchPolicy.isSome then awaitSearch task window\\n        else awaitUntil task deadline\\n      match result with\\n      | some json => return some json\\n      | none =>\\n          retire slot child\\n          let _ ← IO.wait task\\n          return none\\n    catch error =>\\n      let closed ← slot.child.atomically do\\n        match ← get with\\n        | .closed => pure true\\n        | .open _ => pure false\\n      retire slot child\\n      -- Terminal shutdown intentionally closes these pipes. An unexpected\\n      -- EOF in an open lane remains an error and keeps its durable ticket.\\n      unless closed do IO.eprintln s!\\\"Eggshell {role} worker stopped: {error}\\\"\\n      return none\\n  let result ← if role == \\\"search\\\" then do\\n      let pool ← readPoolFor session\\n      withReadPoolWithin pool deadline fun admission =>\\n        execute (pool.slot admission.lane) admission.window\\n    else do\\n      let slot ← slotFor session role\\n      slot.gate.tryAtomically do\\n      match OpenWindow.check deadline (← IO.monoMsNow) with\\n      | none => pure none\\n      | some window => execute slot window\\n  pure (result.bind id)\\n\\n/-- A finished search is publishable only in its requesting context and before\\n    its deadline. An incomplete search can carry only a current-context notice,\\n    never an arbitrary Handoff or a completion checkpoint. -/\\ninductive SearchDelivery (stamp : RequestStamp) (turn : String) (epoch now budget : Nat) where\\n  | obsolete\\n  | incomplete (currentTurn : stamp.turn = turn) (currentEpoch : stamp.epoch = epoch)\\n  | empty (accepted : stamp.accepts turn epoch now = true)\\n  | found (accepted : stamp.accepts turn epoch now = true)\\n      (handoff : Handoff) (fits : handoff.text.length ≤ budget)\\n      (bytesFit : handoff.text.utf8ByteSize ≤ Config.nativeHandoffBytes)\\n\\ndef SearchDelivery.ofReply (stamp : RequestStamp) (turn : String) (epoch now budget : Nat)\\n    (reply : Option Json) : SearchDelivery stamp turn epoch now budget :=\\n  if currentTurn : stamp.turn = turn then\\n    if currentEpoch : stamp.epoch = epoch then\\n      if accepted : stamp.accepts turn epoch now = true then\\n        match reply with\\n        | none => .incomplete currentTurn currentEpoch\\n        | some json =>\\n            match (fromJson? json : Except String (Option Handoff)) with\\n            | .error _ => .incomplete currentTurn currentEpoch\\n            | .ok none => .empty accepted\\n            | .ok (some handoff) =>\\n                if fits : handoff.text.length ≤ budget ∧\\n                    handoff.text.utf8ByteSize ≤ Config.nativeHandoffBytes then\\n                  .found accepted handoff fits.1 fits.2\\n                else .incomplete currentTurn currentEpoch\\n      else .incomplete currentTurn currentEpoch\\n    else .obsolete\\n  else .obsolete\\n\\ndef SearchDelivery.handoff {stamp : RequestStamp} {turn : String} {epoch now budget : Nat} :\\n    SearchDelivery stamp turn epoch now budget → Option Handoff\\n  | .obsolete | .empty _ => none\\n  | .incomplete _ _ => some pendingSearch\\n  | .found _ handoff _ _ => some handoff\\n\\n/-- Oversized UTF-8 data cannot become delivered evidence even if the profile's\\ncharacter allowance is large enough. The receipt remains authority-free. -/\\ntheorem oversized_utf8_reply_is_incomplete (stamp : RequestStamp) (turn : String)\\n    (epoch now budget : Nat) (json : Json) (handoff : Handoff)\\n    (currentTurn : stamp.turn = turn) (currentEpoch : stamp.epoch = epoch)\\n    (parsed : (fromJson? json : Except String (Option Handoff)) = .ok (some handoff))\\n    (tooLarge : Config.nativeHandoffBytes < handoff.text.utf8ByteSize) :\\n    (SearchDelivery.ofReply stamp turn epoch now budget (some json)).handoff = some pendingSearch := by\\n  by_cases accepted : stamp.accepts turn epoch now = true <;>\\n    simp [SearchDelivery.ofReply, SearchDelivery.handoff, currentTurn, currentEpoch,\\n      accepted, parsed, Nat.not_le_of_gt tooLarge]\\n\\ntheorem incomplete_delivery_has_no_authority (stamp : RequestStamp) (turn : String)\\n    (epoch now budget : Nat) (currentTurn : stamp.turn = turn) (currentEpoch : stamp.epoch = epoch) :\\n    let delivery : SearchDelivery stamp turn epoch now budget := .incomplete currentTurn currentEpoch\\n    delivery.handoff = some pendingSearch ∧ pendingSearch.completed = 0 ∧\\n      pendingSearch.deliveredGraphs = [] ∧ pendingSearch.coveredFragments = [] ∧\\n      pendingSearch.blocksCurrent = false := by\\n  exact ⟨rfl, pending_search_has_no_authority⟩\\n\\ntheorem stale_search_reply_is_discarded (stamp : RequestStamp) (turn : String)\\n    (epoch now budget : Nat) (reply : Option Json) (stale : stamp.turn ≠ turn) :\\n    (SearchDelivery.ofReply stamp turn epoch now budget reply).handoff = none := by\\n  simp [SearchDelivery.ofReply, SearchDelivery.handoff, stale]\\n\\ntheorem old_context_reply_is_discarded (stamp : RequestStamp) (turn : String)\\n    (epoch now budget : Nat) (reply : Option Json) (stale : stamp.epoch ≠ epoch) :\\n    (SearchDelivery.ofReply stamp turn epoch now budget reply).handoff = none := by\\n  simp [SearchDelivery.ofReply, SearchDelivery.handoff, stale]\\n\\ntheorem expired_search_reply_is_incomplete (stamp : RequestStamp) (turn : String)\\n    (epoch now budget : Nat) (reply : Option Json)\\n    (currentTurn : stamp.turn = turn) (currentEpoch : stamp.epoch = epoch)\\n    (expired : stamp.deadline ≤ now) :\\n    (SearchDelivery.ofReply stamp turn epoch now budget reply).handoff = some pendingSearch := by\\n  simp [SearchDelivery.ofReply, SearchDelivery.handoff, currentTurn, currentEpoch,\\n    expired_request_cannot_publish stamp turn epoch now expired]\\n\\ntheorem missing_search_reply_is_incomplete (stamp : RequestStamp) (turn : String)\\n    (epoch now budget : Nat)\\n    (currentTurn : stamp.turn = turn) (currentEpoch : stamp.epoch = epoch) :\\n    (SearchDelivery.ofReply stamp turn epoch now budget none).handoff = some pendingSearch := by\\n  by_cases accepted : stamp.accepts turn epoch now = true <;>\\n    simp [SearchDelivery.ofReply, SearchDelivery.handoff, currentTurn, currentEpoch, accepted]\\n\\n/-- Seal admission before waiting for any process. Old slots and late callers\\ncan no longer create a child; each existing child has one retiring owner. -/\\ndef shutdown : IO Unit := do\\n  let owned ← slots.atomically do\\n    let (state, owned) := Lifetime.close (← get)\\n    set state\\n    pure (owned.getD [])\\n  for (_, slot) in owned do\\n    let child ← slot.child.atomically do\\n      let (state, owned) := Lifetime.close (← get)\\n      set state\\n      pure (owned.bind id)\\n    if let some child := child then\\n      killGroup child\\n      let _ ← child.wait\\n      pure ()\\n\\n/-- A waiting search must refresh acknowledged deliveries in its own live\\ncontext before rendering. The captured pre-wait state cannot admit execution. -/\\nstructure CurrentSearch (request : Search) where\\n  state : ThreadState\\n  pending : PendingTurn\\n  valid : pending.turnId = request.pending.turnId ∧ state.epoch = request.state.epoch ∧\\n    state.enabled = true ∧ pending.closed = false ∧ pending.finalMessage.isNone = true\\n\\ndef currentSearch? (request : Search) (state : ThreadState) (pending : PendingTurn) :\\n    Option (CurrentSearch request) :=\\n  if valid : pending.turnId = request.pending.turnId ∧ state.epoch = request.state.epoch ∧\\n      state.enabled = true ∧ pending.closed = false ∧ pending.finalMessage.isNone = true then\\n    some ⟨state, pending, valid⟩\\n  else none\\n\\ntheorem stale_waiter_cannot_start (request : Search) (state : ThreadState)\\n    (pending : PendingTurn) (stale : pending.turnId ≠ request.pending.turnId) :\\n    currentSearch? request state pending = none := by\\n  simp [currentSearch?, stale]\\n\\ntheorem changed_waiter_context_cannot_start (request : Search) (state : ThreadState)\\n    (pending : PendingTurn) (changed : state.epoch ≠ request.state.epoch) :\\n    currentSearch? request state pending = none := by\\n  simp [currentSearch?, changed]\\n\\ndef search (request : Search) (onSemanticReady : IO Unit := pure ()) : IO (Option Handoff) := do\\n  let files ← sessionFiles request.pending.sessionId\\n  -- Metadata is atomically published by the manager. A search may read it but\\n  -- must not quarantine or rewrite control state outside the manager's lock.\\n  let some state ← (readJson? files.state stateJsonDefaults : IO (Option ThreadState)) |\\n    throw (IO.userError \\\"search context state disappeared\\\")\\n  let some pending ← (readJson? files.pending pendingJsonDefaults : IO (Option PendingTurn)) |\\n    throw (IO.userError \\\"search turn disappeared\\\")\\n  let some current := currentSearch? request state pending | return none\\n  let configured := pendingSelection request.pending\\n  let selection := {configured with\\n    handoffBytes := some Config.nativeHandoffBytes\\n    semanticMatcher := if request.route == .lexical then none else configured.semanticMatcher}\\n  match request.pending.projection with\\n  | .none => pure none\\n  | .roots keys => manualHandoff selection request.work keys\\n  | .automatic =>\\n      let mut staged := []\\n      -- Unsaved observations remain reusable even while a writer is busy or\\n      -- the authority is temporarily unavailable. Read them before the .egg\\n      -- snapshot, so a concurrent completed commit cannot create a gap.\\n      for name in [\\\"deferred\\\", \\\"checkpoints\\\"] do\\n        let directory := files.directory / name\\n        if ← directory.pathExists then\\n          for entry in ← directory.readDir do\\n            if entry.fileName.endsWith \\\".json\\\" then\\n              try\\n                if let some base ← (readJson? entry.path pendingJsonDefaults : IO (Option PendingTurn)) then\\n                  if base.write.any request.pending.read.contains then\\n                    let pending ← loadToolReceipts files base\\n                    let values ← IO.ofExcept (stagedGraphValues pending)\\n                    staged := staged ++ values\\n              catch _ => pure ()\\n      if request.staged then\\n        let pending ← readPending? files\\n        let snapshot := pending.filter (·.turnId == request.pending.turnId)\\n        staged := staged ++ (← IO.ofExcept (stagedGraphValues (snapshot.getD request.pending)))\\n      staged := staged.eraseDups\\n      automaticHandoff selection request.work\\n        (current.state.deliveryClaims pending.turnId (← IO.monoMsNow))\\n        request.enforce request.evidence staged (!current.state.afterCompaction)\\n        request.pending.localUnion\\n        (some {\\n          workspace := System.FilePath.mk request.pending.cwd\\n          deadline := request.deadline\\n          question := request.pending.prompt\\n          targets := SourceEvidence.workTargets? (System.FilePath.mk request.pending.cwd) request.work\\n          native := request.enforce || request.evidence.isSome\\n          receipt := request.receipt\\n          onSemanticReady\\n          onDependencies := fun sources =>\\n            queueCheckpoint files {request.pending with tools := [], sources := sources, inFlight := [], finalMessage := none, closed := false} })\\n        (request.route != .lexical)\\n\\n/-- Batch compatible metadata tickets on one read snapshot. Index failure\\n    retains every ticket; indexing never republishes or locks the graph writer. -/\\ndef indexQueued (target : IndexTarget) (paths : List System.FilePath) : IO Nat := do\\n  let pinned ← target.owner.pin\\n  let (pinned,_) ← Warm.refreshSource pinned target.storage ((← IO.monoMsNow)+60000)\\n  let _ ← Synapses.CanonicalSource.Cache.refresh pinned target.storage\\n  let _ ← RetrievalResearch.Index.warm pinned target.storage\\n  let directory ← target.indexes pinned\\n  DB.Sidecar.withIndexClaim target.owner (fun _ => indexOwned pinned directory) target.storage\\nwhere\\n indexOwned (pinned : DB.PageMap.Snapshot) (directory : System.FilePath) : IO Nat := do\\n  let mut tickets : List System.FilePath := []\\n  let mut items : List SemanticMatcher.Item := []\\n  for path in paths.eraseDups do\\n    let path ← DB.PageMap.absolute path\\n    if path.parent != some directory then\\n      IO.eprintln \\\"Eggshell refused an index ticket outside its DB lane\\\"\\n      continue\\n    try\\n      if !(← path.pathExists) then continue\\n      let ticket ← (readBoundedJson path 1048576 : IO IndexTicket)\\n      unless ticket.database == pinned.head.identity &&\\n          ticket.provider == indexProviderKey target.command && ticket.authority == pinned.head.authority do\\n        throw (IO.userError \\\"index ticket belongs to another DB or provider\\\")\\n      let snapshot ← Persistence.Store.owners pinned ticket.roots\\n      let committed ← resolveIndexTicket snapshot ticket\\n      items := items ++ SemanticMatcher.outcomeWorkItems committed.outcomeRelations\\n      tickets := tickets ++ [path]\\n    catch error =>\\n      -- Retain the bytes outside the active suffix so a damaged first batch\\n      -- cannot permanently starve later valid publications.\\n      quarantine path\\n      IO.eprintln s!\\\"Eggshell quarantined an invalid index ticket: {error}\\\"\\n  if tickets.isEmpty then return 0\\n  let _receipt ← SemanticMatcher.indexWorks target.command\\n    items.eraseDups\\n    (some target.owner) target.storage\\n  for path in tickets do removeIfExists path\\n  pure tickets.length\\n\\ndef run (role : String) : IO UInt32 := do\\n  let input ← IO.getStdin\\n  let output ← IO.getStdout\\n  repeat\\n    let line ← input.getLine\\n    if line.isEmpty then break\\n    let result ← try\\n      let json ← IO.ofExcept (Json.parse line)\\n      if role == \\\"search\\\" then\\n        let request ← IO.ofExcept (fromJson? json : Except String Search)\\n        let announced ← IO.mkRef false\\n        let ready := do\\n          unless ← announced.get do\\n            announced.set true\\n            output.putStrLn (toJson (SearchFrame.ready request.identity)).compress\\n            output.flush\\n        pure (toJson (SearchFrame.reply request.identity (← search request ready)))\\n      else if role == \\\"save\\\" then\\n        let session ← IO.ofExcept (json.getObjValAs? String \\\"session\\\")\\n        let path := System.FilePath.mk (← IO.ofExcept (json.getObjValAs? String \\\"path\\\"))\\n        let files ← sessionFiles session\\n        let some base ← (readJson? path pendingJsonDefaults : IO (Option PendingTurn)) |\\n          throw (IO.userError \\\"queued turn disappeared\\\")\\n        let checkpoint := path.parent.bind (·.fileName) == some \\\"checkpoints\\\"\\n        let pending ← if checkpoint && base.finalMessage.isNone then pure base\\n          else loadToolReceipts files base\\n        let saved ← if let some target := pending.write then do\\n          if pending.finalMessage.isNone && pending.tools.isEmpty then pure none\\n          else\\n            let promotion ← if checkpoint && pending.finalMessage.isNone then\\n                promoteObservations pending (.mk target)\\n              else promote pending (.mk target)\\n            let command := pending.semanticMatcher.getD\\n              [(← IO.appPath).toString, \\\"search-provider\\\", \\\"--mode\\\", \\\"lexical\\\"]\\n            -- Lexical maintenance also survives a saving chat without an encoder.\\n            let queued ← try\\n              queueIndex target command promotion.promotion\\n              pure true\\n              catch error =>\\n                IO.eprintln s!\\\"Eggshell published source; derived preparation remains pending: {error}\\\"\\n                pure false\\n            pure (some ({publication := promotion.source, preparationQueued := queued} : NativePublication.Saved))\\n          else pure none\\n        let finished ← observeRelatedFiles files pending ((← IO.monoMsNow) + 5000)\\n        if finished && saved.all (·.publication.awaiting == 0) then removeIfExists path\\n        match saved with\\n        | some saved => pure (toJson (NativePublication.SaveReply.published saved))\\n        | none => pure (toJson NativePublication.SaveReply.noWrite)\\n      else if role == \\\"index\\\" then\\n        if (json.getObjValAs? String \\\"kind\\\").toOption == some \\\"synapses\\\" then\\n          let target ← IO.ofExcept (json.getObjVal? \\\"target\\\" >>= fromJson? (α := Synapses.Journal.Target))\\n          let pinned ← target.owner.pin\\n          let (pinned,index
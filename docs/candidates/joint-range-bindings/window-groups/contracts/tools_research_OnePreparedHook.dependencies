 before.bytes],Blake3.hashSegments_size _⟩\\n  let mut offset := 0\\n  let mut line := 1\\n  let mut pending := ByteArray.empty\\n  let mut omitted := false\\n  let mut state := initial\\n  while offset < before.bytes do\\n    if (← IO.monoMsNow) ≥ deadline then return none\\n    let count := min 4096 (before.bytes-offset)\\n    let page ← FileSystem.readPage handle offset.toUInt64 ⟨count,Nat.min_le_left _ _⟩\\n    unless page.size == count do return none\\n    root := SourceEvidence.stepRoot root page\\n    offset := offset+count\\n    for byte in page do\\n      if byte == 10 then\\n        if !omitted then\\n          if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text\\n        pending := ByteArray.empty\\n        omitted := false\\n        line := line+1\\n      else if !omitted then\\n        if pending.size < maxLine then pending := pending.push byte\\n        else pending := ByteArray.empty; omitted := true\\n  if !pending.isEmpty && !omitted then\\n    if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\\n  unless (← IO.monoMsNow) < deadline && FileSystem.stableRead before after current offset &&\\n      Blake3.hex root.val == expected.root do return none\\n  return some state\\n\\ndef finish (workspace : System.FilePath) (captured : SourceEvidence.Capture)\\n    (raw : String) (deadline : Nat) : IO Captured := do\\n  let inputs := captured.record.files.toArray\\n  let failed := fun reason => ({implementation,inputs := #[],complete := false,aliases := #[],failure := some reason} : Captured)\\n  unless captured.record.valid && captured.record.files == captured.probes.map (·.file) do\\n    return failed \\\"input-not-captured\\\"\\n  unless raw.utf8ByteSize ≤ 2*1024*1024 do return failed \\\"output-budget\\\"\\n  let rows := outputs raw\\n  let trie := Trie.prepare rows\\n  let characters := raw.toList.toArray\\n  let mut state := trie.start\\n  for fileIndex in [:inputs.size] do\\n    let some file := inputs[fileIndex]? | return failed \\\"input-domain\\\"\\n    let result ← try scan workspace file fileIndex trie state deadline catch _ => pure none\\n    let some next := result | return failed \\\"input-not-sealed\\\"\\n    state := next\\n  let aliases := rows.filterMap fun row => do\\n    let (position,chars) ← trie.selected? state row\\n    alias? inputs characters row position chars\\n  let referenced := inputs.filter fun input => aliases.any fun alias =>\\n    input.relative == alias.file.relative && input.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩\\n  return ⟨implementation,referenced,true,aliases,none⟩\\n\\ndef code? (characters : Array Char) (alias : Alias) : Option String := do\\n  let text ← Synapses.ObservedRecords.project characters alias.spelling\\n  if alias.chars == 0 || alias.chars > text.length then none else do\\n    let code := suffix text alias.chars\\n    let reconstructed ← alias? #[⟨alias.file.relative,some ⟨alias.file.bytes,alias.file.fingerprint⟩⟩]\\n      characters ⟨alias.spelling,text⟩ (0,alias.line) alias.chars\\n    if reconstructed == alias then some code else none\\n\\nend Eggshell.ContentCapture\\n\"],[\"ContentMetadata.lean\",\"module\\npublic import Eggshell.ContentCapture\\n@[expose] public section\\n\\nnamespace Eggshell.ContentMetadata\\nopen Lean DB Synapses Synapses.Extraction Persistence.Store\\n\\nstructure Header where\\n  database : String\\n  owner : String\\n  work : String\\n  original : String\\n  implementation : String\\n  inputs : Array SourceEvidence.File\\n  complete : Bool\\n  failure : Option String\\n  aliases : Nat\\n  chunks : Array String\\n  deriving ToJson, FromJson\\n\\ndef ownerKey (id : Nat) := \\\"memo:content-alias:owner:\\\" ++ toString id\\ndef chunkKey (digest : String) := \\\"memo:content-alias:chunk:\\\" ++ digest\\ndef chunkCount : Nat := 64\\n\\nstructure Line (raw : String) where\\n  alias : ContentCapture.Alias\\n  code : String\\n  original : ContentCapture.code? raw.toList.toArray alias = some code\\n  within : alias.first < alias.limit ∧ alias.limit ≤ raw.length\\n\\ndef line? (raw : String) (alias : ContentCapture.Alias) : Option (Line raw) := do\\n  if within : alias.first < alias.limit ∧ alias.limit ≤ raw.length then\\n    match original : ContentCapture.code? raw.toList.toArray alias with\\n    | some code => some ⟨alias,code,original,within⟩\\n    | none => none\\n  else none\\n\\ntheorem Line.original_projection (line : Line raw) :\\n    ContentCapture.code? raw.toList.toArray line.alias = some line.code := line.original\\n\\ntheorem Line.original_bounds (line : Line raw) :\\n    line.alias.first < line.alias.limit ∧ line.alias.limit ≤ raw.length := line.within\\n\\ndef validAlias (inputs : Array SourceEvidence.File) (characters : Array Char)\\n    (alias : ContentCapture.Alias) : Bool :=\\n  alias.file.valid && 0 < alias.line && alias.first < alias.limit && alias.limit ≤ characters.size &&\\n    (ContentCapture.code? characters alias).isSome && inputs.any (fun file =>\\n      file.relative == alias.file.relative && file.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩)\\n\\n/-- Source metadata joins original bytes and portable origins in their one\\nexisting transaction. No second writer, source reopen or derived repair. -/\\ndef stage (writer : PageMap.Writer) (id : Nat) (doc : Document)\\n    (captured : ContentCapture.Captured) : IO Bool := do\\n  unless doc.native && captured.implementation == ContentCapture.implementation do\\n    throw (IO.userError \\\"content correspondence is not from the selected native capture\\\")\\n  let some raw := doc.source | throw (IO.userError \\\"content correspondence lost its original body\\\")\\n  let characters := raw.toList.toArray\\n  unless (captured.complete || captured.aliases.isEmpty) &&\\n      captured.aliase
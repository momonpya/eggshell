α) :=\\n  values.foldr (fun value found => match spanOf value with\\n    | none => found\\n    | some span => found.insert span (value :: found[span]?.getD [])) {}\\n\\ntheorem directory_exact (spanOf : α → Option (Nat × Nat)) (values : List α)\\n    (span : Nat × Nat) :\\n    (directory spanOf values)[span]?.getD [] = values.filter (fun value => spanOf value == some span) := by\\n  induction values with\\n  | nil => simp [directory]\\n  | cons value rest ih =>\\n    cases found : spanOf value with\\n    | none => simpa [directory,found] using ih\\n    | some actual =>\\n      by_cases same : actual = span\\n      · simpa [directory,found,same] using congrArg (List.cons value) ih\\n      · simpa [directory,found,same,Std.HashMap.getElem?_insert] using ih\\n\\nstructure Index (spanOf : α → Option (Nat × Nat)) (values : List α) where\\n  postings : Std.HashMap (Nat × Nat) (List α)\\n  exact : ∀ span, postings[span]?.getD [] = values.filter (fun value => spanOf value == some span)\\n\\ndef prepare (spanOf : α → Option (Nat × Nat)) (values : List α) : Index spanOf values :=\\n  ⟨directory spanOf values,directory_exact spanOf values⟩\\n\\nvariable {α : Type u} {spanOf : α → Option (Nat × Nat)} {values : List α}\\n\\ndef Index.lookup (index : Index spanOf values) (span : Nat × Nat) : List α :=\\n  index.postings[span]?.getD []\\n\\ntheorem Index.lookup_exact (index : Index spanOf values) (span : Nat × Nat) :\\n    index.lookup span = values.filter (fun value => spanOf value == some span) := index.exact span\\n\\nend Eggshell.SpanPostings\\n\"],[\"Synapses.lean\",\"module\\n\\npublic import Std.Data.HashSet.Lemmas\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses\\nopen Lean\\n\\n/-- Recommendation evidence has no import of Value, Match or Union authority. -/\\nstructure File where\\n  relative : String\\n  fingerprint : String\\n  bytes : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef safeRelative (path : String) : Bool :=\\n  !path.isEmpty && !path.startsWith \\\"/\\\" && !path.contains '\\\\x00' &&\\n    (path.splitOn \\\"/\\\").all (fun part => !part.isEmpty && part != \\\".\\\" && part != \\\"..\\\")\\n\\ndef digest (text : String) : Bool :=\\n  text.length == 64 && text.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f'))\\n\\ndef File.valid (file : File) : Bool := safeRelative file.relative && digest file.fingerprint\\n\\n/-- Exact immutable output identity. A Work hash and its entire saved payload\\nidentify data across sessions without equating operations or their authority. -/\\nstructure Original where\\n  work : String\\n  content : String\\n  chars : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Original.valid (original : Original) : Bool :=\\n  !original.work.isEmpty && digest original.content\\n\\ninductive Subject where\\n  | file (file : File)\\n  | original (original : Original)\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ninstance : Coe File Subject := ⟨Subject.file⟩\\n\\ndef Subject.valid : Subject → Bool\\n  | .file data => data.valid\\n  | .original data => data.valid\\n\\ndef Subject.file? : Subject → Option File\\n  | .file data => some data\\n  | .original _ => none\\n\\ndef Subject.sameLocation (left right : Subject) : Bool := match left,right with\\n  | .file a,.file b => a.relative == b.relative\\n  | .original a,.original b => a.work == b.work\\n  | _,_ => false\\n\\n/-- Closed intervals over immutable subjects. File coordinates are line\\nnumbers; original-output coordinates are one-based character positions. -/\\nstructure Range where\\n  subject : Subject\\n  first : Nat\\n  last : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Range.valid (range : Range) : Bool :=\\n  range.subject.valid && 0 < range.first && range.first ≤ range.last &&\\n    match range.subject with | .file _ => true | .original original => range.last ≤ original.chars\\n\\ndef Range.file? (range : Range) : Option File := range.subject.file?\\n\\ndef Range.original (original : Original) (first limit : Nat) : Range :=\\n  ⟨.original original,first+1,limit⟩\\n\\ndef Range.contains (outer inner : Range) : Bool :=\\n  outer.subject == inner.subject && outer.first ≤ inner.first && inner.last ≤ outer.last\\n\\ntheorem Range.contains_self (range : Range) : range.contains range = true := by\\n  simp [Range.contains]\\n\\n/-- A saved part of a citation must lie in both original intervals. The\\nfingerprint is part of equality; a path match alone cannot make an overlap. -/\\ndef Range.intersection? (left right : Range) : Option Range :=\\n  let source := {left with first := max left.first right.first, last := min left.last right.last}\\n  if source.valid && left.contains source && right.contains source then some source else none\\n\\ntheorem Range.intersection_within {left right source : Range}\\n    (found : left.intersection? right = some source) :\\n    source.valid = true ∧ left.contains source = true ∧ right.contains source = true := by\\n  unfold intersection? at found\\n  dsimp only at found\\n  split at found\\n  · rename_i valid\\n    simp only [Option.some.injEq] at found\\n    subst source\\n    simpa only [Bool.and_eq_true, and_assoc] using valid\\n  · contradiction\\n\\nstructure Occurrence where\\n  session : String\\n  turn : String\\n  useId : String\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Occurrence.valid (occurrence : Occurrence) : Bool :=\\n  !occurrence.session.isEmpty && !occurrence.turn.isEmpty && !occurrence.useId.isEmpty\\n\\nstructure Binding where\\n  database : String\\n  owner : String\\n  work : String\\n  first : Nat\\n  limit : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Binding.valid (binding : Binding) : Bool :=\\n  !binding.database.isEmpty && !binding.owner.isEmpty && !binding.work.isEmpty &&\\n    binding.first < binding.limit\\n\\nstructure Read where\\n  occurrence : Occurrence\\n  source : Range\\n  binding : Binding\\n  /-- Selector keys only. Rebuild rechecks the original quoted spelling. -/\\n  quotations : Array String := #[]\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Read.valid (read : Read) : Bool :=\\n  read.occurrence.valid && read.source.valid && read.binding.valid && read.quotations.all digest &&\\n    match read.source.subject with\\n    | .file _ => true\\n    | .original original => original.work == read.binding.work &&\\n        read.source.first == read.binding.first+1 && read.source.last == read.binding.limit\\n\\ntheorem original_read_binding (read : Read) (original : Original)\\n    (kind : read.source.subject = .original original) (valid : read.valid = true) :\\n    original.work = read.binding.work ∧ read.source.first = read.binding.first+1 ∧\\n      read.source.last = read.binding.limit := by\\n  have checked := valid\\n  simp only [Read.valid,kind,Bool.and_eq_true,beq_iff_eq] at checked\\n  simpa only [and_assoc] using checked.2\\n\\nstructure Claim where\\n  database : String\\n  answer : String\\n  first : Nat\\n  limit : Nat\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Claim.valid (claim : Claim) : Bool :=\\n  !claim.database.isEmpty && !claim.answer.isEmpty && claim.first < claim.limit\\n\\nstructure Support where\\n  read : Read\\n  source : Range\\n  claim : Claim\\n  binding : Binding\\n  /-- The original citation can be wider than the part present in this read. -/\\n  cited : Range := source\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Support.valid (support : Support) : Bool :=\\n  support.read.valid && support.source.valid && support.claim.valid &&\\n    support.binding.valid && support.binding.database == support.read.binding.database &&\\n    support.binding.owner == support.read.binding.owner && support.binding.work == support.read.binding.work &&\\n    support.read.binding.first ≤ support.binding.first && support.binding.limit ≤ support.read.binding.limit &&\\n    support.cited.valid && support.cited.contains support.source &&\\n    support.read.source.contains support.source\\n\\n/-- The constructor checks the exact saved read covers the cited source range. -/\\ndef Support.checked (read : Read) (source : Range) (claim : Claim)\\n    (binding : Binding := read.binding) (cited : Range := source) : Except String Support :=\\n  let support := Support.mk read source claim binding cited\\n  if support.valid then .ok support else .error \\\"citation is not covered by its recorded read\\\"\\n\\ntheorem Support.checked_covers {read : Read} {source : Range} {claim : Claim}\\n    {binding : Binding} {cited : Range} {support : Support}\\n    (checked : Support.checked read source claim binding cited = .ok support) :\\n    read.source.contains source = true := by\\n  unfold Support.checked at checked\\n  dsimp only at checked\\n  split at checked\\n  next valid =>\\n    simp only [Support.valid, Bool.and_eq_true] at valid\\n    exact valid.2\\n  next => contradiction\\n\\ntheorem Support.checked_within_citation {read : Read} {source : Range} {claim : Claim}\\n    {binding : Binding} {cited : Range} {support : Support}\\n    (checked : Support.checked read source claim binding cited = .ok support) :\\n    cited.contains source = true := by\\n  unfold Support.checked at checked\\n  dsimp only at checked\\n  split at checked\\n  next valid =>\\n    simp only [Support.valid, Bool.and_eq_true] at valid\\n    exact valid.1.2\\n  next => contradiction\\n\\ninductive WitnessKind where\\n  | value | pathLine | path | identifier\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ninductive DataFormat where\\n  | text | json\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\nstructure Consumption where\\n  producer : Occurrence\\n  consumer : Occurrence\\n  producerFinish : Nat\\n  consumerStart : Nat\\n  kind : WitnessKind\\n  term : String\\n  inputFirst : Nat\\n  inputLimit : Nat\\n  outputFirst : Nat\\n  outputLimit : Nat\\n  inputFormat : DataFormat := .text\\n  outputFormat : DataFormat := .text\\n  /-- Only rows located in the actual producer output, never its entire read. -/\\n  rows : Array Range := #[]\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Consumption.valid (edge : Consumption) : Bool :=\\n  edge.producer.valid && edge.consumer.valid && edge.producer != edge.consumer &&\\n    edge.producerFinish < edge.consumerStart && !edge.term.isEmpty &&\\n    edge.inputFirst < edge.inputLimit && edge.outputFirst < edge.outputLimit &&\\n    edge.rows.all Range.valid\\n\\ndef Consumption.checked (edge : Consumption) : Except String Consumption :=\\n  if edge.valid then .ok edge else .error \\\"unavailable or invalid producer output\\\"\\n\\ntheorem Consumption.checked_before {edge accepted : Consumption}\\n    (checked : edge.checked = .ok accepted) : edge.producerFinish < edge.consumerStart := by\\n  unfold Consumption.checked at checked\\n  split at checked\\n  next valid =>\\n    simp only [Consumption.valid, Bool.and_eq_true, decide_eq_true_eq] at valid\\n    exact valid.1.1.1.1.2\\n  next => contradiction\\n\\ninductive Group where\\n  | answer (database owner : String)\\n  | claim (claim : Claim)\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Group.valid : Group → Bool\\n  | .answer database owner => !database.isEmpty && !owner.isEmpty\\n  | .claim value => value.valid\\n\\ninductive UsageKind where\\n  | omittedThenRead | omittedThenConsumed | deliveredThenCited | reread | sourceChanged\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef UsageKind.label : UsageKind → String\\n  | .omittedThenRead => \\\"omitted_then_read\\\"\\n  | .omittedThenConsumed => \\\"omitted_then_consumed\\\"\\n  | .deliveredThenCited => \\\"delivered_then_cited\\\"\\n  | .reread => \\\"reread\\\"\\n  | .sourceChanged => \\\"source_changed\\\"\\n\\nstructure ConsumptionUse where\\n  consumer : Occurrence\\n  source : Range\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\nstructure Event where\\n  occurrence : Occurrence\\n  ordinal : Nat\\n  consumption : Option ConsumptionUse := none\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, FromJson\\n\\n/-- A consumed range is keyed by its actual downstream use, independently of\\nwhich other ranges become used later. Ordinary observed ordinals stay distinct. -/\\ninstance : ToJson Event where\\n  toJson event := Json.mkObj ([\\n    (\\\"occurrence\\\",toJson event.occurrence),(\\\"ordinal\\\",toJson event.ordinal)] ++\\n    event.consumption.toList.map (fun value => (\\\"consumption\\\",toJson value)))\\n\\nstructure Usage where\\n  event : Event\\n  /-- Opaque digest, never a plaintext question in a shared DB. -/\\n  query : String\\n  source : Range\\n  kind : UsageKind\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Usage.valid (usage : Usage) : Bool :=\\n  usage.event.occurrence.valid && digest usage.query && usage.source.valid &&\\n    usage.event.consumption.all (fun cause => usage.event.ordinal == 0 && cause.consumer.valid &&\\n      cause.consumer != usage.event.occurrence && cause.source == usage.source)\\n\\ninductive Fact where\\n  | read (read : Read)\\n  | consumed (edge : Consumption)\\n  | supports (support : Support)\\n  | coquoted (group : Group) (source : Range)\\n  | used (usage : Usage)\\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\\n\\ndef Fact.valid : Fact → Bool\\n  | .read value => value.valid\\n  | .consumed edge => edge.valid\\n  | .supports support => support.valid\\n  | .coquoted group source => group.valid && source.valid\\n  | .used usage => usage.valid\\n\\n/-- Evidence union is the lattice operation; counts are derived after union. -/\\ndef evidenceJoin [BEq α] [Hashable α] (left right : Std.HashSet α) : Std.HashSet α :=\\n  left.union right\\n\\ndef SameEvidence [BEq α] [Hashable α] (left right : Std.HashSet α) : Prop :=\\n  ∀ fact, left.contains fact = right.contains fact\\n\\ntheorem evidenceJoin_idempotent [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\\n    (evidence : Std.HashSet α) : SameEvidence (evidenceJoin evidence evidence) evidence := by\\n  intro fact\\n  simp [evidenceJoin, Std.HashSet.contains_union]\\n\\ntheorem evidenceJoin_commutative [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\\n    (left right : Std.HashSet α) : SameEvidence (evidenceJoin left right) (evidenceJoin right left) := by\\n  intro fact\\n  simp [evidenceJoin, Std.HashSet.contains_union, Bool.or_comm]\\n\\ntheorem evidenceJoin_associative [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\\n    (a b c : Std.HashSet α) :\\n    SameEvidence (evidenceJoin (evidenceJoin a b) c) (evidenceJoin a (evidenceJoin b c)) := by\\n  intro fact\\n  simp [evidenceJoin, Std.HashSet.contains_union, Bool.or_assoc]\\n\\ndef add [BEq α] [Hashable α] [BEq β] [Hashable β]\\n    (map : Std.HashMap α (Std.HashSet β)) (key : α) (value : β) :=\\n  map.insert key ((map[key]?.getD {}).insert value)\\n\\nstructure Graph where\\n  facts : Std.HashSet Fact := {}\\n  bindings : Std.HashMap Range (Std.HashSet Binding) := {}\\n  incoming : Std.HashMap Occurrence (Std.HashSet Consumption) := {}\\n  supported : Std.HashMap Claim (Std.HashSet Support) := {}\\n  groups : Std.HashMap Group (Std.HashSet Range) := {}\\n  quotedBy : Std.HashMap Range (Std.HashSet Group) := {}\\n  events : Std.HashMap Event Usage := {}\\n  usages : Std.HashMap Range (Std.HashSet Usage) := {}\\n\\ndef Graph.empty : Graph := {}\\n\\ndef Graph.bind (graph : Graph) (source : Range) (binding : Binding) : Graph :=\\n  {graph with bindings := add graph.bindings source binding}\\n\\n/-- Insertion is transactional. A repeated event cannot acquire a new label. -/\\ndef Graph.insert (graph : Graph) (fact : Fact) : Except String Graph := do\\n  unless fact.valid do throw \\\"invalid advisory evidence\\\"\\n  if graph.facts.contains fact then return graph\\n  let graph := {graph with facts := graph.facts.insert fact}\\n  match fact with\\n  | .read value => return graph.bind value.source value.binding\\n  | .consumed edge =>\\n    return {graph with incoming := add graph.incoming edge.consumer edge}\\n  | .supports support =>\\n    let graph := (graph.bind support.source support.binding).bind support.read.source support.read.binding\\n    return {graph with supported := add graph.supported support.claim support}\\n  | .coquoted group source =>\\n    return {graph with\\n      groups := add graph.groups group source\\n      quotedBy := add graph.quotedBy source group}\\n  | .used usage =>\\n    if let some previous := graph.events[usage.event]? then\\n      unless previous == usage do throw \\\"conflicting immutable usage event\\\"\\n    return {graph with\\n      events := graph.events.insert usage.event usage\\n      usages := add graph.usages usage.source usage}\\n\\ndef Graph.ofFacts (facts : Array Fact) : Except String Graph :=\\n  facts.foldlM Graph.insert Graph.empty\\n\\n/-- Canonical interchange is separate from hash-table iteration order. -/\\ndef Graph.snapshot (graph : Graph) : Array Fact :=\\n  graph.facts.toArray.qsort (fun a b => (toJson a).compress < (toJson b).compress)\\n\\ndef Graph.merge (left right : Graph) : Except String Graph :=\\n  Graph.ofFacts (evidenceJoin left.facts right.facts).toArray\\n\\ndef Graph.evidenceCount (graph : Graph) : Nat := graph.facts.size\\n\\ndef Graph.rangeCount (graph : Graph) : Nat :=\\n  let ranges := graph.facts.fold (fun ranges fact =>\\n    match fact with\\n    | .read value => ranges.insert value.source\\n    | .supports support => (ranges.insert support.source).insert support.read.source\\n    | .consumed edge => edge.rows.foldl (·.insert ·) ranges\\n    | .coquoted _ source => ranges.insert source\\n    | .used usage => ranges.insert usage.source) ({} : Std.HashSet Range)\\n  ranges.size\\n\\ndef Graph.sourceBindings (graph : Graph) (source : Range) : Array Binding :=\\n  (graph.bindings[source]?.getD {}).toArray\\n\\n/-- Closed interval union, bounded by observed intervals rather than line numbers. -/\\ndef covered (wanted : Range) (observed : Array Range) : Bool := Id.run do\\n  let rows := (observed.filter (·.subject == wanted.subject)).toList.mergeSort (fun a b => a.first ≤ b.first)\\n  let mut position := wanted.first\\n  for row in rows do\\n    if position < row.first then return false\\n    if position ≤ row.last then position := row.last + 1\\n    if wanted.last < position then return true\\n  return false\\n\\ndef readKind (requested : Range) (stored delivered : Array Range) (fingerprintChecked : Bool) : UsageKind :=\\n  if !fingerprintChecked then .reread\\n  else if covered requested stored then\\n    if covered requested delivered then .reread else .omittedThenRead\\n  else if stored.any (fun range => range.subject.sameLocation requested.subject && range.subject != requested.subject)\\n    then .sourceChanged\\n  else .reread\\n\\ntheorem omitted_requires_checked (requested : Range) (stored delivered : Array Range)\\n    (checked : Bool) (omitted : readKind requested stored delivered checked = .omittedThenRead) :\\n    checked = true := by\\n  cases checked <;> simp_all [readKind]\\n\\ntheorem omitted_requires_stored (requested : Range) (stored delivered : Array Range)\\n    (checked : Bool) (omitted : readKind requested stored delivered checked = .omittedThenRead) :\\n    covered requested stored = true ∧ covered requested delivered = false := by\\n  unfold readKind at omitted\\n  split at omitted\\n  next => contradiction\\n  next =>\\n    split at omitted\\n    next stored =>\\n      split at omitted\\n      next => contradiction\\n      next delivered => exact ⟨by simpa using stored, by simpa using delivered⟩\\n    next => split at omitted <;> contradiction\\n\\ndef Graph.recordRead (graph : Graph) (event : Event) (query : String) (requested : Range)\\n    (stored delivered : Array Range) (checked : Bool) : Except String Graph :=\\n  graph.insert (.used {\\n    event := event\\n    query := query\\n    source := requested\\n    kind := readKind requested stored delivered checked})\\n\\ndef Graph.recordCitation (graph : Graph) (event : Event) (query : String) (source : Range)\\n    (delivered : Array Range) : Except String Graph :=\\n  if covered source delivered then\\n    graph.insert (.used {event, query, source, kind := .deliveredThenCited})\\n  else .ok graph\\n\\nstructure UsageCounts where\\n  omittedThenRead : Nat := 0\\n  omittedThenConsumed : Nat := 0\\n  deliveredThenCited : Nat := 0\\n  reread : Nat := 0\\n  sourceChanged : Nat := 0\\n  deriving Repr, BEq, ToJson\\n\\ndef Graph.usageCounts (graph : Graph) (source : Range) (query : Option String := none) : UsageCounts :=\\n  (graph.usages[source]?.getD {}).fold (fun counts usage =>\\n    if query.any (· != usage.query) then counts else\\n    match usage.kind with\\n    | .omittedThenRead => {counts with omittedThenRead := counts.omittedThenRead + 1}\\n    | .omittedThenConsumed => {counts with omittedThenConsumed := counts.omittedThenConsumed + 1}\\n    | .deliveredThenCited => {counts with deliveredThenCited := counts.deliveredThenCited + 1}\\n    | .reread => {counts with reread := counts.reread + 1}\\n    | .sourceChanged => {counts with sourceChanged := counts.sourceChanged + 1}) {}\\n\\n/-- Incidence traversal visits each shared answer once, without building cliques. -/\\ndef Graph.companions (graph : Graph) (sources : Array Range) : Std.HashMap Range Nat := Id.run do\\n  let mut groups : Std.HashSet Group := {}\\n  for source in sources do\\n    for group in graph.quotedBy[source]?.getD {} do\\n      if let .answer .. := group then groups := groups.insert group\\n  let mut counts : Std.HashMap Range Nat := {}\\n  for group in groups do\\n    for source in graph.groups[group]?.getD {} do\\n      counts := counts.insert source (counts[source]?.getD 0 + 1)\\n  return counts\\n\\nstructure Relevant where\\n  ranges : Std.HashSet Range := {}\\n  occurrences : Std.HashSet Occurrence := {}\\n  unlocated : Array Consumption := #[]\\n\\n/-- Supports seed reverse consumption. Only located witness rows add body ranges. -/\\ndef Graph.relevant (graph : Graph) (claims : Array Claim) : Relevant := Id.run do\\n  let mut result : Relevant := {}\\n  let mut queue : Array Occurrence := #[]\\n  for claim in claims do\\n    for support in graph.supported[claim]?.getD {} do\\n      result := {result with ranges := result.ranges.insert support.source}\\n      queue := queue.push support.read.occurrence\\n  let mut position := 0\\n  while position < queue.size do\\n    let some occurrence := queue[position]? | break\\n    position := position + 1\\n    if result.occurrences.contains occurrence then continue\\n    result := {result with occurrences := result.occurrences.insert occurrence}\\n    for edge in graph.incoming[occurrence]?.getD {} do\\n      result := {result with ranges := edge.rows.foldl (·.insert ·) result.ranges}\\n      if edge.rows.isEmpty then result := {result with unlocated := result.unlocated.push edge}\\n      queue := queue.push edge.producer\\n  return result\\n\\nend Eggshell.Synapses\\n\"],[\"SynapseExtraction.lean\",\"module\\n\\npublic import Eggshell.Synapses\\npublic import Eggshell.SearchUnicode\\npublic import Eggshell.JsonScalars\\npublic import tools.RetrievalCategories\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Extraction\\nopen Lean\\n\\nstructure Term where\\n  kind : WitnessKind\\n  text : String\\n  first : Nat\\n  limit : Nat\\n  deriving Repr, BEq\\n\\ndef termCharacter (char : Char) : Bool :=\\n  char.isAlphanum || char == '_' || char == '/' || char == '.' || char == '+' ||\\n    char == '-' || char == ':' || (128 ≤ char.toNat &&\\n      (RetrievalResearch.Unicode.letterNumber char || RetrievalResearch.Unicode.mark char))\\n\\ndef nameStart (char : Char) : Bool :=\\n  char == '_' || (RetrievalResearch.Unicode.letterNumber char && !SearchUnicode.isDigit char)\\n\\ndef namePart (char : Char) : Bool :=\\n  RetrievalResearch.Unicode.letterNumber char || RetrievalResearch.Unicode.mark char ||\\n    \\\"_:.+-\\\".contains char\\n\\n/-- A named file component is required: separators and C++ comment delimiters\\nare not paths. Pure numbers, options and sed bounds are not identifiers.\\nThis is a lexical witness policy, not a proof of tool data dependence. -/\\ndef termKind? (value : String) : Option WitnessKind :=\\n  if value.isEmpty || value.toList.all SearchUnicode.isDigit then none\\n  else if value.contains '/' then\\n    if value.toList.any (fun char => RetrievalResearch.Unicode.letterNumber char || char == '_') then\\n      let suffix := value.splitOn \\\":\\\" |>.getLast!\\n      some (if suffix.toNat?.isSome && value.contains ':' then .pathLine else .path)\\n    else none\\n  else if value.toList.head?.any nameStart && value.toList.all namePart then some .identifier\\n  else none\\n\\ntheorem numeric_not_a_witness (value : String)\\n    (numeric : value.toList.all SearchUnicode.isDigit = true) : termKind? value = none := by\\n  simp [termKind?, numeric]\\n\\ntheorem unnamed_path_not_a_witness (value : String) (slash : value.contains '/' = true)\\n    (unnamed : value.toList.any (fun char => RetrievalResearch.Unicode.letterNumber char || char == '_') = false) :\\n    termKind? value = none := by\\n  simp [termKind?, slash, unnamed]\\n\\n/-- Preserve every source position. Repeating a token on another output row\\nis another possible witness, not a duplicate of the first row. -/\\ndef termOccurrences (text : String) : Array Term := Id.run do\\n  let mut result := #[]\\n  let mut first := 0\\n  let mut position := 0\\n  let mut token : Array Char := #[]\\n  for char in text.toList ++ [' '] do\\n    if termCharacter char then\\n      if token.isEmpty then first := position\\n      token := token.push char\\n    else if !token.isEmpty then\\n      let value := String.ofList token.toList\\n      if let some kind := termKind? value then\\n        result := result.push ⟨kind, value, first, position⟩\\n        if kind == .pathLine then\\n          let path := \\\":\\\".intercalate (value.splitOn \\\":\\\" |>.dropLast)\\n          if termKind? path == some .path then\\n            result := result.push ⟨.path, path, first, first + path.length⟩\\n      token := #[]\\n    position := position + 1\\n  return result\\n\\n/-- A consumer needs one literal argument witness per key. Deduplicating\\narguments does not discard any position in a producer's output. -/\\ndef terms (text : String) : Array Term := Id.run do\\n  let mut seen : Std.HashSet (WitnessKind × String) := {}\\n  let mut result := #[]\\n  for term in termOccurrences text do\\n    if seen.contains (term.kind, term.text) then continue\\n    seen := seen.insert (term.kind, term.text)\\n    result := result.push term\\n  return result\\n\\nstructure OutputRow where\\n  source : Range\\n  first : Nat\\n  limit : Nat\\n  deriving Repr, BEq, ToJson, FromJson\\n\\ndef OutputRow.covers (row : OutputRow) (first limit : Nat) : Bool :=\\n  row.first ≤ first && first < limit && limit ≤ row.limit && row.source.valid\\n\\n/-- A verified file row takes precedence over its enclosing native member.\\nOtherwise keep the smallest covering span; adding context cannot expand a\\nlocated witness into every enclosing container. -/\\ndef project (rows : Array OutputRow) (first limit : Nat) : Array Range :=\\n  let file := rows.any fun row => row.covers first limit && row.source.file?.isSome\\n  let candidates := rows.filter fun row => row.covers first limit && (!file || row.source.file?.isSome)\\n  let initial := (candidates[0]?).map (fun row => row.limit-row.first) |>.getD 0\\n  let width := candidates.foldl (fun n row => min n (row.limit-row.first)) initial\\n  (candidates.filter (fun row => row.limit-row.first == width)).map (·.source)\\n\\ntheorem project_has_witness {rows : Array OutputRow} {first limit : Nat} {source : Range}\\n    (present : source ∈ project rows first limit) :\\n    ∃ row ∈ rows, row.source = source ∧ row.covers first limit = true := by\\n  simp only [project, Array.mem_map, Array.mem_filter, Bool.and_eq_true] at present\\n  obtain ⟨row, ⟨⟨member, covers, _⟩, _⟩, equal⟩ := present\\n  exact ⟨row, member, equal, covers⟩\\n\\nstructure Produced where\\n  occurrence : Occurrence\\n  finished : Nat\\n  term : Term\\n  source : Array Char\\n  format : DataFormat := .text\\n  deriving Repr\\n\\ndef literal (source : Array Char) (first limit : Nat) (term : String) : Bool :=\\n  first < limit && limit ≤ source.size &&\\n    String.ofList (source.extract first limit).toList == term\\n\\n/-- Structured values retain their JSON type and raw literal coordinates.\\nLexical hints are extracted only inside string values, never object keys. -/\\ndef payloadOccurrences (format : DataFormat) (text : String) : Except String (Array Term) := do\\n  if format == .text then return termOccurrences text\\n  let raw := text.toList.toArray\\n  let mut terms := #[]\\n  for scalar in ← JsonScalars.values text do\\n    terms := terms.push ⟨.value,scalar.literal,scalar.first,scalar.limit⟩\\n    if let some value := scalar.text then\\n      for term in termOccurrences value do\\n        let some first := scalar.offsets[term.first]? | continue\\n        let some limit := scalar.offsets[term.limit]? | continue\\n        if literal raw first limit term.text then\\n          terms := terms.push {term with first,limit}\\n  return terms\\n\\ndef witnessTerm (edge : Consumption) : Bool :=\\n  if edge.kind == .value then edge.inputFormat == .json && edge.outputFormat == .json &&\\n    JsonScalars.scalarLiteral edge.term\\n  else termKind? edge.term == some edge.kind\\n\\n/-- A pending link carries checked literal positions in both actual texts.\\nThe output array is shared by all witnesses from one immutable completion. -/\\nstructure Pending where\\n  edge : Consumption\\n  input : Array Char\\n  output : Array Char\\n  valid : edge.valid = true\\n  classified : witnessTerm edge = true\\n  inputExact : literal input edge.inputFirst edge.inputLimit edge.term = true\\n  outputExact : literal output edge.outputFirst edge.outputLimit edge.term = true\\n\\ndef Pending.check? (edge : Consumption) (input output : Array Char) : Option Pending :=\\n  if valid : edge.valid = true then\\n    if classified : witnessTerm edge = true then\\n      if inputExact : literal input edge.inputFirst edge.inputLimit edge.term = true then\\n        if outputExact : literal output edge.outputFirst edge.outputLimit edge.term = true then\\n          some ⟨edge, input, output, valid, classified, inputExact, outputExact⟩ else none\\n      else none\\n    else none\\n  else none\\n\\ntheorem Pending.input_literal (pending : Pending) :\\n    String.ofList (pending.input.extract pending.edge.inputFirst pending.edge.inputLimit).toList =\\n      pending.edge.term := by\\n  have witness := pending.inputExact\\n  simp only [literal, Bool.and_eq_true, beq_iff_eq] at witness\\n  exact witness.2\\n\\ntheorem Pending.output_literal (pending : Pending) :\\n    String.ofList (pending.output.extract pending.edge.outputFirst pending.edge.outputLimit).toList =\\n      pending.edge.term := by\\n  have witness := pending.outputExact\\n  simp only [literal, Bool.and_eq_true, beq_iff_eq] at witness\\n  exact witness.2\\n\\ntheorem Pending.output_within (pending : Pending) :\\n    pending.edge.outputFirst < pending.edge.outputLimit ∧ pending.edge.outputLimit ≤ pending.output.size := by\\n  have witness := pending.outputExact\\n  simp only [literal, Bool.and_eq_true, decide_eq_true_eq] at witness\\n  exact witness.1\\n\\ntheorem Pending.before (pending : Pending) : pending.edge.producerFinish < pending.edge.consumerStart :=\\n  Consumption.checked_before (edge := pending.edge) (accepted := pending.edge)\\n    (by simp [Consumption.checked, pending.valid])\\n\\ntheorem Pending.non_numeric (pending : Pending) (unstructured : pending.edge.kind ≠ .value) :\\n    pending.edge.term.toList.all SearchUnicode.isDigit = false := by\\n  cases numeric : pending.edge.term.toList.all SearchUnicode.isDigit with\\n  | false => rfl\\n  | true =>\\n    have rejected := numeric_not_a_witness pending.edge.term numeric\\n    have accepted := pending.classified\\n    simp [witnessTerm,unstructured,beq_iff_eq,rejected] at accepted\\n\\nstructure Started where\\n  command : String\\n  ordinal : Nat\\n  pending : Array Pending\\n  format : DataFormat := .text\\n\\nstructure Trace where\\n  graph : Graph := .empty\\n  outputs : Std.HashMap (WitnessKind × String) (Std.HashMap Occurrence (Array Produced)) := {}\\n  starts : Std.HashMap Occurrence Started := {}\\n  finished : Std.HashMap Occurrence String := {}\\n  finishedFormats : Std.HashMap Occurrence DataFormat := {}\\n  rows : Std.HashMap Occurrence (Array OutputRow) := {}\\n  lastOrdinal : Option Nat := none\\n\\ndef Trace.advance (trace : Trace) (ordinal : Nat) : Except String Trace := do\\n  if trace.lastOrdinal.any (ordinal < ·) then throw \\\"RPC trace is not in observed order\\\"\\n  return {trace with lastOrdinal := some ordinal}\\n\\ndef Trace.start (trace : Trace) (occurrence : Occurrence) (ordinal : Nat) (command : String)\\n    (format : DataFormat := .text) :\\n    Except String Trace := do\\n  let trace ← trace.advance ordinal\\n  unless occurrence.valid do throw \\\"missing exact session/turn/tool-use identity\\\"\\n  if let some previous := trace.starts[occurrence]? then\\n    unless previous.command == command && previous.format == format do throw \\\"one occurrence changed its input\\\"\\n    return trace\\n  let mut pending := #[]\\n  let input := command.toList.toArray\\n  let candidates ← payloadOccurrences format command\\n  let strong := candidates.filter fun term => term.kind == .value &&\\n    (trace.outputs[(term.kind,term.text)]?.getD {}).any (fun _ producers =>\\n      producers.any (fun producer => producer.finished < ordinal))\\n  let mut seen : Std.HashSet (WitnessKind × String) := {}\\n  for term in candidates do\\n    if term.kind != .value && strong.any (fun value => value.first ≤ term.first && term.limit ≤ value.limit) then continue\\n    if seen.contains (term.kind,term.text) then continue\\n    seen := seen.insert (term.kind,term.text)\\n    for (_, producers) in trace.outputs[(term.kind, term.text)]?.getD {} do\\n      for producer in producers do\\n        if ordinal ≤ producer.finished then continue\\n        let edge : Consumption := {\\n          producer := producer.occurrence, consumer := occurrence\\n          producerFinish := producer.finished, consumerStart := ordinal\\n          kind := term.kind, term := term.text\\n          inputFirst := term.first, inputLimit := term.limit\\n          outputFirst := producer.term.first, outputLimit := producer.term.limit\\n          inputFormat := format,outputFormat := producer.format\\n          rows := project (trace.rows[producer.occurrence]?.getD {}) producer.term.first producer.term.limit }\\n        if let some checked := Pending.check? edge input producer.source then\\n          pending := pending.push checked\\n  return {trace with starts := trace.starts.insert occurrence ⟨command, ordinal, pending,format⟩}\\n\\ndef Trace.finish (trace : Trace) (occurrence : Occurrence) (ordinal : Nat) (output : String)\\n    (format : DataFormat := .text) :\\n    Except String Trace := do\\n  let trace ← trace.advance ordinal\\n  let some started := trace.starts[occurrence]? | throw \\\"output has no observed start\\\"\\n  if let some previous := trace.finished[occurrence]? then\\n    unless previous == output && trace.finishedFormats[occurrence]? == some format do throw \\\"one occurrence changed its output\\\"\\n    return trace\\n  unless started.ordinal < ordinal do throw \\\"output predates call start\\\"\\n  let mut graph := trace.graph\\n  for pending in started.pending do graph ← graph.insert (.consumed pending.edge)\\n  let mut outputs := trace.outputs\\n  let source := output.toList.toArray\\n  for term in ← payloadOccurrences format output do\\n    let previous := outputs[(term.kind, term.text)]?.getD {}\\n    let positions := previous[occurrence]?.getD #[]\\n    outputs := outputs.insert (term.kind, term.text)\\n      (previous.insert occurrence (positions.push ⟨occurrence, ordinal, term, source,format⟩))\\n  return {trace with\\n    graph, outputs\\n    finished := trace.finished.insert occurrence output\\n    finishedFormats := trace.finishedFormats.insert occurrence format}\\n\\n/-- Attach verified row locations after exact native occurrence binding. -/\\ndef Trace.locate (trace : Trace) (rows : Std.HashMap Occurrence (Array OutputRow)) :\\n    Except String Trace := do\\n  let mut facts := #[]\\n  for fact in trace.graph.snapshot do\\n    match fact with\\n    | .consumed edge =>\\n      let projected := project (rows[edge.producer]?.getD {}) edge.outputFirst edge.outputLimit\\n      facts := facts.push (.consumed {edge with rows := projected})\\n    | other => facts := facts.push other\\n  return {trace with rows, graph := ← Graph.ofFacts facts}\\n\\ndef supportCitations (graph : Graph) (claim : Claim) (cited : Array Range) (reads : Array Read)\\n    (original : Array Read := #[]) :\\n    Except String Graph := do\\n  let mut graph := graph\\n  for citation in cited do\\n    for recorded in reads do\\n      if let some source := citation.intersection? recorded.source then\\n        let rows := original.filter (fun row => row.occurrence == recorded.occurrence &&\\n          row.binding.database == recorded.binding.database &&\\n          row.binding.owner == recorded.binding.owner && row.binding.work == recorded.binding.work &&\\n          source.contains row.source)\\n        let binding ← if source == recorded.source then pure recorded.binding else do\\n          unless covered source (rows.map (·.source)) do continue\\n          let first := rows.foldl (fun first row => min first row.binding.first) recorded.binding.limit\\n          let limit := rows.foldl (fun limit row => max limit row.binding.limit) recorded.binding.first\\n          pure {recorded.binding with first, limit}\\n        let support ← Support.checked recorded source claim binding citation\\n        graph ← graph.insert (.supports support)\\n        graph ← graph.insert (.coquoted (.answer claim.database claim.answer) source)\\n        graph ← graph.insert (.coquoted (.claim claim) source)\\n  return graph\\n\\n/-- Actual notifications only. Missing starts/finishes remain explicit errors. -/\\ndef Trace.notification (trace : Trace) (ordinal : Nat) (record : Json) : Except String Trace := do\\n  if (← record.getObjValAs? String \\\"direction\\\") != \\\"server\\\" then return trace\\n  let message ← record.getObjVal? \\\"message\\\"\\n  let method := (message.getObjValAs? String \\\"method\\\").toOption.getD \\\"\\\"\\n  if method != \\\"item/started\\\" && method != \\\"item/completed\\\" then return trace\\n  let params ← message.getObjVal? \\\"params\\\"\\n  let item ← params.getObjVal? \\\"item\\\"\\n  if (← item.getObjValAs? String \\\"type\\\") != \\\"commandExecution\\\" then return trace\\n  let occurrence : Occurrence := ⟨← params.getObjValAs? String \\\"threadId\\\",\\n    ← params.getObjValAs? String \\\"turnId\\\", ← item.getObjValAs? String \\\"id\\\"⟩\\n  if method == \\\"item/started\\\" then\\n    trace.start occurrence ordinal (← item.getObjValAs? String \\\"command\\\")\\n  else\\n    trace.finish occurrence ordinal ((item.getObjValAs? String \\\"aggregatedOutput\\\").toOption.getD \\\"\\\")\\n\\nend Eggshell.Synapses.Extraction\\n\"],[\"SynapseSource.lean\",\"module\\n\\npublic import Eggshell.SynapseExtraction\\npublic import Eggshell.SourceEvidence\\npublic import Lean.Data.Json.Parser\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Extraction\\nopen Lean\\n\\nstructure Layout where\\n  text : String\\n  original : String\\n  offsets : Array Nat\\n\\n/-- Canonical JSON is checked once; coordinates name original scalar characters. -/\\ndef canonicalLayout (raw : String) : Except String Layout := do\\n  let projected ← if raw.startsWith \\\"\\\\\\\"\\\" then pure (some (raw, 0)) else\\n    match Json.parse raw with\\n    | .ok (.obj value) => do\\n      let json := Json.obj value\\n      unless json.compress == raw do throw \\\"noncanonical native response\\\"\\n      let outputs := ([\\\"output\\\", \\\"aggregatedOutput\\\", \\\"stdout\\\"].filterMap fun key =>\\n        (json.getObjValAs? String key).toOption).eraseDups\\n      match outputs with\\n      | [text] =>\\n        let fragment := (toJson text).compress\\n        match raw.splitOn fragment with\\n        | [before, _] => pure (some (fragment, before.length))\\n        | _ => pure none\\n      | _ => pure none\\n    | _ => pure none\\n  let encoded := projected.isSome\\n  let fragment := projected.map (·.1) |>.getD raw\\n  let base := projected.map (·.2) |>.getD 0\\n  let text ← if encoded then Json.parse fragment >>= Json.getStr? else pure raw\\n  if encoded && (toJson text).compress != fragment then throw \\\"noncanonical saved scalar\\\"\\n  let mut offsets := #[]\\n  let mut position := base + if encoded then 1 else 0\\n  for char in text.toList do\\n    offsets := offsets.push position\\n    position := position + if encoded then (toJson (String.singleton char)).compress.length - 2 else 1\\n  offsets := offsets.push position\\n  unless position + (if encoded then 1 else 0) == base + fragment.length do throw \\\"scalar layout mismatch\\\"\\n  return ⟨text, raw, offsets⟩\\n\\n/-- A failed optional JSON projection never discards an observed body. The\\nliteral view has a coordinate for every original character, including malformed\\nor noncanonical JSON and arbitrary provider text. -/\\ndef layoutView (raw : String) : Layout :=\\n  match canonicalLayout raw with\\n  | .ok view => {view with original := raw}\\n  | .error _ => ⟨raw,raw,Array.range (raw.length+1)⟩\\n\\ndef layout (raw : String) : Except String Layout := .ok (layoutView raw)\\n\\ntheorem layout_total (raw : String) :\\n    ∃ view, layout raw = .ok view ∧ view.original = raw := by\\n  refine ⟨layoutView raw,rfl,?_⟩\\n  simp only [layoutView]\\n  split <;> rfl\\n\\nstructure TextLine where\\n  text : String\\n  first : Nat\\n  limit : Nat\\n  deriving Repr, BEq\\n\\ndef textLines (text : String) : Array TextLine := Id.run do\\n  let mut lines := #[]\\n  let mut position := 0\\n  let size := text.length\\n  for line in text.splitOn \\\"\\\\n\\\" do\\n    let limit := min size (position + line.length + 1)\\n    if position < limit then lines := lines.push ⟨line, position, limit⟩\\n    position := limit\\n  return lines\\n\\n/-- Terminal elision joins unrelated source fragments. Such a display row\\nhas original observation bytes, but no complete file-line payload. -/\\ndef outputElision (text : String) : Bool :=\\n  [\\\"…\\\", \\\"...\\\"].any fun delimiter =>\\n    ((text.splitOn delimiter).drop 1 |>.dropLast).any fun payload =>\\n      match (payload.trimAscii.toString.splitOn \\\" \\\").filter (!·.isEmpty) with\\n      | [count,unit,\\\"truncated\\\"] => count.toNat?.any (0 < ·) &&\\n          [\\\"tokens\\\",\\\"chars\\\",\\\"bytes\\\",\\\"lines\\\"].contains unit\\n      | _ => false\\n\\ndef numbered (text : String) : Option (Nat × String) := do\\n  if outputElision text then none else do\\n    let parts := text.splitOn \\\"\\\\t\\\"\\n    let first ← parts.head?\\n    let number ← first.trimAscii.copy.toNat?\\n    if number == 0 || parts.length < 2 then none\\n    else some (number, \\\"\\\\t\\\".intercalate parts.tail)\\n\\ntheorem elided_row_not_numbered (text : String) (elided : outputElision text = true) :\\n    numbered text = none := by\\n  simp [numbered,elided]\\n\\n/-- Literal shell lexer; unsupported syntax stays unsupported and is never run. -/\\ndef shellWords (text : String) : Except String (Array String) := do\\n  let mut words := #[]\\n  let mut token : Array Char := #[]\\n  let mut quote : Option Char := none\\n  let mut escaped := false\\n  for char in text.toList ++ [' '] do\\n    if escaped then\\n      token := token.push char\\n      escaped := false\\n    else if quote == some '\\\\'' then\\n      if char == '\\\\'' then quote := none else token := token.push char\\n    else if char == '\\\\\\\\' then escaped := true\\n    else if let some delimiter := quote then\\n      if char == delimiter then quote := none else token := token.push char\\n    else if char == '\\\\'' || char == '\\\"' then quote := some char\\n    else if char.isWhitespace || char == ';' || char == '|' then\\n      if !token.isEmpty then words := words.push (String.ofList token.toList)\\n      token := #[]\\n      if char == ';' || char == '|' || char == '\\\\n' then words := words.push (String.singleton char)\\n    else token := token.push char\\n  if quote.isSome || escaped then throw \\\"unfinished shell quote\\\"\\n  return words\\n\\ndef unwrap (command : String) : String :=\\n  match shellWords command with\\n  | .ok words =>\\n    match words.toList with\\n    | [shell, flag, inner] =>\\n      if ([\\\"sh\\\", \\\"bash\\\", \\\"zsh\\\"].contains (shell.splitOn \\\"/\\\" |>.getLast!)) &&\\n          (flag == \\\"-c\\\" || flag == \\\"-lc\\\") then inner else command\\n    | _ => command\\n  | .error _ => command\\n\\ndef workInput (work : String) : Except String Json := do\\n  let parts := work.splitOn \\\"\\\\n\\\"\\n  unless 2 ≤ parts.length do throw \\\"no native work command\\\"\\n  Json.parse (\\\"\\\\n\\\".intercalate parts.tail)\\n\\n/-- All fields of the original native invocation participate. Field names\\ncannot identify the tool's semantics or discard the other argument values. -/\\ndef invocationData (work : String) : Except String (String × DataFormat) := do\\n  let parts := work.splitOn \\\"\\\\n\\\"\\n  unless 2 ≤ parts.length do throw \\\"no native invocation payload\\\"\\n  let raw := \\\"\\\\n\\\".intercalate parts.tail\\n  match Json.parse raw with\\n  | .ok payload => return (payload.compress,.json)\\n  | .error _ => return (raw,.text)\\n\\ndef invocationInput (work : String) : Except String String := (invocationData work).map (·.1)\\n\\n/-- A source-reader decoder, never a gate for recording or general data flow. -/\\ndef workCommand (work : String) : Except String String := do\\n  let payload ← workInput work\\n  match payload.getObjValAs? String \\\"command\\\" with\\n  | .ok value => return unwrap value\\n  | .error _ => return unwrap (← payload.getObjValAs? String \\\"cmd\\\")\\n\\ndef fileMap (records : Array Json) : Except String (Array File) := do\\n  let mut candidates : Std.HashMap String (Std.HashSet File) := {}\\n  for record in records do\\n    if !(← record.getObjValAs? Bool \\\"complete\\\") then continue\\n    if !(← record.getObjValAs? (Array Json) \\\"uris\\\").isEmpty then continue\\n    for value in ← record.getObjValAs? (Array Json) \\\"files\\\" do\\n      let content ← value.getObjVal? \\\"content\\\"\\n      if content == .null then continue\\n      let file : File := ⟨← value.getObjValAs? String \\\"relative\\\",\\n        ← content.getObjValAs? String \\\"root\\\", ← content.getObjValAs? Nat \\\"bytes\\\"⟩\\n      if !file.valid then continue\\n      candidates := add candidates file.relative file\\n  return candidates.fold (fun result _ files =>\\n    if files.size == 1 then result ++ files.toArray else result) #[]\\n\\ndef parseBounds (text : String) : Option (Nat × Nat) := do\\n  let normalized := (text.replace \\\"–\\\" \\\"-\\\").replace \\\"—\\\" \\\"-\\\"\\n  let parts := normalized.splitOn \\\"-\\\"\\n  let first ← (← parts.head?).toNat?\\n  let last ← if parts.length == 1 then some first else if parts.length == 2 then\\n      ((parts[1]!).dropWhile (· == 'L')).toString.toNat? else none\\n  if 0 < first && first ≤ last then some (first, last) else none\\n\\ndef readPlans (command : String) (files : Array File) : Except String (Array Range) := do\\n  let some segments := SourceEvidence.sequenceSegments? command | throw \\\"unsupported read sequence\\\"\\n  let mut plans := #[]\\n  for segment in segments do\\n    let [\\\"nl\\\", \\\"-ba\\\", path, \\\"|\\\", \\\"sed\\\", \\\"-n\\\", program] := (← shellWords segment).toList |\\n      throw \\\"unsupported literal read sequence\\\"\\n    if path.toList.any (fun c => \\\"$\\\\x60*?{}\\\".contains c) then throw \\\"nonliteral read path\\\"\\n    let candidates := files.filter (fun f => path == f.relative || path.endsWith (\\\"/\\\" ++ f.relative))\\n    unless candidates.size == 1 do throw \\\"ambiguous read path\\\"\\n    for statement in program.splitOn \\\";\\\" do\\n      let statement := statement.trimAscii.toString\\n      unless statement.endsWith \\\"p\\\" do throw \\\"unsupported read program\\\"\\n      let bounds := ((statement.dropEnd 1).copy.replace \\\",\\\" \\\"-\\\")\\n      let some (first, last) := parseBounds bounds | throw \\\"invalid read interval\\\"\\n      plans := plans.push ⟨candidates[0]!, first, last⟩\\n  if plans.isEmpty then throw \\\"no numbered read\\\"\\n  return plans\\n\\nstructure Document where\\n  owner : String\\n  work : String\\n  workText : Option String\\n  source : Option String\\n  native : Bool\\n  occurrences : Array Occurrence\\n  files : Array File\\n\\ndef document (value : Json) : Except String Document := do\\n  return {\\n    owner := ← value.getObjValAs? String \\\"owner\\\"\\n    work := ← value.getObjValAs? String \\\"workKey\\\"\\n    workText := ← value.getObjValAs? (Option String) \\\"work\\\"\\n    source := ← value.getObjValAs? (Option String) \\\"source\\\"\\n    native := ← value.getObjValAs? Bool \\\"native\\\"\\n    occurrences := ← value.getObjValAs? (Array Occurrence) \\\"occurrences\\\"\\n    files := ← fileMap (← value.getObjValAs? (Array Json) \\\"records\\\") }\\n\\nstructure LocatedRead where\\n  read : Read\\n  rows : Array OutputRow\\n  originalRows : Array Read\\n  text : String\\n\\n/-- Presence in a pinned source archive, without inventing an execution order. -/\\ndef recordedRows (database : String) (doc : Document) : Except String (Array Read) := do\\n  let some raw := doc.source | throw \\\"no original observation\\\"\\n  let some work := doc.workText | throw \\\"no original work\\\"\\n  let some occurrence := doc.occurrences[0]? | throw \\\"missing native occurrence identity\\\"\\n  let plans ← readPlans (← workCommand work) doc.files\\n  let decoded ← layout raw\\n  let mut rows := #[]\\n  for line in textLines decoded.text do\\n    let some (number, _) := numbered line.text | continue\\n    let files := plans.foldl (fun files range =>\\n      if range.first ≤ number && number ≤ range.last then\\n        (range.file?.map files.insert).getD files else files)\\n      ({} : Std.HashSet File)\\n    if files.size != 1 then continue\\n    let source : Range := ⟨files.toArray[0]!, number, number⟩\\n    let binding : Binding := ⟨database, doc.owner, doc.work,\\n      decoded.offsets[line.first]!, decoded.offsets[line.limit]!⟩\\n    rows := rows.push {occurrence,source,binding}\\n  return rows\\n\\ndef recordedReads (database : String) (doc : Document) : Except String (Array LocatedRead) := do\\n  let rows ← recordedRows database doc\\n  let mut chunks : Array LocatedRead := #[]\\n  for row in rows do\\n    if let some previous := chunks.back? then\\n      if previous.read.source.subject == row.source.subject &&\\n          previous.read.source.last + 1 == row.source.first &&\\n          previous.read.binding.limit == row.binding.first then\\n        let merged := {previous with\\n          read := {previous.read with\\n            source := {previous.read.source with last := row.source.last}\\n            binding := {previous.read.binding with limit := row.binding.limit}}\\n          originalRows := previous.originalRows.push row}\\n        chunks := chunks.pop.push merged\\n        continue\\n    chunks := chunks.push ⟨row, #[], #[row], \\\"\\\"⟩\\n  return chunks\\n\\ndef locateReads (database : String) (doc : Document) (trace : Trace) : Except String (Array LocatedRead) := do\\n  let some raw := doc.source | throw \\\"no original observation\\\"\\n  let some work := doc.workText | throw \\\"no original work\\\"\\n  let command ← workCommand work\\n  let (input,format) ← invocationData work\\n  let plans ← readPlans command doc.files\\n  let decoded ← layout raw\\n  let original := (textLines decoded.text).filterMap fun line => do\\n    let (number, body) ← numbered line.text\\n    let files := plans.filter (fun range => range.first ≤ number && number ≤ range.last)\\n    let unique := files.foldl (fun files range => (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n    if unique.size != 1 then none else\\n      some (line, number, body, unique.toArray[0]!)\\n  if original.isEmpty then throw \\\"no unambiguous original numbered rows\\\"\\n  let mut result := #[]\\n  for occurrence in doc.occurrences do\\n    let some start := trace.starts[occurrence]? | continue\\n    let some output := trace.finished[occurrence]? | continue\\n    let sameInput := match start.format with\\n      | .json => start.command == input && start.format == format\\n      | .text => unwrap start.command == command\\n    if !sameInput then continue\\n    let actualLayout ← layout output\\n    let actual := (textLines actualLayout.text).filterMap fun line => do\\n      let (number, body) ← numbered line.text\\n      some (line, number, body)\\n    if !original.all (fun (_, number, body, _) => actual.any (fun (_, n, b) => n == number && b == body)) then continue\\n    let mut chunks : Array LocatedRead := #[]\\n    for (line, number, body, file) in original do\\n      let source : Range := ⟨file, number, number⟩\\n      let first := decoded.offsets[line.first]!\\n      let limit := decoded.offsets[line.limit]!\\n      let binding : Binding := ⟨database, doc.owner, doc.work, first, limit⟩\\n      let rows := actual.filterMap fun (actualLine, n, b) =>\\n        if n == number && b == body then\\n          some (OutputRow.mk source actualLayout.offsets[actualLine.first]! actualLayout.offsets[actualLine.limit]!)\\n        else none\\n      let recorded : Read := {occurrence,source,binding}\\n      let located : LocatedRead := ⟨recorded, rows, #[recorded], line.text⟩\\n      if let some previous := chunks.back? then\\n        if previous.read.source.subject == .file file && previous.read.source.last + 1 == number &&\\n            previous.read.binding.limit == first then\\n          let merged : LocatedRead := {\\n            read := {previous.read with\\n              source := {previous.read.source with last := number}\\n              binding := {previous.read.binding with limit}}\\n            rows := previous.rows ++ rows\\n            originalRows := previous.originalRows.push recorded\\n            text := previous.text ++ \\\"\\\\n\\\" ++ line.text }\\n          chunks := chunks.pop.push merged\\n          continue\\n      chunks := chunks.push located\\n    result := result ++ chunks\\n  if result.isEmpty then throw \\\"saved observation has no exact matching completed call\\\"\\n  return result\\n\\ndef hexDigit (char : Char) : Option Nat :=\\n  if '0' ≤ char && char ≤ '9' then some (char.toNat - '0'.toNat)\\n  else if 'a' ≤ char && char ≤ 'f' then some (char.toNat - 'a'.toNat + 10)\\n  else if 'A' ≤ char && char ≤ 'F' then some (char.toNat - 'A'.toNat + 10)\\n  else none\\n\\ndef percentDecode (text : String) : Option String := do\\n  let chars := text.toList.toArray\\n  let mut bytes := ByteArray.empty\\n  let mut position := 0\\n  while position < chars.size do\\n    let char := chars[position]!\\n    if char == '%' then\\n      let a ← chars[position+1]? >>= hexDigit\\n      let b ← chars[position+2]? >>= hexDigit\\n      bytes := bytes.push (UInt8.ofNat (16*a+b))\\n      position := position+3\\n    else\\n      bytes := bytes ++ (String.singleton char).toUTF8\\n      position := position+1\\n  String.fromUTF8? bytes\\n\\n/-- Only declared paths and literal line intervals; destinations are never opened. -/\\ndef citation (label destination : String) (files : Array File) : Option Range := do\\n  let destination ← percentDecode destination\\n  let destination := destination.trimAscii.copy |>.replace \\\"<\\\" \\\"\\\" |>.replace \\\">\\\" \\\"\\\"\\n  let mut candidates := #[]\\n  for file in files do\\n    for separator in [\\\":\\\", \\\"#L\\\"] do\\n      let marker := file.relative ++ separator\\n      let parts := destination.splitOn marker\\n      if parts.length != 2 then continue\\n      let leading := parts[0]!\\n      if !leading.isEmpty && !leading.endsWith \\\"/\\\" then continue\\n      let some (first, last) := parseBounds parts[1]! | continue\\n      let filename := file.relative.splitOn \\\"/\\\" |>.getLast!\\n      let displayed := label.splitOn (filename ++ \\\":\\\")\\n      let mut last := last\\n      if displayed.length == 2 then\\n        let bounds := String.ofList ((displayed[1]!).toList.takeWhile\\n          (fun c => c.isDigit || c == '-' || c == '–' || c == '—'))\\n        let (a, b) ← parseBounds bounds\\n        if a != first || (first != last && b != last) then return ← none\\n        last := b\\n      candidates := candidates.push (Range.mk file first last)\\n  if candidates.size == 1 then some candidates[0]! else none\\n\\ndef paragraphCitations (text : String) (files : Array File) : Array Range := Id.run do\\n  let mut result : Std.HashSet Range := {}\\n  for part in (text.splitOn \\\"](\\\").dropLast.zip ((text.splitOn \\\"](\\\").tail) do\\n    let some label := (part.1.splitOn \\\"[\\\").getLast? | continue\\n    let some destination := (part.2.splitOn \\\")\\\").head? | continue\\n    if let some range := citation label destination files then result := result.insert range\\n  return result.toArray\\n\\ndef addAnswer (database : String) (doc : Document) (reads : Array LocatedRead) (graph : Graph) :\\n    Except String Graph := do\\n  let some raw := doc.source | throw \\\"answer has no original scalar\\\"\\n  let decoded ← layout raw\\n  let files := reads.foldl (fun files located =>\\n    (located.read.source.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n  let mut graph := graph\\n  let mut position := 0\\n  for paragraph in decoded.text.splitOn \\\"\\\\n\\\\n\\\" do\\n    let limit := position + paragraph.length\\n    if position < limit then\\n      let claim : Claim := ⟨database, doc.owner, decoded.offsets[position]!, decoded.offsets[limit]!⟩\\n      graph ← supportCitations graph claim (paragraphCitations paragraph files.toArray)\\n        (reads.map (·.read)) (reads.flatMap (·.originalRows))\\n    position := limit + 2\\n  return graph\\n\\nend Eggshell.Synapses.Extraction\\n\"],[\"SynapseUsage.lean\",\"module\\n\\npublic import Eggshell.SynapseSource\\npublic import tools.SpanPostings\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Extraction\\nopen Lean\\n\\nstructure Presentation where\\n  ranges : Array Range := #[]\\n  uncertain : Std.HashSet File := {}\\n  bindings : Array (String × Nat × Nat) := #[]\\n  uncertainOwners : Std.HashSet String := {}\\n  addressed : Array (String × Nat × Nat × List JsonScalars.Segment) := #[]\\n\\ndef caption (text : String) : Option (Nat × Nat × Bool) := do\\n  if !text.startsWith \\\"  ORIGINAL CHARS [\\\" && !text.startsWith \\\"  CHARS [\\\" then none else do\\n    let parts := text.splitOn \\\"CHARS [\\\"\\n    let rest ← parts[1]?\\n    let bounds ← (rest.splitOn \\\")\\\").head?\\n    let [first, limit] := bounds.splitOn \\\",\\\" | none\\n    let first ← first.toNat?\\n    let limit ← limit.toNat?\\n    if first < limit then some (first, limit, text.endsWith \\\" decoded\\\") else none\\n\\ndef scalarSlice (raw : String) (first limit : Nat) : Option String :=\\n  if first < limit && limit ≤ raw.length then\\n    some (String.ofList ((raw.toList.drop first).take (limit-first))) else none\\n\\nstructure SharedSpelling where\\n  file : File\\n  number : Nat\\n  code : String\\n  origins : Array (String × String × String × Occurrence)\\n\\n/-- Decode only complete shared frames. This grants no original-byte status;\\ncallers must bind each spelling to their saved original rows. -/\\ndef sharedSpellings (body : String) : Array SharedSpelling := Id.run do\\n  let wrapper := \\\"EGGSHELL SHARED SOURCE DATA\\\\nOriginal recorded file data; advisory, not a completed operation.\\\\n\\\"\\n  let mut found : Array SharedSpelling := #[]\\n  for packet in (body.splitOn wrapper).tail do\\n    let parts := packet.splitOn \\\"END EGGSHELL SHARED SOURCE DATA\\\\n\\\"\\n    if parts.length < 2 then continue\\n    for block in ((\\\"\\\\n\\\" ++ parts.head!).splitOn \\\"\\\\nSOURCE \\\").tail do\\n      let parts := block.splitOn \\\"\\\\nEND SOURCE\\\"\\n      if parts.length < 2 then continue\\n      let suffix := parts[1]!\\n      if !suffix.isEmpty && !suffix.startsWith \\\"\\\\n\\\" then continue\\n      let fileLine :: originsLine :: \\\"CODE\\\" :: codeLines := parts.head!.splitOn \\\"\\\\n\\\" | continue\\n      let some file := (Json.parse fileLine >>= fromJson? (α := File)).toOption | continue\\n      if !file.valid || !originsLine.startsWith \\\"ORIGINAL READS \\\" then continue\\n      let encoded := String.ofList (originsLine.toList.drop \\\"ORIGINAL READS \\\".length)\\n      let some origins := (Json.parse encoded >>= fromJson? (α := Array String)).toOption | continue\\n      let origins := origins.filterMap fun origin =>\\n        (Json.parse origin >>= fromJson? (α := String × String × String × Occurrence)).toOption\\n      for line in codeLines do\\n        let some (number,code) := numbered line | continue\\n        found := found.push ⟨file,number,code,origins⟩\\n  return found\\n\\n/-- A shared spelling can report only a range belonging to an original saved\\nrow. Sharing the payload never manufactures another execution witness. -/\\nstructure SharedWitness (reads : Array Read) where\\n  row : Read\\n  original : row ∈ reads\\n  file : File\\n  number : Nat\\n  code : String\\n  sourceExact : row.source = ⟨file,number,number⟩\\n\\ntheorem SharedWitness.original_range (witness : SharedWitness reads) :\\n    ∃ row ∈ reads, row.source = ⟨witness.file,witness.number,witness.number⟩ :=\\n  ⟨witness.row,witness.original,witness.sourceExact⟩\\n\\n/-- A file alias can cover just its original code bytes, without a numbered\\nprefix. JSON escaping changes representation, never the saved code spelling. -/\\nstructure SharedCode (original : String) where\\n  text : String\\n  exact : text = original ∨\\n    String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original\\n\\ndef sharedCodes (original : String) : Array (SharedCode original) := Id.run do\\n  let mut result := #[⟨original,Or.inl rfl⟩]\\n  if let some text := (Json.parse (\\\"\\\\\\\"\\\" ++ original ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption then\\n    if same : String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original then\\n      if text != original then result := result.push ⟨text,Or.inr same⟩\\n  return result\\n\\ntheorem SharedCode.original_spelling (code : SharedCode original) :\\n    code.text = original ∨\\n      String.ofList ((toJson code.text).compress.toList.drop 1 |>.dropLast) = original := code.exact\\n\\n/-- Recognize the producer's shared file frame, then compare every displayed\\ncode row with its raw scalar coordinates and declared DB/owner/Work/occurrence.\\nLocation-only notices and arbitrary matching prose cannot label delivery. -/\\ndef sharedPresented (body : String) (docs : Array Document) (reads : Array Read) :\\n    Array (SharedWitness reads) := Id.run do\\n  let displayed := sharedSpellings body\\n  if displayed.isEmpty || reads.isEmpty then return #[]\\n  let mut index : Std.HashMap (File × Nat × String) (Array (SharedWitness reads)) := {}\\n  let byOwner := reads.attach.foldl (fun found saved =>\\n    found.insert saved.val.binding.owner\\n      ((found.getD saved.val.binding.owner #[]).push saved))\\n    ({} : Std.HashMap String (Array {row // row ∈ reads}))\\n  for doc in docs do\\n    if !doc.native then continue\\n    let some raw := doc.source | continue\\n    let characters := raw.toList.toArray\\n    for saved in byOwner.getD doc.owner #[] do\\n      let row := saved.val\\n      if !row.valid || row.binding.work != doc.work || !doc.occurrences.contains row.occurrence then continue\\n      let .file file := row.source.subject | continue\\n      if row.source.first != row.source.last then continue\\n      if !(row.binding.first < row.binding.limit && row.binding.limit ≤ characters.size) then continue\\n      let original := String.ofList (characters.extract row.binding.first row.binding.limit).toList\\n      for code in sharedCodes original do\\n        if code.text.isEmpty || code.text.contains '\\\\n' || code.text.contains '\\\\r' then continue\\n        if same : row.source = ⟨file,row.source.first,row.source.first⟩ then\\n          let witness : SharedWitness reads := ⟨row,saved.property,file,row.source.first,code.text,same⟩\\n          let key := (file,row.source.first,code.text)\\n          index := index.insert key ((index.getD key #[]).push witness)\\n    let .ok decoded := layout raw | continue\\n    let spanOf := fun (saved : {row // row ∈ reads}) =>\\n      if saved.val.valid && saved.val.binding.work == doc.work then\\n        some (saved.val.binding.first,saved.val.binding.limit) else none\\n    let spans := SpanPostings.prepare spanOf (byOwner.getD doc.owner #[]).toList\\n    for line in textLines decoded.text do\\n      let some (number,code) := numbered line.text | continue\\n      for saved in spans.lookup (decoded.offsets[line.first]!,decoded.offsets[line.limit]!) do\\n        let row := saved.val\\n        let .file file := row.source.subject | continue\\n        if same : row.source = ⟨file,number,number⟩ then\\n          let witness : SharedWitness reads := ⟨row,saved.property,file,number,code,same⟩\\n          let key := (file,number,code)\\n          index := index.insert key ((index.getD key #[]).push witness)\\n  let mut found := #[]\\n  for spelling in displayed do\\n    for witness in index.getD (spelling.file,spelling.number,spelling.code) #[] do\\n      let row := witness.row\\n      if spelling.origins.contains (row.binding.database,row.binding.owner,row.binding.work,row.occurrence) then\\n        found := found.push witness\\n  return found\\n\\n/-- Verify actual packet bytes against immutable raw coordinates before labelling. -/\\ndef presented (body : String) (docs : Array Document) (reads : Array Read) : Presentation := Id.run do\\n  let mut result : Presentation := {}\\n  for part in body.splitOn \\\"\\\\nWORK GRAPH \\\" do\\n    let some owner := (part.splitOn \\\"\\\\n\\\").head? | continue\\n    let some doc := docs.find? (·.owner == owner) | continue\\n    let some raw := doc.source | continue\\n    let blocks := part.splitOn \\\"  GROUNDED OUTCOME\\\\n\\\"\\n    let some evidence := blocks[1]? | continue\\n    let evidence := (evidence.splitOn \\\"  TRACE\\\\n\\\").head!\\n    let json := JsonScalars.prepare? raw\\n    let rawChars := match json with | some index => index.characters | none => raw.toList.toArray\\n    let evidenceChars := evidence.toList.toArray\\n    let mut spans := #[]\\n    let mut addressed := #[]\\n    let mut path : Option String := none\\n    let mut bad := false\\n    for line in textLines evidence do\\n      if line.text.startsWith \\\"  JSON PATH \\\" then\\n        path := some (String.ofList (line.text.toList.drop \\\"  JSON PATH \\\".length))\\n        continue\\n      let some (first, limit, decoded) := caption line.text | continue\\n      let location := json.bind (·.cover? first limit)\\n      let declared := path\\n      path := none\\n      if declared.isSome && !location.any (fun address => declared == some address.label) then\\n        bad := true\\n        continue\\n      if !(first < limit && limit ≤ rawChars.size) then bad := true; continue\\n      let segment := String.ofList (rawChars.extract first limit).toList\\n      let marker := \\\"  DECODED JSON STRING DATA\\\\n\\\"\\n      let marked := literal evidenceChars line.limit (line.limit+marker.length) marker\\n      let expected := if decoded || marked then\\n          (Json.parse (\\\"\\\\\\\"\\\" ++ segment ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption\\n        else some segment\\n      let some expected := expected | bad := true; continue\\n      let dataStart := line.limit + if marked then marker.length else 0\\n      if dataStart+expected.length > evidenceChars.size ||\\n          String.ofList (evidenceChars.extract dataStart (dataStart+expected.length)).toList != expected then\\n        bad := true\\n        continue\\n      spans := spans.push (first, limit)\\n      if let some address := location then\\n        if declared == some address.label then addressed := addressed.push (owner,first,limit,address.path)\\n    if spans.isEmpty then\\n      let decoded := (layout raw).toOption.map (·.text)\\n      if !raw.isEmpty && ((evidence.splitOn raw).length > 1 ||\\n          decoded.any (fun text => !text.isEmpty && (evidence.splitOn text).length > 1)) then\\n        spans := #[(0, raw.length)]\\n      else bad := true\\n    if bad then\\n      result := {result with uncertainOwners := result.uncertainOwners.insert owner}\\n      for file in doc.files do result := {result with uncertain := result.uncertain.insert file}\\n    else\\n      result := {result with\\n        bindings := result.bindings ++ spans.map (fun (a,b) => (owner,a,b))\\n        addressed := result.addressed ++ addressed}\\n    for row in reads do\\n      if row.binding.owner == owner && spans.any (fun (first, limit) =>\\n          first ≤ row.binding.first && row.binding.limit ≤ limit) then\\n        result := {result with ranges := result.ranges.push row.source}\\n  for witness in sharedPresented body docs reads do\\n    result := {result with\\n      ranges := result.ranges.push witness.row.source\\n      bindings := result.bindings.push\\n        (witness.row.binding.owner,witness.row.binding.first,witness.row.binding.limit)}\\n  return result\\n\\ndef Presentation.coversBinding (shown : Presentation) (binding : Binding) : Bool := Id.run do\\n  if shown.uncertainOwners.contains binding.owner then return false\\n  let spans := shown.bindings.filterMap fun (owner,first,limit) =>\\n    if owner == binding.owner then some (first,limit) else none\\n  let spans := spans.qsort fun a b => a.1 < b.1\\n  let covered := spans.foldl (fun position (first,limit) =>\\n    if first ≤ position then max position limit else position) binding.first\\n  return binding.first < binding.limit && binding.limit ≤ covered\\n\\ndef Presentation.coversAddress (shown : Presentation) (binding : Binding) (path : List JsonScalars.Segment) : Bool :=\\n  let bindings := shown.addressed.filterMap fun (owner,first,limit,actual) =>\\n    if actual == path then some (owner,first,limit) else none\\n  {shown with bindings}.coversBinding binding\\n\\ndef compactRanges (ranges : Array Range) : Array Range := Id.run do\\n  let mut files : Std.HashMap Subject (Array Range) := {}\\n  for range in ranges do files := files.insert range.subject (files[range.subject]?.getD #[] |>.push range)\\n  let mut result := #[]\\n  for (_, spans) in files do\\n    let mut merged : Array Range := #[]\\n    for span in spans.qsort (fun a b => a.first < b.first || (a.first == b.first && a.last < b.last)) do\\n      if let some previous := merged.back? then\\n        if span.first ≤ previous.last+1 then\\n          merged := merged.pop.push {previous with last := max previous.last span.last}\\n          continue\\n      merged := merged.push span\\n    result := result ++ merged\\n  return result\\n\\n/-- Stored overlap minus verified delivery; does not expand a citation's line count. -/\\ndef omittedRanges (requested : Range) (stored delivered : Array Range) : Array Range := Id.run do\\n  let mut result : Std.HashSet Range := {}\\n  for saved in compactRanges stored do\\n    if saved.subject != requested.subject then continue\\n    let first := max saved.first requested.first\\n    let last := min saved.last requested.last\\n    if last < first then continue\\n    let relevant := (delivered.filter (·.subject == requested.subject)).toList.mergeSort\\n      (fun a b => a.first ≤ b.first)\\n    let mut position := first\\n    for shown in relevant do\\n      if position > last then break\\n      if shown.last < position then continue\\n      if position < shown.first then\\n        result := result.insert {requested with first := position, last := min last (shown.first-1)}\\n      position := max position (shown.last+1)\\n    if position ≤ last then result := result.insert {requested with first := position, last}\\n  return result.toArray\\n\\nstructure Feedback where\\n  graph : Graph := .empty\\n  delivered : Presentation := {}\\n  atStart : Std.HashMap Occurrence Presentation := {}\\n\\ndef Feedback.present (feedback : Feedback) (packet : Presentation) : Feedback :=\\n  {feedback with delivered := {\\n    ranges := feedback.delivered.ranges ++ packet.ranges\\n    uncertain := feedback.delivered.uncertain.union packet.uncertain\\n    bindings := feedback.delivered.bindings ++ packet.bindings\\n    addressed := feedback.delivered.addressed ++ packet.addressed\\n    uncertainOwners := feedback.delivered.uncertainOwners.union packet.uncertainOwners }}\\n\\n/-- A PreToolUse packet arriving after proposal cannot rewrite what was known. -/\\ndef Feedback.start (feedback : Feedback) (occurrence : Occurrence) : Feedback :=\\n  if feedback.atStart.contains occurrence then feedback else\\n    {feedback with atStart := feedback.atStart.insert occurrence feedback.delivered}\\n\\ndef Feedback.completedRead (feedback : Feedback) (occurrence : Occurrence) (query : String)\\n    (requested stored : Array Range) : Except String Feedback := do\\n  let some earlier := feedback.atStart[occurrence]? | throw \\\"read has no observed start\\\"\\n  let mut graph := feedback.graph\\n  let mut ordinal := 0\\n  for source in compactRanges requested do\\n    let checked := match source.subject with\\n      | .file file => !earlier.uncertain.contains file\\n      | .original _ => earlier.uncertainOwners.isEmpty\\n    let gaps := if checked then omittedRanges source stored earlier.ranges else #[]\\n    for gap in if gaps.isEmpty then #[source] else gaps do\\n      graph ← graph.recordRead ⟨occurrence, ordinal, none⟩ query gap stored earlier.ranges checked\\n      ordinal := ordinal+1\\n  return {feedback with graph}\\n\\ndef Feedback.answer (feedback : Feedback) (occurrence : Occurrence) (query text : String) :\\n    Except String Feedback := do\\n  let files := feedback.delivered.ranges.foldl (fun files range =>\\n    (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n  let cited := paragraphCitations text files.toArray\\n  let mut graph := feedback.graph\\n  for index in [:cited.size] do\\n    graph ← graph.recordCitation ⟨occurrence, index, none⟩ query cited[index]! feedback.delivered.ranges\\n  return {feedback with graph}\\n\\n/-- A native usage label may cover only an actual located consumption witness.\\nThe native row remains tied to its original Work and response digest. -/\\nstructure ConsumedSource (edge : Consumption) where\\n  source : Range\\n  valid : edge.valid = true\\n  native : source.file?.isNone = true\\n  consumed : edge.rows.any (·.contains source) = true\\n\\ndef consumedSource? (edge : Consumption) (source : Range) : Option (ConsumedSource edge) :=\\n  if valid : edge.valid = true then\\n    if native : source.file?.isNone = true then\\n      if consumed : edge.rows.any (·.contains source) = true then\\n        some ⟨source,valid,native,consumed⟩ else none\\n    else none\\n  else none\\n\\ntheorem consumed_source_has_witness (checked : ConsumedSource edge) :\\n    ∃ row ∈ edge.rows, row.contains checked.source = true := by\\n  obtain ⟨index,bound,present⟩ := Array.any_eq_true.mp checked.consumed\\n  exact ⟨edge.rows[index],by simp,present⟩\\n\\ntheorem consumed_source_is_later (checked : ConsumedSource edge) :\\n    edge.producerFinish < edge.consumerStart := by\\n  exact Consumption.checked_before (edge := edge) (accepted := edge)\\n    (by simp [Consumption.checked,checked.valid])\\n\\n/-- Literal reuse is advisory evidence, not proof of semantic necessity. The\\ncaller supplies immutable pre-read stored and ACK ranges; no returned sibling\\nfield is labelled merely because it was present in the tool's response. -/\\ndef consumedUsage? (checked : ConsumedSource edge) (query : String)\\n    (stored delivered : Array Range) : Option Usage :=\\n  if covered checked.source stored && !covered checked.source delivered then some {\\n    event := {occurrence := edge.producer,ordinal := 0,consumption := some ⟨edge.consumer,checked.source⟩}\\n    query,source := checked.source,kind := .omittedThenConsumed}\\n  else none\\n\\ntheorem consumed_omission_requires_stored (checked : ConsumedSource edge)\\n    (observed : consumedUsage? checked query stored delivered = some usage) :\\n    covered checked.source stored = true ∧ covered checked.source delivered = false := by\\n  unfold consumedUsage? at observed\\n  split at observed\\n  next present => simpa only [Bool.and_eq_true,Bool.not_eq_true'] using present\\n  next => contradiction\\n\\ndef recordConsumed (graph : Graph) (checked : ConsumedSource edge) (query : String)\\n    (stored delivered : Array Range) : Except String Graph :=\\n  match consumedUsage? checked query stored delivered with\\n  | some usage => graph.insert (.used usage)\\n  | none => .ok graph\\n\\nend Eggshell.Synapses.Extraction\\n\"],[\"SynapseIndex.lean\",\"module\\n\\npublic import Eggshell.GraphStore\\npublic import Eggshell.SynapseProvenance\\npublic import Eggshell.SynapticTopologyStore\\npublic import Eggshell.ObservedRecordView\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Index\\nopen Lean DB\\n\\n/-- The implementation key follows source bytes, never a hand-maintained version. -/\\ndef implementation : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.synaptic-index\\\".toUTF8 [\\n    (include_str \\\"SynapticTopology.lean\\\").toUTF8,(include_str \\\"SynapticTopologyStore.lean\\\").toUTF8,\\n    (include_str \\\"../tools/SpanPostings.lean\\\").toUTF8,\\n    (include_str \\\"Synapses.lean\\\").toUTF8, (include_str \\\"SynapseExtraction.lean\\\").toUTF8,\\n    (include_str \\\"SynapseSource.lean\\\").toUTF8, (include_str \\\"SynapseUsage.lean\\\").toUTF8,\\n    (include_str \\\"SynapseIndex.lean\\\").toUTF8, (include_str \\\"SynapseBuild.lean\\\").toUTF8,\\n    (include_str \\\"SynapseProvenance.lean\\\").toUTF8, (include_str \\\"ObservationAge.lean\\\").toUTF8,\\n    (include_str \\\"ContentCapture.lean\\\").toUTF8,(include_str \\\"ContentMetadata.lean\\\").toUTF8,\\n    (include_str \\\"../tools/ContentCorrespondence.lean\\\").toUTF8,\\n    (include_str \\\"JsonScalars.lean\\\").toUTF8,\\n    (include_str \\\"SynapseQuotes.lean\\\").toUTF8,\\n    (include_str \\\"ObservationContext.lean\\\").toUTF8,(include_str \\\"Sha256.lean\\\").toUTF8,\\n    (include_str \\\"QuotationContext.lean\\\").toUTF8,\\n    (include_str \\\"ObservedRecords.lean\\\").toUTF8,\\n    (include_str \\\"ObservedRecordView.lean\\\").toUTF8,\\n    (include_str \\\"../tools/LiteralSearch.lean\\\").toUTF8,\\n    (include_str \\\"SourceEvidence.lean\\\").toUTF8,\\n    (include_str \\\"SearchUnicode.lean\\\").toUTF8,\\n    (include_str \\\"../tools/RetrievalCategories.lean\\\").toUTF8])\\n\\ndef factName (fact : Fact) : String := \\\"fact:\\\" ++ contentKey fact\\n\\ndef postingPrefix (key : Key) : String := \\\"lookup:\\\" ++ contentKey key ++ \\\":\\\"\\n\\nstructure Posting where\\n  key : Key\\n  fact : String\\n  deriving BEq, ToJson, FromJson\\n\\ndef postingName (key : Key) (fact : Fact) : String := postingPrefix key ++ contentKey fact\\n\\ndef eventName (event : Event) : String := \\\"event:\\\" ++ contentKey event\\n\\ndef belongs (database : String) : Fact → Bool\\n  | .read recorded => recorded.binding.database == database\\n  | .supports support => support.claim.database == database && support.read.binding.database == database\\n  | .coquoted (.answer owner _) _ => owner == database\\n  | .coquoted (.claim claim) _ => claim.database == database\\n  | .consumed _ | .used _ => true\\n\\ndef checkDestination (storage : Sidecar.Storage) (scope : Scope) : IO Unit :=\\n  if scope == .usage && storage != .user then\\n    throw (IO.userError \\\"synaptic usage must stay in the private DB overlay\\\")\\n  else pure ()\\n\\nstructure Manifest where\\n  source : PageMap.Head\\n  implementation : String\\n  scope : Scope\\n  facts : Nat\\n  deriving BEq, ToJson, FromJson\\n\\ndef manifest? (snapshot : PageMap.Snapshot) : IO (Option Manifest) := do\\n  (← snapshot.get \\\"manifest\\\").mapM (decode (α := Manifest))\\n\\n/-- An old index is usable across derived-only commits, through exact parent heads.\\nThe lookup path examines at most the supplied number of journal entries. -/\\ndef sameSources (snapshot : PageMap.Snapshot) (saved : PageMap.Head) (limit : Nat := 16) : IO Bool := do\\n  if saved.identity != snapshot.head.identity || saved.authority != snapshot.head.authority then return false\\n  let mut current := snapshot.head\\n  for _ in [:limit] do\\n    if current == saved then return true\\n    if current.revision ≤ saved.revision then return false\\n    let publication ← Persistence.Store.readPublication snapshot current.revision\\n    if !publication.change.neutral then return false\\n    current := publication.parent\\n  return current == saved\\n\\ndef directory (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\\n    IO System.FilePath := do\\n  return (← Sidecar.locate snapshot storage).directory / \\\"synapses\\\" / scope.directory\\n\\ndef prepare (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\\n    IO PageMap.Snapshot := do\\n  if scope == .usage && storage != .user then\\n    throw (IO.userError \\\"synaptic usage must stay in the private DB overlay\\\")\\n  let sidecar ← Sidecar.prepare (Sidecar.Owner.ofSnapshot snapshot) storage\\n  let parent ← Sidecar.childDirectory sidecar.directory \\\"synapses\\\"\\n  let path := parent / scope.directory\\n  match ← PageMap.open? path with\\n  | some snapshot => return snapshot\\n  | none => PageMap.create path (\\\"advisory:\\\" ++ snapshot.head.identity ++ \\\":\\\" ++ scope.directory)\\n\\nstructure Reader where\\n  index : PageMap.Snapshot\\n  manifest : Manifest\\n\\n/-- Opening never creates an index or prepares a directory inside a shared DB. -/\\ndef open? (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) : IO (Option Reader) := do\\n  if scope == .usage && storage != .user then return none\\n  let path ← directory source storage scope\\n  let some index ← PageMap.open? path | return none\\n  let some metadata ← manifest? index | return none\\n  unless metadata.implementation == implementation && metadata.scope == scope do return none\\n  if scope == .shared then\\n    unless (← index.get \\\"provenance\\\") == some (toJson (← Provenance.stamp source)).compress.toUTF8 do return none\\n    unless ← sameSources source metadata.source do return none\\n  else\\n    unless metadata.source.identity == source.head.identity &&\\n        metadata.source.authority == source.head.authority do return none\\n  return some ⟨index, metadata⟩\\n\\ndef openShared? (source : PageMap.Snapshot) : IO (Option Reader) := do\\n  if let some reader ← open? source .database .shared then return some reader\\n  open? source .user .shared\\n\\ndef putImmutable (writer : PageMap.Writer) (name : String) (bytes : ByteArray) : IO Bool := do\\n  if let some previous ← writer.get name then\\n    unless previous == bytes do throw (IO.userError \\\"conflicting synaptic content address\\\")\\n    return false\\n  writer.put name (some bytes)\\n  return true\\n\\ndef insert (writer : PageMap.Writer) (database : String) (scope : Scope) (fact : Fact) : IO Bool := do\\n  unless scope.accepts fact && belongs database fact && fact.valid do\\n    throw (IO.userError \\\"invalid fact or wrong synaptic privacy/DB scope\\\")\\n  if let .used usage := fact then\\n    let _ ← putImmutable writer (eventName usage.event) (← checkedBytes usage)\\n  let inserted ← putImmutable writer (factName fact) (← checkedBytes fact)\\n  Routing.Store.insert writer fact\\n  for key in addresses fact do\\n    let posting : Posting := ⟨key, contentKey fact⟩\\n    let _ ← putImmutable writer (postingName key fact) (← checkedBytes posting)\\n  return inserted\\n\\ndef erase (writer : PageMap.Writer) (fact : Fact) : IO Bool := do\\n  let name := factName fact\\n  let some previous ← writer.get name | return false\\n  unless previous == (toJson fact).compress.toUTF8 do\\n    throw (IO.userError \\\"retired synaptic object differs from its content address\\\")\\n  Routing.Store.erase writer fact\\n  writer.put name none\\n  for key in addresses fact do writer.put (postingName key fact) none\\n  -- Retiring a recommendation does not permit relabelling an observed event.\\n  -- The small immutable witness remains until its owning DB cache is retired.\\n  return true\\n\\nstructure Delta where\\n  removed : Array Fact := #[]\\n  added : Array Fact := #[]\\n\\ndef checkFacts (database : String) (scope : Scope) (facts : Array Fact) : IO Unit :=\\n  unless facts.all (fun fact => scope.accepts fact && belongs database fact && fact.valid) do\\n    throw (IO.userError \\\"invalid fact or wrong synaptic privacy/DB scope\\\")\\n\\n/-- One metadata publication commits facts and all inverse postings together.\\nAn incompatible prior implementation needs a full replacement, never reuse. -/\\ndef publishDelta (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\\n    (expected : Option PageMap.Head) (delta : Delta)\\n    (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\\n  checkDestination storage scope\\n  checkFacts source.head.identity scope delta.added\\n  checkFacts source.head.identity scope delta.removed\\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\\n    let index ← prepare source storage scope\\n    let previous ← manifest? index\\n    if let some previous := previous then\\n      if scope == .shared && previous.source.revision > source.head.revision then\\n        throw (IO.userError \\\"older source cannot replace a later synaptic publication\\\")\\n      unless previous.source == expected.getD source.head && previous.implementation == implementation &&\\n          previous.scope == scope do throw (IO.userError \\\"stale synaptic index update\\\")\\n    else if expected.isSome then throw (IO.userError \\\"missing synaptic index update base\\\")\\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\\n      let mut count := previous.map (·.facts) |>.getD 0\\n      for fact in delta.removed do\\n        if ← erase writer fact then count := count-1\\n      for fact in delta.added do\\n        if ← insert writer source.head.identity scope fact then count := count+1\\n      prepareRecords writer\\n      let next : Manifest := ⟨source.head, implementation, scope, count⟩\\n      Routing.Store.finish writer count\\n      let bytes ← checkedBytes next\\n      if (← writer.get \\\"manifest\\\") != some bytes then writer.put \\\"manifest\\\" (some bytes)\\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\\n      if (← writer.get \\\"provenance\\\") != some provenance then writer.put \\\"provenance\\\" (some provenance)\\n    return head) storage\\n\\ndef allFacts (index : PageMap.Snapshot) : IO (Array Fact) :=\\n  index.foldRange ⟨\\\"fact:\\\", \\\"fact;\\\"⟩ (fun facts row => do\\n    let some bytes := row.2 | return facts\\n    let fact ← decode (α := Fact) bytes\\n    unless row.1 == factName fact && fact.valid do throw (IO.userError \\\"foreign synaptic fact row\\\")\\n    return facts.push fact) #[]\\n\\n/-- Explicit warm/background replacement; it never runs in a search hook. -/\\ndef replace (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\\n    (facts : Array Fact) (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\\n  checkDestination storage scope\\n  checkFacts source.head.identity scope facts\\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\\n    let index ← prepare source storage scope\\n    if let some previous ← manifest? index then\\n      if scope == .shared && previous.source.revision > source.head.revision then\\n        throw (IO.userError \\\"older source cannot replace a later synaptic publication\\\")\\n    let wanted := facts.foldl (fun wanted fact => wanted.insert (factName fact)) ({} : Std.HashSet String)\\n    let old ← allFacts index\\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\\n      for fact in old do\\n        if !wanted.contains (factName fact) then let _ ← erase writer fact; pure ()\\n      for fact in facts do let _ ← insert writer source.head.identity scope fact; pure ()\\n      prepareRecords writer\\n      let next : Manifest := ⟨source.head, implementation, scope, wanted.size⟩\\n      Routing.Store.finish writer wanted.size\\n      let bytes ← checkedBytes next\\n      if (← writer.get \\\"manifest\\\") != some bytes then writer.put \\\"manifest\\\" (some bytes)\\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\\n      if (← writer.get \\\"provenance\\\") != some provenance then writer.put \\\"provenance\\\" (some provenance)\\n    return head) storage\\n\\nstructure Scan where\\n  postings : Array Posting := #[]\\n  inspected : Nat := 0\\n  pages : Nat := 0\\n  complete : Bool := true\\n\\n/-- Stop in the tree, rather than materializing or traversing all postings. -/\\ndef scanAt (index : PageMap.Snapshot) (ref : PageMap.Ref) (range : PageMap.KeyRange)\\n    (limit deadline : Nat) (initial : Scan) : IO Scan := do\\n  if !initial.complete then return initial\\n  if initial.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {initial with complete := false}\\n  let loaded ← index.load ref\\n  let mut result := {initial with pages := initial.pages+1}\\n  match loaded.page with\\n  | .leaf rows =>\\n    for row in range.select rows do\\n      if result.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\\n      let some bytes := row.2 | continue\\n      let posting ← decode (α := Posting) bytes\\n      unless row.1 == postingPrefix posting.key ++ posting.fact do throw (IO.userError \\\"foreign synaptic posting\\\")\\n      result := {result with postings := result.postings.push posting, inspected := result.inspected+1}\\n    return result\\n  | .branch children =>\\n    for child in children do\\n      if range.overlaps child then\\n        if _smaller : child.height < ref.height then\\n          result ← scanAt index child range limit deadline result\\n        else throw (IO.userError \\\"synaptic index height did not decrease\\\")\\n        if !result.complete then return result\\n    return result\\ntermination_by ref.height\\n\\n/-- This certifies the advisory inverse relation, not Work or completion authority. -/\\nstructure CheckedFact (key : Key) where\\n  fact : Fact\\n  valid : fact.valid = true\\n  bound : key ∈ addresses fact\\n\\ndef CheckedFact.check? (key : Key) (fact : Fact) : Option (CheckedFact key) :=\\n  if valid : fact.valid = true then\\n    if bound : (addresses fact).contains key = true then\\n      some ⟨fact, valid, Array.mem_of_contains_eq_true bound⟩\\n    else none\\n  else none\\n\\nstructure Lookup (key : Key) where\\n  checked : Array (CheckedFact key)\\n  complete : Bool\\n  postingPages : Nat\\n  index : PageMap.Head\\n  payloadBytes : Nat := 0\\n\\ndef Lookup.facts (lookup : Lookup key) : Array Fact := lookup.checked.map (·.fact)\\n\\ntheorem Lookup.returned_bound (lookup : Lookup key) (fact : Fact)\\n    (present : fact ∈ lookup.facts) :\\n    fact.valid = true ∧ key ∈ addresses fact := by\\n  simp only [Lookup.facts, Array.mem_map] at present\\n  obtain ⟨checked, _, equal⟩ := present\\n  subst fact\\n  exact ⟨checked.valid, checked.bound⟩\\n\\ndef Reader.lookup (reader : Reader) (key : Key) (limit deadline : Nat)\\n    (byteLimit : Option Nat := none) : IO (Lookup key) := do\\n  let name := postingPrefix key\\n  let scanned ← match reader.index.head.root with\\n    | none => pure ({} : Scan)\\n    | some root => scanAt reader.index root ⟨name, \\\"lookup:\\\" ++ contentKey key ++ \\\";\\\"⟩ limit deadline {}\\n  let mut facts := #[]\\n  let mut complete := scanned.complete\\n  let mut payloadBytes := 0\\n  for posting in scanned.postings do\\n    if (← IO.monoMsNow) ≥ deadline then\\n      complete := false\\n      break\\n    unless posting.key == key do throw (IO.userError \\\"ambiguous synaptic key digest\\\")\\n    let some bytes ← reader.index.get (\\\"fact:\\\" ++ posting.fact) |\\n      throw (IO.userError \\\"dangling synaptic posting\\\")\\n    if byteLimit.any (payloadBytes+bytes.size > ·) then\\n      complete := false\\n      break\\n    let fact ← decode (α := Fact) bytes\\n    unless fact.valid && reader.manifest.scope.accepts fact && belongs reader.manifest.source.identity fact &&\\n        contentKey fact == posting.fact && (addresses fact).contains key do\\n      throw (IO.userError \\\"synaptic posting does not bind its original fact\\\")\\n    let some checked := CheckedFact.check? key fact |\\n      throw (IO.userError \\\"unbound advisory index result\\\")\\n    facts := facts.push checked\\n    payloadBytes := payloadBytes+bytes.size\\n  return ⟨facts, complete, scanned.pages, reader.index.head, payloadBytes⟩\\n\\nend Eggshell.Synapses.Index\\n\"],[\"SynapseBuild.lean\",\"module\\n\\npublic import Eggshell.SynapseIndex\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Build\\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\\n\\n/-- This adapter reads a pinned native publication. No export, tool execution,\\nor model is involved; unsupported observations remain unlocated. -/\\ndef identities (edge : OutcomeEdge) : Array Occurrence := Provenance.identities edge\\n\\ndef document (reader : NodeReader snapshot) (id : Nat) : IO Document := Provenance.document reader id\\n\\nstructure Entry where\\n  id : Nat\\n  work : Nat\\n\\n/-- The candidate directory supplies headers only, not window lists or bodies. -/\\ndef entries (snapshot : PageMap.Snapshot) : IO (Array Entry) := do\\n  let mut result := #[]\\n  for (ordinal, id) in ← directory snapshot \\\"searchCandidate\\\" do\\n    let located ← locateOutcome snapshot id\\n    unless (← getNat snapshot.get (key \\\"member\\\" id)) == ordinal &&\\n        (← getNat snapshot.get (key \\\"candidate\\\" id)) == 1 do\\n      throw (IO.userError \\\"synaptic candidate is not a live original owner\\\")\\n    result := result.push ⟨id, located.header.work⟩\\n  return result\\n\\ndef topology (snapshot : PageMap.Snapshot) : IO (Std.HashMap Nat (Array Nat)) := do\\n  let mut result := {}\\n  for header in ← allHeaders snapshot do\\n    result := result.insert header.2.header.parent\\n      (result[header.2.header.parent]?.getD #[] ++ header.2.header.children.toArray)\\n  return result\\n\\ndef closure (edges : Std.HashMap Nat (Array Nat)) (roots : Array Nat) : Std.HashSet Nat := Id.run do\\n  let mut seen := {}\\n  let mut queue := roots\\n  let mut position := 0\\n  while position < queue.size do\\n    let current := queue[position]!\\n    position := position + 1\\n    if seen.contains current then continue\\n    seen := seen.insert current\\n    queue := queue ++ edges[current]?.getD #[]\\n  return seen\\n\\ndef reverse (edges : Std.HashMap Nat (Array Nat)) : Std.HashMap Nat (Array Nat) :=\\n  edges.fold (fun result parent children => children.foldl\\n    (fun result child => result.insert child (result[child]?.getD #[] |>.push parent)) result) {}\\n\\nstructure Changes where\\n  owners : Std.HashSet Nat := {}\\n  works : Std.HashSet Nat := {}\\n  removed : Bool := false\\n\\n/-- Follow exact parent heads, not revision counters. A non-ancestor cache\\nrequires an explicit rebuild rather than a fabricated incremental update. -/\\ndef changes (snapshot : PageMap.Snapshot) (saved : PageMap.Head) : IO (Option Changes) := do\\n  if saved.identity != snapshot.head.identity || saved.authority != snapshot.head.authority then return none\\n  let mut current := snapshot.head\\n  let mut result : Changes := {}\\n  while current != saved do\\n    if current.revision ≤ saved.revision then return none\\n    let publication ← readPublication snapshot current.revision\\n    result := {result with removed := result.removed || !publication.change.removed.isEmpty}\\n    for id in publication.change.added ++ publication.change.removed ++ publication.change.affected do\\n      let frame ← readFrame snapshot snapshot.get id\\n      if let some header := OutcomeHeader.fromFrame? frame then\\n        result := {result with owners := result.owners.insert id, works := result.works.insert header.work}\\n      if let some header := AllHeader.fromFrame? frame then\\n        result := {result with works := result.works.insert header.parent}\\n      if let .apply .receipt references := frame.frame then\\n        if let some fields := SourceEvidence.receiptFields? references then\\n          if (← readNode snapshot snapshot.get fields.marker) == .text SourceEvidence.receiptMarker &&\\n              (← readNode snapshot snapshot.get fields.purpose) == .text SourceEvidence.receiptPurpose then\\n            let some owner := OutcomeHeader.fromFrame? (← readFrame snapshot snapshot.get fields.owner) |\\n              throw (IO.userError \\\"source receipt does not refer to an original Outcome frame\\\")\\n            result := {result with\\n              owners := result.owners.insert fields.owner\\n              works := result.works.insert owner.work}\\n    current := publication.parent\\n  return some result\\n\\ndef retain (readOwners answers : Std.HashSet String) (keepConsumption : Bool) : Fact → Bool\\n  | .read read => !readOwners.contains read.binding.owner\\n  | .supports support => !readOwners.contains support.read.binding.owner && !answers.contains support.claim.answer\\n  | .coquoted (.answer _ answer) _ => !answers.contains answer\\n  | .coquoted (.claim claim) _ => !answers.contains claim.answer\\n  | .consumed _ => keepConsumption\\n  | .used _ => false\\n\\ntheorem retained_support_independent (reads answers : Std.HashSet String) (keep : Bool) (support : Support)\\n    (retained : retain reads answers keep (.supports support) = true) :\\n    reads.contains support.read.binding.owner = false ∧ answers.contains support.claim.answer = false := by\\n  simpa [retain, Bool.and_eq_true] using retained\\n\\ntheorem usage_never_enters_shared_rebuild (reads answers : Std.HashSet String) (keep : Bool) (usage : Usage) :\\n    retain reads answers keep (.used usage) = false := rfl\\n\\nstructure Result where\\n  mode : String\\n  source : PageMap.Head\\n  index : PageMap.Head\\n  candidates : Nat := 0\\n  hydrated : Nat := 0\\n  consumptionRebuilt : Bool := false\\n  provenanceOriginals : Nat := 0\\n  provenanceIgnored : Nat := 0\\n  answers : Nat := 0\\n  unsupported : Nat := 0\\n  facts : Nat := 0\\n  elapsedMs : Nat := 0\\n  deriving ToJson\\n\\nstructure Documents (snapshot : PageMap.Snapshot) where\\n  reader : NodeReader snapshot\\n  cache : IO.Ref (Std.HashMap Nat Document)\\n  catalogs : IO.Ref (Std.HashMap Nat ObservationContext.Catalog)\\n\\ndef Documents.get (documents : Documents snapshot) (id : Nat) : IO Document := do\\n  if let some doc := (← documents.cache.get)[id]? then return doc\\n  let doc ← document documents.reader id\\n  documents.cache.modify (·.insert id doc)\\n  return doc\\n\\ndef Documents.catalog (documents : Documents snapshot) (id : Nat) : IO ObservationContext.Catalog := do\\n  if let some catalog := (← documents.catalogs.get)[id]? then return catalog\\n  let doc ← documents.get id\\n  let original ← match ← ObservedRecords.load? snapshot id doc with\\n    | some catalog => pure catalog\\n    | none => do\\n        let some raw := doc.source | throw (IO.userError \\\"original record body is missing\\\")\\n        let prepared ← IO.ofExcept (ObservedRecords.prepare raw)\\n        IO.ofExcept (ObservedRecords.catalog snapshot.head.identity doc prepared.records)\\n  -- File aliases are additional coordinates, never the original domain gate.\\n  let files := (recordedReads snapshot.head.identity doc).toOption.getD #[]\\n  let captured ← match ← ContentMetadata.load? snapshot id doc with\\n    | none => pure ({} : ObservationContext.Catalog)\\n    | some captured => IO.ofExcept (ContentMetadata.catalog snapshot.head.identity doc captured)\\n  let catalog := {original with\\n    located := files ++ captured.located ++ original.located\\n    quotations := captured.quotations ++ original.quotations}\\n  documents.catalogs.modify (·.insert id catalog)\\n  return catalog\\n\\ndef ownerId? (snapshot : PageMap.Snapshot) (owner : String) : IO (Option Nat) := do\\n  let some checked := Persistence.SelectionKey.check? owner |\\n    throw (IO.userError \\\"noncanonical synaptic owner locator\\\")\\n  let ids ← getIds snapshot.get (\\\"owner:\\\" ++ toString checked.digest)\\n  let live ← ids.filterM fun id => return (← snapshot.get (key \\\"member\\\" id)).isSome\\n  match live with\\n  | [] => return none\\n  | [id] => return some id\\n  | _ => throw (IO.userError \\\"ambiguous synaptic owner locator\\\")\\n\\n/-- Scheduling probe only: bounded metadata reads and no directory creation. -/\\ndef required (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Bool := do\\n  return (← Index.open? snapshot storage .shared).isNone\\n\\n/-- The background extractor keeps only metadata between publications. A new\\nanswer hydrates its cited original reads, never every unrelated source body. -/\\ndef refresh (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Result := do\\n  let started ← IO.monoMsNow\\n  if let some ready ← Index.open? snapshot storage .shared then\\n    return {\\n      mode := \\\"warm\\\", source := snapshot.head, index := ready.index.head\\n      facts := ready.manifest.facts, elapsedMs := (← IO.monoMsNow) - started}\\n  let path ← Index.directory snapshot storage .shared\\n  let previous ← PageMap.open? path\\n  let metadata ← previous.bindM Index.manifest?\\n  let compatible := metadata.filter fun value => value.implementation == Index.implementation && value.scope == .shared\\n  let delta ← compatible.bindM fun value => changes snapshot value.source\\n  let incremental := delta.isSome\\n  let previousFacts ← if incremental then previous.mapM Index.allFacts else pure none\\n  let old := previousFacts.getD #[]\\n  Index.checkFacts snapshot.head.identity .shared old\\n  let catalog ← entries snapshot\\n  let all ← topology snapshot\\n  let changed := delta.getD {}\\n  let affectedWorks := closure (reverse all) changed.works.toArray\\n  let documents : Documents snapshot := ⟨← NodeReader.new snapshot, ← IO.mkRef {}, ← IO.mkRef {}⟩\\n  let mut readOwners := #[]\\n  let mut answerOwners := #[]\\n  let mut retiredReads : Std.HashSet String := {}\\n  let mut retiredAnswers : Std.HashSet String := {}\\n  let mut unsupported := 0\\n  for entry in catalog do\\n    if !incremental || changed.owners.contains entry.id || affectedWorks.contains entry.work then\\n      let doc ← documents.get entry.id\\n      if doc.native then\\n        if !incremental || changed.owners.contains entry.id then readOwners := readOwners.push entry\\n      else\\n        answerOwners := answerOwners.push entry\\n        retiredAnswers := retiredAnswers.insert doc.owner\\n  -- Retired original owners are absent from the current candidate directory.\\n  for id in changed.owners do\\n    let value ← readNode snapshot snapshot.get id\\n    retiredReads := retiredReads.insert (Persistence.selectionKey value)\\n    retiredAnswers := retiredAnswers.insert (Persistence.selectionKey value)\\n  -- A source retraction also invalidates its former answer/coquotation groups.\\n  for fact in old do\\n    if let .supports support := fact then\\n      if retiredReads.contains support.read.binding.owner then\\n        retiredAnswers := retiredAnswers.insert support.claim.answer\\n  for answer in retiredAnswers do\\n    if let some id ← ownerId? snapshot answer then\\n      if !answerOwners.any (·.id == id) && catalog.any (·.id == id) then\\n        let doc ← documents.get id\\n        if !doc.native then\\n          let entry := catalog.find? (·.id == id)\\n          if let some entry := entry then answerOwners := answerOwners.push entry\\n  let stamp := (toJson (← Provenance.stamp snapshot)).compress.toUTF8\\n  let previousStamp ← previous.bindM (·.get \\\"provenance\\\")\\n  -- A new answer does not change previously observed call order or row\\n  -- projections. Reuse those facts only if their origin stamp and source\\n  -- metadata are unchanged; otherwise replay from the pinned originals.\\n  let keepConsumption := incremental && readOwners.isEmpty && !changed.removed && previousStamp == some stamp\\n  let mut graph ← IO.ofExcept (Graph.ofFacts (old.filter (retain retiredReads retiredAnswers keepConsumption)))\\n  for entry in readOwners do\\n    let catalog ← documents.catalog entry.id\\n    if catalog.located.isEmpty then unsupported := unsupported+1\\n    for read in catalog.reads do graph ← IO.ofExcept (graph.insert (.read read))\\n  let reads := graph.snapshot.filterMap fun fact => match fact with | .read read => some read | _ => none\\n  let mut workIds : Std.HashMap String Nat := {}\\n  for entry in catalog do\\n    if let some doc := (← documents.cache.get)[entry.id]? then workIds := workIds.insert doc.work entry.work\\n  -- Resolve only recorded read owners whose metadata was reused.\\n  let mut readIds : Std.HashMap String Nat := {}\\n  for read in reads do\\n    if readIds.contains read.binding.owner then continue\\n    if let some id ← ownerId? snapshot read.binding.owner then\\n      let located ← locateOutcome snapshot id\\n      workIds := workIds.insert read.binding.work located.header.work\\n      readIds := readIds.insert read.binding.owner id\\n  for entry in answerOwners do\\n    let doc ← documents.get entry.id\\n    let route := closure all #[entry.work]\\n    let available := reads.filter fun read => (workIds[read.binding.work]?).any route.contains\\n    let files := available.foldl (fun files read =>\\n      (read.source.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n    let citations := ((layout (doc.source.getD \\\"\\\")).map fun decoded =>\\n      paragraphCitations decoded.text files.toArray).toOption.getD #[]\\n    let needed := available.filter fun read => citations.any (fun cited =>\\n      (cited.intersection? read.source).isSome)\\n    let quoteTexts := ((layout (doc.source.getD \\\"\\\")).map fun decoded =>\\n      decoded.text.splitOn \\\"\\\\n\\\\n\\\" |>.toArray.flatMap (fun paragraph =>\\n        (Quotes.extract paragraph).map (·.text))).toOption.getD #[]\\n    let quoteTexts := hashDistinct quoteTexts.toList |>.toArray\\n    let index := LiteralSearch.prepare quoteTexts\\n    let allowed := available.foldl (fun (set : Std.HashSet Read) read => set.insert read) {}\\n    let mut spellings := #[]\\n    let mut quoteOwners : Std.HashSet Nat := {}\\n    if !quoteTexts.isEmpty then\\n      for read in available do\\n        let some id := readIds[read.binding.owner]? | continue\\n        if quoteOwners.contains id then continue\\n        quoteOwners := quoteOwners.insert id\\n        let catalog ← documents.catalog id\\n        spellings := spellings ++ ObservationContext.quoteMatches index\\n          (catalog.quotations.filter (fun item => allowed.contains item.read))\\n    let mut located := #[]\\n    let mut seen : Std.HashSet Nat := {}\\n    for read in needed ++ spellings.map (·.read) do\\n      let some id := readIds[read.binding.owner]? | continue\\n      if seen.contains id then continue\\n      seen := seen.insert id\\n      let catalog ← documents.catalog id\\n      located := located ++ catalog.located\\n    match addAnswer snapshot.head.identity doc located graph with\\n    | .ok next => graph := next\\n    | .error _ => unsupported := unsupported + 1\\n    match ObservationContext.addQuotedAnswer snapshot.head.identity doc spellings graph with\\n    | .ok next => graph := next\\n    | .error _ => unsupported := unsupported + 1\\n  let portable ← if keepConsumption then pure ({} : Provenance.Derived) else Provenance.derive snapshot\\n  graph ← IO.ofExcept (graph.merge portable.graph)\\n  let facts := graph.snapshot\\n  -- The same changed-owner feed and the same atomic index publication own\\n  -- the immutable original read view. Queries never normalize these bodies.\\n  let prepareRecords := fun writer : PageMap.Writer => do\\n    if !incremental then\\n      let pinned ← writer.snapshot\\n      let prior ← pinned.foldRange ⟨\\\"observed-view:owner:\\\",\\\"observed-view:owner;\\\"⟩\\n        (fun keys row => pure (keys.push row.1)) (#[] : Array String)\\n      for key in prior do writer.put key none\\n    for owner in retiredReads do writer.put (ObservedRecordView.ownerKey owner) none\\n    for entry in readOwners do\\n      ObservedRecordView.stage writer snapshot.head.identity (← documents.get entry.id)\\n  let head ← if incremental then\\n      let wanted := graph.facts\\n      let previous := old.foldl (fun set fact => set.insert fact) ({} : Std.HashSet Fact)\\n      Index.publishDelta snapshot storage .shared (metadata.map (·.source)) {\\n        removed := old.filter (!wanted.contains ·)\\n        added := facts.filter (!previous.contains ·) } prepareRecords\\n    else Index.replace snapshot storage .shared facts prepareRecords\\n  return {\\n    mode := if incremental then \\\"incremental\\\" else \\\"rebuild\\\", source := snapshot.head, index := head\\n    candidates := catalog.size, hydrated := (← documents.cache.get).size, answers := answerOwners.size,\\n    consumptionRebuilt := !keepConsumption,provenanceOriginals := portable.originals,provenanceIgnored := portable.ignored,\\n    unsupported, facts := facts.size, elapsedMs := (← IO.monoMsNow) - started}\\n\\nend Eggshell.Synapses.Build\\n\"],[\"SynapseProvenance.lean\",\"module\\n\\npublic import Eggshell.GraphStore\\npublic import Eggshell.ObservationContext\\npublic import Eggshell.ObservedRecords\\npublic import Eggshell.ContentMetadata\\npublic import Eggshell.ObservationAge\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Provenance\\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\\n\\n/-- Native observation identity, with semantic positions checked independently\\nof the Exact session/turn/tool identifiers. -/\\ndef identities (edge : OutcomeEdge) : Array Occurrence :=\\n  edge.observations.toArray.filterMap fun observation => do\\n    let .apply .occurrence references := observation | none\\n    let [(.semantic, result), (.semantic, work), (.exact, session),\\n        (.exact, turn), (.exact, useId)] := references.toList | none\\n    if result != edge.outcome || work != edge.work then none else\\n      some ⟨← text? session, ← text? turn, ← text? useId⟩\\n\\ndef document (reader : NodeReader snapshot) (id : Nat) : IO Document := do\\n  let edge ← reader.outcome (← reader.locateOutcome id)\\n  let owner := Persistence.selectionKey edge.relation\\n  let candidates ← getIds snapshot.get (\\\"owner:\\\" ++ toString (hash edge.relation).toNat)\\n  let live ← candidates.filterM fun id => return (← snapshot.get (key \\\"member\\\" id)).isSome\\n  unless live == [id] do throw (IO.userError \\\"ambiguous synaptic source owner\\\")\\n  return {\\n    owner, work := Persistence.selectionKey edge.work\\n    workText := text? edge.work, source := text? edge.outcome\\n    native := edge.observations.any (Relation.observesOutcomeWork edge.outcome edge.work)\\n    occurrences := identities edge\\n    files := ← IO.ofExcept (fileMap ((← reader.sources id).toArray.map toJson)) }\\n\\n/-- Query-free provenance. The body stays in its original native Outcome. -/\\nstructure Origin where\\n  owner : Nat\\n  occurrence : Occurrence\\n  domain : String\\n  started : Nat\\n  finished : Nat\\n  receivedUnixMs : Option Nat := none\\n  deriving BEq, FromJson\\n\\n/-- Absence stays absent, including in original records without a wall clock. -/\\ninstance : ToJson Origin where\\n  toJson origin := Json.mkObj ([\\n    (\\\"owner\\\", toJson origin.owner), (\\\"occurrence\\\", toJson origin.occurrence),\\n    (\\\"domain\\\", toJson origin.domain), (\\\"started\\\", toJson origin.started),\\n    (\\\"finished\\\", toJson origin.finished)] ++\\n    origin.receivedUnixMs.toList.map (fun time => (\\\"receivedUnixMs\\\", toJson time)))\\n\\ndef Origin.valid (origin : Origin) : Bool :=\\n  origin.occurrence.valid && digest origin.domain && origin.started < origin.finished\\n\\nstructure Checked where\\n  origin : Origin\\n  valid : origin.valid = true\\n\\ndef Origin.check? (origin : Origin) : Option Checked :=\\n  if valid : origin.valid = true then some ⟨origin, valid⟩ else none\\n\\ntheorem Checked.time_order (checked : Checked) : checked.origin.started < checked.origin.finished := by\\n  have := checked.valid\\n  simp only [Origin.valid, Bool.and_eq_true, decide_eq_true_eq] at this\\n  exact this.2\\n\\ndef originPrefix : String := \\\"memo:synaptic-origin:\\\"\\ndef stateKey : String := \\\"memo:synaptic-state\\\"\\n\\ndef contentKey [ToJson α] (value : α) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.synaptic-provenance\\\".toUTF8 [(toJson value).compress.toUTF8])\\n\\ndef name (occurrence : Occurrence) : String := originPrefix ++ contentKey occurrence\\n\\ndef originRow (occurrence : Occurrence) (encoded : ByteArray) : PageMap.Row :=\\n  (name occurrence, some encoded)\\n\\ndef stateRow (encoded : ByteArray) : PageMap.Row := (stateKey, some encoded)\\n\\n/-- The actual metadata row constructors preserve all graph and authority\\nkeys. The publication journal is managed separately by the checked writer. -/\\ntheorem metadata_preserves_authority (occurrence : Occurrence) (encoded root : ByteArray)\\n    (before : String → Option ByteArray) (key : String) (outside : PageMap.derivedKey key = false) :\\n    PageMap.applyRows [originRow occurrence encoded, stateRow root] before key = before key := by\\n  apply PageMap.derived_rows_preserve _ _ _ key outside\\n  simp [originRow, stateRow, name, originPrefix, stateKey, PageMap.derivedKey]\\n\\nstructure State where\\n  count : Nat := 0\\n  digest : String := contentKey (\\\"empty\\\" : String)\\n  deriving BEq, ToJson, FromJson\\n\\nstructure Stored where\\n  ordinal : Nat\\n  previous : String\\n  origin : Origin\\n  deriving BEq, ToJson, FromJson\\n\\ndef bytes [ToJson α] (value : α) : IO ByteArray := do\\n  let encoded := (toJson value).compress.toUTF8\\n  unless encoded.size ≤ 65536 do throw (IO.userError \\\"synaptic provenance exceeds its metadata bound\\\")\\n  return encoded\\n\\ndef decode [ToJson α] [FromJson α] (encoded : ByteArray) : IO α := do\\n  unless encoded.size ≤ 65536 do throw (IO.userError \\\"synaptic provenance exceeds its metadata bound\\\")\\n  let some text := String.fromUTF8? encoded | throw (IO.userError \\\"invalid provenance UTF-8\\\")\\n  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))\\n  unless (toJson value).compress.toUTF8 == encoded do throw (IO.userError \\\"noncanonical synaptic provenance\\\")\\n  return value\\n\\ndef state (source : PageMap.Snapshot) : IO State := do\\n  let result ← match ← source.get stateKey with\\n    | none => pure ({} : State)\\n    | some encoded => decode encoded\\n  unless Synapses.digest result.digest do throw (IO.userError \\\"invalid synaptic provenance root\\\")\\n  return result\\n\\ndef stamp (source : PageMap.Snapshot) : IO String := do\\n  return contentKey (← state source)\\n\\ndef records (source : PageMap.Snapshot) : IO (Array Stored) := do\\n  let values ← source.foldRange ⟨originPrefix, \\\"memo:synaptic-origin;\\\"⟩ (fun values row => do\\n    let some encoded := row.2 | return values\\n    let value ← decode (α := Stored) encoded\\n    unless row.1 == name value.origin.occurrence && value.origin.valid do\\n      throw (IO.userError \\\"provenance record is not bound to its original identity\\\")\\n    return values.push value) #[]\\n  let values := values.qsort (fun a b => a.ordinal < b.ordinal)\\n  let mut previous : State := {}\\n  for value in values do\\n    unless value.ordinal == previous.count && value.previous == previous.digest do\\n      throw (IO.userError \\\"incomplete or reordered provenance chain\\\")\\n    previous := ⟨previous.count+1, contentKey value⟩\\n  unless previous == (← state source) do throw (IO.userError \\\"provenance records disagree with their published root\\\")\\n  return values\\n\\ndef checkedDocument (reader : NodeReader source) (origin : Origin) : IO Document := do\\n  unless origin.valid do throw (IO.userError \\\"invalid native provenance interval\\\")\\n  let doc ← document reader origin.owner\\n  unless doc.native && doc.occurrences.contains origin.occurrence do\\n    throw (IO.userError \\\"provenance does not belong to its original native observation\\\")\\n  return doc\\n\\n/-- A single immutable metadata lookup against a pinned source, not a scan of\\nthe origin log. The caller's native owner and occurrence must both agree. -/\\ndef lookup? (source : PageMap.Snapshot) (owner : OutcomeEdge)\\n    (occurrence : Occurrence) : IO (Option Origin) := do\\n  unless (identities owner).contains occurrence do return none\\n  let some encoded ← source.get (name occurrence) | return none\\n  let stored ← decode (α := Stored) encoded\\n  unless stored.origin.valid && stored.origin.occurrence == occurrence &&\\n      stored.ordinal < (← state source).count do\\n    throw (IO.userError \\\"invalid native observation metadata\\\")\\n  unless (← findNode? source owner.relation) == some stored.origin.owner &&\\n      (← source.get (key \\\"member\\\" stored.origin.owner)).isSome do\\n    throw (IO.userError \\\"native observation metadata has another owner\\\")\\n  return some stored.origin\\n\\n/-- One checked native observation, still bound to its complete original edge. -/\\nstructure Binding where\\n  edge : OutcomeEdge\\n  checked : Checked\\n  observed : (identities edge).contains checked.origin.occurrence = true\\n\\ndef Binding.check? (edge : OutcomeEdge) (origin : Origin) : Option Binding := do\\n  let checked ← origin.check?\\n  if observed : (identities edge).contains checked.origin.occurrence = true then\\n    some ⟨edge,checked,observed⟩ else none\\n\\ntheorem binding_has_observed_interval (binding : Binding) :\\n    binding.checked.origin.valid = true ∧\\n      (identities binding.edge).contains binding.checked.origin.occurrence = true :=\\n  ⟨binding.checked.valid,binding.observed⟩\\n\\ndef appendRows (writer : PageMap.Writer) (origins : Array Origin) : IO Bool := do\\n  let initial ← match ← writer.get stateKey with\\n    | none => pure ({} : State)\\n    | some encoded => decode encoded\\n  unless Synapses.digest initial.digest do throw (IO.userError \\\"invalid synaptic provenance root\\\")\\n  let mut current := initial\\n  for origin in origins do\\n    let key := name origin.occurrence\\n    unless PageMap.derivedKey key do throw (IO.userError \\\"provenance key escaped the non-authoritative namespace\\\")\\n    if let some encoded ← writer.get key then\\n      let old ← decode (α := Stored) encoded\\n      unless old.origin == origin && old.ordinal < current.count do\\n        throw (IO.userError \\\"conflicting immutable native provenance\\\")\\n    else\\n      let value : Stored := ⟨current.count,current.digest,origin⟩\\n      let row := originRow origin.occurrence (← bytes value)\\n      writer.put row.1 row.2\\n      current := ⟨current.count+1,contentKey value⟩\\n  if current == initial then return false\\n  let row := stateRow (← bytes current)\\n  writer.put row.1 row.2\\n  return true\\n\\n/-- Stage after the same transaction's original roots. No source ACK can be\\nreturned between body publication and this metadata publication. -/\\ndef stage (intern : Persistence.Store.Intern) (bindings : Array Binding) : IO Bool := do\\n  for binding in bindings do\\n    let id ← intern.value binding.edge.relation\\n    unless id == binding.checked.origin.owner &&\\n        (← intern.writer.get (key \\\"member\\\" id)).isSome do\\n      throw (IO.userError \\\"native interval is not bound to its live original root\\\")\\n  appendRows intern.writer (bindings.map (·.checked.origin))
.put (arcName id identity) (some payload)\\n    nodes := nodes.push id\\n  put writer (\\\"route:fact:\\\" ++ identity) nodes\\n  let previous ← counts writer\\n  put writer \\\"route:counts\\\" {previous with facts := previous.facts+1,arcs := previous.arcs+nodes.size}\\n\\n/-- Fact incidence is removed by its persisted handles, never by a graph or\\ndictionary scan. Interned keys survive so old pinned readers remain valid. -/\\ndef erase (writer : PageMap.Writer) (fact : Fact) : IO Unit := do\\n  let identity := Index.contentKey fact\\n  let some bytes ← writer.get (\\\"route:fact:\\\" ++ identity) | return\\n  let nodes ← Index.decode (α := Array Nat) bytes\\n  for node in nodes do\\n    let some bytes ← writer.get (arcName node identity) | throw (IO.userError \\\"missing retired routing incidence\\\")\\n    let arc ← decode bytes\\n    unless arc.evidence == identity do throw (IO.userError \\\"retired routing incidence differs from its fact\\\")\\n    writer.put (arcName node identity) none\\n  let previous ← counts writer\\n  unless 0 < previous.facts && nodes.size ≤ previous.arcs do throw (IO.userError \\\"routing counters underflow\\\")\\n  writer.put (\\\"route:fact:\\\" ++ identity) none\\n  put writer \\\"route:counts\\\" {previous with facts := previous.facts-1,arcs := previous.arcs-nodes.size}\\n\\n/-- Sealed in the source fact writer, after the exact same add/remove delta.\\nNo second DB publication or asynchronous readiness marker is involved. -/\\ndef finish (writer : PageMap.Writer) (expected : Nat) : IO Unit := do\\n  let total ← counts writer\\n  unless total.facts == expected do throw (IO.userError \\\"routing projection differs from source fact count\\\")\\n  let bytes ← Index.checkedBytes implementation\\n  if (← writer.get \\\"route:implementation\\\") != some bytes then\\n    writer.put \\\"route:implementation\\\" (some bytes)\\n\\nend Eggshell.Synapses.Routing.Store\\n\",[[\"SynapticTopology.lean\",\"module\\npublic import Eggshell.GraphStore\\npublic import Eggshell.SynapseSource\\n@[expose] public section\\nnamespace Eggshell.Synapses\\nopen Lean DB\\nnamespace Index\\ninductive Scope where\\n  | shared | usage\\n  deriving Repr, BEq, ToJson, FromJson\\n\\ndef Scope.directory : Scope → String\\n  | .shared => \\\"recommendations\\\"\\n  | .usage => \\\"usage\\\"\\n\\ndef Scope.accepts (scope : Scope) : Fact → Bool\\n  | .used _ => scope == .usage\\n  | _ => scope == .shared\\n\\ntheorem shared_rejects_usage (usage : Usage) : Scope.shared.accepts (.used usage) = false := rfl\\n\\ninductive Key where\\n  | owner (database owner : String)\\n  | answer (database owner : String)\\n  | claim (claim : Claim)\\n  | consumer (occurrence : Occurrence)\\n  | group (group : Group)\\n  | quoted (source : Range)\\n  | source (source : Range)\\n  | subject (subject : Subject)\\n  | quotation (digest : String)\\n  | query (digest : String)\\n  | usage (source : Range)\\n  deriving Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, ToJson, FromJson\\n\\ndef addresses : Fact → Array Key\\n  | .read recorded => #[.owner recorded.binding.database recorded.binding.owner, .source recorded.source, .subject recorded.source.subject] ++\\n      recorded.quotations.map Key.quotation\\n  | .supports support => #[\\n      .answer support.claim.database support.claim.answer, .claim support.claim, .source support.source]\\n  | .consumed edge => #[.consumer edge.consumer]\\n  | .coquoted group source => #[.group group, .quoted source]\\n  | .used usage => #[.query usage.query, .usage usage.source]\\n\\ndef contentKey [ToJson α] (value : α) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.synaptic-object\\\".toUTF8 [(toJson value).compress.toUTF8])\\n\\ndef payloadLimit : Nat := 262144\\n\\ndef decode [FromJson α] [ToJson α] (bytes : ByteArray) : IO α := do\\n  unless bytes.size ≤ payloadLimit do throw (IO.userError \\\"synaptic record exceeds its byte bound\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid synaptic UTF-8\\\")\\n  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))\\n  unless (toJson value).compress.toUTF8 == bytes do\\n    throw (IO.userError \\\"noncanonical synaptic record\\\")\\n  return value\\n\\ndef checkedBytes [ToJson α] (value : α) : IO ByteArray := do\\n  let bytes := (toJson value).compress.toUTF8\\n  unless bytes.size ≤ payloadLimit do throw (IO.userError \\\"synaptic record exceeds its byte bound\\\")\\n  return bytes\\n\\nend Index\\nnamespace Recommend\\n/-- Output identity is native occurrence identity. File coordinates are an\\nadditional addressing scheme, never a prerequisite for recommending data. -/\\ninductive Target where\\n  | range (source : Range)\\n  | output (producer : Occurrence)\\n  deriving DecidableEq, BEq, ToJson\\n\\ndef Target.source? : Target → Option Range\\n  | .range source => some source\\n  | .output _ => none\\n\\n/-- A recommendation names data actually carried by its advisory witness.\\nOrdinary rereads and changed sources do not reward a candidate. -/\\ndef carries (fact : Fact) : Target → Bool\\n  | .output producer => match fact with\\n    | .consumed edge => edge.producer == producer\\n    | _ => false\\n  | .range source => match fact with\\n    | .supports support => support.source == source\\n    | .consumed edge => edge.rows.contains source\\n    | .coquoted _ quoted => quoted == source\\n    | .used usage => usage.source == source &&\\n        (usage.kind == .omittedThenRead || usage.kind == .omittedThenConsumed || usage.kind == .deliveredThenCited)\\n    | .read _ => false\\n\\nderiving instance FromJson for Target\\nend Recommend\\nnamespace Routing\\nopen Recommend\\n/-- One step in the existing advisory relation. No original output, command\\ngrammar, similarity score, or human reference list enters this projection. -/\\nstructure Step where\\n  targets : Array Target := #[]\\n  next : Array Index.Key := #[]\\n  deriving BEq\\n\\ndef project (key : Index.Key) (fact : Fact) : 
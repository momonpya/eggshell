letterNumber (c : Char) : Bool := contains lettersNumbers c\\ndef mark (c : Char) : Bool := contains marks c\\n\\n/-- Width equivalence for ASCII and Kana only; not general NFKC or accent removal. -/\\ndef widthFold (text : String) : String := Id.run do\\n  let mut result : Array Char := #[]\\n  for c in text do\\n    let folded := if 0xff01 ≤ c.toNat && c.toNat ≤ 0xff5e then\\n      String.singleton (Char.ofNat (c.toNat - 0xfee0))\\n      else if c.toNat == 0x3000 then \\\" \\\"\\n      else (kanaWidth[c.toNat]?).getD (String.singleton c)\\n    for next in folded do\\n      if !result.isEmpty then\\n        if let some combined := kanaCompositions[(result[result.size - 1]!.toNat, next.toNat)]? then\\n          result := result.set! (result.size - 1) (Char.ofNat combined)\\n        else result := result.push next\\n      else result := result.push next\\n  return String.ofList result.toList\\n\\nend Eggshell.RetrievalResearch.Unicode\\n\"]]]"],["Eggshell.SynapseJournal","[\"module\\n\\npublic import Eggshell.SynapseBuild\\npublic import Eggshell.SynapseUsage\\npublic import Eggshell.PluginModel\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Journal\\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\\n\\nstructure Clock where\\n  domain : String\\n  nanos : Nat\\n  deriving BEq, ToJson, FromJson\\n\\nstructure IndexAt where\\n  head : PageMap.Head\\n  storage : Sidecar.Storage\\n  producer : String\\n  deriving BEq, ToJson, FromJson\\n\\n/-- Captured before the current PreToolUse can deliver anything. Unconfirmed\\noffers make missing-delivery labels unknown, never positive evidence. -/\\nstructure Knowledge where\\n  source : PageMap.Head\\n  indexed : Option IndexAt\\n  acknowledged : List String\\n  uncertain : Bool\\n  archive : Option String := none\\n  archived : Option PageMap.Head := none\\n  deriving BEq, FromJson\\n\\ninstance : ToJson Knowledge where\\n  toJson known := Json.mkObj ([\\n    (\\\"source\\\",toJson known.source),(\\\"indexed\\\",toJson known.indexed),\\n    (\\\"acknowledged\\\",toJson known.acknowledged),(\\\"uncertain\\\",toJson known.uncertain),\\n    (\\\"archive\\\",toJson known.archive)] ++\\n    known.archived.toList.map (fun head => (\\\"archived\\\",toJson head)))\\n\\ninductive Payload where\\n  | start (occurrence : Occurrence) (work query : String) (knowledge : Knowledge)\\n  | finish (occurrence : Occurrence) (name input response : String) (archive : Option String)\\n  | answer (occurrence : Occurrence) (query text : String) (knowledge : Knowledge)\\n  deriving BEq, ToJson, FromJson\\n\\ndef Payload.occurrence : Payload → Occurrence\\n  | .start value .. | .finish value .. | .answer value .. => value\\n\\ndef Payload.kind : Payload → String\\n  | .start .. => \\\"start\\\"\\n  | .finish .. => \\\"finish\\\"\\n  | .answer .. => \\\"answer\\\"\\n\\ndef Payload.sameObservation (left right : Payload) : Bool :=\\n  match left, right with\\n  | .start a work query _, .start b other q _ => a == b && work == other && query == q\\n  | .finish a name input response archive, .finish b n i r other =>\\n    a == b && name == n && input == i && response == r && archive == other\\n  | .answer a query text _, .answer b q t _ => a == b && query == q && text == t\\n  | _, _ => false\\n\\ndef Payload.valid (database : String) (payload : Payload) : Bool :=\\n  payload.occurrence.valid && match payload with\\n  | .start _ _ query known | .answer _ query _ known =>\\n    digest query && known.source.identity == database\\n  | .finish .. => true\\n\\nstructure Entry where\\n  clock : Clock\\n  payload : Payload\\n  receivedUnixMs : Option Nat := none\\n  deriving BEq, FromJson\\n\\ninstance : ToJson Entry where\\n  toJson entry := Json.mkObj ([\\n    (\\\"clock\\\", toJson entry.clock), (\\\"payload\\\", toJson entry.payload)] ++\\n    entry.receivedUnixMs.toList.map (fun time => (\\\"receivedUnixMs\\\", toJson time)))\\n\\ndef Entry.name (entry : Entry) : String :=\\n  Index.contentKey (entry.payload.kind, entry.payload.occurrence)\\n\\nstructure Turn where\\n  session : String\\n  turn : String\\n  deriving BEq, ToJson, FromJson\\n\\ndef Entry.turn (entry : Entry) : Turn :=\\n  ⟨entry.payload.occurrence.session, entry.payload.occurrence.turn⟩\\n\\ndef retainFirst (previous next : Entry) : Except String Entry :=\\n  if previous.payload.sameObservation next.payload then .ok previous\\n  else .error \\\"conflicting native synaptic event\\\"\\n\\ntheorem retry_keeps_first_observation (previous next accepted : Entry)\\n    (result : retainFirst previous next = .ok accepted) : accepted = previous := by\\n  unfold retainFirst at result\\n  split at result <;> simp_all\\n\\ntheorem retry_keeps_observed_time (previous next accepted : Entry)\\n    (result : retainFirst previous next = .ok accepted) : accepted.clock = previous.clock := by\\n  rw [retry_keeps_first_observation previous next accepted result]\\n\\ntheorem retry_keeps_receipt_time (previous next accepted : Entry)\\n    (result : retainFirst previous next = .ok accepted) :\\n    accepted.receivedUnixMs = previous.receivedUnixMs := by\\n  rw [retry_keeps_first_observation previous next accepted result]\\n\\ndef completeKnowledge (known : Knowledge) (indexed : Bool) : Bool :=\\n  !known.uncertain && indexed && (known.archive.isNone || known.archived.isSome)\\n\\ntheorem complete_knowledge_is_confirmed (known : Knowledge) (indexed : Bool)\\n    (complete : completeKnowledge known indexed = true) : known.uncertain = false ∧ indexed = true := by\\n  cases unknown : known.uncertain <;> cases available : indexed <;>\\n    simp_all [completeKnowledge]\\n\\ndef Turn.name (turn : Turn) : String := Index.contentKey turn\\n\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.synaptic-journal\\\".toUTF8 [\\n  Index.implementation.toUTF8, (include_str \\\"SynapseJournal.lean\\\").toUTF8,\\n  (include_str \\\"PluginModel.lean\\\").toUTF8, (include_str \\\"SynapseLive.lean\\\").toUTF8])\\n\\ndef directory (source : PageMap.Snapshot) : IO System.FilePath := do\\n  return (← Sidecar.locate source .user).directory / \\\"synapses\\\" / \\\"events\\\"\\n\\ndef open? (source : PageMap.Snapshot) : IO (Option PageMap.Snapshot) := do\\n  let some journal ← PageMap.open? (← directory source) | return none\\n  unless journal.head.authority == \\\"private-synaptic-events:\\\" ++ source.head.identity do\\n    throw (IO.userError \\\"foreign synaptic event journal\\\")\\n  return some journal\\n\\n/-- Pin only after acquiring the journal's publication claim. Native ingress\\nand background checkpoints share this claim; neither can invalidate the\\nother's snapshot between its duplicate probe and its B-tree transaction.\\nThe claim also serializes first creation. No source DB or index lock is held. -/\\nopaque withPublication (source : PageMap.Snapshot)\\n    (action : PageMap.Snapshot → IO α) : IO α := do\\n  let sidecar ← Sidecar.prepare (Sidecar.Owner.ofSnapshot source) .user\\n  let parent ← Sidecar.childDirectory sidecar.directory \\\"synapses\\\"\\n  let claim := parent / \\\"events.guard\\\"\\n  FileSystem.immutableExistingBytes claim ByteArray.empty\\n  let guard ← FileSystem.openRead claim.toString\\n  let deadline := (← IO.monoMsNow)+5000\\n  repeat\\n    unless (← IO.monoMsNow) < deadline do\\n      throw (IO.userError \\\"synaptic event publication is busy\\\")\\n    if ← FileSystem.tryReadLock guard true then break\\n    IO.sleep 5\\n  try\\n    let path := parent / \\\"events\\\"\\n    let journal ← match ← PageMap.open? path with\\n      | some journal => pure journal\\n      | none => PageMap.create path (\\\"private-synaptic-events:\\\" ++ source.head.identity)\\n    unless journal.head.authority == \\\"private-synaptic-events:\\\" ++ source.head.identity do\\n      throw (IO.userError \\\"foreign synaptic event journal\\\")\\n    action journal\\n  finally FileSystem.unlockRead guard\\n\\ndef prepare (source : PageMap.Snapshot) : IO PageMap.Snapshot :=\\n  withPublication source pure\\n\\ndef maxBytes : Nat := 8 * 1024 * 1024\\n\\ndef entry (journal : PageMap.Snapshot) (ordinal : Nat) : IO Entry := do\\n  let count ← getNat journal.get (key \\\"entry\\\" ordinal)\\n  unless count ≤ maxBytes do throw (IO.userError \\\"synaptic event exceeds its byte bound\\\")\\n  let bytes ← readChunks journal journal.get \\\"entry\\\" ordinal\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid event UTF-8\\\")\\n  let result ← IO.ofExcept (Json.parse text >>= fromJson? (α := Entry))\\n  unless (toJson result).compress.toUTF8 == bytes && result.payload.occurrence.valid &&\\n      digest result.clock.domain do throw (IO.userError \\\"invalid or noncanonical synaptic event\\\")\\n  return result\\n\\n/-- First observed knowledge and time are immutable on identical retries.\\nOnly one private B-tree publication adds the event and its turn posting. -/\\ndef append (source : PageMap.Snapshot) (value : Entry) : IO Bool := do\\n  unless value.payload.valid source.head.identity && digest value.clock.domain do\\n    throw (IO.userError \\\"invalid synaptic event identity\\\")\\n  let bytes := (toJson value).compress.toUTF8\\n  unless bytes.size ≤ maxBytes do throw (IO.userError \\\"synaptic event exceeds its byte bound\\\")\\n  withPublication source fun journal => do\\n    let name := \\\"event:\\\" ++ value.name\\n    if let some previous ← journal.get name then\\n      let ordinal ← IO.ofExcept (payloadSize (some previous))\\n      let saved ← entry journal ordinal\\n      unless saved.name == value.name do throw (IO.userError \\\"ambiguous event digest\\\")\\n      let _ ← IO.ofExcept (retainFirst saved value)\\n      return false\\n    let (_, _, _) ← PageMap.withWriter journal fun writer => do\\n      let ordinal ← getNat writer.get \\\"count\\\"\\n      putChunks writer \\\"entry\\\" ordinal bytes\\n      putNat writer name ordinal\\n      putNat writer \\\"count\\\" (ordinal+1)\\n      let turn := value.turn\\n      writer.put (\\\"turn:\\\" ++ turn.name) (some ((toJson turn).compress.toUTF8))\\n      putNat writer (key (\\\"posting:\\\" ++ turn.name) ordinal) ordinal\\n      putNat writer (\\\"latest:\\\" ++ turn.name) (ordinal+1)\\n    return true\\n\\ndef lookup? (journal : PageMap.Snapshot) (kind : String)\\n    (occurrence : Occurrence) : IO (Option Entry) := do\\n  let name := Index.contentKey (kind, occurrence)\\n  let some encoded ← journal.get (\\\"event:\\\" ++ name) | return none\\n  let ordinal ← IO.ofExcept (payloadSize (some encoded))\\n  unless ordinal < (← getNat journal.get \\\"count\\\") do\\n    throw (IO.userError \\\"native event point is outside its committed journal\\\")\\n  let value ← entry journal ordinal\\n  unless value.name == name && value.payload.kind == kind && value.payload.occurrence == occurrence do\\n    throw (IO.userError \\\"native event point lookup changed its identity\\\")\\n  return some value\\n\\ndef turnEntries (journal : PageMap.Snapshot) (turn : Turn) : IO (Array Entry) := do\\n  let mut values := #[]\\n  for (ordinal, indexed) in ← Persistence.Store.directory journal (\\\"posting:\\\" ++ turn.name) do\\n    unless ordinal == indexed do throw (IO.userError \\\"invalid event turn posting\\\")\\n    let value ← entry journal ordinal\\n    unless value.turn == turn do throw (IO.userError \\\"ambiguous event turn digest\\\")\\n    values := values.push value\\n  return values.qsort fun a b => if a.clock.domain == b.clock.domain then a.clock.nanos < b.clock.nanos\\n    else a.clock.domain < b.clock.domain\\n\\ndef knowledge (source : PageMap.Snapshot) (known : List String) (uncertain : Bool)\\n    (archive : Option String := none) : IO Knowledge := do\\n  let indexed ← if let some reader ← Index.open? source .database .shared then\\n      pure (some ({head := reader.index.head, storage := .database, producer := reader.manifest.implementation} : IndexAt))\\n    else if let some reader ← Index.open? source .user .shared then\\n      pure (some ({head := reader.index.head, storage := .user, producer := reader.manifest.implementation} : IndexAt))\\n    else pure none\\n  let archived ← archive.bindM fun path => do\\n    if (.mk path : System.FilePath).normalize == source.directory.normalize then return some source.head\\n    return (← PageMap.open? (.mk path)).map (·.head)\\n  return ⟨source.head, indexed, known, uncertain, archive, archived⟩\\n\\ndef originalAt? (source : PageMap.Snapshot) (head : PageMap.Head) : IO (Option PageMap.Snapshot) := do\\n  if (← Build.changes source head).isNone then return none\\n  return some {source with head}\\n\\ndef indexAt? (source : PageMap.Snapshot) (known : Knowledge) : IO (Option Index.Reader) := do\\n  let some saved := known.indexed | return none\\n  let some current ← PageMap.open? (← Index.directory source saved.storage .shared) | return none\\n  unless current.head.identity == saved.head.identity && current.head.authority == saved.head.authority &&\\n      saved.head.bytes ≤ current.head.bytes do return none\\n  let index := {current with head := saved.head}\\n  let some manifest ← Index.manifest? index | return none\\n  unless manifest.implementation == saved.producer && saved.producer == Index.implementation &&\\n      manifest.scope == .shared && manifest.source.identity == source.head.identity do return none\\n  let some original ← originalAt? source known.source | return none\\n  unless ← Index.sameSources original manifest.source do return none\\n  return some ⟨index, manifest⟩\\n\\ndef ownerKeys (known : List String) : Array String :=\\n  (known.filterMap fun value => match value.splitOn \\\":\\\" with\\n    | [\\\"h\\\", owner] | [\\\"g\\\", owner, _] | [\\\"e\\\", owner, _, _, _] => some owner\\n    | _ => none).eraseDups.toArray\\n\\ndef acknowledged (keys : List String) (doc : Document) (row : Read) : Bool :=\\n  let whole := keys.any fun value => match value.splitOn \\\":\\\" with\\n    | [\\\"h\\\", owner] => owner == doc.owner\\n    | [\\\"g\\\", owner, result] => owner == doc.owner &&\\n        doc.source.any (fun text => Persistence.selectionKey (.text text) == result)\\n    | _ => false\\n  let spans := keys.filterMap fun value => match value.splitOn \\\":\\\" with\\n    | [\\\"e\\\", owner, result, first, limit] =>\\n        if owner == doc.owner && doc.source.any (fun text => Persistence.selectionKey (.text text) == result) then do\\n          let a ← first.toNat?\\n          let b ← limit.toNat?\\n          if a < b then some (owner,a,b) else none\\n        else none\\n    | _ => none\\n  whole || ({bindings := spans.toArray} : Presentation).coversBinding row.binding\\n\\ndef presentation (source : PageMap.Snapshot) (known : Knowledge) : IO Presentation := do\\n  let some original ← originalAt? source known.source | return {}\\n  let archive ← known.archive.bindM fun path => do\\n    let some head := known.archived | return none\\n    let some current ← PageMap.open? (.mk path) | return none\\n    originalAt? current head\\n  let sources := #[original] ++ archive.toArray\\n  let mut ranges := #[]\\n  for snapshot in sources do\\n    let reader ← NodeReader.new snapshot\\n    for owner in ownerKeys known.acknowledged do\\n      let some id ← Build.ownerId? snapshot owner | continue\\n      let doc ← Build.document reader id\\n      let some catalog := ObservationContext.recorded snapshot.head.identity doc | continue\\n      ranges := ranges ++ (catalog.located.flatMap (·.originalRows) |>.filter (acknowledged known.acknowledged doc) |>.map (·.source))\\n  return {ranges := compactRanges ranges}\\n\\nabbrev Starts := Std.HashMap Occurrence (String × Knowledge × String)\\n\\nstructure NativeFeedback where\\n  graph : Graph\\n  unknown : Nat := 0\\n  ambiguous : Nat := 0\\n\\nabbrev WitnessAt := Occurrence × Nat × Nat × WitnessKind × String\\n\\ndef witnessAt (edge : Consumption) : WitnessAt :=\\n  (edge.consumer,edge.inputFirst,edge.inputLimit,edge.kind,edge.term)\\n\\n/-- A literal may occur in several earlier outputs. Such an ambiguous match\\ndoes not identify which re-read was useful, and cannot earn a missing label. -/\\ndef nativeCandidates (facts : Array Fact) : Array (Consumption × Range) := Id.run do\\n  let mut candidates := #[]\\n  for fact in facts do\\n    let .consumed edge := fact | continue\\n    for source in edge.rows do\\n      if (consumedSource? edge source).isSome then candidates := candidates.push (edge,source)\\n  return candidates\\n\\ndef nativeFeedback (source : PageMap.Snapshot) (starts : Starts) (facts : Array Fact)\\n    (graph : Graph) (deadline : Nat) : IO NativeFeedback := do\\n  let candidates := nativeCandidates facts\\n  let mut witnesses : Std.HashMap WitnessAt (Std.HashSet (Occurrence × Option Range)) := {}\\n  for fact in facts do\\n    let .consumed edge := fact | continue\\n    let rows := if edge.rows.isEmpty then #[none] else edge.rows.map some\\n    for range in rows do\\n      let key := witnessAt edge\\n      witnesses := witnesses.insert key ((witnesses[key]?.getD {}).insert (edge.producer,range))\\n  let mut groups : Std.HashMap Occurrence (Array (Consumption × Range)) := {}\\n  let mut result : NativeFeedback := ⟨graph,0,0⟩\\n  for (edge,range) in candidates do\\n    if (witnesses[witnessAt edge]?.getD {}).size != 1 then\\n      result := {result with ambiguous := result.ambiguous+1}\\n      continue\\n    groups := groups.insert edge.producer (groups[edge.producer]?.getD #[] |>.push (edge,range))\\n  for (producer,uses) in groups do\\n    if (← IO.monoMsNow) ≥ deadline then throw (IO.userError \\\"native usage deadline\\\")\\n    let some (query,known,_) := starts[producer]? | result := {result with unknown := result.unknown+1}; continue\\n    let indexed ← indexAt? source known\\n    unless completeKnowledge known indexed.isSome do\\n      result := {result with unknown := result.unknown+1}; continue\\n    let some indexed := indexed | throw (IO.userError \\\"missing checked pre-read index\\\")\\n    let subjects := uses.foldl (fun subjects (_,range) => subjects.insert range.subject) ({} : Std.HashSet Subject)\\n    let mut stored := #[]\\n    for subject in subjects do\\n      let found ← indexed.lookup (.subject subject) 100000 deadline\\n      unless found.complete do throw (IO.userError \\\"incomplete native stored-read evidence\\\")\\n      stored := stored ++ found.facts.filterMap (fun fact => match fact with\\n        | .read read => if read.occurrence != producer then some read.source else none\\n        | _ => none)\\n    let shown ← presentation source known\\n    for (edge,requested) in uses do\\n      -- Without a pre-existing original there was no missed memory to label.\\n      unless covered requested stored do continue\\n      let missing := omittedRanges requested stored shown.ranges\\n      for range in if missing.isEmpty then #[requested] else missing do\\n        let some checked := consumedSource? edge range | throw (IO.userError \\\"usage escaped its consumption witness\\\")\\n        result := {result with graph := ← IO.ofExcept (recordConsumed result.graph checked query stored shown.ranges)}\\n  return result\\n\\nstructure Replay where\\n  consumed : Array Fact := #[]\\n  usage : Array Fact := #[]\\n  consumers : Array Occurrence := #[]\\n  pending : Nat := 0\\n  unknown : Nat := 0\\n  origins : Array Provenance.Origin := #[]\\n  ambiguousNativeUses : Nat := 0\\n\\ndef acceptPublishedOutput (ownerId : Option Nat) (previous observed : Trace) : Trace :=\\n  if ownerId.isSome then observed else previous\\n\\ntheorem unowned_output_keeps_public_trace (previous observed : Trace) :\\n    acceptPublishedOutput none previous observed = previous := rfl\\n\\n/-- All original body/row work happens in the background. A finish without\\nan exact published native owner remains pending instead of inventing evidence. -/\\ndef replay (source : PageMap.Snapshot) (values : Array Entry) (deadline : Nat) : IO Replay := do\\n  let mut result : Replay := {}\\n  let mut trace : Trace := {}\\n  let mut domain := \\\"\\\"\\n  let mut starts : Starts := {}\\n  let mut locations : Std.HashMap Occurrence (Array OutputRow) := {}\\n  let mut observed : Trace := {}\\n  let mut observedLocations : Std.HashMap Occurrence (Array OutputRow) := {}\\n  let mut usage : Graph := .empty\\n  for value in values do\\n    if (← IO.monoMsNow) ≥ deadline then throw (IO.userError \\\"synaptic replay deadline\\\")\\n    if domain != value.clock.domain then\\n      let projected ← IO.ofExcept (trace.locate locations)\\n      let privateTrace ← IO.ofExcept (observed.locate observedLocations)\\n      let feedback ← nativeFeedback source starts privateTrace.graph.snapshot usage deadline\\n      usage := feedback.graph\\n      result := {result with consumed := result.consumed ++ projected.graph.snapshot}\\n      result := {result with\\n        unknown := result.unknown+feedback.unknown\\n        ambiguousNativeUses := result.ambiguousNativeUses+feedback.ambiguous}\\n      trace := {}; starts := {}; locations := {}; domain := value.clock.domain\\n      observed := {}; observedLocations := {}\\n    if trace.lastOrdinal.any (value.clock.nanos < ·) then\\n      result := {result with unknown := result.unknown+1}\\n      continue\\n    match value.payload with\\n    | .start occurrence work query known =>\\n      let .ok (command,format) := invocationData work | result := {result with unknown := result.unknown+1}; continue\\n      if let some (_,_,original) := starts[occurrence]? then\\n        unless original == work do throw (IO.userError \\\"native start changed its complete invocation\\\")\\n      trace ← IO.ofExcept (trace.start occurrence value.clock.nanos command format)\\n      observed ← IO.ofExcept (observed.start occurrence value.clock.nanos command format)\\n      starts := starts.insert occurrence (query, known, work)\\n      result := {result with consumers := result.consumers.push occurrence}\\n    | .finish occurrence name input response archive =>\\n      if !trace.starts.contains occurrence then result := {result with unknown := result.unknown+1}; continue\\n      let tool : Plugin.ToolEvent := {name,useId := occurrence.useId,input,response}\\n      let some started := trace.starts[occurrence]? | throw (IO.userError \\\"missing observed start\\\")\\n      let work := Plugin.canonicalToolWork tool\\n      let some (_,_,original) := starts[occurrence]? |\\n        throw (IO.userError \\\"native finish has no complete invocation\\\")\\n      unless work == original do throw (IO.userError \\\"native finish changed its complete invocation\\\")\\n      let .ok (command,format) := invocationData work |\\n        throw (IO.userError \\\"native finish has no structured invocation\\\")\\n      unless command == started.command && format == started.format do\\n        throw (IO.userError \\\"native finish changed its observed invocation\\\")\\n      let expected := (Plugin.compileOperationOutcomes (.text occurrence.session) (.text occurrence.turn) tool).2\\n      let localId ← findNode? source expected\\n      let localId ← localId.filterM fun id => return (← source.get (key \\\"member\\\" id)).isSome\\n      let located ← if let some id := localId then pure (some (source, id)) else do\\n        let some path := archive | pure none\\n        let some archived ← PageMap.open? (.mk path) | pure none\\n        let some id ← findNode? archived expected | pure none\\n        if (← archived.get (key \\\"member\\\" id)).isSome then pure (some (archived, id)) else pure none\\n      let some (recorded, id) := located | do\\n        if archive.isSome then result := {result with pending := result.pending+1}\\n        else result := {result with unknown := result.unknown+1}\\n        continue\\n      let currentOriginal := localId.isSome\\n      if currentOriginal then\\n        let origin : Provenance.Origin :=\\n          ⟨id, occurrence, value.clock.domain, started.ordinal, value.clock.nanos, value.receivedUnixMs⟩\\n        result := {result with origins := result.origins.push origin}\\n      let originalReader ← NodeReader.new recorded\\n      let doc ← Build.document originalReader id\\n      unless doc.occurrences.contains occurrence && doc.workText == some (Plugin.canonicalToolWork tool) do\\n        throw (IO.userError \\\"native synaptic observation changed its exact occurrence\\\")\\n      let some raw := doc.source | result := {result with unknown := result.unknown+1}; continue\\n      let outputFormat := if (Json.parse raw).isOk then DataFormat.json else .text\\n      let completed ← IO.ofExcept (trace.finish occurrence value.clock.nanos raw outputFormat)\\n      observed ← IO.ofExcept (observed.finish occurrence value.clock.nanos raw outputFormat)\\n      -- Foreign private work can label usage of this DB's memory, but cannot\\n      -- publish its terms or consumption edges into the shared DB lane.\\n      trace := acceptPublishedOutput localId trace completed\\n      let located := ObservationContext.locate recorded.head.identity doc completed\\n      observedLocations := observedLocations.insert occurrence\\n        ((ObservationContext.locate recorded.head.identity doc observed).flatMap (·.rows))\\n      if currentOriginal then locations := locations.insert occurrence (located.flatMap (·.rows))\\n      -- A general result does not state which part was requested as a read.\\n      -- Locate all its consumption witnesses, but do not label every returned\\n      -- field \\\"missing then read\\\". Native usage needs its own consumption/ACK\\n      -- evidence; the certified file-read policy stays explicit here.\\n      let reads := located.filter (·.read.source.file?.isSome)\\n      if !reads.isEmpty then\\n        if let some (query, known, _) := starts[occurrence]? then\\n          let storedIndex ← indexAt? source known\\n          -- Missing/unverifiable pre-read knowledge cannot earn a read label.\\n          -- Do not decode every acknowledged original only to discard the\\n          -- resulting presentation after the same eligibility decision.\\n          unless completeKnowledge known storedIndex.isSome do\\n            result := {result with unknown := result.unknown+1}\\n            continue\\n          let mut stored := #[]\\n          if let some index := storedIndex then\\n            let files := reads.foldl (fun files read => files.insert read.read.source.subject) ({} : Std.HashSet Subject)\\n            for file in files do\\n              let found ← index.lookup (.subject file) 100000 deadline\\n              unless found.complete do throw (IO.userError \\\"incomplete stored-read evidence\\\")\\n              stored := stored ++ found.facts.filterMap (fun fact => match fact with\\n                | .read read => if read.occurrence != occurrence then some read.source else none\\n                | _ => none)\\n          let shown ← presentation source known\\n          let feedback : Feedback := ({graph := usage, delivered := shown} : Feedback).start occurrence\\n          let feedback ← IO.ofExcept (feedback.completedRead occurrence query (reads.map (·.read.source)) stored)\\n          usage := feedback.graph\\n    | .answer occurrence query text known =>\\n      if known.uncertain then result := {result with unknown := result.unknown+1}; continue\\n      let shown ← presentation source known\\n      let feedback ← IO.ofExcept (({graph := usage, delivered := shown} : Feedback).answer occurrence query text)\\n      usage := feedback.graph\\n  let projected ← IO.ofExcept (trace.locate locations)\\n  let privateTrace ← IO.ofExcept (observed.locate observedLocations)\\n  let feedback ← nativeFeedback source starts privateTrace.graph.snapshot usage deadline\\n  return {result with\\n    consumed := result.consumed ++ projected.graph.snapshot, usage := feedback.graph.snapshot\\n    unknown := result.unknown+feedback.unknown,ambiguousNativeUses := result.ambiguousNativeUses+feedback.ambiguous}\\n\\nstructure Checkpoint where\\n  source : PageMap.Head\\n  index : String\\n  count : Nat\\n  implementation : String\\n  deriving BEq, ToJson, FromJson\\n\\ndef lane (storage : Sidecar.Storage) : String := if storage == .database then \\\"database\\\" else \\\"user\\\"\\n\\ndef checkpoint? (journal : PageMap.Snapshot) (name : String) : IO (Option Checkpoint) := do\\n  (← journal.get name).mapM (Index.decode (α := Checkpoint))\\n\\ndef Checkpoint.sameInput (previous : Checkpoint) (source : PageMap.Snapshot)\\n    (index : String) (count : Nat) (limit : Nat := 16) : IO Bool := do\\n  unless previous.index == index && previous.count == count &&\\n      previous.implementation == Eggshell.Synapses.Journal.implementation do return false\\n  Index.sameSources source previous.source limit\\n\\ndef mark (source : PageMap.Snapshot) (name : String) (checkpoint : Checkpoint) : IO Unit := do\\n  let bytes ← Index.checkedBytes checkpoint\\n  withPublication source fun journal => do\\n    let _ ← PageMap.withWriter journal fun writer => do\\n      if (← writer.get name) != some bytes then writer.put name (some bytes)\\n\\n/-- Constant metadata probe; no journal entries or original bodies are read. -/\\ndef required (source : PageMap.Snapshot) (storage : Sidecar.Storage := .database) : IO Bool := do\\n  let some journal ← open? source | return false\\n  let some reader ← Index.open? source storage .shared | return true\\n  let some previous ← checkpoint? journal (\\\"checkpoint:\\\" ++ lane storage) | return true\\n  return !(← previous.sameInput source reader.index.head.identity (← getNat journal.get \\\"count\\\"))\\n\\nstructure Result where\\n  turns : Nat := 0\\n  consumed : Nat := 0\\n  usage : Nat := 0\\n  pending : Nat := 0\\n  unknown : Nat := 0\\n  complete : Bool := true\\n  ambiguousNativeUses : Nat := 0\\n  deriving ToJson, FromJson\\n\\ndef publish (source : PageMap.Snapshot) (storage : Sidecar.Storage) (result : Replay) (deadline : Nat) : IO Unit := do\\n  let some shared ← Index.open? source storage .shared | throw (IO.userError \\\"synaptic source index is not warm\\\")\\n  let mut old := #[]\\n  for consumer in result.consumers.toList.eraseDups do\\n    let found ← shared.lookup (.consumer consumer) 100000 deadline\\n    unless found.complete do throw (IO.userError \\\"incomplete consumer retirement evidence\\\")\\n    old := old ++ found.facts\\n  let previous := old.foldl (fun set fact => set.insert fact) ({} : Std.HashSet Fact)\\n  let wanted := result.consumed.foldl (fun set fact => set.insert fact) ({} : Std.HashSet Fact)\\n  let _ ← Index.publishDelta source storage .shared (some shared.manifest.source) {\\n    removed := old.filter (!wanted.contains ·), added := result.consumed.filter (!previous.contains ·) }\\n  if result.usage.isEmpty then return\\n  if let some usageReader ← Index.open? source .user .usage then\\n    let _ ← Index.publishDelta source .user .usage (some usageReader.manifest.source) {added := result.usage}\\n  else\\n    let cache ← Index.prepare source .user .usage\\n    let _ ← Index.replace source .user .usage ((← Index.allFacts cache) ++ result.usage)\\n\\n/-- Background replay is bounded by turns and a deadline. Publication is\\nidempotent; checkpoint failure leaves the same immutable events replayable. -/\\ndef refresh (source : PageMap.Snapshot) (storage : Sidecar.Storage) (deadline : Nat)\\n    (limit : Nat := 8) : IO Result := do\\n  let _ ← Build.refresh source storage\\n  let some journal ← open? source | return {}\\n  let some reader ← Index.open? source storage .shared | throw (IO.userError \\\"synaptic source index is not warm\\\")\\n  let count ← getNat journal.get \\\"count\\\"\\n  let expected : Checkpoint := ⟨source.head, reader.index.head.identity, count, implementation⟩\\n  let checkpointKey := \\\"checkpoint:\\\" ++ lane storage\\n  if let some previous ← checkpoint? journal checkpointKey then\\n    if ← previous.sameInput source expected.index count (source.head.revision-previous.source.revision+1) then\\n      if previous != expected then mark source checkpointKey expected\\n      return {}\\n  let turns ← journal.foldRange ⟨\\\"turn:\\\", \\\"turn;\\\"⟩ (fun turns row => do\\n    let some bytes := row.2 | return turns\\n    let turn ← Index.decode (α := Turn) bytes\\n    unless row.1 == \\\"turn:\\\" ++ turn.name do throw (IO.userError \\\"foreign event turn directory\\\")\\n    return turns.push turn) #[]\\n  let mut result : Result := {}\\n  for turn in turns do\\n    let checkpoint : Checkpoint := ⟨source.head, reader.index.head.identity, ← getNat journal.get (\\\"latest:\\\" ++ turn.name), implementation⟩\\n    let turnKey := \\\"processed:\\\" ++ lane storage ++ \\\":\\\" ++ turn.name\\n    if let some previous ← checkpoint? journal turnKey then\\n      if ← previous.sameInput source checkpoint.index checkpoint.count (source.head.revision-previous.source.revision+1) then continue\\n    if result.turns ≥ limit || (← IO.monoMsNow) ≥ deadline then\\n      result := {result with complete := false}\\n      break\\n    let replayed ← replay source (← turnEntries journal turn) deadline\\n    if storage == .database then Provenance.requirePublished source replayed.origins\\n    publish source storage replayed deadline\\n    if replayed.pending == 0 then mark source turnKey checkpoint\\n    else result := {result with complete := false}\\n    result := {result with\\n      turns := result.turns+1, consumed := result.consumed+replayed.consumed.size\\n      usage := result.usage+replayed.usage.size, pending := result.pending+replayed.pending, unknown := result.unknown+replayed.unknown,\\n      ambiguousNativeUses := result.ambiguousNativeUses+replayed.ambiguousNativeUses}\\n  if result.complete then mark source checkpointKey expected\\n  return result\\n\\n/-- Native maintenance has no executable or numerical-provider configuration. -/\\nstructure Target where\\n  owner : Sidecar.Owner\\n  storage : Sidecar.Storage\\n  deriving BEq, ToJson, FromJson\\n\\ndef registry : IO System.FilePath := do return (← Paths.dataRoot) / \\\"synaptic-targets\\\"\\n\\ndef register (source : PageMap.Snapshot) (writable : Bool) : IO Unit := do\\n  let owner := Sidecar.Owner.ofSnapshot source\\n  let (storage, _) ← Sidecar.destination owner writable\\n  let target : Target := ⟨owner, storage⟩\\n  let root ← registry\\n  FileSystem.rejectSymlinkAncestors root\\n  FileSystem.privateDirectory root\\n  FileSystem.immutableBytes (root / (Index.contentKey target ++ \\\".json\\\")) (← Index.checkedBytes target)\\n\\ndef targets : IO (Array (System.FilePath × Target)) := do\\n  let root ← registry\\n  if !(← root.pathExists) then return #[]\\n  let mut result := #[]\\n  for entry in ← root.readDir do\\n    if !entry.fileName.endsWith \\\".json\\\" then continue\\n    try\\n      let bytes ← FileSystem.boundedBytes entry.path 65536\\n      let target ← Index.decode (α := Target) bytes\\n      unless entry.fileName == Index.contentKey target ++ \\\".json\\\" do\\n        throw (IO.userError \\\"foreign native maintenance target\\\")\\n      result := result.push (entry.path, target)\\n    catch error => IO.eprintln s!\\\"Eggshell retained an unreadable native maintenance target: {error}\\\"\\n  return result\\n\\nend Eggshell.Synapses.Journal\\n\",[[\"SynapseJournal.lean\",\"module\\n\\npublic import Eggshell.SynapseBuild\\npublic import Eggshell.SynapseUsage\\npublic import Eggshell.PluginModel\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Journal\\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\\n\\nstructure Clock where\\n  domain : String\\n  nanos : Nat\\n  deriving BEq, ToJson, FromJson\\n\\nstructure IndexAt where\\n  head : PageMap.Head\\n  storage : Sidecar.Storage\\n  producer : String\\n  deriving BEq, ToJson, FromJson\\n\\n/-- Captured before the current PreToolUse can deliver anything. Unconfirmed\\noffers make missing-delivery labels unknown, never positive evidence. -/\\nstructure Knowledge where\\n  source : PageMap.Head\\n  indexed : Option IndexAt\\n  acknowledged : List String\\n  uncertain : Bool\\n  archive : Option String := none\\n  archived : Option PageMap.Head := none\\n  deriving BEq, FromJson\\n\\ninstance : ToJson Knowledge where\\n  toJson known := Json.mkObj ([\\n    (\\\"source\\\",toJson known.source),(\\\"indexed\\\",toJson known.indexed),\\n    (\\\"acknowledged\\\",toJson known.acknowledged),(\\\"uncertain\\\",toJson known.uncertain),\\n    (\\\"archive\\\",toJson known.archive)] ++\\n    known.archived.toList.map (fun head => (\\\"archived\\\",toJson head)))\\n\\ninductive Payload where\\n  | start (occurrence : Occurrence) (work query : String) (knowledge : Knowledge)\\n  | finish (occurrence : Occurrence) (name input response : String) (archive : Option String)\\n  | answer (occurrence : Occurrence) (query text : String) (knowledge : Knowledge)\\n  deriving BEq, ToJson, FromJson\\n\\ndef Payload.occurrence : Payload → Occurrence\\n  | .start value .. | .finish value .. | .answer value .. => value\\n\\ndef Payload.kind : Payload → String\\n  | .start .. => \\\"start\\\"\\n  | .finish .. => \\\"finish\\\"\\n  | .answer .. => \\\"answer\\\"\\n\\ndef Payload.sameObservation (left right : Payload) : Bool :=\\n  match left, right with\\n  | .start a work query _, .start b other q _ => a == b && work == other && query == q\\n  | .finish a name input response archive, .finish b n i r other =>\\n    a == b && name == n && input == i && response == r && archive == other\\n  | .answer a query text _, .answer b q t _ => a == b && query == q && text == t\\n  | _, _ => false\\n\\ndef Payload.valid (database : String) (payload : Payload) : Bool :=\\n  payload.occurrence.valid && match payload with\\n  | .start _ _ query known | .answer _ query _ known =>\\n    digest query && known.source.identity == database\\n  | .finish .. => true\\n\\nstructure Entry where\\n  clock : Clock\\n  payload : Payload\\n  receivedUnixMs : Option Nat := none\\n  deriving BEq, FromJson\\n\\ninstance : ToJson Entry where\\n  toJson entry := Json.mkObj ([\\n    (\\\"clock\\\", toJson entry.clock), (\\\"payload\\\", toJson entry.payload)] ++\\n    entry.receivedUnixMs.toList.map (fun time => (\\\"receivedUnixMs\\\", toJson time)))\\n\\ndef Entry.name (entry : Entry) : String :=\\n  Index.contentKey (entry.payload.kind, entry.payload.occurrence)\\n\\nstructure Turn where\\n  session : String\\n  turn : String\\n  deriving BEq, ToJson, FromJson\\n\\ndef Entry.turn (entry : Entry) : Turn :=\\n  ⟨entry.payload.occurrence.session, entry.payload.occurrence.turn⟩\\n\\ndef retainFirst (previous next : Entry) : Except String Entry :=\\n  if previous.payload.sameObservation next.payload then .ok previous\\n  else .error \\\"conflicting native synaptic event\\\"\\n\\ntheorem retry_keeps_first_observation (previous next accepted : Entry)\\n    (result : retainFirst previous next = .ok accepted) : accepted = previous := by\\n  unfold retainFirst at result\\n  split at result <;> simp_all\\n\\ntheorem retry_keeps_observed_time (previous next accepted : Entry)\\n    (result : retainFirst previous next = .ok accepted) : accepted.clock = previous.clock := by\\n  rw [retry_keeps_first_observation previous next accepted result]\\n\\ntheorem retry_keeps_receipt_time (previous next accepted : Entry)\\n    (result : retainFirst previous next = .ok accepted) :\\n    accepted.receivedUnixMs = previous.receivedUnixMs := by\\n  rw [retry_keeps_first_observation previous next accepted result]\\n\\ndef completeKnowledge (known : Knowledge) (indexed : Bool) : Bool :=\\n  !known.uncertain && indexed && (known.archive.isNone || known.archived.isSome)\\n\\ntheorem complete_knowledge_is_confirmed (known : Knowledge) (indexed : Bool)\\n    (complete : completeKnowledge known indexed = true) : known.uncertain = false ∧ indexed = true := by\\n  cases unknown : known.uncertain <;> cases available : indexed <;>\\n    simp_all [completeKnowledge]\\n\\ndef Turn.name (turn : Turn) : String := Index.contentKey turn\\n\\ndef implementation : String := Blake3.hex (Blake3.digest \\\"eggshell.synaptic-journal\\\".toUTF8 [\\n  Index.implementation.toUTF8, (include_str \\\"SynapseJournal.lean\\\").toUTF8,\\n  (include_str \\\"PluginModel.lean\\\").toUTF8, (include_str \\\"SynapseLive.lean\\\").toUTF8])\\n\\ndef directory (source : PageMap.Snapshot) : IO System.FilePath := do\\n  return (← Sidecar.locate source .user).directory / \\\"synapses\\\" / \\\"events\\\"\\n\\ndef open? (source : PageMap.Snapshot) : IO (Option PageMap.Snapshot) := do\\n  let some journal ← PageMap.open? (← directory source) | return none\\n  unless journal.head.authority == \\\"private-synaptic-events:\\\" ++ source.head.identity do\\n    throw (IO.userError \\\"foreign synaptic event journal\\\")\\n  return some journal\\n\\n/-- Pin only after acquiring the journal's publication claim. Native ingress\\nand background checkpoints share this claim; neither can invalidate the\\nother's snapshot between its duplicate probe and its B-tree transaction.\\nThe claim also serializes first creation. No source DB or index lock is held. -/\\nopaque withPublication (source : PageMap.Snapshot)\\n    (action : PageMap.Snapshot → IO α) : IO α := do\\n  let sidecar ← Sidecar.prepare (Sidecar.Owner.ofSnapshot source) .user\\n  let parent ← Sidecar.childDirectory sidecar.directory \\\"synapses\\\"\\n  let claim := parent / \\\"events.guard\\\"\\n  FileSystem.immutableExistingBytes claim ByteArray.empty\\n  let guard ← FileSystem.openRead claim.toString\\n  let deadline := (← IO.monoMsNow)+5000\\n  repeat\\n    unless (← IO.monoMsNow) < deadline do\\n      throw (IO.userError \\\"synaptic event publication is busy\\\")\\n    if ← FileSystem.tryReadLock guard true then break\\n    IO.sleep 5\\n  try\\n    let path := parent / \\\"events\\\"\\n    let journal ← match ← PageMap.open? path with\\n      | some journal => pure journal\\n      | none => PageMap.create path (\\\"private-synaptic-events:\\\" ++ source.head.identity)\\n    unless journal.head.authority == \\\"private-synaptic-events:\\\" ++ source.head.identity do\\n      throw (IO.userError \\\"foreign synaptic event journal\\\")\\n    action journal\\n  finally FileSystem.unlockRead guard\\n\\ndef prepare (source : PageMap.Snapshot) : IO PageMap.Snapshot :=\\n  withPublication source pure\\n\\ndef maxBytes : Nat := 8 * 1024 * 1024\\n\\ndef entry (journal : PageMap.Snapshot) (ordinal : Nat) : IO Entry := do\\n  let count ← getNat journal.get (key \\\"entry\\\" ordinal)\\n  unless count ≤ maxBytes do throw (IO.userError \\\"synaptic event exceeds its byte bound\\\")\\n  let bytes ← readChunks journal journal.get \\\"entry\\\" ordinal\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid event UTF-8\\\")\\n  let result ← IO.ofExcept (Json.parse text >>= fromJson? (α := Entry))\\n  unless (toJson result).compress.toUTF8 == bytes && result.payload.occurrence.valid &&\\n      digest result.clock.domain do throw (IO.userError \\\"invalid or noncanonical synaptic event\\\")\\n  return result\\n\\n/-- First observed knowledge and time are immutable on identical retries.\\nOnly one private B-tree publication adds the event and its turn posting. -/\\ndef append (source : PageMap.Snapshot) (value : Entry) : IO Bool := do\\n  unless value.payload.valid source.head.identity && digest value.clock.domain do\\n    throw (IO.userError \\\"invalid synaptic event identity\\\")\\n  let bytes := (toJson value).compress.toUTF8\\n  unless bytes.size ≤ maxBytes do throw (IO.userError \\\"synaptic event exceeds its byte bound\\\")\\n  withPublication source fun journal => do\\n    let name := \\\"event:\\\" ++ value.name\\n    if let some previous ← journal.get name then\\n      let ordinal ← IO.ofExcept (payloadSize (some previous))\\n      let saved ← entry journal ordinal\\n      unless saved.name == value.name do throw (IO.userError \\\"ambiguous event digest\\\")\\n      let _ ← IO.ofExcept (retainFirst saved value)\\n      return false\\n    let (_, _, _) ← PageMap.withWriter journal fun writer => do\\n      let ordinal ← getNat writer.get \\\"count\\\"\\n      putChunks writer \\\"entry\\\" ordinal bytes\\n      putNat writer name ordinal\\n      putNat writer \\\"count\\\" (ordinal+1)\\n      let turn := value.turn\\n      writer.put (\\\"turn:\\\" ++ turn.name) (some ((toJson turn).compress.toUTF8))\\n      putNat writer (key (\\\"posting:\\\" ++ turn.name) ordinal) ordinal\\n      putNat writer (\\\"latest:\\\" ++ turn.name) (ordinal+1)\\n    return true\\n\\ndef lookup? (journal : PageMap.Snapshot) (kind : String)\\n    (occurrence : Occurrence) : IO (Option Entry) := do\\n  let name := Index.contentKey (kind, occurrence)\\n  let some encoded ← journal.get (\\\"event:\\\" ++ name) | return none\\n  let ordinal ← IO.ofExcept (payloadSize (some encoded))\\n  unless ordinal < (← getNat journal.get \\\"count\\\") do\\n    throw (IO.userError \\\"native event point is outside its committed journal\\\")\\n  let value ← entry journal ordinal\\n  unless value.name == name && value.payload.kind == kind && value.payload.occurrence == occurrence do\\n    throw (IO.userError \\\"native event point lookup changed its identity\\\")\\n  return some value\\n\\ndef turnEntries (journal : PageMap.Snapshot) (turn : Turn) : IO (Array Entry) := do\\n  let mut values := #[]\\n  for (ordinal, indexed) in ← Persistence.Store.directory journal (\\\"posting:\\\" ++ turn.name) do\\n    unless ordinal == indexed do throw (IO.userError \\\"invalid event turn posting\\\")\\n    let value ← entry journal ordinal\\n    unless value.turn == turn do throw (IO.userError \\\"ambiguous event turn digest\\\")\\n    values := values.push value\\n  return values.qsort fun a b => if a.clock.domain == b.clock.domain then a.clock.nanos < b.clock.nanos\\n    else a.clock.domain < b.clock.domain\\n\\ndef knowledge (source : PageMap.Snapshot) (known : List String) (uncertain : Bool)\\n    (archive : Option String := none) : IO Knowledge := do\\n  let indexed ← if let some reader ← Index.open? source .database .shared then\\n      pure (some ({head := reader.index.head, storage := .database, producer := reader.manifest.implementation} : IndexAt))\\n    else if let some reader ← Index.open? source .user .shared then\\n      pure (some ({head := reader.index.head, storage := .user, producer := reader.manifest.implementation} : IndexAt))\\n    else pure none\\n  let archived ← archive.bindM fun path => do\\n    if (.mk path : System.FilePath).normalize == source.directory.normalize then return some source.head\\n    return (← PageMap.open? (.mk path)).map (·.head)\\n  return ⟨source.head, indexed, known, uncertain, archive, archived⟩\\n\\ndef originalAt? (source : PageMap.Snapshot) (head : PageMap.Head) : IO (Option PageMap.Snapshot) := do\\n  if (← Build.changes source head).isNone then return none\\n  return some {source with head}\\n\\ndef indexAt? (source : PageMap.Snapshot) (known : Knowledge) : IO (Option Index.Reader) := do\\n  let some saved := known.indexed | return none\\n  let some current ← PageMap.open? (← Index.directory source saved.storage .shared) | return none\\n  unless current.head.identity == saved.head.identity && current.head.authority == saved.head.authority &&\\n      saved.head.bytes ≤ current.head.bytes do return none\\n  let index := {current with head := saved.head}\\n  let some manifest ← Index.manifest? index | return none\\n  unless manifest.implementation == saved.producer && saved.producer == Index.implementation &&\\n      manifest.scope == .shared && manifest.source.identity == source.head.identity do return none\\n  let some original ← originalAt? source known.source | return none\\n  unless ← Index.sameSources original manifest.source do return none\\n  return some ⟨index, manifest⟩\\n\\ndef ownerKeys (known : List String) : Array String :=\\n  (known.filterMap fun value => match value.splitOn \\\":\\\" with\\n    | [\\\"h\\\", owner] | [\\\"g\\\", owner, _] | [\\\"e\\\", owner, _, _, _] => some owner\\n    | _ => none).eraseDups.toArray\\n\\ndef acknowledged (keys : List String) (doc : Document) (row : Read) : Bool :=\\n  let whole := keys.any fun value => match value.splitOn \\\":\\\" with\\n    | [\\\"h\\\", owner] => owner == doc.owner\\n    | [\\\"g\\\", owner, result] => owner == doc.owner &&\\n        doc.source.any (fun text => Persistence.selectionKey (.text text) == result)\\n    | _ => false\\n  let spans := keys.filterMap fun value => match value.splitOn \\\":\\\" with\\n    | [\\\"e\\\", owner, result, first, limit] =>\\n        if owner == doc.owner && doc.source.any (fun text => Persistence.selectionKey (.text text) == result) then do\\n          let a ← first.toNat?\\n          let b ← limit.toNat?\\n          if a < b then some (owner,a,b) else none\\n        else none\\n    | _ => none\\n  whole || ({bindings := spans.toArray} : Presentation).coversBinding row.binding\\n\\ndef presentation (source : PageMap.Snapshot) (known : Knowledge) : IO Presentation := do\\n  let some original ← originalAt? source known.source | return {}\\n  let archive ← known.archive.bindM fun path => do\\n    let some head := known.archived | return none\\n    let some current ← PageMap.open? (.mk path) | return none\\n    originalAt? current head\\n  let sources := #[original] ++ archive.toArray\\n  let mut ranges := #[]\\n  for snapshot in sources do\\n    let reader ← NodeReader.new snapshot\\n    for owner in ownerKeys known.acknowledged do\\n      let some id ← Build.ownerId? snapshot owner | continue\\n      let doc ← Build.document reader id\\n      let some catalog := ObservationContext.recorded snapshot.head.identity doc | continue\\n      ranges := ranges ++ (catalog.located.flatMap (·.originalRows) |>.filter (acknowledged known.acknowledged doc) |>.map (·.source))\\n  return {ranges := compactRanges ranges}\\n\\nabbrev Starts := Std.HashMap Occurrence (String × Knowledge × String)\\n\\nstructure NativeFeedback where\\n  graph : Graph\\n  unknown : Nat := 0\\n  ambiguous : Nat := 0\\n\\nabbrev WitnessAt := Occurrence × Nat × Nat × WitnessKind × String\\n\\ndef witnessAt (edge : Consumption) : WitnessAt :=\\n  (edge.consumer,edge.inputFirst,edge.inputLimit,edge.kind,edge.term)\\n\\n/-- A literal may occur in several earlier outputs. Such an ambiguous match\\ndoes not identify which re-read was useful, and cannot earn a missing label. -/\\ndef nativeCandidates (facts : Array Fact) : Array (Consumption × Range) := Id.run do\\n  let mut candidates := #[]\\n  for fact in facts do\\n    let .consumed edge := fact | continue\\n    for source in edge.rows do\\n      if (consumedSource? edge source).isSome then candidates := candidates.push (edge,source)\\n  return candidates\\n\\ndef nativeFeedback (source : PageMap.Snapshot) (starts : Starts) (facts : Array Fact)\\n    (graph : Graph) (deadline : Nat) : IO NativeFeedback := do\\n  let candidates := nativeCandidates facts\\n  let mut witnesses : Std.HashMap WitnessAt (Std.HashSet (Occurrence × Option Range)) := {}\\n  for fact in facts do\\n    let .consumed edge := fact | continue\\n    let rows := if edge.rows.isEmpty then #[none] else edge.rows.map some\\n    for range in rows do\\n      let key := witnessAt edge\\n      witnesses := witnesses.insert key ((witnesses[key]?.getD {}).insert (edge.producer,range))\\n  let mut groups : Std.HashMap Occurrence (Array (Consumption × Range)) := {}\\n  let mut result : NativeFeedback := ⟨graph,0,0⟩\\n  for (edge,range) in candidates do\\n    if (witnesses[witnessAt edge]?.getD {}).size != 1 then\\n      result := {result with ambiguous := result.ambiguous+1}\\n      continue\\n    groups := groups.insert edge.producer (groups[edge.producer]?.getD #[] |>.push (edge,range))\\n  for (producer,uses) in groups do\\n    if (← IO.monoMsNow) ≥ deadline then throw (IO.userError \\\"native usage deadline\\\")\\n    let some (query,known,_) := starts[producer]? | result := {result with unknown := result.unknown+1}; continue\\n    let indexed ← indexAt? source known\\n    unless completeKnowledge known indexed.isSome do\\n      result := {result with unknown := result.unknown+1}; continue\\n    let some indexed := indexed | throw (IO.userError \\\"missing checked pre-read index\\\")\\n    let subjects := uses.foldl (fun subjects (_,range) => subjects.insert range.subject) ({} : Std.HashSet Subject)\\n    let mut stored := #[]\\n    for subject in subjects do\\n      let found ← indexed.lookup (.subject subject) 100000 deadline\\n      unless found.complete do throw (IO.userError \\\"incomplete native stored-read evidence\\\")\\n      stored := stored ++ found.facts.filterMap (fun fact => match fact with\\n        | .read read => if read.occurrence != producer then some read.source else none\\n        | _ => none)\\n    let shown ← presentation source known\\n    for (edge,requested) in uses do\\n      -- Without a pre-existing original there was no missed memory to label.\\n      unless covered requested stored do continue\\n      let missing := omittedRanges requested stored shown.ranges\\n      for range in if missing.isEmpty then #[requested] else missing do\\n        let some checked := consumedSource? edge range | throw (IO.userError \\\"usage escaped its consumption witness\\\")\\n        result := {result with graph := ← IO.ofExcept (recordConsumed result.graph checked query stored shown.ranges)}\\n  return result\\n\\nstructure Replay where\\n  consumed : Array Fact := #[]\\n  usage : Array Fact := #[]\\n  consumers : Array Occurrence := #[]\\n  pending : Nat := 0\\n  unknown : Nat := 0\\n  origins : Array Provenance.Origin := #[]\\n  ambiguousNativeUses : Nat := 0\\n\\ndef acceptPublishedOutput (ownerId : Option Nat) (previous observed : Trace) : Trace :=\\n  if ownerId.isSome then observed else previous\\n\\ntheorem unowned_output_keeps_public_trace (previous observed : Trace) :\\n    acceptPublishedOutput none previous observed = previous := rfl\\n\\n/-- All original body/row work happens in the background. A finish without\\nan exact published native owner remains pending instead of inventing evidence. -/\\ndef replay (source : PageMap.Snapshot) (values : Array Entry) (deadline : Nat) : IO Replay := do\\n  let mut result : Replay := {}\\n  let mut trace : Trace := {}\\n  let mut domain := \\\"\\\"\\n  let mut starts : Starts := {}\\n  let mut locations : Std.HashMap Occurrence (Array OutputRow) := {}\\n  let mut observed : Trace := {}\\n  let mut observedLocations : Std.HashMap Occurrence (Array OutputRow) := {}\\n  let mut usage : Graph := .empty\\n  for value in values do\\n    if (← IO.monoMsNow) ≥ deadline then throw (IO.userError \\\"synaptic replay deadline\\\")\\n    if domain != value.clock.domain then\\n      let projected ← IO.ofExcept (trace.locate locations)\\n      let privateTrace ← IO.ofExcept (observed.locate observedLocations)\\n      let feedback ← nativeFeedback source starts privateTrace.graph.snapshot usage deadline\\n      usage := feedback.graph\\n      result := {result with consumed := result.consumed ++ projected.graph.snapshot}\\n      result := {result with\\n        unknown := result.unknown+feedback.unknown\\n        ambiguousNativeUses := result.ambiguousNativeUses+feedback.ambiguous}\\n      trace := {}; starts := {}; locations := {}; domain := value.clock.domain\\n      observed := {}; observedLocations := {}\\n    if trace.lastOrdinal.any (value.clock.nanos < ·) then\\n      result := {result with unknown := result.unknown+1}\\n      continue\\n    match value.payload with\\n    | .start occurrence work query known =>\\n      let .ok (command,format) := invocationData work | result := {result with unknown := result.unknown+1}; continue\\n      if let some (_,_,original) := starts[occurrence]? then\\n        unless original == work do throw (IO.userError \\\"native start changed its complete invocation\\\")\\n      trace ← IO.ofExcept (trace.start occurrence value.clock.nanos command format)\\n      observed ← IO.ofExcept (observed.start occurrence value.clock.nanos command format)\\n      starts := starts.insert occurrence (query, known, work)\\n      result := {result with consumers := result.consumers.push occurrence}\\n    | .finish occurrence name input response archive =>\\n      if !trace.starts.contains occurrence then result := {result with unknown := result.unknown+1}; continue\\n      let tool : Plugin.ToolEvent := {name,useId := occurrence.useId,input,response}\\n      let some started := trace.starts[occurrence]? | throw (IO.userError \\\"missing observed start\\\")\\n      let work := Plugin.canonicalToolWork tool\\n      let some (_,_,original) := starts[occurrence]? |\\n        throw (IO.userError \\\"native finish has no complete invocation\\\")\\n      unless work == original do throw (IO.userError \\\"native finish changed its complete invocation\\\")\\n      let .ok (command,format) := invocationData work |\\n        throw (IO.userError \\\"native finish has no structured invocation\\\")\\n      unless command == started.command && format == started.format do\\n        throw (IO.userError \\\"native finish changed its observed invocation\\\")\\n      let expected := (Plugin.compileOperationOutcomes (.text occurrence.session) (.text occurrence.turn) tool).2\\n      let localId ← findNode? source expected\\n      let localId ← localId.filterM fun id => return (← source.get (key \\\"member\\\" id)).isSome\\n      let located ← if let some id := localId then pure (some (source, id)) else do\\n        let some path := archive | pure none\\n        let some archived ← PageMap.open? (.mk path) | pure none\\n        let some id ← findNode? archived expected | pure none\\n        if (← archived.get (key \\\"member\\\" id)).isSome then pure (some (archived, id)) else pure none\\n      let some (recorded, id) := located | do\\n        if archive.isSome then result := {result with pending := result.pending+1}\\n        else result := {result with unknown := result.unknown+1}\\n        continue\\n      let currentOriginal := localId.isSome\\n      if currentOriginal then\\n        let origin : Provenance.Origin :=\\n          ⟨id, occurrence, value.clock.domain, started.ordinal, value.clock.nanos, value.receivedUnixMs⟩\\n        result := {result with origins := result.origins.push origin}\\n      let originalReader ← NodeReader.new recorded\\n      let doc ← Build.document originalReader id\\n      unless doc.occurrences.contains occurrence && doc.workText == some (Plugin.canonicalToolWork tool) do\\n        throw (IO.userError \\\"native synaptic observation changed its exact occurrence\\\")\\n      let some raw := doc.source | result := {result with unknown := result.unknown+1}; continue\\n      let outputFormat := if (Json.parse raw).isOk then DataFormat.json else .text\\n      let completed ← IO.ofExcept (trace.finish occurrence value.clock.nanos raw outputFormat)\\n      observed ← IO.ofExcept (observed.finish occurrence value.clock.nanos raw outputFormat)\\n      -- Foreign private work can label usage of this DB's memory, but cannot\\n      -- publish its terms or consumption edges into the shared DB lane.\\n      trace := acceptPublishedOutput localId trace completed\\n      let located := ObservationContext.locate recorded.head.identity doc completed\\n      observedLocations := observedLocations.insert occurrence\\n        ((ObservationContext.locate recorded.head.identity doc observed).flatMap (·.rows))\\n      if currentOriginal then locations := locations.insert occurrence (located.flatMap (·.rows))\\n      -- A general result does not state which part was requested as a read.\\n      -- Locate all its consumption witnesses, but do not label every returned\\n      -- field \\\"missing then read\\\". Native usage needs its own consumption/ACK\\n      -- evidence; the certified file-read policy stays explicit here.\\n      let reads := located.filter (·.read.source.file?.isSome)\\n      if !reads.isEmpty then\\n        if let some (query, known, _) := starts[occurrence]? then\\n          let storedIndex ← indexAt? source known\\n          -- Missing/unverifiable pre-read knowledge cannot earn a read label.\\n          -- Do not decode every acknowledged original only to discard the\\n          -- resulting presentation after the same eligibility decision.\\n          unless completeKnowledge known storedIndex.isSome do\\n            result := {result with unknown := result.unknown+1}\\n            continue\\n          let mut stored := #[]\\n          if let some index := storedIndex then\\n            let files := reads.foldl (fun files read => files.insert read.read.source.subject) ({} : Std.HashSet Subject)\\n            for file in files do\\n              let found ← index.lookup (.subject file) 100000 deadline\\n              unless found.complete do throw (IO.userError \\\"incomplete stored-read evidence\\\")\\n              stored := stored ++ found.facts.filterMap (fun fact => match fact with\\n                | .read read => if read.occurrence != occurrence then some read.source else none\\n                | _ => none)\\n          let shown ← presentation source known\\n          let feedback : Feedback := ({graph := usage, delivered := shown} : Feedback).start occurrence\\n          let feedback ← IO.ofExcept (feedback.completedRead occurrence query (reads.map (·.read.source)) stored)\\n          usage := feedback.graph\\n    | .answer occurrence query text known =>\\n      if known.uncertain then result := {result with unknown := result.unknown+1}; continue\\n      let shown ← presentation source known\\n      let feedback ← IO.ofExcept (({graph := usage, delivered := shown} : Feedback).answer occurrence query text)\\n      usage := feedback.graph\\n  let projected ← IO.ofExcept (trace.locate locations)\\n  let privateTrace ← IO.ofExcept (observed.locate observedLocations)\\n  let feedback ← nativeFeedback source starts privateTrace.graph.snapshot usage deadline\\n  return {result with\\n    consumed := result.consumed ++ projected.graph.snapshot, usage := feedback.graph.snapshot\\n    unknown := result.unknown+feedback.unknown,ambiguousNativeUses := result.ambiguousNativeUses+feedback.ambiguous}\\n\\nstructure Checkpoint where\\n  source : PageMap.Head\\n  index : String\\n  count : Nat\\n  implementation : String\\n  deriving BEq, ToJson, FromJson\\n\\ndef lane (storage : Sidecar.Storage) : String := if storage == .database then \\\"database\\\" else \\\"user\\\"\\n\\ndef checkpoint? (journal : PageMap.Snapshot) (name : String) : IO (Option Checkpoint) := do\\n  (← journal.get name).mapM (Index.decode (α := Checkpoint))\\n\\ndef Checkpoint.sameInput (previous : Checkpoint) (source : PageMap.Snapshot)\\n    (index : String) (count : Nat) (limit : Nat := 16) : IO Bool := do\\n  unless previous.index == index && previous.count == count &&\\n      previous.implementation == Eggshell.Synapses.Journal.implementation do return false\\n  Index.sameSources source previous.source limit\\n\\ndef mark (source : PageMap.Snapshot) (name : String) (checkpoint : Checkpoint) : IO Unit := do\\n  let bytes ← Index.checkedBytes checkpoint\\n  withPublication source fun journal => do\\n    let _ ← PageMap.withWriter journal fun writer => do\\n      if (← writer.get name) != some bytes then writer.put name (some bytes)\\n\\n/-- Constant metadata probe; no journal entries or original bodies are read. -/\\ndef required (source : PageMap.Snapshot) (storage : Sidecar.Storage := .database) : IO Bool := do\\n  let some journal ← open? source | return false\\n  let some reader ← Index.open? source storage .shared | return true\\n  let some previous ← checkpoint? journal (\\\"checkpoint:\\\" ++ lane storage) | return true\\n  return !(← previous.sameInput source reader.index.head.identity (← getNat journal.get \\\"count\\\"))\\n\\nstructure Result where\\n  turns : Nat := 0\\n  consumed : Nat := 0\\n  usage : Nat := 0\\n  pending : Nat := 0\\n  unknown : Nat := 0\\n  complete : Bool := true\\n  ambiguousNativeUses : Nat := 0\\n  deriving ToJson, FromJson\\n\\ndef publish (source : PageMap.Snapshot) (storage : Sidecar.Storage) (result : Replay) (deadline : Nat) : IO Unit := do\\n  let some shared ← Index.open? source storage .shared | throw (IO.userError \\\"synaptic source index is not warm\\\")\\n  let mut old := #[]\\n  for consumer in result.consumers.toList.eraseDups do\\n    let found ← shared.lookup (.consumer consumer) 100000 deadline\\n    unless found.complete do throw (IO.userError \\\"incomplete consumer retirement evidence\\\")\\n    old := old ++ found.facts\\n  let previous := old.foldl (fun set fact => set.insert fact) ({} : Std.HashSet Fact)\\n  let wanted := result.consumed.foldl (fun set fact => set.insert fact) ({} : Std.HashSet Fact)\\n  let _ ← Index.publishDelta source storage .shared (some shared.manifest.source) {\\n    removed := old.filter (!wanted.contains ·), added := result.consumed.filter (!previous.contains ·) }\\n  if result.usage.isEmpty then return\\n  if let some usageReader ← Index.open? source .user .usage then\\n    let _ ← Index.publishDelta source .user .usage (some usageReader.manifest.source) {added := result.usage}\\n  else\\n    let cache ← Index.prepare source .user .usage\\n    let _ ← Index.replace source .user .usage ((← Index.allFacts cache) ++ result.usage)\\n\\n/-- Background replay is bounded by turns and a deadline. Publication is\\nidempotent; checkpoint failure leaves the same immutable events replayable. -/\\ndef refresh (source : PageMap.Snapshot) (storage : Sidecar.Storage) (deadline : Nat)\\n    (limit : Nat := 8) : IO Result := do\\n  let _ ← Build.refresh source storage\\n  let some journal ← open? source | return {}\\n  let some reader ← Index.open? source storage .shared | throw (IO.userError \\\"synaptic source index is not warm\\\")\\n  let count ← getNat journal.get \\\"count\\\"\\n  let expected : Checkpoint := ⟨source.head, reader.index.head.identity, count, implementation⟩\\n  let checkpointKey := \\\"checkpoint:\\\" ++ lane storage\\n  if let some previous ← checkpoint? journal checkpointKey then\\n    if ← previous.sameInput source expected.index count (source.head.revision-previous.source.revision+1) then\\n      if previous != expected then mark source checkpointKey expected\\n      return {}\\n  let turns ← journal.foldRange ⟨\\\"turn:\\\", \\\"turn;\\\"⟩ (fun turns row => do\\n    let some bytes := row.2 | return turns\\n    let turn ← Index.decode (α := Turn) bytes\\n    unless row.1 == \\\"turn:\\\" ++ turn.name do throw (IO.userError \\\"foreign event turn directory\\\")\\n    return turns.push turn) #[]\\n  let mut result : Result := {}\\n  for turn in turns do\\n    let checkpoint : Checkpoint := ⟨source.head, reader.index.head.identity, ← getNat journal.get (\\\"latest:\\\" ++ turn.name), implementation⟩\\n    let turnKey := \\\"processed:\\\" ++ lane storage ++ \\\":\\\" ++ turn.name\\n    if let some previous ← checkpoint? journal turnKey then\\n      if ← previous.sameInput source checkpoint.index checkpoint.count (source.head.revision-previous.source.revision+1) then continue\\n    if result.turns ≥ limit || (← IO.monoMsNow) ≥ deadline then\\n      result := {result with complete := false}\\n      break\\n    let replayed ← replay source (← turnEntries journal turn) deadline\\n    if storage == .database then Provenance.requirePublished source replayed.origins\\n    publish source storage replayed deadline\\n    if replayed.pending == 0 then mark source turnKey checkpoint\\n    else result := {result with complete := false}\\n    result := {result with\\n      turns := result.turns+1, consumed := result.consumed+replayed.consumed.size\\n      usage := result.usage+replayed.usage.size, pending := result.pending+replayed.pending, unknown := result.unknown+replayed.unknown,\\n      ambiguousNativeUses := result.ambiguousNativeUses+replayed.ambiguousNativeUses}\\n  if result.complete then mark source checkpointKey expected\\n  return result\\n\\n/-- Native maintenance has no executable or numerical-provider configuration. -/\\nstructure Target where\\n  owner : Sidecar.Owner\\n  storage : Sidecar.Storage\\n  deriving BEq, ToJson, FromJson\\n\\ndef registry : IO System.FilePath := do return (← Paths.dataRoot) / \\\"synaptic-targets\\\"\\n\\ndef register (source : PageMap.Snapshot) (writable : Bool) : IO Unit := do\\n  let owner := Sidecar.Owner.ofSnapshot source\\n  let (storage, _) ← Sidecar.destination owner writable\\n  let target : Target := ⟨owner, storage⟩\\n  let root ← registry\\n  FileSystem.rejectSymlinkAncestors root\\n  FileSystem.privateDirectory root\\n  FileSystem.immutableBytes (root / (Index.contentKey target ++ \\\".json\\\")) (← Index.checkedBytes target)\\n\\ndef targets : IO (Array (System.FilePath × Target)) := do\\n  let root ← registry\\n  if !(← root.pathExists) then return #[]\\n  let mut result := #[]\\n  for entry in ← root.readDir do\\n    if !entry.fileName.endsWith \\\".json\\\" then continue\\n    try\\n      let bytes ← FileSystem.boundedBytes entry.path 65536\\n      let target ← Index.decode (α := Target) bytes\\n      unless entry.fileName == Index.contentKey target ++ \\\".json\\\" do\\n        throw (IO.userError \\\"foreign native maintenance target\\\")\\n      result := result.push (entry.path, target)\\n    catch error => IO.eprintln s!\\\"Eggshell retained an unreadable native maintenance target: {error}\\\"\\n  return result\\n\\nend Eggshell.Synapses.Journal\\n\"],[\"PluginModel.lean\",\"module\\n\\npublic import Eggshell.Config\\npublic import Eggshell.Blake3\\npublic import Eggshell.Lifecycle\\npublic import Eggshell.Receipt\\npublic import Eggshell.SourceEvidence\\npublic import Eggshell.SourceObservation\\npublic import Eggshell.ContentCapture\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Plugin\\n\\nopen Lean\\n\\ninductive Projection where\\n  | automatic\\n  | none\\n  | roots (values : List String)\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\ninductive SemanticSearchStatus where\\n  | notRequested | completed | pending | timedOut | failed\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\ninductive SearchRoute where\\n  | configured | lexical\\n  deriving Repr, DecidableEq, ToJson, FromJson\\n\\n/-- Runtime observations do not authorize equality or completion. -/\\nstructure SearchTrace where\\n  semantic : SemanticSearchStatus\\n  route : SearchRoute\\n  semanticMs : Nat\\n  lexicalMs : Nat\\n  warmMs : Nat := 0\\n  warmRequests : Nat := 0\\n  deriving Repr, ToJson, FromJson\\n\\nstructure DeliveryOffer where\\n  id : String\\n  stamp : RequestStamp\\n  graphs : List String\\n  text : String\\n  reason : String\\n  search : Option SearchTrace := none\\n  deriving Repr, ToJson, FromJson\\n\\nstructure ThreadState where\\n  profile : String\\n  /-- When false, hooks neither stage work nor read or send graph context. -/\\n  enabled : Bool := true\\n  nextProfile : Option String := none\\n  nextProjection : Option Projection := none\\n  deliveredGraphs : List String := []\\n  /-- Native history may have discarded previously visible staged Outcomes. -/\\n  afterCompaction : Bool := false\\n  lastHandoff : String := \\\"\\\"\\n  lastReason : String := \\\"\\\"\\n  lastSearch : Option SearchTrace := none\\n  /-- Record first versus subsequent eligible searches, including failed or empty results.\\n  This diagnostic marker is independent of acknowledgement, compaction and deadline allocation. -/\\n  searchStarted : Bool := false\\n  epoch : Nat := 0\\n  offers : List DeliveryOffer := []\\n  deriving Repr, ToJson, FromJson\\n\\n/-- Temporary claims expire; only client acknowledgements persist delivery. -/\\ndef ThreadState.deliveryClaims (state : ThreadState) (turn : String) (now : Nat) : List String :=\\n  (state.deliveredGraphs ++ (state.offers.filter (fun offer =>\\n    offer.stamp.accepts turn state.epoch now)).flatMap (·.graphs)).eraseDups\\n\\ntheorem expired_offer_is_not_a_claim (state : ThreadState) (turn : String) (now : Nat)\\n    (expired : ∀ offer ∈ state.offers, offer.stamp.accepts turn state.epoch now = false) :\\n    state.deliveryClaims turn now = state.deliveredGraphs.eraseDups := by\\n  have empty : state.offers.filter (fun offer => offer.stamp.accepts turn state.epoch now) = [] := by\\n    apply List.filter_eq_nil_iff.mpr\\n    intro offer present\\n    simp [expired offer present]\\n  simp [ThreadState.deliveryClaims, empty]\\n\\nstructure ToolEvent where\\n  name : String\\n  useId : String\\n  input : String\\n  response : String\\n  source : Option SourceEvidence.Capture := none\\n  contentInputs : Option SourceEvidence.Capture := none\\n  correspondence : Option ContentCapture.Captured := none\\n  deriving Repr, ToJson, FromJson\\n\\nstructure PendingTurn where\\n  sessionId : String\\n  turnId : String\\n  cwd : String\\n  prompt : String\\n  profile : String\\n  semanticMatcher : Option (List String)\\n  read : List String\\n  write : Option String\\n  handoffChars : Nat\\n  localUnion : Bool := true\\n  projection : Projection\\n  /--\\n  Native occurrences awaiting a possible PostToolUse result. Codex may omit the\\n  terminal hook, so this state is correlation only and never execution authority.\\n  -/\\n  inFlight : List ToolEvent := []\\n  tools : List ToolEvent := []\\n  /-- Related dependency descriptors, queued for the independent observer.\\n  These are locators/previous fingerprints, never evidence of new contents. -/\\n  sources : List SourceEvidence.File := []\\n  finalMessage : Option String := none\\n  closed : Bool := false\\n  deriving Repr, ToJson, FromJson\\n\\nstructure Promotion where\\n  outcomeRelations : List Value\\n\\n/-- The indexer receives the bounded owner view returned after DB publication,\\n    never from a merely compiled or staged turn. It is not a whole DB image. -/\\nstructure CommittedPromotion where\\n  snapshot : Graph\\n  outcomeRelations : List Value\\n  owners_in_snapshot : ∀ owner ∈ outcomeRelations, owner ∈ snapshot.values\\n\\ndef committedPromotion? (snapshot : Graph) (promotion : Promotion) :\\n    Option CommittedPromotion :=\\n  if members : promotion.outcomeRelations ⊆ snapshot.values then\\n    some {\\n      snapshot := snapshot\\n      outcomeRelations := promotion.outcomeRelations\\n      owners_in_snapshot := members }\\n  else none\\n\\ntheorem committedPromotion?_identity {snapshot : Graph} {promotion : Promotion}\\n    {committed : CommittedPromotion}\\n    (accepted : committedPromotion? snapshot promotion = some committed) :\\n    committed.snapshot = snapshot ∧\\n      committed.outcomeRelations = promotion.outcomeRelations := by\\n  unfold committedPromotion? at accepted\\n  split at accepted\\n  · cases accepted\\n    exact ⟨rfl, rfl⟩\\n  · cases accepted\\n\\ntheorem committed_index_owner_present (promotion : CommittedPromotion)\\n    (owner : Value) (present : owner ∈ promotion.outcomeRelations) :\\n    owner ∈ promotion.snapshot.values := promotion.owners_in_snapshot owner present\\n\\ndef prepareCommitted (snapshot : Graph)\\n    (promotion : Promotion) : IO CommittedPromotion := do\\n  let some committed := committedPromotion? snapshot promotion |\\n    throw (IO.userError \\\"published snapshot is missing a promoted outcome\\\")\\n  pure committed\\n\\nstructure SessionFiles where\\n  directory : System.FilePath\\n  state : System.FilePath\\n  pending : System.FilePath\\n  lock : System.FilePath\\n\\ndef safeSession (session : String) : Except String String :=\\n  if session != \\\"\\\" && session.toList.all fun character =>\\n      character.isAlphanum || character == '-' || character == '_' then\\n    pure session\\n  else throw \\\"Codex session ID contains a path-unsafe character\\\"\\n\\n/--\\nShared control-plane state must be visible to both Codex hooks and `!egg`.\\n`PLUGIN_DATA` is hook-only on some hosts, so using it would split one session\\nacross two directories. This root stores session state, daemon coordination,\\nand disposable matcher data; project-selected `.egg` authorities remain the\\nper-turn paths snapshotted in `PendingTurn`.\\n-/\\ndef dataRoot : IO System.FilePath := do\\n  Paths.dataRoot\\n\\ndef sessionFiles (session : String) : IO SessionFiles := do\\n  let safe ← match safeSession session with\\n    | .ok safe => pure safe\\n    | .error message => throw (IO.userError message)\\n  let directory := (← dataRoot) / \\\"sessions\\\" / safe\\n  pure {\\n    directory\\n    state := directory / \\\"state.json\\\"\\n    pending := directory / \\\"pending.json\\\"\\n    lock := directory / \\\"state\\\"\\n  }\\n\\ndef stateJsonDefaults : List (String × Json) :=\\n  [(\\\"searchStarted\\\", toJson false), (\\\"epoch\\\", toJson (0 : Nat)), (\\\"offers\\\", toJson ([] : List DeliveryOffer))]\\n\\ndef pendingJsonDefaults : List (String × Json) := [(\\\"closed\\\", toJson false)]\\n\\n/-- Add only fields introduced by this runtime. Existing malformed fields must\\n    still fail validation rather than being silently replaced. -/\\ndef readJson? [FromJson α] (path : System.FilePath)\\n    (defaults : List (String × Json) := []) : IO (Option α) := do\\n  if !(← path.pathExists) then pure none\\n  else\\n    let text ← IO.FS.readFile path\\n    let parsed ← match Json.parse text with\\n      | .ok json => pure json\\n      | .error message => throw (IO.userError s!\\\"{path}: {message}\\\")\\n    let parsed := match parsed with\\n      | .obj _ => defaults.foldl (fun json (key, value) =>\\n          if (json.getObjVal? key).isOk then json else json.setObjVal! key value) parsed\\n      | _ => parsed\\n    match fromJson? parsed with\\n    | .ok value => pure (some value)\\n    | .error message => throw (IO.userError s!\\\"{path}: {message}\\\")\\n\\ndef writeJson [ToJson α] (path : System.FilePath) (value : α) : IO Unit := do\\n  let path := ((← IO.currentDir) / path).normalize\\n  if let some parent := path.parent then Persistence.privateDirectory parent\\n  -- The receipt must survive a client or manager exit before its queued work\\n  -- is consumed. Publish only after the temporary bytes have been synced.\\n  FileSystem.atomicBytes path (toJson value |>.compress |>.toUTF8)\\n\\ndef readBoundedJson [FromJson α] (path : System.FilePath) (limit : Nat) : IO α := do\\n  let bytes ← FileSystem.boundedBytes path limit\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid JSON text encoding\\\")\\n  IO.ofExcept (Json.parse text >>= fromJson?)\\n\\ndef removeIfExists (path : System.FilePath) : IO Unit := do\\n  if ← path.pathExists then IO.FS.removeFile path\\n\\ndef withSession (session : String) (action : SessionFiles → IO α) : IO α := do\\n  let files ← sessionFiles session\\n  Persistence.privateDirectory files.directory\\n  Persistence.withLockWithin files.lock 100 (action files)\\n\\n/-- Corrupt control state is retained for diagnosis, never repeatedly parsed. -/\\ndef quarantine (path : System.FilePath) : IO Unit := do\\n  if ← path.pathExists then\\n    let suffix := toString (← IO.monoNanosNow)\\n    IO.FS.rename path (.mk (path.toString ++ \\\".corrupt-\\\" ++ suffix))\\n\\ndef readState? (files : SessionFiles) : IO (Option ThreadState) := do\\n  try readJson? files.state stateJsonDefaults\\n  catch error =>\\n    quarantine files.state\\n    let disabled : ThreadState := {\\n      profile := \\\"work\\\", enabled := false,\\n      lastReason := s!\\\"memory disabled after invalid session state: {error}\\\" }\\n    writeJson files.state disabled\\n    pure (some disabled)\\n\\ndef readPendingBase? (files : SessionFiles) : IO (Option PendingTurn) := do\\n  try readJson? files.pending pendingJsonDefaults\\n  catch error =>\\n    quarantine files.pending\\n    IO.eprintln s!\\\"Eggshell preserved an unreadable staged turn: {error}\\\"\\n    pure none\\n\\ndef toolDirectory (files : SessionFiles) (turn : String) : System.FilePath :=\\n  files.directory / \\\"tools\\\" / (Blake3.hex (Blake3.digest \\\"eggshell.turn\\\".toUTF8 [turn.toUTF8]))\\n\\n/-- Point-addressed lifecycle metadata, retained after a save job is consumed.\\nA late Stop/result must still have its original turn's destination and scope;\\nit must never borrow the currently active turn's metadata. -/\\ndef closedTurnPath (files : SessionFiles) (turn : String) : System.FilePath :=\\n  files.directory / \\\"closed\\\" /\\n    ((Blake3.hex (Blake3.digest \\\"eggshell.closed-turn\\\".toUTF8 [turn.toUTF8])) ++ \\\".json\\\")\\n\\ndef readClosedTurn? (files : SessionFiles) (turn : String) : IO (Option PendingTurn) := do\\n  let record ← (readJson? (closedTurnPath files turn) pendingJsonDefaults : IO (Option PendingTurn))\\n  pure (record.filter (fun pending => pending.turnId == turn && pending.closed))\\n\\ndef toolReceiptPath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  toolDirectory files turn /\\n    (Blake3.hex (Blake3.digest \\\"eggshell.tool\\\".toUTF8 [useId.toUTF8]) ++ \\\".json\\\")\\n\\ndef ToolEvent.native (tool : ToolEvent) : ToolEvent :=\\n  {tool with source := none,contentInputs := none,correspondence := none}\\n\\ntheorem native_receipt_ignores_source (tool : ToolEvent) (source : Option SourceEvidence.Capture) :\\n    ({tool with source}.native) = tool.native := rfl\\n\\ntheorem native_receipt_ignores_correspondence (tool : ToolEvent)\\n    (contentInputs : Option SourceEvidence.Capture) (correspondence : Option ContentCapture.Captured) :\\n    ({tool with contentInputs,correspondence}.native) = tool.native := rfl\\n\\nstructure SourceCertificate where\\n  stamp : String\\n  bytes : Nat\\n  source : SourceEvidence.Capture\\n  deriving ToJson, FromJson\\n\\nstructure ContentCertificate where\\n  stamp : String\\n  bytes : Nat\\n  captured : ContentCapture.Captured\\n  deriving ToJson, FromJson\\n\\ndef contentCertificatePath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  files.directory / \\\"correspondence\\\" / (toolDirectory files turn).fileName.getD \\\"\\\" /\\n    (toolReceiptPath files turn useId).fileName.getD \\\"\\\"\\n\\ndef sourceCertificatePath (files : SessionFiles) (turn useId : String) : System.FilePath :=\\n  files.directory / \\\"sources\\\" / (toolDirectory files turn).fileName.getD \\\"\\\" /\\n    (toolReceiptPath files turn useId).fileName.getD \\\"\\\"\\n\\n/-- Parse bytes and observe their version through the same held descriptor.\\nA replaced or concurrently edited native receipt cannot authorize a companion. -/\\ndef readNativeTool? (path : System.FilePath) : IO (Option (ToolEvent × FileSystem.ReadVersion)) := do\\n  if (← FileSystem.regularMetadata? path).isNone then return none\\n  let handle ← FileSystem.openRead path.toString\\n  let before ← FileSystem.readVersion handle\\n  let mut bytes := ByteArray.empty\\n  while bytes.size < before.bytes do\\n    let count := min 4096 (before.bytes - bytes.size)\\n    let page ← FileSystem.readPage handle bytes.size.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    if page.size != count then throw (IO.userError \\\"short native receipt read\\\")\\n    bytes := bytes ++ page\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\\n  unless FileSystem.stableRead before after current bytes.size do\\n    throw (IO.userError \\\"native receipt changed during read\\\")\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"native receipt is not UTF-8\\\")\\n  let tool ← IO.ofExcept (Json.parse text >>= fromJson? (α := ToolEvent))\\n  pure (some (tool.native, before))\\n\\ndef attachCertificate (files : SessionFiles) (turn : String)\\n    (tool : ToolEvent) (version : FileSystem.ReadVersion) : IO ToolEvent := do\\n  let mut result := tool.native\\n  try\\n    if let some certificate ← (readJson? (sourceCertificatePath files turn tool.useId) :\\n        IO (Option SourceCertificate)) then\\n      if certificate.stamp == version.stamp && certificate.bytes == version.bytes then\\n        result := {result with source := some certificate.source}\\n  catch _ => pure () -- Optional provenance never discards the native result.\\n  try\\n    if let some certificate ← (readJson? (contentCertificatePath files turn tool.useId) :\\n        IO (Option ContentCertificate)) then\\n      if certificate.stamp == version.stamp && certificate.bytes == version.bytes then\\n        result := {result with correspondence := some certificate.captured}\\n  catch _ => pure ()\\n  return result\\n\\n/-- Journal the immutable body first; provenance is a small, version-bound\\ncompanion. An identical replay performs no body publication. Reusing a native\\nID for different bytes is an error, never replacement of an earlier result. -/\\ndef recordTool (files : SessionFiles) (turn : String) (tool : ToolEvent) : IO Unit := do\\n  let path := toolReceiptPath files turn tool.useId\\n  if let some (previous, _) ← readNativeTool? path then\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"conflicting native tool receipt ID\\\")\\n  else\\n    if let some parent := path.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes path (toJson tool.native |>.compress |>.toUTF8)\\n  if let some source := tool.source then\\n    let some (previous, version) ← readNativeTool? path |\\n      throw (IO.userError \\\"native receipt disappeared before source publication\\\")\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"source certificate belongs to another native result\\\")\\n    let certificate : SourceCertificate := ⟨version.stamp, version.bytes, source⟩\\n    let certificatePath := sourceCertificatePath files turn tool.useId\\n    if let some parent := certificatePath.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes certificatePath (toJson certificate |>.compress |>.toUTF8)\\n  if let some captured := tool.correspondence then\\n    let some (previous,version) ← readNativeTool? path |\\n      throw (IO.userError \\\"native receipt disappeared before content publication\\\")\\n    unless toJson previous == toJson tool.native do\\n      throw (IO.userError \\\"content correspondence belongs to another native result\\\")\\n    let certificate : ContentCertificate := ⟨version.stamp,version.bytes,captured⟩\\n    let certificatePath := contentCertificatePath files turn tool.useId\\n    if let some parent := certificatePath.parent then FileSystem.durableDirectory parent\\n    FileSystem.immutableBytes certificatePath (toJson certificate |>.compress |>.toUTF8)\\n\\ndef recordedTool? (files : SessionFiles) (turn : String) (tool : ToolEvent) : IO (Option ToolEvent) := do\\n  let some (previous, version) ← readNativeTool? (toolReceiptPath files turn tool.useId) | return none\\n  unless toJson previous == toJson tool.native do return none\\n  some <$> attachCertificate files turn previous version\\n\\n/-- Tool bodies are separate immutable receipts, not a growing JSON rewrite per hook. -/\\ndef loadToolReceipts (files : SessionFiles) (pending : PendingTurn) : IO PendingTurn := do\\n  let directory := toolDirectory files pending.turnId\\n  let mut tools := pending.tools\\n  if ← directory.pathExists then\\n    let entries := (← directory.readDir).toList.mergeSort (fun a b => a.fileName ≤ b.fileName)\\n    for entry in entries do\\n      if entry.fileName.endsWith \\\".json\\\" then\\n        try\\n          if let some (native, version) ← readNativeTool? entry.path then\\n            let tool ← attachCertificate files pending.turnId native version\\n            tools := tools.filter (·.useId != tool.useId) ++ [tool]\\n        catch error =>\\n          IO.eprintln s!\\\"Eggshell retained an unreadable tool receipt: {error}\\\"\\n  pure { pending with tools }\\n\\ndef readPending? (files : SessionFiles) : IO (Option PendingTurn) := do\\n  (← readPendingBase? files).mapM (loadToolReceipts files)\\n\\n/-- Immutable queue entries are removed only after the .egg commit succeeds. -/\\ndef queueCheckpoint (files : SessionFiles) (pending : PendingTurn) : IO Unit := do\\n  let key := Blake3.hex (Blake3.digest \\\"eggshell.checkpoint\\\".toUTF8\\n    [(toJson pending).compress.toUTF8])\\n  writeJson (files.directory / \\\"checkpoints\\\" / (key ++ \\\".json\\\")) pending\\n\\n/-- Independent observations have their own immutable identity. No native\\nresult or earlier source certificate is refreshed or attributed a later state. -/\\ndef observationTool (observation : SourceObservation.Observation limit) : ToolEvent :=\\n  let response := (SourceObservation.observationJson observation).compress\\n  let input := (Json.mkObj [(\\\"files\\\", toJson (observation.capture.record.files.map (·.relative)))]).compress\\n  { name := \\\"eggshell.observe_file\\\"\\n    useId := \\\"eggshell-observation:\\\" ++ Blake3.hex (Blake3.digest \\\"eggshell.observation.record\\\".toUTF8\\n      [input.toUTF8, response.toUTF8])\\n    input, response, source := some observation.capture }\\n\\ntheorem observation_binds_new_record (observation : SourceObservation.Observation limit) :\\n    (observationTool observation).source = some observation.capture ∧\\n      (observationTool observation).response = (SourceObservation.observationJson observation).compress :=\\n  ⟨rfl, rfl⟩\\n\\n/-- This save-worker operation observes registered related files regardless of\\nwhich command, program, editor or local provider changed them. The hook never\\ncalls it. Pending scans retain their queue entry and resume at a page cursor. -/\\ndef observeRelatedFiles (files : SessionFiles) (pending : PendingTurn) (deadline : Nat) : IO Bool := do\\n  let workspace := System.FilePath.mk pending.cwd\\n  let dependencies := (pending.tools.flatMap\\n    (fun tool => tool.source.map (·.record.files) |>.getD []) ++ pending.sources).eraseDups\\n  for file in dependencies do SourceObservation.register files.directory workspace file\\n  let mut finished := true\\n  for path in ← SourceObservation.entries files.directory workspace do\\n    if (← IO.monoMsNow) ≥ deadline then return false\\n    let observed ← try SourceObservation.step path workspace (128 * 1024) 256 deadline\\n      catch error =>\\n        IO.eprintln s!\\\"Eggshell retained source history; observation unavailable: {error}\\\"\\n        pure .unverified\\n    match observed with\\n    | .pending => finished := false\\n    | .unverified => pure ()\\n    | .complete snapshot observation =>\\n        if let some observation := observation then\\n          let tool := observationTool observation\\n          -- This durable queue contains the actual data and its certificate.\\n          -- It is not a native tool receipt: the running model has not seen\\n          -- this independent observation and it cannot bind its final answer.\\n          queueCheckpoint files {pending with tools := [tool], sources := [], inFlight := [], finalMessage := none, closed := false}\\n        SourceObservation.acknowledge path snapshot\\n  pure finished\\n\\ndef pendingSelection (pending : PendingTurn) : Config.Selection := {\\n  label := pending.profile\\n  semanticMatcher := pending.semanticMatcher\\n  read := pending.read.map fun raw => { name := raw, path := System.FilePath.mk raw }\\n  write := pending.write.map fun raw => { name := raw, path := System.FilePath.mk raw }\\n  handoffChars := pending.handoffChars\\n  localUnion := pending.localUnion\\n}\\n\\ndef valueEncoding (value : Value) : String :=\\n  Persistence.valueToJson value |>.compress\\n\\ndef indexOwnerKey (owner : Value) : String :=\\n  \\\"owner:\\\" ++ toString (hash owner)\\n\\ndef indexProviderKey (command : List String) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.index-provider\\\".toUTF8 [(toJson command).compress.toUTF8])\\n\\n/-- Executables belong to private installation configuration, never an imported DB. -/\\nstructure IndexTarget where\\n  owner : DB.Sidecar.Owner\\n  command : List String\\n  storage : DB.Sidecar.Storage := .database\\n  deriving Repr, BEq, ToJson, FromJson\\n\\ndef IndexTarget.key (target : IndexTarget) : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.index-target\\\".toUTF8 [(toJson target).compress.toUTF8])\\n\\ndef IndexTarget.indexes (target : IndexTarget) (snapshot : DB.PageMap.Snapshot) : IO System.FilePath := do\\n  pure ((← DB.Sidecar.locate snapshot target.storage).indexes / indexProviderKey target.command)\\n\\ndef indexRegistry : IO System.FilePath := do pure ((← dataRoot) / \\\"index-targets\\\")\\n\\ndef registerIndexTarget (snapshot : DB.PageMap.Snapshot) (command : List String)\\n    (writable : Bool := true) : IO IndexTarget := do\\n  if command.isEmpty then throw (IO.userError \\\"index provider must name an executable\\\")\\n  let owner := DB.Sidecar.Owner.ofSnapshot snapshot\\n  let (storage, _) ← DB.Sidecar.destination owner writable\\n  let target : IndexTarget := {owner, command, storage}\\n  let directory ← indexRegistry\\n  Persistence.rejectSymlinkAncestors directory\\n  Persistence.privateDirectory directory\\n  let path := directory / (target.key ++ \\\".json\\\")\\n  let bytes := (toJson target).compress.toUTF8\\n  unless bytes.size ≤ 65536 do throw (IO.userError \\\"index target exceeds metadata bound\\\")\\n  if ← path.pathExists then\\n    let previous ← FileSystem.boundedBytes path 65536\\n    if previous == bytes then return target\\n    let parsed : Except String IndexTarget := match String.fromUTF8? previous with\\n      | none => .error \\\"invalid index target encoding\\\"\\n      | some text => Json.parse text >>= fromJson?\\n    match parsed with\\n    | .ok _ => throw (IO.userError \\\"conflicting index target digest\\\")\\n    | .error error =>\\n        IO.eprintln s!\\\"Eggshell repairing a damaged index target: {error}\\\"\\n        quarantine path\\n  FileSystem.immutableBytes path bytes\\n  pure target\\n\\ndef registeredIndexTargets : IO (List (System.FilePath × IndexTarget)) := do\\n  let directory ← indexRegistry\\n  if !(← directory.pathExists) then return []\\n  let mut targets := []\\n  for entry in ((← directory.readDir).toList.mergeSort (fun a b => a.fileName ≤ b.fileName)) do\\n    if !entry.fileName.endsWith \\\".json\\\" then continue\\n    try\\n      let target ← (readBoundedJson entry.path 65536 : IO IndexTarget)\\n      unless entry.fileName == target.key ++ \\\".json\\\" && !target.command.isEmpty do\\n        throw (IO.userError \\\"index registry entry disagrees with its identity\\\")\\n      targets := targets ++ [(entry.path, target)]\\n    catch error => IO.eprintln s!\\\"Eggshell retained unreadable index target: {error}\\\"\\n  pure targets\\n\\n/-- Portable, data-only work. Provider hashes select locally registered lanes;\\nno executable or absolute destination is imported with a DB. -/\\nstructure IndexTicket where\\n  database : String\\n  provider : String\\n  authority : String\\n  roots : List String\\n  deriving ToJson, FromJson, BEq\\n\\ndef indexTicket (database provider : String)\\n    (promotion : CommittedPromotion) : IndexTicket := {\\n  database, provider\\n  authority := valueEncoding promotion.snapshot.authority\\n  roots := promotion.outcomeRelations.map indexOwnerKey |>.eraseDups\\n}\\n\\ntheorem index_ticket_root_is_published (database provider : String)\\n    (promotion : CommittedPromotion) (key : String)\\n    (present : key ∈ (indexTicket database provider promotion).roots) :\\n    ∃ owner ∈ promotion.snapshot.values, indexOwnerKey owner = key := by\\n  simp only [indexTicket, List.mem_eraseDups, List.mem_map] at present\\n  obtain ⟨owner, member, equal⟩ := present\\n  exact ⟨owner, promotion.owners_in_snapshot owner member, equal⟩\\n\\ndef queueIndex (target : String) (command : List String)\\n    (promotion : CommittedPromotion) : IO Unit := do\\n  let snapshot ← DB.PageMap.pin (.mk target)\\n  unless snapshot.head.authority == valueEncoding promotion.snapshot.authority do\\n    throw (IO.userError \\\"index publication belongs to another authority\\\")\\n  let target ← registerIndexTarget snapshot command\\n  let sidecar ← DB.Sidecar.prepare target.owner target.storage\\n  let directory ← DB.Sidecar.childDirectory sidecar.indexes (indexProviderKey command)\\n  let ticket := indexTicket snapshot.head.identity (indexProviderKey command) promotion\\n  let bytes := (toJson ticket).compress.toUTF8\\n  unless bytes.size ≤ 1048576 do throw (IO.userError \\\"index ticket exceeds metadata bound\\\")\\n  let key := Blake3.hex (Blake3.digest \\\"eggshell.index-ticket\\\".toUTF8\\n    [(toJson ticket).compress.toUTF8])\\n  FileSystem.immutableExistingBytes (directory / (key ++ \\\".json\\\")) bytes\\n\\ndef resolveIndexTicket (snapshot : Graph) (ticket : IndexTicket) : IO CommittedPromotion := do\\n  if valueEncoding snapshot.authority != ticket.authority then\\n    throw (IO.userError \\\"index ticket belongs to a different authority\\\")\\n  let candidates := snapshot.values.map fun owner => (indexOwnerKey owner, owner)\\n  let owners ← ticket.roots.mapM fun key => do\\n    match candidates.filter (fun candidate => candidate.1 == key) with\\n    | [(_, owner)] => pure owner\\n    | [] => throw (IO.userError \\\"published index owner is missing\\\")\\n    | _ => throw (IO.userError \\\"ambiguous index owner digest\\\")\\n  prepareCommitted snapshot { outcomeRelations := owners }\\n\\ndef valueKey (value : Value) : String :=\\n  Persistence.selectionKey value\\n\\ndef allNodes (composite : Persistence.Composite) : List Value :=\\n  composite.values.flatMap Value.nodes |>.eraseDups\\n\\ndef resolveKey (composite : Persistence.Composite) (key : String) : Except String Value :=\\n  match (allNodes composite).filter (valueKey · == key) with\\n  | [value] => pure value\\n  | [] => throw s!\\\"unknown Value {key}\\\"\\n  | _ => throw s!\\\"ambiguous display key {key}; inspect the full graph\\\"\\n\\n/-\\nNative JSON is identity-bearing data, not display framing. Lean's JSON object is\\nan ordered map, so parse-and-compress preserves keys, types, containers, array\\norder, and null while making object-key order irrelevant.\\n-/\\ndef canonicalJson (encoded : String) : String :=\\n  match Json.parse encoded with\\n  | .ok json => json.compress\\n  | .error _ => encoded\\n\\n/--\\nThe whole native invocation remains the reservation identity. Object-key order\\nis normalized, while every semantic distinction in the native input is retained.\\n-/\\ndef canonicalToolWork (tool : ToolEvent) : String :=\\n  tool.name ++ \\\"\\\\n\\\" ++ canonicalJson tool.input\\n\\n/--\\nRemember an admitted native occurrence for later PostToolUse correlation.\\nReservations never control execution because Codex does not emit a terminal\\nhook for every failed or externally blocked tool.\\n-/\\ndef reserveTool (pending : PendingTurn) (tool : ToolEvent) : PendingTurn :=\\n  { pending with\\n    inFlight := pending.inFlight.filter (·.useId != tool.useId) ++ [tool] }\\n\\n/-- Close exactly one native occurrence and retain one completed tool record. -/\\ndef finishTool (pending : PendingTurn) (tool : ToolEvent) : PendingTurn :=\\n  { pending with\\n    inFlight := pending.inFlight.filter (fun current => current.useId != tool.useId)\\n    tools := pending.tools.filter (fun current => current.useId != tool.useId) ++ [tool] }\\n\\n/-- A denied or failed PreToolUse releases only its own transient reservation. -/\\ndef cancelTool (pending : PendingTurn) (useId : String) : PendingTurn :=\\n  { pending with inFlight := pending.inFlight.filter (·.useId != useId) }\\n\\n/-- A session owns one pending turn; an omitted hook turn ID denotes that turn. -/\\ndef matchesHookTurn (pending : PendingTurn) : Option String → Bool\\n  | none => true\\n  | some turn => turn == pending.turnId\\n\\n@[simp] theorem matchesHookTurn_omitted (pending : PendingTurn) :\\n    matchesHookTurn pending none = true := rfl\\n\\ntheorem cancelTool_removes_useId (pending : PendingTurn) (useId : String) :\\n    (cancelTool pending useId).inFlight.all (·.useId != useId) := by\\n  simp [cancelTool]\\n\\ndef relation? (operator : Operator) (arguments : List Ref) : Except String Value :=\\n  match Relation.apply? operator arguments with\\n  | some relation => pure relation\\n  | none => throw s!\\\"invalid {Persistence.operatorName operator} relation\\\"\\n\\n/-- One native invocation owns exactly one observed Work→Outcome edge. -/\\ndef observedWorkOutcome (work observed occurrence : Value) : Value × Value :=\\n  let edge := OutcomeEdge.make work observed [occurrence]\\n    (by simp) (by simp [maxOutcomeObservations])\\n  (work, edge.relation)\\n\\n@[simp]\\ntheorem observedWorkOutcome_work (work observed occurrence : Value) :\\n    (observedWorkOutcome work observed occurrence).1 = work := rfl\\n\\n/--\\nOne native occurrence cites its Work and Outcome once. Session, turn, and the\\nnative tool-use ID are the exact occurrence identity; repeating the raw input\\nand response here would retain the same payload twice without adding authority.\\n-/\\ndef nativeOccurrenceArguments (session turn : Value) (tool : ToolEvent) : List Ref :=\\n  [\\n    .semantic (.text (canonicalJson tool.response)),\\n    .semantic (.text (canonicalToolWork tool)),\\n    .exact session,\\n    .exact turn,\\n    .exact (.text tool.useId)]\\n\\ndef nativeOccurrence (session turn : Value) (tool : ToolEvent) : Value :=\\n  .applyList .occurrence (nativeOccurrenceArguments session turn tool)\\n\\ntheorem nativeOccurrence_valid (session turn : Value) (tool : ToolEvent) :\\n    Relation.validArguments .occurrence\\n      (nativeOccurrenceArguments session turn tool) := by\\n  have semantic : (Authority.semantic == Authority.semantic) = true := by decide\\n  have exact : (Authority.exact == Authority.semantic) = false := by decide\\n  simp [nativeOccurrenceArguments, Relation.validArguments,\\n    Relation.splitOccurrence, Relation.semanticValues, Relation.exactValues,\\n    Ref.semantic, Ref.exact, List.takeWhile, semantic, exact]\\n\\ntheorem nativeOccurrence_exactFootprint (session turn : Value) (tool : ToolEvent) :\\n    (nativeOccurrence session turn tool).exactFootprint =\\n      session :: session.exactFootprint ++\\n      turn :: turn.exactFootprint ++ [.text tool.useId] := by\\n  simp [nativeOccurrence, nativeOccurrenceArguments, Value.applyList,\\n    Refs.ofList, Value.exactFootprint, Value.refsExactFootprint,\\n    Ref.semantic, Ref.exact, Value.text]\\n\\n/-\\nNative tool facts have one compiler regardless of whether they are still\\nstaged or are being promoted.  The active turn can therefore join the same\\nrun-local WorkGraph as committed `.egg` authorities without inventing a\\nsecond trace format or granting the stage persistent authority.\\n-/\\ndef compileOperationOutcomes (session turn : Value) (tool : ToolEvent) :\\n    Value × Value :=\\n  let work := Value.text (canonicalToolWork tool)\\n  let observed := Value.text (canonicalJson tool.response)\\n  observedWorkOutcome work observed (nativeOccurrence session turn tool)\\n\\ndef operationChildren (pending : PendingTurn) : List Value :=\\n  ((pending.tools.map fun tool =>\\n    (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId) tool).1).eraseDups) ++\\n    [HandoffRemainder.value pending.prompt]\\n\\ntheorem operation_checkpoint_keeps_open_remainder (pending : PendingTurn) :\\n    HandoffRemainder.value pending.prompt ∈ operationChildren pending := by\\n  simp [operationChildren]\\n\\ndef compileOperationGraph (pending : PendingTurn) : Except String (List Value × Value) := do\\n  let facts := pending.tools.map (compileOperationOutcomes (.text pending.sessionId) (.text pending.turnId))\\n  let all ← relation? .all\\n    (.semantic (.text pending.prompt) :: (operationChildren pendi
d := offset + count == version.bytes && before.any\\n      (fun old => old.content.any (fun content => content.bytes > version.bytes))\\n    let changed := oldHash != some hash || shortened\\n    let span : Span := ⟨offset, count⟩\\n    if changed then\\n      cursor := {cursor with changes := add limit cursor.changes span, changedPages := cursor.changedPages + 1}\\n      if offset ≥ 4096 then\\n        cursor := {cursor with context := add limit cursor.context ⟨offset - 4096, 4096⟩}\\n    else if cursor.includeNext then cursor := {cursor with context := add limit cursor.context span}\\n    FileSystem.appendAt writer written.toUInt64 hash.toUTF8\\n    written := written + 64\\n    cursor := {cursor with offset := offset + count, root := Blake3.hex root.val, includeNext := changed}\\n    visited := visited + 1\\n  FileSystem.syncAppend writer\\n  FileSystem.closeAppend writer\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead actual.toString)\\n  if after != version || current != version then\\n    writeJson path {entry with cursor := none}\\n    return .pending\\n  writeJson path {entry with cursor := some cursor}\\n  if cursor.offset != version.bytes then return .pending\\n  let selected := cursor.context.foldl (add limit) cursor.changes\\n  let window ← chunks handle selected limit\\n  let snapshot : Snapshot := ⟨⟨relative.text, some ⟨version.bytes, cursor.root⟩⟩,\\n    some version.stamp, cursor.bank⟩\\n  finish workspace before snapshot window cursor.changedPages deadline\\n\\n/-- Only after the immutable observation is queued may this disposable index\\nadvance. Updating this pointer does not mutate any previous evidence. -/\\ndef acknowledge (path : System.FilePath) (snapshot : Snapshot) : IO Unit := do\\n  let some entry ← (readJson path : IO (Option Entry)) | throw (IO.userError \\\"observation index disappeared\\\")\\n  if entry.snapshot == some snapshot && entry.cursor.isNone then return\\n  writeJson path {entry with snapshot := some snapshot, cursor := none}\\n\\ndef observationJson (observation : Observation limit) : Json := Json.mkObj [\\n  (\\\"kind\\\", toJson \\\"observed filesystem state; not attributed to a tool or a successful write\\\"),\\n  (\\\"previous\\\", toJson observation.before), (\\\"current\\\", toJson observation.capture.record.files),\\n  (\\\"retained_bytes\\\", toJson (observation.window.chunks.map (·.bytes.size)).sum),\\n  (\\\"different_or_unconfirmed_pages\\\", toJson observation.changedPages),\\n  (\\\"coverage\\\", toJson \\\"retained changed ranges and adjacent context; omitted ranges are not evidence\\\"),\\n  (\\\"chunks\\\", toJson (observation.window.chunks.map fun chunk => Json.mkObj [\\n    (\\\"byte_offset\\\", toJson chunk.offset), (\\\"byte_length\\\", toJson chunk.bytes.size),\\n    (\\\"encoding\\\", toJson (if (String.fromUTF8? chunk.bytes).isSome then \\\"utf8\\\" else \\\"hex\\\")),\\n    (\\\"content\\\", toJson ((String.fromUTF8? chunk.bytes).getD (Blake3.hex chunk.bytes)))]))]\\n\\ntheorem changed_dependencies_are_historical (old : Record) (current : List File)\\n    (changed : current ≠ old.files) : check? old current = none :=\\n  changed_dependency_rejected old current changed\\n\\n/-- The source reader and resumable observer use the same typed digest\\ntransition. Splitting the ordered pages into visits preserves that result. -/\\ntheorem resumed_digest_exact (root : Root) (first rest : List ByteArray) :\\n    (first ++ rest).foldl stepRoot root = rest.foldl stepRoot (first.foldl stepRoot root) :=\\n  List.foldl_append\\n\\ntheorem dependent_result_requires_old_content (records : List Record) (ledger : Ledger)\\n    (old : Record) (present : old ∈ records) (current : List File)\\n    (observed : currentFiles? ledger old.files = some current)\\n    (changed : current ≠ old.files) : authorize? records ledger = none := by\\n  unfold authorize?\\n  split\\n  · rename_i accepted\\n    have agreement := List.all_eq_true.mp (Bool.and_eq_true_iff.mp accepted).2 old present\\n    simp [recordAgrees, observed, agrees, changed] at agreement\\n  · rfl\\n\\nend Eggshell.SourceObservation\\n\",[]]"],["Eggshell.SurfaceJoin","[\"module\\n\\npublic import Eggshell.EvidenceReplay\\n\\n@[expose] public section\\nnamespace Eggshell.Matcher.SurfaceJoin\\n\\n/-- Product lookup uses only its two occurrence arrays. It never constructs\\nall occurrence pairs merely to address one existing rank position. -/\\ntheorem product_lookup (outer : List α) (inner : List β) (make : α → β → γ) (i : Nat) :\\n    (outer.flatMap (fun a => inner.map (make a)))[i]? =\\n      ((outer[i / inner.length]?).bind fun a => inner[i % inner.length]?.map (make a)) := by\\n  induction outer generalizing i with\\n  | nil => simp\\n  | cons head tail ih =>\\n    by_cases empty : inner.length = 0\\n    · have nil : inner = [] := by simpa using empty\\n      subst inner\\n      have product : (head :: tail).flatMap (fun a => ([] : List β).map (make a)) = [] :=\\n        List.flatMap_eq_nil_iff.mpr (by intro a _; rfl)\\n      rw [product]; simp\\n    · have positive : 0 < inner.length := by omega\\n      by_cases first : i < inner.length\\n      · simp only [List.flatMap_cons]\\n        rw [List.getElem?_append_left (by simpa using first), List.getElem?_map]\\n        simp [Nat.div_eq_of_lt first, Nat.mod_eq_of_lt first]\\n      · have after : inner.length ≤ i := by omega\\n        simp only [List.flatMap_cons]\\n        rw [List.getElem?_append_right (by simpa using after), List.length_map, ih]\\n        have split : i = inner.length + (i - inner.length) := by omega\\n        conv => rhs; rw [split]\\n        simp [Nat.add_div_left _ positive, Nat.add_mod_left]\\n\\nstructure Group where\\n  outer : Array IndexedSpan\\n  inner : Array IndexedSpan\\n  queryFirst : Bool\\n\\ndef Group.make (group : Group) (outer inner : IndexedSpan) : Evidence :=\\n  if group.queryFirst then ⟨outer, inner⟩ else ⟨inner, outer⟩\\n\\ndef Group.items (group : Group) : List Evidence :=\\n  group.outer.toList.flatMap (fun outer => group.inner.toList.map (group.make outer))\\n\\ndef Group.count (group : Group) : Nat := group.outer.size * group.inner.size\\n\\ndef Group.lookup (group : Group) (i : Nat) : Option Evidence := do\\n  let outer ← group.outer[i / group.inner.size]?\\n  let inner ← group.inner[i % group.inner.size]?\\n  pure (group.make outer inner)\\n\\ntheorem Group.count_exact (group : Group) : group.count = group.items.length := by\\n  have length (outer : List IndexedSpan) :\\n      (outer.flatMap (fun a => group.inner.toList.map (group.make a))).length =\\n        outer.length * group.inner.size := by\\n    induction outer with\\n    | nil => simp\\n    | cons head tail ih => simp [ih, Nat.add_mul, Nat.add_comm]\\n  simpa [Group.count, Group.items] using (length group.outer.toList).symm\\n\\ntheorem Group.lookup_exact (group : Group) (i : Nat) : group.lookup i = group.items[i]? := by\\n  rw [Group.items, product_lookup]\\n  simp [Group.lookup, Option.map_eq_bind, Function.comp_def]\\n\\n/-- A balanced directory over the current overlapping surface groups. The\\nstored left count is a proof-carrying address boundary, never an unchecked\\noffset supplied by the memo row. -/\\ninductive Directory where\\n  | leaf (group : Group)\\n  | branch (left right : Directory) (leftCount : Nat)\\n  | empty\\n\\ndef Directory.items : Directory → List Evidence\\n  | .leaf group => group.items\\n  | .branch left right _ => left.items ++ right.items\\n  | .empty => []\\n\\ndef Directory.Valid : Directory → Prop\\n  | .leaf _ | .empty => True\\n  | .branch left right leftCount =>\\n      leftCount = left.items.length ∧ left.Valid ∧ right.Valid\\n\\ndef Directory.count : Directory → Nat\\n  | .leaf group => group.count\\n  | .branch _ right leftCount => leftCount + right.count\\n  | .empty => 0\\n\\ntheorem Directory.count_exact (directory : Directory) (valid : directory.Valid) :\\n    directory.count = directory.items.length := by\\n  induction directory with\\n  | leaf group => exact group.count_exact\\n  | branch left right leftCount _ ih =>\\n      simp only [Directory.Valid] at valid\\n      simp [Directory.count, Directory.items, valid.1, ih valid.2.2]\\n  | empty => rfl\\n\\ndef Directory.lookup : Directory → Nat → Option Evidence\\n  | .leaf group, i => group.lookup i\\n  | .branch left right leftCount, i =>\\n      if i < leftCount then left.lookup i else right.lookup (i - leftCount)\\n  | .empty, _ => none\\n\\ntheorem Directory.lookup_exact (directory : Directory) (valid : directory.Valid) (i : Nat) :\\n    directory.lookup i = directory.items[i]? := by\\n  induction directory generalizing i with\\n  | leaf group => exact group.lookup_exact i\\n  | branch left right leftCount ihLeft ihRight =>\\n      simp only [Directory.Valid] at valid\\n      simp only [Directory.lookup, Directory.items, valid.1,\\n        ihLeft valid.2.1, ihRight valid.2.2, List.getElem?_append]\\n  | empty => rfl\\n\\n/-- Keep semantic indexing in erased proofs, not recursive constructor\\nindices: otherwise Lean may retain/evaluate the ghost product lists. -/\\nabbrev Checked (items : List Evidence) :=\\n  {directory : Directory // directory.Valid ∧ directory.items = items}\\n\\ndef append (left : Checked leftItems) (right : Checked rightItems) :\\n    Checked (leftItems ++ rightItems) :=\\n  ⟨.branch left.val right.val left.val.count,\\n    ⟨⟨left.val.count_exact left.property.1, left.property.1, right.property.1⟩,\\n      by simp only [Directory.items, left.property.2, right.property.2]⟩⟩\\n\\ndef balanced (groups : List Group) : Checked (groups.flatMap Group.items) :=\\n  match groups with\\n  | [] => ⟨.empty, ⟨True.intro, rfl⟩⟩\\n  | [group] => ⟨.leaf group, ⟨True.intro, by simp [Directory.items]⟩⟩\\n  | head :: next :: tail =>\\n      let all := head :: next :: tail\\n      let middle := all.length / 2\\n      let left := balanced (all.take middle)\\n      let right := balanced (all.drop middle)\\n      have joined : (all.take middle).flatMap Group.items ++\\n          (all.drop middle).flatMap Group.items = all.flatMap Group.items := by\\n        rw [← List.flatMap_append, List.take_append_drop]\\n      joined ▸ append left right\\ntermination_by groups.length\\ndecreasing_by\\n  all_goals\\n    simp_wf\\n    omega\\n\\ndef ofSpans (queryFirst : Bool) (outer inner : List IndexedSpan) : Group :=\\n  ⟨outer.reverse.toArray, inner.reverse.toArray, queryFirst⟩\\n\\ntheorem ofSpans_items (queryFirst : Bool) (outer inner : List IndexedSpan) :\\n    (ofSpans queryFirst outer inner).items =\\n      (outer.flatMap (fun a => inner.map (fun b =>\\n        if queryFirst then Evidence.mk a b else Evidence.mk b a))).reverse := by\\n  simp only [ofSpans, Group.items, List.toList_toArray]\\n  change outer.reverse.flatMap (fun a => inner.reverse.map (fun b =>\\n      if queryFirst then Evidence.mk a b else Evidence.mk b a)) = _\\n  rw [List.reverse_flatMap]\\n  simp only [Function.comp_def, List.map_reverse]\\n\\ntheorem product_fold (outer inner : List IndexedSpan)\\n    (make : IndexedSpan → IndexedSpan → Evidence) (before : List Evidence) :\\n    outer.foldl (fun acc a => inner.foldl (fun acc b => make a b :: acc) acc) before =\\n      (outer.flatMap (fun a => inner.map (make a))).reverse ++ before := by\\n  induction outer generalizing before with\\n  | nil => simp\\n  | cons head tail ih =>\\n    rw [List.foldl_cons, ih, List.foldl_flip_cons_eq_append,\\n      List.flatMap_cons, List.reverse_append]\\n    simp only [List.append_assoc]\\n\\ntheorem rows_fold (rows : List (String × List IndexedSpan))\\n    (opposite : String → List IndexedSpan)\\n    (make : IndexedSpan → IndexedSpan → Evidence) (before : List Evidence) :\\n    rows.foldl (fun acc row =>\\n      row.2.foldl (fun acc a => (opposite row.1).foldl\\n        (fun acc b => make a b :: acc) acc) acc) before =\\n      (rows.flatMap (fun row => row.2.flatMap (fun a =>\\n        (opposite row.1).map (make a)))).reverse ++ before := by\\n  induction rows generalizing before with\\n  | nil => simp\\n  | cons row rest ih =>\\n      rw [List.foldl_cons, ih, product_fold, List.flatMap_cons, List.reverse_append]\\n      simp only [List.append_assoc]\\n\\ndef fromQuery (query target : Pattern) : List Group :=\\n  query.surface.toList.reverse.map fun row =>\\n    ofSpans true row.2 (target.surface.getD row.1 [])\\n\\ndef fromTarget (query target : Pattern) : List Group :=\\n  target.surface.toList.reverse.map fun row =>\\n    ofSpans false row.2 (query.surface.getD row.1 [])\\n\\ntheorem fromQuery_reference (query target : Pattern) :\\n    (fromQuery query target).flatMap Group.items = surfaceEvidenceFromQuery query target := by\\n  simp only [fromQuery, List.flatMap_map, ofSpans_items, ↓reduceIte]\\n  have reversed := List.reverse_flatMap (l := query.surface.toList)\\n    (f := fun row => row.2.flatMap (fun a => (target.surface.getD row.1 []).map (Evidence.mk a)))\\n  simp only [Function.comp_def] at reversed\\n  rw [← reversed]\\n  simp only [surfaceEvidenceFromQuery, Std.HashMap.fold_eq_foldl_toList]\\n  simpa only [List.append_nil] using\\n    (rows_fold query.surface.toList (fun gram => target.surface.getD gram []) Evidence.mk []).symm\\n\\ntheorem fromTarget_reference (query target : Pattern) :\\n    (fromTarget query target).flatMap Group.items = surfaceEvidenceFromTarget query target := by\\n  simp only [fromTarget, List.flatMap_map, ofSpans_items, Bool.false_eq_true, ↓reduceIte]\\n  have reversed := List.reverse_flatMap (l := target.surface.toList)\\n    (f := fun row => row.2.flatMap (fun a => (query.surface.getD row.1 []).map (fun b => Evidence.mk b a)))\\n  simp only [Function.comp_def] at reversed\\n  rw [← reversed]\\n  simp only [surfaceEvidenceFromTarget, Std.HashMap.fold_eq_foldl_toList]\\n  simpa only [List.append_nil] using\\n    (rows_fold target.surface.toList (fun gram => query.surface.getD gram [])\\n      (fun a b => Evidence.mk b a) []).symm\\n\\n/-- Same complete surface join and original position order as the Matcher.\\nOnly the overlap directory and occurrence arrays are evaluated. The product\\nlist occurs solely in erased specifications; rank replay uses lookup/count. -/\\ndef current (query target : Pattern) : EvidenceReplay.Indexed (surfaceEvidence query target) :=\\n  if side : query.surface.size ≤ target.surface.size then\\n    let directory := balanced (fromQuery query target)\\n    { count := directory.val.count\\n      lookup := fun i => directory.val.lookup i\\n      countExact := by\\n        rw [directory.val.count_exact directory.property.1, directory.property.2, fromQuery_reference]\\n        simp only [surfaceEvidence, if_pos side]\\n      lookupExact := by\\n        intro i\\n        rw [directory.val.lookup_exact directory.property.1, directory.property.2, fromQuery_reference]\\n        simp only [surfaceEvidence, if_pos side] }\\n  else\\n    let directory := balanced (fromTarget query target)\\n    { count := directory.val.count\\n      lookup := fun i => directory.val.lookup i\\n      countExact := by\\n        rw [directory.val.count_exact directory.property.1, directory.property.2, fromTarget_reference]\\n        simp only [surfaceEvidence, if_neg side]\\n      lookupExact := by\\n        intro i\\n        rw [directory.val.lookup_exact directory.property.1, directory.property.2, fromTarget_reference]\\n        simp only [surfaceEvidence, if_neg side] }\\n\\nend Eggshell.Matcher.SurfaceJoin\\n\",[]]"],["Eggshell.SynapseBuild","[\"module\\n\\npublic import Eggshell.SynapseIndex\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Build\\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\\n\\n/-- This adapter reads a pinned native publication. No export, tool execution,\\nor model is involved; unsupported observations remain unlocated. -/\\ndef identities (edge : OutcomeEdge) : Array Occurrence := Provenance.identities edge\\n\\ndef document (reader : NodeReader snapshot) (id : Nat) : IO Document := Provenance.document reader id\\n\\nstructure Entry where\\n  id : Nat\\n  work : Nat\\n\\n/-- The candidate directory supplies headers only, not window lists or bodies. -/\\ndef entries (snapshot : PageMap.Snapshot) : IO (Array Entry) := do\\n  let mut result := #[]\\n  for (ordinal, id) in ← directory snapshot \\\"searchCandidate\\\" do\\n    let located ← locateOutcome snapshot id\\n    unless (← getNat snapshot.get (key \\\"member\\\" id)) == ordinal &&\\n        (← getNat snapshot.get (key \\\"candidate\\\" id)) == 1 do\\n      throw (IO.userError \\\"synaptic candidate is not a live original owner\\\")\\n    result := result.push ⟨id, located.header.work⟩\\n  return result\\n\\ndef topology (snapshot : PageMap.Snapshot) : IO (Std.HashMap Nat (Array Nat)) := do\\n  let mut result := {}\\n  for header in ← allHeaders snapshot do\\n    result := result.insert header.2.header.parent\\n      (result[header.2.header.parent]?.getD #[] ++ header.2.header.children.toArray)\\n  return result\\n\\ndef closure (edges : Std.HashMap Nat (Array Nat)) (roots : Array Nat) : Std.HashSet Nat := Id.run do\\n  let mut seen := {}\\n  let mut queue := roots\\n  let mut position := 0\\n  while position < queue.size do\\n    let current := queue[position]!\\n    position := position + 1\\n    if seen.contains current then continue\\n    seen := seen.insert current\\n    queue := queue ++ edges[current]?.getD #[]\\n  return seen\\n\\ndef reverse (edges : Std.HashMap Nat (Array Nat)) : Std.HashMap Nat (Array Nat) :=\\n  edges.fold (fun result parent children => children.foldl\\n    (fun result child => result.insert child (result[child]?.getD #[] |>.push parent)) result) {}\\n\\nstructure Changes where\\n  owners : Std.HashSet Nat := {}\\n  works : Std.HashSet Nat := {}\\n  removed : Bool := false\\n\\n/-- Follow exact parent heads, not revision counters. A non-ancestor cache\\nrequires an explicit rebuild rather than a fabricated incremental update. -/\\ndef changes (snapshot : PageMap.Snapshot) (saved : PageMap.Head) : IO (Option Changes) := do\\n  if saved.identity != snapshot.head.identity || saved.authority != snapshot.head.authority then return none\\n  let mut current := snapshot.head\\n  let mut result : Changes := {}\\n  while current != saved do\\n    if current.revision ≤ saved.revision then return none\\n    let publication ← readPublication snapshot current.revision\\n    result := {result with removed := result.removed || !publication.change.removed.isEmpty}\\n    for id in publication.change.added ++ publication.change.removed ++ publication.change.affected do\\n      let frame ← readFrame snapshot snapshot.get id\\n      if let some header := OutcomeHeader.fromFrame? frame then\\n        result := {result with owners := result.owners.insert id, works := result.works.insert header.work}\\n      if let some header := AllHeader.fromFrame? frame then\\n        result := {result with works := result.works.insert header.parent}\\n      if let .apply .receipt references := frame.frame then\\n        if let some fields := SourceEvidence.receiptFields? references then\\n          if (← readNode snapshot snapshot.get fields.marker) == .text SourceEvidence.receiptMarker &&\\n              (← readNode snapshot snapshot.get fields.purpose) == .text SourceEvidence.receiptPurpose then\\n            let some owner := OutcomeHeader.fromFrame? (← readFrame snapshot snapshot.get fields.owner) |\\n              throw (IO.userError \\\"source receipt does not refer to an original Outcome frame\\\")\\n            result := {result with\\n              owners := result.owners.insert fields.owner\\n              works := result.works.insert owner.work}\\n    current := publication.parent\\n  return some result\\n\\ndef retain (readOwners answers : Std.HashSet String) (keepConsumption : Bool) : Fact → Bool\\n  | .read read => !readOwners.contains read.binding.owner\\n  | .supports support => !readOwners.contains support.read.binding.owner && !answers.contains support.claim.answer\\n  | .coquoted (.answer _ answer) _ => !answers.contains answer\\n  | .coquoted (.claim claim) _ => !answers.contains claim.answer\\n  | .consumed _ => keepConsumption\\n  | .used _ => false\\n\\ntheorem retained_support_independent (reads answers : Std.HashSet String) (keep : Bool) (support : Support)\\n    (retained : retain reads answers keep (.supports support) = true) :\\n    reads.contains support.read.binding.owner = false ∧ answers.contains support.claim.answer = false := by\\n  simpa [retain, Bool.and_eq_true] using retained\\n\\ntheorem usage_never_enters_shared_rebuild (reads answers : Std.HashSet String) (keep : Bool) (usage : Usage) :\\n    retain reads answers keep (.used usage) = false := rfl\\n\\nstructure Result where\\n  mode : String\\n  source : PageMap.Head\\n  index : PageMap.Head\\n  candidates : Nat := 0\\n  hydrated : Nat := 0\\n  consumptionRebuilt : Bool := false\\n  provenanceOriginals : Nat := 0\\n  provenanceIgnored : Nat := 0\\n  answers : Nat := 0\\n  unsupported : Nat := 0\\n  facts : Nat := 0\\n  elapsedMs : Nat := 0\\n  deriving ToJson\\n\\nstructure Documents (snapshot : PageMap.Snapshot) where\\n  reader : NodeReader snapshot\\n  cache : IO.Ref (Std.HashMap Nat Document)\\n  catalogs : IO.Ref (Std.HashMap Nat ObservationContext.Catalog)\\n\\ndef Documents.get (documents : Documents snapshot) (id : Nat) : IO Document := do\\n  if let some doc := (← documents.cache.get)[id]? then return doc\\n  let doc ← document documents.reader id\\n  documents.cache.modify (·.insert id doc)\\n  return doc\\n\\ndef Documents.catalog (documents : Documents snapshot) (id : Nat) : IO ObservationContext.Catalog := do\\n  if let some catalog := (← documents.catalogs.get)[id]? then return catalog\\n  let doc ← documents.get id\\n  let original ← match ← ObservedRecords.load? snapshot id doc with\\n    | some catalog => pure catalog\\n    | none => do\\n        let some raw := doc.source | throw (IO.userError \\\"original record body is missing\\\")\\n        let prepared ← IO.ofExcept (ObservedRecords.prepare raw)\\n        IO.ofExcept (ObservedRecords.catalog snapshot.head.identity doc prepared.records)\\n  -- File aliases are additional coordinates, never the original domain gate.\\n  let files := (recordedReads snapshot.head.identity doc).toOption.getD #[]\\n  let captured ← match ← ContentMetadata.load? snapshot id doc with\\n    | none => pure ({} : ObservationContext.Catalog)\\n    | some captured => IO.ofExcept (ContentMetadata.catalog snapshot.head.identity doc captured)\\n  let catalog := {original with\\n    located := files ++ captured.located ++ original.located\\n    quotations := captured.quotations ++ original.quotations}\\n  documents.catalogs.modify (·.insert id catalog)\\n  return catalog\\n\\ndef ownerId? (snapshot : PageMap.Snapshot) (owner : String) : IO (Option Nat) := do\\n  let some checked := Persistence.SelectionKey.check? owner |\\n    throw (IO.userError \\\"noncanonical synaptic owner locator\\\")\\n  let ids ← getIds snapshot.get (\\\"owner:\\\" ++ toString checked.digest)\\n  let live ← ids.filterM fun id => return (← snapshot.get (key \\\"member\\\" id)).isSome\\n  match live with\\n  | [] => return none\\n  | [id] => return some id\\n  | _ => throw (IO.userError \\\"ambiguous synaptic owner locator\\\")\\n\\n/-- Scheduling probe only: bounded metadata reads and no directory creation. -/\\ndef required (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Bool := do\\n  return (← Index.open? snapshot storage .shared).isNone\\n\\n/-- The background extractor keeps only metadata between publications. A new\\nanswer hydrates its cited original reads, never every unrelated source body. -/\\ndef refresh (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Result := do\\n  let started ← IO.monoMsNow\\n  if let some ready ← Index.open? snapshot storage .shared then\\n    return {\\n      mode := \\\"warm\\\", source := snapshot.head, index := ready.index.head\\n      facts := ready.manifest.facts, elapsedMs := (← IO.monoMsNow) - started}\\n  let path ← Index.directory snapshot storage .shared\\n  let previous ← PageMap.open? path\\n  let metadata ← previous.bindM Index.manifest?\\n  let compatible := metadata.filter fun value => value.implementation == Index.implementation && value.scope == .shared\\n  let delta ← compatible.bindM fun value => changes snapshot value.source\\n  let incremental := delta.isSome\\n  let previousFacts ← if incremental then previous.mapM Index.allFacts else pure none\\n  let old := previousFacts.getD #[]\\n  Index.checkFacts snapshot.head.identity .shared old\\n  let catalog ← entries snapshot\\n  let all ← topology snapshot\\n  let changed := delta.getD {}\\n  let affectedWorks := closure (reverse all) changed.works.toArray\\n  let documents : Documents snapshot := ⟨← NodeReader.new snapshot, ← IO.mkRef {}, ← IO.mkRef {}⟩\\n  let mut readOwners := #[]\\n  let mut answerOwners := #[]\\n  let mut retiredReads : Std.HashSet String := {}\\n  let mut retiredAnswers : Std.HashSet String := {}\\n  let mut unsupported := 0\\n  for entry in catalog do\\n    if !incremental || changed.owners.contains entry.id || affectedWorks.contains entry.work then\\n      let doc ← documents.get entry.id\\n      if doc.native then\\n        if !incremental || changed.owners.contains entry.id then readOwners := readOwners.push entry\\n      else\\n        answerOwners := answerOwners.push entry\\n        retiredAnswers := retiredAnswers.insert doc.owner\\n  -- Retired original owners are absent from the current candidate directory.\\n  for id in changed.owners do\\n    let value ← readNode snapshot snapshot.get id\\n    retiredReads := retiredReads.insert (Persistence.selectionKey value)\\n    retiredAnswers := retiredAnswers.insert (Persistence.selectionKey value)\\n  -- A source retraction also invalidates its former answer/coquotation groups.\\n  for fact in old do\\n    if let .supports support := fact then\\n      if retiredReads.contains support.read.binding.owner then\\n        retiredAnswers := retiredAnswers.insert support.claim.answer\\n  for answer in retiredAnswers do\\n    if let some id ← ownerId? snapshot answer then\\n      if !answerOwners.any (·.id == id) && catalog.any (·.id == id) then\\n        let doc ← documents.get id\\n        if !doc.native then\\n          let entry := catalog.find? (·.id == id)\\n          if let some entry := entry then answerOwners := answerOwners.push entry\\n  let stamp := (toJson (← Provenance.stamp snapshot)).compress.toUTF8\\n  let previousStamp ← previous.bindM (·.get \\\"provenance\\\")\\n  -- A new answer does not change previously observed call order or row\\n  -- projections. Reuse those facts only if their origin stamp and source\\n  -- metadata are unchanged; otherwise replay from the pinned originals.\\n  let keepConsumption := incremental && readOwners.isEmpty && !changed.removed && previousStamp == some stamp\\n  let mut graph ← IO.ofExcept (Graph.ofFacts (old.filter (retain retiredReads retiredAnswers keepConsumption)))\\n  for entry in readOwners do\\n    let catalog ← documents.catalog entry.id\\n    if catalog.located.isEmpty then unsupported := unsupported+1\\n    for read in catalog.reads do graph ← IO.ofExcept (graph.insert (.read read))\\n  let reads := graph.snapshot.filterMap fun fact => match fact with | .read read => some read | _ => none\\n  let mut workIds : Std.HashMap String Nat := {}\\n  for entry in catalog do\\n    if let some doc := (← documents.cache.get)[entry.id]? then workIds := workIds.insert doc.work entry.work\\n  -- Resolve only recorded read owners whose metadata was reused.\\n  let mut readIds : Std.HashMap String Nat := {}\\n  for read in reads do\\n    if readIds.contains read.binding.owner then continue\\n    if let some id ← ownerId? snapshot read.binding.owner then\\n      let located ← locateOutcome snapshot id\\n      workIds := workIds.insert read.binding.work located.header.work\\n      readIds := readIds.insert read.binding.owner id\\n  for entry in answerOwners do\\n    let doc ← documents.get entry.id\\n    let route := closure all #[entry.work]\\n    let available := reads.filter fun read => (workIds[read.binding.work]?).any route.contains\\n    let files := available.foldl (fun files read =>\\n      (read.source.file?.map files.insert).getD files) ({} : Std.HashSet File)\\n    let citations := ((layout (doc.source.getD \\\"\\\")).map fun decoded =>\\n      paragraphCitations decoded.text files.toArray).toOption.getD #[]\\n    let needed := available.filter fun read => citations.any (fun cited =>\\n      (cited.intersection? read.source).isSome)\\n    let quoteTexts := ((layout (doc.source.getD \\\"\\\")).map fun decoded =>\\n      decoded.text.splitOn \\\"\\\\n\\\\n\\\" |>.toArray.flatMap (fun paragraph =>\\n        (Quotes.extract paragraph).map (·.text))).toOption.getD #[]\\n    let quoteTexts := hashDistinct quoteTexts.toList |>.toArray\\n    let index := LiteralSearch.prepare quoteTexts\\n    let allowed := available.foldl (fun (set : Std.HashSet Read) read => set.insert read) {}\\n    let mut spellings := #[]\\n    let mut quoteOwners : Std.HashSet Nat := {}\\n    if !quoteTexts.isEmpty then\\n      for read in available do\\n        let some id := readIds[read.binding.owner]? | continue\\n        if quoteOwners.contains id then continue\\n        quoteOwners := quoteOwners.insert id\\n        let catalog ← documents.catalog id\\n        spellings := spellings ++ ObservationContext.quoteMatches index\\n          (catalog.quotations.filter (fun item => allowed.contains item.read))\\n    let mut located := #[]\\n    let mut seen : Std.HashSet Nat := {}\\n    for read in needed ++ spellings.map (·.read) do\\n      let some id := readIds[read.binding.owner]? | continue\\n      if seen.contains id then continue\\n      seen := seen.insert id\\n      let catalog ← documents.catalog id\\n      located := located ++ catalog.located\\n    match addAnswer snapshot.head.identity doc located graph with\\n    | .ok next => graph := next\\n    | .error _ => unsupported := unsupported + 1\\n    match ObservationContext.addQuotedAnswer snapshot.head.identity doc spellings graph with\\n    | .ok next => graph := next\\n    | .error _ => unsupported := unsupported + 1\\n  let portable ← if keepConsumption then pure ({} : Provenance.Derived) else Provenance.derive snapshot\\n  graph ← IO.ofExcept (graph.merge portable.graph)\\n  let facts := graph.snapshot\\n  -- The same changed-owner feed and the same atomic index publication own\\n  -- the immutable original read view. Queries never normalize these bodies.\\n  let prepareRecords := fun writer : PageMap.Writer => do\\n    if !incremental then\\n      let pinned ← writer.snapshot\\n      let prior ← pinned.foldRange ⟨\\\"observed-view:owner:\\\",\\\"observed-view:owner;\\\"⟩\\n        (fun keys row => pure (keys.push row.1)) (#[] : Array String)\\n      for key in prior do writer.put key none\\n    for owner in retiredReads do writer.put (ObservedRecordView.ownerKey owner) none\\n    for entry in readOwners do\\n      ObservedRecordView.stage writer snapshot.head.identity (← documents.get entry.id)\\n  let head ← if incremental then\\n      let wanted := graph.facts\\n      let previous := old.foldl (fun set fact => set.insert fact) ({} : Std.HashSet Fact)\\n      Index.publishDelta snapshot storage .shared (metadata.map (·.source)) {\\n        removed := old.filter (!wanted.contains ·)\\n        added := facts.filter (!previous.contains ·) } prepareRecords\\n    else Index.replace snapshot storage .shared facts prepareRecords\\n  return {\\n    mode := if incremental then \\\"incremental\\\" else \\\"rebuild\\\", source := snapshot.head, index := head\\n    candidates := catalog.size, hydrated := (← documents.cache.get).size, answers := answerOwners.size,\\n    consumptionRebuilt := !keepConsumption,provenanceOriginals := portable.originals,provenanceIgnored := portable.ignored,\\n    unsupported, facts := facts.size, elapsedMs := (← IO.monoMsNow) - started}\\n\\nend Eggshell.Synapses.Build\\n\",[]]"],["Eggshell.SynapseBundles","[\"module\\npublic import Eggshell.SynapseTransport\\npublic import Eggshell.HashDistinct\\npublic import Std.Data.HashMap.Lemmas\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Bundles\\nopen Lean Persistence.Store Recommend Routing.Store\\n\\ndef bundleKind (hint : Hint) : String := match hint.group with\\n  | some (.claim _) => \\\"claim\\\"\\n  | some (.answer ..) => \\\"answer\\\"\\n  | none => Routing.Store.kindName hint.kind\\n\\nstructure Demand where\\n  key : String\\n  kind : String\\n  offers : Array Hint\\n  nonempty : offers.isEmpty = false\\n  sourcesOnly : offers.all (fun offer => offer.target.source?.isSome) = true\\n  same : offers.all (fun offer => offer.reasonKey == key && bundleKind offer == kind) = true\\n\\ndef Demand.check? (key kind : String) (offers : Array Hint) : Option Demand :=\\n  if nonempty : offers.isEmpty = false then\\n    if sourcesOnly : offers.all (fun offer => offer.target.source?.isSome) = true then\\n      if same : offers.all (fun offer => offer.reasonKey == key && bundleKind offer == kind) = true then\\n        some ⟨key,kind,offers,nonempty,sourcesOnly,same⟩ else none\\n    else none\\n  else none\\n\\ndef Demand.sources (demand : Demand) : Array Range :=\\n  (demand.offers.toList.filterMap (·.target.source?)).eraseDups.toArray\\n\\ndef Demand.priority (demand : Demand) : Nat :=\\n  demand.offers.foldl (fun priority offer => min priority offer.priority)\\n    ((demand.offers[0]?).map (·.priority) |>.getD 0)\\n\\ndef demands (plan : Transport.Plan) : Array Demand := Id.run do\\n  let mut groups : Std.HashMap (String × String) (Array Hint) := {}\\n  for offer in plan.results.flatMap (·.admitted) do\\n    if offer.target.source?.isNone then continue\\n    let key := (offer.reasonKey,bundleKind offer)\\n    groups := groups.insert key (groups[key]?.getD #[] |>.push offer)\\n  return (groups.toArray.filterMap fun ((key,kind),offers) => Demand.check? key kind offers).qsort fun a b =>\\n    if a.priority == b.priority then a.key < b.key else a.priority < b.priority\\n\\n/-- The original owner and every scalar row remain attached to their range.\\nNo graph relation is sufficient to invent a source binding. -/\\nstructure Bound (source : Range) where\\n  original : OutcomeEdge\\n  owner : String\\n  ownerExact : owner = Persistence.selectionKey original.relation\\n  rows : Array Read\\n  valid : rows.all Read.valid = true\\n  inside : rows.all (fun row => source.contains row.source) = true\\n  owned : rows.all (fun row => row.binding.owner == owner) = true\\n  complete : covered source (rows.map (·.source)) = true\\n  spans : List (Nat × Nat)\\n  spansExact : spans = (rows.toList.map fun row => (row.binding.first,row.binding.limit)).eraseDups\\n\\ntheorem Bound.spans_exact (bound : Bound source) :\\n    bound.spans = (bound.rows.toList.map fun row => (row.binding.first,row.binding.limit)).eraseDups :=\\n  bound.spansExact\\n\\nstructure Member where\\n  source : Range\\n  choices : Array (Bound source)\\n  located : choices.isEmpty = false\\n\\nstructure Projected where\\n  demand : Demand\\n  members : Array Member\\n  sourcesExact : members.map (·.source) = demand.sources\\n\\nstructure OwnerRows where\\n  original : Transport.LocatedOwner\\n  key : String\\n  keyExact : key = Persistence.selectionKey original.owner.relation\\n  directory : Std.HashMap Range (Array Read)\\n  directoryExact : ∀ source, directory[source]?.getD #[] = original.located.filterMap\\n    (fun located => if located.source == source then some located.row else none)\\n\\ndef rowDirectory (located : Array Routed.Located) : Std.HashMap Range (Array Read) :=\\n  located.foldl (fun directory row => directory.insert row.source\\n    ((directory[row.source]?.getD #[]).push row.row)) {}\\n\\ntheorem row_directory_exact (located : Array Routed.Located) (source : Range) :\\n    (rowDirectory located)[source]?.getD #[] = located.filterMap\\n      (fun row => if row.source == source then some row.row else none) := by\\n  have go : ∀ reversed : List Routed.Located,\\n      (rowDirectory reversed.reverse.toArray)[source]?.getD #[] =\\n        reversed.reverse.toArray.filterMap (fun row =>\\n          if row.source == source then some row.row else none) := by\\n    intro reversed\\n    induction reversed with\\n    | nil => simp [rowDirectory]\\n    | cons row previous ih =>\\n      have step : (row :: previous).reverse.toArray = previous.reverse.toArray.push row := by simp\\n      rw [step]\\n      simp only [rowDirectory,Array.foldl_push,Std.HashMap.getElem?_insert]\\n      by_cases same : row.source = source\\n      · simpa [same,rowDirectory,Array.filterMap_push] using congrArg (fun rows => rows.push row.row) ih\\n      · simpa [same,rowDirectory,Array.filterMap_push] using ih\\n  simpa using go located.toList.reverse\\n\\ndef bindingRows (source : Range) (owner : OwnerRows) : Array Read :=\\n  (hashDistinct (owner.directory[source]?.getD #[]).toList).toArray\\n\\ntheorem binding_rows_exact (source : Range) (owner : OwnerRows) :\\n    bindingRows source owner = (owner.directory[source]?.getD #[]).toList.eraseDups.toArray := by\\n  simp only [bindingRows,HashDistinct.reference]\\n\\ndef bind? (source : Range) (owner : OwnerRows) : Option (Bound source) :=\\n  let rows := bindingRows source owner\\n  if valid : rows.all Read.valid = true then\\n    if inside : rows.all (fun row => source.contains row.source) = true then\\n      if owned : rows.all (fun row => row.binding.owner == owner.key) = true then\\n        if complete : covered source (rows.map (·.source)) = true then\\n          let spans := hashDistinct (rows.toList.map fun row => (row.binding.first,row.binding.limit))\\n          some ⟨owner.original.owner,owner.key,owner.keyExact,rows,valid,inside,owned,complete,\\n            spans,HashDistinct.reference _⟩ else none\\n      else none\\n    else none\\n  else none\\n\\ndef project? (owners : Array OwnerRows) (demand : Demand) : Option Projected := do\\n  let members ← demand.sources.mapM fun source => do\\n    let choices := owners.filterMap (bind? source)\\n    if located : choices.isEmpty = false then some (Member.mk source choices located) else none\\n  if sourcesExact : members.map (·.source) = demand.sources then\\n    some ⟨demand,members,sourcesExact⟩ else none\\n\\ndef project (plan : Transport.Plan) : Array Projected :=\\n  let owners := plan.owners.map fun original =>\\n    (⟨original,Persistence.selectionKey original.owner.relation,rfl,\\n      rowDirectory original.located,row_directory_exact original.located⟩ : OwnerRows)\\n  (demands plan).filterMap (project? owners)\\n\\ntheorem projected_sources_unchanged (projected : Projected) :\\n    projected.members.map (·.source) = projected.demand.sources := projected.sourcesExact\\n\\ndef receipt (plan : Transport.Plan) (projected : Array Projected) (text : String) : Json :=\\n  let shown := Extraction.presented text plan.documents plan.rows\\n  (plan.receiptWith shown).setObjVal! \\\"bundles\\\" (toJson ((demands plan).map fun demand =>\\n    Json.mkObj [(\\\"identity\\\",toJson demand.key), (\\\"kind\\\",toJson demand.kind),\\n      (\\\"priority\\\",toJson demand.priority), (\\\"members\\\",toJson demand.sources),\\n      (\\\"located\\\",toJson (projected.any (·.demand.key == demand.key))),\\n      (\\\"bodyDelivered\\\",toJson (demand.sources.all fun source => covered source shown.ranges))]))\\n\\nend Eggshell.Synapses.Bundles\\n\",[]]"],["Eggshell.SynapseExtraction","[\"module\\n\\npublic import Eggshell.Synapses\\npublic import Eggshell.SearchUnicode\\npublic import Eggshell.JsonScalars\\npublic import tools.RetrievalCategories\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Extraction\\nopen Lean\\n\\nstructure Term where\\n  kind : WitnessKind\\n  text : String\\n  first : Nat\\n  limit : Nat\\n  deriving Repr, BEq\\n\\ndef termCharacter (char : Char) : Bool :=\\n  char.isAlphanum || char == '_' || char == '/' || char == '.' || char == '+' ||\\n    char == '-' || char == ':' || (128 ≤ char.toNat &&\\n      (RetrievalResearch.Unicode.letterNumber char || RetrievalResearch.Unicode.mark char))\\n\\ndef nameStart (char : Char) : Bool :=\\n  char == '_' || (RetrievalResearch.Unicode.letterNumber char && !SearchUnicode.isDigit char)\\n\\ndef namePart (char : Char) : Bool :=\\n  RetrievalResearch.Unicode.letterNumber char || RetrievalResearch.Unicode.mark char ||\\n    \\\"_:.+-\\\".contains char\\n\\n/-- A named file component is required: separators and C++ comment delimiters\\nare not paths. Pure numbers, options and sed bounds are not identifiers.\\nThis is a lexical witness policy, not a proof of tool data dependence. -/\\ndef termKind? (value : String) : Option WitnessKind :=\\n  if value.isEmpty || value.toList.all SearchUnicode.isDigit then none\\n  else if value.contains '/' then\\n    if value.toList.any (fun char => RetrievalResearch.Unicode.letterNumber char || char == '_') then\\n      let suffix := value.splitOn \\\":\\\" |>.getLast!\\n      some (if suffix.toNat?.isSome && value.contains ':' then .pathLine else .path)\\n    else none\\n  else if value.toList.head?.any nameStart && value.toList.all namePart then some .identifier\\n  else none\\n\\ntheorem numeric_not_a_witness (value : String)\\n    (numeric : value.toList.all SearchUnicode.isDigit = true) : termKind? value = none := by\\n  simp [termKind?, numeric]\\n\\ntheorem unnamed_path_not_a_witness (value : String) (slash : value.contains '/' = true)\\n    (unnamed : value.toList.any (fun char => RetrievalResearch.Unicode.letterNumber char || char == '_') = false) :\\n    termKind? value = none := by\\n  simp [termKind?, slash, unnamed]\\n\\n/-- Preserve every source position. Repeating a token on another output row\\nis another possible witness, not a duplicate of the first row. -/\\ndef termOccurrences (text : String) : Array Term := Id.run do\\n  let mut result := #[]\\n  let mut first := 0\\n  let mut position := 0\\n  let mut token : Array Char := #[]\\n  for char in text.toList ++ [' '] do\\n    if termCharacter char then\\n      if token.isEmpty then first := position\\n      token := token.push char\\n    else if !token.isEmpty then\\n      let value := String.ofList token.toList\\n      if let some kind := termKind? value then\\n        result := result.push ⟨kind, value, first, position⟩\\n        if kind == .pathLine then\\n          let path := \\\":\\\".intercalate (value.splitOn \\\":\\\" |>.dropLast)\\n          if termKind? path == some .path then\\n            result := result.push ⟨.path, path, first, first + path.length⟩\\n      token := #[]\\n    position := position + 1\\n  return result\\n\\n/-- A consumer needs one literal argument witness per key. Deduplicating\\narguments does not discard any position in a producer's output. -/\\ndef terms (text : String) : Array Term := Id.run do\\n  let mut seen : Std.HashSet (WitnessKind × String) := {}\\n  let mut result := #[]\\n  for term in termOccurrences text do\\n    if seen.contains (term.kind, term.text) then continue\\n    seen := seen.insert (term.kind, term.text)\\n    result := result.push term\\n  return result\\n\\nstructure OutputRow where\\n  source : Range\\n  first : Nat\\n  limit : Nat\\n  deriving Repr, BEq, ToJson, FromJson\\n\\ndef OutputRow.covers (row : OutputRow) (first limit : Nat) : Bool :=\\n  row.first ≤ first && first < limit && limit ≤ row.limit && row.source.valid\\n\\n/-- A verified file row takes precedence over its enclosing native member.\\nOtherwise keep the smallest covering span; adding context cannot expand a\\nlocated witness into every enclosing container. -/\\ndef project (rows : Array OutputRow) (first limit : Nat) : Array Range :=\\n  let file := rows.any fun row => row.covers first limit && row.source.file?.isSome\\n  let candidates := rows.filter fun row => row.covers first limit && (!file || row.source.file?.isSome)\\n  let initial := (candidates[0]?).map (fun row => row.limit-row.first) |>.getD 0\\n  let width := candidates.foldl (fun n row => min n (row.limit-row.first)) initial\\n  (candidates.filter (fun row => row.limit-row.first == width)).map (·.source)\\n\\ntheorem project_has_witness {rows : Array OutputRow} {first limit : Nat} {source : Range}\\n    (present : source ∈ project rows first limit) :\\n    ∃ row ∈ rows, row.source = source ∧ row.covers first limit = true := by\\n  simp only [project, Array.mem_map, Array.mem_filter, Bool.and_eq_true] at present\\n  obtain ⟨row, ⟨⟨member, covers, _⟩, _⟩, equal⟩ := present\\n  exact ⟨row, member, equal, covers⟩\\n\\nstructure Produced where\\n  occurrence : Occurrence\\n  finished : Nat\\n  term : Term\\n  source : Array Char\\n  format : DataFormat := .text\\n  deriving Repr\\n\\ndef literal (source : Array Char) (first limit : Nat) (term : String) : Bool :=\\n  first < limit && limit ≤ source.size &&\\n    String.ofList (source.extract first limit).toList == term\\n\\n/-- Structured values retain their JSON type and raw literal coordinates.\\nLexical hints are extracted only inside string values, never object keys. -/\\ndef payloadOccurrences (format : DataFormat) (text : String) : Except String (Array Term) := do\\n  if format == .text then return termOccurrences text\\n  let raw := text.toList.toArray\\n  let mut terms := #[]\\n  for scalar in ← JsonScalars.values text do\\n    terms := terms.push ⟨.value,scalar.literal,scalar.first,scalar.limit⟩\\n    if let some value := scalar.text then\\n      for term in termOccurrences value do\\n        let some first := scalar.offsets[term.first]? | continue\\n        let some limit := scalar.offsets[term.limit]? | continue\\n        if literal raw first limit term.text then\\n          terms := terms.push {term with first,limit}\\n  return terms\\n\\ndef witnessTerm (edge : Consumption) : Bool :=\\n  if edge.kind == .value then edge.inputFormat == .json && edge.outputFormat == .json &&\\n    JsonScalars.scalarLiteral edge.term\\n  else termKind? edge.term == some edge.kind\\n\\n/-- A pending link carries checked literal positions in both actual texts.\\nThe output array is shared by all witnesses from one immutable completion. -/\\nstructure Pending where\\n  edge : Consumption\\n  input : Array Char\\n  output : Array Char\\n  valid : edge.valid = true\\n  classified : witnessTerm edge = true\\n  inputExact : literal input edge.inputFirst edge.inputLimit edge.term = true\\n  outputExact : literal output edge.outputFirst edge.outputLimit edge.term = true\\n\\ndef Pending.check? (edge : Consumption) (input output : Array Char) : Option Pending :=\\n  if valid : edge.valid = true then\\n    if classified : witnessTerm edge = true then\\n      if inputExact : literal input edge.inputFirst edge.inputLimit edge.term = true then\\n        if outputExact : literal output edge.outputFirst edge.outputLimit edge.term = true then\\n          some ⟨edge, input, output, valid, classified, inputExact, outputExact⟩ else none\\n      else none\\n    else none\\n  else none\\n\\ntheorem Pending.input_literal (pending : Pending) :\\n    String.ofList (pending.input.extract pending.edge.inputFirst pending.edge.inputLimit).toList =\\n      pending.edge.term := by\\n  have witness := pending.inputExact\\n  simp only [literal, Bool.and_eq_true, beq_iff_eq] at witness\\n  exact witness.2\\n\\ntheorem Pending.output_literal (pending : Pending) :\\n    String.ofList (pending.output.extract pending.edge.outputFirst pending.edge.outputLimit).toList =\\n      pending.edge.term := by\\n  have witness := pending.outputExact\\n  simp only [literal, Bool.and_eq_true, beq_iff_eq] at witness\\n  exact witness.2\\n\\ntheorem Pending.output_within (pending : Pending) :\\n    pending.edge.outputFirst < pending.edge.outputLimit ∧ pending.edge.outputLimit ≤ pending.output.size := by\\n  have witness := pending.outputExact\\n  simp only [literal, Bool.and_eq_true, decide_eq_true_eq] at witness\\n  exact witness.1\\n\\ntheorem Pending.before (pending : Pending) : pending.edge.producerFinish < pending.edge.consumerStart :=\\n  Consumption.checked_before (edge := pending.edge) (accepted := pending.edge)\\n    (by simp [Consumption.checked, pending.valid])\\n\\ntheorem Pending.non_numeric (pending : Pending) (unstructured : pending.edge.kind ≠ .value) :\\n    pending.edge.term.toList.all SearchUnicode.isDigit = false := by\\n  cases numeric : pending.edge.term.toList.all SearchUnicode.isDigit with\\n  | false => rfl\\n  | true =>\\n    have rejected := numeric_not_a_witness pending.edge.term numeric\\n    have accepted := pending.classified\\n    simp [witnessTerm,unstructured,beq_iff_eq,rejected] at accepted\\n\\nstructure Started where\\n  command : String\\n  ordinal : Nat\\n  pending : Array Pending\\n  format : DataFormat := .text\\n\\nstructure Trace where\\n  graph : Graph := .empty\\n  outputs : Std.HashMap (WitnessKind × String) (Std.HashMap Occurrence (Array Produced)) := {}\\n  starts : Std.HashMap Occurrence Started := {}\\n  finished : Std.HashMap Occurrence String := {}\\n  finishedFormats : Std.HashMap Occurrence DataFormat := {}\\n  rows : Std.HashMap Occurrence (Array OutputRow) := {}\\n  lastOrdinal : Option Nat := none\\n\\ndef Trace.advance (trace : Trace) (ordinal : Nat) : Except String Trace := do\\n  if trace.lastOrdinal.any (ordinal < ·) then throw \\\"RPC trace is not in observed order\\\"\\n  return {trace with lastOrdinal := some ordinal}\\n\\ndef Trace.start (trace : Trace) (occurrence : Occurrence) (ordinal : Nat) (command : String)\\n    (format : DataFormat := .text) :\\n    Except String Trace := do\\n  let trace ← trace.advance ordinal\\n  unless occurrence.valid do throw \\\"missing exact session/turn/tool-use identity\\\"\\n  if let some previous := trace.starts[occurrence]? then\\n    unless previous.command == command && previous.format == format do throw \\\"one occurrence changed its input\\\"\\n    return trace\\n  let mut pending := #[]\\n  let input := command.toList.toArray\\n  let candidates ← payloadOccurrences format command\\n  let strong := candidates.filter fun term => term.kind == .value &&\\n    (trace.outputs[(term.kind,term.text)]?.getD {}).any (fun _ producers =>\\n      producers.any (fun producer => producer.finished < ordinal))\\n  let mut seen : Std.HashSet (WitnessKind × String) := {}\\n  for term in candidates do\\n    if term.kind != .value && strong.any (fun value => value.first ≤ term.first && term.limit ≤ value.limit) then continue\\n    if seen.contains (term.kind,term.text) then continue\\n    seen := seen.insert (term.kind,term.text)\\n    for (_, producers) in trace.outputs[(term.kind, term.text)]?.getD {} do\\n      for producer in producers do\\n        if ordinal ≤ producer.finished then continue\\n        let edge : Consumption := {\\n          producer := producer.occurrence, consumer := occurrence\\n          producerFinish := producer.finished, consumerStart := ordinal\\n          kind := term.kind, term := term.text\\n          inputFirst := term.first, inputLimit := term.limit\\n          outputFirst := producer.term.first, outputLimit := producer.term.limit\\n          inputFormat := format,outputFormat := producer.format\\n          rows := project (trace.rows[producer.occurrence]?.getD {}) producer.term.first producer.term.limit }\\n        if let some checked := Pending.check? edge input producer.source then\\n          pending := pending.push checked\\n  return {trace with starts := trace.starts.insert occurrence ⟨command, ordinal, pending,format⟩}\\n\\ndef Trace.finish (trace : Trace) (occurrence : Occurrence) (ordinal : Nat) (output : String)\\n    (format : DataFormat := .text) :\\n    Except String Trace := do\\n  let trace ← trace.advance ordinal\\n  let some started := trace.starts[occurrence]? | throw \\\"output has no observed start\\\"\\n  if let some previous := trace.finished[occurrence]? then\\n    unless previous == output && trace.finishedFormats[occurrence]? == some format do throw \\\"one occurrence changed its output\\\"\\n    return trace\\n  unless started.ordinal < ordinal do throw \\\"output predates call start\\\"\\n  let mut graph := trace.graph\\n  for pending in started.pending do graph ← graph.insert (.consumed pending.edge)\\n  let mut outputs := trace.outputs\\n  let source := output.toList.toArray\\n  for term in ← payloadOccurrences format output do\\n    let previous := outputs[(term.kind, term.text)]?.getD {}\\n    let positions := previous[occurrence]?.getD #[]\\n    outputs := outputs.insert (term.kind, term.text)\\n      (previous.insert occurrence (positions.push ⟨occurrence, ordinal, term, source,format⟩))\\n  return {trace with\\n    graph, outputs\\n    finished := trace.finished.insert occurrence output\\n    finishedFormats := trace.finishedFormats.insert occurrence format}\\n\\n/-- Attach verified row locations after exact native occurrence binding. -/\\ndef Trace.locate (trace : Trace) (rows : Std.HashMap Occurrence (Array OutputRow)) :\\n    Except String Trace := do\\n  let mut facts := #[]\\n  for fact in trace.graph.snapshot do\\n    match fact with\\n    | .consumed edge =>\\n      let projected := project (rows[edge.producer]?.getD {}) edge.outputFirst edge.outputLimit\\n      facts := facts.push (.consumed {edge with rows := projected})\\n    | other => facts := facts.push other\\n  return {trace with rows, graph := ← Graph.ofFacts facts}\\n\\ndef supportCitations (graph : Graph) (claim : Claim) (cited : Array Range) (reads : Array Read)\\n    (original : Array Read := #[]) :\\n    Except String Graph := do\\n  let mut graph := graph\\n  for citation in cited do\\n    for recorded in reads do\\n      if let some source := citation.intersection? recorded.source then\\n        let rows := original.filter (fun row => row.occurrence == recorded.occurrence &&\\n          row.binding.database == recorded.binding.database &&\\n          row.binding.owner == recorded.binding.owner && row.binding.work == recorded.binding.work &&\\n          source.contains row.source)\\n        let binding ← if source == recorded.source then pure recorded.binding else do\\n          unless covered source (rows.map (·.source)) do continue\\n          let first := rows.foldl (fun first row => min first row.binding.first) recorded.binding.limit\\n          let limit := rows.foldl (fun limit row => max limit row.binding.limit) recorded.binding.first\\n          pure {recorded.binding with first, limit}\\n        let support ← Support.checked recorded source claim binding citation\\n        graph ← graph.insert (.supports support)\\n        graph ← graph.insert (.coquoted (.answer claim.database claim.answer) source)\\n        graph ← graph.insert (.coquoted (.claim claim) source)\\n  return graph\\n\\n/-- Actual notifications only. Missing starts/finishes remain explicit errors. -/\\ndef Trace.notification (trace : Trace) (ordinal : Nat) (record : Json) : Except String Trace := do\\n  if (← record.getObjValAs? String \\\"direction\\\") != \\\"server\\\" then return trace\\n  let message ← record.getObjVal? \\\"message\\\"\\n  let method := (message.getObjValAs? String \\\"method\\\").toOption.getD \\\"\\\"\\n  if method != \\\"item/started\\\" && method != \\\"item/completed\\\" then return trace\\n  let params ← message.getObjVal? \\\"params\\\"\\n  let item ← params.getObjVal? \\\"item\\\"\\n  if (← item.getObjValAs? String \\\"type\\\") != \\\"commandExecution\\\" then return trace\\n  let occurrence : Occurrence := ⟨← params.getObjValAs? String \\\"threadId\\\",\\n    ← params.getObjValAs? String \\\"turnId\\\", ← item.getObjValAs? String \\\"id\\\"⟩\\n  if method == \\\"item/started\\\" then\\n    trace.start occurrence ordinal (← item.getObjValAs? String \\\"command\\\")\\n  else\\n    trace.finish occurrence ordinal ((item.getObjValAs? String \\\"aggregatedOutput\\\").toOption.getD \\\"\\\")\\n\\nend Eggshell.Synapses.Extraction\\n\",[]]"],["Eggshell.SynapseIndex","[\"module\\n\\npublic import Eggshell.GraphStore\\npublic import Eggshell.SynapseProvenance\\npublic import Eggshell.SynapticTopologyStore\\npublic import Eggshell.ObservedRecordView\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Index\\nopen Lean DB\\n\\n/-- The implementation key follows source bytes, never a hand-maintained version. -/\\ndef implementation : String :=\\n  Blake3.hex (Blake3.digest \\\"eggshell.synaptic-index\\\".toUTF8 [\\n    (include_str \\\"SynapticTopology.lean\\\").toUTF8,(include_str \\\"SynapticTopologyStore.lean\\\").toUTF8,\\n    (include_str \\\"../tools/SpanPostings.lean\\\").toUTF8,\\n    (include_str \\\"Synapses.lean\\\").toUTF8, (include_str \\\"SynapseExtraction.lean\\\").toUTF8,\\n    (include_str \\\"SynapseSource.lean\\\").toUTF8, (include_str \\\"SynapseUsage.lean\\\").toUTF8,\\n    (include_str \\\"SynapseIndex.lean\\\").toUTF8, (include_str \\\"SynapseBuild.lean\\\").toUTF8,\\n    (include_str \\\"SynapseProvenance.lean\\\").toUTF8, (include_str \\\"ObservationAge.lean\\\").toUTF8,\\n    (include_str \\\"ContentCapture.lean\\\").toUTF8,(include_str \\\"ContentMetadata.lean\\\").toUTF8,\\n    (include_str \\\"../tools/ContentCorrespondence.lean\\\").toUTF8,\\n    (include_str \\\"JsonScalars.lean\\\").toUTF8,\\n    (include_str \\\"SynapseQuotes.lean\\\").toUTF8,\\n    (include_str \\\"ObservationContext.lean\\\").toUTF8,(include_str \\\"Sha256.lean\\\").toUTF8,\\n    (include_str \\\"QuotationContext.lean\\\").toUTF8,\\n    (include_str \\\"ObservedRecords.lean\\\").toUTF8,\\n    (include_str \\\"ObservedRecordView.lean\\\").toUTF8,\\n    (include_str \\\"../tools/LiteralSearch.lean\\\").toUTF8,\\n    (include_str \\\"SourceEvidence.lean\\\").toUTF8,\\n    (include_str \\\"SearchUnicode.lean\\\").toUTF8,\\n    (include_str \\\"../tools/RetrievalCategories.lean\\\").toUTF8])\\n\\ndef factName (fact : Fact) : String := \\\"fact:\\\" ++ contentKey fact\\n\\ndef postingPrefix (key : Key) : String := \\\"lookup:\\\" ++ contentKey key ++ \\\":\\\"\\n\\nstructure Posting where\\n  key : Key\\n  fact : String\\n  deriving BEq, ToJson, FromJson\\n\\ndef postingName (key : Key) (fact : Fact) : String := postingPrefix key ++ contentKey fact\\n\\ndef eventName (event : Event) : String := \\\"event:\\\" ++ contentKey event\\n\\ndef belongs (database : String) : Fact → Bool\\n  | .read recorded => recorded.binding.database == database\\n  | .supports support => support.claim.database == database && support.read.binding.database == database\\n  | .coquoted (.answer owner _) _ => owner == database\\n  | .coquoted (.claim claim) _ => claim.database == database\\n  | .consumed _ | .used _ => true\\n\\ndef checkDestination (storage : Sidecar.Storage) (scope : Scope) : IO Unit :=\\n  if scope == .usage && storage != .user then\\n    throw (IO.userError \\\"synaptic usage must stay in the private DB overlay\\\")\\n  else pure ()\\n\\nstructure Manifest where\\n  source : PageMap.Head\\n  implementation : String\\n  scope : Scope\\n  facts : Nat\\n  deriving BEq, ToJson, FromJson\\n\\ndef manifest? (snapshot : PageMap.Snapshot) : IO (Option Manifest) := do\\n  (← snapshot.get \\\"manifest\\\").mapM (decode (α := Manifest))\\n\\n/-- An old index is usable across derived-only commits, through exact parent heads.\\nThe lookup path examines at most the supplied number of journal entries. -/\\ndef sameSources (snapshot : PageMap.Snapshot) (saved : PageMap.Head) (limit : Nat := 16) : IO Bool := do\\n  if saved.identity != snapshot.head.identity || saved.authority != snapshot.head.authority then return false\\n  let mut current := snapshot.head\\n  for _ in [:limit] do\\n    if current == saved then return true\\n    if current.revision ≤ saved.revision then return false\\n    let publication ← Persistence.Store.readPublication snapshot current.revision\\n    if !publication.change.neutral then return false\\n    current := publication.parent\\n  return current == saved\\n\\ndef directory (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\\n    IO System.FilePath := do\\n  return (← Sidecar.locate snapshot storage).directory / \\\"synapses\\\" / scope.directory\\n\\ndef prepare (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\\n    IO PageMap.Snapshot := do\\n  if scope == .usage && storage != .user then\\n    throw (IO.userError \\\"synaptic usage must stay in the private DB overlay\\\")\\n  let sidecar ← Sidecar.prepare (Sidecar.Owner.ofSnapshot snapshot) storage\\n  let parent ← Sidecar.childDirectory sidecar.directory \\\"synapses\\\"\\n  let path := parent / scope.directory\\n  match ← PageMap.open? path with\\n  | some snapshot => return snapshot\\n  | none => PageMap.create path (\\\"advisory:\\\" ++ snapshot.head.identity ++ \\\":\\\" ++ scope.directory)\\n\\nstructure Reader where\\n  index : PageMap.Snapshot\\n  manifest : Manifest\\n\\n/-- Opening never creates an index or prepares a directory inside a shared DB. -/\\ndef open? (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) : IO (Option Reader) := do\\n  if scope == .usage && storage != .user then return none\\n  let path ← directory source storage scope\\n  let some index ← PageMap.open? path | return none\\n  let some metadata ← manifest? index | return none\\n  unless metadata.implementation == implementation && metadata.scope == scope do return none\\n  if scope == .shared then\\n    unless (← index.get \\\"provenance\\\") == some (toJson (← Provenance.stamp source)).compress.toUTF8 do return none\\n    unless ← sameSources source metadata.source do return none\\n  else\\n    unless metadata.source.identity == source.head.identity &&\\n        metadata.source.authority == source.head.authority do return none\\n  return some ⟨index, metadata⟩\\n\\ndef openShared? (source : PageMap.Snapshot) : IO (Option Reader) := do\\n  if let some reader ← open? source .database .shared then return some reader\\n  open? source .user .shared\\n\\ndef putImmutable (writer : PageMap.Writer) (name : String) (bytes : ByteArray) : IO Bool := do\\n  if let some previous ← writer.get name then\\n    unless previous == bytes do throw (IO.userError \\\"conflicting synaptic content address\\\")\\n    return false\\n  writer.put name (some bytes)\\n  return true\\n\\ndef insert (writer : PageMap.Writer) (database : String) (scope : Scope) (fact : Fact) : IO Bool := do\\n  unless scope.accepts fact && belongs database fact && fact.valid do\\n    throw (IO.userError \\\"invalid fact or wrong synaptic privacy/DB scope\\\")\\n  if let .used usage := fact then\\n    let _ ← putImmutable writer (eventName usage.event) (← checkedBytes usage)\\n  let inserted ← putImmutable writer (factName fact) (← checkedBytes fact)\\n  Routing.Store.insert writer fact\\n  for key in addresses fact do\\n    let posting : Posting := ⟨key, contentKey fact⟩\\n    let _ ← putImmutable writer (postingName key fact) (← checkedBytes posting)\\n  return inserted\\n\\ndef erase (writer : PageMap.Writer) (fact : Fact) : IO Bool := do\\n  let name := factName fact\\n  let some previous ← writer.get name | return false\\n  unless previous == (toJson fact).compress.toUTF8 do\\n    throw (IO.userError \\\"retired synaptic object differs from its content address\\\")\\n  Routing.Store.erase writer fact\\n  writer.put name none\\n  for key in addresses fact do writer.put (postingName key fact) none\\n  -- Retiring a recommendation does not permit relabelling an observed event.\\n  -- The small immutable witness remains until its owning DB cache is retired.\\n  return true\\n\\nstructure Delta where\\n  removed : Array Fact := #[]\\n  added : Array Fact := #[]\\n\\ndef checkFacts (database : String) (scope : Scope) (facts : Array Fact) : IO Unit :=\\n  unless facts.all (fun fact => scope.accepts fact && belongs database fact && fact.valid) do\\n    throw (IO.userError \\\"invalid fact or wrong synaptic privacy/DB scope\\\")\\n\\n/-- One metadata publication commits facts and all inverse postings together.\\nAn incompatible prior implementation needs a full replacement, never reuse. -/\\ndef publishDelta (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\\n    (expected : Option PageMap.Head) (delta : Delta)\\n    (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\\n  checkDestination storage scope\\n  checkFacts source.head.identity scope delta.added\\n  checkFacts source.head.identity scope delta.removed\\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\\n    let index ← prepare source storage scope\\n    let previous ← manifest? index\\n    if let some previous := previous then\\n      if scope == .shared && previous.source.revision > source.head.revision then\\n        throw (IO.userError \\\"older source cannot replace a later synaptic publication\\\")\\n      unless previous.source == expected.getD source.head && previous.implementation == implementation &&\\n          previous.scope == scope do throw (IO.userError \\\"stale synaptic index update\\\")\\n    else if expected.isSome then throw (IO.userError \\\"missing synaptic index update base\\\")\\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\\n      let mut count := previous.map (·.facts) |>.getD 0\\n      for fact in delta.removed do\\n        if ← erase writer fact then count := count-1\\n      for fact in delta.added do\\n        if ← insert writer source.head.identity scope fact then count := count+1\\n      prepareRecords writer\\n      let next : Manifest := ⟨source.head, implementation, scope, count⟩\\n      Routing.Store.finish writer count\\n      let bytes ← checkedBytes next\\n      if (← writer.get \\\"manifest\\\") != some bytes then writer.put \\\"manifest\\\" (some bytes)\\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\\n      if (← writer.get \\\"provenance\\\") != some provenance then writer.put \\\"provenance\\\" (some provenance)\\n    return head) storage\\n\\ndef allFacts (index : PageMap.Snapshot) : IO (Array Fact) :=\\n  index.foldRange ⟨\\\"fact:\\\", \\\"fact;\\\"⟩ (fun facts row => do\\n    let some bytes := row.2 | return facts\\n    let fact ← decode (α := Fact) bytes\\n    unless row.1 == factName fact && fact.valid do throw (IO.userError \\\"foreign synaptic fact row\\\")\\n    return facts.push fact) #[]\\n\\n/-- Explicit warm/background replacement; it never runs in a search hook. -/\\ndef replace (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\\n    (facts : Array Fact) (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\\n  checkDestination storage scope\\n  checkFacts source.head.identity scope facts\\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\\n    let index ← prepare source storage scope\\n    if let some previous ← manifest? index then\\n      if scope == .shared && previous.source.revision > source.head.revision then\\n        throw (IO.userError \\\"older source cannot replace a later synaptic publication\\\")\\n    let wanted := facts.foldl (fun wanted fact => wanted.insert (factName fact)) ({} : Std.HashSet String)\\n    let old ← allFacts index\\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\\n      for fact in old do\\n        if !wanted.contains (factName fact) then let _ ← erase writer fact; pure ()\\n      for fact in facts do let _ ← insert writer source.head.identity scope fact; pure ()\\n      prepareRecords writer\\n      let next : Manifest := ⟨source.head, implementation, scope, wanted.size⟩\\n      Routing.Store.finish writer wanted.size\\n      let bytes ← checkedBytes next\\n      if (← writer.get \\\"manifest\\\") != some bytes then writer.put \\\"manifest\\\" (some bytes)\\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\\n      if (← writer.get \\\"provenance\\\") != some provenance then writer.put \\\"provenance\\\" (some provenance)\\n    return head) storage\\n\\nstructure Scan where\\n  postings : Array Posting := #[]\\n  inspected : Nat := 0\\n  pages : Nat := 0\\n  complete : Bool := true\\n\\n/-- Stop in the tree, rather than materializing or traversing all postings. -/\\ndef scanAt (index : PageMap.Snapshot) (ref : PageMap.Ref) (range : PageMap.KeyRange)\\n    (limit deadline : Nat) (initial : Scan) : IO Scan := do\\n  if !initial.complete then return initial\\n  if initial.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {initial with complete := false}\\n  let loaded ← index.load ref\\n  let mut result := {initial with pages := initial.pages+1}\\n  match loaded.page with\\n  | .leaf rows =>\\n    for row in range.select rows do\\n      if result.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\\n      let some bytes := row.2 | continue\\n      let posting ← decode (α := Posting) bytes\\n      unless row.1 == postingPrefix posting.key ++ posting.fact do throw (IO.userError \\\"foreign synaptic posting\\\")\\n      result := {result with postings := result.postings.push posting, inspected := result.inspected+1}\\n    return result\\n  | .branch children =>\\n    for child in children do\\n      if range.overlaps child then\\n        if _smaller : child.height < ref.height then\\n          result ← scanAt index child range limit deadline result\\n        else throw (IO.userError \\\"synaptic index height did not decrease\\\")\\n        if !result.complete then return result\\n    return result\\ntermination_by ref.height\\n\\n/-- This certifies the advisory inverse relation, not Work or completion authority. -/\\nstructure CheckedFact (key : Key) where\\n  fact : Fact\\n  valid : fact.valid = true\\n  bound : key ∈ addresses fact\\n\\ndef CheckedFact.check? (key : Key) (fact : Fact) : Option (CheckedFact key) :=\\n  if valid : fact.valid = true then\\n    if bound : (addresses fact).contains key = true then\\n      some ⟨fact, valid, Array.mem_of_contains_eq_true bound⟩\\n    else none\\n  else none\\n\\nstructure Lookup (key : Key) where\\n  checked : Array (CheckedFact key)\\n  complete : Bool\\n  postingPages : Nat\\n  index : PageMap.Head\\n  payloadBytes : Nat := 0\\n\\ndef Lookup.facts (lookup : Lookup key) : Array Fact := lookup.checked.map (·.fact)\\n\\ntheorem Lookup.returned_bound (lookup : Lookup key) (fact : Fact)\\n    (present : fact ∈ lookup.facts) :\\n    fact.valid = true ∧ key ∈ addresses fact := by\\n  simp only [Lookup.facts, Array.mem_map] at present\\n  obtain ⟨checked, _, equal⟩ := present\\n  subst fact\\n  exact ⟨checked.valid, checked.bound⟩\\n\\ndef Reader.lookup (reader : Reader) (key : Key) (limit deadline : Nat)\\n    (byteLimit : Option Nat := none) : IO (Lookup key) := do\\n  let name := postingPrefix key\\n  let scanned ← match reader.index.head.root with\\n    | none => pure ({} : Scan)\\n    | some root => scanAt reader.index root ⟨name, \\\"lookup:\\\" ++ contentKey key ++ \\\";\\\"⟩ limit deadline {}\\n  let mut facts := #[]\\n  let mut complete := scanned.complete\\n  let mut payloadBytes := 0\\n  for posting in scanned.postings do\\n    if (← IO.monoMsNow) ≥ deadline then\\n      complete := false\\n      break\\n    unless posting.key == key do throw (IO.userError \\\"ambiguous synaptic key digest\\\")\\n    let some bytes ← reader.index.get (\\\"fact:\\\" ++ posting.fact) |\\n      throw (IO.userError \\\"dangling synaptic posting\\\")\\n    if byteLimit.any (payloadBytes+bytes.size > ·) then\\n      complete := false\\n      break\\n    let fact ← decode (α := Fact) bytes\\n    unless fact.valid && reader.manifest.scope.accepts fact && belongs reader.manifest.source.identity fact &&\\n        contentKey fact
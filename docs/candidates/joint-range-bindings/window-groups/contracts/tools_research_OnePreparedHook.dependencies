hell.Receipt\\npublic import Eggshell.Matcher\\npublic import Eggshell.GraphStore\\npublic import Eggshell.DiscoveryAudit\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SelectionAudit\\nopen Lean\\n\\n/-- A locator survives demand-memo reuse. Owner lists describe the surviving\\ndelivery, while the immutable snapshot describes the entire chosen extraction. -/\\nstructure Reference where\\n  receipt : String\\n  stage : String\\n  sha256 : String\\n  visible : List String\\n  controls : List String\\n  deriving ToJson, FromJson\\n\\ndef Reference.restrict (reference : Reference) (visible controls : List String) : Reference :=\\n  {reference with\\n    visible := reference.visible.filter visible.contains\\n    controls := reference.controls.filter controls.contains}\\n\\nstructure Generator where\\n  left : Json\\n  right : Json\\n  scope : String\\n  authority : Json\\n  deriving ToJson, FromJson\\n\\ndef Generator.encode (edge : UnionEdge) : Generator := {\\n  left := Persistence.valueToJson edge.left\\n  right := Persistence.valueToJson edge.right\\n  scope := match edge.scope with | .run _ => \\\"run\\\" | .workspace _ => \\\"workspace\\\"\\n  authority := Persistence.valueToJson (match edge.scope with | .run value | .workspace value => value) }\\n\\ndef Generator.decode (row : Generator) : Except String UnionEdge := do\\n  let left ← Persistence.valueFromJson 4096 row.left\\n  let right ← Persistence.valueFromJson 4096 row.right\\n  let authority ← Persistence.valueFromJson 4096 row.authority\\n  let scope ← match row.scope with\\n    | \\\"run\\\" => pure (UnionScope.run authority)\\n    | \\\"workspace\\\" => pure (UnionScope.workspace authority)\\n    | _ => throw \\\"unknown equality generator scope\\\"\\n  if safe : Value.sameExactFootprint left right then\\n    pure ⟨left, right, scope, Value.sameExactFootprint_sound safe⟩\\n  else throw \\\"equality generator crosses Exact authority\\\"\\n\\nstructure CompletedBranch where\\n  owner : String\\n  demand : Json\\n  projectedOutcome : Json\\n  /-- Positions in the shared checked comparison pool; Value payloads are\\n  serialized once, including comparisons shared by many completed branches. -/\\n  premises : List Nat\\n  /-- Shared structural All positions along this branch, excluding siblings. -/\\n  decompositions : List Nat := []\\n  deriving ToJson, FromJson\\n\\n/-- Observed beside the actual matcher call, before saturation adds more\\ngenerators. Values and source frames remain shared until completed owners\\nare known; only those owners are serialized. -/\\nstructure Admission where\\n  matched : Matcher.Match\\n  runLocal : List UnionEdge\\n  child : Json\\n  inquiry : Value\\n  nomination : Option UnionEdge\\n  schedule : Option Nat := none\\n\\ndef Admission.observe (view : RunView) (inquiry : Value) (corpus : Matcher.Corpus)\\n    (children : Std.HashMap Value Persistence.Store.ChildObservation)\\n    (matched : Matcher.Match) : Admission := Id.run do\\n  let mut child := Json.null\\n  if let some original := corpus.subworks.find? (view.quotient.toEquality.same matched.edge.work) then\\n    if let some parent := corpus.parents.find? (fun edge => edge.children.contains original) then\\n      child := Json.mkObj [(\\\"kind\\\", toJson \\\"topology\\\"),\\n        (\\\"requested\\\", Persistence.valueToJson original), (\\\"original\\\", Persistence.valueToJson original),\\n        (\\\"relation\\\", Persistence.valueToJson parent.relation)]\\n    else if let some observed := children[original]? then\\n      child := observed.encode\\n  return {\\n    matched, runLocal := view.localUnions, child, inquiry\\n    nomination := Matcher.localUnion? view.quotient inquiry matched }\\n\\n/-- The Match which proposed one actual local generator. Unlike completed\\nadmission, nomination needs no completed subwork or Outcome context. -/\\nstructure UnionOrigin where\\n  generator : Nat\\n  localCount : Nat\\n  inquiry : Json\\n  demand : Json\\n  work : Json\\n  currentFragment : Json\\n  pastFragment : Json\\n  wholeIdentity : Bool\\n  fragmentIdentity : Bool\\n  priorComplete : Bool\\n  demandComplete : Bool\\n  priorWeight : Nat\\n  demandWeight : Nat\\n  retrieved : Bool\\n  schedule : Option Nat := none\\n  deriving ToJson, FromJson\\n\\n/-- Full structural keys disambiguate collision buckets; no display digest\\nor serialized Value is used as generator identity. -/\\nstructure GeneratorKey where\\n  left : Value\\n  right : Value\\n  run : Bool\\n  authority : Value\\n  deriving BEq, Hashable\\n\\ndef GeneratorKey.ofEdge (edge : UnionEdge) : GeneratorKey := {\\n  left := edge.left, right := edge.right\\n  run := match edge.scope with | .run _ => true | .workspace _ => false\\n  authority := match edge.scope with | .run value | .workspace value => value }\\n\\ndef Admission.atPrefix (runLocal : List UnionEdge) (admission : Admission) : Bool :=\\n  DiscoveryAudit.atPrefix admission.runLocal runLocal\\n\\ndef unionOrigins (runLocal : List UnionEdge) (history : List Admission) : List UnionOrigin := Id.run do\\n  if runLocal.isEmpty then return []\\n  let mut nominated : Std.HashMap GeneratorKey Admission := {}\\n  for admission in history.reverse do\\n    if let some edge := admission.nomination then\\n      let key := GeneratorKey.ofEdge edge\\n      unless nominated.contains key do\\n        if admission.atPrefix runLocal then nominated := nominated.insert key admission\\n  return runLocal.zipIdx.filterMap fun (edge, index) => do\\n    let admission ← nominated[GeneratorKey.ofEdge edge]?\\n    unless admission.runLocal.length ≤ index do none\\n    let matched := admission.matched\\n    let aligned ← matched.work.alignment?\\n    pure {\\n      generator := index, localCount := admission.runLocal.length\\n      inquiry := Persistence.valueToJson admission.inquiry\\n      demand := Persistence.valueToJson matched.demand\\n      work := Persistence.valueToJson matched.edge.work\\n      currentFragment := Persistence.valueToJson matched.work.currentFragment\\n      pastFragment := Persistence.valueToJson matched.work.pastFragment\\n      wholeIdentity := matched.work.wholeWorkIdentity\\n      fragmentIdentity := matched.work.fragmentIdentity\\n      priorComplete := aligned.priorInDemand.complete\\n      demandComplete := aligned.demandInPrior.complete\\n      priorWeight := aligned.priorInDemand.coveredWeight\\n      demandWeight := aligned.demandInPrior.coveredWeight\\n      retrieved := matched.retrieved, schedule := admission.schedule }\\n\\nstructure AdmissionSnapshot where\\n  owner : String\\n  branches : List Nat\\n  localCount : Nat\\n  demand : Json\\n  work : Json\\n  currentFragment : Json\\n  pastFragment : Json\\n  wholeIdentity : Bool\\n  fragmentIdentity : Bool\\n  subwork : Bool\\n  classIdentity : Bool\\n  priorComplete : Option Bool\\n  demandComplete : Option Bool\\n  pastWhole : Bool\\n  groundedFragment : Bool\\n  retrieved : Bool\\n  child : Json\\n  schedule : Option Nat := none\\n  deriving ToJson, FromJson\\n\\ndef Admission.snapshot? (runLocal : List UnionEdge) (branches : List CompletedBranch)\\n    (admission : Admission) (owner : String) : Option AdmissionSnapshot := do\\n  unless admission.atPrefix runLocal do none\\n  let matched := admission.matched\\n  unless matched.automatic && matched.judgment.delivery == .completed do none\\n  let projected := Persistence.valueToJson matched.projectedEdge.relation\\n  let positions := branches.zipIdx.filterMap fun (branch, index) =>\\n    if branch.owner == owner && branch.projectedOutcome == projected &&\\n        branch.demand == Persistence.valueToJson matched.projectionWork then some index else none\\n  if positions.isEmpty then none else some {\\n    owner, branches := positions, localCount := admission.runLocal.length\\n    demand := Persistence.valueToJson matched.demand\\n    work := Persistence.valueToJson matched.edge.work\\n    currentFragment := Persistence.valueToJson matched.work.currentFragment\\n    pastFragment := Persistence.valueToJson matched.work.pastFragment\\n    wholeIdentity := matched.work.wholeWorkIdentity\\n    fragmentIdentity := matched.work.fragmentIdentity\\n    subwork := matched.work.subwork\\n    classIdentity := matched.work.isIdentity\\n    priorComplete := matched.work.priorCoverage.map (·.complete)\\n    demandComplete := matched.work.demandCoverage.map (·.complete)\\n    pastWhole := matched.work.pastWholeWork\\n    groundedFragment := matched.groundedOutcomeFragment\\n    retrieved := matched.retrieved\\n    child := admission.child, schedule := admission.schedule }\\n\\nstructure Snapshot where\\n  current : Json\\n  persistent : List Generator\\n  runLocal : List Generator\\n  premises : List DiscoveryAudit.ComparisonRow\\n  owners : List String\\n  completedBranches : List CompletedBranch := []\\n  admissions : List AdmissionSnapshot := []\\n  localOrigins : List UnionOrigin := []\\n  schedules : List DiscoveryAudit.ScheduleSnapshot := []\\n  continuations : List DiscoveryAudit.ContinuationSnapshot := []\\n  decompositions : List DiscoveryAudit.AllUse := []\\n  finalPass : Option Nat := none\\n  deriving ToJson, FromJson\\n\\n/-- No second quotient build occurs in the hook. Only premises from a checked\\nproduction selection and its current generators are serialized here. -/\\ndef Snapshot.ofReport (persistent runLocal : List UnionEdge)\\n    {graph : WorkGraph} {equality : Equality} {policy : OutcomePolicy}\\n    {current : Value} {selection : Selection}\\n    (report : SelectionDependency.Report graph equality policy current selection)\\n    (owners : List String) (bindings : List (Value × String) := [])\\n    (admissions : List (Admission × String) := []) (history : List Admission := [])\\n    (trail : DiscoveryAudit.Trail := {}) (runAll : List AllEdge := [])\\n    (finalPass : Option Nat := none) : Snapshot := Id.run do\\n  let positions : Std.HashMap SelectionDependency.Comparison Nat :=\\n    report.premises.zipIdx.foldl (fun positions (premise, index) => positions.insert premise index) {}\\n  let decompositions := hashDistinct (selection.decompositionEdges.map (·.relation))\\n  let allPositions : Std.HashMap Value Nat := decompositions.zipIdx.foldl\\n    (fun positions (relation, index) => positions.insert relation index) {}\\n  let completedBranches : List CompletedBranch := (SelectionDependency.completedBranches equality current selection).flatMap\\n    fun branch => (bindings.filterMap fun (projected, owner) =>\\n      if projected == branch.edge.relation then some owner else none).eraseDups.map fun owner => {\\n        owner, demand := Persistence.valueToJson branch.demand\\n        projectedOutcome := Persistence.valueToJson branch.edge.relation\\n        premises := branch.premises.map (fun premise => positions.getD premise report.premises.length)\\n        decompositions := branch.decompositions.map fun edge =>\\n          allPositions.getD edge.relation decompositions.length }\\n  return {\\n  current := Persistence.valueToJson current\\n  persistent := persistent.map Generator.encode\\n  runLocal := runLocal.map Generator.encode\\n  premises := report.premises.map DiscoveryAudit.ComparisonRow.encode\\n  owners := owners.eraseDups\\n  completedBranches\\n  admissions := admissions.filterMap fun (admission, owner) =>\\n    admission.snapshot? runLocal completedBranches owner\\n  localOrigins := unionOrigins runLocal history\\n  schedules := trail.schedules.reverse.filterMap (·.snapshot? runLocal)\\n  continuations := trail.continuations.reverse.filterMap (·.snapshot? runLocal)\\n  decompositions := decompositions.map fun relation =>\\n    {relation := Persistence.valueToJson relation, generated := runAll.any (·.relation == relation)}\\n  finalPass }\\n\\ndef capture (receipt : Option String) (snapshot : Snapshot)\\n    (visible controls : List String) : IO (Option Reference) := do\\n  let some receipt := receipt | return none\\n  try\\n    let stage := \\\"selection-\\\" ++ (← Receipt.fresh)\\n    let data := toJson snapshot\\n    Receipt.write receipt stage data\\n    pure (some {receipt, stage, sha256 := Sha256.hex data.compress.toUTF8, visible, controls})\\n  catch error =>\\n    IO.eprintln s!\\\"Eggshell could not record selected equality premises: {error}\\\"\\n    pure none\\n\\ndef kindName : EqualityDependency.Kind → String\\n  | .notEquivalent => \\\"notEquivalent\\\"\\n  | .literal => \\\"literal\\\"\\n  | .persistentUnion => \\\"persistentUnion\\\"\\n  | .localUnion => \\\"localUnion\\\"\\n  | .congruence => \\\"congruence\\\"\\n\\ndef admissionChild (data : Json) : Except String (Option (Value × Value)) := do\\n  if data == Json.null then return none\\n  let requested ← Persistence.valueFromJson 4096 (data.getObjValD \\\"requested\\\")\\n  let original ← Persistence.valueFromJson 4096 (data.getObjValD \\\"original\\\")\\n  match ← data.getObjValAs? String \\\"kind\\\" with\\n  | \\\"topology\\\" =>\\n      let value ← Persistence.valueFromJson 4096 (data.getObjValD \\\"relation\\\")\\n      let some edge := AllEdge.fromValue? value | throw \\\"source child does not name an All\\\"\\n      unless original == requested && edge.children.contains original do\\n        throw \\\"source child is absent from its original All\\\"\\n  | \\\"indexed\\\" =>\\n      let directory ← data.getObjValAs? String \\\"directory\\\"\\n      unless (System.FilePath.mk directory).isAbsolute do throw \\\"relative child source directory\\\"\\n      let _ ← (fromJson? (data.getObjValD \\\"head\\\") : Except String DB.PageMap.Head)\\n      let owner ← data.getObjValAs? Nat \\\"owner\\\"\\n      let child ← data.getObjValAs? Nat \\\"child\\\"\\n      let frame ← Persistence.Store.NodeFrame.fromJson (data.getObjValD \\\"frame\\\")\\n      let some checked := frame.check owner | throw \\\"source child frame has forward references\\\"\\n      let some header := Persistence.Store.AllHeader.fromFrame? checked |\\n        throw \\\"source child frame is not an original All\\\"\\n      unless header.children.contains child do throw \\\"source child posting lost its position\\\"\\n  | _ => throw \\\"unknown source child evidence\\\"\\n  pure (some (requested, original))\\n\\n/-- Compare only against the generator prefix available at an observation. -/\\ndef replayComparisons (persistent runLocal : List UnionEdge) (localCount : Nat)\\n    (pairs : List (String × Value × Value × Bool)) : Except String (List Json) := do\\n  unless localCount ≤ runLocal.length do throw \\\"comparison prefix is outside the recorded run\\\"\\n  let active := runLocal.take localCount\\n  let roots := pairs.flatMap fun (_, left, right, _) => [left, right]\\n  let some quotient := QuotientBuilder.build? roots persistent active |\\n    throw \\\"observation snapshot does not generate a valid quotient\\\"\\n  let stored := EqualityDependency.DirectIndex.make persistent\\n  let all := EqualityDependency.DirectIndex.make (persistent ++ active)\\n  pairs.mapM fun (role, left, right, accepted) => do\\n    let kind := EqualityDependency.classify quotient.toEquality stored all left right\\n    unless (kind != .notEquivalent) == accepted do\\n      throw \\\"comparison changed under its original generator prefix\\\"\\n    pure (Json.mkObj [(\\\"role\\\", toJson role), (\\\"accepted\\\", toJson accepted),\\n      (\\\"kind\\\", toJson (kindName kind)), (\\\"left\\\", Persistence.valueToJson left),\\n      (\\\"right\\\", Persistence.valueToJson right)])\\n\\ndef analyzeUnionOrigin (persistent runLocal : List UnionEdge) (origin : UnionOrigin) : Except String Json := do\\n  let some edge := runLocal[origin.generator]? | throw \\\"local origin names a missing generator\\\"\\n  unless origin.localCount ≤ origin.generator do\\n    throw \\\"a local generator depends on itself or a future generator\\\"\\n  let inquiry ← Persistence.valueFromJson 4096 origin.inquiry\\n  let demand ← Persistence.valueFromJson 4096 origin.demand\\n  let work ← Persistence.valueFromJson 4096 origin.work\\n  let current ← Persistence.valueFromJson 4096 origin.currentFragment\\n  let past ← Persistence.valueFromJson 4096 origin.pastFragment\\n  unless edge.scope == .run inquiry && edge.left == current && edge.right == past do\\n    throw \\\"local generator changed its nomination endpoints or Inquiry scope\\\"\\n  unless !origin.retrieved && !origin.fragmentIdentity &&\\n      (origin.priorComplete || origin.demandComplete ||\\n        origin.priorWeight != 0 || origin.demandWeight != 0) do\\n    throw \\\"recorded Match did not pass the local-Union nomination gate\\\"\\n  let comparisons ← replayComparisons persistent runLocal origin.localCount [\\n    (\\\"wholeWorkIdentity\\\", demand, work, origin.wholeIdentity),\\n    (\\\"fragmentIdentity\\\", current, past, origin.fragmentIdentity)]\\n  pure (Json.mkObj [(\\\"generator\\\", toJson origin.generator), (\\\"localCount\\\", toJson origin.localCount),\\n    (\\\"status\\\", toJson \\\"nomination-replayed\\\"), (\\\"inquiry\\\", origin.inquiry),\\n    (\\\"comparisons\\\", toJson comparisons), (\\\"schedulingAncestry\\\", toJson \\\"untracked\\\"),\\n    (\\\"patternSelectionAncestry\\\", toJson \\\"untracked\\\"), (\\\"schedule\\\", toJson origin.schedule)])\\n\\n/-- Replay the exact generator prefix observed at Match construction. Future\\nlocal Unions cannot retroactively justify an admission comparison. Source IO\\nbindings remain an explicit boundary; this checks their retained frame, not\\nthe current filesystem or semantic truth of the observation. -/\\ndef analyzeAdmission (persistent runLocal : List UnionEdge) (branches : List CompletedBranch)\\n    (admission : AdmissionSnapshot) : Except String Json := do\\n  unless admission.localCount ≤ runLocal.length && !admission.branches.isEmpty do\\n    throw \\\"invalid admission generator prefix or empty branch binding\\\"\\n  let demand ← Persistence.valueFromJson 4096 admission.demand\\n  let work ← Persistence.valueFromJson 4096 admission.work\\n  let current ← Persistence.valueFromJson 4096 admission.currentFragment\\n  let past ← Persistence.valueFromJson 4096 admission.pastFragment\\n  let basis := if admission.classIdentity then\\n      admission.wholeIdentity && admission.pastWhole &&\\n        admission.priorComplete.isNone && admission.demandComplete.isNone &&\\n        current == demand && past == work\\n    else match admission.priorComplete, admission.demandComplete with\\n      | some prior, some present => (admission.pastWhole && prior) ||\\n          (admission.groundedFragment && (prior || present))\\n      | _, _ => false\\n  unless !admission.retrieved && admission.subwork && admission.fragmentIdentity && basis do\\n    throw \\\"recorded Match did not pass the completed admission gate\\\"\\n  for position in admission.branches do\\n    let some branch := branches[position]? | throw \\\"admission branch is outside the selection\\\"\\n    unless branch.owner == admission.owner do throw \\\"admission crossed source owners\\\"\\n    let value ← Persistence.valueFromJson 4096 branch.projectedOutcome\\n    let some edge := OutcomeEdge.fromValue? value | throw \\\"admission branch is not an Outcome\\\"\\n    let originalWork := if admission.classIdentity then work else current\\n    unless edge.work == originalWork && branch.demand == admission.currentFragment do\\n      throw \\\"admission changed the projected Work fragment or admitted demand\\\"\\n  let child ← admissionChild admission.child\\n  if admission.classIdentity && child.isNone then\\n    throw \\\"class identity completion has no original child witness\\\"\\n  let pairs := [(\\\"wholeWorkIdentity\\\", demand, work, admission.wholeIdentity),\\n    (\\\"fragmentIdentity\\\", current, past, admission.fragmentIdentity)] ++\\n    (child.toList.flatMap fun (requested, original) =>\\n      [(\\\"subworkAlias\\\", work, requested, true), (\\\"originalChildAlias\\\", requested, original, true)])\\n  let comparisons ← replayComparisons persistent runLocal admission.localCount pairs\\n  pure (Json.mkObj [(\\\"owner\\\", toJson admission.owner), (\\\"branches\\\", toJson admission.branches),\\n    (\\\"classIdentity\\\", toJson admission.classIdentity),\\n    (\\\"localCount\\\", toJson admission.localCount), (\\\"status\\\", toJson \\\"replayed\\\"),\\n    (\\\"sourceChild\\\", toJson (if child.isSome then \\\"recorded-source-boundary\\\" else \\\"untracked\\\")),\\n    (\\\"childEvidence\\\", admission.child), (\\\"comparisons\\\", toJson comparisons),\\n    (\\\"schedule\\\", toJson admission.schedule)])\\n\\ndef decodeAll (data : Json) : Except String AllEdge := do\\n  let value ← Persistence.valueFromJson 4096 data\\n  let some edge := AllEdge.fromValue? value | throw \\\"discovery trace does not name an All relation\\\"\\n  pure edge\\n\\ndef analyzeSchedule (persistent runLocal : List UnionEdge)\\n    (schedule : DiscoveryAudit.ScheduleSnapshot) : Except String Json := do\\n  unless [\\\"discovery\\\", \\\"terminal\\\"].contains schedule.kind do throw \\\"unknown scheduling observation\\\"\\n  let current ← Persistence.valueFromJson 4096 schedule.current\\n  let discovery ← schedule.discovery.mapM (Persistence.valueFromJson 4096)\\n  let tasks ← schedule.tasks.mapM (Persistence.valueFromJson 4096)\\n  let prior ← schedule.runAll.mapM decodeAll\\n  let expected := discovery.filter fun task =>\\n    !HandoffRemainder.isValue task && Matcher.freshDemand current prior task\\n  unless tasks == expected do throw \\\"scheduled tasks differ from the actual discovery filter\\\"\\n  if schedule.kind == \\\"terminal\\\" then\\n    unless discovery == [current] && tasks == [current] && prior.isEmpty &&\\n        schedule.premises.isEmpty && schedule.uses.isEmpty do\\n      throw \\\"terminal scheduling changed its certified unadmitted root\\\"\\n  let pairs ← schedule.premises.mapM fun premise => do\\n    unless [\\\"decomposition\\\", \\\"deduplicatedChild\\\", \\\"completedOutcome\\\", \\\"advisoryOutcome\\\"].contains premise.role do\\n      throw \\\"unknown scheduling comparison role\\\"\\n    pure (premise.role, ← Persistence.valueFromJson 4096 premise.left,\\n      ← Persistence.valueFromJson 4096 premise.right, true)\\n  let comparisons ← replayComparisons persistent runLocal schedule.localCount pairs\\n  for use in schedule.uses do\\n    let edge ← decodeAll use.relation\\n    unless use.generated == prior.any (fun before => before.relation == edge.relation) do\\n      throw \\\"scheduling confused an original All with a generated continuation\\\"\\n    unless schedule.premises.any (fun premise => premise.role == \\\"decomposition\\\" &&\\n        premise.left == Persistence.valueToJson edge.parent) do\\n      throw \\\"scheduling lost a selected All-parent comparison\\\"\\n  pure (Json.mkObj [(\\\"pass\\\", toJson schedule.pass), (\\\"kind\\\", toJson schedule.kind),\\n    (\\\"localCount\\\", toJson schedule.localCount), (\\\"discovery\\\", toJson schedule.discovery),\\n    (\\\"tasks\\\", toJson schedule.tasks), (\\\"comparisons\\\", toJson comparisons),\\n    (\\\"uses\\\", toJson schedule.uses), (\\\"scope\\\", toJson \\\"whole-scheduling-selection\\\"),\\n    (\\\"dependencySlice\\\", toJson \\\"untracked\\\"), (\\\"admissionAncestry\\\", toJson \\\"untracked\\\")])\\n\\ndef scheduleBinding (schedules : List DiscoveryAudit.ScheduleSnapshot)\\n    (pass : Option Nat) (localCount : Nat) (demand : Json) : Except String Bool := do\\n  let some pass := pass | return false\\n  let some schedule := schedules.find? (·.pass == pass) | return false\\n  unless schedule.localCount == localCount && schedule.tasks.contains demand do\\n    throw \\\"Match observation changed its scheduled Demand or equality epoch\\\"\\n  pure true\\n\\ndef analyzeContinuation (persistent runLocal : List UnionEdge)\\n    (schedules : List DiscoveryAudit.ScheduleSnapshot)\\n    (event : DiscoveryAudit.ContinuationSnapshot) : Except String Json := do\\n  unless event.localCount ≤ runLocal.length do throw \\\"continuation equality epoch is outside the run\\\"\\n  let creation := schedules.find? (·.pass == event.pass)\\n  if let some schedule := creation then\\n    unless schedule.localCount == event.localCount && schedule.current == event.current do\\n      throw \\\"continuation changed the scheduling step which created it\\\"\\n  let current ← Persistence.valueFromJson 4096 event.current\\n  let edge ← decodeAll event.relation\\n  let remainder := HandoffRemainder.value event.text\\n  unless current == Value.text event.text && edge.parent == current &&\\n      edge.children.getLast? == some remainder do\\n    throw \\\"continuation changed its external root or mandatory open remainder\\\"\\n  let positions := event.support.map (·.child)\\n  unless positions.eraseDups.length == positions.length do throw \\\"duplicate continuation child support\\\"\\n  let support ← event.support.mapM fun row => do\\n    let some child := edge.children[row.child]? | throw \\\"continuation support names a missing child\\\"\\n    let demand ← Persistence.valueFromJson 4096 row.demand\\n    let work ← Persistence.valueFromJson 4096 row.work\\n    let fragment ← Persistence.valueFromJson 4096 row.currentFragment\\n    let past ← Persistence.valueFromJson 4096 row.pastFragment\\n    unless child != remainder && demand == current && row.automatic && row.subwork && fragment == child do\\n      throw \\\"continuation child lost its actual automatic root Match\\\"\\n    let comparisons ← row.localCount.mapM fun before => do\\n      unless before ≤ event.localCount do throw \\\"continuation used a future Match observation\\\"\\n      replayComparisons persistent runLocal before [\\n        (\\\"wholeWorkIdentity\\\", demand, work, row.wholeIdentity),\\n        (\\\"fragmentIdentity\\\", fragment, past, row.fragmentIdentity)]\\n    let scheduled ← match row.localCount with\\n      | none => pure false\\n      | some before => scheduleBinding schedules row.schedule before row.demand\\n    if let some pass := row.schedule then\\n      unless pass ≤ event.pass do throw \\\"continuation used a future scheduled Match\\\"\\n    pure (Json.mkObj [(\\\"child\\\", toJson row.child), (\\\"schedule\\\", toJson row.schedule),\\n      (\\\"localCount\\\", toJson row.localCount), (\\\"comparisons\\\", toJson comparisons),\\n      (\\\"scheduling\\\", toJson (if scheduled then \\\"recorded-step\\\" else \\\"untracked\\\")),\\n      (\\\"automaticGate\\\", toJson \\\"captured-production-result\\\"),\\n      (\\\"childRoleAncestry\\\", toJson \\\"untracked\\\"), (\\\"retrieved\\\", toJson row.retrieved)])\\n  let unknown := edge.children.zipIdx.filterMap fun (child, index) =>\\n    if child != remainder && !positions.contains index then some index else none\\n  pure (Json.mkObj [(\\\"pass\\\", toJson event.pass), (\\\"localCount\\\", toJson event.localCount),\\n    (\\\"relation\\\", event.relation), (\\\"status\\\", toJson \\\"captured-production-continuation\\\"),\\n    (\\\"creationScheduling\\\", toJson (if creation.isSome then \\\"recorded-step\\\" else \\\"untracked\\\")),\\n    (\\\"support\\\", toJson support), (\\\"untrackedChildren\\\", toJson unknown),\\n    (\\\"dependencySlice\\\", toJson \\\"untracked\\\")])\\n\\n/-- Join a selected structural All to an actual generation event. The source\\nflag comes from the controller's runAll, never absence of a telemetry record. -/\\ndef analyzeAllUse (events : List DiscoveryAudit.ContinuationSnapshot)\\n    (bound : Option (Nat × Nat)) (strict : Bool) (use : DiscoveryAudit.AllUse) : Except String Json := do\\n  let _ ← decodeAll use.relation\\n  let generators := events.zipIdx.filter (fun (event, _) => event.relation == use.relation)\\n  let producer ← if !use.generated then pure none else do\\n    let some (pass, count) := bound | pure none\\n    let eligible := generators.find? fun (event, _) => event.localCount ≤ count &&\\n      (if strict then event.pass < pass else event.pass ≤ pass)\\n    if eligible.isNone && !generators.isEmpty then\\n      throw \\\"selected All used a future continuation generation\\\"\\n    pure eligible\\n  pure (Json.mkObj [(\\\"relation\\\", use.relation), (\\\"generated\\\", toJson use.generated),\\n    (\\\"origin\\\", toJson (if !use.generated then \\\"source-selection-boundary\\\"\\n      else if producer.isSome then \\\"recorded-generation\\\" else \\\"untracked\\\")),\\n    (\\\"continuation\\\", toJson (producer.map (·.2))),\\n    (\\\"generationPass\\\", toJson (producer.map (·.1.pass))),\\n    (\\\"generationLocalCount\\\", toJson (producer.map (·.1.localCount))),\\n    (\\\"causalAncestry\\\", toJson \\\"untracked\\\")])\\n\\n/-- Explicit-only folds and congruence replay run outside the hook deadline.\\nThe result concerns selected comparisons, never whole-delivery ancestry. -/\\ndef analyze (snapshot : Snapshot) : Except String Json := do\\n  let persistent ← snapshot.persistent.mapM Generator.decode\\n  let runLocal ← snapshot.runLocal.mapM Generator.decode\\n  let current ← Persistence.valueFromJson 4096 snapshot.current\\n  let pairs ← snapshot.premises.mapM fun premise => do\\n    unless [\\\"decomposition\\\", \\\"deduplicatedChild\\\", \\\"completedOutcome\\\", \\\"advisoryOutcome\\\"].contains premise.role do\\n      throw \\\"unknown selected comparison role\\\"\\n    pure (premise.role, ← Persistence.valueFromJson 4096 premise.left,\\n      ← Persistence.valueFromJson 4096 premise.right)\\n  let roots := current :: pairs.flatMap (fun (_, left, right) => [left, right])\\n  let some quotient := QuotientBuilder.build? roots persistent runLocal |\\n    throw \\\"selected equality snapshot does not generate a valid quotient\\\"\\n  let stored := EqualityDependency.DirectIndex.make persistent\\n  let all := EqualityDependency.DirectIndex.make (persistent ++ runLocal)\\n  let rows ← pairs.mapM fun (role, left, right) => do\\n    let kind := EqualityDependency.classify quotient.toEquality stored all left right\\n    if kind == .notEquivalent then throw \\\"selected positive comparison failed equality replay\\\"\\n    pure (Json.mkObj [(\\\"role\\\", toJson role), (\\\"kind\\\", toJson (kindName kind)),\\n      (\\\"left\\\", Persistence.valueToJson left), (\\\"right\\\", Persistence.valueToJson right)])\\n  let continuationPasses := snapshot.continuations.map (·.pass)\\n  unless continuationPasses.eraseDups.length == continuationPasses.length do\\n    throw \\\"duplicate continuation generation step\\\"\\n  let continuations ← snapshot.continuations.mapM (analyzeContinuation persistent runLocal snapshot.schedules)\\n  let allUses ← snapshot.decompositions.mapM (analyzeAllUse snapshot.continuations\\n    (snapshot.finalPass.map (fun pass => (pass, runLocal.length))) false)\\n  let branches ← snapshot.completedBranches.zipIdx.mapM fun (branch, index) => do\\n    unless snapshot.owners.contains branch.owner do\\n      throw \\\"completed branch is not part of the checked selection\\\"\\n    let premises ← branch.premises.mapM fun position =>\\n      match snapshot.premises[position]? with\\n      | some premise => pure premise\\n      | none => throw \\\"completed branch comparison is outside the checked selection\\\"\\n    let demand ← Persistence.valueFromJson 4096 branch.demand\\n    let projected ← Persistence.valueFromJson 4096 branch.projectedOutcome\\n    let [edge] := (WorkGraph.fromValues [projected]).outcomes |\\n      throw \\\"completed branch does not name an Outcome\\\"\\n    unless premises.getLast? == some (DiscoveryAudit.ComparisonRow.encode\\n        ⟨.completedOutcome, edge.work, demand⟩) do\\n      throw \\\"completed branch lost its terminal Outcome comparison\\\"\\n    let comparisons ← branch.premises.mapM fun position =>\\n      match rows[position]? with\\n      | some row => pure row\\n      | none => throw \\\"completed branch comparison was not replayed\\\"\\n    let decompositions ← branch.decompositions.mapM fun position => do\\n      let some use := snapshot.decompositions[position]? |\\n        throw \\\"completed branch All is outside the structural pool\\\"\\n      let edge ← decodeAll use.relation\\n      unless premises.any (fun premise => premise.role == \\\"decomposition\\\" &&\\n          premise.left == Persistence.valueToJson edge.parent) do\\n        throw \\\"completed branch All lost its selected parent comparison\\\"\\n      let some row := allUses[position]? | throw \\\"completed branch All was not replayed\\\"\\n      pure (row.setObjVal! \\\"allUse\\\" (toJson position))\\n    let unknownDecompositions := branch.premises.filter fun position =>\\n      match snapshot.premises[position]? with\\n      | none => false\\n      | some premise => premise.role == \\\"decomposition\\\" && !branch.decompositions.any (fun index =>\\n          ((snapshot.decompositions[index]?).bind (fun use => (decodeAll use.relation).toOption)).any\\n            (fun edge => premise.left == Persistence.valueToJson edge.parent))\\n    pure (Json.mkObj [(\\\"selectionBranch\\\", toJson index), (\\\"owner\\\", toJson branch.owner), (\\\"demand\\\", branch.demand),\\n      (\\\"projectedOutcome\\\", branch.projectedOutcome), (\\\"comparisons\\\", toJson comparisons),\\n      (\\\"decompositions\\\", toJson decompositions), (\\\"structuralAncestry\\\", toJson \\\"untracked\\\"),\\n      (\\\"untrackedDecompositionComparisons\\\", toJson unknownDecompositions)])\\n  let admissions ← snapshot.admissions.mapM (analyzeAdmission persistent runLocal snapshot.completedBranches)\\n  let originIndices := snapshot.localOrigins.map (·.generator)\\n  unless originIndices.eraseDups.length == originIndices.length do\\n    throw \\\"local generator has duplicate origin records\\\"\\n  let origins ← snapshot.localOrigins.mapM (analyzeUnionOrigin persistent runLocal)\\n  let passes := snapshot.schedules.map (·.pass)\\n  unless passes.eraseDups.length == passes.length do throw \\\"duplicate scheduling observation\\\"\\n  let schedules ← snapshot.schedules.mapM fun schedule => do\\n    let row ← analyzeSchedule persistent runLocal schedule\\n    let uses ← schedule.uses.mapM (analyzeAllUse snapshot.continuations\\n      (some (schedule.pass, schedule.localCount)) true)\\n    pure (row.setObjVal! \\\"generationUses\\\" (toJson uses))\\n  let admissions ← (snapshot.admissions.zip admissions).mapM fun (record, row) => do\\n    let known ← scheduleBinding snapshot.schedules record.schedule record.localCount record.demand\\n    pure (row.setObjVal! \\\"schedulingAncestry\\\" (toJson (if known then \\\"recorded-step\\\" else \\\"untracked\\\")))\\n  let origins ← (snapshot.localOrigins.zip origins).mapM fun (record, row) => do\\n    let known ← scheduleBinding snapshot.schedules record.schedule record.localCount record.demand\\n    pure (row.setObjVal! \\\"schedulingAncestry\\\" (toJson (if known then \\\"recorded-step\\\" else \\\"untracked\\\")))\\n  pure (Json.mkObj [\\n    (\\\"status\\\", toJson \\\"partial\\\"), (\\\"component\\\", toJson \\\"selected-extraction\\\"),\\n    (\\\"scope\\\", toJson \\\"whole-selected-extraction-before-source-and-transport-pruning\\\"),\\n    (\\\"deliveryAncestry\\\", toJson \\\"untracked\\\"),\\n    (\\\"localUnionAncestry\\\", toJson \\\"untracked\\\"),\\n    (\\\"localUnionOrigins\\\", toJson origins),\\n    (\\\"localOriginScope\\\", toJson \\\"recorded-run-before-source-and-transport-pruning\\\"),\\n    (\\\"untrackedLocalOrigins\\\", toJson ((List.range runLocal.length).filter (!originIndices.contains ·))),\\n    (\\\"completedBranchScope\\\", toJson \\\"selected-root-to-outcome-positive-comparisons\\\"),\\n    (\\\"finalLeafSlice\\\", toJson \\\"untracked\\\"),\\n    (\\\"matchAdmission\\\", toJson (if admissions.isEmpty then \\\"untracked\\\" else \\\"partial\\\")),\\n    (\\\"sourceChildWitness\\\", toJson \\\"per-admission-source-boundary\\\"),\\n    (\\\"matchAdmissions\\\", toJson admissions),\\n    (\\\"continuationAncestry\\\", toJson \\\"untracked\\\"),\\n    (\\\"schedulingAncestry\\\", toJson (if schedules.isEmpty then \\\"untracked\\\" else \\\"partial\\\")),\\n    (\\\"schedulingRecords\\\", toJson schedules), (\\\"continuationRecords\\\", toJson continuations),\\n    (\\\"selectedAllUses\\\", toJson allUses),\\n    (\\\"completedBranches\\\", toJson branches),\\n    (\\\"comparisons\\\", toJson rows)])\\n\\ndef read (reference : Reference) : IO Snapshot := do\\n  unless Receipt.validId reference.receipt && reference.stage.startsWith \\\"selection-\\\" &&\\n      Receipt.validId ((reference.stage.drop 10).copy) do\\n    throw (IO.userError \\\"invalid selected equality receipt locator\\\")\\n  let path := (← Paths.dataRoot) / \\\"receipts\\\" / reference.receipt / (reference.stage ++ \\\".json\\\")\\n  FileSystem.rejectSymlinkAncestors path\\n  let bytes ← FileSystem.boundedBytes path (8 * 1024 * 1024)\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid equality receipt encoding\\\")\\n  let envelope ← IO.ofExcept (Json.parse text)\\n  unless envelope.getObjValD \\\"receipt\\\" == toJson reference.receipt &&\\n      envelope.getObjValD \\\"stage\\\" == toJson reference.stage do\\n    throw (IO.userError \\\"selected equality receipt identity mismatch\\\")\\n  let data ← IO.ofExcept (envelope.getObjVal? \\\"data\\\")\\n  unless Sha256.hex data.compress.toUTF8 == reference.sha256 do\\n    throw (IO.userError \\\"selected equality snapshot digest mismatch\\\")\\n  let snapshot ← IO.ofExcept (fromJson? data : Except String Snapshot)\\n  unless (reference.visible ++ reference.controls).all snapshot.owners.contains do\\n    throw (IO.userError \\\"delivered completed owner is absent from the selected extraction\\\")\\n  pure snapshot\\n\\ndef inspect (reference : Reference) : IO Json := do\\n  let snapshot ← read reference\\n  let result ← IO.ofExcept (analyze snapshot)\\n  let branches ← IO.ofExcept (result.getObjValAs? (List Json) \\\"completedBranches\\\")\\n  let retained := branches.filterMap fun branch =>\\n    let owner := (branch.getObjValAs? String \\\"owner\\\").toOption.getD \\\"\\\"\\n    let visible := reference.visible.contains owner\\n    let control := reference.controls.contains owner\\n    if visible || control then some\\n      ((branch.setObjVal! \\\"ownerVisible\\\" (toJson visible)).setObjVal! \\\"ownerControls\\\" (toJson control))\\n    else none\\n  let recorded := snapshot.completedBranches.map (·.owner)\\n  let unknown := (reference.visible ++ reference.controls).eraseDups.filter (!recorded.contains ·)\\n  let positions := retained.filterMap fun branch => (branch.getObjValAs? Nat \\\"selectionBranch\\\").toOption\\n  let admissions ← IO.ofExcept (result.getObjValAs? (List Json) \\\"matchAdmissions\\\")\\n  let admissions := admissions.filterMap fun admission =>\\n    let used := ((admission.getObjValAs? (List Nat) \\\"branches\\\").toOption.getD []).filter positions.contains\\n    if used.isEmpty then none else some (admission.setObjVal! \\\"branches\\\" (toJson used))\\n  let admitted := admissions.flatMap fun admission =>\\n    (admission.getObjValAs? (List Nat) \\\"branches\\\").toOption.getD []\\n  let sourced := (admissions.filter (fun admission =>\\n    admission.getObjValD \\\"sourceChild\\\" != toJson \\\"untracked\\\")).flatMap fun admission =>\\n      (admission.getObjValAs? (List Nat) \\\"branches\\\").toOption.getD []\\n  pure ((((((result.setObjVal! \\\"retained\\\" (toJson reference)).setObjVal!\\n    \\\"completedBranches\\\" (toJson retained)).setObjVal! \\\"untrackedCompletedOwners\\\" (toJson unknown)).setObjVal!\\n    \\\"matchAdmissions\\\" (toJson admissions)).setObjVal!\\n    \\\"untrackedAdmissionBranches\\\" (toJson (positions.filter (!admitted.contains ·)))).setObjVal!\\n    \\\"untrackedSourceChildBranches\\\" (toJson (positions.filter (!sourced.contains ·))))\\n\\ndef readStage (receipt stage : String) : IO Json := do\\n  unless Receipt.validId receipt && [\\\"search\\\", \\\"published\\\", \\\"ack\\\"].contains stage do\\n    throw (IO.userError \\\"invalid hook receipt stage\\\")\\n  let path := (← Paths.dataRoot) / \\\"receipts\\\" / receipt / (stage ++ \\\".json\\\")\\n  FileSystem.rejectSymlinkAncestors path\\n  let bytes ← FileSystem.boundedBytes path (8 * 1024 * 1024)\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid hook receipt encoding\\\")\\n  let envelope ← IO.ofExcept (Json.parse text)\\n  unless envelope.getObjValD \\\"receipt\\\" == toJson receipt && envelope.getObjValD \\\"stage\\\" == toJson stage do\\n    throw (IO.userError \\\"hook receipt stage identity mismatch\\\")\\n  IO.ofExcept (envelope.getObjVal? \\\"data\\\")\\n\\ndef inspectHook (receipt : String) : IO Json := do\\n  let search ← readStage receipt \\\"search\\\"\\n  let reference ← IO.ofExcept\\n    (fromJson? ((search.getObjValD \\\"equalityOrigin\\\").getObjValD \\\"selection\\\") : Except String Reference)\\n  let analysis ← inspect reference\\n  let published ← try pure (some (← readStage receipt \\\"published\\\")) catch _ => pure none\\n  let acknowledgement ← try pure (some (← readStage receipt \\\"ack\\\")) catch _ => pure none\\n  if let some record := published then\\n    let output ← IO.ofExcept (record.getObjValAs? String \\\"output\\\")\\n    unless record.getObjValD \\\"sha256\\\" == toJson (Sha256.hex output.toUTF8) &&\\n        record.getObjValD \\\"bytes\\\" == toJson output.utf8ByteSize do\\n      throw (IO.userError \\\"published hook output digest mismatch\\\")\\n  pure (Json.mkObj [(\\\"receipt\\\", toJson receipt), (\\\"search\\\", search),\\n    (\\\"published\\\", toJson published), (\\\"acknowledgement\\\", toJson acknowledgement),\\n    (\\\"hostIngestion\\\", toJson \\\"unconfirmed\\\"), (\\\"selection\\\", analysis)])\\n\\nend Eggshell.SelectionAudit\\n\",[]]"],["Eggshell.SelectionDependency","[\"module\\n\\npublic import Eggshell.EqualityDependency\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SelectionDependency\\n\\ninductive Role where\\n  | decomposition\\n  | deduplicatedChild\\n  | completedOutcome\\n  | advisoryOutcome\\n  deriving BEq, Hashable, DecidableEq, Repr\\n\\nstructure Comparison where\\n  role : Role\\n  left : Value\\n  right : Value\\n  deriving BEq, Hashable\\n\\ndef Comparison.holds (equality : Equality) (comparison : Comparison) : Bool :=\\n  equality.same comparison.left comparison.right\\n\\n/-- Replay only the selected All's quotient deduplication. The first retained\\nwitness is the one tested by the production `any` predicate. -/\\ndef dedupFrom (equality : Equality) (kept : List Value) :\\n    List Value → List Value × List Comparison\\n  | [] => (kept, [])\\n  | value :: tail =>\\n      match kept.find? (equality.same value) with\\n      | none => dedupFrom equality (value :: kept) tail\\n      | some prior =>\\n          let next := dedupFrom equality kept tail\\n          (next.1, ⟨.deduplicatedChild, value, prior⟩ :: next.2)\\n\\ntheorem dedupFrom_output (equality : Equality) (values kept : List Value) :\\n    (dedupFrom equality kept values).1 =\\n      values.foldl (fun current value =>\\n        if current.any (equality.same value) then current else value :: current) kept := by\\n  induction values generalizing kept with\\n  | nil => rfl\\n  | cons value tail ih =>\\n    have predicate := List.isSome_find? (xs := kept) (f := equality.same value)\\n    cases found : kept.find? (equality.same value) with\\n    | none =>\\n      have absent : kept.any (equality.same value) = false := by simpa [found] using predicate.symm\\n      simp only [dedupFrom, found, List.foldl_cons, absent, Bool.false_eq_true, ↓reduceIte]\\n      exact ih _\\n    | some prior =>\\n      have present : kept.any (equality.same value) = true := by simpa [found] using predicate.symm\\n      simp only [dedupFrom, found, List.foldl_cons, present, ↓reduceIte]\\n      exact ih _\\n\\ntheorem dedupFrom_positive (equality : Equality) (values kept : List Value)\\n    (comparison : Comparison) (member : comparison ∈ (dedupFrom equality kept values).2) :\\n    comparison.holds equality = true := by\\n  induction values generalizing kept with\\n  | nil => simp [dedupFrom] at member\\n  | cons value tail ih =>\\n    cases found : kept.find? (equality.same value) with\\n    | none => exact ih _ (by simpa [dedupFrom, found] using member)\\n    | some prior =>\\n      simp only [dedupFrom, found, List.mem_cons] at member\\n      rcases member with same | later\\n      · subst comparison\\n        simpa only [Comparison.holds] using (List.find?_some found)\\n      · exact ih _ later\\n\\ndef dedup (equality : Equality) (values : List Value) : List Value × List Comparison :=\\n  let result := dedupFrom equality [] values\\n  (result.1.reverse, result.2)\\n\\ntheorem dedup_output (equality : Equality) (values : List Value) :\\n    (dedup equality values).1 = WorkGraph.distinct equality values := by\\n  simp only [dedup, dedupFrom_output, WorkGraph.distinct]\\n\\nmutual\\n\\ndef structural (equality : Equality) (work : Value) : Selection → List Comparison\\n  | .residual _ _ | .outcomes _ _ _ => []\\n  | .handoff _ prior => structural equality work prior\\n  | .decomposed _ edge _ _ children =>\\n      let dropped := dedup equality edge.children\\n      ⟨.decomposition, edge.parent, work⟩ :: dropped.2 ++\\n        structuralChildren equality dropped.1 children\\n\\ndef structuralChildren (equality : Equality) : List Value → List Selection → List Comparison\\n  | work :: works, child :: children =>\\n      structural equality work child ++ structuralChildren equality works children\\n  | _, _ => []\\n\\nend\\n\\nmutual\\n\\ntheorem structural_positive (graph : WorkGraph) (equality : Equality) (work : Value)\\n    (selection : Selection) (valid : selection.structurallyValidAt graph equality work = true)\\n    (comparison : Comparison) (member : comparison ∈ structural equality work selection) :\\n    comparison.holds equality = true := by\\n  cases selection with\\n  | residual _ _ | outcomes _ _ _ => simp [structural] at member\\n  | handoff selected prior =>\\n      have next := (Bool.and_eq_true_iff.mp valid).2\\n      exact structural_positive graph equality work prior next comparison member\\n  | decomposed selected edge completed advisory children =>\\n      have parts := Bool.and_eq_true_iff.mp valid\\n      have before := Bool.and_eq_true_iff.mp parts.1\\n      simp only [structural, List.mem_cons, List.mem_append] at member\\n      rcases member with (same | dropped) | child\\n      · subst comparison\\n        exact before.2\\n      · exact dedupFrom_positive equality edge.children [] comparison dropped\\n      · apply structuralChildren_positive graph equality _ children _ comparison child\\n        simpa only [WorkGraph.childrenFor, dedup_output] using parts.2\\n\\ntheorem structuralChildren_positive (graph : WorkGraph) (equality : Equality)\\n    (works : List Value) (children : List Selection)\\n    (valid : Selection.structurallyValidChildren graph equality works children = true)\\n    (comparison : Comparison) (member : comparison ∈ structuralChildren equality works children) :\\n    comparison.holds equality = true := by\\n  cases works with\\n  | nil => simp [structuralChildren] at member\\n  | cons work works =>\\n      cases children with\\n      | nil => simp [structuralChildren] at member\\n      | cons child children =>\\n          have parts := Bool.and_eq_true_iff.mp valid\\n          simp only [structuralChildren, List.mem_append] at member\\n          rcases member with first | later\\n          · exact structural_positive graph equality work child parts.1 comparison first\\n          · exact structuralChildren_positive graph equality works children parts.2 comparison later\\n\\nend\\n\\ndef outcomeComparisons (role : Role) (uses : List (Value × OutcomeEdge)) : List Comparison :=\\n  uses.map fun (work, edge) => ⟨role, edge.work, work⟩\\n\\ndef comparisons (equality : Equality) (work : Value) (selection : Selection) : List Comparison :=\\n  structural equality work selection ++\\n    outcomeComparisons .completedOutcome selection.completedUses ++\\n    outcomeComparisons .advisoryOutcome selection.advisoryUses\\n\\n/-- Positive comparisons on one selected root-to-completed-Outcome path.\\nThese describe the executed selection, not a minimal counterfactual proof.\\nSibling subtrees contribute no premises; deduplication at a shared ancestor\\ndoes, since it determined that ancestor's retained child list. -/\\nstructure CompletedBranch where\\n  demand : Value\\n  edge : OutcomeEdge\\n  premises : List Comparison\\n  decompositions : List AllEdge := []\\n\\ndef ownBranches (work : Value) (edges : List OutcomeEdge) : List CompletedBranch :=\\n  edges.map fun edge => {demand := work, edge, premises := [⟨.completedOutcome, edge.work, work⟩]}\\n\\nmutual\\n\\ndef completedBranches (equality : Equality) (work : Value) : Selection → List CompletedBranch\\n  | .residual _ _ => []\\n  | .outcomes _ completed _ => ownBranches work completed\\n  | .handoff _ prior => completedBranches equality work prior\\n  | .decomposed _ edge completed _ children =>\\n      let dropped := dedup equality edge.children\\n      let ancestors := ⟨.decomposition, edge.parent, work⟩ :: dropped.2\\n      (ownBranches work completed ++ completedChildren equality dropped.1 children).map\\n        fun branch => {branch with\\n          premises := ancestors ++ branch.premises\\n          decompositions := edge :: branch.decompositions}\\n\\ndef completedChildren (equality : Equality) : List Value → List Selection → List CompletedBranch\\n  | work :: works, child :: children =>\\n      completedBranches equality work child ++ completedChildren equality works children\\n  | _, _ => []\\n\\nend\\n\\nmutual\\n\\ntheorem completedBranches_decomposition (equality : Equality) (work : Value)\\n    (selection : Selection) (branch : CompletedBranch)\\n    (member : branch ∈ completedBranches equality work selection)\\n    (edge : AllEdge) (used : edge ∈ branch.decompositions) :\\n    edge ∈ selection.decompositionEdges := by\\n  cases selection with\\n  | residual _ _ => simp [completedBranches] at member\\n  | outcomes _ completed _ =>\\n      obtain ⟨_, _, rfl⟩ := List.mem_map.mp member\\n      simp at used\\n  | handoff _ prior =>\\n      simpa only [Selection.decompositionEdges] using\\n        completedBranches_decomposition equality work prior branch member edge used\\n  | decomposed selected parent completed advisory children =>\\n      simp only [Selection.decompositionEdges]\\n      obtain ⟨before, present, rfl⟩ := List.mem_map.mp member\\n      simp only [List.mem_cons] at used\\n      rcases used with same | deeper\\n      · subst edge\\n        exact List.mem_cons_self\\n      · rcases List.mem_append.mp present with own | nested\\n        · obtain ⟨_, _, rfl⟩ := List.mem_map.mp own\\n          simp at deeper\\n        · obtain ⟨child, contains, selected⟩ := completedChildren_decomposition\\n            equality _ children before nested edge deeper\\n          exact List.mem_cons_of_mem _ (List.mem_flatMap.mpr ⟨child, contains, selected⟩)\\n\\ntheorem completedChildren_decomposition (equality : Equality)\\n    (works : List Value) (children : List Selection) (branch : CompletedBranch)\\n    (member : branch ∈ completedChildren equality works children)\\n    (edge : AllEdge) (used : edge ∈ branch.decompositions) :\\n    ∃ child ∈ children, edge ∈ child.decompositionEdges := by\\n  cases works with\\n  | nil => simp [completedChildren] at member\\n  | cons work works =>\\n      cases children with\\n      | nil => simp [completedChildren] at member\\n      | cons child children =>\\n          rcases List.mem_append.mp member with first | later\\n          · exact ⟨child, List.mem_cons_self,\\n              completedBranches_decomposition equality work child branch first edge used⟩\\n          · obtain ⟨selected, contains, used⟩ := completedChildren_decomposition\\n              equality works children branch later edge used\\n            exact ⟨selected, List.mem_cons_of_mem _ contains, used⟩\\n\\nend\\n\\ntheorem comparisons_positive (graph : WorkGraph) (equality : Equality) (policy : OutcomePolicy)\\n    (work : Value) (selection : Selection) (valid : selection.validFor graph equality policy work = true)\\n    (comparison : Comparison) (member : comparison ∈ comparisons equality work selection) :\\n    comparison.holds equality = true := by\\n  have outer := Bool.and_eq_true_iff.mp valid\\n  have middle := Bool.and_eq_true_iff.mp outer.1\\n  have first := Bool.and_eq_true_iff.mp middle.1\\n  simp only [comparisons, List.mem_append] at member\\n  rcases member with (tree | completed) | advisory\\n  · exact structural_positive graph equality work selection first.1 comparison tree\\n  · obtain ⟨⟨demand, edge⟩, present, same⟩ := List.mem_map.mp completed\\n    subst comparison\\n    exact (Bool.and_eq_true_iff.mp ((Bool.and_eq_true_iff.mp\\n      ((List.all_eq_true.mp middle.2) _ present)).1)).2\\n  · obtain ⟨⟨demand, edge⟩, present, same⟩ := List.mem_map.mp advisory\\n    subst comparison\\n    exact (Bool.and_eq_true_iff.mp ((Bool.and_eq_true_iff.mp\\n      ((List.all_eq_true.mp outer.2) _ present)).1)).2\\n\\n/-- A component of a delivery explanation. This validates the chosen\\nselection's equality premises; matcher admission, original child-role evidence\\nand causal ancestry of local generators are separate required components. -/\\nstructure Report (graph : WorkGraph) (equality : Equality) (policy : OutcomePolicy)\\n    (work : Value) (selection : Selection) : Type where\\n  valid : selection.validFor graph equality policy work = true\\n  premises : List Comparison\\n  exact : premises = comparisons equality work selection\\n  positive : ∀ premise ∈ premises, premise.holds equality = true\\n\\ndef Report.ofValid {graph : WorkGraph} {equality : Equality} {policy : OutcomePolicy}\\n    {work : Value} {selection : Selection}\\n    (valid : selection.validFor graph equality policy work = true) :\\n    Report graph equality policy work selection :=\\n  ⟨valid, comparisons equality work selection, rfl,\\n    comparisons_positive graph equality policy work selection valid⟩\\n\\ndef report? (graph : WorkGraph) (equality : Equality) (policy : OutcomePolicy)\\n    (work : Value) (selection : Selection) : Option (Report graph equality policy work selection) :=\\n  if valid : selection.validFor graph equality policy work = true then\\n    some (Report.ofValid valid)\\n  else none\\n\\nend Eggshell.SelectionDependency\\n\",[]]"],["Eggshell.SelectionReplay","[\"module\\n\\npublic import Eggshell.RankMemo\\n\\n@[expose] public section\\nnamespace Eggshell.Matcher.SelectionReplay\\n\\n/-- Runtime membership contains only unit ordinals. The refinement below\\nkeeps the old selected history entirely in erased propositions. -/\\nstructure Index where\\n  query : Std.HashMap Nat Unit\\n  target : Std.HashMap Nat Unit\\n\\nstructure Index.Represents (index : Index) (selected : List Evidence) : Prop where\\n  queryExact : ∀ unit, index.query.contains unit = (selected.flatMap (·.query.units)).contains unit\\n  targetExact : ∀ unit, index.target.contains unit = (selected.flatMap (·.target.units)).contains unit\\n\\ndef Index.empty : Index := ⟨{}, {}⟩\\n\\ntheorem Index.empty_exact : Index.empty.Represents [] :=\\n  ⟨by intro unit; simp [empty], by intro unit; simp [empty]⟩\\n\\ndef Index.conflicts (index : Index) (candidate : Evidence) : Bool :=\\n  candidate.query.units.any index.query.contains || candidate.target.units.any index.target.contains\\n\\ntheorem Index.conflicts_exact (index : Index) (known : index.Represents selected) (candidate : Evidence) :\\n    index.conflicts candidate =\\n      (candidate.query.units.any (selected.flatMap (·.query.units)).contains ||\\n       candidate.target.units.any (selected.flatMap (·.target.units)).contains) := by\\n  have query : index.query.contains = (selected.flatMap (·.query.units)).contains :=\\n    funext known.queryExact\\n  have target : index.target.contains = (selected.flatMap (·.target.units)).contains :=\\n    funext known.targetExact\\n  rw [conflicts, query, target]\\n\\ndef Index.extend (index : Index) (candidate : Evidence) : Index :=\\n  ⟨candidate.query.units.foldl (fun known unit => known.insert unit ()) index.query,\\n   candidate.target.units.foldl (fun known unit => known.insert unit ()) index.target⟩\\n\\ntheorem Index.extend_exact (index : Index) (known : index.Represents selected) (candidate : Evidence) :\\n    (index.extend candidate).Represents (selected ++ [candidate]) :=\\n  ⟨by intro unit; simp [extend, HashDistinct.fold_contains, known.queryExact],\\n   by intro unit; simp [extend, HashDistinct.fold_contains, known.targetExact]⟩\\n\\n/-- Witness positions refer to the current complete ordered evidence, not to\\nold positive hits. Every skipped candidate must currently overlap an earlier\\nselection; every selected candidate must currently be disjoint. -/\\ndef check (index : Index) (ordinal : Nat) (positions : List Nat) : List Evidence → Bool\\n  | [] => positions.isEmpty\\n  | candidate :: rest =>\\n      if index.conflicts candidate then\\n        if positions.head? == some ordinal then false\\n        else check index (ordinal + 1) positions rest\\n      else if positions.head? == some ordinal then\\n        check (index.extend candidate) (ordinal + 1) positions.tail rest\\n      else false\\n\\ndef pick (ordinal : Nat) (positions : List Nat) : List Evidence → List Evidence\\n  | [] => []\\n  | candidate :: rest =>\\n      if positions.head? == some ordinal then\\n        candidate :: pick (ordinal + 1) positions.tail rest\\n      else pick (ordinal + 1) positions rest\\n\\ntheorem check_exact (ranked : List Evidence) (index : Index) (known : index.Represents selected)\\n    (ordinal : Nat) (positions : List Nat)\\n    (accepted : check index ordinal positions ranked = true) :\\n    selected ++ pick ordinal positions ranked = ranked.foldl workSelectionStep selected := by\\n  induction ranked generalizing selected index ordinal positions with\\n  | nil => simp [pick]\\n  | cons candidate rest ih =>\\n      have overlap := index.conflicts_exact known candidate\\n      cases conflict : index.conflicts candidate <;>\\n        cases take : positions.head? == some ordinal <;>\\n        simp only [check, conflict, take, Bool.false_eq_true, ↓reduceIte] at accepted\\n      · have tail := ih (index.extend candidate) (index.extend_exact known candidate) (ordinal + 1) positions.tail accepted\\n        simpa only [pick, take, ↓reduceIte, List.foldl_cons, workSelectionStep,\\n          ← overlap, conflict, Bool.false_eq_true, ↓reduceIte, List.append_assoc,\\n          List.singleton_append] using tail\\n      · have tail := ih index known (ordinal + 1) positions accepted\\n        simpa only [pick, take, Bool.false_eq_true, ↓reduceIte, List.foldl_cons,\\n          workSelectionStep, ← overlap, conflict, ↓reduceIte] using tail\\n\\ndef certify (ranked : List Evidence) (positions : List Nat) :\\n    Option { chosen : List Evidence // chosen = workSelection ranked } :=\\n  if accepted : check Index.empty 0 positions ranked = true then\\n    some ⟨pick 0 positions ranked, by\\n      simpa only [List.nil_append, workSelection] using check_exact ranked Index.empty Index.empty_exact 0 positions accepted⟩\\n  else none\\n\\n/-- On a miss, produce only a compact position trace. The original ranked\\nobjects are selected afterward; previous unit lists are never rebuilt. -/\\ndef positions (index : Index) (ordinal : Nat) : List Evidence → List Nat\\n  | [] => []\\n  | candidate :: rest =>\\n      if index.conflicts candidate then positions index (ordinal + 1) rest\\n      else ordinal :: positions (index.extend candidate) (ordinal + 1) rest\\n\\ntheorem positions_lower (ranked : List Evidence) (index : Index) (ordinal : Nat)\\n    (position : Nat) (member : position ∈ positions index ordinal ranked) : ordinal ≤ position := by\\n  induction ranked generalizing index ordinal with\\n  | nil => simp [positions] at member\\n  | cons candidate rest ih =>\\n      simp only [positions] at member\\n      split at member\\n      · have later := ih index (ordinal + 1) member; omega\\n      · rcases List.mem_cons.mp member with same | later\\n        · omega\\n        · have later := ih (index.extend candidate) (ordinal + 1) later; omega\\n\\ntheorem positions_check (ranked : List Evidence) (index : Index) (ordinal : Nat) :\\n    check index ordinal (positions index ordinal ranked) ranked = true := by\\n  induction ranked generalizing index ordinal with\\n  | nil => rfl\\n  | cons candidate rest ih =>\\n      cases conflict : index.conflicts candidate\\n      · simpa only [positions, check, conflict, Bool.false_eq_true, ↓reduceIte,\\n          List.head?_cons, beq_self_eq_true, List.tail_cons] using\\n          ih (index.extend candidate) (ordinal + 1)\\n      · have next := ih index (ordinal + 1)\\n        have notCurrent : (positions index (ordinal + 1) rest).head? ≠ some ordinal := by\\n          cases found : positions index (ordinal + 1) rest with\\n          | nil => simp\\n          | cons head tail =>\\n              have later := positions_lower rest index (ordinal + 1) head (by rw [found]; simp)\\n              have different : head ≠ ordinal := by omega\\n              simp [different]\\n        simpa [positions, check, conflict, notCurrent] using next\\n\\ndef generate (ranked : List Evidence) :\\n    { chosen : List Evidence // chosen = workSelection ranked } × List Nat :=\\n  let saved := positions Index.empty 0 ranked\\n  (⟨pick 0 saved ranked, by\\n    simpa only [List.nil_append, workSelection] using\\n      check_exact ranked Index.empty Index.empty_exact 0 saved (positions_check ranked Index.empty 0)⟩, saved)\\n\\n/-- Arbitrary old/corrupt positions cannot produce a non-reference selection.\\nScores and source spans are reconstructed from the current chosen objects. -/\\ndef obtain (ranked : List Evidence) (saved : Option (List Nat)) :\\n    { chosen : List Evidence // chosen = workSelection ranked } × List Nat × Bool :=\\n  match saved with\\n  | some positions =>\\n      match certify ranked positions with\\n      | some chosen => (chosen, positions, true)\\n      | none => let found := generate ranked; (found.1, found.2, false)\\n  | none => let found := generate ranked; (found.1, found.2, false)\\n\\ntheorem obtain_exact (ranked : List Evidence) (saved : Option (List Nat)) :\\n    (obtain ranked saved).1.val = workSelection ranked := (obtain ranked saved).1.property\\n\\nend Eggshell.Matcher.SelectionReplay\\n\",[]]"],["Eggshell.SemanticMatcher","[\"module\\n\\npublic import Eggshell.Blake3\\npublic import Eggshell.Matcher\\npublic import Eggshell.Paths\\npublic import tools.OwnedRows\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SemanticMatcher\\n\\nopen Lean\\n\\nstructure Item where\\n  id : String\\n  text : String\\n  deriving ToJson, BEq\\n\\nstructure Request where\\n  query : Item\\n  candidates : List Item\\n  deriving ToJson\\n\\nstructure IndexRequest where\\n  index : List Item\\n  cache : Option DB.Sidecar.Owner := none\\n  cache_storage : DB.Sidecar.Storage := .database\\n  deriving ToJson\\n\\nstructure IndexResponse where\\n  indexed : List String\\n  deriving FromJson\\n\\n/-- Queue consumption requires an acknowledgement for this exact ordered batch. -/\\nstructure IndexReceipt (items : List Item) where\\n  indexed : List String\\n  exact_batch : indexed = items.map (·.id)\\n\\ndef indexReceipt? (items : List Item) (response : IndexResponse) :\\n    Option (IndexReceipt items) :=\\n  if exact : response.indexed = items.map (·.id) then\\n    some ⟨response.indexed, exact⟩\\n  else none\\n\\ntheorem index_receipt_matches_batch (items : List Item) (response : IndexResponse)\\n    (receipt : IndexReceipt items)\\n    (_accepted : indexReceipt? items response = some receipt) :\\n    receipt.indexed = items.map (·.id) := receipt.exact_batch\\n\\ntheorem mismatched_index_acknowledgement_rejected (items : List Item)\\n    (response : IndexResponse) (different : response.indexed ≠ items.map (·.id)) :\\n    indexReceipt? items response = none := by\\n  simp [indexReceipt?, different]\\n\\nstructure WindowChoice where\\n  document : Nat\\n  indices : List Nat\\n  deriving FromJson, ToJson\\n\\nstructure Response where\\n  related : List Nat\\n  ranked : List Nat := []\\n  evidence : List WindowChoice := []\\n  deriving FromJson\\n\\nstructure IndexedResponse where\\n  related : List Nat\\n  ranked : List Nat\\n  evidence : List WindowChoice := []\\n  deriving FromJson\\n\\n/-- A parent synthesis changes priority, never the eligibility of its evidence. -/\\ndef synthesizedChild (corpus : Matcher.Corpus) (candidate : Matcher.Candidate) : Bool :=\\n  corpus.parents.any fun parent =>\\n    parent.children.contains candidate.edge.work &&\\n      corpus.candidates.any fun owner => owner.edge.work == parent.parent\\n\\n/-- Keep the previous summary-first ordering, then admit every readable observed\\n    child. Sealing a turn cannot make its tool evidence unsearchable. -/\\ndef eligibleCandidates (corpus : Matcher.Corpus) : List Matcher.Candidate :=\\n  let readable := corpus.candidates.filter fun candidate =>\\n    (Matcher.atomText? candidate.edge.work).isSome\\n  readable.filter (fun candidate => !synthesizedChild corpus candidate) ++\\n    readable.filter (synthesizedChild corpus)\\n\\ntheorem eligible_iff_readable_owner (corpus : Matcher.Corpus)\\n    (candidate : Matcher.Candidate) :\\n    candidate ∈ eligibleCandidates corpus ↔\\n      candidate ∈ corpus.candidates ∧\\n        (Matcher.atomText? candidate.edge.work).isSome = true := by\\n  cases priority : synthesizedChild corpus candidate <;>\\n    simp [eligibleCandidates, priority]\\n\\n/-- This includes children of completed parents, independent of parent count,\\n    graph shape, provider scores, or text length. -/\\ntheorem readable_owner_remains_eligible (corpus : Matcher.Corpus)\\n    (candidate : Matcher.Candidate) (owner : candidate ∈ corpus.candidates)\\n    (readable : (Matcher.atomText? candidate.edge.work).isSome = true) :\\n    candidate ∈ eligibleCandidates corpus :=\\n  (eligible_iff_readable_owner corpus candidate).mpr ⟨owner, readable⟩\\n\\ndef relations (candidates : List Matcher.Candidate)\\n    (indices : List Nat) : List Value :=\\n  indices.eraseDups.filterMap fun index => do\\n    let candidate ← candidates[index]?\\n    pure candidate.edge.relation\\n\\n/-- Invalid or invented indexes resolve to no relation. -/\\ntheorem relations_subset_candidate_owners {candidates : List Matcher.Candidate}\\n    {indices : List Nat} {relation : Value}\\n    (member : relation ∈ relations candidates indices) :\\n    ∃ candidate ∈ candidates, candidate.edge.relation = relation := by\\n  simp only [relations, List.mem_filterMap] at member\\n  obtain ⟨index, _, resolved⟩ := member\\n  change candidates[index]?.bind (fun candidate =>\\n    some candidate.edge.relation) = some relation at resolved\\n  rw [Option.bind_eq_some_iff] at resolved\\n  obtain ⟨candidate, present, equal⟩ := resolved\\n  simp only [Option.some.injEq] at equal\\n  exact ⟨candidate, List.mem_of_getElem? present, equal⟩\\n\\ndef processStdio : IO.Process.StdioConfig := {\\n  stdin := .piped\\n  stdout := .piped\\n  stderr := .null\\n}\\n\\nabbrev Child := IO.Process.Child processStdio\\n\\nstructure Running where\\n  child : Child\\n\\ninductive Lane where\\n  | index\\n  | search\\n  deriving DecidableEq\\n\\n/-- Shared across installations and chats belonging to the same OS user.\\n    Never unlink a lease file: every contender must lock the same inode. -/\\ndef lanePath (lane : Lane) : IO System.FilePath := do\\n  let root := (← Paths.home) / \\\".cache\\\" / \\\"eggshell\\\" / \\\"resources\\\"\\n  Persistence.rejectSymlinkAncestors root\\n  Persistence.privateDirectory root\\n  pure (root / (match lane with | .index => \\\"index.guard\\\" | .search => \\\"search.guard\\\"))\\n\\ndef withLane (lane : Lane) (action : IO α) : IO (Option α) := do\\n  let path ← lanePath lane\\n  Persistence.rejectSymlinkAncestors path\\n  let handle ← IO.FS.Handle.mk path .append\\n  Persistence.privateFile path\\n  match lane with\\n  | .index => handle.lock\\n  | .search => if !(← handle.tryLock) then return none\\n  try\\n    some <$> action\\n  finally\\n    handle.unlock\\n\\ndef start : List String → IO Running\\n  | [] => throw (IO.userError \\\"semantic_matcher must name an executable\\\")\\n  | executable :: arguments => do\\n      let child : Child ← IO.Process.spawn {\\n        cmd := executable\\n        args := arguments.toArray\\n        stdin := .piped\\n        stdout := .piped\\n        stderr := .null\\n        -- Stay in the worker's owned group so worker cancellation also stops\\n        -- this provider and its numerical child.\\n      }\\n      pure { child }\\n\\ndef closeInput (running : Running) : IO (IO.Process.Child {\\n    stdin := .null, stdout := .piped, stderr := .null }) := do\\n  let (_, child) ← running.child.takeStdin\\n  pure child\\n\\ndef reapProvider (child : IO.Process.Child {\\n    stdin := .null, stdout := .piped, stderr := .null }) : Nat → IO Unit\\n  | 0 => do\\n      try child.kill catch _ => pure ()\\n      let _ ← child.wait\\n      pure ()\\n  | steps + 1 => do\\n      match ← child.tryWait with\\n      | some _ => pure () -- tryWait has already reaped this child.\\n      | none =>\\n          IO.sleep 5\\n          reapProvider child steps\\n\\ndef stop (running : Running) : IO Unit := do\\n  let child ← closeInput running\\n  -- EOF lets the provider reap its numerical child in its own finally block.\\n  -- A broken provider is terminated; its descendants remain in the worker's\\n  -- group and the numerical lease prevents another model from overtaking it.\\n  reapProvider child 200\\n\\ndef withProvider (command : List String) (action : Running → IO α) : IO α := do\\n  let running ← start command\\n  try action running finally stop running\\n\\ndef withResponseDeadline (action : IO α) : IO α := do\\n  let response ← IO.asTask action .dedicated\\n  let timeout ← IO.asTask (do\\n    IO.sleep 15000\\n    throw (IO.userError \\\"semantic matcher timed out\\\")) .dedicated\\n  match ← IO.waitAny [response, timeout] with\\n  | .ok line => pure line\\n  | .error error => throw error\\n\\ndef readLine (running : Running) : IO String :=\\n  withResponseDeadline running.child.stdout.getLine\\n\\ndef exchange (running : Running) (request : Request) : IO Response := do\\n  running.child.stdin.putStr ((toJson request).compress ++ \\\"\\\\n\\\")\\n  running.child.stdin.flush\\n  let line ← readLine running\\n  let json ← match Json.parse line with\\n    | .ok json => pure json\\n    | .error message => throw (IO.userError s!\\\"semantic matcher: {message}\\\")\\n  match (fromJson? json : Except String Response) with\\n  | .ok response => pure response\\n  | .error message => throw (IO.userError s!\\\"semantic matcher: {message}\\\")\\n\\ndef candidateText (candidate : Matcher.Candidate) : String :=\\n  (Matcher.atomText? candidate.edge.work |>.getD \\\"\\\") ++ \\\"\\\\n\\\" ++\\n    (Matcher.atomText? candidate.edge.outcome |>.getD \\\"\\\")\\n\\ntheorem candidate_text_source (candidate : Matcher.Candidate) :\\n    candidateText candidate = Persistence.Store.searchText candidate.edge := rfl\\n\\n/-- Stable cache key for rebuildable acceleration; it is never graph authority. -/\\ndef contentKey (value : Value) : String :=\\n  Blake3.hex <| Blake3.digest \\\"eggshell.semantic.embedding\\\".toUTF8\\n    [Persistence.valueToJson value |>.compress |>.toUTF8]\\n\\ndef item (value : Value) (text : String) : Item :=\\n  { id := contentKey value, text }\\n\\ndef outcomeWorkItems (values : List Value) : List Item :=\\n  (eligibleCandidates (Matcher.Corpus.build LogicalText.logicalNormalizer\\n    (WorkGraph.fromValues values))).map fun candidate =>\\n      let text := candidateText candidate\\n      item (.text text) text\\n\\ndef nominations (candidates : List Matcher.Candidate)\\n    (response : Response) : Matcher.SemanticNominations := {\\n  related := relations candidates response.related\\n}\\n\\ntheorem nomination_has_corpus_owner {corpus : Matcher.Corpus}\\n    {response : Response} {relation : Value}\\n    (member : relation ∈\\n      (nominations (eligibleCandidates corpus) response).related) :\\n    ∃ candidate ∈ corpus.candidates, candidate.edge.relation = relation := by\\n  obtain ⟨candidate, eligible, equal⟩ := relations_subset_candidate_owners member\\n  exact ⟨candidate, ((eligible_iff_readable_owner corpus candidate).mp eligible).1, equal⟩\\n\\n/-- Run after durable publication in the independent index worker. Completion\\n    requires acknowledgement of this exact batch. The owning worker controls\\n    cancellation; hook responses do not wait for this index operation. -/\\ndef withIndexProvider (command : List String) (action : Running → IO α) : IO α := do\\n  let command := match command with\\n    | executable :: \\\"search-provider\\\" :: arguments =>\\n        executable :: \\\"search-provider\\\" :: (arguments ++ [\\\"--lane\\\", \\\"index\\\"])\\n    | command => command\\n  let some result ← withLane .index (withProvider command action)\\n    | throw (IO.userError \\\"index lane did not produce an acknowledgement\\\")\\n  pure result\\n\\ndef indexReply (running : Running) (items : List Item) (request : Json) : IO (IndexReceipt items) := do\\n  running.child.stdin.putStrLn request.compress\\n  running.child.stdin.flush\\n  let json ← IO.ofExcept (Json.parse (← running.child.stdout.getLine))\\n  let response ← IO.ofExcept (fromJson? json : Except String IndexResponse)\\n  let some receipt := indexReceipt? items response |\\n    throw (IO.userError \\\"semantic index acknowledged a different batch\\\")\\n  pure receipt\\n\\ndef indexWorks (command : List String) (items : List Item)\\n    (cache : Option DB.Sidecar.Owner := none)\\n    (storage : DB.Sidecar.Storage := .database) : IO (IndexReceipt items) := do\\n  if items.isEmpty then return ⟨items.map (·.id), rfl⟩\\n  withIndexProvider command fun running =>\\n    indexReply running items (toJson ({index := items, cache, cache_storage := storage} : IndexRequest))\\n\\n/-- Already bounded original windows must not be split into overlapping windows\\nagain. This request acknowledges exactly the missing window keys. -/\\ndef indexWindows (running : Running) (items : List Item) (owner : DB.Sidecar.Owner)\\n    (storage : DB.Sidecar.Storage := .database) :\\n    IO (IndexReceipt items) :=\\n  indexReply running items (Json.mkObj [(\\\"index_windows\\\", toJson items), (\\\"cache\\\", toJson owner),\\n    (\\\"cache_storage\\\", toJson storage)])\\n\\n/-- Independent providers can read and score cached vectors concurrently.\\nThe numerical child acquires the model resource lease only when inference is\\nneeded and holds it until exit. The requesting worker owns its cancellation. -/\\ndef nominateWithRanking (command : List String) (query : Value) (queryText : String)\\n    (corpus : Matcher.Corpus) :\\n    IO (Matcher.SemanticNominations × (List Value × List (Value × List Nat))) :=\\n  let candidates := eligibleCandidates corpus\\n  if candidates.isEmpty then pure ({}, [], []) else do\\n    try\\n      withProvider command fun running => do\\n        let response ← exchange running {\\n          query := item query queryText\\n          candidates := candidates.map fun candidate =>\\n            let text := candidateText candidate\\n            item (.text text) text\\n        }\\n        unless response.ranked.length == candidates.length &&\\n            response.ranked.mergeSort (· ≤ ·) == List.range candidates.length do\\n          throw (IO.userError \\\"semantic matcher returned an incomplete evidence ranking\\\")\\n        let windows ← response.evidence.mapM fun choice => do\\n          let some candidate := candidates[choice.document]? |\\n            throw (IO.userError \\\"foreign full-reference evidence owner\\\")\\n          let count := (SearchRank.windows (candidateText candidate)).length\\n          unless choice.indices.length ≤ 16 && choice.indices.eraseDups == choice.indices &&\\n              choice.indices.all (· < count) do\\n            throw (IO.userError \\\"foreign full-reference evidence window\\\")\\n          pure (candidate.edge.relation, choice.indices)\\n        pure (nominations candidates response, relations candidates response.ranked, windows)\\n    catch error =>\\n      IO.eprintln s!\\\"eggshell: semantic matcher unavailable: {error}\\\"\\n      pure ({ pending := true }, [], [])\\n\\ndef nominate (command : List String) (query : Value) (queryText : String)\\n    (corpus : Matcher.Corpus) : IO Matcher.SemanticNominations := do\\n  pure (← nominateWithRanking command query queryText corpus).1\\n\\n/-- An untrusted pull must describe a nonempty, bounded, distinct set of\\nwindows in the nominated document before any source reader is called. -/\\nstructure WindowPull (document : Persistence.Store.SearchDocument) where\\n  indices : List Nat\\n  nonempty : indices ≠ []\\n  bounded : indices.length ≤ 32\\n  distinct : indices.eraseDups = indices\\n  within : indices.all (fun index => decide (index < document.windows.length)) = true\\n\\ndef WindowPull.check? (document : Persistence.Store.SearchDocument) (indices : List Nat) :\\n    Option (WindowPull document) :=\\n  if valid : indices ≠ [] ∧ indices.length ≤ 32 ∧ indices.eraseDups = indices ∧\\n      indices.all (fun index => decide (index < document.windows.length)) = true then\\n    some ⟨indices, valid.1, valid.2.1, valid.2.2.1, valid.2.2.2⟩\\n  else none\\n\\ndef WindowPull.handles (pull : WindowPull document) : List (Fin document.windows.length) :=\\n  pull.indices.attach.map fun index => ⟨index.val, by\\n    have := (List.all_eq_true.mp pull.within) index.val index.property\\n    exact of_decide_eq_true this⟩\\n\\ntheorem WindowPull.handles_exact (pull : WindowPull document) :\\n    pull.handles.map Fin.val = pull.indices := by\\n  simp [handles]\\n\\ntheorem WindowPull.handles_bounded (pull : WindowPull document) :\\n    pull.handles.length ≤ 32 := by\\n  simpa [handles] using pull.bounded\\n\\n/-- Scored evidence is bounded by its immutable source directory, not by a\\nforeground repair batch. Validating a rank never calls the source reader. -/\\nstructure WindowEvidence (document : Persistence.Store.SearchDocument) where\\n  indices : List Nat\\n  bounded : indices.length ≤ document.windows.length\\n  distinct : hashDistinct indices = indices\\n  within : indices.all (fun index => decide (index < document.windows.length)) = true\\n\\ndef WindowEvidence.check? (document : Persistence.Store.SearchDocument) (indices : List Nat) :\\n    Option (WindowEvidence document) :=\\n  if valid : indices.length ≤ document.windows.length ∧ hashDistinct indices = indices ∧\\n      indices.all (fun index => decide (index < document.windows.length)) = true then\\n    some ⟨indices,valid.1,valid.2.1,valid.2.2⟩\\n  else none\\n\\ndef WindowEvidence.handles (evidence : WindowEvidence document) : List (Fin document.windows.length) :=\\n  evidence.indices.attach.map fun index => ⟨index.val, by\\n    have := (List.all_eq_true.mp evidence.within) index.val index.property\\n    exact of_decide_eq_true this⟩\\n\\ntheorem WindowEvidence.handles_exact (evidence : WindowEvidence document) :\\n    evidence.handles.map Fin.val = evidence.indices := by simp [handles]\\n\\ntheorem WindowEvidence.handles_bounded (evidence : WindowEvidence document) :\\n    evidence.handles.length ≤ document.windows.length := by\\n  simpa [handles] using evidence.bounded\\n\\n/-- Focus has already scored its finite admitted domain. A reply must preserve\\nevery original window, including lower ranks; no constant top-k is a domain. -/\\nstructure WindowOrder (document : Persistence.Store.SearchDocument) where\\n  evidence : WindowEvidence document\\n  complete : evidence.indices.mergeSort (· ≤ ·) = List.range document.windows.length\\n\\ndef WindowOrder.check? (document : Persistence.Store.SearchDocument) (indices : List Nat) :\\n    Option (WindowOrder document) := do\\n  let evidence ← WindowEvidence.check? document indices\\n  if complete : evidence.indices.mergeSort (· ≤ ·) = List.range document.windows.length then\\n    some ⟨evidence,complete⟩ else none\\n\\ntheorem WindowOrder.covers (order : WindowOrder document) (index : Nat)\\n    (within : index < document.windows.length) : index ∈ order.evidence.indices := by\\n  have sorted : index ∈ order.evidence.indices.mergeSort (· ≤ ·) := by\\n    rw [order.complete]\\n    exact List.mem_range.mpr within\\n  exact List.mem_mergeSort.mp sorted\\n\\n/-- Provider positions resolve in the requesting corpus, never to a provider\\npath or invented text. A nomination retains that ownership certificate. -/\\nstructure IndexedNomination (documents : List Persistence.Store.SearchDocument) where\\n  document : Persistence.Store.SearchDocument\\n  owned : document ∈ documents\\n  windows : List (Fin document.windows.length)\\n  bounded : windows.length ≤ document.windows.length\\n\\ndef IndexedNomination.indices (nomination : IndexedNomination documents) : List Nat :=\\n  nomination.windows.map Fin.val\\n\\ntheorem IndexedNomination.window_owned (nomination : IndexedNomination documents)\\n    (index : Nat) (present : index ∈ nomination.indices) :\\n    index < nomination.document.windows.length := by\\n  obtain ⟨window, _, equal⟩ := List.mem_map.mp present\\n  exact equal ▸ window.isLt\\n\\n/-- A provider may order the closed requesting corpus, but cannot omit,\\nduplicate or invent a document in the surrounding-evidence order. -/\\nstructure IndexedOrder (documents : List Persistence.Store.SearchDocument) where\\n  indices : List Nat\\n  bounded : indices.length = documents.length\\n  complete : indices.mergeSort (· ≤ ·) = List.range documents.length\\n\\ndef IndexedOrder.check? (documents : List Persistence.Store.SearchDocument) (indices : List Nat) :\\n    Option (IndexedOrder documents) :=\\n  if valid : indices.length = documents.length then\\n    if complete : indices.mergeSort (· ≤ ·) = List.range documents.length then\\n      some ⟨indices, valid, complete⟩ else none\\n  else none\\n\\ntheorem IndexedOrder.existing (order : IndexedOrder documents) (index : Nat)\\n    (present : index ∈ order.indices) : index < documents.length := by\\n  have sorted : index ∈ order.indices.mergeSort (· ≤ ·) := List.mem_mergeSort.mpr present\\n  rw [order.complete] at sorted\\n  exact List.mem_range.mp sorted\\n\\ntheorem IndexedOrder.covers (order : IndexedOrder documents) (index : Nat)\\n    (within : index < documents.length) : index ∈ order.indices := by\\n  have sorted : index ∈ order.indices.mergeSort (· ≤ ·) := by\\n    rw [order.complete]\\n    exact List.mem_range.mpr within\\n  exact List.mem_mergeSort.mp sorted\\n\\nstructure IndexedSearch (documents : List Persistence.Store.SearchDocument) where\\n  related : List (IndexedNomination documents)\\n  ranking : List (IndexedNomination documents)\\n  order : IndexedOrder documents\\n\\ndef indexedNominations (documents : List Persistence.Store.SearchDocument)\\n    (response : IndexedResponse) : Except String (List (IndexedNomination documents)) :=\\n  response.related.eraseDups.foldlM (fun nominations index => do\\n    match present : documents[index]? with\\n    | none => pure nominations\\n    | some document =>\\n        let owned := List.mem_of_getElem? present\\n        let indices := (response.evidence.find? (·.document == index)).map (·.indices) |>.getD []\\n        if indices.isEmpty then pure (nominations ++ [⟨document, owned, [], by simp⟩]) else\\n          let some pull := WindowEvidence.check? document indices |\\n            throw \\\"semantic evidence window lies outside its document\\\"\\n          pure (nominations ++ [⟨document, owned, pull.handles, pull.handles_bounded⟩])) []\\n\\n/-- Evidence validation has the actual directory bound. The separate repair\\ncapability still accepts at most 32 windows before reading source bytes. -/\\ndef resolveIndexedNomination (found : Option {row // row ∈ documents})\\n    (indices : List Nat) : Except String (Option (IndexedNomination documents)) := do\\n  let some document := found | return none\\n  if indices.isEmpty then\\n    return some ⟨document.val, document.property, [], by simp⟩\\n  let some pull := WindowEvidence.check? document.val indices |\\n    throw \\\"semantic evidence window lies outside its document\\\"\\n  return some ⟨document.val, document.property, pull.handles, pull.handles_bounded⟩\\n\\ndef indexedNominationsUsing (documents : List Persistence.Store.SearchDocument)\\n    (response : IndexedResponse) : Except String (List (IndexedNomination documents)) :=\\n  let directory := OwnedRows.make documents\\n  let choices := FirstIndex.make WindowChoice.document response.evidence\\n  (hashDistinct response.related).filterMapM fun index =>\\n    resolveIndexedNomination (directory.get index)\\n      ((choices.read index).map (·.indices) |>.getD [])\\n\\n@[csimp] theorem indexed_nominations_compiled : indexedNominations = indexedNominationsUsing := by\\n  funext documents response\\n  unfold indexedNominationsUsing\\n  simp only [HashDistinct.reference, OwnedRows.get_exact, FirstIndex.read_exact]\\n  have same := append_fold_filterMapM\\n    (fun index => resolveIndexedNomination (OwnedRows.reference documents index)\\n      ((response.evidence.find? (·.document == index)).map (·.indices) |>.getD []))\\n    response.related.eraseDups []\\n  simp only [List.nil_append, bind_pure] at same\\n  rw [← same]\\n  clear same\\n  unfold indexedNominations\\n  congr 1\\n  funext nominations index\\n  have originalValue := OwnedRows.reference_value documents index\\n  cases original : OwnedRows.reference documents index with\\n  | none =>\\n      rw [original] at originalValue\\n      have missing : documents[index]? = none := by simpa using originalValue.symm\\n      unfold resolveIndexedNomination\\n      split\\n      · rfl\\n      · rename_i row present\\n        rw [missing] at present\\n        contradiction\\n  | some document =>\\n      rw [original] at originalValue\\n      have found : documents[index]? = some document.val := by simpa using originalValue.symm\\n      unfold resolveIndexedNomination\\n      split\\n      · rename_i missing\\n        rw [found] at missing\\n        contradiction\\n      · rename_i row present\\n        have same : row = document.val := Option.some.inj (present.symm.trans found)\\n        cases same\\n        dsimp only\\n        split\\n        · rfl\\n        · cases checked : WindowEvidence.check? document.val\\n            ((response.evidence.find? (·.document == index)).map (·.indices) |>.getD []) <;> rfl\\n\\ndef documentOwners (documents : List Persistence.Store.SearchDocument)\\n    (indices : List Nat) : List Nat :=\\n  indices.eraseDups.filterMap fun index => documents[index]?.map (·.owner)\\n\\ntheorem documentOwners_owned {documents : List Persistence.Store.SearchDocument}\\n    {indices : List Nat} {owner : Nat} (member : owner ∈ documentOwners documents indices) :\\n    ∃ document ∈ documents, document.owner = owner := by\\n  simp only [documentOwners, List.mem_filterMap] at member\\n  obtain ⟨index, _, resolved⟩ := member\\n  rw [Option.map_eq_some_iff] at resolved\\n  obtain ⟨document, present, equal⟩ := resolved\\n  exact ⟨document, List.mem_of_getElem? present, equal⟩\\n\\n/-- All providers use the same indexed boundary. Executable identity neither\\nselects a second protocol nor permits full source reconstruction. -/\\nabbrev WindowReader := (document : Persistence.Store.SearchDocument) →\\n  Fin document.windows.length → IO String\\n\\n/-- Drop a forbidden capability before constructing the response task. In\\nparticular, an unused reader must not mark its captured DB cache as shared.\\nKeep this decision outside the async closure, including after inlining. -/\\n@[noinline] def windowRepairReader (needed : Bool) (reader : WindowReader) : Option WindowReader :=\\n  if needed then some reader else none\\n\\ndef nominateIndexed (command : List String) (queryText : String)\\n    (documents : List Persistence.Store.SearchDocument) (lexical anchors : List Nat)\\n    (readWindow : WindowReader) (allowDurableRepair : Bool := false)\\n    (receipt : Option String := none) (purpose : String := \\\"discovery\\\") :\\n    IO (Option (IndexedSearch documents)) := do\\n  if documents.isEmpty then\\n    let some order := IndexedOrder.check? documents [] |\\n      throw (IO.userError \\\"empty semantic corpus has a nonempty directory\\\")\\n    return some ⟨[], [], order⟩\\n  let reader := windowRepairReader\\n    (allowDurableRepair || documents.any (·.cache.isNone)) readWindow\\n  try\\n    withProvider command fun running => withResponseDeadline do\\n      let request := Json.mkObj [(\\\"query\\\", toJson (item (.text queryText) queryText)),\\n        (\\\"documents\\\", toJson (documents.map fun document => Json.mkObj [\\n          (\\\"id\\\", toJson document.owner), (\\\"windows\\\", toJson document.windows),\\n          (\\\"cache\\\", toJson document.cache)])),\\n        (\\\"lexical\\\", toJson lexical), (\\\"anchors\\\", toJson anchors), (\\\"receipt\\\", toJson receipt),\\n        (\\\"purpose\\\", toJson purpose)]\\n      running.child.stdin.putStrLn request.compress\\n      running.child.stdin.flush\\n      let mut json ← IO.ofExcept (Json.parse (← running.child.stdout.getLine))\\n      let mut repaired : Std.HashSet (Nat × Nat) := {}\\n      -- One bounded pull per missing batch. The provider supplies no path,\\n      -- node or snapshot identity: indexes resolve only within this request.\\n      while let .ok need := json.getObjVal? \\\"need_windows\\\" do\\n        let documentIndex ← IO.ofExcept (need.getObjValAs? Nat \\\"document\\\")\\n        let indices ← IO.ofExcept (need.getObjValAs? (List Nat) \\\"indices\\\")\\n        let some document := documents[documentIndex]? |\\n          throw (IO.userError \\\"numerical repair names a foreign document\\\")\\n        if document.cache.isSome && !allowDurableRepair then\\n          throw (IO.userError \\\"durable numerical windows are pending background warm\\\")\\n        let some pull := WindowPull.check? document indices |\\n          throw (IO.userError \\\"invalid numerical window repair batch\\\")\\n        unless repaired.size + pull.indices.length ≤ 32 do\\n          throw (IO.userError \\\"bounded foreground numerical repair is pending\\\")\\n        for index in pull.indices do\\n          unless !repaired.contains (documentIndex, index) do\\n            throw (IO.userError \\\"numerical repair repeated an already supplied window\\\")\\n          repaired := repaired.insert (documentIndex, index)\\n        let some readWindow := reader |\\n          throw (IO.userError \\\"durable numerical windows are pending background warm\\\")\\n        let texts ← pull.handles.mapM (readWindow document)\\n        running.child.stdin.putStrLn (Json.mkObj [(\\\"windows\\\", toJson texts)]).compress\\n        running.child.stdin.flush\\n        json ← IO.ofExcept (Json.parse (← running.child.stdout.getLine))\\n      if let .ok message := json.getObjValAs? String \\\"error\\\" then\\n        throw (IO.userError (\\\"indexed numerical provider: \\\" ++ message))\\n      let response ← IO.ofExcept (fromJson? json : Except String IndexedResponse)\\n      let some order := IndexedOrder.check? documents response.ranked |\\n        throw (IO.userError \\\"semantic evidence order is not the complete requesting corpus\\\")\\n      let related ← IO.ofExcept (indexedNominations documents response)\\n      let ranking ← IO.ofExcept (indexedNominations documents {response with related := order.indices})\\n      if purpose == \\\"focus\\\" then\\n        for row in ranking do\\n          let some _complete := WindowOrder.check? row.document row.indices |\\n            throw (IO.userError \\\"focus response omitted an already scored source window\\\")\\n      pure (some ⟨related, ranking, order⟩)\\n  catch error =>\\n    IO.eprintln s!\\\"eggshell: indexed semantic matcher unavailable: {error}\\\"\\n    pure none\\n\\nend Eggshell.SemanticMatcher\\n\",[]]"],["Eggshell.Sha256","[\"module\\n\\npublic import Eggshell.Blake3\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Sha256\\n\\ndef constants : Array UInt32 := #[\\n  0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\\n  0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\\n  0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\\n  0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\\n  0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\\n  0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\\n  0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\\n  0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]\\n\\ndef rotate (x : UInt32) (n : UInt32) : UInt32 := (x >>> n) ||| (x <<< (32-n))\\n\\ndef compress (state : Array UInt32) (bytes : ByteArray) (offset : Nat) : Array UInt32 := Id.run do\\n  let mut words := #[]\\n  for i in [0:16] do\\n    let p := offset + i*4\\n    words := words.push ((bytes[p]!.toUInt32 <<< 24) ||| (bytes[p+1]!.toUInt32 <<< 16) |||\\n      (bytes[p+2]!.toUInt32 <<< 8) ||| bytes[p+3]!.toUInt32)\\n  for i in [16:64] do\\n    let x := words[i-15]!\\n    let y := words[i-2]!\\n    words := words.push (words[i-16]! +\\n      (rotate x 7 ^^^ rotate x 18 ^^^ (x >>> 3)) + words[i-7]! +\\n      (rotate y 17 ^^^ rotate y 19 ^^^ (y >>> 10)))\\n  let mut a := state[0]!\\n  let mut b := state[1]!\\n  let mut c := state[2]!\\n  let mut d := state[3]!\\n  let mut e := state[4]!\\n  let mut f := state[5]!\\n  let mut g := state[6]!\\n  let mut h := state[7]!\\n  for i in [0:64] do\\n    let t1 := h + (rotate e 6 ^^^ rotate e 11 ^^^ rotate e 25) +\\n      ((e &&& f) ^^^ (~~~e &&& g)) + constants[i]! + words[i]!\\n    let t2 := (rotate a 2 ^^^ rotate a 13 ^^^ rotate a 22) +\\n      ((a &&& b) ^^^ (a &&& c) ^^^ (b &&& c))\\n    h := g; g := f; f := e; e := d + t1\\n    d := c; c := b; b := a; a := t1 + t2\\n  return (state.zip #[a,b,c,d,e,f,g,h]).map fun (x,y) => x+y\\n\\ndef digest (input : ByteArray) : ByteArray := Id.run do\\n  let mut bytes := input.push 0x80\\n  let padding := (64 - ((bytes.size + 8) % 64)) % 64\\n  for _ in [0:padding] do bytes := bytes.push 0\\n  let bits := input.size.toUInt64 * 8\\n  for i in [0:8] do bytes := bytes.push ((bits >>> ((7-i)*8).toUInt64).toUInt8)\\n  let mut state := Blake3.iv\\n  for block in [0:bytes.size/64] do state := compress state bytes (block*64)\\n  let mut result := ByteArray.empty\\n  for word in state do\\n    for i in [0:4] do result := result.push ((word >>> ((3-i)*8).toUInt32).toUInt8)\\n  return result\\n\\ndef hex (bytes : ByteArray) : String := Blake3.hex (digest bytes)\\n\\nend Eggshell.Sha256\\n\",[]]"],["Eggshell.SourceDelta","[\"module\\npublic import Eggshell.GraphStore\\n\\n@[expose] public section\\nnamespace Eggshell.SourceDelta\\nopen DB Persistence.Store\\n\\ndef linked (parent child : PageMap.Head) : Bool :=\\n  parent.identity == child.identity && parent.authority == child.authority &&\\n    parent.revision+1 == child.revision && parent.bytes < child.bytes\\n\\ninductive Lineage : PageMap.Head → PageMap.Head → Prop where\\n  | same (head) : Lineage head head\\n  | step {first parent child} : Lineage first parent → linked parent child = true → Lineage first child\\n\\ntheorem Lineage.same_identity (chain : Lineage first last) : first.identity = last.identity := by\\n  induction chain with\\n  | same => rfl\\n  | step _ link ih =>\\n    simp only [linked, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at link\\n    exact ih.trans link.1.1.1\\n\\ntheorem Lineage.revision_le (chain : Lineage first last) : first.revision ≤ last.revision := by\\n  induction chain with\\n  | same => omega\\n  | step _ link ih =>\\n    simp only [linked, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at link\\n    omega\\n\\nstructure Delta (first last : PageMap.Head) where\\n  owners : List Nat\\n  records : Nat\\n  bytes : Nat\\n  lineage : Lineage first last\\n\\n/-- The pinned target authenticates every publication. Replay follows actual\\nparent heads back to the exact saved head, not just matching revision numbers.\\nBounds apply before decoding each journal payload. Failure is a full-plan\\ndecision, never a claim that there were no source changes. -/\\nprivate def walk (source : PageMap.Snapshot) (first current : PageMap.Head)\\n    (remaining : Nat) (byteBudget : Nat) : IO (Option (Delta first current)) := do\\n  if same : first = current then return some ⟨[],0,0,by rw [← same]; exact .same first⟩\\n  match remaining with\\n  | 0 => return none\\n  | remaining+1 =>\\n    if current.revision ≤ first.revision then return none\\n    let historical := {source with head := current}\\n    let bytes ← IO.ofExcept (payloadSize (← historical.get (key \\\"change\\\" current.revision)))\\n    if bytes > byteBudget then return none\\n    -- Read this record through its own child head. A later revision must not\\n    -- replace an older journal entry and thereby rewrite the replayed past.\\n    let publication ← readPublication historical current.revision\\n    if publication.change.added.length + publication.change.removed.length + publication.change.affected.length > 8192 then return none\\n    if valid : linked publication.parent current = true then\\n      let some previous ← walk source first publication.parent remaining (byteBudget-bytes) | return none\\n      let owners := hashDistinct (publication.change.added ++ publication.change.removed ++\\n        publication.change.affected ++ previous.owners)\\n      if owners.length > 4096 then return none\\n      return some ⟨owners,previous.records+1,previous.bytes+bytes,.step previous.lineage valid⟩\\n    else return none\\n\\nopaque read? (source : PageMap.Snapshot) (basis : PageMap.Head) : IO (Option (Delta basis source.head)) := do\\n  try\\n    unless basis.identity == source.head.identity && basis.authority == source.head.authority &&\\n        basis.revision ≤ source.head.revision && basis.bytes ≤ source.head.bytes do return none\\n    let result ← walk source basis source.head 4096 (8*1024*1024)\\n    let nodes ← getNat source.get \\\"nodes\\\"\\n    if result.any (fun delta => !delta.owners.all (· < nodes)) then return none\\n    return result\\n  catch _ => return none\\n\\n/-- Only nominated live candidates are read; no directory of all owners and\\nno complete candidate-domain payload is opened by this path. -/\\ndef documents (source : PageMap.Snapshot) (owners : List Nat) : IO (List SearchDocument) := do\\n  let mut rows := []\\n  for owner in owners do\\n    let candidate ← source.get (key \\\"candidate\\\" owner)\\n    if candidate.isNone then continue\\n    unless (← IO.ofExcept (payloadSize candidate)) == 1 do\\n      throw (IO.userError \\\"invalid changed search candidate\\\")\\n    let located ← locateOutcome source owner\\n    let ordinal ← getNat source.get (key \\\"member\\\" owner)\\n    unless (← IO.ofExcept (payloadSize (← source.get (key \\\"searchCandidate\\\" ordinal)))) == owner do\\n      throw (IO.userError \\\"changed search candidate disagrees with its reverse directory\\\")\\n    let encoded ← readChunks source source.get \\\"searchWindows\\\" owner\\n    let (windows,tail) ← IO.ofExcept (windowCodec.decode encoded.toList)\\n    unless tail.isEmpty && !windows.isEmpty &&\\n        windows.all (fun value => PageMap.validIdentity value) do\\n      throw (IO.userError \\\"invalid changed window directory\\\")\\n    rows := ⟨owner,located.header.work,windows,some (Sidecar.Owner.ofSnapshot source)⟩ :: rows\\n  return rows.reverse\\n\\nend Eggshell.SourceDelta\\n\",[]]"],["Eggshell.SourceEvidence","[\"module\\n\\npublic import Eggshell.FileSystem\\npublic import Eggshell.Blake3\\npublic import Eggshell.Relation\\npublic import Lean.Data.Json.FromToJson\\npublic import Lean.Data.Json.Parser\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SourceEvidence\\nopen Lean\\n\\n/-- A portable locator is relative to the current workspace. The producing\\nworkspace's absolute name is not an identity or permission to read elsewhere. -/\\ndef safeRelative (path : String) : Bool :=\\n  !path.isEmpty && !path.startsWith \\\"/\\\" && !path.contains '\\\\x00' &&\\n    (path.splitOn \\\"/\\\").all (fun part =>\\n      !part.isEmpty && part != \\\".\\\" && part != \\\"..\\\")\\n\\nstructure Relative where\\n  text : String\\n  safe : safeRelative text = true\\n\\ndef Relative.check? (path : String) : Option Relative :=\\n  if safe : safeRelative path = true then some ⟨path, safe⟩ else none\\n\\ntheorem relative_cannot_escape (path : Relative) :\\n    (path.text.splitOn \\\"/\\\").all (fun part => part != \\\"..\\\") = true := by\\n  have parts := path.safe\\n  simp only [safeRelative, Bool.and_eq_true] at parts\\n  apply List.all_eq_true.mpr\\n  intro part member\\n  have valid := List.all_eq_true.mp parts.2 part member\\n  simpa only [Bool.and_eq_true] using (Bool.and_eq_true_iff.mp valid).2\\n\\ndef withoutDots (path : String) : String :=\\n  (if path.startsWith \\\"/\\\" then \\\"/\\\" else \\\"\\\") ++\\n    \\\"/\\\".intercalate ((path.splitOn \\\"/\\\").filter (fun part => !part.isEmpty && part != \\\".\\\"))\\n\\ndef relative? (workspace directory : System.FilePath) (path : String) : Option Relative := do\\n  if path.isEmpty || path.contains '\\\\x00' then none else do\\n    let workspace := withoutDots workspace.normalize.toString\\n    let actual := withoutDots (directory / System.FilePath.mk path).normalize.toString\\n    let basePrefix := if workspace.endsWith \\\"/\\\" then workspace else workspace ++ \\\"/\\\"\\n    if !actual.startsWith basePrefix then none else\\n      Relative.check? ((actual.drop basePrefix.length).copy)\\n\\nstructure Fingerprint where\\n  bytes : Nat\\n  root : String\\n  deriving Repr, DecidableEq, BEq, ToJson, FromJson\\n\\nstructure File where\\n  relative : String\\n  content : Option Fingerprint\\n  deriving Repr, DecidableEq, BEq, ToJson, FromJson\\n\\nstructure Record where\\n  workspace : String\\n  files : List File\\n  uris : List String := []\\n  complete : Bool\\n  /-- File observations may be complete while a directory search or another\\n      operation has an open dependency domain. Such a record never completes Work. -/\\n  closed : Bool := false\\n  deriving Repr, DecidableEq, ToJson\\n\\n/-- Absence of a closed-domain witness never asserts complete operation\\ncoverage. It also does not discard the independently recorded file data. -/\\ninstance : FromJson Record where\\n  fromJson? json := do\\n    let workspace ← json.getObjValAs? String \\\"workspace\\\"\\n    let files ← json.getObjValAs? (List File) \\\"files\\\"\\n    let uris ← json.getObjValAs? (List String) \\\"uris\\\"\\n    let complete ← json.getObjValAs? Bool \\\"complete\\\"\\n    let closed ← match json.getObjVal? \\\"closed\\\" with\\n      | .error _ => pure false\\n      | .ok value => fromJson? value\\n    pure ⟨workspace, files, uris, complete, closed⟩\\n\\ninstance : BEq Record := ⟨fun left right => decide (left = right)⟩\\ninstance : LawfulBEq Record where\\n  rfl := by intro record; simp [BEq.beq]\\n  eq_of_beq := by intro left right equal; exact of_decide_eq_true equal\\n\\ndef Record.valid (record : Record) : Bool :=\\n  record.complete && record.uris.isEmpty && !record.files.isEmpty &&\\n    decide ((record.files.map (·.relative)).Nodup) &&\\n    record.files.all (fun file => safeRelative file.relative &&\\n      file.content.all (fun content => content.root.length == 64 &&\\n        content.root.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f'))))\\n\\n/-- Freshness authorizes only exact currently observed dependency descriptors.\\nIt does not assert collision freedom or prove a provider's external behavior. -/\\ndef agrees (record : Record) (current : List File) : Bool :=\\n  record.valid && decide (current = record.files)\\n\\nstructure Checked (record : Record) (current : List File) : Type where\\n  valid : record.valid = true\\n  exact : current = record.files\\n\\ndef check? (record : Record) (current : List File) : Option (Checked record current) :=\\n  if accepted : agrees record current = true then\\n    some ⟨(Bool.and_eq_true_iff.mp accepted).1,\\n      of_decide_eq_true (Bool.and_eq_true_iff.mp accepted).2⟩\\n  else none\\n\\ntheorem checked_dependencies_exact (checked : Checked record current) :\\n    current = record.files := checked.exact\\n\\n/-- A valid historical observation becomes usable again exactly when its\\nactual dependencies match; a later observation cannot refresh its hashes. -/\\ntheorem checked_iff_valid_dependencies (record : Record) (current : List File) :\\n    (check? record current).isSome = true ↔ record.valid = true ∧ current = record.files := by\\n  unfold check?\\n  split\\n  · rename_i accepted\\n    constructor\\n    · intro _\\n      exact ⟨(Bool.and_eq_true_iff.mp accepted).1,\\n        of_decide_eq_true (Bool.and_eq_true_iff.mp accepted).2⟩\\n    · intro _\\n      rfl\\n  · rename_i rejected\\n    constructor\\n    · intro impossible\\n      simp at impossible\\n    · rintro ⟨valid, equal⟩\\n      exact False.elim (rejected (by simp [agrees, valid, equal]))\\n\\ntheorem changed_dependency_rejected (record : Record) (current : List File)\\n    (changed : current ≠ record.files) : check? record current = none := by\\n  simp [check?, agrees, changed]\\n\\ntheorem incomplete_record_rejected (record : Record) (current : List File)\\n    (incomplete : record.complete = false) : check? record current = none := by\\n  simp [check?, agrees, Record.valid, incomplete]\\n\\n/-- Workspace names are display provenance. Relocation changes neither the\\nrelative dependency keys nor the contents which the receiving machine checks. -/\\ntheorem relocated_record_agreement (record : Record) (current : List File) (name : String) :\\n    agrees {record with workspace := name} current = agrees record current := rfl\\n\\nstructure Probe where\\n  file : File\\n  stamp : Option String\\n  deriving Repr, ToJson, FromJson\\n\\nstructure Capture where\\n  record : Record\\n  probes : List Probe\\n  deriving Repr, ToJson, FromJson\\n\\ndef pageRoot (previous page : ByteArray) : ByteArray :=\\n  Blake3.digest \\\"eggshell.source.page\\\".toUTF8 [previous, page]\\n\\ntheorem page_root_size (previous page : ByteArray) : (pageRoot previous page).size = 32 := by\\n  exact Blake3.hashSegments_size _\\n\\nabbrev Root := {bytes : ByteArray // bytes.size = 32}\\n\\ndef stepRoot (previous : Root) (page : ByteArray) : Root :=\\n  ⟨pageRoot previous.val page, page_root_size _ _⟩\\n\\n/-- The scanner holds a single bounded native page, a digest and counters.\\nThe chain commits page order and file length. It is a content fingerprint,\\nnot an assertion that equal finite hashes imply equal arbitrary files. -/\\ndef fingerprint (path : System.FilePath) (deadline : Nat) : IO (Option (Fingerprint × String)) := do\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  let handle ← FileSystem.openRead path.toString\\n  let before ← FileSystem.readVersion handle\\n  let mut offset := 0\\n  let mut root : Root := ⟨Blake3.digest \\\"eggshell.source.file\\\".toUTF8 [Blake3.u64le before.bytes],\\n    Blake3.hashSegments_size _⟩\\n  while offset < before.bytes do\\n    if (← IO.monoMsNow) ≥ deadline then return none\\n    let count := min 4096 (before.bytes - offset)\\n    let page ← FileSystem.readPage handle offset.toUInt64 ⟨count, Nat.min_le_left _ _⟩\\n    if page.size != count then return none\\n    root := stepRoot root page\\n    offset := offset + count\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  if !FileSystem.stableRead before after current offset then return none\\n  pure (some (⟨before.bytes, Blake3.hex root.val⟩, before.stamp))\\n\\ndef probe (workspace : System.FilePath) (relative : Relative) (deadline : Nat) : IO (Option Probe) := do\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  let path := workspace / relative.text\\n  try\\n    FileSystem.rejectSymlinkAncestors path\\n    match ← FileSystem.regularMetadata? path with\\n    | none => pure (some ⟨⟨relative.text, none⟩, none⟩)\\n    | some _ =>\\n        pure ((← fingerprint path deadline).map fun (content, stamp) =>\\n          ⟨⟨relative.text, some content⟩, some stamp⟩)\\n  catch _ => pure none -- inaccessible, symlink or interrupted is unverified, never absent\\n\\ndef stillCurrent (workspace : System.FilePath) (probe : Probe) : IO Bool := do\\n  let some relative := Relative.check? probe.file.relative | return false\\n  let path := workspace / relative.text\\n  try\\n    FileSystem.rejectSymlinkAncestors path\\n    match probe.stamp, ← FileSystem.regularMetadata? path with\\n    | none, none => pure true\\n    | some expected, some _ => pure ((← FileSystem.readVersion\\n        (← FileSystem.openRead path.toString)).stamp == expected)\\n    | _, _ => pure false\\n  catch _ => pure false\\n\\n/-- Recheck the version after all related fingerprints have been collected.\\nThe OS version checks are observations, not an atomic filesystem snapshot. -/\\ndef checkedProbeFile (workspace : System.FilePath) (observed : Option Probe)\\n    (deadline : Nat) : IO (Option File) := do\\n  let some observed := observed | return none\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  unless ← stillCurrent workspace observed do return none\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  pure (some observed.file)\\n\\n/-- Observe precisely the declared files. There is no workspace scan, Git\\ndependency, remote request, persistent negative cache or hard file-count cap. -/\\ndef observe (workspace : System.FilePath) (files : List File) (deadline : Nat) :\\n    IO (Option (List File)) := do\\n  let mut observations := []\\n  for file in files do\\n    let some relative := Relative.check? file.relative | return none\\n    let some observed ← probe workspace relative deadline | return none\\n    observations := observed :: observations\\n  let mut files := []\\n  for observed in observations.reverse do\\n    let some file ← checkedProbeFile workspace (some observed) deadline | return none\\n    files := file :: files\\n  pure (some files.reverse)\\n\\ndef verify (workspace : System.FilePath) (record : Record) (deadline : Nat) : IO Bool := do\\n  if !record.valid then return false\\n  let some current ← observe workspace record.files deadline | return false\\n  pure ((check? record current).isSome)\\n\\ndef unknown (workspace : System.FilePath) (uris : List String := []) : Capture :=\\n  ⟨⟨workspace.fileName.getD workspace.toString, [], uris, false, false⟩, []⟩\\n\\n/-- Only explicitly named local files are captured. Unrecognized shell syntax,\\ndirectory searches and remote providers remain historical evidence. -/\\ndef pathsFromInput (input : Json) : List String :=\\n  [\\\"path\\\", \\\"file_path\\\", \\\"filename\\\", \\\"file\\\"].filterMap fun key =>\\n    (input.getObjValAs? String key).toOption\\n\\ndef urisFromInput (input : Json) : List String :=\\n  [\\\"url\\\", \\\"uri\\\"].filterMap fun key => (input.getObjValAs? String key).toOption\\n\\ndef isURI (path : String) : Bool := (path.splitOn \\\"://\\\").length > 1\\n\\n/-- Literal shell words. Expansion, redirection and substitution do not\\nestablish a closed local read. Quoted patterns are separate from operands. -/\\ndef literalWords? (text : String) : Option (List String) := do\\n  if text.contains '\\\\x00' then return ← none\\n  let mut words := []\\n  let mut word := \\\"\\\"\\n  let mut quote := (0 : Nat)\\n  let mut started := false\\n  let mut escaped := false\\n  for c in text.toList do\\n    if quote == 1 then\\n      if c == '\\\\'' then quote := 0 else word := word.push c\\n    else if quote == 2 then\\n      if escaped then\\n        if c == '\\\\n' || c == '\\\\r' then return ← none\\n        if !['$', '`', '\\\"', '\\\\\\\\'].contains c then word := word.push '\\\\\\\\'\\n        word := word.push c\\n        escaped := false\\n      else if c == '\\\\\\\\' then escaped := true\\n      else if c == '\\\"' then quote := 0\\n      else if c == '$' || c == '`' then return ← none\\n      else word := word.push c\\n    else if c == '\\\\'' then\\n      quote := 1\\n      started := true\\n    else if c == '\\\"' then\\n      quote := 2\\n      started := true\\n    else if c == '\\\\n' || c == '\\\\r' then return ← none\\n    else if c.isWhitespace then\\n      if started then words := word :: words\\n      word := \\\"\\\"\\n      started := false\\n    else if ['$', '`', '\\\\\\\\', ';', '|', '&', '<', '>', '*', '?', '[', ']', '(', ')', '{', '}'].contains c then\\n      return ← none\\n    else\\n      word := word.push c\\n      started := true\\n  if quote != 0 || escaped then return ← none\\n  if started then words := word :: words\\n  pure words.reverse\\n\\ndef printProgram (program : String) : Bool :=\\n  (program.splitOn \\\";\\\").all fun range =>\\n    range.endsWith \\\"p\\\" && !(range.dropEnd 1).isEmpty &&\\n      ((range.dropEnd 1).copy.toList).all (fun c => c.isDigit || c == ',' || c == '$')\\n\\n/-- A stream filter has no file operand. Programs which read/write another\\nfile, execute a command or substitute shell expressions cannot inhabit this\\nplan. The external command/OS observation remains outside this pure contract. -/\\ninductive StreamFilter where\\n  | print (program : String) (literal : printProgram program = true)\\n  | prefix (lines : Nat)\\n  | suffix (lines : Nat)\\n\\ndef streamFilter? (words : List String) : Option StreamFilter := do\\n  match words with\\n  | [\\\"sed\\\", \\\"-n\\\", program] =>\\n      if literal : printProgram program = true then some (.print program literal) else none\\n  | [\\\"head\\\", \\\"-n\\\", count] => count.toNat? |>.map StreamFilter.prefix\\n  | [\\\"head\\\", count] =>\\n      if count.startsWith \\\"-\\\" then\\n        ((count.drop 1).copy.toNat?).map StreamFilter.prefix else none\\n  | [\\\"tail\\\", \\\"-n\\\", count] => count.toNat? |>.map StreamFilter.suffix\\n  | [\\\"tail\\\", count] =>\\n      if count.startsWith \\\"-\\\" then\\n        ((count.drop 1).copy.toNat?).map StreamFilter.suffix else none\\n  | _ => none\\n\\n/-- Split only unquoted pipes; every filter must consume its input stream\\nwithout introducing another source. -/\\ndef pipelineSegments? (command : String) : Option (List String) := do\\n  let mut parts := []\\n  let mut part := \\\"\\\"\\n  let mut quote := (0 : Nat)\\n  let mut escaped := false\\n  for c in command.toList do\\n    if escaped then\\n      part := part.push c\\n      escaped := false\\n    else if quote == 2 && c == '\\\\\\\\' then\\n      part := part.push c\\n      escaped := true\\n    else if quote == 0 && c == '|' then\\n      parts := part :: parts\\n      part := \\\"\\\"\\n    else\\n      part := part.push c\\n      if quote == 1 then\\n        if c == '\\\\'' then quote := 0\\n      else if quote == 2 then\\n        if c == '\\\"' then quote := 0\\n      else if c == '\\\\'' then quote := 1\\n      else if c == '\\\"' then quote := 2\\n  if quote != 0 || escaped then return ← none\\n  pure ((part :: parts).reverse)\\n\\n/-- Split a literal list of read pipelines. Both sides of `&&` are included:\\nan unexecuted right side can only make the dependency set conservative.\\nQuotes retain separators in regexes and sed programs. Unsupported operators,\\nexpansion and commands are rejected by the subsequent pipeline parser. -/\\ndef sequenceSegments? (command : String) : Option (List String) := do\\n  let mut parts := []\\n  let mut part := \\\"\\\"\\n  let mut quote := (0 : Nat)\\n  let mut ampersand := false\\n  let mut afterAnd := false\\n  let mut escaped := false\\n  for c in command.toList do\\n    if escaped then\\n      part := part.push c\\n      escaped := false\\n    else if quote == 2 && c == '\\\\\\\\' then\\n      part := part.push c\\n      escaped := true\\n    else if ampersand then\\n      if c != '&' then return ← none\\n      if part.trimAscii.isEmpty then return ← none\\n      parts := part :: parts\\n      part := \\\"\\\"\\n      ampersand := false\\n      afterAnd := true\\n    else if quote == 0 && c == '&' then\\n      ampersand := true\\n    else if quote == 0 && (c == ';' || c == '\\\\n') then\\n      if part.trimAscii.isEmpty then return ← none\\n      parts := part :: parts\\n      part := \\\"\\\"\\n    else\\n      part := part.push c\\n      if !c.isWhitespace then afterAnd := false\\n      if quote == 1 then\\n        if c == '\\\\'' then quote := 0\\n      else if quote == 2 then\\n        if c == '\\\"' then quote := 0\\n      else if c == '\\\\'' then quote := 1\\n      else if c == '\\\"' then quote := 2\\n  if quote != 0 || escaped || ampersand || afterAnd then return ← none\\n  if !part.trimAscii.isEmpty then parts := part :: parts\\n  pure parts.reverse\\n\\ndef readerFiles? (words : List String) : Option (List String) := do\\n  let executable ← words.head?\\n  let arguments := words.tail\\n  let name := (System.FilePath.mk executable).fileName.getD executable\\n  match name with\\n  | \\\"cat\\\" =>\\n      let files := arguments.dropWhile (fun word => [\\\"--\\\", \\\"-n\\\", \\\"-b\\\", \\\"-s\\\", \\\"-v\\\", \\\"-E\\\", \\\"-T\\\"].contains word)\\n      if files.isEmpty || files.any (fun file => file.startsWith \\\"-\\\") then none else some files\\n  | \\\"sed\\\" =>\\n      match arguments with\\n      | \\\"-n\\\" :: program :: files =>\\n          if !files.isEmpty && printProgram program &&\\n              !files.any (fun file => file.startsWith \\\"-\\\") then some files else none\\n      | _ => none\\n  | \\\"rg\\\" =>\\n      let arguments := arguments.dropWhile (fun word =>\\n        [\\\"-n\\\", \\\"-l\\\", \\\"-i\\\", \\\"-S\\\", \\\"-F\\\", \\\"-w\\\", \\\"-s\\\", \\\"--fixed-strings\\\", \\\"--line-number\\\",\\n          \\\"--ignore-case\\\", \\\"--word-regexp\\\"].contains word)\\n      let files ← match arguments with\\n        | \\\"--\\\" :: _pattern :: files => some files\\n        | pattern :: files => if pattern.startsWith \\\"-\\\" then none else some files\\n        | _ => none\\n      if !files.isEmpty && !files.any (fun file => file.startsWith \\\"-\\\") then some files else none\\n  | \\\"nl\\\" =>\\n      match arguments with\\n      | [file] | [\\\"-ba\\\", file] => if file.startsWith \\\"-\\\" then none else some [file]\\n      | _ => none\\n  | _ => none\\n\\nstructure ReadPlan where\\n  sources : {files : List String // files ≠ []}\\n  filters : List StreamFilter\\n\\ndef pipelineReadPlan? (command : String) : Option ReadPlan := do\\n  let segments ← pipelineSegments? command\\n  let words ← segments.mapM literalWords?\\n  let first ← words.head?\\n  let files ← readerFiles? first\\n  let filters ← words.tail.mapM streamFilter?\\n  if nonempty : files ≠ [] then some ⟨⟨files, nonempty⟩, filters⟩ else none\\n\\ndef combinedFiles (plans : List ReadPlan) : List String :=\\n  (plans.flatMap (·.sources.val)).eraseDups\\n\\n/-- No accepted pipeline is omitted. A batch can never authorize just its\\nrecognizable prefix; parsing all pipelines succeeds before this is called. -/\\ndef joinReadPlans? (plans : List ReadPlan) : Option ReadPlan :=\\n  if nonempty : combinedFiles plans ≠ [] then\\n    some ⟨⟨combinedFiles plans, nonempty⟩, plans.flatMap (·.filters)⟩\\n  else none\\n\\ndef readPlan? (command : String) : Option ReadPlan := do\\n  let segments ← sequenceSegments? command\\n  let plans ← segments.mapM pipelineReadPlan?\\n  joinReadPlans? plans\\n\\ndef commandFiles? (command : String) : Option (List String) :=\\n  (readPlan? command).map (·.sources.val)\\n\\n/-- Preserve each independently recognized read in a mixed batch. Failure to\\ndescribe the entire command does not erase observations of explicitly named\\nfiles. This list gives observation targets only, never completion authority. -/\\ndef observedCommandFiles (command : String) : List String :=\\n  ((sequenceSegments? command).getD []).filterMap pipelineReadPlan? |>.flatMap (·.sources.val) |>.eraseDups\\n\\ntheorem observed_command_file_from_read (command : String) (file : String)\\n    (present : file ∈ observedCommandFiles command) :\\n    ∃ segment ∈ (sequenceSegments? command).getD [],\\n      ∃ plan, pipelineReadPlan? segment = some plan ∧ file ∈ plan.sources.val := by\\n  simp only [observedCommandFiles, List.mem_eraseDups, List.mem_flatMap, List.mem_filterMap] at present\\n  obtain ⟨plan, ⟨segment, member, parsed⟩, filePresent⟩ := present\\n  exact ⟨segment, member, plan, parsed, filePresent⟩\\n\\ntheorem accepted_read_plan_dependencies (command : String) (plan : ReadPlan)\\n    (accepted : readPlan? command = some plan) :\\n    commandFiles? command = some plan.sources.val := by\\n  simp [commandFiles?, accepted]\\n\\ntheorem read_plan_dependencies_nonempty (plan : ReadPlan) : plan.sources.val ≠ [] :=\\n  plan.sources.property\\n\\ntheorem stream_filters_preserve_dependencies (plan : ReadPlan) (filters : List StreamFilter) :\\n    ({plan with filters} : ReadPlan).sources = plan.sources := rfl\\n\\ntheorem combined_files_exact (plans : List ReadPlan) (file : String) :\\n    file ∈ combinedFiles plans ↔ ∃ plan ∈ plans, file ∈ plan.sources.val := by\\n  simp [combinedFiles, List.mem_flatMap]\\n\\ntheorem joined_read_plan_dependencies (plans : List ReadPlan) (plan : ReadPlan)\\n    (accepted : joinReadPlans? plans = some plan) :\\n    plan.sources.val = combinedFiles plans := by\\n  unfold joinReadPlans? at accepted\\n  split at accepted\\n  · cases accepted\\n    rfl\\n  · contradiction\\n\\ntheorem joined_read_plan_preserves_every_source (plans : List ReadPlan) (plan : ReadPlan)\\n    (accepted : joinReadPlans? plans = some plan) (file : String) :\\n    file ∈ plan.sources.val ↔ ∃ pipeline ∈ plans, file ∈ pipeline.sources.val := by\\n  rw [joined_read_plan_dependencies plans plan accepted]\\n  exact combined_files_exact plans file\\n\\ndef inputPaths (input : Json) : List String :=\\n  let direct := pathsFromInput input ++ ((input.getObjValAs? (List String) \\\"paths\\\").toOption.getD [])\\n  (if !direct.isEmpty then direct else\\n    (((input.getObjValAs? String \\\"cmd\\\").toOption.orElse\\n      (fun _ => (input.getObjValAs? String \\\"command\\\").toOption)).bind commandFiles?).getD []).eraseDups\\n\\ndef observedInputPaths (input : Json) : List String :=\\n  let direct := pathsFromInput input ++ ((input.getObjValAs? (List String) \\\"paths\\\").toOption.getD [])\\n  (if !direct.isEmpty then direct else\\n    (((input.getObjValAs? String \\\"cmd\\\").toOption.orElse\\n      (fun _ => (input.getObjValAs? String \\\"command\\\").toOption)).map observedCommandFiles).getD []).eraseDups\\n\\ndef inputDirectory? (workspace : System.FilePath) (input : Json) : Option System.FilePath := do\\n  let mut directory := workspace\\n  let mut specified := false\\n  for key in [\\\"workdir\\\", \\\"cwd\\\"] do\\n    if (input.getObjVal? key).isOk then\\n      let raw ← (input.getObjValAs? String key).toOption\\n      let actual := (workspace / raw).normalize\\n      if specified && directory != actual then return ← none\\n      directory := actual\\n      specified := true\\n  pure directory\\n\\ndef capture (workspace : System.FilePath) (input : Json) (deadline : Nat) : IO Capture := do\\n  let paths := observedInputPaths input\\n  let uris := (urisFromInput input ++ paths.filter isURI).eraseDups\\n  if paths.isEmpty || !uris.isEmpty then return unknown workspace uris\\n  let some directory := inputDirectory? workspace input | return unknown workspace\\n  let mut probes := []\\n  let mut closed := paths == inputPaths input && !paths.isEmpty\\n  for path in paths do\\n    let some relative := relative? workspace directory path | return unknown workspace\\n    -- A named directory is an open search domain, not a failed file read.\\n    -- Retain the other sealed file observations; do not traverse the directory.\\n    if ← (directory / path).isDir then\\n      closed := false\\n      continue\\n    let some observed ← probe workspace relative deadline | return unknown workspace\\n    probes := observed :: probes\\n  let completed := probes.reverse\\n  let record : Record := ⟨workspace.fileName.getD workspace.toString, completed.map (·.file), [], true, closed⟩\\n  if !record.valid then return unknown workspace\\n  pure ⟨record, completed⟩\\n\\ndef sealCapture (workspace : System.FilePath) (capture : Capture) (deadline : Nat) : IO Record := do\\n  if capture.record.files != capture.probes.map (·.file) || !capture.record.valid then\\n    return {capture.record with complete := false}\\n  for probe in capture.probes do\\n    if (← IO.monoMsNow) ≥ deadline then return {capture.record with complete := false}\\n    unless ← stillCurrent workspace probe do return {capture.record with complete := false}\\n  pure capture.record\\n\\ndef sourceMarker : String := \\\"EGGSHELL SOURCE\\\\n\\\"\\n\\ndef encode (record : Record) : String := sourceMarker ++ (toJson record).compress\\n\\ndef decode? (text : String) : Option Record := do\\n  if !text.startsWith sourceMarker then none else\\n    (Json.parse ((text.drop sourceMarker.length).copy) >>= fromJson?).toOption\\n\\n/-- Source certificates are separate Exact-only roots. Adding one never\\nchanges the identity of an observed Outcome or its semantic search terms. -/\\ndef receiptMarker : String := \\\"eggshell.source\\\"\\ndef receiptPurpose : String := \\\"observed dependency certificate\\\"\\n\\nstructure ReceiptFields (α : Type) where\\n  marker : α\\n  session : α\\n  turn : α\\n  tag : α\\n  owner : α\\n  data : α\\n  purpose : α\\n\\ndef receiptFields? {α : Type} (references : List (Authority × α)) : Option (ReceiptFields α) :=\\n  match Relation.exactValues references with\\n  | some [marker, session, turn, tag, owner, data, purpose] =>\\n      some ⟨marker, session, turn, tag, owner, data, purpose⟩\\n  | _ => none\\n\\ndef receiptArguments (session turn tag owner : Value) (record : Record) : List Ref :=\\n  [\\n    .exact (.text receiptMarker), .exact session, .exact turn, .exact tag,\\n    .exact owner, .exact (.text (encode record)), .exact (.text receiptPurpose)]\\n\\ndef receipt (session turn tag owner : Value) (record : Record) : Value :=\\n  .applyList .receipt (receiptArguments session turn tag owner record)\\n\\ntheorem receipt_owner_bound (session turn tag owner : Value) (record : Record) :\\n    (receiptFields? (receiptArguments session turn tag owner record)).map (·.owner) = some owner := by\\n  rfl\\n\\ndef receiptRecord? (owner value : Value) : Option Record := do\\n  match value with\\n  | .apply .receipt references =>\\n      let fields ← receiptFields? references.toList\\n      if fields.marker != .text receiptMarker || fields.purpose != .text receiptPurpose ||\\n          fields.owner != owner then none\\n      else match fields.data with\\n        | .atom bytes => String.fromUTF8? bytes >>= decode?\\n        | _ => none\\n  | _ => none\\n\\ntheorem receipt_other_owner_rejected (session turn tag owner other : Value) (record : Record)\\n    (different : owner ≠ other) :\\n    receiptRecord? other (receipt session turn tag owner record) = none := by\\n  simp [receiptRecord?, receipt, receiptArguments, receiptFields?, Relation.exactValues,\\n    Value.applyList, Refs.ofList, Refs.toList, Ref.exact, different]\\n\\n/-- Unknown is a real provenance state, not a successful check with no files. -/\\ndef unverified : Record := ⟨\\\"\\\", [], [], false, false⟩\\n\\nabbrev Ledger := Std.HashMap String (Option File)\\n\\ndef currentFiles? (ledger : Ledger) (files : List File) : Option (List File) :=\\n  files.mapM fun file => (ledger[file.relative]?).join\\n\\ndef recordAgrees (ledger : Ledger) (record : Record) : Bool :=\\n  (currentFiles? ledger record.files).any (agrees record)\\n\\nstructure Authorization (records : List Record) where\\n  ledger : Ledger\\n  nonempty : records ≠ []\\n  checked : ∀ record ∈ records, recordAgrees ledger record = true\\n\\ndef authorize? (records : List Record) (ledger : Ledger) : Option (Authorization records) :=\\n  if checked : (!records.isEmpty && records.all (recordAgrees ledger)) = true then\\n    some ⟨ledger, by\\n      intro empty\\n      simp [empty] at checked,\\n      List.all_eq_true.mp (Bool.and_eq_true_iff.mp checked).2⟩ else none\\n\\ntheorem authorization_uses_observed_ledger (records : List Record) (ledger : Ledger)\\n    (authorization : Authorization records)\\n    (accepted : authorize? records ledger = some authorization) :\\n    authorization.ledger = ledger := by\\n  unfold authorize? at accepted\\n  split at accepted\\n  · cases accepted\\n    rfl\\n  · contradiction\\n\\n/-- A currently named file/directory must occur in the selected sources under\\nthe same relative locator, not merely with a matching basename or bytes. -/\\ndef targetAgreement (targets : List String) (records : List Record) : Bool :=\\n  targets.all fun target => (records.flatMap (·.files)).any fun file =>\\n    file.relative == target || file.relative.startsWith (target ++ \\\"/\\\")\\n\\ntheorem target_agreement_has_each_locator (targets : List String) (records : List Record)\\n    (accepted : targetAgreement targets records = true) (target : String) (present : target ∈ targets) :\\n    ∃ file ∈ records.flatMap (·.files), file.relative == target ||\\n      file.relative.startsWith (target ++ \\\"/\\\") := by\\n  have covered := List.all_eq_true.mp accepted target present\\n  simpa only [List.any_eq_true] using covered\\n\\ndef workTargets? (workspace : System.FilePath) (work : String) : Option (List String) := do\\n  let lines := work.splitOn \\\"\\\\n\\\"\\n  let input ← (Json.parse (\\\"\\\\n\\\".intercalate lines.tail)).toOption\\n  let paths := inputPaths input\\n  if paths.isEmpty || !(urisFromInput input).isEmpty || paths.any isURI then none else do\\n    let directory ← inputDirectory? workspace input\\n    paths.mapM fun path => (relative? workspace directory path).map (·.text)\\n\\ntheorem authorization_has_current_dependencies (authorization : Authorization records)\\n    (record : Record) (present : record ∈ records) :\\n    ∃ current, currentFiles? authorization.ledger record.files = some current ∧\\n      record.valid = true ∧ current = record.files := by\\n  have accepted := authorization.checked record present\\n  cases observed : currentFiles? authorization.ledger record.files with\\n  | none => simp [recordAgrees, observed] at accepted\\n  | some current =>\\n      refine ⟨current, rfl, ?_⟩\\n      simpa [recordAgrees, observed, agrees] using accepted\\n\\ninductive ProbeStatus where\\n  | checked | unverified | timedOut\\n  deriving BEq, ToJson\\n\\ninductive RecordStatus where\\n  | matched | changed | unverified | timedOut | external\\n  deriving BEq, ToJson\\n\\nstructure FileCheck where\\n  relative : String\\n  status : ProbeStatus\\n  deriving ToJson\\n\\nstructure RecordCheck where\\n  ordinal : Nat\\n  status : RecordStatus\\n  deriving ToJson\\n\\nstructure Observation where\\n  ledger : Ledger\\n  files : Array FileCheck\\n  records : Array RecordCheck\\n  startedMs : Nat\\n  finishedMs : Nat\\n  deadlineMs : Nat\\n\\ndef Observation.receipt (observation : Observation) : Json := Json.mkObj [\\n  (\\\"startedMs\\\",toJson observation.startedMs),(\\\"finishedMs\\\",toJson observation.finishedMs),\\n  (\\\"deadlineMs\\\",toJson observation.deadlineMs),\\n  (\\\"elapsedMs\\\",toJson (observation.finishedMs-observation.startedMs)),\\n  (\\\"files\\\",toJson observation.files),(\\\"records\\\",toJson observation.records)]\\n\\ndef recordStatus (ledger : Ledger) (failures : Std.HashMap String ProbeStatus) (record : Record) : RecordStatus :=\\n  if !record.uris.isEmpty then .external\\n  else if !record.valid then .unverified\\n  else if recordAgrees ledger record then .matched\\n  else if record.files.any (fun file => (ledger[file.relative]?).join.any (· != file)) then .changed\\n  else if record.files.any (fun file => failures[file.relative]? == some .timedOut) then .timedOut\\n  else .unverified\\n\\ntheorem matched_status_has_checked_dependencies (ledger : Ledger)\\n    (failures : Std.HashMap String ProbeStatus) (record : Record)\\n    (matched : recordStatus ledger failures record = .matched) : recordAgrees ledger record = true := by\\n  unfold recordStatus at matched\\n  split at matched <;> try contradiction\\n  split at matched <;> try contradiction\\n  split at matched\\n  · assumption\\n  · split at matched <;> try contradiction\\n    split at matched <;> contradiction\\n\\ntheorem external_status_never_matches (ledger : Ledger)\\n    (failures : Std.HashMap String ProbeStatus) (record : Record)\\n    (external : record.uris.isEmpty = false) : recordStatus ledger failures record = .external := by\\n  simp [recordStatus,external]\\n\\n/-- Request-local observation is shared by all selected owners. A failed or\\nexpired probe stays unknown, independently of a definite changed fingerprint.\\nThe diagnostic states never populate the authorization ledger. -/\\ndef o
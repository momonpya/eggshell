hes (original : String) (number : Nat) (code : String) : Bool :=\\n  (sharedCodes original).any fun spelling =>\\n    spelling.text == code || numbered (if spelling.text.endsWith \\\"\\\\n\\\" then\\n      (spelling.text.dropEnd 1).copy else spelling.text) == some (number,code)\\n\\nstructure Shared (saved : Array Read) (source : Source doc) (row : CanonicalSource.StoredRow) (origin : CanonicalSource.Origin) where\\n  read : Read\\n  present : read ∈ saved\\n  valid : read.valid = true\\n  sourceExact : read.source = ⟨.file row.key.file,row.key.line,row.key.line⟩\\n  originBinding : read.binding = origin.binding\\n  originOccurrence : read.occurrence = origin.occurrence\\n  ownerExact : read.binding.owner = doc.owner\\n  workExact : read.binding.work = doc.work\\n  nativeOccurrence : doc.occurrences.contains read.occurrence = true\\n  dependency : doc.files.contains row.key.file = true\\n  within : read.binding.first < read.binding.limit ∧ read.binding.limit ≤ source.indexed.chars.size\\n  spelling : codeMatches (source.indexed.slice read.binding.first\\n    (read.binding.limit-read.binding.first)) row.key.line row.code = true\\n\\ndef shared? {saved : Array Read} (source : Source doc) (row : CanonicalSource.StoredRow)\\n    (origin : CanonicalSource.Origin) (savedRead : {read : Read // read ∈ saved}) : Option (Shared saved source row origin) :=\\n  let read := savedRead.val\\n  if valid : read.valid = true then\\n    if sourceExact : read.source = ⟨.file row.key.file,row.key.line,row.key.line⟩ then\\n      if binding : read.binding = origin.binding then\\n        if occurrence : read.occurrence = origin.occurrence then\\n          if owner : read.binding.owner = doc.owner then\\n            if work : read.binding.work = doc.work then\\n              if native : doc.occurrences.contains read.occurrence = true then\\n                if dependency : doc.files.contains row.key.file = true then\\n                  if within : read.binding.first < read.binding.limit ∧ re
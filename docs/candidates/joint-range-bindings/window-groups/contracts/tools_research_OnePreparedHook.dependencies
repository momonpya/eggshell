state <;> rfl\\n\\ntheorem closed_retains_no_owner : close (.closed : Cell α) = (.closed, none) := rfl\\n\\ntheorem close_cannot_admit (state : Cell (Option α)) :\\n    admit (close state).1 = .refused := by\\n  rw [close_is_closed]; rfl\\n\\ntheorem release_cannot_reopen (predicate : α → Bool) :\\n    release predicate .closed = (.closed, none) := rfl\\n\\ntheorem second_close_has_no_owner (state : Cell α) :\\n    (close (close state).1).2 = none := by\\n  rw [close_is_closed]; rfl\\n\\nend Eggshell.Plugin.Worker.Lifetime\\n\",[]]"],["Init.Data.Array.OfFn","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.Array.OfFn\"]"],["Init.Data.Array.Sort.Lemmas","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.Array.Sort.Lemmas\"]"],["Init.Data.ByteArray.Lemmas","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.ByteArray.Lemmas\"]"],["Init.Data.FloatArray","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.FloatArray\"]"],["Init.Data.List.Nat.Pairwise","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.List.Nat.Pairwise\"]"],["Init.Data.List.Sort.Basic","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.List.Sort.Basic\"]"],["Init.Data.List.Sort.Lemmas","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.List.Sort.Lemmas\"]"],["Init.Data.Ord.String","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.Ord.String\"]"],["Init.Data.Queue","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.Queue\"]"],["Init.Data.String.Legacy","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.String.Legacy\"]"],["Init.Data.String.Lemmas.Iterate","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.Data.String.Lemmas.Iterate\"]"],["Init.System.IO","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Init.System.IO\"]"],["Init.System.Promise","
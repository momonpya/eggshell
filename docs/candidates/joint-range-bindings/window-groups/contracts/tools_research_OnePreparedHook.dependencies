 throw (IO.userError \\\"missing content block\\\")\\n    unless Sha256.hex bytes == digest do throw (IO.userError \\\"changed content block\\\")\\n    let rows ← ObservedRecords.decode (α := Array ContentCapture.Alias) bytes\\n    unless rows.size ≤ chunkCount do throw (IO.userError \\\"foreign content block extent\\\")\\n    aliases := aliases ++ rows\\n  let characters := raw.toList.toArray\\n  unless aliases.size == header.aliases && (header.complete || aliases.isEmpty) &&\\n      aliases.all (validAlias header.inputs characters) do\\n    throw (IO.userError \\\"incomplete content correspondence directory\\\")\\n  return some ⟨header.implementation,header.inputs,header.complete,aliases,header.failure⟩\\n\\ndef catalog (database : String) (doc : Document) (captured : ContentCapture.Captured) :\\n    Except String ObservationContext.Catalog := do\\n  let some raw := doc.source | throw \\\"missing original content body\\\"\\n  let some occurrence := doc.occurrences[0]? | throw \\\"missing original occurrence\\\"\\n  let characters := raw.toList.toArray\\n  let mut result : ObservationContext.Catalog := {}\\n  let quoteSource := QuotationContext.Source.make raw\\n  for alias in captured.aliases do\\n    let some code := ContentCapture.code? characters alias | throw \\\"content alias lost literal equality\\\"\\n    let read : Read := {\\n      occurrence,source := ⟨.file alias.file,alias.line,alias.line⟩\\n      binding := ⟨database,doc.owner,doc.work,alias.first,alias.limit⟩\\n      quotations := #[Quotes.digest code]}\\n    unless read.valid do throw \\\"content alias has an invalid original binding\\\"\\n    result := {\\n      located := result.located.push ⟨read,#[⟨read.source,alias.first,alias.limit⟩],#[read],code⟩\\n      quotations := result.quotations.push\\n        (ObservationContext.Quotation.prepare quoteSource read alias.first alias.limit code)}\\n  return result\\n\\nend Eggshell.ContentMetadata\\n\"],[\"../tools/ContentCorrespondence.lean\",\"module\\npublic import Std.Data.HashMap\\npublic import Std.Data.HashSet.Lemmas\\n@[expose] public section\\n\\n/- Content correspondence has no command, file-system, Work, Match or Union\\ninput. A capture adapter must supply verified acquired input records and retain\\ntheir identities. This module proves equality of content at actual positions;\\nit does not turn a matching string into an execution or freshness certificate. -/\\nnamespace ContentCorrespondence\\n\\nabbrev Inputs := Array (Array String)\\nabbrev Position := Nat × Nat\\nvariable {inputs : Inputs}\\n\\ndef positions (inputs : Inputs) : List Position :=\\n  (List.finRange inputs.size).flatMap fun source =>\\n    (List.finRange inputs[source].size).map fun row => (source.val,row.val)\\n\\ntheorem position_present (source : Fin inputs.size) (row : Fin inputs[source].size) :\\n    (source.val,row.val) ∈ positions inputs := by\\n  apply List.mem_flatMap.mpr\\n  refine ⟨source,by simp,?_⟩\\n  exact List.mem_map.mpr ⟨row,by simp,rfl⟩\\n\\ndef textAt (inputs : Inputs) (position : Position) : String :=\\n  ((inputs[position.1]?).bind fun rows => rows[position.2]?).getD \\\"\\\"\\n\\n@[simp] theorem textAt_present (source : Fin inputs.size) (row : Fin inputs[source].size) :\\n    textAt inputs (source.val,row.val) = inputs[source][row] := by\\n  simp [textAt]\\n\\nstructure Correspondence (inputs : Inputs) (text : String) (position : Position) : Type where\\n  sourceBound : position.1 < inputs.size\\n  rowBound : position.2 < (inputs[position.1]'sourceBound).size\\n  original : (inputs[position.1]'sourceBound)[position.2]'rowBound = text\\n\\ndef check? (inputs : Inputs) (text : String) (position : Position) :\\n    Option (Correspondence inputs text position) :=\\n  if sourceBound : position.1 < inputs.size then\\n    if rowBound : position.2 < inputs[position.1].size then\\n      if original : inputs[position.1][position.2] = text then\\n        some ⟨sourceBound,rowBound,original⟩ else none\\n    else none\\n  else none\\n\\nabbrev Buckets := Std.HashMap String (Std.HashSet Position)\\n\\ndef bucket (buckets : Buckets) (text : String) : Std.HashSet Position :=\\n  buckets[text]?.getD {}\\n\\n/-- The one-time completeness check permits safe absence/ambiguity decisions.\\nHash collisions never suffice: the map key is the full original string. -/\\ndef complete (inputs : Inputs) (buckets : Buckets) : Bool :=\\n  (positions inputs).all fun position => (bucket buckets (textAt inputs position)).contains position\\n\\nstructure Index (inputs : Inputs) where\\n  buckets : Buckets\\n  complete : complete inputs buckets = true\\n\\ndef checkedIndex? (inputs : Inputs) (buckets : Buckets) : Option (Index inputs) :=\\n  if checked : complete inputs buckets = true then some ⟨buckets,checked⟩ else none\\n\\ndef prepare? (inputs : Inputs) : Option (Index inputs) := Id.run do\\n  let mut buckets : Buckets := {}\\n  for position in positions inputs do\\n    let text := textAt inputs position\\n    buckets := buckets.insert text ((bucket buckets text).insert position)\\n  return checkedIndex? inputs buckets\\n\\ntheorem Index.contains_original (index : Index inputs) (source : Fin inputs.size)\\n    (row : Fin inputs[source].size) (text : String) (same : inputs[source][row] = text) :\\n    (bucket index.buckets text).contains (source.val,row.val) = true := by\\n  have present := List.all_eq_true.mp index.complete (source.val,row.val) (position_present source row)\\n  simpa only [textAt_present,same] using present\\n\\nstructure Unique (index : Index inputs) (text : String) where\\n  position : Position\\n  correspondence : Correspondence inputs text position\\n  only : (bucket index.buckets text).toList = [position]\\n\\ndef Index.unique? (index : Index inputs) (text : String) : Option (Unique index text) :=\\n  match found : (bucket index.buckets text).toList with\\n  | [position] => do\\n      let correspondence ← check? inputs text position\\n      some ⟨position,correspondence,found⟩\\n  | _ => none\\n\\ntheorem Unique.only_original {index : Index inputs} {text : String}\\n    (unique : Unique index text) (source : Fin inputs.size)\\n    (row : Fin inputs[source].size) (same : inputs[source][row] = text) :\\n    unique.position = (source.val,row.val) := by\\n  have included := index.contains_original source row text same\\n  have present : (source.val,row.val) ∈ (bucket index.buckets text).toList :=\\n    Std.HashSet.mem_toList.mpr (Std.HashSet.mem_iff_contains.mpr included)\\n  rw [unique.only] at present\\n  exact (List.mem_singleton.mp present).symm\\n\\n/-- Neighboring records are accepted only through literal sequence equality.\\nThe adapter may propose a run around a unique anchor, but cannot fill a gap\\nfrom a path name, line-number hint or presumed tool operation. -/\\nstructure Run (inputs : Inputs) (output : Array String)\\n    (source first outputFirst count : Nat) : Type where\\n  nonempty : 0 < count\\n  sourceBound : source < inputs.size\\n  sourceEnd : first+count ≤ (inputs[source]'sourceBound).size\\n  outputEnd : outputFirst+count ≤ output.size\\n  original : ∀ offset : Fin count,\\n    (inputs[source]'sourceBound)[first+offset.val]'(by have := offset.isLt; omega) =\\n      output[outputFirst+offset.val]'(by have := offset.isLt; omega)\\n\\ndef run? (inputs : Inputs) (output : Array String) (source first outputFirst count : Nat) :\\n    Option (Run inputs output source first outputFirst count) :=\\n  if nonempty : 0 < count then\\n    if sourceBound : source < inputs.size then\\n      if sourceEnd : first+count ≤ inputs[source].size then\\n        if outputEnd : outputFirst+count ≤ output.size then\\n          if original : (List.finRange count).all (fun offset =>\\n              decide (inputs[source][first+offset.val]'(by have := offset.isLt; omega) =\\n                output[outputFirst+offset.val]'(by have := offset.isLt; omega))) = true then\\n            some ⟨nonempty,sourceBound,sourceEnd,outputEnd,by\\n              intro offset\\n              simpa only [decide_eq_true_eq] using\\n                (List.all_eq_true.mp original offset (by simp))⟩\\n          else none\\n        else none\\n      else none\\n    else none\\n  else none\\n\\nstructure AnchoredRun (index : Index inputs) (output : Array String) (anchorIndex : Fin output.size)\\n    (anchor : Unique index output[anchorIndex]) (first count : Nat) : Type where\\n  contains : first ≤ anchorIndex.val ∧ anchorIndex.val < first+count\\n  preceding : anchorIndex.val-first ≤ anchor.position.2\\n  original : Run inputs output anchor.position.1 (anchor.position.2-(anchorIndex.val-first)) first count\\n\\n/-- The source and its starting position come from a unique content anchor,\\nnot a guessed path. Every neighboring output record is checked again. -/\\ndef anchoredRun? (index : Index inputs) (output : Array String) (anchorIndex : Fin output.size)\\n    (anchor : Unique index output[anchorIndex]) (first count : Nat) :\\n    Option (AnchoredRun index output anchorIndex anchor first count) :=\\n  if contains : first ≤ anchorIndex.val ∧ anchorIndex.val < first+count then\\n    if preceding : anchorIndex.val-first ≤ anchor.position.2 then do\\n      let original ← run? inputs output anchor.position.1 (anchor.position.2-(anchorIndex.val-first)) first count\\n      some ⟨contains,preceding,original⟩\\n    else none\\n  else none\\n\\ntheorem AnchoredRun.anchor_preserved (run : AnchoredRun index output anchorIndex anchor first count) :\\n    anchor.position.2-(anchorIndex.val-first)+(anchorIndex.val-first) = anchor.position.2 := by\\n  have := run.preceding\\n  omega\\n\\n/-- Capture needs only absence, one location, or proven ambiguity. It never\\nstores an unbounded posting list for common records such as `}`. Replaying\\nthe same immutable input position does not manufacture ambiguity. -/\\ninductive Candidate where\\n  | absent\\n  | one (position : Position)\\n  | ambiguous\\n  deriving DecidableEq, BEq, Repr\\n\\ndef Candidate.join : Candidate → Candidate → Candidate\\n  | .absent,right => right\\n  | left,.absent => left\\n  | .one left,.one right => if left = right then .one left else .ambiguous\\n  | _,_ => .ambiguous\\n\\n@[simp] theorem Candidate.absent_join (candidate : Candidate) :\\n    Candidate.absent.join candidate = candidate := rfl\\n\\n@[simp] theorem Candidate.join_absent (candidate : Candidate) :\\n    candidate.join .absent = candidate := by cases candidate <;> rfl\\n\\n@[simp] theorem Candidate.ambiguous_join (candidate : Candidate) :\\n    Candidate.ambiguous.join candidate = .ambiguous := by cases candidate <;> rfl\\n\\n@[simp] theorem Candidate.join_ambiguous (candidate : Candidate) :\\n    candidate.join .ambiguous = .ambiguous := by cases candidate <;> rfl\\n\\ntheorem Candidate.join_idempotent (candidate : Candidate) :\\n    candidate.join candidate = candidate := by\\n  cases candidate <;> simp [join]\\n\\ntheorem Candidate.join_commutative (left right : Candidate) :\\n    left.join right = right.join left := by\\n  cases left <;> cases right <;>\\n    try simp only [absent_join,join_absent,ambiguous_join,join_ambiguous]\\n  rename_i a b\\n  by_cases same : a = b\\n  · subst b; simp [join]\\n  · simp [join,same,Ne.symm same]\\n\\ntheorem Candidate.join_associative (left middle right : Candidate) :\\n    (left.join middle).join right = left.join (middle.join right) := by\\n  cases left <;> cases middle <;> cases right <;>\\n    try simp only [absent_join,join_absent,ambiguous_join,join_ambiguous]\\n  rename_i a b c\\n  by_cases same : a = b\\n  · subst b\\n    by_cases next : a = c <;> simp [join,next]\\n  · by_cases next : b = c\\n    · subst c; simp [join,same]\\n    · simp [join,same,next]\\n\\nabbrev StreamIndex := Std.HashMap String Candidate\\n\\ndef start (output : Array String) : StreamIndex :=\\n  output.foldl (fun index text => index.insert text .absent) {}\\n\\n/-- Index the bounded observed output, then stream the acquired input once.\\nUnwanted input records allocate no entry. The capture adapter must seal all\\ninput fingerprints and EOF before treating a `.one` as final correspondence. -/\\ndef observe (index : StreamIndex) (position : Position) (text : String) : StreamIndex :=\\n  index.modify text (fun candidate => candidate.join (.one position))\\n\\ntheorem observe_size (index : StreamIndex) (position : Position) (text : String) :\\n    (observe index position text).size = index.size := by\\n  exact Std.HashMap.size_modify\\n\\ntheorem observe_keeps_domain (index : StreamIndex) (position : Position) (text query : String) :\\n    (observe index position text).contains query = index.contains query := by\\n  exact Std.HashMap.contains_modify\\n\\nend ContentCorrespondence\\n\"],[\"JsonScalars.lean\",\"module\\n\\npublic import Lean.Data.Json.Parser\\npublic import Lean.Data.Json.FromToJson\\n\\n@[expose] public section\\n\\nnamespace Eggshell.JsonScalars\\nopen Lean\\n\\ninductive Segment where\\n  | key (name : String)\\n  | index (position : Nat)\\n  deriving DecidableEq, BEq, ToJson, FromJson\\n\\ndef pathJson (path : List Segment) : Json :=\\n  toJson (path.map fun part => match part with\\n    | .key name => toJson name | .index position => toJson position)\\n\\ndef resolve (value : Json) : List Segment → Except String Json\\n  | [] => .ok value\\n  | .key name :: rest => do resolve (← value.getObjVal? name) rest\\n  | .index position :: rest => do resolve (← value.getArrVal? position) rest\\n\\nstructure Scalar where\\n  first : Nat\\n  limit : Nat\\n  literal : String\\n  text : Option String\\n  offsets : Array Nat\\n  /-- Reversed paths share their ancestors instead of copying every prefix. -/\\n  pathRev : List Segment\\n  contextFirst : Nat\\n\\nstructure Frame where\\n  object : Bool\\n  pathRev : List Segment\\n  next : Nat := 0\\n  key : Option (String × Nat) := none\\n\\ndef place (frames : Array Frame) (first : Nat) :\\n    Except String (List Segment × Nat × Array Frame) := do\\n  let some frame := frames.back? | return ([],first,frames)\\n  if frame.object then\\n    let some (key,start) := frame.key | throw \\\"structured object has no pending key\\\"\\n    return (.key key :: frame.pathRev,start,frames.pop.push {frame with key := none})\\n  else\\n    return (.index frame.next :: frame.pathRev,first,\\n      frames.pop.push {frame with next := frame.next+1})\\n\\ndef primitive : Json → Bool\\n  | .arr _ | .obj _ => false\\n  | _ => true\\n\\ndef scalarLiteral (text : String) : Bool :=\\n  (Json.parse text).toOption.any fun value => primitive value && value.compress == text\\n\\n/-- One canonical scan records literal coordinates, immediate member starts\\nand shared ancestor paths. Keys provide context but never become witnesses. -/\\ndef scan (json : Json) (raw : String) : Except String (Array Scalar) := do\\n  unless json.compress == raw do throw \\\"noncanonical structured observation\\\"\\n  let chars := raw.toList.toArray\\n  let mut position := 0\\n  let mut result := #[]\\n  let mut frames : Array Frame := #[]\\n  while position < chars.size do\\n    let char := chars[position]!\\n    if char == '{' || char == '[' then\\n      let (path,_,next) ← place frames position\\n      frames := next.push {object := char == '{',pathRev := path}\\n      position := position+1\\n    else if char == '}' || char == ']' then\\n      frames := frames.pop\\n      position := position+1\\n    else if char.isWhitespace || \\\",:\\\".contains char then\\n      position := position+1\\n    else if char == '\\\"' then\\n      let first := position\\n      position := position+1\\n      let mut escaped := false\\n      let mut closed := false\\n      while position < chars.size do\\n        let char := chars[position]!\\n        position := position+1\\n        if escaped then escaped := false\\n        else if char == '\\\\\\\\' then escaped := true\\n        else if char == '\\\"' then closed := true; break\\n      unless closed do throw \\\"unfinished structured string\\\"\\n      let limit := position\\n      let mut following := position\\n      while following < chars.size && chars[following]!.isWhitespace do following := following+1\\n      let literal := String.ofList (chars.extract first limit).toList\\n      let text ← Json.parse literal >>= Json.getStr?\\n      if chars[following]? == some ':' then\\n        let some frame := frames.back? | throw \\\"structured key has no object\\\"\\n        unless frame.object && frame.key.isNone do throw \\\"structured key outside an object\\\"\\n        frames := frames.pop.push {frame with key := some (text,first)}\\n        continue\\n      let (path,contextFirst,next) ← place frames first\\n      frames := next\\n      let mut offsets := #[]\\n      let mut original := first+1\\n      for char in text.toList do\\n        offsets := offsets.push original\\n        original := original+(toJson (String.singleton char)).compress.length-2\\n      offsets := offsets.push original\\n      unless original+1 == limit do throw \\\"structured scalar coordinates differ\\\"\\n      result := result.push ⟨first,limit,literal,some text,offsets,path,contextFirst⟩\\n    else\\n      let first := position\\n      while position < chars.size && !chars[position]!.isWhitespace &&\\n          !(\\\"{}[],:\\\".contains chars[position]!) do position := position+1\\n      let literal := String.ofList (chars.extract first position).toList\\n      unless scalarLiteral literal do throw \\\"invalid structured scalar\\\"\\n      let (path,contextFirst,next) ← place frames first\\n      frames := next\\n      result := result.push ⟨first,position,literal,none,#[],path,contextFirst⟩\\n  return result\\n\\ndef values (raw : String) : Except String (Array Scalar) := do scan (← Json.parse raw) raw\\n\\ndef Scalar.prefixExact (scalar : Scalar) (raw : Array Char) : Bool :=\\n  match scalar.pathRev.head? with\\n  | some (.key name) =>\\n      String.ofList (raw.extract scalar.contextFirst scalar.first).toList ==\\n        (toJson name).compress ++ \\\":\\\"\\n  | _ => scalar.contextFirst == scalar.first\\n\\n/-- A displayed path is independently checked against the parsed original.\\nIts member prefix and literal still refer to exact original characters. -/\\nstructure Checked (root : Json) (raw : Array Char) where\\n  scalar : Scalar\\n  value : Json\\n  resolved : resolve root scalar.pathRev.reverse = .ok value\\n  primitive : primitive value = true\\n  spelling : value.compress = scalar.literal\\n  bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size\\n  exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal\\n  memberExact : scalar.prefixExact raw = true\\n\\ndef Checked.check? (root : Json) (raw : Array Char) (scalar : Scalar) : Option (Checked root raw) :=\\n  match resolved : resolve root scalar.pathRev.reverse with\\n  | .error _ => none\\n  | .ok value =>\\n    if primitive : JsonScalars.primitive value = true then\\n      if spelling : value.compress = scalar.literal then\\n        if bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size then\\n          if exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal then\\n            if memberExact : scalar.prefixExact raw = true then\\n              some ⟨scalar,value,resolved,primitive,spelling,bounds,exact,memberExact⟩ else none\\n          else none\\n        else none\\n      else none\\n    else none\\n\\nstructure Address (raw : String) where\\n  root : Json\\n  characters : Array Char\\n  parsed : Json.parse raw = .ok root\\n  charactersExact : characters = raw.toList.toArray\\n  leaf : Checked root characters\\n\\ndef Address.path (address : Address raw) : List Segment := address.leaf.scalar.pathRev.reverse\\n\\ndef Address.label (address : Address raw) : String := (pathJson address.path).compress\\n\\ntheorem address_resolves (address : Address raw) :\\n    Json.parse raw = .ok address.root ∧ resolve address.root address.path = .ok address.leaf.value :=\\n  ⟨address.parsed,address.leaf.resolved⟩\\n\\ntheorem address_literal_is_original (address : Address raw) :\\n    String.ofList (raw.toList.toArray.extract address.leaf.scalar.first address.leaf.scalar.limit).toList =\\n      address.leaf.value.compress := by\\n  rw [← address.charactersExact,address.leaf.spelling]\\n  exact address.leaf.exact\\n\\nstructure Index (raw : String) where\\n  root : Json\\n  characters : Array Char\\n  parsed : Json.parse raw = .ok root\\n  charactersExact : characters = raw.toList.toArray\\n  leaves : Array (Checked root characters)\\n\\ndef prepare? (raw : String) : Option (Index raw) := do\\n  match parsed : Json.parse raw with\\n  | .error _ => none\\n  | .ok root =>\\n    let scalars ← (scan root raw).toOption\\n    let characters := raw.toList.toArray\\n    let leaves ← scalars.mapM (Checked.check? root characters)\\n    return ⟨root,characters,parsed,rfl,leaves⟩\\n\\n/-- Scalar limits are in original serialization order. Search once by the\\nlast position; ancestors and field names do not require a linear leaf scan. -/\\ndef Index.cover? (index : Index raw) (first limit : Nat) : Option (Address raw) := Id.run do\\n  let mut lower := 0\\n  let mut upper := index.leaves.size\\n  while lower < upper do\\n    let middle := (lower+upper)/2\\n    let some leaf := index.leaves[middle]? | return none\\n    if leaf.scalar.limit < limit then lower := middle+1 else upper := middle\\n  let some leaf := index.leaves[lower]? | return none\\n  if leaf.scalar.contextFirst ≤ first && first < limit && limit ≤ leaf.scalar.limit then\\n    return some ⟨index.root,index.characters,index.parsed,index.charactersExact,leaf⟩\\n  return none\\n\\ndef Index.witness? (index : Index raw) (first limit : Nat) : Option (Address raw) := do\\n  let address ← index.cover? first limit\\n  if address.leaf.scalar.first ≤ first then some address else none\\n\\nend Eggshell.JsonScalars\\n\"],[\"SynapseQuotes.lean\",\"module\\n\\npublic import Eggshell.Sha256\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.Quotes\\n\\n/-- Only opaque keys of already stored source spellings enter the index. A\\nkey selects candidates; the original spelling is checked again before use. -/\\ndef digest (text : String) : String :=\\n  Sha256.hex (\\\"eggshell.literal-quotation\\\\n\\\" ++ text).toUTF8\\n\\nstructure Quote (original : String) where\\n  first : Nat\\n  limit : Nat\\n  text : String\\n  within : first < limit ∧ limit ≤ original.length\\n  exact : text = String.ofList (original.toList.toArray.extract first limit).toList\\n\\ntheorem quote_is_original (quote : Quote original) :\\n    quote.text = String.ofList (original.toList.toArray.extract quote.first quote.limit).toList :=\\n  quote.exact\\n\\n/-- Literal backtick spans only, with equally sized closing delimiters. No\\nnormalization or semantic attribution is inferred from ordinary prose. The\\ncursor never rewinds, including on unfinished or mismatched delimiters. -/\\ndef extract (original : String) : Array (Quote original) := Id.run do\\n  let chars := original.toList.toArray\\n  let size := original.length\\n  let mut position := 0\\n  let mut result := #[]\\n  while position < chars.size do\\n    if chars[position]! != '`' then position := position+1; continue\\n    let start := position\\n    while position < chars.size && chars[position]! == '`' do position := position+1\\n    let width := position-start\\n    let first := position\\n    while position < chars.size do\\n      if chars[position]! != '`' then position := position+1; continue\\n      let limit := position\\n      while position < chars.size && chars[position]! == '`' do position := position+1\\n      if position-limit != width then continue\\n      if within : first < limit ∧ limit ≤ size then\\n        result := result.push ⟨first,limit,String.ofList (chars.extract first limit).toList,within,rfl⟩\\n      break\\n  return result\\n\\nend Eggshell.Synapses.Quotes\\n\"],[\"ObservationContext.lean\",\"module\\n\\npublic import Eggshell.SynapseSource\\npublic import Eggshell.Sha256\\npublic import Eggshell.SynapseQuotes\\npublic import tools.LiteralSearch\\npublic import Eggshell.QuotationContext\\n\\n@[expose] public section\\n\\nnamespace Eggshell.Synapses.ObservationContext\\nopen Lean Extraction\\n\\n/-- Plain text keeps its actual row. Structured data uses checked scalar\\nmembers and ancestor paths, rather than copying the enclosing object. -/\\ndef lineBounds (lines : Array TextLine) (first limit : Nat) : Nat × Nat := Id.run do\\n  let mut lower := 0\\n  let mut upper := lines.size\\n  while lower < upper do\\n    let middle := (lower+upper)/2\\n    let some line := lines[middle]? | return (first,limit)\\n    if line.limit < limit then lower := middle+1 else upper := middle\\n  match lines[lower]? with\\n  | some line => if line.first ≤ first && limit ≤ line.limit then (line.first,line.limit) else (first,limit)\\n  | none => (first,limit)\\n\\ndef originalSubject (work raw : String) : Original := ⟨work,Sha256.hex raw.toUTF8,raw.length⟩\\n\\n/-- The original identity requires hashing once, not JSON/command parsing.\\nThe same pinned native observation can then bind any valid stored interval. -/\\nstructure OriginalOwner (doc : Document) where\\n  raw : String\\n  original : doc.source = some raw\\n  identity : Original\\n  identityExact : identity = originalSubject doc.work raw\\n  native : doc.native = true\\n\\ndef OriginalOwner.prepare? (doc : Document) : Option (OriginalOwner doc) := do\\n  let raw ← doc.source\\n  if original : doc.source = some raw then\\n    if native : doc.native = true then some ⟨raw,original,originalSubject doc.work raw,rfl,native⟩ else none\\n  else none\\n\\nstructure OriginalOwner.Bound (owner : OriginalOwner doc) (database : String) (source : Range) where\\n  read : Read\\n  valid : read.valid = true\\n  sourceExact : read.source = source\\n  databaseExact : read.binding.database = database\\n  ownerExact : read.binding.owner = doc.owner\\n  workExact : read.binding.work = doc.work\\n  nativeOrigin : doc.occurrences.contains read.occurrence = true\\n  sourceIdentity : source.subject = .original owner.identity\\n  withinOriginal : read.binding.limit ≤ owner.raw.length\\n  firstExact : read.binding.first = source.first-1\\n  limitExact : read.binding.limit = source.last\\n\\ndef OriginalOwner.bind (owner : OriginalOwner doc) (database : String) (source : Range) :\\n    Array (owner.Bound database source) := Id.run do\\n  if sourceIdentity : source.subject = .original owner.identity then\\n    if sourceValid : source.valid = true then\\n      have inBounds : source.last ≤ owner.raw.length := by\\n        have checked := sourceValid\\n        simp only [Range.valid,sourceIdentity,Bool.and_eq_true,decide_eq_true_eq] at checked\\n        simpa [owner.identityExact,originalSubject] using checked.2\\n      let mut result := #[]\\n      for occurrence in doc.occurrences do\\n        let read : Read := ⟨occurrence,source,⟨database,doc.owner,doc.work,source.first-1,source.last⟩,#[]⟩\\n        if valid : read.valid = true then\\n          if origin : doc.occurrences.contains occurrence = true then\\n            result := result.push ⟨read,valid,rfl,rfl,rfl,rfl,origin,sourceIdentity,inBounds,rfl,rfl⟩\\n      return result\\n    else return #[]\\n  else return #[]\\n\\ntheorem OriginalOwner.Bound.same_native_owner {doc : Document} {owner : OriginalOwner doc}\\n    {database : String} {source : Range} (bound : owner.Bound database source) :\\n    bound.read.binding.owner = doc.owner ∧ bound.read.binding.work = doc.work ∧\\n      doc.occurrences.contains bound.read.occurrence = true :=\\n  ⟨bound.ownerExact,bound.workExact,bound.nativeOrigin⟩\\n\\ntheorem OriginalOwner.Bound.same_requested_range {doc : Document} {owner : OriginalOwner doc}\\n    {database : String} {source : Range} (bound : owner.Bound database source) :\\n    bound.read.source = source ∧ bound.read.binding.first = source.first-1 ∧\\n      bound.read.binding.limit = source.last := ⟨bound.sourceExact,bound.firstExact,bound.limitExact⟩\\n\\nstructure Prepared (doc : Document) where\\n  raw : String\\n  original : doc.source = some raw\\n  view : Layout\\n  mapped : layout raw = .ok view\\n  rawChars : Array Char\\n  rawCharsExact : rawChars = raw.toList.toArray\\n  viewChars : Array Char\\n  viewCharsExact : viewChars = view.text.toList.toArray\\n  lines : Array TextLine\\n  identity : Original\\n  identityExact : identity = originalSubject doc.work raw\\n  json : Option (JsonScalars.Index raw)\\n\\ndef prepare? (doc : Document) : Option (Prepared doc) := do\\n  let raw ← doc.source\\n  if original : doc.source = some raw then\\n    match mapped : layout raw with\\n    | .error _ => none\\n    | .ok view => some ⟨raw,original,view,mapped,raw.toList.toArray,rfl,\\n        view.text.toList.toArray,rfl,textLines view.text,originalSubject doc.work raw,rfl,JsonScalars.prepare? raw⟩\\n  else none\\n\\ndef Prepared.rawBounds (prepared : Prepared doc) (edge : Consumption) :\\n    Option (Nat × Nat × JsonScalars.Address prepared.raw) := do\\n  let index ← prepared.json\\n  let address ← index.witness? edge.outputFirst edge.outputLimit\\n  let scalar := address.leaf.scalar\\n  if edge.kind == .value then\\n    if edge.outputFirst != scalar.first || edge.outputLimit != scalar.limit then none\\n    else some (scalar.contextFirst,scalar.limit,address)\\n  else if let some text := scalar.text then\\n    if text.contains '\\\\n' then do\\n      let first ← scalar.offsets.findIdx? (· == edge.outputFirst)\\n      let limit ← scalar.offsets.findIdx? (· == edge.outputLimit)\\n      let (first,limit) := lineBounds (textLines text) first limit\\n      let first ← scalar.offsets[first]?\\n      let limit ← scalar.offsets[limit]?\\n      some (first,limit,address)\\n    else some (scalar.contextFirst,scalar.limit,address)\\n  else some (scalar.contextFirst,scalar.limit,address)\\n\\nstructure Fragment (doc : Document) where\\n  occurrence : Occurrence\\n  binding : Binding\\n  raw : String\\n  payload : String\\n  address : Option (JsonScalars.Address raw)\\n  native : doc.native = true\\n  origin : doc.occurrences.contains occurrence = true\\n  original : doc.source = some raw\\n  owner : binding.owner = doc.owner\\n  work : binding.work = doc.work\\n  valid : binding.valid = true\\n  within : binding.first < binding.limit ∧ binding.limit ≤ raw.length\\n  exact : payload = String.ofList ((raw.toList.drop binding.first).take (binding.limit-binding.first))\\n\\n/-- Resolve only an actual producer and a literal saved output witness. Source\\nfiles, shell syntax and line numbers are not prerequisites. -/\\ndef Prepared.locate? (prepared : Prepared doc) (database : String) (edge : Consumption) : Option (Fragment doc) := do\\n  if native : doc.native = true then\\n    if origin : doc.occurrences.contains edge.producer = true then\\n        let raw := prepared.raw\\n        let view := if edge.outputFormat == .json then prepared.rawChars else prepared.viewChars\\n        if !(literal view edge.outputFirst edge.outputLimit edge.term) then none else do\\n          let (first,limit,address) ← if edge.outputFormat == .json then do\\n              let (first,limit,address) ← prepared.rawBounds edge\\n              if first ≤ edge.outputFirst && edge.outputLimit ≤ limit then some (first,limit,some address) else none\\n            else do\\n              let (first,limit) := lineBounds prepared.lines edge.outputFirst edge.outputLimit\\n              if !(first ≤ edge.outputFirst && edge.outputLimit ≤ limit) then none else do\\n                let first ← prepared.view.offsets[first]?\\n                let limit ← prepared.view.offsets[limit]?\\n                some (first,limit,prepared.json.bind (·.cover? first limit))\\n          do\\n            let binding : Binding := ⟨database,doc.owner,doc.work,fir
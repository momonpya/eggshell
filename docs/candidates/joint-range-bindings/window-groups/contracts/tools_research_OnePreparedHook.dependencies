rray Nat := digitBlock0 ++ digitBlock1 ++ digitBlock2 ++ digitBlock3 ++ digitBlock4 ++ digitBlock5 ++ digitBlock6\\n\\ndef foldMap : Std.HashMap Nat String := Std.HashMap.ofList folds.toList\\n\\ndef fold (c : Char) : String := (foldMap[c.toNat]?).getD (String.singleton c)\\n\\ndef isDigit (c : Char) : Bool := digits.contains c.toNat\\n\\nend Eggshell.SearchUnicode\\n\"],[\"../Eggshell/SearchRank.lean\",\"module\\n\\npublic import Eggshell.SearchUnicode\\npublic import Eggshell.HashDistinct\\npublic import tools.RetrievalGrams\\npublic import Eggshell.Frequency\\npublic import tools.FirstIndex\\npublic import Lean.Data.Json\\n\\n@[expose] public section\\n\\nnamespace Eggshell.SearchRank\\n\\ndef log1p (x : Float) : Float := RetrievalResearch.log1p x\\n\\ndef asciiTerm (c : Char) : Bool := RetrievalResearch.asciiTerm c\\n\\ndef rawTerms (text : String) : List String := RetrievalResearch.tokens text\\n\\ndef terms (text : String) : List String := hashDistinct (rawTerms text)\\n\\ntheorem deduplicated_nodup [BEq α] [LawfulBEq α] (xs : List α) : xs.eraseDups.Nodup := by\\n  match xs with\\n  | [] => simp\\n  | x :: tail =>\\n    rw [List.eraseDups_cons, List.nodup_cons]\\n    constructor\\n    · simp\\n    · exact deduplicated_nodup (tail.filter fun y => !y == x)\\ntermination_by xs.length\\ndecreasing_by\\n  have := List.length_filter_le (fun y => !y == x) tail\\n  simp only [List.length_cons]\\n  omega\\n\\ntheorem terms_nodup (text : String) : (terms text).Nodup :=\\n  HashDistinct.nodup (rawTerms text)\\n\\ndef anchor (term : String) : Bool := RetrievalResearch.anchor term\\n\\ndef scoreOrder (a b : Float × Nat) : Bool :=\\n  a.1 > b.1 || (a.1 == b.1 && a.2 ≤ b.2)\\n\\ndef rankRows (query : String) (rows : List α) (contains : α → String → Bool)\\n    (frequency : String → Nat) (anchors : Bool) (population : Nat := rows.length) : List Nat :=\\n  RetrievalResearch.rankRows query rows contains frequency anchors population\\n\\ndef rankDocuments (query : String) (documents : List (List String))\\n    (frequency : String → Nat) (anchors : Bool) : List Nat :=\\n  rankRows query documents List.contains frequency anchors\\n\\n/-- The indexed reader supplies complete query-term postings and global\\ncounts. Row enumeration preserves the provider's existing stable tie-break;\\nsource text and every unrelated document term remain unread. -/\\ntheorem rankRows_map (query : String) (rows : List α) (project : α → β)\\n    (contains : β → String → Bool) (frequency : String → Nat) (anchors : Bool) :\\n    rankRows query (rows.map project) contains frequency anchors =\\n      rankRows query rows (fun row term => contains (project row) term) frequency anchors := by\\n  simp only [rankRows, RetrievalResearch.rankRows, List.length_map, List.zipIdx_map, List.filterMap_map]\\n  rfl\\n\\n/-- The oracle preserves query-term order, floating-point operations and the\\nstable index tie-break. No mathematical rearrangement of Float sums is used. -/\\ndef referenceLexical (query : String) (candidates : List String)\\n    (anchors := false) : List Nat :=\\n  let documents := candidates.map terms\\n  rankDocuments query documents (fun term => (documents.filter (·.contains term)).length) anchors\\n\\ntheorem document_count_exact (candidates : List String) (term : String) :\\n    Frequency.count (candidates.map terms) term =\\n      ((candidates.map terms).filter (·.contains term)).length := by\\n  induction candidates with\\n  | nil => rfl\\n  | cons text rest ih =>\\n      simp only [List.map_cons, Frequency.count_cons, (terms_nodup text).count, ih,\\n        List.filter_cons, List.contains_eq_mem]\\n      split <;> simp_all [Nat.add_comm]\\n\\ntheorem document_frequency_append (left right : List (List String)) (term : String) :\\n    ((left ++ right).filter (·.contains term)).length =\\n      (left.filter (·.contains term)).length + (right.filter (·.contains term)).length := by\\n  simp\\n\\n/-- Reusable document compilation and a certified signed frequency index.\\nIts candidate sequence includes deletions, corrections and order changes. -/\\nstructure Corpus (candidates : List String) where\\n  documents : List (List String)\\n  exact : documents = candidates.map terms\\n  frequencies : Frequency.Index documents\\n\\ndef Corpus.build (candidates : List String) : Corpus candidates :=\\n  let documents := candidates.map terms\\n  ⟨documents, rfl, Frequency.Index.empty.replace documents [] documents (by intro term; simp)⟩\\n\\n/-- Unchanged prefix/suffix terms are reused. Only the changed region is\\nparsed, subtracted and added; zero counts disappear from the signed map. -/\\ndef Corpus.revise {before : List String} (previous : Corpus before)\\n    (after : List String) : Corpus after :=\\n  let region := Frequency.affectedRegion before after\\n  let left := previous.documents.take region.left.length\\n  let removed := (previous.documents.drop region.left.length).take region.removed.length\\n  let right := previous.documents.drop (region.left.length + region.removed.length)\\n  have leftExact : left = region.left.map terms := by\\n    simp [left, previous.exact, region.old, List.map_append]\\n  have removedExact : removed = region.removed.map terms := by\\n    simp [removed, previous.exact, region.old, List.map_append, List.append_assoc]\\n  have rightExact : right = region.right.map terms := by\\n    simp [right, previous.exact, region.old, List.map_append, List.append_assoc,\\n      ← List.drop_drop]\\n  let added := region.added.map terms\\n  let documents := left ++ added ++ right\\n  have exact : documents = after.map terms := by\\n    simp [documents, leftExact, rightExact, added, region.current, List.map_append]\\n  let frequencies := previous.frequencies.replace documents removed added (by\\n    intro term\\n    rw [previous.exact, exact, removedExact]\\n    simp only [region.old, region.current, List.map_append, Frequency.count_append]\\n    dsimp only [added]\\n    omega)\\n  ⟨documents, exact, frequencies⟩\\n\\ndef Corpus.rank {candidates : List String} (corpus : Corpus candidates) (query : String)\\n    (anchors := false) : List Nat :=\\n  rankDocuments query corpus.documents (fun term => (corpus.frequencies.counts.getD term 0).toNat) anchors\\n\\ntheorem Corpus.rank_exact {candidates : List String} (corpus : Corpus candidates)\\n    (query : String) (anchors : Bool) : corpus.rank query anchors = referenceLexical query candidates anchors := by\\n  have frequencies : (fun term => (corpus.frequencies.counts.getD term 0).toNat) =\\n      fun term => ((candidates.map terms).filter (·.contains term)).length := by\\n    funext term\\n    rw [corpus.frequencies.exact, corpus.exact, document_count_exact]\\n    simp\\n  simp only [rank, referenceLexical, corpus.exact, frequencies]\\n\\ndef lexical (query : String) (candidates : List String) (anchors := false) : List Nat :=\\n  (Corpus.build candidates).rank query anchors\\n\\ntheorem lexical_exact (query : String) (candidates : List String) (anchors : Bool) :\\n    lexical query candidates anchors = referenceLexical query candidates anchors :=\\n  Corpus.rank_exact _ query anchors\\n\\ndef fused (rankings : List (List Nat)) : List Nat :=\\n  let ids := rankings.flatten.eraseDups\\n  let scores := ids.map fun id =>\\n    (rankings.foldl (fun score ranking =>\\n      match (ranking.zipIdx.find? (·.1 == id)) with\\n      | some (_, rank) => score + 1 / (61 + rank).toFloat\\n      | none => score) (0 : Float), id)\\n  (scores.mergeSort scoreOrder).map (·.2)\\n\\n/-- Build each first-position directory once. Floating-point additions keep\\ntheir original ranking order, including duplicated ids within a ranking. -/\\ndef fusedIndexed (rankings : List (List Nat)) : List Nat :=\\n  let directories := rankings.map fun ranking => firstTable Prod.fst ranking.zipIdx\\n  let ids := hashDistinct rankings.flatten\\n  let scores := ids.map fun id =>\\n    (directories.foldl (fun score directory =>\\n      match directory[id]? with\\n      | some (_, rank) => score + 1 / (61 + rank).toFloat\\n      | none => score) (0 : Float), id)\\n  (scores.mergeSort scoreOrder).map (·.2)\\n\\n@[csimp] theorem fused_compiled : fused = fusedIndexed := by\\n  funext rankings\\n  simp only [fused, fusedIndexed, HashDistinct.reference, List.foldl_map,\\n    firstTable_exact]\\n\\n/-- All provider output goes through this constructor. It cannot invent an\\n    index, duplicate an outcome, or exceed the selected context budget. -/\\ndef select (count limit : Nat) (anchors ranking : List Nat) : List Nat :=\\n  ((anchors ++ ranking).eraseDups.filter (· < count)).take limit\\n\\ndef selectIndexed (count limit : Nat) (anchors ranking : List Nat) : List Nat :=\\n  ((hashDistinct (anchors ++ ranking)).filter (· < count)).take limit\\n\\n@[csimp] theorem select_compiled : select = selectIndexed := by\\n  funext count limit anchors ranking\\n  simp only [select, selectIndexed, HashDistinct.reference]\\n\\ntheorem selected_no_duplicates (n k : Nat) (a r : List Nat) : (select n k a r).Nodup := by\\n  exact (List.take_sublist k _).nodup (List.filter_sublist.nodup (deduplicated_nodup (a ++ r)))\\n\\ntheorem selected_within_budget (n k : Nat) (a r : List Nat) :\\n    (select n k a r).length ≤ k := by simp [select, List.length_take, Nat.min_le_left]\\n\\ntheorem selected_is_existing (n k : Nat) (a r : List Nat) (id : Nat)\\n    (member : id ∈ select n k a r) : id < n := by\\n  have h := List.mem_of_mem_take member\\n  have filtered := List.mem_filter.mp h\\n  simpa using filtered.2\\n\\ntheorem selected_was_ranked (n k : Nat) (a r : List Nat) (id : Nat)\\n    (member : id ∈ select n k a r) : id ∈ a ∨ id ∈ r := by\\n  have h := List.mem_of_mem_take member\\n  have filtered := (List.mem_filter.mp h).1\\n  simpa using filtered\\n\\ntheorem zero_budget_is_empty (n : Nat) (a r : List Nat) : select n 0 a r = [] := rfl\\n\\ndef windowsFrom : Nat → List Char → List String\\n  | 0, _ => []\\n  | count + 1, characters => String.ofList (characters.take 512) :: windowsFrom count (characters.drop 384)\\n\\ntheorem windowsFrom_exact (count : Nat) (characters : List Char) :\\n    windowsFrom count characters = (List.range count).map (fun index =>\\n      String.ofList ((characters.drop (index * 384)).take 512)) := by\\n  induction count generalizing characters with\\n  | zero => rfl\\n  | succ count ih =>\\n      simp only [windowsFrom, List.range_succ_eq_map, List.map_cons, Nat.zero_mul,\\n        List.drop_zero, List.map_map, ih]\\n      apply congrArg (List.cons (String.ofList (characters.take 512)))\\n      apply List.map_congr_left\\n      intro index _\\n      dsimp only [Function.comp_def]\\n      rw [List.drop_drop]\\n      have offset : 384 + index * 384 = index.succ * 384 := by omega\\n      rw [offset]\\n\\ndef windows (text : String) : List String :=\\n  let characters := text.toList\\n  windowsFrom ((max 1 characters.length + 383) / 384) characters\\n\\n/-- Byte offsets advance with the consumed prefix, rather than rescanning\\nthe original text. The projection is the very same window sequence. -/\\ndef locatedWindowsFrom : Nat → Nat → List Char → List (Nat × String)\\n  | 0, _, _ => []\\n  | count + 1, offset, characters =>\\n      (offset, String.ofList (characters.take 512)) ::\\n        locatedWindowsFrom count\\n          (offset + (String.ofList (characters.take 384)).utf8ByteSize)\\n          (characters.drop 384)\\n\\ntheorem locatedWindowsFrom_exact (count offset : Nat) (characters : List Char) :\\n    (locatedWindowsFrom count offset characters).map Prod.snd = windowsFrom count characters := by\\n  induction count generalizing offset characters with\\n  | zero => rfl\\n  | succ count ih => simp only [locatedWindowsFrom, List.map_cons, windowsFrom, ih]\\n\\ndef locatedWindows (text : String) : List (Nat × String) :=\\n  locatedWindowsFrom ((max 1 text.toList.length + 383) / 384) 0 text.toList\\n\\ntheorem locatedWindows_exact (text : String) :\\n    (locatedWindows text).map Prod.snd = windows text :=\\n  locatedWindowsFrom_exact _ _ _\\n\\ntheorem windows_exact (text : String) :\\n    windows text = (List.range ((max 1 text.toList.length + 383) / 384)).map (fun index =>\\n      String.ofList ((text.toList.drop (index * 384)).take 512)) :=\\n  windowsFrom_exact _ _\\n\\nend Eggshell.SearchRank\\n\"],[\"RetrievalIndex.lean\",\"module\\n\\npublic import Eggshell.Persistence\\npublic import Eggshell.DB.Sidecar\\npublic import Eggshell.Receipt\\npublic import tools.RetrievalGrams\\n\\n@[expose] public section\\n\\nnamespace Eggshell.RetrievalResearch.Index\\nopen Lean\\nopen Persistence Store\\n\\ndef contract : String := Sha256.hex (\\n  (include_str \\\"RetrievalGrams.lean\\\").toUTF8 ++\\n  (include_str \\\"RetrievalCategories.lean\\\").toUTF8 ++\\n  (include_str \\\"../Eggshell/SearchUnicode.lean\\\").toUTF8 ++\\n  (include_str \\\"../Eggshell/SearchRank.lean\\\").toUTF8 ++\\n  (include_str \\\"RetrievalIndex.lean\\\").toUTF8)\\n\\n/-- Source roots are append ordinals; candidate deletion changes population.\\nBoth remain stable across derived query/matcher memo publications. -/\\nstructure Stamp where\\n  database : String\\n  authority : String\\n  roots : Nat\\n  candidates : Nat\\n  contract : String\\n  deriving ToJson, FromJson, BEq, DecidableEq\\n\\ndef stamp (source : Snapshot) : IO Stamp := do\\n  pure {\\n    database := source.head.identity, authority := Sha256.hex source.head.authority.toUTF8\\n    roots := ← getNat source.get \\\"roots\\\", candidates := ← getNat source.get \\\"candidates\\\", contract}\\n\\ndef authority (source : Snapshot) : String :=\\n  \\\"eggshell.lexical:\\\" ++ source.head.identity ++ \\\":\\\" ++\\n    Sha256.hex source.head.authority.toUTF8 ++ \\\":\\\" ++ contract\\n\\ndef path (source : Snapshot) (storage : DB.Sidecar.Storage) : IO System.FilePath := do\\n  pure ((← DB.Sidecar.locate source storage).directory / \\\"lexical\\\" / contract / \\\"tree\\\")\\n\\ndef readStamp (index : Snapshot) : IO (Option Stamp) := do\\n  let some bytes ← index.get \\\"ready\\\" | return none\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"invalid lexical readiness record\\\")\\n  some <$> IO.ofExcept (fromJson? (← IO.ofExcept (Json.parse text)))\\n\\nstructure Reader (source : Snapshot) where\\n  index : Snapshot\\n  expected : Stamp\\n\\ndef open? (source : Snapshot) : IO (Option (Reader source)) := do\\n  DB.Sidecar.observe source\\n  let expected ← stamp source\\n  for storage in [.database, .user] do\\n    try\\n      let index ← DB.PageMap.pin (← path source storage)\\n      unless index.head.authority == authority source do continue\\n      unless (← readStamp index) == some expected &&\\n          (← getNat index.get \\\"documents\\\") == expected.candidates do continue\\n      return some ⟨index, expected⟩\\n    catch _ => pure ()\\n  pure none\\n\\ndef Reader.posting (reader : Reader source) (unit : String) : IO (List Nat × Nat) := do\\n  let some term ← findTerm? reader.index reader.index.get unit | return ([], 0)\\n  let rows ← directory reader.index (key \\\"posting\\\" term.id)\\n  let count ← getNat reader.index.get (key \\\"frequency\\\" term.id)\\n  unless rows.length == count do throw (IO.userError \\\"lexical posting frequency disagrees\\\")\\n  for (ordinal, owner) in rows do\\n    let indexed ← IO.ofExcept (payloadSize (← reader.index.get (key \\\"owner\\\" owner)))\\n    let live ← IO.ofExcept (payloadSize (← source.get (key \\\"member\\\" owner)))\\n    unless indexed == ordinal && live == ordinal &&\\n        (← getNat source.get (key \\\"candidate\\\" owner)) == 1 do\\n      throw (IO.userError \\\"lexical posting names a different live source owner\\\")\\n  pure (rows.map Prod.snd, count)\\n\\ndef ready (source : Snapshot) : IO Bool := do\\n  if (← getNat source.get \\\"candidates\\\") == 0 then return true\\n  pure (← open? source).isSome\\n\\ndef status (source : Snapshot) : IO Json := do\\n  let expected ← stamp source\\n  pure (Json.mkObj [(\\\"contract\\\", toJson contract), (\\\"stamp\\\", toJson expected),\\n    (\\\"ready\\\", toJson (← ready source))])\\n\\n/-- Hybrid nominations require complete lexical as well as numerical input.\\nA missing/partial index is pending, never a completed empty ranking. -/\\ndef strictLookup (source : Snapshot) : IO (String → IO (List Nat × Nat)) := do\\n  if (← getNat source.get \\\"candidates\\\") == 0 then return fun _ => pure ([], 0)\\n  let some reader ← open? source |\\n    throw (IO.userError \\\"dictionary-free lexical index is pending explicit/background warm\\\")\\n  pure reader.posting\\n\\ndef strictPosting (source : Snapshot) (unit : String) : IO (List Nat × Nat) := do\\n  (← strictLookup source) unit\\n\\n/-- Cold-index delivery uses existing original-unit postings as coarse advice.\\nIt does not repair the index or claim the new normalized ranking is complete.\\nNormal operation requires warm; width/case aliases are guaranteed by that\\ncomplete index, not by this degraded original-unit path. -/\\ndef originalPosting (source : Snapshot) (unit : String) : IO (List Nat × Nat) := do\\n  let text := String.ofList (unit.toList.drop 1)\\n  let units := (LogicalText.logical text).units.map (·.text)\\n  let mut matched : Option (Std.HashSet Nat) := none\\n  for part in units do\\n    let ids := Std.HashSet.ofList (← Store.postings source part)\\n    matched := some (match matched with | none => ids | some before => before.filter ids.contains)\\n  let ids ← (matched.getD {}).toList.filterM fun id => do\\n    pure ((← source.get (key \\\"member\\\" id)).isSome &&\\n      (← getNat source.get (key \\\"candidate\\\" id)) == 1)\\n  pure (ids, ids.length)\\n\\ndef coarseLookup (source : Snapshot) (receipt : Option String := none) :\\n    IO (String → IO (List Nat × Nat)) := do\\n  if (← getNat source.get \\\"candidates\\\") == 0 then return fun _ => pure ([], 0)\\n  if let some reader ← open? source then return reader.posting\\n  Receipt.observe receipt (\\\"lexical-index-\\\" ++ source.head.identity) (Json.mkObj [\\n    (\\\"status\\\", toJson \\\"pending\\\"), (\\\"route\\\", toJson \\\"original-unit-postings\\\"),\\n    (\\\"database\\\", toJson source.head.identity), (\\\"contract\\\", toJson contract)])\\n  pure (originalPosting source)\\n\\ndef reverseTerms (writer : DB.PageMap.Writer) (owner : Nat) : IO (List Nat) := do\\n  let bytes ← readChunks (← writer.snapshot) writer.get \\\"ownerTerms\\\" owner\\n  let (terms, tail) ← IO.ofExcept ((DB.Wire.list DB.Wire.natural).decode bytes.toList)\\n  unless tail.isEmpty && hashDistinct terms == terms do throw (IO.userError \\\"invalid lexical reverse index\\\")\\n  pure terms\\n\\ndef retract (writer : DB.PageMap.Writer) (owner ordinal : Nat) : IO Unit := do\\n  for (term, index) in (← reverseTerms writer owner).zipIdx do\\n    let count ← getNat writer.get (key \\\"frequency\\\" term)\\n    if count == 0 then throw (IO.userError \\\"lexical frequency underflow\\\")\\n    putNat writer (key \\\"frequency\\\" term) (count - 1)\\n    writer.put (key (key \\\"posting\\\" term) ordinal) none\\n    if index % 256 == 255 then writer.flush\\n  writer.put (key \\\"owner\\\" owner) none\\n\\ndef add (writer : DB.PageMap.Writer) (source : Snapshot) (document : SearchDocument)\\n    (ordinal : Nat) : IO Bool := do\\n  let retained ← writer.get (key \\\"ownerTerms\\\" document.owner)\\n  let terms ← if retained.isSome then reverseTerms writer document.owner else do\\n    let reader ← NodeReader.new source\\n    let owner ← reader.outcome (← reader.locateOutcome document.owner)\\n    let intern : Intern := ⟨writer, ← IO.mkRef {}⟩\\n    let mut result : Array Nat := #[]\\n    for (unit, index) in (tokens (searchText owner)).zipIdx do\\n      result := result.push (← intern.term unit)\\n      if index % 256 == 255 then writer.flush\\n    pure result.toList\\n  for (term, index) in terms.zipIdx do\\n    putNat writer (key \\\"frequency\\\" term) ((← getNat writer.get (key \\\"frequency\\\" term)) + 1)\\n    putNat writer (key (key \\\"posting\\\" term) ordinal) document.owner\\n    if index % 256 == 255 then writer.flush\\n  putChunks writer \\\"ownerTerms\\\" document.owner ((DB.Wire.list DB.Wire.natural).encode terms).toByteArray\\n  putNat writer (key \\\"owner\\\" document.owner) ordinal\\n  pure retained.isNone\\n\\nstructure Result where\\n  stamp : Stamp\\n  added : Nat := 0\\n  removed : Nat := 0\\n  hydrated : Nat := 0\\n  batches : Nat := 0\\n  deriving ToJson\\n\\n/-- Explicit maintenance only. Read hooks never create or repair an index.\\nRemoving readiness precedes every delta, so a crash cannot certify a partial\\ntree. Pinned older readers retain their complete immutable page root. -/\\ndef warm (source : Snapshot) (storage : DB.Sidecar.Storage) : IO Result := do\\n  let expected ← stamp source\\n  if expected.candidates == 0 then return {stamp := expected}\\n  if let some known ← open? source then\\n    return {stamp := known.expected}\\n  DB.Sidecar.withIndexClaim (DB.Sidecar.Owner.ofSnapshot source) (fun sidecar => do\\n    let current ← (DB.Sidecar.Owner.ofSnapshot source).pin\\n    unless (← stamp current) == expected do throw (IO.userError \\\"source changed before lexical warm\\\")\\n    let folder ← DB.Sidecar.childDirectory sidecar.directory \\\"lexical\\\"\\n    let folder ← DB.Sidecar.childDirectory folder contract\\n    let target := folder / \\\"tree\\\"\\n    let initial ← if ← target.pathExists then DB.PageMap.pin target\\n      else DB.PageMap.create target (authority source)\\n    unless initial.head.authority == authority source do throw (IO.userError \\\"foreign lexical index\\\")\\n    let documents ← searchDocuments source\\n    let wanted ← documents.mapM fun document => do\\n      pure (document, ← getNat source.get (key \\\"member\\\" document.owner))\\n    let live := Std.HashMap.ofList (wanted.map fun (document, ordinal) => (document.owner, ordinal))\\n    let previous ← directory initial \\\"owner\\\"\\n    let known := Std.HashMap.ofList previous\\n    let removed := previous.filter fun (owner, ordinal) => live[owner]? != some ordinal\\n    let added := wanted.filter fun (document, ordinal) => known[document.owner]? != some ordinal\\n    let _ ← DB.PageMap.withWriter initial fun writer => writer.put \\\"ready\\\" none\\n    let mut index ← DB.PageMap.pin target\\n    let mut batches := 0\\n    let mut hydrated := 0\\n    let mut remainingRemoved := removed\\n    while !remainingRemoved.isEmpty do\\n      let batch := remainingRemoved.take 32\\n      let _ ← DB.PageMap.withWriter index fun writer =>\\n        for (owner, ordinal) in batch do retract writer owner ordinal\\n      remainingRemoved := remainingRemoved.drop 32\\n      index ← DB.PageMap.pin target\\n      batches := batches + 1\\n    let mut remainingAdded := added\\n    while !remainingAdded.isEmpty do\\n      let batch := remainingAdded.take 32\\n      let (read, _, _) ← DB.PageMap.withWriter index fun writer => do\\n        let mut read := 0\\n        for (document, ordinal) in batch do\\n          if ← add writer source document ordinal then read := read + 1\\n        pure read\\n      hydrated := hydrated + read\\n      remainingAdded := remainingAdded.drop 32\\n      index ← DB.PageMap.pin target\\n      batches := batches + 1\\n    let current ← (DB.Sidecar.Owner.ofSnapshot source).pin\\n    unless (← stamp current) == expected do throw (IO.userError \\\"source changed during lexical warm\\\")\\n    let observed ← directory index \\\"owner\\\"\\n    unless observed.length == expected.candidates &&\\n        observed.all (fun (owner, ordinal) => live[owner]? == some ordinal) do\\n      throw (IO.userError \\\"lexical index does not cover the complete source catalogue\\\")\\n    let _ ← DB.PageMap.withWriter index fun writer => do\\n      putNat writer \\\"documents\\\" expected.candidates\\n      writer.put \\\"ready\\\" (some (toJson expected).compress.toUTF8)\\n    pure {stamp := expected, added := added.length, removed := removed.length, hydrated, batches}) storage\\n\\nend Eggshell.RetrievalResearch.Index\\n\"]]]"],["tools.SharedCoverage","[\"module\\npublic import Std\\npublic import Eggshell.HashDistinct\\n@[expose] public section\\n\\n/- Independent evidence closures over a shared, immutable payload basis.\\n   This module has no Work, Match, Union, IO or completion operation.\\n   A caller must supply original ranges and their required provenance nodes.\\n   Selection uses current-search cue weights; it contains no expected answer. -/\\nnamespace SharedCoverage\\n\\nstructure Offer (nodes cues : Nat) where\\n  closure : List (Fin nodes)\\n  covers : List (Fin cues)\\n\\nstructure Problem where\\n  costs : Array (Nat × Nat)\\n  weights : Array Nat\\n  offers : Array (Offer costs.size weights.size)\\n  fixed : Nat × Nat := (0,0)\\n  limit : Nat × Nat\\n\\ndef nodes (p : Problem) (selected : List (Fin p.offers.size)) : List (Fin p.costs.size) :=\\n  (selected.flatMap fun index => p.offers[index].closure).eraseDups\\n\\ndef cues (p : Problem) (selected : List (Fin p.offers.size)) : List (Fin p.weights.size) :=\\n  (selected.flatMap fun index => p.offers[index].covers).eraseDups\\n\\ndef nodesFast (p : Problem) (selected : List (Fin p.offers.size)) : List (Fin p.costs.size) :=\\n  Eggshell.hashDistinct (selected.flatMap fun index => p.offers[index].closure)\\n\\ndef cuesFast (p : Problem) (selected : List (Fin p.offers.size)) : List (Fin p.weights.size) :=\\n  Eggshell.hashDistinct (selected.flatMap fun index => p.offers[index].covers)\\n\\n@[csimp] theorem nodes_compiled : @nodes = @nodesFast := by\\n  funext p selected\\n  exact (Eggshell.HashDistinct.reference _).symm\\n\\n@[csimp] theorem cues_compiled : @cues = @cuesFast := by\\n  funext p selected\\n  exact (Eggshell.HashDistinct.reference _).symm\\n\\ndef cost (p : Problem) (selected : List (Fin p.offers.size)) : Nat × Nat :=\\n  (nodes p selected).foldl (fun total index =>\\n    (total.1 + p.costs[index].1,total.2 + p.costs[index].2)) p.fixed\\n\\ndef benefit (p : Problem) (selected : List (Fin p.offers.size)) : Nat :=\\n  ((cues p selected).map fun index => p.weights[index]).sum\\n\\n/-- Native and byte limits apply to the union, including shared source frames. -/\\nstructure Selection (p : Problem) where\\n  selected : List (Fin p.offers.size)\\n  unique : selected.Nodup\\n  charsFit : (cost p selected).1 ≤ p.limit.1\\n  bytesFit : (cost p selected).2 ≤ p.limit.2\\n\\ndef empty? (p : Problem) : Option (Selection p) :=\\n  if fits : p.fixed.1 ≤ p.limit.1 ∧ p.fixed.2 ≤ p.limit.2 then\\n    some ⟨[],by simp,by simpa [cost,nodes] using fits.1,by simpa [cost,nodes] using fits.2⟩\\n  else none\\n\\ndef extend? (prior : Selection p) (index : Fin p.offers.size) : Option (Selection p) :=\\n  if fresh : index ∉ prior.selected then\\n    let next := prior.selected ++ [index]\\n    if fits : (cost p next).1 ≤ p.limit.1 ∧ (cost p next).2 ≤ p.limit.2 then\\n      some ⟨next,by\\n        apply List.nodup_append.mpr\\n        refine ⟨prior.unique,by simp,?_⟩\\n        intro a present b singleton same\\n        have last : b = index := List.mem_singleton.mp singleton\\n        exact fresh ((same.trans last) ▸ present),fits.1,fits.2⟩\\n    else none\\n  else none\\n\\nstructure Proposal (prior : Selection p) where\\n  result : Selection p\\n  gain : Nat\\n  positive : 0 < gain\\n  /-- Both limits enter the same denominator. Integer cross-products avoid\\n  rounding, division and a fitted tuning coefficient. -/\\n  charge : Nat\\n\\ndef proposal? (prior : Selection p) (index : Fin p.offers.size) : Option (Proposal prior) := do\\n  let result ← extend? prior index\\n  let gain := benefit p result.selected - benefit p prior.selected\\n  if positive : 0 < gain then\\n    let before := cost p prior.selected\\n    let after := cost p result.selected\\n    let charge := max ((after.1-before.1)*p.limit.2) ((after.2-before.2)*p.limit.1)\\n    pure ⟨result,gain,positive,charge⟩\\n  else none\\n\\n/-- Stable ties retain the earlier declared offer. Zero-charge novel evidence\\nprecedes charged evidence, without giving a duplicate cue another vote. -/\\ndef better (next previous : Proposal prior) : Bool :=\\n  if next.charge == 0 then previous.charge != 0 || previous.gain < next.gain\\n  else if previous.charge == 0 then false\\n  else previous.gain*next.charge < next.gain*previous.charge\\n\\ndef best (prior : Selection p) : Option (Proposal prior) :=\\n  (List.finRange p.offers.size).foldl (fun found index =>\\n    match proposal? prior index,found with\\n    | none,_ => found\\n    | some next,none => some next\\n    | some next,some previous => if better next previous then some next else found) none\\n\\n\\ntheorem removeAll_distinct [BEq α] [LawfulBEq α] (left right : List α) :\\n    left.removeAll right.eraseDups = left.removeAll right := by\\n  simp [List.removeAll, List.elem_eq_contains, List.contains_eq_mem]\\n\\ntheorem nodes_append_one (p : Problem) (selected : List (Fin p.offers.size))\\n    (index : Fin p.offers.size) :\\n    nodes p (selected ++ [index]) = nodes p selected ++\\n      (p.offers[index].closure.removeAll (nodes p selected)).eraseDups := by\\n  simp only [nodes, List.flatMap_append, List.flatMap_singleton, List.eraseDups_append]\\n  rw [removeAll_distinct]\\n\\ntheorem cues_append_one (p : Problem) (selected : List (Fin p.offers.size))\\n    (index : Fin p.offers.size) :\\n    cues p (selected ++ [index]) = cues p selected ++\\n      (p.offers[index].covers.removeAll (cues p selected)).eraseDups := by\\n  simp only [cues, List.flatMap_append, List.flatMap_singleton, List.eraseDups_append]\\n  rw [removeAll_distinct]\\n\\nstructure Evaluation (prior : Selection p) where\\n  nodeIndex : Std.HashMap (Fin p.costs.size) Unit\\n  nodesExact : Eggshell.HashDistinct.Seen nodeIndex (nodes p prior.selected)\\n  cueIndex : Std.HashMap (Fin p.weights.size) Unit\\n  cuesExact : Eggshell.HashDistinct.Seen cueIndex (cues p prior.selected)\\n  beforeCost : Nat × Nat\\n  costExact : beforeCost = cost p prior.selected\\n  beforeBenefit : Nat\\n  benefitExact : beforeBenefit = benefit p prior.selected\\n\\ndef evaluation (prior : Selection p) : Evaluation prior := {\\n  nodeIndex := (nodes p prior.selected).foldl (fun known node => known.insert node ()) {}\\n  nodesExact := by intro query; simp [Eggshell.HashDistinct.fold_contains]\\n  cueIndex := (cues p prior.selected).foldl (fun known cue => known.insert cue ()) {}\\n  cuesExact := by intro query; simp [Eggshell.HashDistinct.fold_contains]\\n  beforeCost := cost p prior.selected\\n  costExact := rfl\\n  beforeBenefit := benefit p prior.selected\\n  benefitExact := rfl}\\n\\nvariable {p : Problem} {prior : Selection p}\\n\\ndef Evaluation.afterCost (cached : Evaluation prior) (index : Fin p.offers.size) : Nat × Nat :=\\n  let fresh := Eggshell.hashDistinct (p.offers[index].closure.filter fun node => !cached.nodeIndex.contains node)\\n  fresh.foldl (fun total node => (total.1+p.costs[node].1,total.2+p.costs[node].2)) cached.beforeCost\\n\\ndef Evaluation.afterBenefit (cached : Evaluation prior) (index : Fin p.offers.size) : Nat :=\\n  let fresh := Eggshell.hashDistinct (p.offers[index].covers.filter fun cue => !cached.cueIndex.contains cue)\\n  cached.beforeBenefit + (fresh.map fun cue => p.weights[cue]).sum\\n\\ntheorem Evaluation.afterCost_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\\n    cached.afterCost index = cost p (prior.selected ++ [index]) := by\\n  unfold Evaluation.afterCost cost\\n  rw [nodes_append_one, List.foldl_append, Eggshell.HashDistinct.reference, cached.costExact]\\n  simp only [List.removeAll, List.elem_eq_contains, cached.nodesExact _]\\n  rfl\\n\\ntheorem Evaluation.afterBenefit_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\\n    cached.afterBenefit index = benefit p (prior.selected ++ [index]) := by\\n  unfold Evaluation.afterBenefit benefit\\n  rw [cues_append_one, List.map_append, List.sum_append, Eggshell.HashDistinct.reference, cached.benefitExact]\\n  simp only [List.removeAll, List.elem_eq_contains, cached.cuesExact _]\\n  rfl\\n\\ndef extendCached? (prior : Selection p) (cached : Evaluation prior)\\n    (index : Fin p.offers.size) : Option (Selection p) :=\\n  if fresh : index ∉ prior.selected then\\n    let after := cached.afterCost index\\n    if fits : after.1 ≤ p.limit.1 ∧ after.2 ≤ p.limit.2 then\\n      some ⟨prior.selected ++ [index],by\\n        apply List.nodup_append.mpr\\n        refine ⟨prior.unique,by simp,?_⟩\\n        intro a present b singleton same\\n        have last : b = index := List.mem_singleton.mp singleton\\n        exact fresh ((same.trans last) ▸ present),\\n        by rw [← cached.afterCost_exact index]; exact fits.1,\\n        by rw [← cached.afterCost_exact index]; exact fits.2⟩\\n    else none\\n  else none\\n\\ntheorem extendCached_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\\n    extendCached? prior cached index = extend? prior index := by\\n  simp only [extendCached?, extend?, Evaluation.afterCost_exact]\\n\\ndef proposalCached? (prior : Selection p) (cached : Evaluation prior)\\n    (index : Fin p.offers.size) : Option (Proposal prior) := do\\n  let result ← extendCached? prior cached index\\n  let gain := cached.afterBenefit index - cached.beforeBenefit\\n  if positive : 0 < gain then\\n    let before := cached.beforeCost\\n    let after := cached.afterCost index\\n    let charge := max ((after.1-before.1)*p.limit.2) ((after.2-before.2)*p.limit.1)\\n    pure ⟨result,gain,positive,charge⟩\\n  else none\\n\\ntheorem proposalCached_exact (cached : Evaluation prior) (index : Fin p.offers.size) :\\n    proposalCached? prior cached index = proposal? prior index := by\\n  unfold proposalCached? proposal?\\n  rw [extendCached_exact]\\n  by_cases fresh : index ∉ prior.selected\\n  · by_cases fits : (cost p (prior.selected ++ [index])).1 ≤ p.limit.1 ∧\\n        (cost p (prior.selected ++ [index])).2 ≤ p.limit.2\\n    · simp [extend?,fresh,fits,Evaluation.afterBenefit_exact,Evaluation.afterCost_exact,\\n        cached.costExact,cached.benefitExact]\\n    · simp [extend?,fresh,fits]\\n  · simp [extend?,fresh]\\n\\ndef bestCached (prior : Selection p) : Option (Proposal prior) :=\\n  let cached := evaluation prior\\n  (List.finRange p.offers.size).foldl (fun found index =>\\n    match proposalCached? prior cached index,found with\\n    | none,_ => found\\n    | some next,none => some next\\n    | some next,some previous => if better next previous then some next else found) none\\n\\n@[csimp] theorem best_cached_compiled : @best = @bestCached := by\\n  funext p prior\\n  simp only [best,bestCached,proposalCached_exact]\\n\\n\\ndef fill (fuel : Nat) (prior : Selection p) : Selection p :=\\n  match fuel with\\n  | 0 => prior\\n  | fuel+1 => match best prior with\\n    | none => prior\\n    | some next => fill fuel next.result\\n\\n/-- Keep the first selection on equal benefit. Costs and dependency closure\\nremain certified by Selection; this makes no approximation-ratio claim. -/\\ndef prefer (first second : Selection p) : Selection p :=\\n  if benefit p first.selected < benefit p second.selected then second else first\\n\\ntheorem prefer_first (first second : Selection p) :\\n    benefit p first.selected ≤ benefit p (prefer first second).selected := by\\n  unfold prefer\\n  split <;> omega\\n\\ntheorem prefer_second (first second : Selection p) :\\n    benefit p second.selected ≤ benefit p (prefer first second).selected := by\\n  unfold prefer\\n  split <;> omega\\n\\ndef singletonScan (initial best : Selection p)\\n    (pending : List (Fin p.offers.size)) : Selection p :=\\n  match pending with\\n  | [] => best\\n  | index :: tail => singletonScan initial\\n      (match extend? initial index with\\n       | none => best\\n       | some one => prefer best one) tail\\n\\ntheorem singletonScan_keeps (initial best : Selection p)\\n    (pending : List (Fin p.offers.size)) :\\n    benefit p best.selected ≤ benefit p (singletonScan initial best pending).selected := by\\n  induction pending generalizing best with\\n  | nil => exact Nat.le_refl _\\n  | cons index tail ih =>\\n    simp only [singletonScan]\\n    cases extension : extend? initial index with\\n    | none => exact ih best\\n    | some one => exact Nat.le_trans (prefer_first best one) (ih _)\\n\\ntheorem singletonScan_covers (initial best : Selection p)\\n    (pending : List (Fin p.offers.size)) (index : Fin p.offers.size)\\n    (present : index ∈ pending) (one : Selection p)\\n    (created : extend? initial index = some one) :\\n    benefit p one.selected ≤ benefit p (singletonScan initial best pending).selected := by\\n  induction pending generalizing best with\\n  | nil => simp at present\\n  | cons head tail ih =>\\n    simp only [singletonScan]\\n    rcases List.mem_cons.mp present with same | later\\n    · subst head\\n      rw [created]\\n      exact Nat.le_trans (prefer_second best one) (singletonScan_keeps initial _ tail)\\n    · cases extension : extend? initial head with\\n      | none => exact ih best later\\n      | some next => exact ih (prefer best next) later\\n\\ndef bestSingleton (initial : Selection p) : Selection p :=\\n  singletonScan initial initial (List.finRange p.offers.size)\\n\\ntheorem bestSingleton_covers (initial : Selection p) (index : Fin p.offers.size)\\n    (one : Selection p) (created : extend? initial index = some one) :\\n    benefit p one.selected ≤ benefit p (bestSingleton initial).selected := by\\n  exact singletonScan_covers initial initial _ index (List.mem_finRange index) one created\\n\\ndef chooseFrom (initial : Selection p) : Selection p :=\\n  prefer (fill p.offers.size initial) (bestSingleton initial)\\n\\ntheorem chooseFrom_dominates_greedy (initial : Selection p) :\\n    benefit p (fill p.offers.size initial).selected ≤ benefit p (chooseFrom initial).selected :=\\n  prefer_first _ _\\n\\ntheorem chooseFrom_dominates_singleton (initial : Selection p)\\n    (index : Fin p.offers.size) (one : Selection p)\\n    (created : extend? initial index = some one) :\\n    benefit p one.selected ≤ benefit p (chooseFrom initial).selected :=\\n  Nat.le_trans (bestSingleton_covers initial index one created) (prefer_second _ _)\\n\\ndef choose? (p : Problem) : Option (Selection p) := do\\n  let initial ← empty? p\\n  pure (chooseFrom initial)\\n\\n\\ntheorem within_limits (result : Selection p) :\\n    (cost p result.selected).1 ≤ p.limit.1 ∧ (cost p result.selected).2 ≤ p.limit.2 :=\\n  ⟨result.charsFit,result.bytesFit⟩\\n\\ntheorem source_node_is_declared (p : Problem) (selected : List (Fin p.offers.size))\\n    (node : Fin p.costs.size) (present : node ∈ nodes p selected) :\\n    ∃ index ∈ selected, node ∈ p.offers[index].closure := by\\n  have member : node ∈ selected.flatMap (fun index => p.offers[index].closure) := by\\n    simpa [nodes] using present\\n  exact List.mem_flatMap.mp member\\n\\ntheorem selected_closure_is_complete (p : Problem) (selected : List (Fin p.offers.size))\\n    (index : Fin p.offers.size) (chosen : index ∈ selected)\\n    (node : Fin p.costs.size) (required : node ∈ p.offers[index].closure) :\\n    node ∈ nodes p selected := by\\n  simp only [nodes,List.mem_eraseDups]\\n  exact List.mem_flatMap.mpr ⟨index,chosen,required⟩\\n\\nprivate theorem erase_nodup [BEq α] [LawfulBEq α] (xs : List α) : xs.eraseDups.Nodup := by\\n  match xs with\\n  | [] => simp\\n  | x :: tail =>\\n      rw [List.eraseDups_cons,List.nodup_cons]\\n      constructor\\n      · simp\\n      · exact erase_nodup (tail.filter fun y => !y == x)\\ntermination_by xs.length\\ndecreasing_by\\n  have := List.length_filter_le (fun y => !y == x) tail\\n  simp only [List.length_cons]\\n  omega\\n\\ntheorem duplicate_payload_charged_once (p : Problem) (selected : List (Fin p.offers.size)) :\\n    (nodes p selected).Nodup := by\\n  exact erase_nodup _\\n\\ntheorem duplicate_cue_scored_once (p : Problem) (selected : List (Fin p.offers.size)) :\\n    (cues p selected).Nodup := by\\n  exact erase_nodup _\\n\\nend SharedCoverage\\n\",[]]"],["tools.SourceWindow","[\"module\\npublic import Std\\n@[expose] public section\\nnamespace SourceWindow\\n\\n/-- Scalar coordinates of the actual source intersection of one search window.\\nContext expansion belongs to the renderer and is not represented here. -/\\nstructure Slice (sourceLength : Nat) where\\n  first : Nat\\n  last : Nat\\n  ordered : first < last\\n  within : last ≤ sourceLength\\n  bounded : last-first ≤ 512\\n\\ndef project (sourceLength prefixChars index : Nat) : Option (Slice sourceLength) :=\\n  let first := index*384-prefixChars\\n  let last := min sourceLength (index*384+512-prefixChars)\\n  if ordered : first < last then\\n    some ⟨first,last,ordered,Nat.min_le_left _ _,by\\n      have upper := Nat.min_le_right sourceLength (index*384+512-prefixChars)\\n      omega⟩\\n  else none\\n\\n/-- A source character is scored exactly when its global coordinate occurs\\nin the producer's original window. A window center has no role in this test. -/\\ntheorem projected_covers_iff (sourceLength prefixChars index position : Nat) :\\n    (∃ span, project sourceLength prefixChars index = some span ∧\\n      span.first ≤ position ∧ position < span.last) ↔\\n    position < sourceLength ∧ index*384 ≤ prefixChars+position ∧\\n      prefixChars+position < index*384+512 := by\\n  unfold project\\n  dsimp only\\n  split\\n  · simp only [Option.some.injEq]\\n    constructor\\n    · rintro ⟨span,equal,first,last⟩\\n      cases equal\\n      dsimp only at first last\\n      omega\\n    · intro covered\\n      refine ⟨_,rfl,?_,?_⟩ <;> (dsimp only; omega)\\n  · constructor\\n    · rintro ⟨span,equal,_⟩\\n      cases equal\\n    · intro covered\\n      exfalso\\n      omega\\n\\nend SourceWindow\\n\",[]]"],["tools.SpanPostings","[\"module\\npublic import Std.Data.HashMap.Lemmas\\n@[expose] public section\\nnamespace Eggshell.SpanPostings\\n\\n/-- Exact original-byte coordinates index the original candidate sequence.\\nValues, order and duplicates are retained; hashing is only a directory. -/\\ndef directory (spanOf : α → Option (Nat × Nat)) (values : List α) :\\n    Std.HashMap (Nat × Nat) (List α) :=\\n  values.foldr (fun value found => match spanOf value with\\n    | none => found\\n    | some span => found.insert span (value :: found[span]?.getD [])) {}\\n\\ntheorem directory_exact (spanOf : α → Option (Nat × Nat)) (values : List α)\\n    (span : Nat × Nat) :\\n    (directory spanOf values)[span]?.getD [] = values.filter (fun value => spanOf value == some span) := by\\n  induction values with\\n  | nil => simp [directory]\\n  | cons value rest ih =>\\n    cases found : spanOf value with\\n    | none => simpa [directory,found] using ih\\n    | some actual =>\\n      by_cases same : actual = span\\n      · simpa [directory,found,same] using congrArg (List.cons value) ih\\n      · simpa [directory,found,same,Std.HashMap.getElem?_insert] using ih\\n\\nstructure Index (spanOf : α → Option (Nat × Nat)) (values : List α) where\\n  postings : Std.HashMap (Nat × Nat) (List α)\\n  exact : ∀ span, postings[span]?.getD [] = values.filter (fun value => spanOf value == some span)\\n\\ndef prepare (spanOf : α → Option (Nat × Nat)) (values : List α) : Index spanOf values :=\\n  ⟨directory spanOf values,directory_exact spanOf values⟩\\n\\nvariable {α : Type u} {spanOf : α → Option (Nat × Nat)} {values : List α}\\n\\ndef Index.lookup (index : Index spanOf values) (span : Nat × Nat) : List α :=\\n  index.postings[span]?.getD []\\n\\ntheorem Index.lookup_exact (index : Index spanOf values) (span : Nat × Nat) :\\n    index.lookup span = values.filter (fun value => spanOf value == some span) := index.exact span\\n\\nend Eggshell.SpanPostings\\n\",[]]"],["tools.WindowCentroid","[\"module\\n\\npublic import Eggshell.Blake3\\n\\n@[expose] public section\\n\\nnamespace Eggshell.WindowCentroid\\n\\n/-- Experimental scoring projection. Keep every encoded segment, but give one\\noriginal DB window one normalized vector. Weights count newly covered source\\ntokens, so a short overflow tail cannot acquire the weight of a full segment.\\nNo cache or source bytes change. Adoption requires matched token/quality trials. -/\\ndef weights (tokens capacity overlap count : Nat) : Except String (Array Nat) := do\\n  unless 0 < capacity && overlap < capacity && 0 < count && count ≤ 512 do\\n    throw \\\"invalid segment geometry\\\"\\n  let step := capacity - overlap\\n  let expected := if tokens ≤ capacity then 1 else 1 + (tokens - capacity + step - 1) / step\\n  unless count == expected do throw \\\"segment count disagrees with source token coverage\\\"\\n  if tokens == 0 then return #[1]\\n  let mut result := #[]\\n  for index in [:count] do\\n    let length := min capacity (tokens - index * step)\\n    let carried := if index == 0 then 0 else overlap\\n    unless carried < length do throw \\\"segment adds no source tokens\\\"\\n    result := result.push (length - carried)\\n  unless result.foldl (· + ·) 0 == tokens do throw \\\"source token weights are incomplete\\\"\\n  return result\\n\\ndef digit (byte : UInt8) : Except String UInt64 :=\\n  if 48 ≤ byte && byte ≤ 57 then .ok (byte - 48).toUInt64\\n  else if 97 ≤ byte && byte ≤ 102 then .ok (byte - 87).toUInt64\\n  else .error \\\"noncanonical packed vector\\\"\\n\\ndef unpack (packed : String) : Except String (Array Float) := do\\n  let bytes := packed.toUTF8\\n  unless 0 < bytes.size && bytes.size % 16 == 0 && bytes.size / 16 ≤ 4096 do\\n    throw \\\"invalid packed vector shape\\\"\\n  let mut values := #[]\\n  for word in [:bytes.size / 16] do\\n    let mut bits : UInt64 := 0\\n    for byte in [:8] do\\n      let offset := word * 16 + byte * 2\\n      let value := (← digit bytes[offset]!) * 16 + (← digit bytes[offset + 1]!)\\n      bits := bits ||| (value <<< (byte * 8).toUInt64)\\n    let value := Float.ofBits bits\\n    unless !value.isNaN && !value.isInf do throw \\\"nonfinite packed vector\\\"\\n    values := values.push value\\n  return values\\n\\ndef pack (values : Array Float) : String := Id.run do\\n  let mut bytes := ByteArray.empty\\n  for value in values do\\n    for byte in [:8] do bytes := bytes.push ((value.toBits >>> (byte * 8).toUInt64).toUInt8)\\n  return Blake3.hex bytes\\n\\ndef project (vectors : Array String) (tokens capacity overlap : Nat) : Except String String := do\\n  let counts ← weights tokens capacity overlap vectors.size\\n  let decoded ← vectors.mapM unpack\\n  let dimension := decoded[0]!.size\\n  unless decoded.all (·.size == dimension) do throw \\\"segment dimensions disagree\\\"\\n  -- A one-segment window retains its exact original numerical representation.\\n  if vectors.size == 1 then return vectors[0]!\\n  let mut sum := Array.replicate dimension (0.0 : Float)\\n  for index in [:vectors.size] do\\n    let weight := counts[index]!.toFloat\\n    for coordinate in [:dimension] do\\n      sum := sum.set! coordinate (sum[coordinate]! + weight * decoded[index]![coordinate]!)\\n  let norm := Float.sqrt (sum.foldl (fun total value => total + value * value) 0.0)\\n  unless 0.0 < norm && !norm.isInf && !norm.isNaN do throw \\\"undefined window centroid\\\"\\n  return pack (sum.map (· / norm))\\n\\nend Eggshell.WindowCentroid\\n\",[]]"],["tools.research.ArtifactHash","[\"import Eggshell.Sha256\\nimport Eggshell.FileSystem\\n\\nnamespace Eggshell.Research.ArtifactHash\\n\\nprivate def blocks (state : Array UInt32) (bytes : ByteArray) : Array UInt32 := Id.run do\\n  let mut state := state\\n  for index in [:bytes.size/64] do state := Sha256.compress state bytes (index*64)\\n  return state\\n\\nprivate def finish (state : Array UInt32) (tail : ByteArray) (total : Nat) : String := Id.run do\\n  let mut bytes := tail.push 0x80\\n  let padding := (64-((bytes.size+8)%64))%64\\n  for _ in [:padding] do bytes := bytes.push 0\\n  let bits := total.toUInt64*8\\n  for index in [:8] do bytes := bytes.push ((bits >>> ((7-index)*8).toUInt64).toUInt8)\\n  let state := blocks state bytes\\n  let mut result := ByteArray.empty\\n  for word in state do\\n    for index in [:4] do result := result.push ((word >>> ((3-index)*8).toUInt32).toUInt8)\\n  return Blake3.hex result\\n\\n/-- The same SHA-256 compression and padding as `Sha256.digest`, with only\\none native page and the final padding retained. Reads use the pinned descriptor. -/\\ndef read (handle : FileSystem.ReadHandle) (total : Nat) : IO String := do\\n  let mut state := Blake3.iv\\n  let mut offset := 0\\n  while offset+4096 ≤ total do\\n    let bytes ← FileSystem.readPage handle offset.toUInt64 ⟨4096,by decide⟩\\n    unless bytes.size == 4096 do throw (IO.userError \\\"artifact shortened during hashing\\\")\\n    state := blocks state bytes\\n    offset := offset+4096\\n  let count := min 4096 (total-offset)\\n  let tail ← if count == 0 then pure ByteArray.empty else\\n    FileSystem.readPage handle offset.toUInt64 ⟨count,Nat.min_le_left _ _⟩\\n  unless tail.size == count && offset+count == total do\\n    throw (IO.userError \\\"artifact tail changed during hashing\\\")\\n  return finish state tail total\\n\\n/-- Resolve once, read that open file in bounded pages, then recheck both the\\ndescriptor version and current path. A same-size replacement cannot pass. -/\\ndef hex (path : System.FilePath) : IO String := do\\n  let resolved ← IO.FS.realPath path\\n  let handle ← FileSystem.openRead resolved.toString\\n  let before ← FileSystem.readVersion handle\\n  let digest ← read handle before.bytes\\n  let after ← FileSystem.readVersion handle\\n  let current ← FileSystem.readVersion (← FileSystem.openRead resolved.toString)\\n  unless FileSystem.stableRead before after current before.bytes &&\\n      (← IO.FS.realPath path) == resolved do\\n    throw (IO.userError s!\\\"artifact changed while inspecting {path}\\\")\\n  return digest\\n\\nend Eggshell.Research.ArtifactHash\\n\",[]]"],["tools.research.NativeTrialAudit","[\"import Eggshell.SynapseBuild\\nimport Eggshell.SynapseUsage\\nimport Eggshell.ContentMetadata\\nimport tools.research.ArtifactHash\\nimport tools.research.RequiredDelivery\\nimport tools.research.OriginalEvidence\\nimport Eggshell.Worker\\n\\nopen Lean Eggshell Eggshell.Synapses\\n\\nnamespace Eggshell.Research.NativeTrialAudit\\n\\nprivate abbrev Requirement := OriginalEvidence.Reference\\n\\nprivate structure Source where\\n  source : String\\n  workspace : String\\n  prompt : String\\n  files : Array (String × String)\\n  required : Array Requirement\\n  deriving FromJson\\n\\nprivate structure Trial where\\n  source : Source\\n  database : String\\n  request : String\\n  stdout : String\\n  timing : String\\n  body : String\\n  deriving FromJson\\n\\nprivate def check (condition : Bool) (message : String) : IO Unit :=\\n  unless condition do throw (IO.userError message)\\n\\nprivate def readJson (path : String) : IO Json := do\\n  IO.ofExcept (Json.parse (← IO.FS.readFile (.mk path)))\\n\\nprivate def originals (source : DB.PageMap.Snapshot) (workspace : System.FilePath) :\\n    IO (Array Extraction.Document × Array Read) := do\\n  let reader ← Persistence.Store.NodeReader.new source\\n  let mut documents := #[]\\n  let mut rows := #[]\\n  let mut images : Std.HashMap File OriginalEvidence.Image := {}\\n  -- Discover original owners from this publication, including newly accumulated\\n  -- observations. Human reference requirements never choose the source owners.\\n  for entry in ← Build.entries source do\\n    let mut doc ← Build.document reader entry.id\\n    if let some captured ← ContentMetadata.load? source entry.id doc then\\n      let catalog ← IO.ofExcept (ContentMetadata.catalog source.head.identity doc captured)\\n      let characters := doc.source.getD \\\"\\\" |>.toList.toArray\\n      -- The product's saved coordinates are not the oracle. Re-read and hash\\n      -- the reference image, then compare the actual original slice with its\\n      -- claimed file line independently of the capture matcher.\\n      for located in catalog.located do\\n        let row := located.read\\n        let some file := row.source.file? | throw (IO.userError \\\"file alias has no file\\\")\\n        let image ← match images[file]? with\\n          | some image => pure image\\n          | none => do\\n              let image ← OriginalEvidence.load workspace file\\n              images := images.insert file image\\n              pure image\\n        let lines := (image.text.splitOn \\\"\\\\n\\\").toArray\\n        let some expected := lines[row.source.first-1]? | throw (IO.userError \\\"file alias exceeds reference image\\\")\\n        let original := String.ofList (characters.extract row.binding.first row.binding.limit).toList\\n        let decoded := (Json.parse (\\\"\\\\\\\"\\\" ++ original ++ \\\"\\\\\\\"\\\") >>= Json.getStr?).toOption\\n        check (row.source.first == row.source.last && (original == expected || decoded == some expected))\\n          \\\"saved file alias differs from independent reference bytes\\\"\\n        rows := rows.push row\\n      let files := captured.inputs.filterMap fun input => input.content.map fun content =>\\n        (⟨input.relative,content.root,content.bytes⟩ : File)\\n      doc := {doc with files := (hashDistinct (doc.files.toList ++ files.toList)).toArray}\\n    documents := documents.push doc\\n    if let .ok found := Extraction.recordedRows source.head.identity doc then rows := rows ++ found\\n  return (documents,rows)\\n\\ndef inspect (input : String) : IO Json := do\\n  let bytes ← IO.FS.readBinFile (.mk input)\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"trial input encoding\\\")\\n  let trial ← IO.ofExcept (Json.parse text >>= fromJson? (α := Trial))\\n  let specification := trial.source\\n  for requirement in specification.required do\\n    check (!requirement.path.isEmpty && 0 < requirement.first && requirement.first ≤ requirement.last)\\n      \\\"invalid reference source range\\\"\\n  for (name,expected) in specification.files do\\n    check ((← ArtifactHash.hex (System.FilePath.mk specification.source / name)) == expected)\\n      \\\"immutable source bytes changed\\\"\\n  let before ← DB.PageMap.pin (.mk specification.source)\\n  let (documents,fileRows) ← originals before (.mk specification.workspace)\\n  let resolved ← OriginalEvidence.resolve (.mk specification.workspace) before.head.identity\\n    documents fileRows specification.required\\n  let rows := resolved.reads\\n  let alternatives : Array (String × Array Read × Array Range) := resolved.requirements.map fun item =>\\n    let candidates := rows.filter fun row => item.alternatives.any fun target =>\\n      target.subject == row.source.subject && row.source.first ≤ target.last && target.first ≤ row.source.last\\n    (item.name,candidates,item.alternatives)\\n  -- The denominator is determined from the immutable source before inspecting\\n  -- delivery bytes. A later failed candidate cannot shrink it.\\n  let frozen ← IO.ofExcept (RequiredDelivery.freeze (alternatives.map fun (name,_,targets) =>\\n    ⟨name,targets⟩) (rows.map (·.source)))\\n  let request ← readJson trial.request\\n  check ((request.getObjValAs? String \\\"hook_event_name\\\").toOption == some \\\"UserPromptSubmit\\\" &&\\n    (request.getObjValAs? String \\\"prompt\\\").toOption == some specification.prompt &&\\n    (request.getObjValAs? String \\\"cwd\\\").toOption == some specification.workspace) \\\"wrong preflight question or workspace\\\"\\n  let stdout ← IO.FS.readFile (.mk trial.stdout)\\n  let timing ← readJson trial.timing\\n  check ((timing.getObjValAs? Nat \\\"exitCode\\\").toOption == some 0 &&\\n    (timing.getObjValAs? Float \\\"elapsedMs\\\").toOption.any (fun ms => 0 < ms && ms < 30000) &&\\n    (timing.getObjValAs? String \\\"stdoutSha256\\\").toOption == some (Sha256.hex stdout.toUTF8))\\n    \\\"native preflight failed, expired or has different stdout\\\"\\n  let reply ← IO.ofExcept (Json.parse stdout)\\n  check reply.getObj?.isOk \\\"native hook returned a non-object reply\\\"\\n  let body := (reply.getObjVal? \\\"hookSpecificOutput\\\" >>= (·.getObjValAs? String \\\"additionalContext\\\")).toOption.getD \\\"\\\"\\n  check (body == (← IO.FS.readFile (.mk trial.body))) \\\"saved body differs from actual stdout\\\"\\n  let after ← DB.PageMap.pin (.mk trial.database)\\n  let same ← Index.sameSources after before.head (after.head.revision-before.head.revision+1)\\n  let original ← IO.FS.readBinFile (DB.PageMap.dataPath before.directory before.head)\\n  let current ← IO.FS.readBinFile (DB.PageMap.dataPath after.directory after.head)\\n  let prefixExact := original.extract 0 before.head.bytes == current.extract 0 before.head.bytes\\n  check (same && prefixExact) \\\"preparation changed original source facts or pages\\\"\\n  let shown := Extraction.presented body documents rows\\n  let requirements := alternatives.map fun (name,candidates,targets) =>\\n    let stored := targets.any (fun target => covered target (candidates.map (fun (row : Read) => row.source)))\\n    let delivered := targets.any (fun target => covered target shown.ranges)\\n    Json.mkObj [(\\\"name\\\",toJson name),(\\\"stored\\\",toJson stored),\\n      (\\\"storedOwners\\\",toJson ((candidates.map (fun (row : Read) => row.binding.owner)).toList.eraseDups.toArray)),\\n      (\\\"bodyDelivered\\\",toJson delivered),(\\\"unlocated\\\",toJson (!stored))]\\n  return Json.mkObj [(\\\"specSha256\\\",toJson (Sha256.hex bytes)),\\n    (\\\"sourceGraphFiles\\\",Json.mkObj (specification.files.toList.map fun (name,digest) => (name,toJson digest))),\\n    (\\\"sameSourceFacts\\\",toJson same),(\\\"samePublishedPagePrefix\\\",toJson prefixExact),\\n    (\\\"originalDocuments\\\",toJson documents.size),(\\\"originalRows\\\",toJson fileRows.size),\\n    (\\\"originalOutputBindings\\\",toJson resolved.bindings),\\n    (\\\"stdoutSha256\\\",toJson (Sha256.hex stdout.toUTF8)),(\\\"bodySha256\\\",toJson (Sha256.hex body.toUTF8)),\\n    (\\\"frozenEvidence\\\",toJson frozen),(\\\"requiredDelivery\\\",toJson (RequiredDelivery.assess frozen shown.ranges)),\\n    (\\\"requirements\\\",toJson requirements)]\\n\\n/-- Body coverage from an explicitly unbounded worker diagnostic is distinct\\nfrom timely hook delivery. It cannot satisfy the native preflight gate. -/\\ndef inspectWorker (input : String) : IO Json := do\\n  let bytes ← IO.FS.readBinFile (.mk input)\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"worker audit encoding\\\")\\n  let trial ← IO.ofExcept (Json.parse text >>= fromJson? (α := Trial))\\n  let specification := trial.source\\n  for (name,expected) in specification.files do\\n    check ((← ArtifactHash.hex (.mk specification.source / name)) == expected) \\\"worker source bytes changed\\\"\\n  let before ← DB.PageMap.pin (.mk specification.source)\\n  let request ← IO.ofExcept ((← readJson trial.request) |> fromJson? (α := Plugin.Worker.Search))\\n  check (request.pending.prompt == specification.prompt && request.work == specification.prompt &&\\n    request.pending.cwd == specification.workspace && !request.enforce && request.evidence.isNone)\\n    \\\"worker diagnostic differs from the frozen question\\\"\\n  let stdout ← IO.FS.readFile (.mk trial.stdout)\\n  let timing ← readJson trial.timing\\n  check ((timing.getObjValAs? Nat \\\"exitCode\\\").toOption == some 0 &&\\n    (timing.getObjValAs? String \\\"stdoutSha256\\\").toOption == some (Sha256.hex stdout.toUTF8)) \\\"worker reply differs\\\"\\n  let some last := (stdout.splitOn \\\"\\\\n\\\" |>.filter (!·.isEmpty)).getLast? |\\n    throw (IO.userError \\\"worker diagnostic has no frame\\\")\\n  let frame ← IO.ofExcept (Json.parse last >>= fromJson? (α := Plugin.Worker.SearchFrame))\\n  let .reply identity handoff := frame | throw (IO.userError \\\"worker diagnostic has only progress\\\")\\n  check (identity == request.identity) \\\"worker reply identity differs\\\"\\n  let (documents,fileRows) ← originals before (.mk specification.workspace)\\n  let resolved ← OriginalEvidence.resolve (.mk specification.workspace) before.head.identity\\n    documents fileRows specification.required\\n  let frozen ← IO.ofExcept (RequiredDelivery.freeze (resolved.requirements.map fun item =>\\n    ⟨item.name,item.alternatives⟩) (resolved.reads.map (·.source)))\\n  let after ← DB.PageMap.pin (.mk trial.database)\\n  check (after.head == before.head) \\\"worker diagnostic changed the source publication\\\"\\n  let body := handoff.map (·.text) |>.getD \\\"\\\"\\n  let shown := Extraction.presented body documents resolved.reads\\n  return Json.mkObj [(\\\"diagnosticOnly\\\",toJson true),(\\\"actualHook\\\",toJson false),\\n    (\\\"latencyAcceptance\\\",toJson false),(\\\"productionAdoption\\\",toJson false),\\n    (\\\"specSha256\\\",toJson (Sha256.hex bytes)),(\\\"stdoutSha256\\\",toJson (Sha256.hex stdout.toUTF8)),\\n    (\\\"bodySha256\\\",toJson (Sha256.hex body.toUTF8)),(\\\"bodyChars\\\",toJson body.length),\\n    (\\\"elapsedMs\\\",timing.getObjValD \\\"elapsedMs\\\"),(\\\"frozenEvidence\\\",toJson frozen),\\n    (\\\"coverageWithoutDeadline\\\",toJson (RequiredDelivery.assess frozen shown.ranges))]\\n\\n/-- Source extraction and literal code/fingerprint comparison stay in Lean.\\nThe orchestrator can seal the report, then replay it without trusting labels. -/\\ndef cliMain (args : List String) : IO Unit := do\\n  let [mode,input,output] := args | throw (IO.userError \\\"NativeTrialAudit emit|check INPUT REPORT\\\")\\n  let report ← inspect input\\n  if mode == \\\"emit\\\" then\\n    check (!(← (System.FilePath.mk output).pathExists)) \\\"keep the existing native audit\\\"\\n    IO.FS.writeFile (.mk output) (report.compress ++ \\\"\\\\n\\\")\\n  else if mode == \\\"check\\\" then\\n    check (report == (← readJson output)) \\\"sealed native evidence report differs from replay\\\"\\n  else throw (IO.userError \\\"expected emit or check\\\")\\n  IO.println s!\\\"native evidence audit {mode} completed\\\"\\n\\nend Eggshell.Research.NativeTrialAudit\\n\",[]]"],["tools.research.OnePreparedHook","[\"import tools.research.StudySeedChecks\\nimport Eggshell.Install\\nimport Eggshell.WindowOwners\\nopen Lean Eggshell Eggshell.Research\\n\\nprivate def check (condition : Bool) (message : String) : IO Unit :=\\n  unless condition do throw (IO.userError message)\\nprivate def read (path : System.FilePath) : IO Json :=\\n  IO.FS.readFile path >>= fun text => IO.ofExcept (Json.parse text)\\n\\nprivate def checkReadScope : IO Unit := do\\n  let seen ← IO.mkRef (#[] : Array DB.Sidecar.Storage)\\n  let primary ← Synapses.Recommend.readablePrepared? (α := Nat) fun storage => do\\n    seen.modify (·.push storage)\\n    pure (some (if storage == .database then 7 else 99))\\n  check (primary == some 7 && (← seen.get) == #[.database]) \\\"a ready shared view was not reused directly\\\"\\n  seen.set #[]\\n  let fallback ← Synapses.Recommend.readablePrepared? (α := Nat) fun storage => do\\n    seen.modify (·.push storage)\\n    if storage == .database then throw (.permissionDenied none 13 \\\"fixture\\\")\\n    pure (some 11)\\n  check (fallback == some 11 && (← seen.get) == #[.database,.user]) \\\"unreadable shared view prevented private reuse\\\"\\n  seen.set #[]\\n  let corruptAccepted ← try\\n    let _ ← Synapses.Recommend.readablePrepared? (α := Nat) fun storage => do\\n      seen.modify (·.push storage)\\n      if storage == .database then throw (IO.userError \\\"fixture corruption\\\")\\n      pure (some 11)\\n    pure true\\n    catch _ => pure false\\n  check (!corruptAccepted && (← seen.get) == #[.database]) \\\"corrupt shared data was silently treated as a miss\\\"\\n\\n/-- Exactly one old-snapshot diagnostic. Reuse numerical/lexical preparation;\\nrebuild only the changed synaptic and original-source views, before the hook.\\nNo answering model, all-topic retry, or foreground repair. -/\\ndef main (args : List String) : IO Unit := do\\n  checkReadScope\\n  let (candidate,output,prepared,captureRanges) ← match args with\\n    | [candidate,output] => pure (candidate,output,none,false)\\n    | [candidate,output,prepared] => pure (candidate,output,some (System.FilePath.mk prepared),false)\\n    | [candidate,output,prepared,\\\"ranges\\\"] => pure (candidate,output,some (System.FilePath.mk prepared),true)\\n    | _ => throw (IO.userError \\\"candidate and new output directory; optional prepared checkpoint\\\")\\n  let root := System.FilePath.mk output\\n  check (!(← root.pathExists)) \\\"keep previous actual hook\\\"\\n  IO.FS.createDirAll root\\n  let study := System.FilePath.mk \\\"/Users/ovm/.codex/experiments/eggshell/study-services-20261026\\\"\\n  let old := System.FilePath.mk \\\"/Users/ovm/.codex/experiments/eggshell/literal-support-20261026/required-replay/topic-1\\\"\\n  let database := (prepared.getD root) / \\\"work.egg\\\"\\n  if prepared.isNone then\\n    let copied ← IO.Process.output {cmd := \\\"/bin/cp\\\",args := #[\\\"-cR\\\",(old / \\\"work.egg\\\").toString,database.toString]}\\n    check (copied.exitCode == 0) \\\"could not share prepared checkpoint extents\\\"\\n  let original ← DB.PageMap.pin database\\n  check (original.head.identity == \\\"76352b67a9c35002bff67dc3d3c3a01b7bd194e43e09f5f54714dde75df5a8de\\\" &&\\n    original.head.revision == 31 && original.head.bytes == 45216846) \\\"wrong fixed source\\\"\\n  let sourceFiles ← StudyRuntime.files database\\n  let data := root / \\\"data\\\"\\n  IO.FS.createDir data\\n  let shared ← IO.Process.output {cmd := \\\"/bin/cp\\\",args := #[\\\"-cR\\\",(old / \\\"data/read-cache\\\").toString,(data / \\\"read-cache\\\").toString]}\\n  check (shared.exitCode == 0) \\\"could not reuse private read preparation\\\"\\n  let frozen ← read (study / \\\"seed-1-complete-audit.json\\\")\\n  let availability ← IO.ofExcept (frozen.getObjValAs? (Array Json) \\\"availability\\\")\\n  let some required := availability.find? (fun row => (row.getObjValAs? Nat \\\"topic\\\").toOption == some 2) |\\n    throw (IO.userError \\\"missing frozen topic\\\")\\n  IO.FS.writeFile (root / \\\"frozen-before-delivery.json\\\") required.pretty\\n  let started ← IO.monoMsNow\\n  let synapses ← Synapses.Build.refresh original .database\\n  let canonical ← Synapses.CanonicalSource.Cache.refresh original .database\\n  let owners ← WindowOwners.refresh original .database\\n  IO.FS.writeFile (root / \\\"changed-views.json\\\") (Json.mkObj [(\\\"synaptic\\\",toJson synapses),\\n    (\\\"canonical\\\",toJson canonical),(\\\"windowOwners\\\",toJson owners),(\\\"elapsedMs\\\",toJson ((← IO.monoMsNow)-started)),\\n    (\\\"fullWarmCalls\\\",toJson (0 : Nat)),(\\\"numericalLexicalPreparationReused\\\",toJson true)]).pretty\\n  check ((← Synapses.Index.openShared? original).isSome && (← Synapses.CanonicalSource.Cache.ready original))\\n    \\\"changed views did not become ready\\\"\\n  check ((← WindowOwners.openShared? original).isSome) \\\"numerical window-owner view is not ready\\\"\\n  let installRoot := root / \\\"prefix\\\"\\n  let binary := installRoot / \\\"libexec/eggshell\\\"\\n  IO.FS.createDirAll binary.parent.get!\\n  let copied ← IO.Process.output {cmd := \\\"/bin/cp\\\",args := #[\\\"-c\\\",candidate ++ \\\"/product-build/StudyMain\\\",binary.toString]}\\n  check (copied.exitCode == 0) \\\"could not select fixed product\\\"\\n  let runtimeSha ← ArtifactHash.hex binary\\n  let plugin := installRoot / \\\"share/eggshell/codex-plugin\\\"\\n  let launcher := plugin / \\\"bin/eggshelld\\\"\\n  IO.FS.createDirAll launcher.parent.get!\\n  IO.FS.writeFile launcher (Install.pluginLauncher installRoot)\\n  IO.setAccessRights launcher {\\n    user := {read := true,write := true,execution := true}\\n    group := {read := true,execution := true}\\n    other := {read := true,execution := true}}\\n  let linked ← IO.Process.output {cmd := \\\"/bin/ln\\\",args := #[\\\"-s\\\",\\n    \\\"/Users/ovm/.codex/experiments/eggshell/numerical-owned-20261024/prefix/share/eggshell/minilm\\\",\\n    (installRoot / \\\"share/eggshell/minilm\\\").toString]}\\n  check (linked.exitCode == 0) \\\"could not select existing MiniLM boundary\\\"\\n  let config := root / \\\"config.toml\\\"\\n  IO.FS.writeFile config (\\\"default = \\\\\\\"work\\\\\\\"\\\\nsemantic_matcher = \\\" ++\\n    (toJson #[binary.toString,\\\"search-provider\\\"]).compress ++ \\\"\\\\n[eggs]\\\\nwork = \\\" ++\\n    (toJson database.toString).compress ++ \\\"\\\\n[profiles.work]\\\\nread = [\\\\\\\"work\\\\\\\"]\\\\nhandoff_chars = 120000\\\\n\\\")\\n  let workspace := \\\"/Users/ovm/Code/eggshell-benchmarks/aamas-2027/sources/llvm-project\\\"\\n  let environment := #[\\n    (\\\"EGGSHELL_PREFIX\\\",some installRoot.toString),(\\\"EGGSHELL_DATA_ROOT\\\",some data.toString),\\n    (\\\"EGGSHELL_CONFIG\\\",some config.toString),(\\\"EGGSHELL_PROFILE\\\",some \\\"work\\\"),\\n    (\\\"EGGSHELL_HANDOFF_TRACE\\\",some (root / \\\"handoff-trace.txt\\\").toString),\\n    (\\\"EGGSHELL_TRACE_SELECTION_RANGES\\\",if captureRanges then some \\\"1\\\" else none),\\n    (\\\"PLUGIN_ROOT\\\",some plugin.toString),(\\\"CODEX_THREAD_ID\\\",none),(\\\"CODEX_TURN_ID\\\",none),\\n    (\\\"LEAN_NUM_THREADS\\\",some \\\"1\\\"),(\\\"OMP_NUM_THREADS\\\",some \\\"1\\\"),(\\\"OPENBLAS_NUM_THREADS\\\",some \\\"1\\\"),\\n    (\\\"MKL_NUM_THREADS\\\",some \\\"1\\\"),(\\\"HF_HUB_OFFLINE\\\",some \\\"1\\\"),(\\\"TOKENIZERS_PARALLELISM\\\",some \\\"false\\\")]\\n  let definitions ← IO.ofExcept (Json.parse (← IO.FS.readFile (study / \\\"task-definitions.json\\\")) >>= Json.getArr?)\\n  let some definition := definitions.find? (fun row => (row.getObjValAs? Nat \\\"topic\\\").toOption == some 2) |\\n    throw (IO.userError \\\"missing fixed question\\\")\\n  let prompt ← IO.FS.readFile (.mk (← IO.ofExcept ((definition.getObjValD \\\"prompt\\\").getObjValAs? String \\\"path\\\")))\\n  check (Sha256.hex prompt.toUTF8 == (← IO.ofExcept ((definition.getObjValD \\\"prompt\\\").getObjValAs? String \\\"sha256\\\")))\\n    \\\"fixed question changed\\\"\\n  let publisher ← StudyRuntime.startPublisher binary data environment\\n  try\\n    let session := \\\"packet-ledger-one-native-hook\\\"\\n    let managed ← StudyRuntime.startManaged binary plugin session (data / \\\"sessions\\\" / session / \\\"daemon.json\\\") environment\\n    try\\n      let request := Json.mkObj [(\\\"hook_event_name\\\",toJson \\\"UserPromptSubmit\\\"),(\\\"session_id\\\",toJson session),\\n        (\\\"turn_id\\\",toJson \\\"source-turn\\\"),(\\\"cwd\\\",toJson workspace),(\\\"prompt\\\",toJson prompt),\\n        (\\\"_eggshell_config\\\",toJson config.toString)]\\n      let output ← StudyCommand.run binary.toString #[\\\"codex-hook\\\"] environment workspace (request.compress ++ \\\"\\\\n\\\") (root / \\\"hook\\\") 35000\\n      let reply ← IO.ofExcept (Json.parse output.stdout)\\n      let body := ((reply.getObjValD \\\"hookSpecificOutput\\\").getObjValAs? String \\\"additionalContext\\\").toOption.getD \\\"\\\"\\n      IO.FS.writeFile (root / \\\"body.txt\\\") body\\n      let specification := Json.mkObj [(\\\"source\\\",toJson database.toString),(\\\"workspace\\\",toJson workspace),\\n        (\\\"prompt\\\",toJson prompt),(\\\"files\\\",toJson sourceFiles),(\\\"required\\\",definition.getObjValD \\\"referenceRanges\\\")]\\n      let auditInput := Json.mkObj [(\\\"source\\\",specification),(\\\"database\\\",toJson database.toString),\\n        (\\\"request\\\",toJson (root / \\\"hook/stdin\\\").toString),(\\\"stdout\\\",toJson (root / \\\"hook/stdout\\\").toString),\\n        (\\\"timing\\\",toJson (root / \\\"hook/record.json\\\").toString),(\\\"body\\\",toJson (root / \\\"body.txt\\\").toString)]\\n      IO.FS.writeFile (root / \\\"audit-input.json\\\") auditInput.pretty\\n      let audit ← NativeTrialAudit.inspect (root / \\\"audit-input.json\\\").toString\\n      check (audit.getObjValD \\\"frozenEvidence\\\" == required.getObjValD \\\"frozenEvidence\\\") \\\"frozen denominator changed\\\"\\n      IO.FS.writeFile (root / \\\"audit.json\\\") audit.pretty\\n      IO.FS.writeFile (root / \\\"result.json\\\") (Json.mkObj [(\\\"actualHook\\\",toJson true),\\n        (\\\"elapsedMs\\\",toJson output.elapsedMs),(\\\"exitCode\\\",toJson output.exitCode),\\n        (\\\"runtimeSha256\\\",toJson runtimeSha),(\\\"bodyBytes\\\",toJson body.utf8ByteSize),\\n        (\\\"requiredDelivery\\\",audit.getObjValD \\\"requiredDelivery\\\"),(\\\"modelCalls\\\",toJson (0 : Nat)),\\n        (\\\"newSeedStudy\\\",toJson false),(\\\"adopted\\\",toJson false)]).pretty\\n    finally StudyRuntime.stopManaged managed (root / \\\"shutdown.json\\\")\\n  finally StudyRuntime.stopManaged publisher (root / \\\"publisher-shutdown.json\\\")\\n  check ((← DB.PageMap.pin database).head == original.head) \\\"read-only hook changed the source\\\"\\n\",[]]"],["tools.research.OriginalEvidence","[\"import Eggshell.ObservationContext\\nimport tools.research.RequiredDelivery\\n\\nopen Lean Eggshell Eggshell.Synapses Eggshell.Synapses.Extraction\\n\\nnamespace Eggshell.Research.OriginalEvidence\\n\\nstructure Reference where\\n  name : String\\n  path : String\\n  first : Nat\\n  last : Nat\\n  deriving FromJson, ToJson\\n\\ndef fingerprint (bytes : ByteArray) : String := Id.run do\\n  let mut root := Blake3.digest \\\"eggshell.source.file\\\".toUTF8 [Blake3.u64le bytes.size]\\n  for page in [:((bytes.size+4095)/4096)] do\\n    root := SourceEvidence.pageRoot root (bytes.extract (page*4096) (min bytes.size ((page+1)*4096)))\\n  return Blake3.hex root\\n\\n/-- Only exact bytes of a saved dependency may supply reference code. This is\\nan audit input, never input to the recommender or an authority certificate. -/\\nstructure Image where\\n  private mk ::\\n  file : File\\n  text : String\\n  validFile : file.valid = true\\n  bytesExact : text.toUTF8.size = file.bytes\\n  hashExact : fingerprint text.toUTF8 = file.fingerprint\\n\\ndef image? (file : File) (bytes : ByteArray) : Option Image := do\\n  let text ← String.fromUTF8? bytes\\n  if valid : file.valid = true then\\n    if size : text.toUTF8.size = file.bytes then\\n      if hash : fingerprint text.toUTF8 = file.fingerprint then\\n        some ⟨file,text,valid,size,hash⟩\\n      else none\\n    else none\\n  else none\\n\\ndef load (workspace : System.FilePath) (file : File) : IO Image := do\\n  unless file.valid do throw (IO.userError \\\"invalid reference dependency\\\")\\n  let bytes ← FileSystem.boundedBytes (workspace / file.relative) (16*1024*1024)\\n  let some image := image? file bytes |\\n    throw (IO.userError s!\\\"reference source fingerprint differs: {file.relative}\\\")\\n  return image\\n\\ndef normalized (line : TextLine) : String := (numbered line.text).map (·.2) |>.getD line.text\\n\\n/-- A literal match binds the real original-output interval. It makes no claim\\nthat a shell command has certified file coordinates or that Work is reusable. -/\\nstructure Witness (doc : Document) (image : Image) (expected : Array String) where\\n  read : Read\\n  native : doc.native = true\\n  dependency : doc.files.contains image.file = true\\n  raw : String\\n  original : doc.source = some raw\\n  observed : Array String\\n  literal : observed = expected\\n  source : read.source.subject = .original (ObservationContext.originalSubject doc.work raw)\\n  owner : read.binding.owner = doc.owner\\n  work : read.binding.work = doc.work\\n  valid : read.valid = true\\n\\ntheorem Witness.original_output (witness : Witness doc image expected) :\\n    ∃ original, witness.read.source.subject = .original original :=\\n  ⟨_,witness.source⟩\\n\\ntheorem Witness.exact_reference (witness : Witness doc image expected) :\\n    witness.observed = expected := witness.literal\\n\\ndef locate (database : String) (doc : Document) (image : Image)\\n    (expected : Array String) : Array (Witness doc image expected) := Id.run do\\n  if expected.isEmpty || !expected.any (fun line => !line.trimAscii.isEmpty) then return #[]\\n  if native : doc.native = true then\\n    if dependency : doc.files.contains image.file = true then\\n      let some prepared := ObservationContext.prepare? doc | return #[]\\n      let some occurrence := doc.occurrences[0]? | return #[]\\n      let mut found : Array (Witness doc image expected) := #[]\\n      let mut views := #[(prepared.lines,prepared.view.offsets)]\\n      if let some index := prepared.json then\\n        for leaf in index.leaves do\\n          if let some text := leaf.scalar.text then\\n            views := views.push (textLines text,leaf.scalar.offsets)\\n      for (lines,offsets) in views do\\n        for start in [:lines.size] do\\n          if start+expected.size > lines.size then break\\n          let observed := (lines.extract start (start+expected.size)).map normalized\\n          if literal : observed = expected then\\n            let some firstLine := lines[start]? | continue\\n            let some lastLine := lines[start+expected.size-1]? | continue\\n            let some first := offsets[firstLine.first]? | continue\\n            let some limit := offsets[lastLine.limit]? | continue\\n            if !(first < limit && limit ≤ prepared.raw.length) then continue\\n            if found.any (fun prior => prior.read.binding.first == first && prior.read.binding.limit == limit) then continue\\n            let read : Read := {\\n              occurrence := occurrence\\n              source := Range.original prepared.identity first limit\\n              binding := ⟨database,doc.owner,doc.work,first,limit⟩ }\\n            if valid : read.valid = true then\\n              found := found.push {\\n                read := read\\n                native := native\\n                dependency := dependency\\n                raw := prepared.raw\\n                original := prepared.original\\n                observed := observed\\n                literal := literal\\n                source := by simp only [read,Range.original]; rw [prepared.identityExact]\\n                owner := rfl\\n                work := rfl\\n                valid := valid }\\n      return found\\n    else return #[]\\n  else return #[]\\n\\nstructure Resolved where\\n  reads : Array Read\\n  requirements : Array RequiredDelivery.Requirement\\n  bindings : Array Json\\n\\n/-- Resolve all alternatives before opening a handoff. Unknown command syntax\\ncannot remove literal DB evidence from the denominator. No source bytes are\\ncopied into a candidate, DB, index or delivery packet by this function. -/\\ndef resolve (workspace : System.FilePath) (database : String)\\n    (docs : Array Document) (rows : Array Read) (required : Array Reference) : IO Resolved := do\\n  let mut images : Std.HashMap File Image := {}\\n  let mut result : Resolved := ⟨rows,#[],#[]⟩\\n  for item in required do\\n    unless safeRelative item.path && 0 < item.first && item.first ≤ item.last do\\n      throw (IO.userError \\\"invalid original reference range\\\")\\n    let files := rows.foldl (fun files row => match row.source.file? with\\n      | some file => if file.relative == item.path then files.insert file else files\\n      | none => files) ({} : Std.HashSet File)\\n    let mut alternatives := files.toArray.map (fun file => Range.mk (.file file) item.first item.last)\\n    for doc in docs do\\n      if !doc.native then continue\\n      for file in doc.files do\\n        if file.relative != item.path then continue\\n        let image ← match images[file]? with\\n          | some image => pure image\\n          | none => do\\n            let image ← load workspace file\\n            images := images.insert file image\\n            pure image\\n        let lines := (image.text.splitOn \\\"\\\\n\\\").toArray\\n        unless item.last ≤ lines.size do throw (IO.userError \\\"reference extends beyond source file\\\")\\n        let expected := lines.extract (item.first-1) item.last\\n        for witness in locate database doc image expected do\\n          result := {result with\\n            reads := result.reads.push witness.read\\n            bindings := result.bindings.push (Json.mkObj [(\\\"name\\\",toJson item.name),\\n              (\\\"file\\\",toJson file),(\\\"read\\\",toJson witness.read),\\n              (\\\"referenceFirst\\\",toJson item.first),(\\\"referenceLast\\\",toJson item.last)])}\\n          alternatives := alternatives.push witness.read.source\\n    result := {result with requirements := result.requirements.push ⟨item.name,alternatives⟩}\\n  return result\\n\\nend Eggshell.Research.OriginalEvidence\\n\",[]]"],["tools.research.RequiredDelivery","[\"import Eggshell.SynapseUsage\\n\\nopen Lean Eggshell.Synapses\\n\\nnamespace Eggshell.Research.RequiredDelivery\\n\\n/-- Alternatives are fixed before delivery. Each names a complete immutable\\nfile range or original-output range; a path or a summary is not an alternative. -/\\nstructure Requirement where\\n  name : String\\n  alternatives : Array Range\\n  deriving ToJson, FromJson\\n\\nstructure EvidenceUnit where\\n  names : Array String\\n  alternatives : Array Range\\n  deriving ToJson, FromJson\\n\\nstructure Frozen where\\n  units : Array EvidenceUnit\\n  initiallyUnavailable : Array String\\n  deriving ToJson, FromJson\\n\\nprivate def spelling (ranges : Array Range) : String := (toJson ranges).compress\\n\\nprivate def canonical (ranges : Array Range) : Array Range :=\\n  (ranges.toList.eraseDups.toArray).qsort (fun a b => (toJson a).compress < (toJson b).compress)\\n\\nprivate def overlaps (a b : Range) : Bool :=\\n  a.subject == b.subject && a.first ≤ b.last && b.first ≤ a.last\\n\\n/-- Only verified DB ranges may populate `available`. The snapshot, identities\\nand frozen result are sealed by the IO auditor before a handoff is inspected.\\nIdentical evidence cannot inflate the denominator under different labels.\\nOverlapping distinct units require an explicit partition before freezing. -/\\ndef freeze (required : Array Requirement) (available : Array Range) : Except String Frozen := do\\n  unless available.all (·.valid) do throw \\\"invalid DB evidence range\\\"\\n  let mut units : Array EvidenceUnit := #[]\\n  let mut absent := #[]\\n  let mut names : Std.HashSet String := {}\\n  for item in required do\\n    unless !item.name.trimAscii.isEmpty && !names.contains item.name &&\\n        item.alternatives.all (·.valid) do\\n      throw \\\"invalid or duplicate required evidence identity\\\"\\n    names := names.insert item.name\\n    let alternatives := canonical (item.alternatives.filter (fun target => covered target available))\\n    if alternatives.isEmpty then absent := absent.push item.name; continue\\n    if let some index := units.findIdx? (fun unit => spelling unit.alternatives == spelling alternatives) then\\n      units := units.modify index fun unit => {unit with names := unit.names.push item.name}\\n      continue\\n    unless units.all (fun unit => !unit.alternatives.any (fun a => alternatives.any (overlaps a))) do\\n      throw \\\"partition overlapping required evidence before freezing\\\"\\n    units := units.push ⟨#[item.name],alternatives⟩\\n  return ⟨units,absent⟩\\n\\ndef reachesTarget (required delivered : Nat) : Bool :=\\n  0 < required && delivered ≤ required && 19*required ≤ 20*delivered\\n\\ntheorem target_has_nonempty_denominator (required delivered : Nat)\\n    (met : reachesTarget required delivered = true) : 0 < required ∧ delivered ≤ required := by\\n  simp only [reachesTarget, Bool.and_eq_true, decide_eq_true_eq] at met\\n  exact met.1\\n\\ntheorem one_miss_requires_twenty (required : Nat) (positive : 0 < required) :\\n    reachesTarget required (required-1) = true ↔ 20 ≤ required := by\\n  simp only [reachesTarget, Bool.and_eq_true, decide_eq_true_eq]\\n  omega\\n\\nstructure Result where\\n  eligible : Nat\\n  delivered : Nat\\n  missing : Array (Array String)\\n  initiallyUnavailable : Array String\\n  targetPercent : Nat := 95\\n  targetMet : Bool\\n  deriving ToJson, FromJson\\n\\n/-- The denominator remains the frozen DB-present units even if a later index\\nor retrieval stage misses them. `shown` must come from verified original bytes\\nin the actual hook output, never from nomination, a locator or a claimed ACK. -/\\ndef assess (frozen : Frozen) (shown : Array Range) : Result := Id.run do\\n  let shown := shown.filter (·.valid)\\n  let missing := frozen.units.filter (fun unit => !unit.alternatives.any (fun target => covered target shown))\\n  let eligible := frozen.units.size\\n  let delivered := eligible-missing.size\\n  return {\\n    eligible,delivered,missing := missing.map (·.names)\\n    initiallyUnavailable := frozen.initiallyUnavailable\\n    targetMet := reachesTarget eligible delivered }\\n\\nend Eggshell.Research.RequiredDelivery\\n\",[]]"],["tools.research.ResourceGuard","[\"import tools.research.ArtifactHash\\nimport Lean.Data.Json.FromToJson\\nimport Lean.Data.Json.Parser\\nimport Std.Data.HashMap\\nimport Std.Data.HashSet\\n\\nopen Lean\\n\\nnamespace Eggshell.Research.ResourceGuard\\n\\nstructure Process where\\n  pid : Nat\\n  parent : Nat\\n  rssKiB : Nat\\n  state : String\\n  identity : String\\n  command : Array String\\n  deriving Inhabited, ToJson\\n\\ndef words (line : String) : Array String :=\\n  ((line.splitOn \\\" \\\").filter (! ·.isEmpty)).toArray\\n\\ndef parseProcess (line : String) : Option Process := do\\n  let parts := words line\\n  guard (10 ≤ parts.size)\\n  return {\\n    pid := ← parts[0]!.toNat?, parent := ← parts[1]!.toNat?, rssKiB := ← parts[2]!.toNat?\\n    state := parts[3]!, identity := String.intercalate \\\" \\\" (parts.extract 4 9).toList\\n    command := parts.extract 9 parts.size }\\n\\ndef processes : IO (Std.HashMap Nat Process) := do\\n  let output ← IO.Process.output {\\n    cmd := \\\"/bin/ps\\\", args := #[\\\"-axo\\\",\\\"pid=,ppid=,rss=,stat=,lstart=,args=\\\"]\\n    env := #[(\\\"LC_ALL\\\",some \\\"C\\\")]}\\n  unless output.exitCode == 0 do throw (IO.userError \\\"cannot inspect owned process resources\\\")\\n  return (output.stdout.splitOn \\\"\\\\n\\\").foldl (fun rows line =>\\n    match parseProcess line with\\n    | some row => rows.insert row.pid row\\n    | none => rows) {}\\n\\ndef ancestors (rows : Std.HashMap Nat Process) (monitor : Nat) : Std.HashSet Nat := Id.run do\\n  let mut result := ({} : Std.HashSet Nat).insert monitor\\n  let mut current := rows[monitor]?.map (·.parent)\\n  while let some pid := current do\\n    if result.contains pid then break\\n    result := result.insert pid\\n    current := rows[pid]?.map (·.parent)\\n  return result\\n\\n/-- Signals can only target rows outside the monitor's current ancestor set. -/\\nstructure CheckedProcess (excluded : Std.HashSet Nat) where\\n  process : Process\\n  permitted : excluded.contains process.pid = false\\n\\ntheorem CheckedProcess.ne_protected (row : CheckedProcess excluded)\\n    (present : excluded.contains pid = true) : row.process.pid ≠ pid := by\\n  intro same\\n  have forbidden := row.permitted\\n  rw [same, present] at forbidden\\n  contradiction\\n\\ndef owned (rows : Std.HashMap Nat Process) (excluded : Std.HashSet Nat)\\n    (child : Nat) (known : Std.HashMap Nat String) (prefixes : Array String) : Array (CheckedProcess excluded) := Id.run do\\n  let eligible := rows.toArray.filter fun (_,row) =>\\n    !excluded.contains row.pid && !row.state.startsWith \\\"Z\\\"\\n  let mut children : Std.HashMap Nat (Array Nat) := {}\\n  let mut selected : Std.HashSet Nat := {}\\n  let mut queue := #[]\\n  for (_,row) in eligible do\\n    children := children.insert row.parent ((children[row.parent]?.getD #[]).push row.pid)\\n    let identified := row.command.any fun arg => prefixes.any fun root =>\\n      arg == root || arg.startsWith (root ++ \\\"/\\\")\\n    if row.pid == child || known[row.pid]? == some row.identity || identified then\\n      selected := selected.insert row.pid\\n      queue := queue.push row.pid\\n  let mut position := 0\\n  while position < queue.size do\\n    let parent := queue[position]!\\n    position := position + 1\\n    for pid in children[parent]?.getD #[] do\\n      if selected.contains pid then continue\\n      selected := selected.insert pid\\n      queue := queue.push pid\\n  let mut result := #[]\\n  for (_,row) in eligible do\\n    if !selected.contains row.pid then continue\\n    if permitted : excluded.contains row.pid = false then\\n      result := result.push ⟨row,permitted⟩\\n  return result\\n\\nstructure Settings where\\n  record : String\\n  cwd : String\\n  command : Array String\\n  ownedPrefixes : Array String := #[]\\n  limitRssKiB : Nat := 3145728\\n  minFreeKiB : Nat := 524288\\n  deriving FromJson, ToJson\\n\\n/-- Keep half a GiB below the user's four-GiB ceiling for sampling and\\nshutdown. Three GiB remains the default, rather than the maximum allowed. -/\\ndef maximumStopRssKiB : Nat := 3670016\\n\\ndef validStopRss (limit : Nat) : Bool := decide (0 < limit ∧ limit ≤ maximumStopRssKiB)\\n\\ntheorem valid_stop_reserves_headroom {limit : Nat} (valid : validStopRss limit = true) :\\n    limit + 524288 ≤ 4194304 := by\\n  have bound := (of_decide_eq_true valid).2\\n  exact Nat.add_le_add_right bound 524288\\n\\ndef diskFreeKiB (directory : System.FilePath) : IO Nat := do\\n  let output ← IO.Process.output {cmd := \\\"/bin/df\\\", args := #[\\\"-Pk\\\",directory.toString]}\\n  let rows := (output.stdout.splitOn \\\"\\\\n\\\").filter (! ·.isEmpty)\\n  let some row := rows.getLast? | throw (IO.userError \\\"disk inspection returned no rows\\\")\\n  let fields := words row\\n  let some free := fields[3]?.bind String.toNat? | throw (IO.userError \\\"disk inspection did not report available KiB\\\")\\n  unless output.exitCode == 0 do throw (IO.userError \\\"cannot inspect free disk space\\\")\\n  return free\\n\\n/-- Generation has temporary disk costs beyond its persisted trial directory.\\nThe continuous stop floor stays separate from this startup headroom. -/\\ndef generationSpaceReady (availableKiB : Nat) : Bool := decide (2097152 ≤ availableKiB)\\n\\ntheorem generation_space_bound {availableKiB : Nat}\\n    (ready : generationSpaceReady availableKiB = true) : 2097152 ≤ availableKiB :=\\n  of_decide_eq_true ready\\n\\ndef requireGenerationSpace (directory : System.FilePath) : IO Unit := do\\n  unless generationSpaceReady (← diskFreeKiB directory) do\\n    throw (IO.userError \\\"generation requires at least 2 GiB free before starting; keep the 512 MiB continuous stop floor\\\")\\n\\nprivate abbrev Child := IO.Process.Child {stdin := .inherit, stdout := .inherit, stderr := .inherit}\\n\\nprivate def poll (child : Child) (exit : IO.Ref (Option UInt32)) : IO (Option UInt32) := do\\n  if let some code ← exit.get then return some code\\n  let code ← child.tryWait\\n  exit.set code\\n  return code\\n\\nprivate def snapshot (path : System.FilePath) (json : Json) : IO Unit := do\\n  let pending := System.FilePath.mk (path.toString ++ \\\".pending\\\")\\n  IO.FS.writeFile pending (json.compress ++ \\\"\\\\n\\\")\\n  IO.FS.rename pending path\\n\\ndef run (settings : Settings) : IO UInt32 := do\\n  unless !settings.command.isEmpty && validStopRss settings.limitRssKiB do\\n    throw (IO.userError \\\"guard needs a command and an RSS stop threshold at most 3.5 GiB\\\")\\n  let path := System.FilePath.mk settings.record\\n  unless path.isAbsolute && !(← path.pathExists) do\\n    throw (IO.userError \\\"keep the existing guard record; use a new absolute path\\\")\\n  let directory := path.parent.getD (.mk settings.cwd)\\n  IO.FS.createDirAll directory\\n  unless settings.minFreeKiB ≤ (← diskFreeKiB directory) do\\n    throw (IO.userError \\\"not enough disk space to start this guarded execution\\\")\\n  let monitor := (← IO.Process.getPID).toNat\\n  let started ← IO.monoMsNow\\n  let binarySha ← Eggshell.Research.ArtifactHash.hex (← IO.appPath)\\n  let child ← IO.Process.spawn {\\n    cmd := settings.command[0]!, args := settings.command.extract 1 settings.command.size\\n    cwd := some (.mk settings.cwd), setsid := true\\n    env := #[(\\\"LEAN_NUM_THREADS\\\",some \\\"1\\\"),(\\\"OMP_NUM_THREADS\\\",some \\\"1\\\"),\\n      (\\\"OPENBLAS_NUM_THREADS\\\",some \\\"1\\\"),(\\\"MKL_NUM_THREADS\\\",some \\\"1\\\"),\\n      (\\\"TOKENIZERS_PARALLELISM\\\",some \\\"false\\\"),(\\\"HF_HUB_OFFLINE\\\",some \\\"1\\\")]\\n    stdin := .inherit, stdout := .inherit, stderr := .inherit}\\n  let exit ← IO.mkRef none\\n  let mut known : Std.HashMap Nat String := {}\\n  let mut peak := 0\\n  let mut samples := 0\\n  let mut reason : Option String := none\\n  let mut failure : Option String := none\\n  let mut activeIds := #[]\\n  let mut peakProcesses : Array Json := #[]\\n  let mut lastDisk := 0\\n  let report := fun (state : String) (code : Option Nat) (peak samples : Nat)\\n      (reason failure : Option String) (activeIds : Array Nat) (elapsed : Nat)\\n      (peakProcesses : Array Json) => Json.mkObj [\\n    (\\\"state\\\",toJson state),(\\\"guardPid\\\",toJson monitor),(\\\"childPid\\\",toJson child.pid.toNat),\\n    (\\\"guardSha256\\\",toJson binarySha),(\\\"limitRssKiB\\\",toJson settings.limitRssKiB),\\n    (\\\"userCeilingRssKiB\\\",toJson (4194304 : Nat)),(\\\"sampledPeakRssKiB\\\",toJson peak),\\n    (\\\"samples\\\",toJson samples),(\\\"reason\\\",toJson reason),(\\\"error\\\",toJson failure),\\n    (\\\"guardTriggered\\\",toJson reason.isSome),(\\\"exitCode\\\",toJson code),\\n    (\\\"ownedPids\\\",toJson activeIds),(\\\"peakProcesses\\\",toJson peakProcesses),\\n    (\\\"elapsedMs\\\",toJson elapsed),(\\\"settings\\\",toJson settings)]\\n  try\\n    repeat\\n      let rows ← processes\\n      let excluded := ancestors rows monitor\\n      let active := owned rows excluded child.pid.toNat known settings.ownedPrefixes\\n      activeIds := active.map (·.process.pid)\\n      for row in active do known := known.insert row.process.pid row.process.identity\\n      let rss := active.foldl (fun total row => total + row.process.rssKiB)\\n        (rows[monitor]?.map (·.rssKiB) |>.getD 0)\\n      if peak < rss then\\n        peak := rss\\n        let peakRows := (active.map (·.process)) ++ (rows[monitor]?).toArray\\n        peakProcesses := peakRows.map fun row =>\\n          let role := row.command[1]?.filter (#[\\\"codex-worker\\\",\\\"codex-daemon\\\",\\\"codex-hook\\\",\\n            \\\"search-provider\\\",\\\"app-server\\\",\\\"guard\\\"].contains ·)\\n          let lane := if role == some \\\"codex-worker\\\" then\\n            row.command[2]?.filter (#[\\\"save\\\",\\\"search\\\",\\\"index\\\"].contains ·) else none\\n          Json.mkObj [(\\\"pid\\\",toJson row.pid),(\\\"parent\\\",toJson row.parent),(\\\"rssKiB\\\",toJson row.rssKiB),\\n            (\\\"program\\\",toJson (row.command[0]?.getD \\\"\\\")),(\\\"role\\\",toJson role),(\\\"lane\\\",toJson lane)]\\n      samples := samples + 1\\n      let now ← IO.monoMsNow\\n      if rss ≥ settings.limitRssKiB then reason := some \\\"aggregate-rss\\\"\\n      if now ≥ lastDisk + 1000 then\\n        lastDisk := now\\n        if (← diskFreeKiB directory) < settings.minFreeKiB then reason := some \\\"disk-space\\\"\\n      if reason.isSome then break\\n      if let some _ ← poll child exit then\\n        -- tryWait reaps this child. Reinspect so a prior ps row cannot make\\n        -- a completed child appear to be a leftover process.\\n        let finalRows ← processes\\n        let remaining := owned finalRows (ancestors finalRows monitor) child.pid.toNat known settings.ownedPrefixes\\n        activeIds := remaining.map (·.process.pid)\\n        if !remaining.isEmpty then reason := some \\\"leftover-processes\\\"\\n        break\\n      if samples % 10 == 1 then\\n        snapshot path (report \\\"running\\\" (none : Option Nat) peak samples reason failure activeIds (now-started) peakProcesses)\\n      IO.sleep 100\\n  catch error =>\\n    reason := some \\\"monitor-error\\\"\\n    failure := some error.toString\\n  if reason.isSome then\\n    -- Revalidate identity immediately before signaling. The proof-bearing\\n    -- rows exclude the monitor and all its ancestors even during teardown.\\n    try\\n      let rows ← processes\\n      let targets := owned rows (ancestors rows monitor) child.pid.toNat known settings.ownedPrefixes\\n      for target in targets do\\n        let _ ← IO.Process.output {cmd := \\\"/bin/kill\\\",args := #[\\\"-KILL\\\",toString target.process.pid]}\\n    catch error => failure := some s!\\\"cleanup inspection: {error}\\\"\\n    if (← poll child exit).isNone then\\n      -- This child owns a fresh process group (setsid above). Even if ps is\\n      -- unavailable, terminate that owned group before waiting or reporting.\\n      let _ ← IO.Process.output {cmd := \\\"/bin/kill\\\",args := #[\\\"-KILL\\\",\\\"--\\\",\\\"-\\\" ++ toString child.pid]}\\n      try child.kill catch _ => pure ()\\n  let code ← match ← poll child exit with\\n    | some code => pure code\\n    | none => child.wait\\n  -- The recorded set describes actual survivors after cleanup, rather than\\n  -- the last sample taken before the owned processes were signalled.\\n  let cleanupDeadline := (← IO.monoMsNow)+2000\\n  let mut emptySince : Option Nat := none\\n  repeat\\n    let rows ← processes\\n    let active := owned rows (ancestors rows monitor) child.pid.toNat known settings.ownedPrefixes\\n    activeIds := active.map (·.process.pid)\\n    for target in active do\\n      known := known.insert target.process.pid target.process.identity\\n    let now ← IO.monoMsNow\\n    if activeIds.isEmpty then\\n      if let some since := emptySince then\\n        if now ≥ since+100 then break\\n      else emptySince := some now\\n    else\\n      emptySince := none\\n      -- A hook can finish spawning its daemon after the first kill sweep.\\n      -- Reacquire proof-bearing ownership rows on every sweep, including\\n      -- newly discovered children, and retain their identities if reparented.\\n      if reason.isSome then\\n        for target in active do\\n          let _ ← IO.Process.output {cmd := \\\"/bin/kill\\\",args := #[\\\"-KILL\\\",toString target.process.pid]}\\n          pure ()\\n    if now ≥ cleanupDeadline then break\\n    IO.sleep 5\\n  let finalRows ← processes\\n  activeIds := (owned finalRows (ancestors finalRows monitor) child.pid.toNat known settings.ownedPrefixes).map (·.process.pid)\\n  if !activeIds.isEmpty then\\n    failure := some \\\"owned processes survived resource cleanup\\\"\\n    if reason.isNone then reason := some \\\"leftover-processes\\\"\\n  snapshot path (report \\\"finished\\\" (some code.toNat) peak samples reason failure activeIds ((← IO.monoMsNow)-started) peakProcesses)\\n  return if reason.isSome then 2 else code\\n\\ndef cliMain (args : List String) : IO UInt32 := do\\n  try\\n    let [input] := args | throw (IO.userError \\\"ResourceGuard SETTINGS.json\\\")\\n    let json ← IO.ofExcept (Json.parse (← IO.FS.readFile (.mk input)))\\n    let settings ← IO.ofExcept (fromJson? (α := Eggshell.Research.ResourceGuard.Settings) json)\\n    Eggshell.Research.ResourceGuard.run settings\\n  catch error =>\\n    IO.eprintln error.toString\\n    return 1\\n\\nend Eggshell.Research.ResourceGuard\\n\",[]]"],["tools.research.StudyAdmission","[\"import tools.research.NativeTrialAudit\\nimport tools.research.StudyRuntime\\nimport tools.research.StudyTransport\\nimport tools.research.StudyCommand\\nimport tools.research.ArtifactHash\\nimport Eggshell.Install\\n\\nopen Lean Eggshell\\n\\nnamespace Eggshell.Research.StudyAdmission\\n\\nstructure Artifact where\\n  path : String\\n  sha256 : String\\n  deriving FromJson, ToJson\\n\\nstructure Preparation where\\n  input : Artifact\\n  stdout : Artifact\\n  timing : Artifact\\n  body : Artifact\\n  state : Artifact\\n  shutdown : Artifact\\n  search : Artifact\\n  numerical : Array Artifact\\n  auditInput : Artifact\\n  auditReport : Artifact\\n  session : String\\n  deriving FromJson, ToJson\\n\\nstructure Plan where\\n  label : String\\n  purpose : String\\n  topic : Nat\\n  stage : Nat\\n  repetition : Nat\\n  model : String\\n  effort : String\\n  workspace : String\\n  sourceCommit : String\\n  prompt : Artifact\\n  runner : Artifact\\n  cliWrapper : Artifact\\n  nativeCli : Artifact\\n  runtime : Artifact\\n  accountConfiguration : Artifact\\n  configuration : Artifact\\n  harness : Array Artifact\\n  pluginRoot : String\\n  pluginFiles : Array Artifact\\n  sourceSnapshot : String\\n  sourceFiles : Array (String × String)\\n  database : String\\n  databaseFiles : Array (String × String)\\n  dataRoot : String\\n  privateFiles : Array (String × String)\\n  environment : Array (String × Option String)\\n  preparation : Preparation\\n  output : String\\n  guardRecord : String\\n  deriving FromJson, ToJson\\n\\nstructure Admitted where\\n  private mk ::\\n  plan : Plan\\n  prompt : String\\n  bodySha256 : String\\n  audit : Json\\n  liveDoctor : Json\\n  knownOmissions : Array String\\n  modelExact : plan.model = \\\"gpt-5.6-luna\\\"\\n  effortExact : plan.effort = \\\"xhigh\\\"\\n\\nprivate def check (condition : Bool) (message : String) : IO Unit :=\\n  unless condition do throw (IO.userError message)\\n\\ndef readJson (path : String) : IO Json := do\\n  IO.ofExcept (Json.parse (← IO.FS.readFile (.mk path)))\\n\\n/-- The opened file's identity/version and its resolved path must remain stable\\nacross hashing. Credentials are not experiment artifacts. -/\\ndef verifyArtifact (artifact : Artifact) : IO Unit := do\\n  let path := System.FilePath.mk artifact.path\\n  check (path.isAbsolute && path.fileName != some \\\"auth.json\\\") \\\"invalid experiment artifact path\\\"\\n  check ((← ArtifactHash.hex path) == artifact.sha256) s!\\\"sealed artifact changed: {path}\\\"\\n\\n/-- A copied bundle may keep valid hashes while still launching its old\\nprefix. Bind both installed entry points to the exact frozen runtime. -/\\ndef verifyPluginRuntime (runtime : Artifact) (pluginRoot : String) : IO Unit := do\\n  let executable := System.FilePath.mk runtime.path\\n  let directory := executable.parent.getD \\\"\\\"\\n  let installRoot := directory.parent.getD \\\"\\\"\\n  check (executable.isAbsolute && executable.fileName == some \\\"eggshell\\\" &&\\n    directory.fileName == some \\\"libexec\\\" && installRoot.isAbsolute) \\\"runtime is outside an installed prefix\\\"\\n  let expected := Install.pluginLauncher installRoot\\n  for name in #[\\\"egg\\\",\\\"eggshelld\\\"] do\\n    let path := System.FilePath.mk pluginRoot / \\\"bin\\\" / name\\n    check ((← FileSystem.boundedBytes path 16384) == expected.toUTF8)\\n      s!\\\"plugin launcher does not target the frozen runtime: {path}\\\"\\n\\nprivate def sorted (files : Array (String × String)) := files.qsort (fun a b => a.1 < b.1)\\n\\npartial def tree (root : System.FilePath) (relative : String := \\\"\\\") : IO (Array (String × String)) := do\\n  let mut result := #[]\\n  for entry in ← (root / relative).readDir do\\n    let name := if relative.isEmpty then entry.fileName else relative ++ \\\"/\\\" ++ entry.fileName\\n    let metadata ← entry.path.symlinkMetadata\\n    if metadata.type == .dir then result := result ++ (← tree root name)\\n    else\\n      check (metadata.type == .file && entry.fileName != \\\"daemon.json\\\") \\\"private preparation has a symlink or live daemon\\\"\\n      result := result.push (name,← ArtifactHash.hex entry.path)\\n  return sorted result\\n\\ndef env (plan : Plan) (name : String) : Option String :=\\n  (plan.environment.find? (·.1 == name)).bind (·.2)\\n\\nprivate def requireEnv (plan : Plan) (key value : String) : IO Unit :=\\n  check (env plan key == some value) s!\\\"prepared environment differs: {key}\\\"\\n\\nprivate def datum (artifact : Artifact) : IO Json := do\\n  let json ← readJson artifact.path\\n  IO.ofExcept (json.getObjVal? \\\"data\\\")\\n\\n/-- Stored receipts do not imply that cache files still exist. Inspect the\\ncurrent DB through the frozen runtime, without starting an encoder. -/\\ndef verifyLiveWarm (plan : Plan) : IO Json := do\\n  let directory := System.FilePath.mk (plan.output ++ s!\\\".warm-check-{← IO.Process.getPID}-{← IO.monoNanosNow}\\\")\\n  let result ← StudyCommand.run plan.runtime.path #[\\\"egg\\\",\\\"doctor\\\"] plan.environment plan.workspace \\\"\\\" directory 60000\\n  check (result.exitCode == 0) \\\"current native cache inspection failed\\\"\\n  let doctor ← IO.ofExcept (Json.parse result.stdout)\\n  let databases ← IO.ofExcept (doctor.getObjValAs? (Array Json) \\\"databases\\\")\\n  check (databases.size == 1) \\\"current cache inspection selected another database set\\\"\\n  let database := databases[0]!\\n  check ((database.getObjValAs? String \\\"path\\\").toOption == some plan.database &&\\n    (database.getObjValAs? String \\\"state\\\").toOption == some \\\"warm\\\") \\\"current database is cold\\\"\\n  let coverage ← IO.ofExcept (database.getObjVal? \\\"coverage\\\")\\n  for lane in #[coverage,← IO.ofExcept (coverage.getObjVal? \\\"discovery\\\"),← IO.ofExcept (coverage.getObjVal? \\\"focus\\\")] do\\n    let windows ← IO.ofExcept (lane.getObjValAs? Nat \\\"windows\\\")\\n    check (windows > 0 && (lane.getObjValAs? Nat \\\"valid\\\").toOption == some windows &&\\n      (lane.getObjValAs? Nat \\\"missing\\\").toOption == some 0 &&\\n      (lane.getObjValAs? Nat \\\"invalid\\\").toOption == some 0) \\\"current source windows are missing or invalid\\\"\\n  return Json.mkObj [(\\\"directory\\\",toJson directory.toString),(\\\"report\\\",doctor)]\\n\\ndef admit (path expectedSha256 : String) : IO Admitted := do\\n  verifyArtifact ⟨path,expectedSha256⟩\\n  let plan ← IO.ofExcept (fromJson? (α := Plan) (← readJson path))\\n  let modelExact : PLift (plan.model = \\\"gpt-5.6-luna\\\") ←\\n    if h : plan.model = \\\"gpt-5.6-luna\\\" then pure ⟨h⟩ else throw (IO.userError \\\"model substitution is not permitted\\\")\\n  let effortExact : PLift (plan.effort = \\\"xhigh\\\") ←\\n    if h : plan.effort = \\\"xhigh\\\" then pure ⟨h⟩ else throw (IO.userError \\\"reasoning effort differs from the study\\\")\\n  check (!plan.label.isEmpty && plan.label.toList.all (fun c => c.isAlphanum || c == '-' || c == '_' || c == '.'))\\n    \\\"invalid trial label\\\"\\n  check (1 ≤ plan.stage && plan.stage ≤ 6 && plan.topic == (plan.stage-1)%3+1 &&\\n      #[\\\"pilot\\\",\\\"comparison\\\"].contains plan.purpose) \\\"trial is outside the frozen six-stage design\\\"\\n  check ((System.FilePath.mk plan.workspace).isAbsolute && (System.FilePath.mk plan.output).isAbsolute &&\\n    !(← (System.FilePath.mk plan.output).pathExists)) \\\"trial workspace/output is invalid or already used\\\"\\n  let p := plan.preparation\\n  let artifacts := #[plan.prompt,plan.runner,plan.cliWrapper,plan.nativeCli,plan.runtime,\\n    plan.accountConfiguration,plan.configuration,p.input,p.stdout,p.timing,p.body,p.state,p.shutdown,\\n    p.search,p.auditInput,p.auditReport] ++ plan.harness ++ plan.pluginFiles ++ p.numerical\\n  for artifact in artifacts do verifyArtifact artifact\\n  verifyPluginRuntime plan.runtime plan.pluginRoot\\n  check (!plan.harness.isEmpty && !plan.pluginFiles.isEmpty &&\\n    plan.pluginFiles.any (·.path == plan.pluginRoot ++ \\\"/bin/eggshelld\\\")) \\\"unsealed harness or plugin launcher\\\"\\n  let environmentNames := (plan.environment.map (·.1)).toList\\n  check (environmentNames.eraseDups.length == plan.environment.size) \\\"duplicate environment setting\\\"\\n  requireEnv plan \\\"EGGSHELL_DATA_ROOT\\\" plan.dataRoot\\n  requireEnv plan \\\"EGGSHELL_CONFIG\\\" plan.configuration.path\\n  requireEnv plan \\\"CODEX_HOME\\\" ((System.FilePath.mk plan.accountConfiguration.path).parent.getD (.mk \\\"\\\")).toString\\n  requireEnv plan \\\"EGGSHELL_PROFILE\\\" \\\"work\\\"\\n  check ((env plan \\\"EGGSHELL_PREFIX\\\").any (fun root => root ++ \\\"/libexec/eggshell\\\" == plan.runtime.path))\\n    \\\"prepared runtime prefix differs\\\"\\n  check ((env plan \\\"EGGSHELL_TARGET\\\").isNone && (env plan \\\"EGGSHELL_HANDOFF_BYTES\\\").isNone)\\n    \\\"unsealed target/budget override\\\"\\n  let commit ← IO.Process.output {cmd := \\\"/usr/bin/git\\\",args := #[\\\"rev-parse\\\",\\\"HEAD\\\"],cwd := some (.mk plan.workspace)}\\n  let clean ← IO.Process.output {cmd := \\\"/usr/bin/git\\\",args := #[\\\"status\\\",\\\"--porcelain\\\"],cwd := some (.mk plan.workspace)}\\n  check (commit.exitCode == 0 && commit.stdout.trimAscii.copy == plan.sourceCommit &&\\n    clean.exitCode == 0 && clean.stdout.trimAscii.isEmpty) \\\"source checkout changed\\\"\\n  check (sorted plan.sourceFiles == (← StudyRuntime.files (.mk plan.sourceSnapshot)) &&\\n    sorted plan.databaseFiles == (← StudyRuntime.files (.mk plan.database))) \\\"saved publication changed\\\"\\n  FileSystem.rejectSymlinkAncestors (.mk plan.dataRoot)\\n  check ((← tree (.mk plan.dataRoot)) == sorted plan.privateFiles) \\\"private preparation changed\\\"\\n  let config ← Config.parseFile (.mk plan.configuration.path)\\n  let selected ← IO.ofExcept (Config.resolve config \\\"work\\\")\\n  check (config.defaultProfile == \\\"work\\\" && selected.read.map (·.path.toString) == [plan.database] &&\\n    selected.write.map (·.path.toString) == some plan.database && selected.handoffChars == 120000 &&\\n    selected.semanticMatcher == some [plan.runtime.path,\\\"search-provider\\\"])\\n    \\\"prepared profile, database, provider or budget differs\\\"\\n  let prompt ← IO.FS.readFile (.mk plan.prompt.path)\\n  let request ← readJson p.input.path\\n  check ((request.getObjValAs? String \\\"_eggshell_config\\\").toOption == some plan.configuration.path &&\\n    (request.getObjValAs? String \\\"session_id\\\").toOption == some p.session)\\n    \\\"preflight used another config or session\\\"\\n  let auditInput ← readJson p.auditInput.path\\n  let source ← IO.ofExcept (auditInput.getObjVal? \\\"source\\\")\\n  check ((auditInput.getObjValAs? String \\\"database\\\").toOption == some plan.database &&\\n    (source.getObjValAs? String \\\"source\\\").toOption == some plan.sourceSnapshot &&\\n    (source.getObjValAs? String \\\"workspace\\\").toOption == some plan.workspace &&\\n    (source.getObjValAs? String \\\"prompt\\\").toOption == some prompt &&\\n    (source.getObjValAs? (Array (String × String)) \\\"files\\\").toOption.map sorted == some (sorted plan.sourceFiles))\\n    \\\"audit is bound to a different publication or question\\\"\\n  for (key,artifact) in #[(\\\"request\\\",p.input),(\\\"stdout\\\",p.stdout),(\\\"timing\\\",p.timing),(\\\"body\\\",p.body)] do\\n    check ((auditInput.getObjValAs? String key).toOption == some artifact.path) s!\\\"audit references another {key}\\\"\\n  let audit ← NativeTrialAudit.inspect p.auditInput.path\\n  check (audit == (← readJson p.auditReport.path)) \\\"native source/code audit is stale\\\"\\n  check ((audit.getObjValAs? Nat \\\"originalRows\\\").toOption.any (· > 0)) \\\"no original memory observations\\\"\\n  let body ← IO.FS.readFile (.mk p.body.path)\\n  check (!body.trimAscii.isEmpty && !(body.contains \\\"EGGSHELL SEARCH INCOMPLETE\\\")) \\\"preflight did not deliver a memory body\\\"\\n  let state ← readJson p.state.path\\n  check ((state.getObjValAs? String \\\"lastHandoff\\\").toOption == some body &&\\n    (state.getObjValAs? (Array String) \\\"deliveredGraphs\\\").toOption.any (! ·.isEmpty)) \\\"preflight was not acknowledged\\\"\\n  let shutdown ← readJson p.shutdown.path\\n  check ((shutdown.getObjValAs? String \\\"phase\\\").toOption == some \\\"stopped\\\" &&\\n    (shutdown.getObjValAs? Bool \\\"acknowledged\\\").toOption == some true &&\\n    (shutdown.getObjValAs? Nat \\\"daemonExitCode\\\").toOption == some 0 &&\\n    (shutdown.getObjValAs? Bool \\\"endpointRemoved\\\").toOption == some true) \\\"preparation daemon did not close cleanly\\\"\\n  let search ← datum p.search\\n  let trace ← IO.ofExcept (search.getObjVal? \\\"trace\\\")\\n  check ((trace.getObjValAs? String \\\"semantic\\\").toOption == some \\\"completed\\\") \\\"warm semantic preflight did not complete\\\"\\n  let mut purposes : Std.HashSet String := {}\\n  for numerical in p.numerical do\\n    let receipt ← datum numerical\\n    let corpus ← IO.ofExcept (receipt.getObjVal? \\\"corpus\\\")\\n    purposes := purposes.insert (← IO.ofExcept (corpus.getObjValAs? String \\\"purpose\\\"))\\n    let counters ← IO.ofExcept (receipt.getObjVal? \\\"counters\\\")\\n    let sources ← IO.ofExcept (counters.getObjVal? \\\"source\\\")\\n    let encoder ← IO.ofExcept (counters.getObjVal? \\\"encoder\\\")\\n    check ((receipt.getObjValAs? String \\\"status\\\").toOption == some \\\"completed\\\" &&\\n      (sources.getObjValAs? Nat \\\"hit\\\").toOption.any (· > 0) &&\\n      (sources.getObjValAs? Nat \\\"absent\\\").toOption == some 0 &&\\n      (sources.getObjValAs? Nat \\\"unusable\\\").toOption == some 0 &&\\n      (encoder.getObjValAs? Nat \\\"sourceEncodeUs\\\").toOption == some 0)\\n      \\\"preflight has cold/invalid source vectors or encoded source windows inside the hook\\\"\\n  check (purposes.size == 2 && purposes.contains \\\"discovery\\\" && purposes.contains \\\"focus\\\")\\n    \\\"both warm numerical lanes are required\\\"\\n  let requirements ← IO.ofExcept (audit.getObjValAs? (Array Json) \\\"requirements\\\")\\n  let knownOmissions ← (requirements.filter fun row =>\\n    (row.getObjValAs? Bool \\\"stored\\\").toOption == some true &&\\n    (row.getObjValAs? Bool \\\"bodyDelivered\\\").toOption != some true).mapM fun row =>\\n      IO.ofExcept (row.getObjValAs? String \\\"name\\\")\\n  check (plan.purpose == \\\"pilot\\\" || knownOmissions.isEmpty) \\\"comparison preflight omits known required source code\\\"\\n  let liveDoctor ← verifyLiveWarm plan\\n  return {\\n    plan,prompt,bodySha256 := p.body.sha256,audit,liveDoctor,knownOmissions\\n    modelExact := modelExact.down,effortExact := effortExact.down}\\n\\nend Eggshell.Research.StudyAdmission\\n\",[]]"],["tools.research.StudyCommand","[\"import Eggshell.Worker\\nimport Eggshell.Sha256\\nimport tools.research.StudyEnvironment\\n\\nopen Lean Eggshell\\n\\nnamespace Eggshell.Research.StudyCommand\\n\\nstructure Result where\\n  exitCode : Nat\\n  elapsedMs : Nat\\n  stdout : String\\n  stderr : String\\n  deriving ToJson\\n\\nprivate def readBounded (handle : IO.FS.Handle) : IO String := do\\n  let mut bytes := ByteArray.empty\\n  repeat\\n    let next ← handle.read 1\\n    if next.isEmpty then break\\n    unless bytes.size < 32*1024*1024 do throw (IO.userError \\\"native command output exceeds 32 MiB\\\")\\n    bytes := bytes ++ next\\n  let some text := String.fromUTF8? bytes | throw (IO.userError \\\"native command output is not UTF-8\\\")\\n  return text\\n\\ndef run (binary : String) (args : Array String) (environment : Array (String × Option String))\\n    (cwd : String) (input : String) (directory : System.FilePath) (timeoutMs : Nat) : IO Result := do\\n  unless !(← directory.pathExists) do throw (IO.userError \\\"keep the previous native command evidence\\\")\\n  StudyEnvironment.prepare environment\\n  IO.FS.createDir directory\\n  IO.FS.writeFile (directory / \\\"stdin\\\") input\\n  let spawned ← IO.Process.spawn {\\n    cmd := binary,args,cwd := some (.mk cwd),env := environment\\n    stdin := .piped,stdout := .piped,stderr := .piped,setsid := true}\\n  let (stdin,child) ← spawned.takeStdin\\n  let writer ← IO.asTask (do stdin.putStr input; stdin.flush) .dedicated\\n  let out ← IO.asTask (readBounded child.stdout) .dedicated\\n  let err ← IO.asTask (readBounded child.stderr) .dedicated\\n  let exit ← IO.mkRef (none : Option UInt32)\\n  let started ← IO.monoMsNow\\n  try\\n    repeat\\n      if let some code ← child.tryWait then\\n        exit.set (some code)\\n        break\\n      unless (← IO.monoMsNow) < started + timeoutMs do throw (IO.userError \\\"native command timed out\\\")\\n      for task in #[writer] do\\n        if ← IO.hasFinished task then\\n          if let .error error := task.get then throw error\\n      IO.sleep 5\\n    while !(← IO.hasFinished out) || !(← IO.hasFinished err) || !(← IO.hasFinished writer) do\\n      unless (← IO.monoMsNow) < started + timeoutMs do throw (IO.userError \\\"native command pipes did not close\\\")\\n      IO.sleep 5\\n    let stdout ← IO.ofExcept (out.get.mapError IO.Error.toString)\\n    let stderr ← IO.ofExcept (err.get.mapError IO.Error.toString)\\n    let _ ← IO.ofExcept (writer.get.mapError IO.Error.toString)\\n    let result : Result := ⟨((← exit.get).getD 1).toNat,(← IO.monoMsNow)-started,stdout,stderr⟩\\n    IO.FS.writeFile (directory / \\\"stdout\\\") stdout\\n    IO.FS.writeFile (directory / \\\"stderr\\\") stderr\\n    IO.FS.writeFile (directory / \\\"record.json\\\") ((Json.mkObj [\\n      (\\\"exitCode\\\",toJson result.exitCode),(\\\"elapsedMs\\\",toJson result.elapsedMs),\\n      (\\\"stdoutSha256\\\",toJson (Sha256.hex stdout.toUTF8))]).compress ++ \\\"\\\\n\\\")\\n    return result\\n  finally\\n    Plugin.Worker.killGroup child\\n    if (← exit.get).isNone then\\n      let _ ← child.wait\\n      pure ()\\n\\nend Eggshell.Research.StudyCommand\\n\",[]]"],["tools.research.StudyEnvironment","[\"import Eggshell.FileSystem\\n\\nnamespace Eggshell.Research.StudyEnvironment\\n\\n/-- Resolve only the explicit setting carried by a frozen child environment.\\nNever change the controller's own environment or reinterpret a relative path. -/\\ndef temporaryRoot? (environment : Array (String × Option String)) : Except String (Option System.FilePath) := do\\n  match (environment.filter (·.1 == \\\"TMPDIR\\\")).toList with\\n  | [] | [(_,none)] => return none\\n  | [(_,some raw)] =>\\n      let path := (System.FilePath.mk raw).normalize\\n      unless !raw.trimAscii.isEmpty && path.isAbsolute && path.toString != \\\"/\\\" do\\n        throw \\\"study TMPDIR must name an absolute non-root directory\\\"\\n      return some path\\n  | _ => throw \\\"duplicate study TMPDIR setting\\\"\\n\\n/-- A sealed path does not prove that its directory exists or is writable.\\nPrepare a missing scratch root and probe actual IO before starting a child.\\nExisting directories keep their permissions; only our new probe is removed. -/\\ndef prepare (environment : Array (String × Option String)) : IO Unit := do\\n  let some path ← IO.ofExcept (temporaryRoot? environment) | return\\n  try\\n    FileSystem.rejectSymlinkAncestors path\\n    match ← FileSystem.symlinkMetadata? path with\\n    | none => FileSystem.privateDirectory path\\n    | some metadata =>\\n        unless metadata.type == .dir do throw (IO.userError \\\"scratch root is not a directory\\\")\\n    let probe := path / s!\\\".eggshell-probe-{← IO.Process.getPID}-{← IO.monoNanosNow}\\\"\\n    IO.FS.createDir probe\\n    let file := probe / \\\"io\\\"\\n    try\\n      FileSystem.privateDirectory probe\\n      IO.FS.writeFile file \\\"eggshell\\\\n\\\"\\n      unless (← IO.FS.readFile file) == \\\"eggshell\\\\n\\\" do throw (IO.userError \\\"scratch probe disagrees\\\")\\n    finally\\n      if ← file.pathExists then IO.FS.removeFile file\\n      IO.FS.removeDir probe\\n  catch error => throw (IO.userError s!\\\"study TMPDIR {path}: {error}\\\")\\n\\nend Eggshell.Research.StudyEnvironment\\n\",[]]"],["tools.research.StudyPrepare","[\"import tools.research.StudyAdmission\\nimport tools.research.StudyCommand\\n\\nopen Lean Eggshell\\n\\nnamespace Eggshell.Research.StudyPrepare\\n\\nprivate def check (condition : Bool) (message : String) : IO Unit :=\\n  unless condition do throw (IO.userError message)\\n\\ndef artifact (path : System.FilePath) : IO StudyAdmission.Artifact :=\\n  return ⟨path.toString,← ArtifactHash.hex path⟩\\n\\nprivate def setEnv (original updates : Array (String × Option String)) : Array (String × Option String) :=\\n  original.filter (fun row => !updates.any (·.1 == row.1)) ++ updates\\n\\nprivate def write (path : System.FilePath) (json : Json) : IO Unit :=\\n  IO.FS.writeFile path (json.compress ++ \\\"\\\\n\\\")\\n\\n/-- Source-only restore, explicit off-hook warming, two independent native\\nchats and exact-source audit. No App Server turn or answering model is invoked. -/\\ndef prepare (templatePath directory : String) (live : Bool := false) : IO StudyAdmission.Plan := do\\n  let template ← IO.ofExcept (fromJson? (α := StudyAdmission.Plan) (← StudyAdmission.readJson templatePath))\\n  let root := System.FilePath.mk directory\\n  check (root.isAbsolute && !(← root.pathExists)) \\\"keep the existing preparation\\\"\\n  for artifact in #[template.prompt,template.runtime,template.accountConfiguration] ++ template.pluginFiles do\\n    StudyAdmission.verifyArtifact artifact\\n  let original ← StudyRuntime.files (.mk template.sourceSnapshot)\\n  check (original == template.sourceFiles.qsort (fun a b => a.1 < b.1)) \\\"source snapshot changed before preparation\\\"\\n  IO.FS.createDir root\\n  let data := if live then System.FilePath.mk template.dataRoot else root / \\\"data\\\"\\n  let config := if live then System.FilePath.mk template.configuration.path else root / \\\"config.toml\\\"\\n  for path in #[template.runtime.path,template.database] do\\n    check (!(path.contains '\\\"') && !(path.contains '\\\\\\\\') && !(path.contains '\\\\n')) \\\"unsupported TOML path quoting\\\"\\n  let source := \\\"default = \\\\\\\"work\\\\\\\"\\\\nsemantic_matcher = \\\" ++\\n    (toJson #[template.runtime.path,\\\"search-provider\\\"]).compress ++ \\\"\\\\n[eggs]\\\\nwork = \\\" ++\\n    (toJson template.database).compress ++\\n    \\\"\\\\n[profiles.work]\\\\nread = [\\\\\\\"work\\\\\\\"]\\\\nwrite = \\\\\\\"work\\\\\\\"\\\\nhandoff_chars = 120000\\\\n\\\"\\n  if live then\\n    StudyAdmission.verifyArtifact template.configuration\\n    check (data.isAbsolute && (← data.pathExists) && (← IO.FS.readFile config) == source)\\n      \\\"live preparation requires the sealed study configuration and existing private history\\\"\\n    check ((← StudyRuntime.files (.mk template.database)) == original)\\n      \\\"live database differs from the frozen source checkpoint\\\"\\n    let privateFiles ← StudyAdmission.tree data\\n    check (!privateFiles.any (fun row => row.1.endsWith \\\"/daemon.json\\\"))\\n      \\\"a live daemon still owns the persistent private history\\\"\\n  else\\n    IO.FS.createDir data\\n    IO.FS.writeFile config source\\n  let environment := setEnv template.environment #[\\n    (\\\"EGGSHELL_CONFIG\\\",some config.toString),(\\\"EGGSHELL_DATA_ROOT\\\",some data.toString),\\n    (\\\"EGGSHELL_PROFILE\\\",some \\\"work\\\"),(\\\"PLUGIN_ROOT\\\",some template.pluginRoot),\\n    (\\\"LEAN_NUM_THREADS\\\",some \\\"1\\\"),(\\\"OMP_NUM_THREADS\\\",some \\\"1\\\"),(\\\"OPENBLAS_NUM_THREADS\\\",some \\\"1\\\"),\\n    (\\\"MKL_NUM_THREADS\\\",some \\\"1\\\"),(\\\"TOKENIZERS_PARALLELISM\\\",some \\\"false\\\"),(\\\"HF_HUB_OFFLINE\\\",some \\\"1\\\")]\\n  if !live then StudyRuntime.restore (.mk template.sourceSnapshot) (.mk template.database)\\n  let warm ← StudyCommand.run template.runtime.path #[\\\"egg\\\",\\\"warm\\\",\\\"work\\\"] environment template.workspace \\\"\\\" (root / \\\"warm\\\") 240000\\n  check (warm.exitCode == 0) \\\"explicit source warm failed\\\"\\n  let warmed ← IO.ofExcept (Json.parse warm.stdout >>= (·.getObjValAs? (Array Json) \\\"databases\\\"))\\n  check (warmed.size == 1) \\\"warm returned another database set\\\"\\n  let coverage ← IO.ofExcept (warmed[0]!.getObjVal? \\\"after\\\")\\n  check ((coverage.getObjValAs? Nat \\\"missing\\\").toOption == some 0 &&\\n    (coverage.getObjValAs? Nat \\\"invalid\\\").toOption == some 0) \\\"source warm is incomplete\\\"\\n  let doctor ← StudyCommand.run template.runtime.path #[\\\"egg\\\",\\\"doctor\\\"] environment template.workspace \\\"\\\" (root / \\\"doctor\\\") 60000\\n  check (doctor.exitCode == 0) \\\"native doctor failed\\\"\\n  let prompt ← IO.FS.readFile (.mk template.prompt.path)\\n  let mut lastBody : Option String := none\\n  let mut finalSession := \\\"\\\"\\n  let mut finalCall := root\\n  for index in [0:2] do\\n    let session := s!\\\"prepare-{template.label}-{index}\\\"\\n    let call := root / s!\\\"chat-{index}\\\"\\n    IO.FS.createDir call\\n    let endpoint := data / \\\"sessions\\\" / session / \\\"daemon.json\\\"\\n    let managed ← StudyRuntime.startManaged (.mk template.runtime.path) (.mk template.pluginRoot) session endpoint environment\\n    try\\n      let mut body := \\\"\\\"\\n      for event in #[\\\"SessionStart\\\",\\\"UserPromptSubmit\\\"] do\\n        let fields := [(\\\"hook_event_name\\\",toJson event),(\\\"session_id\\\",toJson session),(\\\"turn_id\\\",toJson \\\"first\\\"),\\n          (\\\"cwd\\\",toJson template.workspace),(\\\"_eggshell_config\\\",toJson config.toString)]\\n        let request := Json.mkObj (if event == \\\"UserPromptSubmit\\\" then fields ++ [(\\\"prompt\\\",toJson prompt)] else fields)\\n        let result ← StudyCommand.run template.runtime.path #[\\\"codex-hook\\\"] environment template.workspace\\n          (request.compress ++ \\\"\\\\n\\\") (call / event) 35000\\n        check (result.exitCode == 0 && result.elapsedMs < 30000) \\\"native preparation hook failed or expired\\\"\\n        if event == \\\"UserPromptSubmit\\\" then\\n          let reply ← IO.ofExcept (Json.parse result.stdout)\\n          body ← IO.ofExcept (reply.getObjVal? \\\"hookSpecificOutput\\\" >>= (·.getObjValAs? String \\\"additionalContext\\\"))\\n      check (!body.trimAscii.isEmpty && !(body.contains \\\"EGGSHELL SEARCH INCOMPLETE\\\")) \\\"new chat did not deliver source memory\\\"\\n      if let some previous := lastBody then check (previous == body) \\\"new chat changed the fixed-source preflight body\\\"\\n      lastBody := some body\\n      IO.FS.writeFile (call / \\\"body.txt\\\") body\\n      finalSession := session\\n      finalCall := call\\n    finally\\n      StudyRuntime.stopManaged managed (call / \\\"shutdown.json\\\")\\n  let mut receipt : Option System.FilePath := none\\n  for entry in ← (data / \\\"receipts\\\").readDir do\\n    let request := entry.path / \\\"request.json\\\"\\n    if !(← request.pathExists) then continue\\n    let fields ← IO.ofExcept ((← StudyAdmission.readJson request.toString).getObjVal? \\\"data\\\")\\n    if (fields.getObjValAs? String \\\"event\\\").toOption == some \\\"UserPromptSubmit\\\" &&\\n        (fields.getObjValAs? String \\\"session\\\").toOption == some finalSession then\\n      check receipt.isNone \\\"multiple receipts for the qualification hook\\\"\\n      receipt := some entry.path\\n  let some qualifiedReceipt := receipt | throw (IO.userError \\\"qualification has no native receipt\\\")\\n  let mut numerical := #[]\\n  for entry in ← qualifiedReceipt.readDir do\\n    if entry.fileName.startsWith \\\"numerical-\\\" && entry.fileName.endsWith \\\".json\\\" then\\n      numerical := numerical.push (← artifact entry.path)\\n  let auditInput := root / \\\"audit-input.json\\\"\\n  let prototype ← StudyAdmission.readJson template.preparation.auditInput.path\\n  let originalSource ← IO.ofExcept (prototype.getObjVal? \\\"source\\\")\\n  let required ← IO.ofExcept (originalSource.getObjVal? \\\"required\\\")\\n  let source := Json.mkObj [(\\\"source\\\",toJson template.sourceSnapshot),(\\\"workspace\\\",toJson template.workspace),\\n    (\\\"prompt\\\",toJson prompt),(\\\"files\\\",toJson original),(\\\"required\\\",required)]\\n  let hook := finalCall / \\\"UserPromptSubmit\\\"\\n  write auditInput (Json.mkObj [(\\\"source\\\",source),(\\\"database\\\",toJson template.database),\\n    (\\\"request\\\",toJson (hook / \\\"stdin\\\").toString),(\\\"stdout\\\",toJson (hook / \\\"stdout\\\").toString),\\n    (\\\"timing\\\",toJson (hook / \\\"record.json\\\").toString),(\\\"body\\\",toJson (finalCall / \\\"body.txt\\\").toString)])\\n  let auditReport := root / \\\"audit-report.json\\\"\\n  write auditReport (← NativeTrialAudit.inspect auditInput.toString)\\n  let p : StudyAdmission.Preparation := {\\n    input := ← artifact (hook / \\\"stdin\\\"),stdout := ← artifact (hook / \\\"stdout\\\"),timing := ← artifact (hook / \\\"record.json\\\")\\n    body := ← artifact (finalCall / \\\"body.txt\\\"),state := ← artifact (data / \\\"sessions\\\" / finalSession / \\\"state.json\\\")\\n    shutdown := ← artifact (finalCall / \\\"shutdown.json\\\"),search := ← artifact (qualifiedReceipt / \\\"search.json\\\")\\n    numerical,auditInput := ← artifact auditInput,auditReport := ← artifact auditReport,session := finalSession }\\n  check ((← StudyRuntime.files (.mk template.sourceSnapshot)) == original) \\\"preparation changed the protected source\\\"\\n  let plan := {template with\\n    configuration := ← artifact config,dataRoot := data.toString,environment\\n    databaseFiles := ← StudyRuntime.files (.mk template.database),privateFiles := ← StudyAdmission.tree data,preparation := p}\\n  write (root / \\\"plan.json\\\") (toJson plan)\\n  write (root / \\\"preparation-mode.json\\\") (Json.mkObj [\\n    (\\\"mode\\\",toJson (if live then \\\"persistent-private-history\\\" else \\\"source-only-portability\\\")),\\n    (\\\"dataRoot\\\",toJson data.toString),(\\\"restoredDatabase\\\",toJson (!live))])\\n  return plan\\n\\nend Eggshell.Research.StudyPrepare\\n\",[]]"],["tools.research.StudyRuntime","[\"import Eggshell.Daemon\\nimport Eggshell.SynapseBuild\\nimport tools.research.ArtifactHash\\n\\nopen Lean Eggshell\\n\\nnamespace Eggshell.Research.StudyRuntime\\n\\nprivate def check (condition : Bool) (message : String) : IO Unit :=\\n  unless condition do throw (IO.userError message)\\n\\nprivate def readJson (path : System.FilePath) : IO Json := do\\n  IO.ofExcept (Json.parse (← IO.FS.readFile path))\\n\\nprivate def writeJson (path : System.FilePath) (value : Json) : IO Unit := do\\n  check (!(← path.pathExists)) \\\"keep the existing experiment evidence\\\"\\n  IO.FS.writeFile path (value.compress ++ \\\"\\\\n\\\")\\n\\n/-- Only root publication files are copied. Derived directories and private\\nquery/session state cannot enter a checkpoint through this function. -/\\ndef files (directory : System.FilePath) : IO (Array (String × String)) := do\\n  let mut result := #[]\\n  for entry in ← directory.readDir do\\n    let metadata ← entry.path.symlinkMetadata\\n    if metadata.type == .dir then continue\\n    check (metadata.type == .file) \\\"a publication file must be a regular file\\\"\\n    result := result.push (entry.fileName,← ArtifactHash.hex entry.path)\\n  return result.qsort (fun a b => a.1 < b.1)\\n\\ndef inside (parent child : System.FilePath) : Bool :=\\n  let parent := parent.normalize.toString\\n  let child := child.normalize.toString\\n  child == parent || child.startsWith (parent ++ \\\"/\\\")\\n\\ndef checkpoint (source target : System.FilePath) : IO (Array (String × String)) := do\\n  check (source.isAbsolute && target.isAbsolute) \\\"checkpoint needs absolute paths\\\"\\n  Persistence.rejectSymlinkAncestors source\\n  Persistence.rejectSymlinkAncestors target\\n  check (!(inside source target)) \\\"checkpoint must be outside its source database\\\"\\n  check (!(← target.pathExists)) \\\"keep the existing checkpoint\\\"\\n  let snapshot ← DB.PageMap.pin source\\n  let original ← files source\\n  IO.FS.createDirAll target\\n  for (name,_) in original do\\n    -- APFS shares unchanged page extents. No recursive directory copy occurs.\\n    let copied ← IO.Process.output {cmd := \\\"/bin/cp\\\", args := #[\\\"-c\\\", (source / name).toString, (target / name).toString]}\\n    check (copied.exitCode == 0) \\\"publication file copy failed\\\"\\n  let retained ← DB.PageMap.pin source\\n  let saved ← DB.PageMap.pin target\\n  check (snapshot.head == retained.head && snapshot.head == saved.head &&\\n      original == (← files source) && original == (← files target)) \\\"publication changed during checkpoint\\\"\\n  return original\\n\\ndef restore (source target : System.FilePath) : IO Unit := do\\n  check (source.isAbsolute && target.isAbsolute) \\\"restore needs absolute paths\\\"\\n  Persistence.rejectSymlinkAncestors source\\n  Persistence.rejectSymlinkAncestors target\\n  check (!(inside target source)) \\\"restoring must not remove the protected seed\\\"\\n  if ← target.pathExists then\\n    check ((← target.symlinkMetadata).type == .dir) \\\"active database must be a directory\\\"\\n    let _ ← DB.PageMap.pin target\\n    pure ()\\n  let pending := System.FilePath.mk (target.toString ++ \\\".restoring\\\")\\n  let _ ← checkpoint source pending\\n  if ← target.pathExists then IO.FS.removeDirAll target\\n  IO.FS.rename pending target\\n\\nprivate abbrev Child := IO.Process.Child {stdin := .null, stdout := .inherit, stderr := .inherit}\\n\\nprivate def poll (child : Child) (exit : IO.Ref (Option UInt32)) : IO (Option UInt32) := do\\n  if let some code ← exit.get then return some code\\n  let code ← child.tryWait\\n  exit.set code\\n  return code\\n\\nprivate partial def ready (child : Child) (session : String) (path : System.FilePath)\\n    (exit : IO.Ref (Option UInt32)) (deadline : Nat) : IO Plugin.Daemon.Endpoint := do\\n  check ((← poll child exit).isNone) \\\"owned daemon exited before readiness\\\"\\n  if ← path.pathExists then\\n    let endpoint ← IO.ofExcept (fromJson? (α := Plugin.Daemon.Endpoint) (← readJson path))\\n    check (endpoint.pid == child.pid.toNat && endpoint.session == session) \\\"session belongs to another daemon\\\"\\n    return endpoint\\n  check ((← IO.monoMsNow) < deadline) \\\"owned daemon did not become ready\\\"\\n  IO.sleep 5\\n  ready child session path exit deadline\\n\\nprivate partial def stopped (child : Child) (exit : IO.Ref (Option UInt32)) (deadline : Nat) : IO UInt32 := do\\n  if let some code ← poll child exit then return code\\n  check ((← IO.monoMsNow) < deadline) \\\"owned daemon did not exit before the cleanup deadline\\\"\\n  IO.sleep 5\\n  stopped child exit deadline\\n\\nstructure Managed where\\n  private child : Child\\n  private exit : IO.Ref (Option UInt32)\\n  private endpoint : Plugin.Daemon.Endpoint\\n  private path : System.FilePath\\n  private expectedShutdown : String := \\\"\\\"\\n\\ndef startManaged (binary plugin : System.FilePath) (session : String) (path : System.FilePath)\\n    (environment : Array (String × Option String)) : IO Managed := do\\n  let _ ← IO.ofExcept (Plugin.safeSession session)\\n  check (← (plugin / \\\"bin/eggshelld\\\").pathExists) \\\"missing reviewed plugin launcher\\\"\\n  check (!(← path.pathExists)) \\\"a daemon already owns this session\\\"\\n  let child ← IO.Process.spawn {\\n    cmd := binary.toString, args := #[\\\"codex-daemon\\\",session]\\n    env := environment.push (\\\"PLUGIN_ROOT\\\",some plugin.toString)\\n    stdin := .null, stdout := .inherit, stderr := .inherit, setsid := true}\\n  let exit ← IO.mkRef none\\n  try\\n    let endpoint ← ready child session path exit ((← IO.monoMsNow) + 10000)\\n    return {child,exit,endpoint,path}\\n  catch error =>\\n    if (← poll child exit).isNone then\\n      Plugin.Worker.killGroup child\\n      let _ ← child.wait\\n      pure ()\\n    throw error\\n\\n/-- The study owns this child directly, before any model turn starts. It does\\nnot infer ownership from a shared endpoint or terminate another chat's service.\\nPublication startup prepares no source DB, vectors or answering context. -/\\ndef startPublisher (binary dataRoot : System.FilePath)\\n    (environment : Array (String × Option String)) (recoverDead : Bool := false) : IO Managed := do\\n  let dataRoot := dataRoot.normalize\\n  check (binary.isAbsolute && dataRoot.isAbsolute && dataRoot.toString != \\\"/\\\")\\n    \\\"absolute isolated publisher paths required\\\"\\n  check ((environment.filter (·.1 == \\\"EGGSHELL_DATA_ROOT\\\")) ==\\n    #[(\\\"EGGSHELL_DATA_ROOT\\\",some dataRoot.toString)]) \\\"publisher environment differs from its isolated scope\\\"\\n  FileSystem.rejectSymlinkAncestors dataRoot\\n  let path := dataRoot / \\\"publisher/endpoint.json\\\"\\n  if recoverDead then\\n    Persistence.withLockWithin (dataRoot / \\\"publisher/starting\\\") 10000 do\\n      if let some metadata ← FileSystem.symlinkMetadata? path then\\n        check (metadata.type == .file) \\\"stale publisher endpoint is not a regular file\\\"\\n        let endpoint ← IO.ofExcept (fromJson? (α := Plugin.Daemon.Endpoint) (← readJson path))\\n        check (endpoint.session == \\\"publisher\\\" && !(← Numerical.alive endpoint.pid))\\n          \\\"cannot recover an endpoint whose publisher is still alive\\\"\\n        IO.FS.removeFile path\\n        IO.println (Json.mkObj [(\\\"recoveredDeadStudyPublisherPid\\\",toJson endpoint.pid)]).compress\\n  check ((← FileSystem.symlinkMetadata? path).isNone) \\\"a publisher already owns this study scope\\\"\\n  let child ← IO.Process.spawn {\\n    cmd := binary.toString,args := #[\\\"codex-publication-daemon\\\"],env := environment\\n    stdin := .null,stdout := .inherit,stderr := .inherit,setsid := true }\\n  let exit ← IO.mkRef none\\n  try\\n    let endpoint ← ready child \\\"publisher\\\" path exit ((← IO.monoMsNow)+10000)\\n    check (endpoint.compatible (← Plugin.Publication.generation))\\n      \\\"publisher implementation differs from the frozen protocol\\\"\\n    let pong ← Plugin.Daemon.exchange endpoint \\\"ping\\\" (budget := 1000)\\n    check (pong == \\\"true\\\") \\\"owned publisher rejected readiness\\\"\\n    return {child,exit,endpoint,path,expectedShutdown := \\\"true\\\"}\\n  catch error =>\\n    if (← poll child exit).isNone then\\n      Plugin.Worker.killGroup child\\n      let _ ← child.wait\\n      pure ()\\n    throw error\\n\\ndef abort (managed : Managed) : IO Unit := do\\n  if (← poll managed.child managed.exit).isNone then\\n    Plugin.Worker.killGroup managed.child\\n    let code ← managed.child.wait\\n    managed.exit.set (some code)\\n\\ndef pid (managed : Managed) : Nat := managed.endpoint.pid\\n\\n/-- Acknowledgement and actual owned-child exit are separate conditions. -/\\ndef stopManaged (managed : Managed) (report : System.FilePath) : IO Unit := do\\n  check (!(← report.pathExists)) \\\"keep the existing supervisor result\\\"\\n  try\\n    let current ← IO.ofExcept (fromJson? (α := Plugin.Daemon.Endpoint) (← readJson managed.path))\\n    check (current.pid == managed.endpoint.pid && current.secret == managed.endpoint.secret) \\\"owned daemon was replaced\\\"\\n    let acknowledged ← Plugin.Daemon.exchange managed.endpoint \\\"shutdown\\\"\\n      (budget := if managed.expectedShutdown.isEmpty then 500 else 5000)\\n    check (acknowledged == managed.expectedShutdown) \\\"owned process rejected shutdown\\\"\\n    let stopStarted ← IO.monoMsNow\\n    let code ← stopped managed.child managed.exit (stopStarted + 15000)\\n    let removed := !(← managed.path.pathExists)\\n    let result := Json.mkObj [(\\\"phase\\\",toJson \\\"stopped\\\"),(\\\"pid\\\",toJson managed.endpoint.pid),\\n      (\\\"daemonExitCode\\\",toJson code.toNat),(\\\"endpointRemoved\\\",toJson removed),\\n      (\\\"processExited\\\",toJson true),\\n      (\\\"stopElapsedMs\\\",toJson ((← IO.monoMsNow)-stopStarted)),(\\\"acknowledged\\\",toJson true),\\n      (\\\"service\\\",toJson (if managed.expectedShutdown.isEmpty then \\\"session\\\" else \\\"publication\\\"))]\\n    writeJson report result\\n    check (code == 0 && removed) \\\"owned daemon did not stop cleanly\\\"\\n  catch error =>\\n    if !(← report.pathExists) then\\n      writeJson report (Json.mkObj [(\\\"phase\\\",toJson \\\"failed\\\"),(\\\"error\\\",toJson error.toString)])\\n    throw error\\n  finally\\n    abort managed\\n\\ndef supervise (binary plugin : System.FilePath) (session : String) (report : System.FilePath) : IO UInt32 := do\\n  check (!(← report.pathExists)) \\\"keep the existing supervisor result\\\"\\n  let path ← Plugin.Daemon.endpointPath session\\n  let managed ← startManaged binary plugin session path #[]\\n  try\\n    let stdout ← IO.getStdout\\n    stdout.putStr ((Json.mkObj [(\\\"phase\\\",toJson \\\"ready\\\"),(\\\"pid\\\",toJson (pid managed))]).compress ++ \\\"\\\\n\\\")\\n    stdout.flush\\n    let command ← IO.ofExcept (Json.parse (← (← IO.getStdin).getLine))\\n    check ((command.getObjValAs? String \\\"command\\\").toOption == some \\\"shutdown\\\") \\\"expected supervisor shutdown\\\"\\n    stopManaged managed report\\n    return 0\\n  finally abort managed\\n\\ndef cliMain (args : List String) : IO UInt32 := do\\n  try\\n    match args with\\n    | [\\\"checkpoint\\\",source,target,report] =>\\n        if ← (System.FilePath.mk report).pathExists then throw (IO.userError \\\"keep the existing checkpoint report\\\")\\n        let files ← Eggshell.Research.StudyRuntime.checkpoint (.mk source) (.mk target)\\n        IO.FS.writeFile (.mk report) ((toJson files).compress ++ \\\"\\\\n\\\")\\n        return 0\\n    | [\\\"restore\\\",source,target] =>\\n        Eggshell.Research.StudyRuntime.restore (.mk source) (.mk target)\\n        return 0\\n    | [\\\"supervise\\\",binary,plugin,session,report] =>\\n        Eggshell.Research.StudyRuntime.supervise (.mk binary) (.mk plugin) session (.mk report)\\n    | _ => throw (IO.userError \\\"StudyRuntime checkpoint SOURCE TARGET REPORT | restore SOURCE TARGET | supervise BINARY PLUGIN SESSION REPORT\\\")\\n  catch error =>\\n    IO.eprintln error.toString\\n    return 1\\n\\nend Eggshell.Research.StudyRuntime\\n\",[]]"],["tools.research.StudySeedChecks","[\"import tools.research.StudyPrepare\\nimport Eggshell.SynapseLive\\nimport Eggshell.ContentMetadata\\n\\nopen Lean Eggshell Eggshell.Synapses\\nopen Eggshell.Research\\n\\nnamespace Eggshell.Research.StudySeedChecks\\n\\nstructure Input where\\n  runtime : StudyAdmission.Artifact\\n  pluginRoot : String\\n  pluginFiles : Array StudyAdmission.Artifact\\n  environment : Array (String × Option String)\\n  deriving FromJson, ToJson\\n\\nprivate def check (condition : Bool) (message : String) : IO Unit :=\\n  unless condition do throw (IO.userError message)\\n\\nprivate def replaceEnv (original updates : Array (String × Option String)) :=\\n  original.filter (fun row => !updates.any (·.1 == row.1)) ++ updates\\n\\nprivate def save (path : System.FilePath) (value : Json) : IO Unit :=\\n  IO.FS.writeFile path (value.compress ++ \\\"\\\\n\\\")\\n\\nprivate def config (binary database : String) : String :=\\n  \\\"default = \\\\\\\"work\\\\\\\"\\\\nsemantic_matcher = \\\" ++\\n  (toJson #[binary,\\\"search-provider\\\"]).compress ++ \\\"\\\\n[eggs]\\\\nwork = \\\" ++\\n  (toJson database).compress ++ \\\"\\\\n[profiles.work]\\\\nread = [\\\\\\\"work\\\\\\\"]\\\\nwrite = \\\\\\\"work\\\\\\\"\\\\nhandoff_chars = 120000\\\\n\\\"\\n\\nprivate def origins (database : System.FilePath) (count : Nat) : IO Unit := do\\n  let deadline := (← IO.monoMsNow)+20000\\n  repeat\\n    let snapshot ← DB.PageMap.pin database\\n    if (← Provenance.records snapshot).size == count then return\\n    check ((← IO.monoMsNow) < deadline) \\\"actual save worker did not publish every tool origin\\\"\\n    IO.sleep 25\\n\\nprivate def facts (database : System.FilePath) (ready : Array Fact → Bool) : IO (Array Fact) := do\\n  let deadline := (← IO.monoMsNow)+20000\\n  repeat\\n    let snapshot ← DB.PageMap.pin database\\n    if let some reader ← Index.open? snapshot .database .shared then\\n      let all ← Index.allFacts reader.index\\n      if ready all then return all\\n    check ((← IO.monoMsNow) < deadline) \\\"actual index worker did not publish the expected synaptic facts\\\"\\n    IO.sleep 25\\n\\nprivate def isConsumption : Fact → Bool\\n  | .consumed edge => edge.consumer.useId == \\\"consume\\\" && edge.producer.useId == \\\"read\\\" &&\\n      edge.rows.any (·.first == 11)\\n  | _ => false\\n\\nprivate def supported : Fact → Bool\\n  | .supports _ => true\\n  | _ => false\\n\\nprivate def coquoted : Fact → Bool\\n  | .coquoted _ _ => true\\n  | _ => false\\n\\nprivate def genericAliases (source : DB.PageMap.Snapshot) : IO Nat := do\\n  let reader ← Persistence.Store.NodeReader.new source\\n  let origins ← Provenance.records source\\n  let some origin := origins.find? (fun row => row.origin.occurrence.useId == \\\"generic\\\") |\\n    throw (IO.userError \\\"generic native output was not published\\\")\\n  let document ← Provenance.checkedDocument reader origin.origin\\n  let some capture ← ContentMetadata.load? source origin.origin.owner document |\\n    throw (IO.userError \\\"generic output lost its atomic correspondence status\\\")\\n  check (capture.complete && capture.aliases.size == 15)\\n    \\\"actual arbitrary provider did not preserve all unique literal file lines\\\"\\n  let catalog ← IO.ofExcept (ContentMetadata.catalog source.head.identity document capture)\\n  check (catalog.located.size == 15) \\\"native aliases did not reach the original coordinate catalog\\\"\\n  return capture.aliases.size\\n\\n/-- The wanted quote is strictly inside an original spelling, not equal to a\\nwhole saved record or supported through a file-coordinate citation. -/\\nprivate def literalSupport (source : DB.PageMap.Snapshot) (facts : Array Fact)\\n    (wanted : String) : IO Bool := do\\n  let reader ← Persistence.Store.NodeReader.new source\\n  for fact in facts do\\n    let .supports support := fact | continue\\n    if support.source.file?.isSome || support.read.quotations.contains (Quotes.digest wanted) then continue\\n    let some id ← Build.ownerId? source support.binding.owner | continue\\n    let doc ← Build.document reader id\\n    let some raw := doc.source | continue\\n    let text := String.ofList ((raw.toList.drop support.binding.first).take\\n      (support.binding.limit-support.binding.first))\\n    if (text.splitOn wanted).length > 1 then return true\\n  return false\\n\\n/-- Freeze required DB-present source rows before a new chat's real hook runs.\\nThis is a small model-free check of the audit wiring, not the recall study. -/\\nprivate def recall (plan : Input) (root source : System.FilePath)\\n    (environment : Array (String × Option String)) : IO Unit := do\\n  let snapshot := root / \\\"recall-source.egg\\\"\\n  let files ← StudyRuntime.checkpoint source snapshot\\n  let question := \\\"Show the saved source evidence for NEEDED_SYMBOL and OTHER_SYMBOL.\\\"\\n  let frozen := Json.mkObj [\\n    (\\\"source\\\",toJson snapshot.toString),(\\\"workspace\\\",toJson root.toString),(\\\"prompt\\\",toJson question),\\n    (\\\"files\\\",toJson files),(\\\"required\\\",toJson #[\\n      Json.mkObj [(\\\"name\\\",toJson \\\"needed-symbol\\\"),(\\\"path\\\",toJson \\\"src/source.cpp\\\"),\\n        (\\\"first\\\",toJson (11 : Nat)),(\\\"last\\\",toJson (11 : Nat))],\\n      Json.mkObj [(\\\"name\\\",toJson \\\"other-symbol\\\"),(\\\"path\\\",toJson \\\"src/source.cpp\\\"),\\n        (\\\"first\\\",toJson (14 : Nat)),(\\\"last\\\",toJson (14 : Nat))]])]\\n  save (root / \\\"recall-required-before-delivery.json\\\") frozen\\n  let configuration := root / \\\"recall-config.toml\\\"\\n  IO.FS.writeFile configuration (\\\"default = \\\\\\\"work\\\\\\\"\\\\nsemantic_matcher = \\\" ++\\n    (toJson #[plan.runtime.path,\\\"search-provider\\\"]).compress ++ \\\"\\\\n[eggs]\\\\nwork = \\\" ++\\n    (toJson source.toString).compress ++ \\\"\\\\n[profiles.work]\\\\nread = [\\\\\\\"work\\\\\\\"]\\\\nhandoff_chars = 120000\\\\n\\\")\\n  let data := root / \\\"recall-data\\\"\\n  IO.FS.createDir data\\n  let session := \\\"native-recall-preflight\\\"\\n  let environment := replaceEnv environment #[\\n    (\\\"EGGSHELL_DATA_ROOT\\\",some data.toString),(\\\"EGGSHELL_CONFIG\\\",some configuration.toString),\\n    (\\\"CODEX_THREAD_ID\\\",none),(\\\"CODEX_TURN_ID\\\",none)]\\n  let warm ← StudyCommand.run plan.runtime.path #[\\\"egg\\\",\\\"warm\\\",\\\"work\\\"] environment root.toString \\\"\\\"\\n    (root / \\\"recall-warm\\\") 60000\\n  check (warm.exitCode == 0) \\\"readonly recall source was not warmed\\\"\\n  let publisher ← StudyRuntime.startPublisher (.mk plan.runtime.path) data environment\\n  let managed ← try\\n    StudyRuntime.startManaged (.mk plan.runtime.path) (.mk plan.pluginRoot) session\\n      (data / \\\"sessions\\\" / session / \\\"daemon.json\\\") environment\\n    catch error =>\\n      StudyRuntime.stopManaged publisher (root / \\\"recall-publisher-shutdown.json\\\")\\n      throw error\\n  let command := root / \\\"recall-hook\\\"\\n  try\\n    let input := Json.mkObj [(\\\"hook_event_name\\\",toJson \\\"UserPromptSubmit\\\"),\\n      (\\\"session_id\\\",toJson session),(\\\"turn_id\\\",toJson \\\"recall-turn\\\"),(\\\"cwd\\\",toJson root.toString),\\n      (\\\"prompt\\\",toJson question),(\\\"_eggshell_config\\\",toJson configuration.toString)]\\n    let output ← StudyCommand.run plan.runtime.path #[\\\"codex-hook\\\"] environment root.toString\\n      (input.compress ++ \\\"\\\\n\\\") command 35000\\n    check (output.exitCode == 0) \\\"readonly recall hook failed\\\"\\n    let reply ← IO.ofExcept (Json.parse output.stdout)\\n    let body := (reply.getObjVal? \\\"hookSpecificOutput\\\" >>= (·.getObjValAs? String \\\"additionalContext\\\")).toOption.getD \\\"\\\"\\n    IO.FS.writeFile (root / \\\"recall-body.txt\\\") body\\n  finally\\n    try StudyRuntime.stopManaged managed (root / \\\"recall-shutdown.json\\\")\\n    finally StudyRuntime.stopManaged publisher (root / \\\"recall-publisher-shutdown.json\\\")\\n  let audit := Json.mkObj [(\\\"source\\\",frozen),(\\\"database\\\",toJson source.toString),\\n    (\\\"request\\\",toJson (command / \\\"stdin\\\").toString),(\\\"stdout\\\",toJson (command / \\\"stdout\\\").toString),\\n    (\\\"timing\\\",toJson (command / \\\"record.json\\\").toString),(\\\"body\\\",toJson (root / \\\"recall-body.txt\\\").toString)]\\n  save (root / \\\"recall-audit-input.json\\\") audit\\n  let report ← NativeTrialAudit.inspect (root / \\\"recall-audit-input.json\\\").toString\\n  save (root / \\\"recall-audit.json\\\") report\\n  let result ← IO.ofExcept (report.getObjVal? \\\"requiredDelivery\\\")\\n  check ((result.getObjValAs? Nat \\\"eligible\\\").toOption == some 2) \\\"recall denominator lacks frozen DB-present originals\\\"\\n  check ((result.getObjValAs? Bool \\\"targetMet\\\").toOption == some true) \\\"actual readonly hook omitted required fixture evidence\\\"\\n\\n/-- The fixture writes no relations. Only real hooks, a real shell, the save\\nworker and the index worker may create its observations and consumption. -/\\ndef run (templatePath directory : String) (remote : Bool := false)\\n    (literal : Bool := false) (generic : Bool := false) : IO Unit := do\\n  let plan ← IO.ofExcept (fromJson? (α := Input) (← StudyAdmission.readJson templatePath))\\n  StudyAdmission.verifyArtifact plan.runtime\\n  for artifact in plan.pluginFiles do StudyAdmission.verifyArtifact artifact\\n  let root := System.FilePath.mk directory\\n  check (root.isAbsolute && !(← root.pathExists)) \\\"a new absolute fixture directory is required\\\"\\n  check ((← IO.getEnv \\\"EGGSHELL_DATA_ROOT\\\") == some (root / \\\"data\\\").toString)\\n    \\\"fixture observer and native hooks need the same isolated private data root\\\"\\n  Persistence.rejectSymlinkAncestors root\\n  IO.FS.createDir root\\n  IO.FS.createDir (root / \\\"data\\\")\\n  IO.FS.createDir (root / \\\"src\\\")\\n  let lines := (List.range 10).map (fun i => s!\\\"prefix_{i+1}\\\") ++\\n    [\\\"NEEDED_SYMBOL\\\", \\\"alpha\\\", \\\"beta\\\", \\\"OTHER_SYMBOL\\\", \\\"omega\\\"]\\n  IO.FS.writeFile (root / \\\"src/source.cpp\\\") (\\\"\\\\n\\\".intercalate lines ++ \\\"\\\\n\\\")\\n  let database := root / \\\"work.egg\\\"\\n  let initial ← DB.PageMap.create database (Persistence.valueToJson (.text \\\"native-seed-fixture\\\")).compress\\n  check ((← Build.entries initial).isEmpty) \\\"synthetic seed did not start with an empty database\\\"\\n  let configuration := root / \\\"config.toml\\\"\\n  IO.FS.writeFile configuration (config plan.runtime.path database.toString)\\n  let session := \\\"native-empty-seed\\\"\\n  let turn := \\\"seed-turn\\\"\\n  let environment := replaceEnv plan.environment #[\\n    (\\\"EGGSHELL_DATA_ROOT\\\",some (root / \\\"data\\\").toString),\\n    (\\\"EGGSHELL_CONFIG\\\",some configuration.toString),(\\\"EGGSHELL_PROFILE\\\",some \\\"work\\\"),\\n    (\\\"CODEX_THREAD_ID\\\",some session),(\\\"CODEX_TURN_ID\\\",some turn)]\\n  let call := fun label args input => do\\n    let result ← StudyCommand.run plan.runtime.path args environment root.toString input (root / label) 35000\\n    check (result.exitCode == 0 && result.elapsedMs < 30000) s!\\\"native {label} failed or expired: {result.stderr}\\\"\\n    return result\\n  let hook := fun label fields => do\\n    let input := Json.mkObj ([(\\\"session_id\\\",toJson session),(\\\"turn_id\\\",toJson turn),\\n      (\\\"cwd\\\",toJson root.toString),(\\\"_eggshell_config\\\",toJson configuration.toString)] ++ fields)\\n    let result ← call label #[\\\"codex-hook\\\"] (input.compress ++ \\\"\\\\n\\\")\\n    let _ ← IO.ofExcept (Json.parse result.stdout)\\n    pure ()\\n  let endpoint := root / \\\"data/sessions\\\" / session / \\\"daemon.json\\\"\\n  let publisher ← StudyRuntime.startPublisher (.mk plan.runtime.path) (root / \\\"data\\\") environment\\n  let managed ← try\\n    StudyRuntime.startManaged (.mk plan.runtime.path) (.mk plan.pluginRoot) session endpoint environment\\n    catch error =>\\n      StudyRuntime.stopManaged publisher (root / \\\"publisher-shutdown.json\\\")\\n      throw error\\n  try\\n    hook \\\"SessionStart\\\" [(\\\"hook_event_name\\\",toJson \\\"SessionStart\\\")]\\n    hook \\\"UserPromptSubmit\\\" [(\\\"hook_event_name\\\",toJson \\\"UserPromptSubmit\\\"),\\n      (\\\"prompt\\\",toJson \\\"inspect the source symbols and their recorded evidence\\\")]\\n    let commands := #[\\n      (\\\"read\\\", \\\"nl -ba src/source.cpp | sed -n '10p;11,12p' && nl -ba src/source.cpp | sed -n '14p'\\\"),\\n      (\\\"consume\\\", \\\"printf NEEDED_SYMBOL\\\"),\\n      (\\\"other\\\", \\\"nl -ba src/source.cpp | sed -n '13,15p'\\\"),\\n      (\\\"reread\\\", \\\"nl -ba src/source.cpp | sed -n '10,12p'\\\")]\\n    let remoteCalls : Array Plugin.ToolEvent := if !remote then #[] else #[\\n      {name := \\\"mcp__catalog__lookup\\\",useId := \\\"remote-lookup\\\",input := \\\"{}\\\"\\n       response := (toJson #[Json.mkObj [(\\\"id\\\",toJson \\\"RECORD_42\\\"),\\n          (\\\"uri\\\",toJson \\\"smb://customer/logs/boot.txt\\\")]]).compress},\\n      {name := \\\"mcp__catalog__inspect\\\",useId := \\\"remote-inspect\\\"\\n       input := (Json.mkObj [(\\\"request\\\",Json.mkObj [(\\\"record\\\",toJson \\\"RECORD_42\\\")])]).compress\\n       response := (Json.mkObj [(\\\"status\\\",toJson \\\"available\\\")]).compress}]\\n    let toolCount := commands.size+remoteCalls.size+(if generic then 1 else 0)\\n    let remoteConsumption := fun all => !remote || all.any (fun fact => match fact with\\n      | .consumed edge => edge.producer.useId == \\\"remote-lookup\\\" && edge.consumer.useId == \\\"remote-inspect\\\" &&\\n          edge.kind == .value && edge.term == (toJson \\\"RECORD_42\\\").compress && !edge.rows.isEmpty\\n      | _ => false)\\n    for index in [:commands.size] do\\n      let (useId, command) := commands[index]!\\n      let input := Json.mkObj [(\\\"command\\\",toJson command)]\\n      let fields := [(\\\"tool_name\\\",toJson \\\"shell\\\"),(\\\"tool_use_id\\\",toJson useId),(\\\"tool_input\\\",input)]\\n      hook (useId ++ \\\"-Pre\\\") (fields ++ [(\\\"hook_event_name\\\",toJson \\\"PreToolUse\\\")])\\n      let actual ← StudyCommand.run \\\"/bin/sh\\\" #[\\\"-c\\\",command] environment root.toString \\\"\\\"\\n        (root / (useId ++ \\\"-actual\\\")) 5000\\n      check (actual.exitCode == 0) \\\"fixture shell command failed\\\"\\n      hook (useId ++ \\\"-Post\\\") (fields ++ [(\\\"hook_event_name\\\",toJson \\\"PostToolUse\\\"),\\n        (\\\"tool_response\\\",Json.mkObj [(\\\"output\\\",toJson actual.stdout),(\\\"exitCode\\\",toJson actual.exitCode)])])\\n      origins database (index+1)\\n    for (tool,index) in remoteCalls.zipIdx do\\n      let fields := [(\\\"tool_name\\\",toJson tool.name),(\\\"tool_use_id\\\",toJson tool.useId),\\n        (\\\"tool_input\\\",← IO.ofExcept (Json.parse tool.input))]\\n      hook (tool.useId ++ \\\"-Pre\\\") (fields ++ [(\\\"hook_event_name\\\",toJson \\\"PreToolUse\\\")])\\n      hook (tool.useId ++ \\\"-Post\\\") (fields ++ [(\\\"hook_event_name\\\",toJson \\\"PostToolUse\\\"),\\n        (\\\"tool_response\\\",← IO.ofExcept (Json.parse tool.response))])\\n      origins database (commands.size+index+1)\\n    if generic then\\n      let command := \\\"awk '{print FILENAME \\\\\\\":\\\\\\\" NR \\\\\\\":\\\\\\\" $0}' src/source.cpp\\\"\\n      let input := Json.mkObj [(\\\"opaque_job\\\",toJson command)]\\n      let fields := [(\\\"tool_name\\\",toJson \\\"arbitrary_provider\\\"),(\\\"tool_use_id\\\",toJson \\\"generic\\\"),\\n        (\\\"tool_input\\\",input)]\\n      hook \\\"generic-Pre\\\" (fields ++ [(\\\"hook_event_name\\\",toJson \\\"PreToolUse\\\")])\\n      let actual ← StudyCommand.run \\\"/bin/sh\\\" #[\\\"-c\\\",command] environment root.toString \\\"\\\"\\n        (root / \\\"generic-actual\\\") 5000\\n      check (actual.exitCode == 0) \\\"generic fixture command failed\\\"\\n      hook \\\"generic-Post\\\" (fields ++ [(\\\"hook_event_name\\\",toJson \\\"PostToolUse\\\"),\\n        (\\\"tool_response\\\",Json.mkObj [(\\\"opaque_result\\\",toJson actual.stdout)])])\\n      origins database toolCount\\n    let answer := if literal then\\n        \\\"The symbol `NEEDED_SYMBOL` and remote location `customer/logs` are supported by [first](src/source.cpp:11) and [second](src/source.cpp:14).\\\"\\n      else \\\"The symbols are supported by [first](src/source.cpp:11) and [second](src/source.cpp:14).\\\"\\n    hook \\\"Stop\\\" [(\\\"hook_event_name\\\",toJson \\\"Stop\\\"),(\\\"last_assistant_message\\\",toJson answer)]\\n    let _ ← call \\\"keep\\\" #[\\\"egg\\\",\\\"keep\\\"] \\\"\\\"\\n    let all ← facts database fun all => all.any isConsumption && all.any supported && all.any coquoted && remoteConsumption all\\n    let snapshot ← DB.PageMap.pin database\\n    if literal then\\n      for wanted in [\\\"NEEDED_SYMBOL\\\",\\\"customer/logs\\\"] do\\n        check (← literalSupport snapshot all wanted) s!\\\"original substring quote lost its support: {wanted}\\\"\\n    let stored ← Provenance.records snapshot\\n    check (stored.size == toolCount && stored.all (fun row => row.origin.valid && row.origin.occurrence.session == session))\\n      \\\"native origins lost their source or temporal binding\\\"\\n    let sourceReader ← Persistence.Store.NodeReader.new snapshot\\n    let capturedAliases ← if generic then genericAliases snapshot else pure 0\\n    let mut checkedRows := 0\\n    for origin in stored do\\n      if origin.origin.occurrence.useId != \\\"read\\\" then continue\\n      let document ← Provenance.checkedDocument sourceReader origin.origin\\n      let rows ← IO.ofExcept (Extraction.recordedRows snapshot.head.identity document)\\n      check (rows.map (·.source.first) == #[10,11,12,14])\\n        \\\"actual conditional read lost coordinates or filled a gap\\\"\\n      checkedRows := checkedRows+rows.size\\n    check (checkedRows == 4) \\\"conditional read was not checked in the saved source\\\"\\n    let journal ← Journal.prepare snapshot\\n    let entries ← Journal.turnEntries journal ⟨session,turn⟩\\n    check (entries.size == toolCount*2+1) \\\"native Pre/Post/Stop journal is incomplete\\\"\\n    let mut usage : Array Fact := #[]\\n    if let some reader ← Index.open? snapshot .user .usage then usage ← Index.allFacts reader.index\\n    save (root / \\\"facts.json\\\") (toJson all)\\n    save (root / \\\"origins.json\\\") (toJson (stored.map (·.origin)))\\n    save (root / \\\"usage.json\\\") (toJson usage)\\n    save (root / \\\"result.json\\\") (Json.mkObj [\\n      (\\\"runtime\\\",toJson plan.runtime),(\\\"emptyInitialDatabase\\\",toJson true),\\n      (\\\"actualShellCalls\\\",toJson (commands.size+(if generic then 1 else 0))),\\n      (\\\"genericContentAliases\\\",toJson capturedAliases),(\\\"McpShapedHookPairs\\\",toJson remoteCalls.size),\\n      (\\\"realMcpServerUsed\\\",toJson false),(\\\"nativeToolCalls\\\",toJson toolCount),\\n      (\\\"nativeJournalEvents\\\",toJson entries.size),\\n      (\\\"portableOrigins\\\",toJson stored.size),(\\\"consumptionWitnesses\\\",toJson (all.filter isConsumption).size),\\n      (\\\"conditionalReadRows\\\",toJson checkedRows),\\n      (\\\"literalSubstringChecks\\\",toJson (if literal then 2 else (0 : Nat))),\\n      (\\\"supports\\\",toJson (all.filter supported).size),(\\\"coquoted\\\",toJson (all.filter coquoted).size),\\n      (\\\"privateUsage\\\",toJson usage.size),(\\\"answeringModelCalls\\\",toJson (0 : Nat)),\\n      (\\\"directRelationInsertions\\\",toJson (0 : Nat))])\\n  finally\\n    try StudyRuntime.stopManaged managed (root / \\\"shutdown.json\\\")\\n    finally StudyRuntime.stopManaged publisher (root / \\\"publisher-shutdown.json\\\")\\n  let copied := root / \\\"output.egg\\\"\\n  let publication ← StudyRuntime.checkpoint database copied\\n  save (root / \\\"publication-files.json\\\") (toJson publication)\\n  let recoveryData := root / \\\"recovery-data\\\"\\n  IO.FS.createDir recoveryData\\n  let recoveryConfig := root / \\\"recovery-config.toml\\\"\\n  IO.FS.writeFile recoveryConfig (config plan.runtime.path copied.toString)\\n  let recoveredEnvironment := replaceEnv environment #[\\n    (\\\"EGGSHELL_DATA_ROOT\\\",some recoveryData.toString),(\\\"EGGSHELL_CONFIG\\\",some recoveryConfig.toString),\\n    (\\\"CODEX_THREAD_ID\\\",none),(\\\"CODEX_TURN_ID\\\",none)]\\n  let warmed ← StudyCommand.run plan.runtime.path #[\\\"egg\\\",\\\"warm\\\",\\\"work\\\"] recoveredEnvironment root.toString \\\"\\\"\\n    (root / \\\"recover-warm\\\") 60000\\n  check (warmed.exitCode == 0) \\\"source-only seed could not be warmed without its old private state\\\"\\n  let recovered ← facts copied fun all => all.any isConsumption && all.any supported && all.any coquoted\\n  if generic then\\n    check ((← genericAliases (← DB.PageMap.pin copied)) == 15)\\n      \\\"source-only recovery lost command-independent coordinates\\\"\\n  if literal then\\n    for wanted in [\\\"NEEDED_SYMBOL\\\",\\\"customer/logs\\\"] do\\n      check (← literalSupport (← DB.PageMap.pin copied) recovered wanted)\\n        s!\\\"source-only reconstruction lost substring support: {wanted}\\\"\\n  check ((← StudyRuntime.files copied) == publication) \\\"recovering derived synapses changed the source publication\\\"\\n  save (root / \\\"recovery.json\\\") (Json.mkObj [\\n    (\\\"runtime\\\",toJson plan.runtime),(\\\"sourceOnlyCheckpoint\\\",toJson true),\\n    (\\\"newPrivateRoot\\\",toJson true),(\\\"publicationUnchanged\\\",toJson true),\\n    (\\\"consumptionWitnesses\\\",toJson (recovered.filter isConsumption).size),\\n    (\\\"supports\\\",toJson (recovered.filter supported).size),\\n    (\\\"coquoted\\\",toJson (recovered.filter coquoted).size)])\\n  if remote then recall plan root copied environment\\n\\ndef cliMain (args : List String) : IO UInt32 := do\\n  try\\n    let [template,directory] := args | throw (IO.userError \\\"StudySeedChecks TEMPLATE NEW-DIRECTORY\\\")\\n    Eggshell.Research.StudySeedChecks.run template directory\\n    return 0\\n  catch error =>\\n    IO.eprintln error.toString\\n    return 1\\n\\nend Eggshell.Research.StudySeedChecks\\n\",[]]"],["tools.research.StudyTransport","[\"import Lean.Data.Json\\nimport Std.Sync.Mutex\\nimport Init.Data.Queue\\nimport tools.research.ResourceGuard\\nimport tools.research.StudyEnvironment\\n\\nopen Lean\\n\\nnamespace Eggshell.Research.StudyTransport\\n\\ninductive Access where\\n  | inspect | generate\\n  deriving DecidableEq\\n\\ninductive ReadMethod where\\n  | initialize | models | hooks\\n\\ninductive RunMethod where\\n  | threadStart | turnStart | unsubscribe | interrupt\\n\\ninductive Request : Access → Type where\\n  | read (method : ReadMethod) : Request access\\n  | run (method : RunMethod) : Request .generate\\n\\ndef Request.method : Request access → String\\n  | .read .initialize => \\\"initialize\\\"\\n  | .read .models => \\\"model/list\\\"\\n  | .read .hooks => \\\"hooks/list\\\"\\n  | .run .threadStart => \\\"thread/start\\\"\\n  | .run .turnStart => \\\"turn/start\\\"\\n  | .run .unsubscribe => \\\"thread/unsubscribe\\\"\\n  | .run .interrupt => \\\"turn/interrupt\\\"\\n\\ntheorem inspection_cannot_start_turn (request : Request .inspect) :\\n    request.method ≠ \\\"turn/start\\\" := by\\n  cases request with\\n  | read method => cases method <;> decide\\n\\nstructure Settings where\\n  command : Array String\\n  cwd : String\\n  environment : Array (String × Option String)\\n  output : String\\n  timeoutMs : Nat\\n  responseBytes : Nat\\n  transcriptBytes : Nat\\n  deriving FromJson\\n\\nprivate structure Inbox where\\n  pending : Std.Queue (Json × Nat) := .empty\\n  count : Nat := 0\\n  bytes : Nat := 0\\n  error : Option String := none\\n  closed : Bool := false\\n  stopping : Bool := false\\n\\nprivate structure Transcript where\\n  handle : IO.FS.Handle\\n  bytes : Nat := 0\\n  largest : Nat := 0\\n\\nprivate abbrev Reader := Task (Except IO.Error Unit)\\nprivate abbrev Child := IO.Process.Child {stdin := .null, stdout := .piped, stderr := .piped}\\n\\nstructure Client (access : Access) where\\n  private settings : Settings\\n  private child : Child\\n  private input : IO.Ref (Option IO.FS.Handle)\\n  private stdoutReader : Reader\\n  private stderrReader : Reader\\n  private writer : IO.Ref (Option Reader)\\n  private inbox : Std.Mutex Inbox\\n  private transcript : Std.Mutex Transcript\\n  private nextId : IO.Ref Nat\\n  private notices : IO.Ref (Array Json)\\n  private exit : IO.Ref (Option UInt32)\\n  private family : IO.Ref (Std.HashMap Nat String)\\n  private monitor : Nat\\n\\nprivate def record (settings : Settings) (transcript : Std.Mutex Transcript)\\n    (direction : String) (message : Json) (size : Nat := 0) : IO Unit := do\\n  let row := Json.mkObj [(\\\"direction\\\",toJson direction),(\\\"message\\\",message),\\n    (\\\"monotonic_ns\\\",toJson (← IO.monoNanosNow))]\\n  let line := row.compress ++ \\\"\\\\n\\\"\\n  transcript.atomically do\\n    let current ← get\\n    unless current.bytes + line.utf8ByteSize ≤ settings.transcriptBytes do\\n      throw (IO.userError \\\"App Server transcript exceeded its frozen capture bound\\\")\\n    current.handle.putStr line\\n    current.handle.flush\\n    set {current with bytes := current.bytes + line.utf8ByteSize, largest := max current.largest size}\\n\\nprivate partial def enqueue (inbox : Std.Mutex Inbox) (message : Json) (size : Nat) : IO Unit := do\\n  let inserted ← inbox.atomically do\\n    let state ← get\\n    if state.stopping then return true\\n    if state.count ≥ 128 || state.bytes + size > 32 * 1024 * 1024 then return false\\n    set {state with pending := state.pending.enqueue (message,size), count := state.count + 1, bytes := state.bytes + size}\\n    return true\\n  unless inserted do\\n    IO.sleep 5\\n    enqueue inbox message size\\n\\nprivate def readStdout (access : Access) (settings : Settings) (handle : IO.FS.Handle)\\n    (inbox : Std.Mutex Inbox) (transcript : Std.Mutex Transcript) : IO Unit := do\\n  try\\n    let mut pending := ByteArray.empty\\n    repeat\\n      if ← inbox.atomically (return (← get).stopping) then break\\n      -- FS.Handle is buffered stdio: a large fread can wait for that many\\n      -- bytes on a live pipe. One buffered byte completes without waiting\\n      -- for the next frame and bounds even an unterminated response.\\n      let chunk ← handle.read 1\\n      if chunk.isEmpty then\\n        unless pending.isEmpty do throw (IO.userError \\\"App Server closed an unfinished JSON frame\\\")\\n        break\\n      let mut start := 0\\n      for i in [0:chunk.size] do\\n        if chunk[i]! != 10 then continue\\n        let raw := pending ++ chunk.extract start i\\n        unless raw.size ≤ settings.responseBytes do throw (IO.userError \\\"App Server response exceeded its frozen capture bound\\\")\\n        let some text := String.fromUTF8? raw | throw (IO.userError \\\"App Server response is not UTF-8\\\")\\n        let message ← IO.ofExcept (Json.parse text)\\n        let _ ← IO.ofExcept message.getObj?\\n        record settings transcript \\\"server\\\" message raw.size\\n        if access == .inspect && #[\\\"turn/started\\\",\\\"thread/tokenUsage/updated\\\"].contains\\n            ((message.getObjValAs? String \\\"method\\\").toOption.getD \\\"\\\") then\\n          throw (IO.userError \\\"unexpected generation event during metadata inspection\\\")\\n        enqueue inbox message raw.size\\n        pending := .empty\\n        start := i + 1\\n      pending := pending ++ chunk.extract start chunk.size\\n      unless pending.size ≤ settings.responseBytes do throw (IO.userError \\\"App Server partial response exceeded its frozen capture bound\\\")\\n  catch error =>\\n    inbox.atomically (modify fun state => {state with error := some error.toString})\\n  finally\\n    inbox.atomically (modify fun state => {state with closed := true})\\n\\nprivate def readStderr (handle output : IO.FS.Handle) (inbox : Std.Mutex Inbox) : IO Unit := do\\n  try\\n    let mut bytes := 0\\n    let mut pending := ByteArray.empty\\n    repeat\\n      let chunk ← handle.read 1\\n      if chunk.isEmpty then\\n        output.write pending\\n        output.flush\\n        break\\n      bytes := bytes + chunk.size\\n      unless bytes ≤ 16 * 1024 * 1024 do throw (IO.userError \\\"App Server stderr exceeded 16 MiB\\\")\\n      pending := pending ++ chunk\\n      if chunk[0]! == 10 || pending.size ≥ 4096 then\\n        output.write pending\\n        output.flush\\n        pending := .empty\\n  catch error =>\\n    inbox.atomically (modify fun state => {state with error := some error.toString})\\n\\ndef start (access : Access) (settings : Settings) : IO (Client access) := do\\n  unless !settings.command.isEmpty && settings.timeoutMs > 0 && settings.timeoutMs ≤ 900000 &&\\n      settings.responseBytes > 0 && settings.responseBytes ≤ 32 * 1024 * 1024 &&\\n      settings.transcriptBytes > 0 && settings.transcriptBytes ≤ 256 * 1024 * 1024 do\\n    throw (IO.userError \\\"invalid App Server command, deadline, or capture bounds\\\")\\n  let output := System.FilePath.mk settings.output\\n  unless output.isAbsolute && !(← output.pathExists) do throw (IO.userError \\\"keep the existing transport evidence\\\")\\n  StudyEnvironment.prepare settings.environment\\n  -- Reserve this run atomically; concurrent clients must not truncate each\\n  -- other's transcript after both pass the existence check above.\\n  IO.FS.createDir output\\n  let log ← IO.FS.Handle.mk (output / \\\"exchange.jsonl\\\") .write\\n  let errors ← IO.FS.Handle.mk (output / \\\"stderr.log\\\") .write\\n  let spawned ← IO.Process.spawn {\\n    cmd := settings.command[0]!, args := settings.command.extract 1 settings.command.size\\n    cwd := some (.mk settings.cwd), env := settings.environment\\n    stdin := .piped, stdout := .piped, stderr := .piped, setsid := true}\\n  let (input,child) ← spawned.takeStdin\\n  let inbox ← Std.Mutex.new ({} : Inbox)\\n  let transcript ← Std.Mutex.new ({handle := log} : Transcript)\\n  let stdoutReader ← IO.asTask (readStdout access settings child.stdout inbox transcript) .dedicated\\n  let stderrReader ← IO.asTask (readStderr child.stderr errors inbox) .dedicated\\n  return {\\n    settings,child,input := ← IO.mkRef (some input),stdoutReader,stderrReader\\n    writer := ← IO.mkRef none,inbox,transcript,nextId := ← IO.mkRef 0,\\n    notices := ← IO.mkRef #[],exit := ← IO.mkRef none\\n    family := ← IO.mkRef {},monitor := (← IO.Process.getPID).toNat}\\n\\nprivate partial def awaitTask (task : Reader) (deadline : Nat) : IO Unit := do\\n  if ← IO.hasFinished task then\\n    match task.get with\\n    | .ok () => return\\n    | .error error => throw error\\n  unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"App Server pipe operation timed out\\\")\\n  IO.sleep 5\\n  awaitTask task deadline\\n\\nprivate def send (client : Client access) (message : Json) : IO Unit := do\\n  let line := message.compress ++ \\\"\\\\n\\\"\\n  unless line.utf8ByteSize ≤ 1024 * 1024 do throw (IO.userError \\\"App Server request exceeds 1 MiB\\\")\\n  let some input ← client.input.get | throw (IO.userError \\\"App Server input is closed\\\")\\n  record client.settings client.transcript \\\"client\\\" message\\n  let writing ← IO.asTask (do input.putStr line; input.flush) .dedicated\\n  client.writer.set (some writing)\\n  awaitTask writing ((← IO.monoMsNow) + client.settings.timeoutMs)\\n  client.writer.set none\\n\\nprivate partial def receive (client : Client access) (deadline : Nat) : IO Json := do\\n  let row ← client.inbox.atomically do\\n    let state ← get\\n    if let some ((message,size),rest) := state.pending.dequeue? then\\n      set {state with pending := rest,count := state.count - 1,bytes := state.bytes - size}\\n      return some message\\n    if let some error := state.error then throw (IO.userError error)\\n    if state.closed then throw (IO.userError \\\"App Server stdout closed\\\")\\n    return none\\n  if let some row := row then return row\\n  unless (← IO.monoMsNow) < deadline do throw (IO.userError \\\"App Server response timed out\\\")\\n  IO.sleep 5\\n  receive client deadline\\n\\ndef request (client : Client access) (method : Request access) (params : Json) : IO Json := do\\n  let id ← client.nextId.get\\n  client.nextId.set (id + 1)\\n  send client (Json.mkObj [(\\\"id\\\",toJson id),(\\\"method\\\",toJson method.method),(\\\"params\\\",params)])\\n  let deadline := (← IO.monoMsNow) + client.settings.timeoutMs\\n  repeat\\n    let message ← receive client deadline\\n    if (message.getObjVal? \\\"id\\\").toOption.isSome then\\n      if (message.getObjVal? \\\"method\\\").toOption.isSome then throw (IO.userError \\\"unexpected server-initiated request\\\")\\n      unless (message.getObjValAs? Nat \\\"id\\\").toOption == some id do throw (IO.userError \\\"App Server response ID mismatch\\\")\\n      if (message.getObjVal? \\\"error\\\").toOption.isSome then throw (IO.userError s!\\\"App Server {method.method} failed; retain the recorded error\\\")\\n      return ← IO.ofExcept (message.getObjVal? \\\"result\\\")\\n    client.notices.modify (·.push message)\\n  throw (IO.userError \\\"unreachable request completion\\\")\\n\\ndef handshake (client : Client access) (version : String) : IO Json := do\\n  let hello ← request client (.read .initialize) (Json.mkObj [\\n    (\\\"clientInfo\\\",Json.mkObj [(\\\"name\\\",toJson \\\"eggshell_study\\\"),(\\\"title\\\",toJson \\\"Eggshell study\\\"),(\\\"version\\\",toJson version)]),\\n    (\\\"capabilities\\\",Json.mkObj [(\\\"experimentalApi\\\",toJson true)])])\\n  send client (Json.mkObj [(\\\"method\\\",toJson \\\"initialized\\\"),(\\\"params\\\",Json.mkObj [])])\\n  return hello\\n\\ndef waitNotification (client : Client .generate) (method : String)\\n    (accepts : Json → Bool) : IO Json := do\\n  let buffered ← client.notices.get\\n  client.notices.set #[]\\n  for message in buffered do\\n    if (message.getObjValAs? String \\\"method\\\").toOption != some method then continue\\n    if let .ok params := message.getObjVal? \\\"params\\\" then\\n      if accepts params then return params\\n  let deadline := (← IO.monoMsNow) + client.settings.timeoutMs\\n  repeat\\n    let message ← receive client deadline\\n    if (message.getObjVal? \\\"id\\\").toOption.isSome then throw (IO.userError \\\"unexpected RPC request/response while waiting for a turn\\\")\\n    if (message.getObjValAs? String \\\"method\\\").toOption != some method then continue\\n    let params ← IO.ofExcept (message.getObjVal? \\\"params\\\")\\n    if accepts params then return params\\n  throw (IO.userError \\\"unreachable notification completion\\\")\\n\\nprivate def poll (client : Client access) : IO (Option UInt32) := do\\n  if let some code ← client.exit.get then return some code\\n  let code ← client.child.tryWait\\n  client.exit.set code\\n  return code\\n\\nprivate partial def waitExit (client : Client access) (deadline : Nat) : IO (Option UInt32) := do\\n  if let some code ← poll client then return some code\\n  if (← IO.monoMsNow) ≥ deadline then return none\\n  IO.sleep 5\\n  waitExit client deadline\\n\\nprivate def familyMembers (client : Client access) : IO (Array ResourceGuard.Process) := do\\n  let rows ← ResourceGuard.processes\\n  let excluded := ResourceGuard.ancestors rows client.monitor\\n  let members := ResourceGuard.owned rows excluded client.child.pid.toNat (← client.family.get) #[]\\n  for member in members do\\n    client.family.modify (·.insert member.process.pid member.process.identity)\\n  return members.map fun member => member.process\\n\\nprivate def familySummary (process : ResourceGuard.Process) : Json :=\\n  Json.mkObj [(\\\"pid\\\",toJson process.pid),(\\\"parent\\\",toJson process.parent),\\n    (\\\"birth\\\",toJson process.identity),(\\\"executable\\\",toJson (process.command[0]?.getD \\\"\\\"))]\\n\\ndef executables (client : Client access) : IO (Array String) := do\\n  return (← familyMembers client).map (fun process => process.command[0]?.getD \\\"\\\")\\n\\nprivate def stopFamily (client : Client access) : IO Unit := do\\n  let rows ← ResourceGuard.processes\\n  let excluded := ResourceGuard.ancestors rows client.monitor\\n  for member in ResourceGuard.owned rows excluded client.child.pid.toNat (← client.family.get) #[] do\\n    let _ ← IO.Process.output {cmd := \\\"/bin/kill\\\",args := #[\\\"-KILL\\\",toString member.process.pid]}\\n\\nprivate def groupMembers (pid : Nat) : IO (Array Json) := do\\n  let output ← IO.Process.output {cmd := \\\"/bin/ps\\\",args := #[\\\"-axo\\\",\\\"pid=,ppid=,pgid=,stat=,comm=\\\"]}\\n  unless output.exitCode == 0 do throw (IO.userError \\\"cannot inspect the owned App Server process group\\\")\\n  let mut members := #[]\\n  for line in output.stdout.splitOn \\\"\\\\n\\\" do\\n    let fields := ((line.splitOn \\\" \\\").filter (! ·.isEmpty)).toArray\\n    if fields.size < 5 || fields[2]!.toNat? != some pid || fields[3]!.startsWith \\\"Z\\\" then continue\\n    members := members.push (Json.mkObj [(\\\"pid\\\",toJson fields[0]!),(\\\"parent\\\",toJson fields[1]!),\\n      (\\\"group\\\",toJson fields[2]!),(\\\"state\\\",toJson fields[3]!),\\n      (\\\"executable\\\",toJson (String.intercalate \\\" \\\" (fields.extract 4 fields.size).toList))])\\n  return members\\n\\ndef close (client : Client access) (actionError : Option String := none) : IO Json := do\\n  -- Capture the still-attached family before EOF can reparent helpers that\\n  -- created their own process group. Reuse the guard's birth-checked ownership\\n  -- and ancestor exclusion rather than inferring ownership from names.\\n  let mut cleanupErrors := #[]\\n  let mut beforeFamily := #[]\\n  let mut afterFamily := #[]\\n  try beforeFamily := (← familyMembers client).map familySummary\\n  catch error => cleanupErrors := cleanupErrors.push error.toString\\n  client.input.set none\\n  let mut forced := false\\n  let mut code ← waitExit client ((← IO.monoMsNow) + 15000)\\n  if code.isNone then\\n    forced := true\\n    let _ ← IO.Process.output {cmd := \\\"/bin/kill\\\",args := #[\\\"-KILL\\\",\\\"--\\\",\\\"-\\\" ++ toString client.child.pid]}\\n    code := some (← client.child.wait)\\n    client.exit.set code\\n  let mut beforeGroup := #[]\\n  let mut afterGroup := #[]\\n  try beforeGroup ← groupMembers client.child.pid.toNat\\n  catch error => cleanupErrors := cleanupErrors.push error.toString\\n  -- Reaping the server does not reap helpers that still own its setsid group.\\n  -- Retain their identities and terminate only that group, including on a\\n  -- normal server exit. No global process-name shutdown is involved.\\n  try\\n    let _ ← IO.Process.output {cmd := \\\"/bin/kill\\\",args := #[\\\"-KILL\\\",\\\"--\\\",\\\"-\\\" ++ toString client.child.pid]}\\n    stopFamily client\\n    IO.sleep 10\\n    afterGroup ← groupMembers client.child.pid.toNat\\n    afterFamily := (← familyMembers client).map familySummary\\n  catch error => cleanupErrors := cleanupErrors.push error.toString\\n  client.inbox.atomically (modify fun state => {state with stopping := true})\\n  let mut taskErrors := #[]\\n  let tasks := #[client.stdoutReader,client.stderrReader] ++ (← client.writer.get).toArray\\n  for task in tasks do\\n    try awaitTask task ((← IO.monoMsNow) + 5000)\\n    catch error => taskErrors := taskErrors.push error.toString\\n  let finalInbox ← client.inbox.atomically get\\n  let trace ← client.transcript.atomically get\\n  let stopped ← tasks.allM (fun task => return ← IO.hasFinished task)\\n  let result := Json.mkObj [(\\\"pid\\\",toJson client.child.pid.toNat),(\\\"exitCode\\\",toJson (code.map UInt32.toNat)),\\n    (\\\"forced\\\",toJson forced),(\\\"readersStopped\\\",toJson stopped),(\\\"taskErrors\\\",toJson taskErrors),\\n    (\\\"actionError\\\",toJson actionError),\\n    (\\\"groupBeforeCleanup\\\",toJson beforeGroup),(\\\"groupAfterCleanup\\\",toJson afterGroup),\\n    (\\\"familyBeforeCleanup\\\",toJson beforeFamily),(\\\"familyAfterCleanup\\\",toJson afterFamily),\\n    (\\\"cleanupErrors\\\",toJson cleanupErrors),\\n    (\\\"transportError\\\",toJson finalInbox.error),(\\\"transcriptBytes\\\",toJson trace.bytes),\\n    (\\\"largestResponseBytes\\\",toJson trace.largest)]\\n  IO.FS.writeFile (.mk client.settings.output / \\\"process.json\\\") (result.compress ++ \\\"\\\\n\\\")\\n  return result\\n\\ndef withClient (access : Access) (settings : Settings) (action : Client access → IO α) : IO α := do\\n  let client ← start access settings\\n  let outcome : Except IO.Error α ← try pure (.ok (← action client)) catch error => pure (.error error)\\n  let actionError := match outcome with\\n    | .error error => some error.toString\\n    | .ok _ => none\\n  let cleanup ← close client actionError\\n  match outcome with\\n  | .error error => throw error\\n  | .ok value =>\\n      unless (cleanup.getObjValAs? Nat \\\"exitCode\\\").toOption == some 0 &&\\n          (cleanup.getObjValAs? Bool \\\"forced\\\").toOption == some false &&\\n          (cleanup.getObjValAs? Bool \\\"readersStopped\\\").toOption == some true &&\\n          (cleanup.getObjValAs? (Array String) \\\"taskErrors\\\").toOption == some #[] &&\\n          (cleanup.getObjValAs? (Array String) \\\"cleanupErrors\\\").toOption == some #[] &&\\n          (cleanup.getObjValAs? (Array Json) \\\"groupAfterCleanup\\\").toOption == some #[] &&\\n          (cleanup.getObjValAs? (Array Json) \\\"familyAfterCleanup\\\").toOption == some #[] &&\\n          (cleanup.getObjVal? \\\"transportError\\\").toOption == some .null do\\n        throw (IO.userError \\\"App Server did not close cleanly; retain process.json\\\")\\n      return value\\n\\ndef probe (settings : Settings) : IO Unit :=\\n  withClient .inspect settings fun client => do\\n    let hello ← handshake client \\\"0.145.0\\\"\\n    let models ← request client (.read .models) (Json.mkObj [(\\\"includeHidden\\\",toJson true)])\\n    let hooks ← request client (.read .hooks) (Json.mkObj [(\\\"cwds\\\",toJson #[settings.cwd])])\\n    for (name,value) in #[(\\\"initialize\\\",hello),(\\\"models\\\",models),(\\\"hooks\\\",hooks)] do\\n      IO.FS.writeFile (.mk settings.output / (name ++ \\\".json\\\")) (value.compress ++ \\\"\\\\n\\\")\\n\\nend Eggshell.Research.StudyTransport\\n\",[]]"]]
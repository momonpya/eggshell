ead.binding.work = read.binding.work := witness.origin\\n\\n/-- Scan the actual reachable record spellings for all of an answer's literal\\nquotes together. A matching identifier may occur inside a row/member; it need\\nnot equal the entire enclosing record. Duplicate aliases do not multiply a\\nread's support. These are advisory citations, never execution certificates. -/\\ndef quoteMatches (index : LiteralSearch.Index patterns) (spellings : Array Quotation) : Array Quotation := Id.run do\\n  let mut seen : Std.HashMap (Occurrence × String × String × String × Nat × Nat × String) Nat := {}\\n  let mut result := #[]\\n  for item in spellings do\\n    for hit in LiteralSearch.first index item.text do\\n      let text := patterns[hit.pattern]\\n      let witness := item.locate? hit.first hit.limit\\n      let read := witness.map (·.read) |>.getD item.read\\n      let anchor := witness.map (fun found => (found.first,found.limit))\\n      let first := anchor.map Prod.fst |>.getD read.binding.first\\n      let limit := anchor.map Prod.snd |>.getD read.binding.limit\\n      let key := (read.occurrence,read.binding.database,read.binding.owner,read.binding.work,first,limit,text)\\n      let next : Quotation := ⟨read,text,none,anchor⟩\\n      if let some previous := seen[key]? then\\n        let some prior := result[previous]? | continue\\n        let width := read.binding.limit-read.binding.first\\n        let oldWidth := prior.read.binding.limit-prior.read.binding.first\\n        if width < oldWidth || (width == oldWidth && read.source.file?.isSome && prior.read.source.file?.isNone) then\\n          result := result.set! previous next\\n      else\\n        seen := seen.insert key result.size\\n        result := result.push next\\n  return result\\n\\nstructure Catalog where\\n  located : Array LocatedRead := #[]\\n  quotations : Array Quotation := #[]\\n\\ndef Catalog.reads (catalog : Catalog) : Array Read := catalog.located.map (·.read)\\n\\n/-- Certified source rows have
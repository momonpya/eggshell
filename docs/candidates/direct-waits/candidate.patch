diff --git a/Eggshell/TaskDeadline.lean b/Eggshell/TaskDeadline.lean
index 5ee05af3..dce647a1 100644
--- a/Eggshell/TaskDeadline.lean
+++ b/Eggshell/TaskDeadline.lean
@@ -43,0 +44,6 @@ def event (task : AsyncTask α) : IO (Selector α) := do
+/-- Register readiness in this owner. `Async.block` first starts another
+pool task; a socket/timer wait needs no such CPU worker. The caller retains
+the absolute deadline and owns cancellation of the actual IO. -/
+def awaitEvent (action : Async α) : IO α := do
+  IO.ofExcept (← IO.wait (← action.toIO))
+
@@ -53 +59 @@ def wait (task : AsyncTask α) (deadline : Nat) : IO α := do
-    let result ← (do
+    let result ← awaitEvent (do
@@ -56 +62 @@ def wait (task : AsyncTask α) (deadline : Nat) : IO α := do
-        .case timer (fun _ => pure none)]).block
+        .case timer (fun _ => pure none)])

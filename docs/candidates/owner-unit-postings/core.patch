+def memberOwners (member : Synapses.Bundles.Member) : List String :=
+  member.choices.toList.map (·.owner)
+
+theorem member_covered_owner (keys : Array String) (units : Array UnitPlan)
+    (member : Synapses.Bundles.Member) (index : Fin units.size)
+    (covered : memberCovered keys units [index] member = true) :
+    ∃ owner ∈ memberOwners member, keys[units[index].family]? = some owner := by
+  simp only [memberCovered,List.any_cons,List.any_nil,Bool.or_false] at covered
+  obtain ⟨bound,present,valid⟩ := Array.any_eq_true'.mp covered
+  have matched : keys[units[index].family]? = some bound.owner := by
+    simpa only [Bool.and_eq_true,beq_iff_eq] using (Bool.and_eq_true_iff.mp valid).1
+  exact ⟨bound.owner,List.mem_map.mpr ⟨bound,by simpa using present,rfl⟩,matched⟩
+
+theorem member_candidates_exact (keys : Array String) (units : Array UnitPlan)
+    (member : Synapses.Bundles.Member)
+    (directory : OwnerUnitPostings.Index (fun index : Fin units.size => keys[units[index].family]?)) :
+    directory.select (memberOwners member) (fun index => memberCovered keys units [index] member) =
+      (List.finRange units.size).filter (fun index => memberCovered keys units [index] member) :=
+  directory.select_exact _ _ (member_covered_owner keys units member)
 

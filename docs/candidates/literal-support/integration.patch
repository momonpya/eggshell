 structure Quotation where
   read : Read
   text : String
+
+/-- Scan the actual reachable record spellings for all of an answer's literal
+quotes together. A matching identifier may occur inside a row/member; it need
+not equal the entire enclosing record. Duplicate aliases do not multiply a
+read's support. These are advisory citations, never execution certificates. -/
+def quoteMatches (index : LiteralSearch.Index patterns) (spellings : Array Quotation) : Array Quotation := Id.run do
+  let mut seen : Std.HashSet (Read × String) := {}
+  let mut result := #[]
+  for item in spellings do
+    for hit in LiteralSearch.first index item.text do
+      let text := patterns[hit.pattern]
+      if seen.contains (item.read,text) then continue
+      seen := seen.insert (item.read,text)
+      result := result.push ⟨item.read,text⟩
+  return result
 

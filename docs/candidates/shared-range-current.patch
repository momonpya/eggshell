+import Eggshell.Handoff
+open Lean Eggshell Eggshell.Plugin
+namespace OriginalCueReference
+def legacyCueViews (records : List (ContextSpan source))
+    (heads : List (Nat × Option Nat))
+    (decoded : Option (DecodedLayout source)) (ranges : List (EvidenceRange source)) :
+    List (EvidenceView source) :=
+  let scopedHeads := contextStructureHeads source decoded true
+  let candidates := ranges.map fun range =>
+    -- A section entry is itself the scope boundary. It cannot borrow the
+    -- preceding section as if it were a prerequisite.
+    let isEntry := heads.any fun head => head.2 == some range.start
+    let complete := if isEntry then recordContextRange records range
+      else prerequisiteContextRange records heads range
+    let coherent := preferredCueContext records heads range
+    -- Every admitted cue retains nearby original conditions and results.
+    -- Enlarging only the first cue used to spend the entire owner share on
+    -- one declaration, leaving later branch conclusions without conditions.
+    let required := if isEntry then complete else coherentRecordContext records heads complete 1024
+    let scope := prerequisiteContextRange records scopedHeads range
+    let required := if bounds : scope.start < required.start ∧ required.stop - scope.start ≤ 2048 then
+      (⟨scope.start, required.stop, Nat.lt_trans bounds.1 required.ordered,
+        required.within, bounds.2⟩ : EvidenceRange source)
+      else required
+    (complete, required, coherent)
+  -- Cover the ranked statements and their prerequisites before enlarging
+  -- any one neighborhood. Optional local consequences use only remaining
+  -- space and cannot evict an already admitted original cue.
+  let coverage := candidates.map (fun (_, required, _) => required)
+  -- A compact neighborhood can still exceed the remaining space. Retain
+  -- its smaller original cue/entry as an alternative, rather than dropping
+  -- a required scope boundary merely because its optional context cannot fit.
+  let fallback := candidates.filterMap fun (complete, required, _) =>
+    if required.start == complete.start && required.stop == complete.stop then none else some complete
+  let context := candidates.filterMap fun (_, required, coherent) =>
+    if coherent.start == required.start && coherent.stop == required.stop then none else some coherent
+  (coverage ++ fallback ++ context).filterMap fun candidate => match decoded with
+    | none => some (.original candidate)
+    | some layout => (decodedEvidenceUsing? layout candidate).map EvidenceView.decoded
+
+
+theorem preprocessing_preserved : @Eggshell.Plugin.prepareCueViews = @legacyCueViews := by
+  funext source records heads decoded ranges
+  rfl
+end OriginalCueReference
+
+private def requireRange (condition : Bool) (message : String) : IO Unit :=
+  unless condition do throw (IO.userError message)
+
+def main : IO Unit := do
+  let lines := (List.range 240).map fun n =>
+    s!"{n+1}\t  if (gate_{n}) emit(\"条件 {n}\", result_{n});"
+  let source := (toJson ("\n".intercalate lines)).compress
+  let work := "read sample ranges"
+  let owner := OutcomeEdge.make (.text work) (.text source) [] (by simp) (by simp)
+  let original : TransportSlice := {
+    owner := some owner.relation, keys := ["original"],
+    text := "original-frame:" ++ source, members := [], visibleKeys := []}
+  let positions := [1,9,17]
+  let some part := (prepareContextualOwnerPlan [] positions owner "original source route" [] original).eval 120000 |
+    throw (IO.userError "original context preparation failed")
+  let family : SharedRangeAdapter.Family := {
+    owner, windows := positions,
+    template := {original with text := part.text,keys := part.keys,context := part.context}}
+  let (units,cues) := SharedRangeAdapter.prepare 0 family
+  requireRange (!units.isEmpty && !cues.isEmpty) "independent query units vanished"
+  for unit in units do
+    let some context := unit.slice.context | throw (IO.userError "long original data lost its context")
+    requireRange (context.owner == relationKey owner.relation) "original owner changed"
+    requireRange (context.outcome == relationKey owner.outcome && context.sourceChars == source.length)
+      "original source identity changed"
+    requireRange (unit.slice.members.isEmpty && unit.slice.visibleKeys.isEmpty)
+      "advisory source acquired control"
+    requireRange (context.fragments.all fun fragment =>
+      fragment.first+fragment.original.length ≤ source.length &&
+      fragment.original == ((source.drop fragment.first).take fragment.original.length).copy)
+      "new data or wrong original coordinates were emitted"
+    requireRange (context.cues.all fun (a,b) => SharedRangeAdapter.covers unit.ranges a b)
+      "a claimed query cue was only partly delivered"
+  let pieces := SharedRangeAdapter.cuePieces 100 [family] units [cues]
+  requireRange (pieces.all fun piece => 0 < piece.weight) "empty query demand was invented"
+  requireRange (pieces.zipIdx.all fun (a,i) => pieces.zipIdx.all fun (b,j) =>
+    i ≥ j || a.last ≤ b.first) "overlapping windows voted for the same original position twice"
+  let cost := fun (items : List TransportSlice) =>
+    let text := "frame\n" ++ "\n".intercalate (items.map (·.text)) ++ "\nend"
+    (text.length,text.utf8ByteSize)
+  let some fitted := SharedRangeAdapter.fit (8192,16384) cost [family] |
+    throw (IO.userError "fitting independent evidence failed")
+  requireRange (!fitted.val.isEmpty) "an affordable complete cue closure was omitted"
+  requireRange ((cost fitted.val).1 ≤ 8192 && (cost fitted.val).2 ≤ 16384)
+    "the real serialized packet exceeded a limit"
+  requireRange (fitted.val.all fun slice => slice.members.isEmpty && slice.visibleKeys.isEmpty)
+    "materialization invented native authority"
+  IO.println "range adapter: original encoded source, exact fragments, complete cue closure, disjoint weighted coverage, shared materialization and real dual packet bound passed"

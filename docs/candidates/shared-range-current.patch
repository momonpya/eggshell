+module
+
+public import Eggshell.SearchUnicode
+public import tools.RetrievalCategories
+
+@[expose] public section
+
+namespace Eggshell.IdentifierParts
+
+def lower (c : Char) : Bool := 'a' ≤ c && c ≤ 'z'
+def upper (c : Char) : Bool := 'A' ≤ c && c ≤ 'Z'
+def digit (c : Char) : Bool := '0' ≤ c && c ≤ '9'
+
+/-- Keep acronym tails with the following word: HTTPServer -> HTTP, Server.
+Only ASCII case supplies a case boundary; Unicode words remain intact. -/
+def boundary (previous current : Char) (next : Option Char) : Bool :=
+  (lower previous && upper current) ||
+  (upper previous && upper current && next.any lower) ||
+  (digit previous && (lower current || upper current)) ||
+  ((lower previous || upper previous) && digit current)
+
+def normalized (characters : Array Char) : String :=
+  String.ofList (characters.toList.flatMap fun c => (SearchUnicode.fold c).toList)
+
+/-- Additional retrieval hints from original identifier/path components.
+The caller supplies its existing script boundary, so this introduces neither
+a dictionary nor a second CJK policy. Whole original terms remain separate.
+These hints have no role in Work identity, equivalence or completion. -/
+def parts (script : Char → Bool) (text : String) : List String := Id.run do
+  let characters := (RetrievalResearch.Unicode.widthFold text).toList.toArray
+  let mut result : Array String := #[]
+  let mut current : Array Char := #[]
+  for index in [:characters.size] do
+    let c := characters[index]!
+    let word := !script c && (RetrievalResearch.Unicode.letterNumber c ||
+      (!current.isEmpty && RetrievalResearch.Unicode.mark c))
+    if word then
+      if let some previous := current.back? then
+        if boundary previous c characters[index + 1]? then
+          result := result.push (normalized current)
+          current := #[]
+      current := current.push c
+    else if !current.isEmpty then
+      result := result.push (normalized current)
+      current := #[]
+  if !current.isEmpty then result := result.push (normalized current)
+  return result.toList
+
+end Eggshell.IdentifierParts

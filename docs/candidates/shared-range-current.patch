+/-- This premise is retained by both real producers at generation time. It is
+not supplied as a hypothetical ancestry assumption by the completion caller. -/
+theorem discovery_local_unions_not_retrieved (discovery : Discovery)
+    (edge : UnionEdge) (present : edge ∈ discovery.view.localUnions) :
+    ∃ quotient inquiry matched,
+      localUnion? quotient inquiry matched = some edge ∧
+      matched.retrieved = false ∧ edge.scope = .run inquiry := by
+  obtain ⟨quotient, inquiry, matched, created, intrinsic⟩ := discovery.localOrigins edge present
+  exact ⟨quotient, inquiry, matched, created, intrinsic, localUnion_is_run_scoped created⟩
+
+/-- Every current generator is either an explicit persistent input, or has
+an actual non-retrieved Match constructor witness. No ancestry premise is
+required for the current run's local edges. -/
+theorem discovery_generators_have_origin (discovery : Discovery)
+    (edge : UnionEdge) (present : edge ∈ discovery.persistentUnions ++ discovery.view.localUnions) :
+    edge ∈ discovery.persistentUnions ∨
+      ∃ quotient inquiry matched, localUnion? quotient inquiry matched = some edge ∧
+        matched.retrieved = false ∧ edge.scope = .run inquiry := by
+  rcases List.mem_append.mp present with durable | recent
+  · exact Or.inl durable
+  · exact Or.inr (discovery_local_unions_not_retrieved discovery edge recent)
+
+theorem completed_generator_origins {discovery : Discovery} {demand : Value} {edge : OutcomeEdge}
+    (used : (demand, edge) ∈ (extraction discovery).selection.completedUses) :
+    Equivalent (discovery.persistentUnions ++ discovery.view.localUnions) edge.work demand ∧
+    Value.SameExactFootprint edge.work demand ∧
+    ∀ generator ∈ discovery.persistentUnions ++ discovery.view.localUnions,
+      generator ∈ discovery.persistentUnions ∨
+        ∃ quotient inquiry matched, localUnion? quotient inquiry matched = some generator ∧
+          matched.retrieved = false ∧ generator.scope = .run inquiry := by
+  have selected := Selection.completedUse_sound (extraction_sound discovery) used
+  have equality := discovery.generated edge.work demand selected.2.1
+  exact ⟨equality, equality.exactAuthority, discovery_generators_have_origin discovery⟩
+

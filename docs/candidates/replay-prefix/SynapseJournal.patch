+/-- Canonical private append metadata. The floor records the most recent
+insertion which was not strictly after all preceding clocks. A prefix older
+than that insertion must be sorted and replayed again. -/
+structure Frontier where
+  producer : String
+  count : Nat := 0
+  latest : Nat := 0
+  floor : Nat := 0
+  maximum : Option Clock := none
+  chain : String
+  bytes : Nat := 0
+  deriving BEq,ToJson,FromJson
+
+def frontierKey (turn : Turn) := "turn-input:" ++ turn.name
+def receiptKey (turn : Turn) (ordinal : Nat) := key ("turn-sequence:" ++ turn.name) ordinal
+
+def Frontier.initial (journal : PageMap.Snapshot) (turn : Turn) : Frontier :=
+  {producer := implementation,chain := Index.contentKey (journal.head.identity,turn,"private events")}
+
+def Frontier.accepts (old next : Frontier) : Bool :=
+  old.producer == next.producer && old.count ≤ next.count && next.floor ≤ old.count
+
+theorem later_order_violation_rejected (old next : Frontier) (later : old.count < next.floor) :
+    old.accepts next = false := by
+  simp [Frontier.accepts,show ¬ next.floor ≤ old.count by omega]
+
+def Frontier.step (old : Frontier) (ordinal : Nat) (value : Entry) : Frontier := Id.run do
+  let raw := (toJson value).compress.toUTF8
+  let ordered := old.maximum.all (·.before value.clock)
+  let count := old.count+1
+  let floor := if ordered then old.floor else count
+  let maximum := match old.maximum with
+    | none => value.clock
+    | some previous => if previous.before value.clock then value.clock else previous
+  let bytes := old.bytes+raw.size
+  return {
+    producer := implementation,count,latest := ordinal+1,floor,maximum := some maximum,bytes
+    chain := Index.contentKey (old.chain,ordinal,Sha256.hex raw,count,floor,maximum,bytes)}
+

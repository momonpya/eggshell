["module\n\npublic import Eggshell.PublicationWire\npublic import Eggshell.Numerical\npublic import Eggshell.CanonicalSourcePrepared\n\n@[expose] public section\n\nnamespace Eggshell.Plugin.Publication.Client\nopen Lean DB\n\nstructure SourceReference where\n  endpoint : Daemon.Endpoint\n  access : Synapses.CanonicalSource.Shared.Access\n\ndef SourceReference.metadata (reference : SourceReference) := reference.access.metadata\n\ndef SourceReference.identity (reference : SourceReference) : Json := reference.access.identity\n\ndef liveBudget (deadline : Nat) : IO Nat := do\n  let now ← IO.monoMsNow\n  unless now < deadline do throw (IO.userError \"prepared source request expired\")\n  return min maxBudgetMs (deadline-now)\n\n/-- An explicitly supplied data-side owner is useful to native clients and\ndoes not require a writer registration for a read-only source. -/\ndef prepareSourceUsing (endpoint : Daemon.Endpoint) (source : PageMap.Snapshot)\n    (storage : Sidecar.Storage) (deadline : Nat) : IO (Option SourceReference) := do\n  let budget ← liveBudget deadline\n  let response ← Daemon.exchange endpoint \"prepare-source\" (Json.mkObj [\n    (\"directory\",toJson source.directory.toString),(\"source\",toJson source.head),(\"storage\",toJson storage),\n    (\"budgetMs\",toJson budget)]) (budget := budget)\n  let value ← IO.ofExcept (Json.parse response)\n  if value == Json.null then return none\n  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)\n  unless access.database == source.head.identity && access.source == source.head &&\n      access.metadata.source.identity == source.head.identity && Synapses.digest access.scope &&\n      Synapses.digest access.capability &&\n      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do\n    throw (IO.userError \"prepared source reply changed its scope or source\")\n  return some ⟨{endpoint with secret := access.capability},access⟩\n\n/-- After local administration grants a read scope, refreshing it needs only\nthat scope's read capability, including when the publisher is another owner. -/\ndef SourceReference.refresh (reference : SourceReference) (source : PageMap.Head)\n    (deadline : Nat) : IO (Option SourceReference) := do\n  let budget ← liveBudget deadline\n  let response ← Daemon.exchange reference.endpoint \"refresh-source\" (Json.mkObj [\n    (\"database\",toJson reference.access.database),(\"scope\",toJson reference.access.scope),\n    (\"source\",toJson (some source)),(\"budgetMs\",toJson budget)]) (budget := budget)\n  let value ← IO.ofExcept (Json.parse response)\n  if value == Json.null then return none\n  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)\n  unless access.database == reference.access.database && access.scope == reference.access.scope &&\n      access.capability == reference.access.capability && access.source == source &&\n      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do\n    throw (IO.userError \"prepared source refresh changed its read authority\")\n  return some ⟨reference.endpoint,access⟩\n\ndef sourceRows (reference : SourceReference) (owners : Array String) (deadline : Nat) :\n    IO Synapses.CanonicalSource.Shared.Projection := do\n  let access := reference.access\n  let owners := (hashDistinct owners.toList).toArray\n  let budget ← liveBudget deadline\n  let response ← Daemon.exchange reference.endpoint \"source-rows\" (Json.mkObj [\n    (\"database\",toJson access.database),(\"scope\",toJson access.scope),(\"source\",toJson access.source),\n    (\"metadata\",toJson access.metadata),(\"owners\",toJson owners),(\"budgetMs\",toJson budget)]) (budget := budget)\n  let result ← IO.ofExcept (Json.parse response >>= fromJson? (α := Synapses.CanonicalSource.Shared.Projection))\n  unless result.identity == reference.identity && result.rows.map Prod.fst == owners do\n    throw (IO.userError \"prepared source projection changed its owner domain\")\n  for (owner,rows) in result.rows do\n    unless rows.all (fun row => row.origins.all (fun origin =>\n        origin.binding.database == access.database && origin.binding.owner == owner)) do\n      throw (IO.userError \"prepared source projection crossed its owner scope\")\n    let _ ← IO.ofExcept (Synapses.CanonicalSource.load access.database rows)\n    pure ()\n  return result\n\ndef endpoint? : IO (Option Daemon.Endpoint) := do\n  readJson? ((← directory) / \"endpoint.json\") []\n\ndef sourceRecords (reference : SourceReference) (owners : Array String) (deadline : Nat) :\n    IO Synapses.ObservedRecordView.Projection := do\n  let access := reference.access\n  let owners := (hashDistinct owners.toList).toArray\n  let budget ← liveBudget deadline\n  let response ← Daemon.exchange reference.endpoint \"source-records\" (Json.mkObj [\n    (\"database\",toJson access.database),(\"scope\",toJson access.scope),(\"source\",toJson access.source),\n    (\"metadata\",toJson access.metadata),(\"owners\",toJson owners),(\"budgetMs\",toJson budget)]) (budget := budget)\n  let result ← IO.ofExcept (Json.parse response >>=\n    fromJson? (α := Synapses.ObservedRecordView.Projection))\n  unless result.source == access.source && result.rows.map Prod.fst == owners do\n    throw (IO.userError \"original record projection changed its requested source or owner domain\")\n  for (owner,found) in result.rows do\n    if let some view := found then\n      unless view.header.database == access.database && view.header.owner == owner do\n        throw (IO.userError \"original record view crossed its read scope\")\n  return result\n\ndef ready (endpoint : Daemon.Endpoint) : IO Unit := do\n  unless endpoint.session == \"publisher\" && endpoint.compatible (← generation) do\n    throw (IO.userError \"publisher executable identity differs from this caller\")\n  let _ ← Daemon.exchange endpoint \"ping\" (budget := 500)\n  pure ()\n\ndef resolve : IO Daemon.Endpoint := do\n  let root ← directory\n  if let some endpoint ← endpoint? then\n    if endpoint.compatible (← generation) then\n      let reachable ← try ready endpoint; pure true catch _ => pure false\n      if reachable then return endpoint\n  Persistence.withLockWithin (root / \"starting\") 10000 do\n    if let some endpoint ← endpoint? then\n      let live ← Numerical.alive endpoint.pid\n      if live then\n        if endpoint.compatible (← generation) then\n          ready endpoint\n          return endpoint\n        throw (IO.userError \"shared data service uses another implementation; explicitly stop its owner before replacement\")\n      else removeIfExists (root / \"endpoint.json\")\n    let child ← IO.Process.spawn {\n      cmd := (← IO.appPath).toString,args := #[\"codex-publication-daemon\"]\n      stdin := .null,stdout := .null,stderr := .inherit,setsid := true }\n    let deadline := (← IO.monoMsNow)+10000\n    repeat\n      unless (← child.tryWait).isNone do throw (IO.userError \"publisher exited during startup\")\n      if let some endpoint ← endpoint? then\n        unless endpoint.pid == child.pid.toNat do throw (IO.userError \"publisher startup returned another owner\")\n        ready endpoint\n        return endpoint\n      unless (← IO.monoMsNow) < deadline do throw (IO.userError \"publisher startup expired\")\n      IO.sleep 5\n    throw (IO.userError \"unreachable publisher startup\")\n\ndef prepareSource (source : PageMap.Snapshot) (storage : Sidecar.Storage)\n    (deadline : Nat) : IO (Option SourceReference) := do\n  prepareSourceUsing (← resolve) source storage deadline\n\ndef register (endpoint : Daemon.Endpoint) (path : System.FilePath) (identity : String) : IO Project := do\n  let response ← Daemon.exchange endpoint \"register\" (Json.mkObj [\n    (\"directory\",toJson path.toString),(\"database\",toJson identity)]) (budget := 5000)\n  let project ← IO.ofExcept (Json.parse response >>= fromJson? (α := Project))\n  unless project.database == identity && Synapses.digest project.capability do\n    throw (IO.userError \"publisher granted another database\")\n  return project\n\ndef submit (endpoint : Daemon.Endpoint) (project : Project) (capsule : Capsule) : IO NativePublication.SourceReceipt := do\n  let peer := {endpoint with secret := project.capability}\n  let response ← Daemon.exchange peer \"publish\" (Json.mkObj [\n    (\"database\",toJson project.database),(\"capsule\",toJson capsule)]) (budget := maxBudgetMs)\n  let receipt ← IO.ofExcept (Json.parse response >>= fromJson? (α := NativePublication.SourceReceipt))\n  unless receipt.accounted && receipt.head.identity == project.database do\n    throw (IO.userError \"publisher returned an unrelated source ACK\")\n  return receipt\n\n/-- Reconstruct only the submitted view from the authenticated durable ACK.\nThe service does not send the whole DB or duplicate every graph Value. -/\ndef restore (request : NativePublication.Prepared) (receipt : NativePublication.SourceReceipt) : IO NativePublication.Published := do\n  let expected := NativePublication.receipt request.items receipt.head\n  unless (toJson expected).compress == (toJson receipt).compress do\n    throw (IO.userError \"publisher source coverage differs from the native request\")\n  let authority ← IO.ofExcept (Json.parse receipt.head.authority >>=\n    Persistence.valueFromJson (receipt.head.authority.length+1))\n  let header := {Graph.empty authority with revision := receipt.head.revision}\n  let (transaction,promotion) ← IO.ofExcept (NativePublication.compilePrepared header request.target request)\n  let submitted : Graph := {\n    authority,revision := receipt.head.revision,values := transaction.stagedValues,unions := []\n    values_wellFormed := transaction.stagedValues_wellFormed }\n  return ⟨← prepareCommitted submitted promotion,receipt⟩\n\ndef run (pending : PendingTurn) (target : System.FilePath) (checkpoint : Bool) : IO NativePublication.Published := do\n  let target ← PageMap.absolute target\n  let source ← match ← PageMap.open? target with\n    | some source => pure source\n    | none => Persistence.withLock target (Persistence.ensureSnapshot target)\n  let request ← NativePublication.prepare pending target checkpoint\n  let endpoint ← resolve\n  let project ← register endpoint target source.head.identity\n  let receipt ← submit endpoint project (Capsule.ofPrepared request)\n  restore request receipt\n\ndef control (kind : String) : IO String := do\n  unless #[\"stats\",\"shutdown\"].contains kind do throw (IO.userError \"unknown publication control operation\")\n  let some endpoint ← endpoint? | return \"null\"\n  Daemon.exchange endpoint kind (budget := 5000)\n\nend Eggshell.Plugin.Publication.Client\n\nnamespace Eggshell.Plugin\n\ndef promote (pending : PendingTurn) (target : System.FilePath) : IO NativePublication.Published :=\n  Publication.Client.run pending target false\n\ndef promoteObservations (pending : PendingTurn) (target : System.FilePath) : IO NativePublication.Published :=\n  Publication.Client.run pending target true\n\nend Eggshell.Plugin\n",[]]
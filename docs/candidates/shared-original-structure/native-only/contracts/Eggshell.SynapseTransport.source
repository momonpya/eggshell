["module\n\npublic import Eggshell.SynapticTransport\npublic import tools.KeyPostings\npublic import Eggshell.HashDistinct\npublic import Eggshell.SynapticBindings\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Transport\nopen Lean Persistence.Store _root_.Eggshell.Synapses.Extraction Recommend\n\nstructure Owner where\n  database : String\n  original : OutcomeEdge\n  provenance : List SourceEvidence.Record\n\ndef Owner.document (owner : Owner) : Except String Document := do\n  return {\n    owner := Persistence.selectionKey owner.original.relation\n    work := Persistence.selectionKey owner.original.work\n    workText := text? owner.original.work\n    source := text? owner.original.outcome\n    native := owner.original.observations.any\n      (Relation.observesOutcomeWork owner.original.outcome owner.original.work)\n    occurrences := Provenance.identities owner.original\n    files := ← fileMap (owner.provenance.toArray.map toJson) }\n\nstructure LocatedOwner where\n  owner : OutcomeEdge\n  document : Document\n  located : Array Routed.Located\n  outputs : Array (LocatedOutput document)\n\n/-- Hydration and the original identity are prepared once per admitted owner.\nBinding a graph interval does not parse or hash the same body again. -/\nstructure AdmittedOwner where\n  owner : Owner\n  document : Document\n  original : Option (ObservationContext.OriginalOwner document)\n\nstructure Observation where\n  database : String\n  owner : String\n  work : String\n  occurrence : Occurrence\n  age : ObservationAge.Assessment\n  metadataFailure : Option String := none\n  deriving ToJson\n\nstructure Plan where\n  results : Array Routed.Result := #[]\n  owners : Array LocatedOwner := #[]\n  documents : Array Document := #[]\n  rows : Array Read := #[]\n  unsupported : Nat := 0\n  unlocatedFileOwners : Nat := 0\n  observations : Array Observation := #[]\n  canonical : Std.HashMap String (Array CanonicalSource.StoredRow) := {}\n  canonicalReuse : Array (String × CanonicalSource.Shared.Reuse × CanonicalSource.Shared.Reuse) := #[]\n  canonicalFailure : Array (String × String) := #[]\n  originalStructures : Std.HashMap String ObservedRecordView.Geometry := {}\n  originalCache : Array Json := #[]\n  bindingComplete : Bool := true\n  bindingRequests : Nat := 0\n  bindingBytes : Nat := 0\n  bindingUnresolved : Nat := 0\n\ndef Plan.complete (plan : Plan) : Bool := plan.bindingComplete && plan.results.all (·.complete)\n\n/-- An exact source-posting origin can be attached only to this already\nadmitted owner. Stored offsets are still bounded by its original body and\nthe native occurrence; the index cannot nominate another Work here. -/\ndef boundTo (database : String) (document : Document) (identity : Original) (read : Read) : Bool :=\n  document.native && read.valid && read.binding.database == database &&\n    read.binding.owner == document.owner && read.binding.work == document.work &&\n    document.occurrences.contains read.occurrence && read.binding.limit ≤ identity.chars &&\n    match read.source.subject with\n    | .original original => original == identity\n    | .file file => document.files.contains file\n\ndef Plan.ranges (plan : Plan) : List (Value × List (Nat × Nat × Nat)) :=\n  plan.owners.toList.map fun owner =>\n    (owner.owner.relation, (owner.located.toList.filterMap fun located =>\n      if located.source.file?.isNone then none else some\n      (located.offer.priority, located.row.binding.first, located.row.binding.limit)).eraseDups)\n\nstructure OutputRange where\n  priority : Nat\n  first : Nat\n  limit : Nat\n  path : Option (List JsonScalars.Segment)\n  deriving BEq\n\ndef LocatedOwner.originalRanges (owner : LocatedOwner) : Array (Range × OutputRange) := Id.run do\n  let raw := owner.document.source.getD \"\"\n  let json := JsonScalars.prepare? raw\n  return owner.located.filterMap fun located => do\n    let .original _ := located.source.subject | none\n    some (located.source,{\n      priority := located.offer.priority\n      first := located.row.binding.first\n      limit := located.row.binding.limit\n      path := (json.bind (·.cover? located.row.binding.first located.row.binding.limit)).map (·.path)})\n\ndef Plan.outputRanges (plan : Plan) : List (Value × List OutputRange) := Id.run do\n  let mut originals : Std.HashMap Range (Value × OutputRange) := {}\n  for owner in plan.owners do\n    for (source,range) in owner.originalRanges do\n      if (originals[source]?).all (fun prior => range.priority < prior.2.priority) then\n        originals := originals.insert source (owner.owner.relation,range)\n  return plan.owners.toList.map fun owner =>\n    let shared := originals.toArray.filterMap fun (_,origin,range) =>\n      if origin == owner.owner.relation then some range else none\n    let shared := shared.qsort fun a b => if a.first == b.first then a.limit < b.limit else a.first < b.first\n    (owner.owner.relation, ((owner.outputs.toList.map fun located =>\n      ({priority := located.offer.priority,first := located.fragment.binding.first\n        limit := located.fragment.binding.limit,path := located.fragment.address.map (·.path)} : OutputRange)) ++\n      shared.toList).eraseDups)\n\n/-- Original intervals bind to their immutable native output identity; file\ncoordinates bind through the existing source postings. A graph hint cannot\nnominate a different Work, occurrence or out-of-body interval. -/\ndef build (prepared : Array Recommend.Prepared) (answers : Array (String × Nat))\n    (owners : Array Owner) (query : String) (deadline : Nat)\n    (graphDeadline : Option Nat := none) : IO Plan := do\n  let mut plan : Plan := {}\n  let mut outputWitnesses : Array (String × Array Offer) := #[]\n  let assessedUnixMs ← ObservationAge.now\n  for source in prepared do\n    let consumers := owners.flatMap fun owner =>\n      if owner.database != source.source.head.identity then #[] else\n      let priorities := answers.filterMap fun (key,priority) =>\n        if key == Persistence.selectionKey owner.original.relation then some priority else none\n      (Provenance.identities owner.original).flatMap fun occurrence =>\n        priorities.map fun priority => (occurrence,priority)\n    let result ← Routed.collect source answers query (min deadline (graphDeadline.getD deadline)) consumers\n    let (result,outputs) ← try pure (result,← Routed.outputOffers source result deadline)\n      catch error => pure ({result with complete := false,failure := some s!\"output-witness: {error}\"},#[])\n    outputWitnesses := outputWitnesses.push (source.source.head.identity,outputs)\n    plan := {plan with results := plan.results.push result}\n  let offers := plan.results.flatMap (·.admitted)\n  let mut admitted : Array AdmittedOwner := #[]\n  let mut originals : Std.HashMap (String × Original) (List Nat) := {}\n  for owner in owners do\n    let .ok document := owner.document | plan := {plan with unsupported := plan.unsupported+1}; continue\n    let original := ObservationContext.OriginalOwner.prepare? document\n    if let some original := original then\n      let key := (owner.database,original.identity)\n      originals := originals.insert key (admitted.size :: (originals[key]?.getD []))\n    admitted := admitted.push ⟨owner,document,original⟩\n  -- Prepend in the directory. Appending to a shared array here repeatedly\n  -- copies a growing owner's complete row list.\n  let mut origins : Std.HashMap (String × String) (List Routed.Located) := {}\n  for (source,result) in prepared.zip plan.results do\n    let database := source.source.head.identity\n    let scopedOffers := result.admitted\n    let wanted := (hashDistinct (scopedOffers.toList.filterMap fun hint => do\n      let range ← hint.target.source?\n      let .file _ := range.subject | none\n      some range)).toArray\n    let allowed := admitted.foldl (fun allowed item =>\n      if item.owner.database == database && item.document.native then\n        allowed.insert item.document.owner else allowed) ({} : Std.HashSet String)\n    let resolved ← if wanted.isEmpty then pure ({} : IndexedBindings.Resolved)\n      else if let some index := source.shared then IndexedBindings.resolve index wanted allowed deadline\n      else pure {complete := false,unresolved := wanted.size}\n    plan := {plan with\n      bindingComplete := plan.bindingComplete && resolved.complete\n      bindingRequests := plan.bindingRequests+resolved.requests\n      bindingBytes := plan.bindingBytes+resolved.bytes\n      bindingUnresolved := plan.bindingUnresolved+resolved.unresolved}\n    let mut unresolved : Std.HashSet Range := {}\n    for offer in scopedOffers do\n      let .range target := offer.target | continue\n      if exact : offer.target = .range target then\n        let mut rows := #[]\n        match target.subject with\n        | .file _ => rows := resolved.rows[target]?.getD #[]\n        | .original identity =>\n          for index in originals[(database,identity)]?.getD [] do\n            let some item := admitted[index]? | continue\n            let some original := item.original | continue\n            rows := rows ++ (original.bind database target).map (·.read)\n          if rows.isEmpty then unresolved := unresolved.insert target\n        for row in rows do\n          if contained : target.contains row.source = true then\n            let located : Routed.Located := ⟨offer,target,exact,row,contained⟩\n            let key := (database,row.binding.owner)\n            origins := origins.insert key (located :: (origins[key]?.getD []))\n    plan := {plan with bindingUnresolved := plan.bindingUnresolved+unresolved.size}\n  -- Certified rows and compact prepared recipes cross this boundary. Original\n  -- payload blocks remain in the data-side service; no full view is decoded.\n  -- A graph resource limit cannot erase independently verified source rows.\n  for source in prepared do\n    if let some reference := source.canonical then\n      try\n        let ids := owners.filterMap fun owner =>\n          if owner.database == source.source.head.identity then\n            some (Persistence.selectionKey owner.original.relation) else none\n        let found ← Plugin.Publication.Client.sourceRows reference ids deadline\n        let reuse := (source.source.head.identity,reference.access.reuse,found.reuse)\n        plan := {plan with canonicalReuse := plan.canonicalReuse.push reuse}\n        for (owner,rows) in found.rows do\n          let merged ← IO.ofExcept (CanonicalSource.Delivery.merge ((plan.canonical[owner]?.getD #[]) ++ rows))\n          plan := {plan with canonical := if merged.isEmpty then plan.canonical.erase owner\n            else plan.canonical.insert owner merged}\n        let structures ← Plugin.Publication.Client.sourceRecords reference ids deadline\n        plan := {plan with originalCache := plan.originalCache.push structures.cache}\n        for (owner,found) in structures.rows do\n          let some geometry := found | continue\n          let some witness := admitted.find? (fun item => item.owner.database == source.source.head.identity &&\n            item.document.owner == owner) | throw (IO.userError \"original recipe has no admitted owner\")\n          let some original := witness.original | throw (IO.userError \"original recipe lacks native identity\")\n          unless geometry.header.work == witness.document.work && geometry.header.original == original.identity &&\n              geometry.header.characters == original.identity.chars &&\n              geometry.header.occurrences == witness.document.occurrences &&\n              geometry.spans.all (fun span => span.first < span.limit &&\n                span.limit ≤ geometry.header.characters && span.limit-span.first ≤ 2048) do\n            throw (IO.userError \"original recipe crossed its native content or occurrence\")\n          plan := {plan with originalStructures := plan.originalStructures.insert owner geometry}\n      catch error =>\n        let failure := (source.source.head.identity,error.toString)\n        plan := {plan with canonicalFailure := plan.canonicalFailure.push failure}\n  if offers.isEmpty then return plan\n  -- Query-invariant across owners. Computing this same ordered set inside\n  -- each owner was quadratic work repeated for every hydrated observation.\n  for item in admitted do\n    if (← IO.monoMsNow) ≥ deadline then\n      return {plan with results := plan.results.map fun result =>\n        {result with complete := false,failure := some \"binding-deadline\"}}\n    let owner := item.owner\n    let document := item.document\n    let located := (origins[(owner.database,document.owner)]?.getD []).reverse.toArray.filter fun located =>\n      item.original.any (fun original => boundTo owner.database document original.identity located.row)\n    let rows := (hashDistinct (located.toList.map (·.row))).toArray\n    let witnesses := outputWitnesses.flatMap fun (database,offers) =>\n      if database == owner.database then offers else #[]\n    let context := if witnesses.isEmpty then none else ObservationContext.prepare? document\n    let outputs := context.map (Recommend.locateOutputsUsing witnesses owner.database) |>.getD #[]\n    -- Metadata is fetched only for offered native origins, once per occurrence,\n    -- with a fixed cap and the existing request deadline. It cannot block or\n    -- filter the historical body when unavailable, expired, or clock-skewed.\n    if !located.isEmpty || !outputs.isEmpty then\n      for occurrence in document.occurrences do\n        if plan.observations.any (fun prior => prior.database == owner.database &&\n            prior.owner == document.owner && prior.occurrence == occurrence) then continue\n        let (receivedUnixMs,metadataFailure) ←\n          if plan.observations.size ≥ 256 || (← IO.monoMsNow) ≥ deadline then\n            pure (none,some \"metadata-budget\")\n          else if let some source := prepared.find? (·.source.head.identity == owner.database) then\n            try\n              let origin ← Provenance.lookup? source.source owner.original occurrence\n              pure (origin.bind (·.receivedUnixMs),if origin.isNone then some \"unrecorded\" else none)\n            catch _ => pure (none,some \"metadata-unverified\")\n          else pure (none,some \"source-unavailable\")\n        plan := {plan with observations := plan.observations.push {\n          database := owner.database,owner := document.owner,work := document.work,occurrence\n          age := ObservationAge.assess assessedUnixMs receivedUnixMs,metadataFailure}}\n    plan := {plan with\n      documents := plan.documents.push document\n      rows := plan.rows ++ rows\n      unlocatedFileOwners := plan.unlocatedFileOwners +\n        if !document.files.isEmpty && located.isEmpty then 1 else 0\n      owners := plan.owners.push ⟨owner.original,document,located,outputs⟩}\n  return plan\n\ndef Plan.receiptWith (plan : Plan) (delivery : Extraction.Presentation) : Json :=\n  let bindings := KeyPostings.prepare (·.source) (plan.owners.flatMap (·.located))\n  let originals := ((plan.results.flatMap (·.admitted)).toList.filterMap fun offer => do\n    let source ← offer.target.source?\n    let .original _ := source.subject | none\n    some source) |> hashDistinct |>.toArray\n  Json.mkObj [\n    (\"complete\", toJson plan.complete), (\"unsupportedOwners\", toJson plan.unsupported),\n    (\"bindingComplete\",toJson plan.bindingComplete),(\"bindingRequests\",toJson plan.bindingRequests),\n    (\"bindingBytes\",toJson plan.bindingBytes),(\"bindingUnresolved\",toJson plan.bindingUnresolved),\n    (\"unlocatedFileOwners\",toJson plan.unlocatedFileOwners),\n    (\"observationAges\",toJson plan.observations),\n    (\"originalRecipeCache\",toJson plan.originalCache),\n    (\"originalRecipeOwners\",toJson plan.originalStructures.size),\n    (\"inputs\", toJson (plan.results.map Routed.Result.receipt)),\n    (\"originalReferences\",toJson (originals.map fun source =>\n      let bindings := (bindings.lookup source).map (·.row.binding)\n      let origins := bindings.foldl (fun known binding => known.insert binding) ({} : Std.HashSet Binding)\n      let origins := origins.toArray.qsort fun a b => (toJson a).compress < (toJson b).compress\n      Json.mkObj [\n      (\"source\",toJson source), (\"bodyDelivered\",toJson (covered source delivery.ranges)),\n      (\"origins\",toJson origins)])),\n    (\"originalOutputs\",toJson (plan.owners.flatMap fun owner => owner.outputs.map fun located =>\n      Json.mkObj [\n        (\"evidence\",toJson located.offer.identity), (\"binding\",toJson located.fragment.binding),\n        (\"path\",toJson (located.fragment.address.map (fun address => JsonScalars.pathJson address.path))),\n        (\"bodyDelivered\",toJson (delivery.coversBinding located.fragment.binding)),\n        (\"addressDelivered\",toJson (located.fragment.address.map (fun address =>\n          delivery.coversAddress located.fragment.binding address.path)))])),\n    (\"offers\", toJson (plan.results.flatMap fun result => result.admitted.map fun offer =>\n      let delivered := match offer.target with\n        | .range source => covered source delivery.ranges\n        | .output _ => plan.owners.any fun owner => owner.outputs.any fun located =>\n            located.offer.identity == offer.evidence && delivery.coversBinding located.fragment.binding\n      Json.mkObj [(\"offer\", offer.json), (\"bodyDelivered\", toJson delivered)]))]\n\ndef Plan.receipt (plan : Plan) (text : String) : Json :=\n  plan.receiptWith (Extraction.presented text plan.documents plan.rows)\n\nend Eggshell.Synapses.Transport\n",[]]
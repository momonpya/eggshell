["module\n\npublic import Eggshell.GraphStore\npublic import Eggshell.SynapseProvenance\npublic import Eggshell.SynapticTopologyStore\npublic import Eggshell.ObservedRecordView\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Index\nopen Lean DB\n\n/-- The implementation key follows source bytes, never a hand-maintained version. -/\ndef implementation : String :=\n  Blake3.hex (Blake3.digest \"eggshell.synaptic-index\".toUTF8 [\n    (include_str \"SynapticTopology.lean\").toUTF8,(include_str \"SynapticTopologyStore.lean\").toUTF8,\n    (include_str \"../tools/SpanPostings.lean\").toUTF8,\n    (include_str \"Synapses.lean\").toUTF8, (include_str \"SynapseExtraction.lean\").toUTF8,\n    (include_str \"SynapseSource.lean\").toUTF8, (include_str \"SynapseUsage.lean\").toUTF8,\n    (include_str \"SynapseIndex.lean\").toUTF8, (include_str \"SynapseBuild.lean\").toUTF8,\n    (include_str \"SynapseProvenance.lean\").toUTF8, (include_str \"ObservationAge.lean\").toUTF8,\n    (include_str \"ContentCapture.lean\").toUTF8,(include_str \"ContentMetadata.lean\").toUTF8,\n    (include_str \"../tools/ContentCorrespondence.lean\").toUTF8,\n    (include_str \"JsonScalars.lean\").toUTF8,\n    (include_str \"SynapseQuotes.lean\").toUTF8,\n    (include_str \"ObservationContext.lean\").toUTF8,(include_str \"Sha256.lean\").toUTF8,\n    (include_str \"QuotationContext.lean\").toUTF8,\n    (include_str \"ObservedRecords.lean\").toUTF8,\n    (include_str \"ObservedRecordView.lean\").toUTF8,\n    (include_str \"OriginalStructure.lean\").toUTF8,\n    (include_str \"../tools/LiteralSearch.lean\").toUTF8,\n    (include_str \"SourceEvidence.lean\").toUTF8,\n    (include_str \"SearchUnicode.lean\").toUTF8,\n    (include_str \"../tools/RetrievalCategories.lean\").toUTF8])\n\ndef factName (fact : Fact) : String := \"fact:\" ++ contentKey fact\n\ndef postingPrefix (key : Key) : String := \"lookup:\" ++ contentKey key ++ \":\"\n\nstructure Posting where\n  key : Key\n  fact : String\n  deriving BEq, ToJson, FromJson\n\ndef postingName (key : Key) (fact : Fact) : String := postingPrefix key ++ contentKey fact\n\ndef eventName (event : Event) : String := \"event:\" ++ contentKey event\n\ndef belongs (database : String) : Fact → Bool\n  | .read recorded => recorded.binding.database == database\n  | .supports support => support.claim.database == database && support.read.binding.database == database\n  | .coquoted (.answer owner _) _ => owner == database\n  | .coquoted (.claim claim) _ => claim.database == database\n  | .consumed _ | .used _ => true\n\ndef checkDestination (storage : Sidecar.Storage) (scope : Scope) : IO Unit :=\n  if scope == .usage && storage != .user then\n    throw (IO.userError \"synaptic usage must stay in the private DB overlay\")\n  else pure ()\n\nstructure Manifest where\n  source : PageMap.Head\n  implementation : String\n  scope : Scope\n  facts : Nat\n  deriving BEq, ToJson, FromJson\n\ndef manifest? (snapshot : PageMap.Snapshot) : IO (Option Manifest) := do\n  (← snapshot.get \"manifest\").mapM (decode (α := Manifest))\n\n/-- An old index is usable across derived-only commits, through exact parent heads.\nThe lookup path examines at most the supplied number of journal entries. -/\ndef sameSources (snapshot : PageMap.Snapshot) (saved : PageMap.Head) (limit : Nat := 16) : IO Bool := do\n  if saved.identity != snapshot.head.identity || saved.authority != snapshot.head.authority then return false\n  let mut current := snapshot.head\n  for _ in [:limit] do\n    if current == saved then return true\n    if current.revision ≤ saved.revision then return false\n    let publication ← Persistence.Store.readPublication snapshot current.revision\n    if !publication.change.neutral then return false\n    current := publication.parent\n  return current == saved\n\ndef directory (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\n    IO System.FilePath := do\n  return (← Sidecar.locate snapshot storage).directory / \"synapses\" / scope.directory\n\ndef prepare (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\n    IO PageMap.Snapshot := do\n  if scope == .usage && storage != .user then\n    throw (IO.userError \"synaptic usage must stay in the private DB overlay\")\n  let sidecar ← Sidecar.prepare (Sidecar.Owner.ofSnapshot snapshot) storage\n  let parent ← Sidecar.childDirectory sidecar.directory \"synapses\"\n  let path := parent / scope.directory\n  match ← PageMap.open? path with\n  | some snapshot => return snapshot\n  | none => PageMap.create path (\"advisory:\" ++ snapshot.head.identity ++ \":\" ++ scope.directory)\n\nstructure Reader where\n  index : PageMap.Snapshot\n  manifest : Manifest\n\n/-- Opening never creates an index or prepares a directory inside a shared DB. -/\ndef open? (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) : IO (Option Reader) := do\n  if scope == .usage && storage != .user then return none\n  let path ← directory source storage scope\n  let some index ← PageMap.open? path | return none\n  let some metadata ← manifest? index | return none\n  unless metadata.implementation == implementation && metadata.scope == scope do return none\n  if scope == .shared then\n    unless (← index.get \"provenance\") == some (toJson (← Provenance.stamp source)).compress.toUTF8 do return none\n    unless ← sameSources source metadata.source do return none\n  else\n    unless metadata.source.identity == source.head.identity &&\n        metadata.source.authority == source.head.authority do return none\n  return some ⟨index, metadata⟩\n\ndef openShared? (source : PageMap.Snapshot) : IO (Option Reader) := do\n  if let some reader ← open? source .database .shared then return some reader\n  open? source .user .shared\n\ndef putImmutable (writer : PageMap.Writer) (name : String) (bytes : ByteArray) : IO Bool := do\n  if let some previous ← writer.get name then\n    unless previous == bytes do throw (IO.userError \"conflicting synaptic content address\")\n    return false\n  writer.put name (some bytes)\n  return true\n\ndef insert (writer : PageMap.Writer) (database : String) (scope : Scope) (fact : Fact) : IO Bool := do\n  unless scope.accepts fact && belongs database fact && fact.valid do\n    throw (IO.userError \"invalid fact or wrong synaptic privacy/DB scope\")\n  if let .used usage := fact then\n    let _ ← putImmutable writer (eventName usage.event) (← checkedBytes usage)\n  let inserted ← putImmutable writer (factName fact) (← checkedBytes fact)\n  Routing.Store.insert writer fact\n  for key in addresses fact do\n    let posting : Posting := ⟨key, contentKey fact⟩\n    let _ ← putImmutable writer (postingName key fact) (← checkedBytes posting)\n  return inserted\n\ndef erase (writer : PageMap.Writer) (fact : Fact) : IO Bool := do\n  let name := factName fact\n  let some previous ← writer.get name | return false\n  unless previous == (toJson fact).compress.toUTF8 do\n    throw (IO.userError \"retired synaptic object differs from its content address\")\n  Routing.Store.erase writer fact\n  writer.put name none\n  for key in addresses fact do writer.put (postingName key fact) none\n  -- Retiring a recommendation does not permit relabelling an observed event.\n  -- The small immutable witness remains until its owning DB cache is retired.\n  return true\n\nstructure Delta where\n  removed : Array Fact := #[]\n  added : Array Fact := #[]\n\ndef checkFacts (database : String) (scope : Scope) (facts : Array Fact) : IO Unit :=\n  unless facts.all (fun fact => scope.accepts fact && belongs database fact && fact.valid) do\n    throw (IO.userError \"invalid fact or wrong synaptic privacy/DB scope\")\n\n/-- One metadata publication commits facts and all inverse postings together.\nAn incompatible prior implementation needs a full replacement, never reuse. -/\ndef publishDelta (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\n    (expected : Option PageMap.Head) (delta : Delta)\n    (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\n  checkDestination storage scope\n  checkFacts source.head.identity scope delta.added\n  checkFacts source.head.identity scope delta.removed\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\n    let index ← prepare source storage scope\n    let previous ← manifest? index\n    if let some previous := previous then\n      if scope == .shared && previous.source.revision > source.head.revision then\n        throw (IO.userError \"older source cannot replace a later synaptic publication\")\n      unless previous.source == expected.getD source.head && previous.implementation == implementation &&\n          previous.scope == scope do throw (IO.userError \"stale synaptic index update\")\n    else if expected.isSome then throw (IO.userError \"missing synaptic index update base\")\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\n      let mut count := previous.map (·.facts) |>.getD 0\n      for fact in delta.removed do\n        if ← erase writer fact then count := count-1\n      for fact in delta.added do\n        if ← insert writer source.head.identity scope fact then count := count+1\n      prepareRecords writer\n      let next : Manifest := ⟨source.head, implementation, scope, count⟩\n      Routing.Store.finish writer count\n      let bytes ← checkedBytes next\n      if (← writer.get \"manifest\") != some bytes then writer.put \"manifest\" (some bytes)\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\n      if (← writer.get \"provenance\") != some provenance then writer.put \"provenance\" (some provenance)\n    return head) storage\n\ndef allFacts (index : PageMap.Snapshot) : IO (Array Fact) :=\n  index.foldRange ⟨\"fact:\", \"fact;\"⟩ (fun facts row => do\n    let some bytes := row.2 | return facts\n    let fact ← decode (α := Fact) bytes\n    unless row.1 == factName fact && fact.valid do throw (IO.userError \"foreign synaptic fact row\")\n    return facts.push fact) #[]\n\n/-- Explicit warm/background replacement; it never runs in a search hook. -/\ndef replace (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\n    (facts : Array Fact) (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\n  checkDestination storage scope\n  checkFacts source.head.identity scope facts\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\n    let index ← prepare source storage scope\n    if let some previous ← manifest? index then\n      if scope == .shared && previous.source.revision > source.head.revision then\n        throw (IO.userError \"older source cannot replace a later synaptic publication\")\n    let wanted := facts.foldl (fun wanted fact => wanted.insert (factName fact)) ({} : Std.HashSet String)\n    let old ← allFacts index\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\n      for fact in old do\n        if !wanted.contains (factName fact) then let _ ← erase writer fact; pure ()\n      for fact in facts do let _ ← insert writer source.head.identity scope fact; pure ()\n      prepareRecords writer\n      let next : Manifest := ⟨source.head, implementation, scope, wanted.size⟩\n      Routing.Store.finish writer wanted.size\n      let bytes ← checkedBytes next\n      if (← writer.get \"manifest\") != some bytes then writer.put \"manifest\" (some bytes)\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\n      if (← writer.get \"provenance\") != some provenance then writer.put \"provenance\" (some provenance)\n    return head) storage\n\nstructure Scan where\n  postings : Array Posting := #[]\n  inspected : Nat := 0\n  pages : Nat := 0\n  complete : Bool := true\n\n/-- Stop in the tree, rather than materializing or traversing all postings. -/\ndef scanAt (index : PageMap.Snapshot) (ref : PageMap.Ref) (range : PageMap.KeyRange)\n    (limit deadline : Nat) (initial : Scan) : IO Scan := do\n  if !initial.complete then return initial\n  if initial.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {initial with complete := false}\n  let loaded ← index.load ref\n  let mut result := {initial with pages := initial.pages+1}\n  match loaded.page with\n  | .leaf rows =>\n    for row in range.select rows do\n      if result.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\n      let some bytes := row.2 | continue\n      let posting ← decode (α := Posting) bytes\n      unless row.1 == postingPrefix posting.key ++ posting.fact do throw (IO.userError \"foreign synaptic posting\")\n      result := {result with postings := result.postings.push posting, inspected := result.inspected+1}\n    return result\n  | .branch children =>\n    for child in children do\n      if range.overlaps child then\n        if _smaller : child.height < ref.height then\n          result ← scanAt index child range limit deadline result\n        else throw (IO.userError \"synaptic index height did not decrease\")\n        if !result.complete then return result\n    return result\ntermination_by ref.height\n\n/-- This certifies the advisory inverse relation, not Work or completion authority. -/\nstructure CheckedFact (key : Key) where\n  fact : Fact\n  valid : fact.valid = true\n  bound : key ∈ addresses fact\n\ndef CheckedFact.check? (key : Key) (fact : Fact) : Option (CheckedFact key) :=\n  if valid : fact.valid = true then\n    if bound : (addresses fact).contains key = true then\n      some ⟨fact, valid, Array.mem_of_contains_eq_true bound⟩\n    else none\n  else none\n\nstructure Lookup (key : Key) where\n  checked : Array (CheckedFact key)\n  complete : Bool\n  postingPages : Nat\n  index : PageMap.Head\n  payloadBytes : Nat := 0\n\ndef Lookup.facts (lookup : Lookup key) : Array Fact := lookup.checked.map (·.fact)\n\ntheorem Lookup.returned_bound (lookup : Lookup key) (fact : Fact)\n    (present : fact ∈ lookup.facts) :\n    fact.valid = true ∧ key ∈ addresses fact := by\n  simp only [Lookup.facts, Array.mem_map] at present\n  obtain ⟨checked, _, equal⟩ := present\n  subst fact\n  exact ⟨checked.valid, checked.bound⟩\n\ndef Reader.lookup (reader : Reader) (key : Key) (limit deadline : Nat)\n    (byteLimit : Option Nat := none) : IO (Lookup key) := do\n  let name := postingPrefix key\n  let scanned ← match reader.index.head.root with\n    | none => pure ({} : Scan)\n    | some root => scanAt reader.index root ⟨name, \"lookup:\" ++ contentKey key ++ \";\"⟩ limit deadline {}\n  let mut facts := #[]\n  let mut complete := scanned.complete\n  let mut payloadBytes := 0\n  for posting in scanned.postings do\n    if (← IO.monoMsNow) ≥ deadline then\n      complete := false\n      break\n    unless posting.key == key do throw (IO.userError \"ambiguous synaptic key digest\")\n    let some bytes ← reader.index.get (\"fact:\" ++ posting.fact) |\n      throw (IO.userError \"dangling synaptic posting\")\n    if byteLimit.any (payloadBytes+bytes.size > ·) then\n      complete := false\n      break\n    let fact ← decode (α := Fact) bytes\n    unless fact.valid && reader.manifest.scope.accepts fact && belongs reader.manifest.source.identity fact &&\n        contentKey fact == posting.fact && (addresses fact).contains key do\n      throw (IO.userError \"synaptic posting does not bind its original fact\")\n    let some checked := CheckedFact.check? key fact |\n      throw (IO.userError \"unbound advisory index result\")\n    facts := facts.push checked\n    payloadBytes := payloadBytes+bytes.size\n  return ⟨facts, complete, scanned.pages, reader.index.head, payloadBytes⟩\n\nend Eggshell.Synapses.Index\n",[["SynapticTopology.lean","module\npublic import Eggshell.GraphStore\npublic import Eggshell.SynapseSource\n@[expose] public section\nnamespace Eggshell.Synapses\nopen Lean DB\nnamespace Index\ninductive Scope where\n  | shared | usage\n  deriving Repr, BEq, ToJson, FromJson\n\ndef Scope.directory : Scope → String\n  | .shared => \"recommendations\"\n  | .usage => \"usage\"\n\ndef Scope.accepts (scope : Scope) : Fact → Bool\n  | .used _ => scope == .usage\n  | _ => scope == .shared\n\ntheorem shared_rejects_usage (usage : Usage) : Scope.shared.accepts (.used usage) = false := rfl\n\ninductive Key where\n  | owner (database owner : String)\n  | answer (database owner : String)\n  | claim (claim : Claim)\n  | consumer (occurrence : Occurrence)\n  | group (group : Group)\n  | quoted (source : Range)\n  | source (source : Range)\n  | subject (subject : Subject)\n  | quotation (digest : String)\n  | query (digest : String)\n  | usage (source : Range)\n  deriving Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, ToJson, FromJson\n\ndef addresses : Fact → Array Key\n  | .read recorded => #[.owner recorded.binding.database recorded.binding.owner, .source recorded.source, .subject recorded.source.subject] ++\n      recorded.quotations.map Key.quotation\n  | .supports support => #[\n      .answer support.claim.database support.claim.answer, .claim support.claim, .source support.source]\n  | .consumed edge => #[.consumer edge.consumer]\n  | .coquoted group source => #[.group group, .quoted source]\n  | .used usage => #[.query usage.query, .usage usage.source]\n\ndef contentKey [ToJson α] (value : α) : String :=\n  Blake3.hex (Blake3.digest \"eggshell.synaptic-object\".toUTF8 [(toJson value).compress.toUTF8])\n\ndef payloadLimit : Nat := 262144\n\ndef decode [FromJson α] [ToJson α] (bytes : ByteArray) : IO α := do\n  unless bytes.size ≤ payloadLimit do throw (IO.userError \"synaptic record exceeds its byte bound\")\n  let some text := String.fromUTF8? bytes | throw (IO.userError \"invalid synaptic UTF-8\")\n  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))\n  unless (toJson value).compress.toUTF8 == bytes do\n    throw (IO.userError \"noncanonical synaptic record\")\n  return value\n\ndef checkedBytes [ToJson α] (value : α) : IO ByteArray := do\n  let bytes := (toJson value).compress.toUTF8\n  unless bytes.size ≤ payloadLimit do throw (IO.userError \"synaptic record exceeds its byte bound\")\n  return bytes\n\nend Index\nnamespace Recommend\n/-- Output identity is native occurrence identity. File coordinates are an\nadditional addressing scheme, never a prerequisite for recommending data. -/\ninductive Target where\n  | range (source : Range)\n  | output (producer : Occurrence)\n  deriving DecidableEq, BEq, ToJson\n\ndef Target.source? : Target → Option Range\n  | .range source => some source\n  | .output _ => none\n\n/-- A recommendation names data actually carried by its advisory witness.\nOrdinary rereads and changed sources do not reward a candidate. -/\ndef carries (fact : Fact) : Target → Bool\n  | .output producer => match fact with\n    | .consumed edge => edge.producer == producer\n    | _ => false\n  | .range source => match fact with\n    | .supports support => support.source == source\n    | .consumed edge => edge.rows.contains source\n    | .coquoted _ quoted => quoted == source\n    | .used usage => usage.source == source &&\n        (usage.kind == .omittedThenRead || usage.kind == .omittedThenConsumed || usage.kind == .deliveredThenCited)\n    | .read _ => false\n\nderiving instance FromJson for Target\nend Recommend\nnamespace Routing\nopen Recommend\n/-- One step in the existing advisory relation. No original output, command\ngrammar, similarity score, or human reference list enters this projection. -/\nstructure Step where\n  targets : Array Target := #[]\n  next : Array Index.Key := #[]\n  deriving BEq\n\ndef project (key : Index.Key) (fact : Fact) : Step :=\n  match key, fact with\n  | .answer .., .supports support =>\n    ⟨#[.range support.source], #[.group (.claim support.claim),\n      .consumer support.read.occurrence, .quoted support.source]⟩\n  | .consumer _, .consumed edge =>\n    ⟨if edge.rows.isEmpty then #[.output edge.producer] else edge.rows.map Target.range,\n      edge.rows.map Index.Key.quoted |>.push (.consumer edge.producer)⟩\n  | .quoted _, .coquoted group _ => ⟨#[], #[.group group]⟩\n  | .group _, .coquoted _ source => ⟨#[.range source], #[]⟩\n  | .query _, .used value =>\n    if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed ||\n        value.kind == .deliveredThenCited then\n      ⟨#[.range value.source], #[.quoted value.source]⟩ else {}\n  | _, _ => {}\n\n/-- Projection cannot invent a recommended target. Control authority remains\noutside this module: a supported target is still only an advisory witness. -/\ntheorem project_carries (key : Index.Key) (fact : Fact) (target : Target)\n    (present : target ∈ (project key fact).targets) : carries fact target = true := by\n  cases key <;> cases fact <;> simp only [project] at present <;>\n    try simp_all [carries]\n  all_goals\n    split at present <;> simp_all [Array.mem_map, Bool.or_eq_true, beq_iff_eq]\n  obtain ⟨source,member,rfl⟩ := present\n  simpa using member\n\nend Routing\nend Eggshell.Synapses\n"],["SynapticTopologyStore.lean","module\npublic import Eggshell.SynapticTopology\n@[expose] public section\nnamespace Eggshell.Synapses.Routing.Store\nopen Lean DB Recommend\ndef implementation : String := Blake3.hex (Blake3.digest \"eggshell.synaptic-topology\".toUTF8 [\n  (include_str \"SynapticTopology.lean\").toUTF8,(include_str \"SynapticTopologyStore.lean\").toUTF8])\n\n/-- This is an advisory projection, never an Outcome or a completion proof.\nThe original fact remains in the pinned source index and is not copied. -/\nstructure Arc where\n  evidence : String\n  kind : Nat\n  group : Option Nat\n  targets : Array Nat\n  next : Array Nat\n  deriving BEq\n\ndef arcCodec : Wire.Codec Arc :=\n  (Wire.text.product (Wire.natural.product ((Wire.optional Wire.natural).product\n    ((Wire.list Wire.natural).product (Wire.list Wire.natural))))).iso\n    (fun arc => (arc.evidence,arc.kind,arc.group,arc.targets.toList,arc.next.toList))\n    (fun (evidence,kind,group,targets,next) => ⟨evidence,kind,group,targets.toArray,next.toArray⟩)\n    (by intro arc; cases arc; simp)\n\ntheorem arc_roundtrip (arc : Arc) (tail : List UInt8) :\n    arcCodec.decode (arcCodec.encode arc ++ tail) = .ok (arc,tail) :=\n  arcCodec.roundtrip arc tail\n\ndef encode (arc : Arc) : ByteArray := (arcCodec.encode arc).toByteArray\n\ndef decode (payload : ByteArray) : IO Arc := do\n  unless payload.size ≤ Index.payloadLimit do throw (IO.userError \"routing arc exceeds its bound\")\n  let (arc,rest) ← IO.ofExcept (arcCodec.decode payload.toList)\n  unless rest.isEmpty && encode arc == payload && digest arc.evidence && arc.kind < 6 &&\n      (arc.kind == 0 || arc.kind == 2) == arc.group.isSome do\n    throw (IO.userError \"invalid or noncanonical routing arc\")\n  return arc\n\ndef kind : Fact → Nat\n  | .supports _ => 0\n  | .consumed _ => 1\n  | .coquoted .. => 2\n  | .used usage => match usage.kind with\n    | .omittedThenRead => 3\n    | .omittedThenConsumed => 4\n    | _ => 5\n  | .read _ => 0\n\ndef kindName : Nat → String\n  | 0 => \"support\" | 1 => \"consumption\" | 2 => \"coquotation\"\n  | 3 => \"omitted_then_read\" | 4 => \"omitted_then_consumed\"\n  | _ => \"delivered_then_cited\"\n\nstructure Node where\n  key : Index.Key\n  id : Nat\n  deriving ToJson, FromJson\n\nstructure Destination where\n  target : Target\n  id : Nat\n  deriving ToJson, FromJson\n\nstructure Counts where\n  facts : Nat := 0\n  nodes : Nat := 0\n  targets : Nat := 0\n  arcs : Nat := 0\n  deriving ToJson, FromJson\n\ndef arcPrefix (node : Nat) : String := s!\"route:arc:{node}:\"\ndef arcName (node : Nat) (identity : String) : String := arcPrefix node ++ identity\ndef nodeName (node : Nat) : String := s!\"route:node:{node}\"\ndef targetName (target : Nat) : String := s!\"route:target:{target}\"\n\ndef put [ToJson α] (writer : PageMap.Writer) (key : String) (value : α) : IO Unit := do\n  writer.put key (some (← Index.checkedBytes value))\n\ndef counts (writer : PageMap.Writer) : IO Counts := do\n  match ← writer.get \"route:counts\" with\n  | some bytes => Index.decode bytes\n  | none => pure {}\n\ndef internNode (writer : PageMap.Writer) (key : Index.Key) : IO Nat := do\n  let name := \"route:key:\" ++ Index.contentKey key\n  if let some bytes ← writer.get name then\n    let node ← Index.decode (α := Node) bytes\n    unless node.key == key do throw (IO.userError \"routing node digest ambiguity\")\n    return node.id\n  let previous ← counts writer\n  let node : Node := ⟨key,previous.nodes⟩\n  put writer name node\n  put writer (nodeName node.id) node\n  put writer \"route:counts\" {previous with nodes := previous.nodes+1}\n  return node.id\n\ndef internDestination (writer : PageMap.Writer) (target : Target) : IO Nat := do\n  let name := \"route:destination:\" ++ Index.contentKey target\n  if let some bytes ← writer.get name then\n    let destination ← Index.decode (α := Destination) bytes\n    unless destination.target == target do throw (IO.userError \"routing target digest ambiguity\")\n    return destination.id\n  let previous ← counts writer\n  let destination : Destination := ⟨target,previous.targets⟩\n  put writer name destination\n  put writer (targetName destination.id) destination\n  put writer \"route:counts\" {previous with targets := previous.targets+1}\n  return destination.id\n\n/-- Only checked facts feed the projection. Full original evidence is kept in\nthe original index; the new rows contain handles and graph incidence only. -/\ndef insert (writer : PageMap.Writer) (fact : Fact) : IO Unit := do\n  unless fact.valid do throw (IO.userError \"invalid routing source fact\")\n  let identity := Index.contentKey fact\n  if (← writer.get (\"route:fact:\" ++ identity)).isSome then return\n  let mut nodes : Array Nat := #[]\n  for key in Index.addresses fact do\n    let step := Routing.project key fact\n    if step.targets.isEmpty && step.next.isEmpty then continue\n    let id ← internNode writer key\n    let targets ← step.targets.mapM (internDestination writer)\n    let next ← step.next.mapM (internNode writer)\n    let group ← match fact with\n      | .supports support => pure (some (← internNode writer (.group (.claim support.claim))))\n      | .coquoted group _ => pure (some (← internNode writer (.group group)))\n      | _ => pure none\n    let arc : Arc := ⟨identity,kind fact,group,targets,next⟩\n    let payload := encode arc\n    unless payload.size ≤ Index.payloadLimit do throw (IO.userError \"routing arc exceeds its bound\")\n    writer.put (arcName id identity) (some payload)\n    nodes := nodes.push id\n  put writer (\"route:fact:\" ++ identity) nodes\n  let previous ← counts writer\n  put writer \"route:counts\" {previous with facts := previous.facts+1,arcs := previous.arcs+nodes.size}\n\n/-- Fact incidence is removed by its persisted handles, never by a graph or\ndictionary scan. Interned keys survive so old pinned readers remain valid. -/\ndef erase (writer : PageMap.Writer) (fact : Fact) : IO Unit := do\n  let identity := Index.contentKey fact\n  let some bytes ← writer.get (\"route:fact:\" ++ identity) | return\n  let nodes ← Index.decode (α := Array Nat) bytes\n  for node in nodes do\n    let some bytes ← writer.get (arcName node identity) | throw (IO.userError \"missing retired routing incidence\")\n    let arc ← decode bytes\n    unless arc.evidence == identity do throw (IO.userError \"retired routing incidence differs from its fact\")\n    writer.put (arcName node identity) none\n  let previous ← counts writer\n  unless 0 < previous.facts && nodes.size ≤ previous.arcs do throw (IO.userError \"routing counters underflow\")\n  writer.put (\"route:fact:\" ++ identity) none\n  put writer \"route:counts\" {previous with facts := previous.facts-1,arcs := previous.arcs-nodes.size}\n\n/-- Sealed in the source fact writer, after the exact same add/remove delta.\nNo second DB publication or asynchronous readiness marker is involved. -/\ndef finish (writer : PageMap.Writer) (expected : Nat) : IO Unit := do\n  let total ← counts writer\n  unless total.facts == expected do throw (IO.userError \"routing projection differs from source fact count\")\n  let bytes ← Index.checkedBytes implementation\n  if (← writer.get \"route:implementation\") != some bytes then\n    writer.put \"route:implementation\" (some bytes)\n\nend Eggshell.Synapses.Routing.Store\n"],["../tools/SpanPostings.lean","module\npublic import Std.Data.HashMap.Lemmas\n@[expose] public section\nnamespace Eggshell.SpanPostings\n\n/-- Exact original-byte coordinates index the original candidate sequence.\nValues, order and duplicates are retained; hashing is only a directory. -/\ndef directory (spanOf : α → Option (Nat × Nat)) (values : List α) :\n    Std.HashMap (Nat × Nat) (List α) :=\n  values.foldr (fun value found => match spanOf value with\n    | none => found\n    | some span => found.insert span (value :: found[span]?.getD [])) {}\n\ntheorem directory_exact (spanOf : α → Option (Nat × Nat)) (values : List α)\n    (span : Nat × Nat) :\n    (directory spanOf values)[span]?.getD [] = values.filter (fun value => spanOf value == some span) := by\n  induction values with\n  | nil => simp [directory]\n  | cons value rest ih =>\n    cases found : spanOf value with\n    | none => simpa [directory,found] using ih\n    | some actual =>\n      by_cases same : actual = span\n      · simpa [directory,found,same] using congrArg (List.cons value) ih\n      · simpa [directory,found,same,Std.HashMap.getElem?_insert] using ih\n\nstructure Index (spanOf : α → Option (Nat × Nat)) (values : List α) where\n  postings : Std.HashMap (Nat × Nat) (List α)\n  exact : ∀ span, postings[span]?.getD [] = values.filter (fun value => spanOf value == some span)\n\ndef prepare (spanOf : α → Option (Nat × Nat)) (values : List α) : Index spanOf values :=\n  ⟨directory spanOf values,directory_exact spanOf values⟩\n\nvariable {α : Type u} {spanOf : α → Option (Nat × Nat)} {values : List α}\n\ndef Index.lookup (index : Index spanOf values) (span : Nat × Nat) : List α :=\n  index.postings[span]?.getD []\n\ntheorem Index.lookup_exact (index : Index spanOf values) (span : Nat × Nat) :\n    index.lookup span = values.filter (fun value => spanOf value == some span) := index.exact span\n\nend Eggshell.SpanPostings\n"],["Synapses.lean","module\n\npublic import Std.Data.HashSet.Lemmas\npublic import Lean.Data.Json.FromToJson\n\n@[expose] public section\n\nnamespace Eggshell.Synapses\nopen Lean\n\n/-- Recommendation evidence has no import of Value, Match or Union authority. -/\nstructure File where\n  relative : String\n  fingerprint : String\n  bytes : Nat\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef safeRelative (path : String) : Bool :=\n  !path.isEmpty && !path.startsWith \"/\" && !path.contains '\\x00' &&\n    (path.splitOn \"/\").all (fun part => !part.isEmpty && part != \".\" && part != \"..\")\n\ndef digest (text : String) : Bool :=\n  text.length == 64 && text.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f'))\n\ndef File.valid (file : File) : Bool := safeRelative file.relative && digest file.fingerprint\n\n/-- Exact immutable output identity. A Work hash and its entire saved payload\nidentify data across sessions without equating operations or their authority. -/\nstructure Original where\n  work : String\n  content : String\n  chars : Nat\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Original.valid (original : Original) : Bool :=\n  !original.work.isEmpty && digest original.content\n\ninductive Subject where\n  | file (file : File)\n  | original (original : Original)\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ninstance : Coe File Subject := ⟨Subject.file⟩\n\ndef Subject.valid : Subject → Bool\n  | .file data => data.valid\n  | .original data => data.valid\n\ndef Subject.file? : Subject → Option File\n  | .file data => some data\n  | .original _ => none\n\ndef Subject.sameLocation (left right : Subject) : Bool := match left,right with\n  | .file a,.file b => a.relative == b.relative\n  | .original a,.original b => a.work == b.work\n  | _,_ => false\n\n/-- Closed intervals over immutable subjects. File coordinates are line\nnumbers; original-output coordinates are one-based character positions. -/\nstructure Range where\n  subject : Subject\n  first : Nat\n  last : Nat\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Range.valid (range : Range) : Bool :=\n  range.subject.valid && 0 < range.first && range.first ≤ range.last &&\n    match range.subject with | .file _ => true | .original original => range.last ≤ original.chars\n\ndef Range.file? (range : Range) : Option File := range.subject.file?\n\ndef Range.original (original : Original) (first limit : Nat) : Range :=\n  ⟨.original original,first+1,limit⟩\n\ndef Range.contains (outer inner : Range) : Bool :=\n  outer.subject == inner.subject && outer.first ≤ inner.first && inner.last ≤ outer.last\n\ntheorem Range.contains_self (range : Range) : range.contains range = true := by\n  simp [Range.contains]\n\n/-- A saved part of a citation must lie in both original intervals. The\nfingerprint is part of equality; a path match alone cannot make an overlap. -/\ndef Range.intersection? (left right : Range) : Option Range :=\n  let source := {left with first := max left.first right.first, last := min left.last right.last}\n  if source.valid && left.contains source && right.contains source then some source else none\n\ntheorem Range.intersection_within {left right source : Range}\n    (found : left.intersection? right = some source) :\n    source.valid = true ∧ left.contains source = true ∧ right.contains source = true := by\n  unfold intersection? at found\n  dsimp only at found\n  split at found\n  · rename_i valid\n    simp only [Option.some.injEq] at found\n    subst source\n    simpa only [Bool.and_eq_true, and_assoc] using valid\n  · contradiction\n\nstructure Occurrence where\n  session : String\n  turn : String\n  useId : String\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Occurrence.valid (occurrence : Occurrence) : Bool :=\n  !occurrence.session.isEmpty && !occurrence.turn.isEmpty && !occurrence.useId.isEmpty\n\nstructure Binding where\n  database : String\n  owner : String\n  work : String\n  first : Nat\n  limit : Nat\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Binding.valid (binding : Binding) : Bool :=\n  !binding.database.isEmpty && !binding.owner.isEmpty && !binding.work.isEmpty &&\n    binding.first < binding.limit\n\nstructure Read where\n  occurrence : Occurrence\n  source : Range\n  binding : Binding\n  /-- Selector keys only. Rebuild rechecks the original quoted spelling. -/\n  quotations : Array String := #[]\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Read.valid (read : Read) : Bool :=\n  read.occurrence.valid && read.source.valid && read.binding.valid && read.quotations.all digest &&\n    match read.source.subject with\n    | .file _ => true\n    | .original original => original.work == read.binding.work &&\n        read.source.first == read.binding.first+1 && read.source.last == read.binding.limit\n\ntheorem original_read_binding (read : Read) (original : Original)\n    (kind : read.source.subject = .original original) (valid : read.valid = true) :\n    original.work = read.binding.work ∧ read.source.first = read.binding.first+1 ∧\n      read.source.last = read.binding.limit := by\n  have checked := valid\n  simp only [Read.valid,kind,Bool.and_eq_true,beq_iff_eq] at checked\n  simpa only [and_assoc] using checked.2\n\nstructure Claim where\n  database : String\n  answer : String\n  first : Nat\n  limit : Nat\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Claim.valid (claim : Claim) : Bool :=\n  !claim.database.isEmpty && !claim.answer.isEmpty && claim.first < claim.limit\n\nstructure Support where\n  read : Read\n  source : Range\n  claim : Claim\n  binding : Binding\n  /-- The original citation can be wider than the part present in this read. -/\n  cited : Range := source\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Support.valid (support : Support) : Bool :=\n  support.read.valid && support.source.valid && support.claim.valid &&\n    support.binding.valid && support.binding.database == support.read.binding.database &&\n    support.binding.owner == support.read.binding.owner && support.binding.work == support.read.binding.work &&\n    support.read.binding.first ≤ support.binding.first && support.binding.limit ≤ support.read.binding.limit &&\n    support.cited.valid && support.cited.contains support.source &&\n    support.read.source.contains support.source\n\n/-- The constructor checks the exact saved read covers the cited source range. -/\ndef Support.checked (read : Read) (source : Range) (claim : Claim)\n    (binding : Binding := read.binding) (cited : Range := source) : Except String Support :=\n  let support := Support.mk read source claim binding cited\n  if support.valid then .ok support else .error \"citation is not covered by its recorded read\"\n\ntheorem Support.checked_covers {read : Read} {source : Range} {claim : Claim}\n    {binding : Binding} {cited : Range} {support : Support}\n    (checked : Support.checked read source claim binding cited = .ok support) :\n    read.source.contains source = true := by\n  unfold Support.checked at checked\n  dsimp only at checked\n  split at checked\n  next valid =>\n    simp only [Support.valid, Bool.and_eq_true] at valid\n    exact valid.2\n  next => contradiction\n\ntheorem Support.checked_within_citation {read : Read} {source : Range} {claim : Claim}\n    {binding : Binding} {cited : Range} {support : Support}\n    (checked : Support.checked read source claim binding cited = .ok support) :\n    cited.contains source = true := by\n  unfold Support.checked at checked\n  dsimp only at checked\n  split at checked\n  next valid =>\n    simp only [Support.valid, Bool.and_eq_true] at valid\n    exact valid.1.2\n  next => contradiction\n\ninductive WitnessKind where\n  | value | pathLine | path | identifier\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ninductive DataFormat where\n  | text | json\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\nstructure Consumption where\n  producer : Occurrence\n  consumer : Occurrence\n  producerFinish : Nat\n  consumerStart : Nat\n  kind : WitnessKind\n  term : String\n  inputFirst : Nat\n  inputLimit : Nat\n  outputFirst : Nat\n  outputLimit : Nat\n  inputFormat : DataFormat := .text\n  outputFormat : DataFormat := .text\n  /-- Only rows located in the actual producer output, never its entire read. -/\n  rows : Array Range := #[]\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Consumption.valid (edge : Consumption) : Bool :=\n  edge.producer.valid && edge.consumer.valid && edge.producer != edge.consumer &&\n    edge.producerFinish < edge.consumerStart && !edge.term.isEmpty &&\n    edge.inputFirst < edge.inputLimit && edge.outputFirst < edge.outputLimit &&\n    edge.rows.all Range.valid\n\ndef Consumption.checked (edge : Consumption) : Except String Consumption :=\n  if edge.valid then .ok edge else .error \"unavailable or invalid producer output\"\n\ntheorem Consumption.checked_before {edge accepted : Consumption}\n    (checked : edge.checked = .ok accepted) : edge.producerFinish < edge.consumerStart := by\n  unfold Consumption.checked at checked\n  split at checked\n  next valid =>\n    simp only [Consumption.valid, Bool.and_eq_true, decide_eq_true_eq] at valid\n    exact valid.1.1.1.1.2\n  next => contradiction\n\ninductive Group where\n  | answer (database owner : String)\n  | claim (claim : Claim)\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Group.valid : Group → Bool\n  | .answer database owner => !database.isEmpty && !owner.isEmpty\n  | .claim value => value.valid\n\ninductive UsageKind where\n  | omittedThenRead | omittedThenConsumed | deliveredThenCited | reread | sourceChanged\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef UsageKind.label : UsageKind → String\n  | .omittedThenRead => \"omitted_then_read\"\n  | .omittedThenConsumed => \"omitted_then_consumed\"\n  | .deliveredThenCited => \"delivered_then_cited\"\n  | .reread => \"reread\"\n  | .sourceChanged => \"source_changed\"\n\nstructure ConsumptionUse where\n  consumer : Occurrence\n  source : Range\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\nstructure Event where\n  occurrence : Occurrence\n  ordinal : Nat\n  consumption : Option ConsumptionUse := none\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, FromJson\n\n/-- A consumed range is keyed by its actual downstream use, independently of\nwhich other ranges become used later. Ordinary observed ordinals stay distinct. -/\ninstance : ToJson Event where\n  toJson event := Json.mkObj ([\n    (\"occurrence\",toJson event.occurrence),(\"ordinal\",toJson event.ordinal)] ++\n    event.consumption.toList.map (fun value => (\"consumption\",toJson value)))\n\nstructure Usage where\n  event : Event\n  /-- Opaque digest, never a plaintext question in a shared DB. -/\n  query : String\n  source : Range\n  kind : UsageKind\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Usage.valid (usage : Usage) : Bool :=\n  usage.event.occurrence.valid && digest usage.query && usage.source.valid &&\n    usage.event.consumption.all (fun cause => usage.event.ordinal == 0 && cause.consumer.valid &&\n      cause.consumer != usage.event.occurrence && cause.source == usage.source)\n\ninductive Fact where\n  | read (read : Read)\n  | consumed (edge : Consumption)\n  | supports (support : Support)\n  | coquoted (group : Group) (source : Range)\n  | used (usage : Usage)\n  deriving Inhabited, Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, Hashable, ToJson, FromJson\n\ndef Fact.valid : Fact → Bool\n  | .read value => value.valid\n  | .consumed edge => edge.valid\n  | .supports support => support.valid\n  | .coquoted group source => group.valid && source.valid\n  | .used usage => usage.valid\n\n/-- Evidence union is the lattice operation; counts are derived after union. -/\ndef evidenceJoin [BEq α] [Hashable α] (left right : Std.HashSet α) : Std.HashSet α :=\n  left.union right\n\ndef SameEvidence [BEq α] [Hashable α] (left right : Std.HashSet α) : Prop :=\n  ∀ fact, left.contains fact = right.contains fact\n\ntheorem evidenceJoin_idempotent [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\n    (evidence : Std.HashSet α) : SameEvidence (evidenceJoin evidence evidence) evidence := by\n  intro fact\n  simp [evidenceJoin, Std.HashSet.contains_union]\n\ntheorem evidenceJoin_commutative [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\n    (left right : Std.HashSet α) : SameEvidence (evidenceJoin left right) (evidenceJoin right left) := by\n  intro fact\n  simp [evidenceJoin, Std.HashSet.contains_union, Bool.or_comm]\n\ntheorem evidenceJoin_associative [BEq α] [Hashable α] [EquivBEq α] [LawfulHashable α]\n    (a b c : Std.HashSet α) :\n    SameEvidence (evidenceJoin (evidenceJoin a b) c) (evidenceJoin a (evidenceJoin b c)) := by\n  intro fact\n  simp [evidenceJoin, Std.HashSet.contains_union, Bool.or_assoc]\n\ndef add [BEq α] [Hashable α] [BEq β] [Hashable β]\n    (map : Std.HashMap α (Std.HashSet β)) (key : α) (value : β) :=\n  map.insert key ((map[key]?.getD {}).insert value)\n\nstructure Graph where\n  facts : Std.HashSet Fact := {}\n  bindings : Std.HashMap Range (Std.HashSet Binding) := {}\n  incoming : Std.HashMap Occurrence (Std.HashSet Consumption) := {}\n  supported : Std.HashMap Claim (Std.HashSet Support) := {}\n  groups : Std.HashMap Group (Std.HashSet Range) := {}\n  quotedBy : Std.HashMap Range (Std.HashSet Group) := {}\n  events : Std.HashMap Event Usage := {}\n  usages : Std.HashMap Range (Std.HashSet Usage) := {}\n\ndef Graph.empty : Graph := {}\n\ndef Graph.bind (graph : Graph) (source : Range) (binding : Binding) : Graph :=\n  {graph with bindings := add graph.bindings source binding}\n\n/-- Insertion is transactional. A repeated event cannot acquire a new label. -/\ndef Graph.insert (graph : Graph) (fact : Fact) : Except String Graph := do\n  unless fact.valid do throw \"invalid advisory evidence\"\n  if graph.facts.contains fact then return graph\n  let graph := {graph with facts := graph.facts.insert fact}\n  match fact with\n  | .read value => return graph.bind value.source value.binding\n  | .consumed edge =>\n    return {graph with incoming := add graph.incoming edge.consumer edge}\n  | .supports support =>\n    let graph := (graph.bind support.source support.binding).bind support.read.source support.read.binding\n    return {graph with supported := add graph.supported support.claim support}\n  | .coquoted group source =>\n    return {graph with\n      groups := add graph.groups group source\n      quotedBy := add graph.quotedBy source group}\n  | .used usage =>\n    if let some previous := graph.events[usage.event]? then\n      unless previous == usage do throw \"conflicting immutable usage event\"\n    return {graph with\n      events := graph.events.insert usage.event usage\n      usages := add graph.usages usage.source usage}\n\ndef Graph.ofFacts (facts : Array Fact) : Except String Graph :=\n  facts.foldlM Graph.insert Graph.empty\n\n/-- Canonical interchange is separate from hash-table iteration order. -/\ndef Graph.snapshot (graph : Graph) : Array Fact :=\n  graph.facts.toArray.qsort (fun a b => (toJson a).compress < (toJson b).compress)\n\ndef Graph.merge (left right : Graph) : Except String Graph :=\n  Graph.ofFacts (evidenceJoin left.facts right.facts).toArray\n\ndef Graph.evidenceCount (graph : Graph) : Nat := graph.facts.size\n\ndef Graph.rangeCount (graph : Graph) : Nat :=\n  let ranges := graph.facts.fold (fun ranges fact =>\n    match fact with\n    | .read value => ranges.insert value.source\n    | .supports support => (ranges.insert support.source).insert support.read.source\n    | .consumed edge => edge.rows.foldl (·.insert ·) ranges\n    | .coquoted _ source => ranges.insert source\n    | .used usage => ranges.insert usage.source) ({} : Std.HashSet Range)\n  ranges.size\n\ndef Graph.sourceBindings (graph : Graph) (source : Range) : Array Binding :=\n  (graph.bindings[source]?.getD {}).toArray\n\n/-- Closed interval union, bounded by observed intervals rather than line numbers. -/\ndef covered (wanted : Range) (observed : Array Range) : Bool := Id.run do\n  let rows := (observed.filter (·.subject == wanted.subject)).toList.mergeSort (fun a b => a.first ≤ b.first)\n  let mut position := wanted.first\n  for row in rows do\n    if position < row.first then return false\n    if position ≤ row.last then position := row.last + 1\n    if wanted.last < position then return true\n  return false\n\ndef readKind (requested : Range) (stored delivered : Array Range) (fingerprintChecked : Bool) : UsageKind :=\n  if !fingerprintChecked then .reread\n  else if covered requested stored then\n    if covered requested delivered then .reread else .omittedThenRead\n  else if stored.any (fun range => range.subject.sameLocation requested.subject && range.subject != requested.subject)\n    then .sourceChanged\n  else .reread\n\ntheorem omitted_requires_checked (requested : Range) (stored delivered : Array Range)\n    (checked : Bool) (omitted : readKind requested stored delivered checked = .omittedThenRead) :\n    checked = true := by\n  cases checked <;> simp_all [readKind]\n\ntheorem omitted_requires_stored (requested : Range) (stored delivered : Array Range)\n    (checked : Bool) (omitted : readKind requested stored delivered checked = .omittedThenRead) :\n    covered requested stored = true ∧ covered requested delivered = false := by\n  unfold readKind at omitted\n  split at omitted\n  next => contradiction\n  next =>\n    split at omitted\n    next stored =>\n      split at omitted\n      next => contradiction\n      next delivered => exact ⟨by simpa using stored, by simpa using delivered⟩\n    next => split at omitted <;> contradiction\n\ndef Graph.recordRead (graph : Graph) (event : Event) (query : String) (requested : Range)\n    (stored delivered : Array Range) (checked : Bool) : Except String Graph :=\n  graph.insert (.used {\n    event := event\n    query := query\n    source := requested\n    kind := readKind requested stored delivered checked})\n\ndef Graph.recordCitation (graph : Graph) (event : Event) (query : String) (source : Range)\n    (delivered : Array Range) : Except String Graph :=\n  if covered source delivered then\n    graph.insert (.used {event, query, source, kind := .deliveredThenCited})\n  else .ok graph\n\nstructure UsageCounts where\n  omittedThenRead : Nat := 0\n  omittedThenConsumed : Nat := 0\n  deliveredThenCited : Nat := 0\n  reread : Nat := 0\n  sourceChanged : Nat := 0\n  deriving Repr, BEq, ToJson\n\ndef Graph.usageCounts (graph : Graph) (source : Range) (query : Option String := none) : UsageCounts :=\n  (graph.usages[source]?.getD {}).fold (fun counts usage =>\n    if query.any (· != usage.query) then counts else\n    match usage.kind with\n    | .omittedThenRead => {counts with omittedThenRead := counts.omittedThenRead + 1}\n    | .omittedThenConsumed => {counts with omittedThenConsumed := counts.omittedThenConsumed + 1}\n    | .deliveredThenCited => {counts with deliveredThenCited := counts.deliveredThenCited + 1}\n    | .reread => {counts with reread := counts.reread + 1}\n    | .sourceChanged => {counts with sourceChanged := counts.sourceChanged + 1}) {}\n\n/-- Incidence traversal visits each shared answer once, without building cliques. -/\ndef Graph.companions (graph : Graph) (sources : Array Range) : Std.HashMap Range Nat := Id.run do\n  let mut groups : Std.HashSet Group := {}\n  for source in sources do\n    for group in graph.quotedBy[source]?.getD {} do\n      if let .answer .. := group then groups := groups.insert group\n  let mut counts : Std.HashMap Range Nat := {}\n  for group in groups do\n    for source in graph.groups[group]?.getD {} do\n      counts := counts.insert source (counts[source]?.getD 0 + 1)\n  return counts\n\nstructure Relevant where\n  ranges : Std.HashSet Range := {}\n  occurrences : Std.HashSet Occurrence := {}\n  unlocated : Array Consumption := #[]\n\n/-- Supports seed reverse consumption. Only located witness rows add body ranges. -/\ndef Graph.relevant (graph : Graph) (claims : Array Claim) : Relevant := Id.run do\n  let mut result : Relevant := {}\n  let mut queue : Array Occurrence := #[]\n  for claim in claims do\n    for support in graph.supported[claim]?.getD {} do\n      result := {result with ranges := result.ranges.insert support.source}\n      queue := queue.push support.read.occurrence\n  let mut position := 0\n  while position < queue.size do\n    let some occurrence := queue[position]? | break\n    position := position + 1\n    if result.occurrences.contains occurrence then continue\n    result := {result with occurrences := result.occurrences.insert occurrence}\n    for edge in graph.incoming[occurrence]?.getD {} do\n      result := {result with ranges := edge.rows.foldl (·.insert ·) result.ranges}\n      if edge.rows.isEmpty then result := {result with unlocated := result.unlocated.push edge}\n      queue := queue.push edge.producer\n  return result\n\nend Eggshell.Synapses\n"],["SynapseExtraction.lean","module\n\npublic import Eggshell.Synapses\npublic import Eggshell.SearchUnicode\npublic import Eggshell.JsonScalars\npublic import tools.RetrievalCategories\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Extraction\nopen Lean\n\nstructure Term where\n  kind : WitnessKind\n  text : String\n  first : Nat\n  limit : Nat\n  deriving Repr, BEq\n\ndef termCharacter (char : Char) : Bool :=\n  char.isAlphanum || char == '_' || char == '/' || char == '.' || char == '+' ||\n    char == '-' || char == ':' || (128 ≤ char.toNat &&\n      (RetrievalResearch.Unicode.letterNumber char || RetrievalResearch.Unicode.mark char))\n\ndef nameStart (char : Char) : Bool :=\n  char == '_' || (RetrievalResearch.Unicode.letterNumber char && !SearchUnicode.isDigit char)\n\ndef namePart (char : Char) : Bool :=\n  RetrievalResearch.Unicode.letterNumber char || RetrievalResearch.Unicode.mark char ||\n    \"_:.+-\".contains char\n\n/-- A named file component is required: separators and C++ comment delimiters\nare not paths. Pure numbers, options and sed bounds are not identifiers.\nThis is a lexical witness policy, not a proof of tool data dependence. -/\ndef termKind? (value : String) : Option WitnessKind :=\n  if value.isEmpty || value.toList.all SearchUnicode.isDigit then none\n  else if value.contains '/' then\n    if value.toList.any (fun char => RetrievalResearch.Unicode.letterNumber char || char == '_') then\n      let suffix := value.splitOn \":\" |>.getLast!\n      some (if suffix.toNat?.isSome && value.contains ':' then .pathLine else .path)\n    else none\n  else if value.toList.head?.any nameStart && value.toList.all namePart then some .identifier\n  else none\n\ntheorem numeric_not_a_witness (value : String)\n    (numeric : value.toList.all SearchUnicode.isDigit = true) : termKind? value = none := by\n  simp [termKind?, numeric]\n\ntheorem unnamed_path_not_a_witness (value : String) (slash : value.contains '/' = true)\n    (unnamed : value.toList.any (fun char => RetrievalResearch.Unicode.letterNumber char || char == '_') = false) :\n    termKind? value = none := by\n  simp [termKind?, slash, unnamed]\n\n/-- Preserve every source position. Repeating a token on another output row\nis another possible witness, not a duplicate of the first row. -/\ndef termOccurrences (text : String) : Array Term := Id.run do\n  let mut result := #[]\n  let mut first := 0\n  let mut position := 0\n  let mut token : Array Char := #[]\n  for char in text.toList ++ [' '] do\n    if termCharacter char then\n      if token.isEmpty then first := position\n      token := token.push char\n    else if !token.isEmpty then\n      let value := String.ofList token.toList\n      if let some kind := termKind? value then\n        result := result.push ⟨kind, value, first, position⟩\n        if kind == .pathLine then\n          let path := \":\".intercalate (value.splitOn \":\" |>.dropLast)\n          if termKind? path == some .path then\n            result := result.push ⟨.path, path, first, first + path.length⟩\n      token := #[]\n    position := position + 1\n  return result\n\n/-- A consumer needs one literal argument witness per key. Deduplicating\narguments does not discard any position in a producer's output. -/\ndef terms (text : String) : Array Term := Id.run do\n  let mut seen : Std.HashSet (WitnessKind × String) := {}\n  let mut result := #[]\n  for term in termOccurrences text do\n    if seen.contains (term.kind, term.text) then continue\n    seen := seen.insert (term.kind, term.text)\n    result := result.push term\n  return result\n\nstructure OutputRow where\n  source : Range\n  first : Nat\n  limit : Nat\n  deriving Repr, BEq, ToJson, FromJson\n\ndef OutputRow.covers (row : OutputRow) (first limit : Nat) : Bool :=\n  row.first ≤ first && first < limit && limit ≤ row.limit && row.source.valid\n\n/-- A verified file row takes precedence over its enclosing native member.\nOtherwise keep the smallest covering span; adding context cannot expand a\nlocated witness into every enclosing container. -/\ndef project (rows : Array OutputRow) (first limit : Nat) : Array Range :=\n  let file := rows.any fun row => row.covers first limit && row.source.file?.isSome\n  let candidates := rows.filter fun row => row.covers first limit && (!file || row.source.file?.isSome)\n  let initial := (candidates[0]?).map (fun row => row.limit-row.first) |>.getD 0\n  let width := candidates.foldl (fun n row => min n (row.limit-row.first)) initial\n  (candidates.filter (fun row => row.limit-row.first == width)).map (·.source)\n\ntheorem project_has_witness {rows : Array OutputRow} {first limit : Nat} {source : Range}\n    (present : source ∈ project rows first limit) :\n    ∃ row ∈ rows, row.source = source ∧ row.covers first limit = true := by\n  simp only [project, Array.mem_map, Array.mem_filter, Bool.and_eq_true] at present\n  obtain ⟨row, ⟨⟨member, covers, _⟩, _⟩, equal⟩ := present\n  exact ⟨row, member, equal, covers⟩\n\nstructure Produced where\n  occurrence : Occurrence\n  finished : Nat\n  term : Term\n  source : Array Char\n  format : DataFormat := .text\n  deriving Repr\n\ndef literal (source : Array Char) (first limit : Nat) (term : String) : Bool :=\n  first < limit && limit ≤ source.size &&\n    String.ofList (source.extract first limit).toList == term\n\n/-- Structured values retain their JSON type and raw literal coordinates.\nLexical hints are extracted only inside string values, never object keys. -/\ndef payloadOccurrences (format : DataFormat) (text : String) : Except String (Array Term) := do\n  if format == .text then return termOccurrences text\n  let raw := text.toList.toArray\n  let mut terms := #[]\n  for scalar in ← JsonScalars.values text do\n    terms := terms.push ⟨.value,scalar.literal,scalar.first,scalar.limit⟩\n    if let some value := scalar.text then\n      for term in termOccurrences value do\n        let some first := scalar.offsets[term.first]? | continue\n        let some limit := scalar.offsets[term.limit]? | continue\n        if literal raw first limit term.text then\n          terms := terms.push {term with first,limit}\n  return terms\n\ndef witnessTerm (edge : Consumption) : Bool :=\n  if edge.kind == .value then edge.inputFormat == .json && edge.outputFormat == .json &&\n    JsonScalars.scalarLiteral edge.term\n  else termKind? edge.term == some edge.kind\n\n/-- A pending link carries checked literal positions in both actual texts.\nThe output array is shared by all witnesses from one immutable completion. -/\nstructure Pending where\n  edge : Consumption\n  input : Array Char\n  output : Array Char\n  valid : edge.valid = true\n  classified : witnessTerm edge = true\n  inputExact : literal input edge.inputFirst edge.inputLimit edge.term = true\n  outputExact : literal output edge.outputFirst edge.outputLimit edge.term = true\n\ndef Pending.check? (edge : Consumption) (input output : Array Char) : Option Pending :=\n  if valid : edge.valid = true then\n    if classified : witnessTerm edge = true then\n      if inputExact : literal input edge.inputFirst edge.inputLimit edge.term = true then\n        if outputExact : literal output edge.outputFirst edge.outputLimit edge.term = true then\n          some ⟨edge, input, output, valid, classified, inputExact, outputExact⟩ else none\n      else none\n    else none\n  else none\n\ntheorem Pending.input_literal (pending : Pending) :\n    String.ofList (pending.input.extract pending.edge.inputFirst pending.edge.inputLimit).toList =\n      pending.edge.term := by\n  have witness := pending.inputExact\n  simp only [literal, Bool.and_eq_true, beq_iff_eq] at witness\n  exact witness.2\n\ntheorem Pending.output_literal (pending : Pending) :\n    String.ofList (pending.output.extract pending.edge.outputFirst pending.edge.outputLimit).toList =\n      pending.edge.term := by\n  have witness := pending.outputExact\n  simp only [literal, Bool.and_eq_true, beq_iff_eq] at witness\n  exact witness.2\n\ntheorem Pending.output_within (pending : Pending) :\n    pending.edge.outputFirst < pending.edge.outputLimit ∧ pending.edge.outputLimit ≤ pending.output.size := by\n  have witness := pending.outputExact\n  simp only [literal, Bool.and_eq_true, decide_eq_true_eq] at witness\n  exact witness.1\n\ntheorem Pending.before (pending : Pending) : pending.edge.producerFinish < pending.edge.consumerStart :=\n  Consumption.checked_before (edge := pending.edge) (accepted := pending.edge)\n    (by simp [Consumption.checked, pending.valid])\n\ntheorem Pending.non_numeric (pending : Pending) (unstructured : pending.edge.kind ≠ .value) :\n    pending.edge.term.toList.all SearchUnicode.isDigit = false := by\n  cases numeric : pending.edge.term.toList.all SearchUnicode.isDigit with\n  | false => rfl\n  | true =>\n    have rejected := numeric_not_a_witness pending.edge.term numeric\n    have accepted := pending.classified\n    simp [witnessTerm,unstructured,beq_iff_eq,rejected] at accepted\n\nstructure Started where\n  command : String\n  ordinal : Nat\n  pending : Array Pending\n  format : DataFormat := .text\n\nstructure Trace where\n  graph : Graph := .empty\n  outputs : Std.HashMap (WitnessKind × String) (Std.HashMap Occurrence (Array Produced)) := {}\n  starts : Std.HashMap Occurrence Started := {}\n  finished : Std.HashMap Occurrence String := {}\n  finishedFormats : Std.HashMap Occurrence DataFormat := {}\n  rows : Std.HashMap Occurrence (Array OutputRow) := {}\n  lastOrdinal : Option Nat := none\n\ndef Trace.advance (trace : Trace) (ordinal : Nat) : Except String Trace := do\n  if trace.lastOrdinal.any (ordinal < ·) then throw \"RPC trace is not in observed order\"\n  return {trace with lastOrdinal := some ordinal}\n\ndef Trace.start (trace : Trace) (occurrence : Occurrence) (ordinal : Nat) (command : String)\n    (format : DataFormat := .text) :\n    Except String Trace := do\n  let trace ← trace.advance ordinal\n  unless occurrence.valid do throw \"missing exact session/turn/tool-use identity\"\n  if let some previous := trace.starts[occurrence]? then\n    unless previous.command == command && previous.format == format do throw \"one occurrence changed its input\"\n    return trace\n  let mut pending := #[]\n  let input := command.toList.toArray\n  let candidates ← payloadOccurrences format command\n  let strong := candidates.filter fun term => term.kind == .value &&\n    (trace.outputs[(term.kind,term.text)]?.getD {}).any (fun _ producers =>\n      producers.any (fun producer => producer.finished < ordinal))\n  let mut seen : Std.HashSet (WitnessKind × String) := {}\n  for term in candidates do\n    if term.kind != .value && strong.any (fun value => value.first ≤ term.first && term.limit ≤ value.limit) then continue\n    if seen.contains (term.kind,term.text) then continue\n    seen := seen.insert (term.kind,term.text)\n    for (_, producers) in trace.outputs[(term.kind, term.text)]?.getD {} do\n      for producer in producers do\n        if ordinal ≤ producer.finished then continue\n        let edge : Consumption := {\n          producer := producer.occurrence, consumer := occurrence\n          producerFinish := producer.finished, consumerStart := ordinal\n          kind := term.kind, term := term.text\n          inputFirst := term.first, inputLimit := term.limit\n          outputFirst := producer.term.first, outputLimit := producer.term.limit\n          inputFormat := format,outputFormat := producer.format\n          rows := project (trace.rows[producer.occurrence]?.getD {}) producer.term.first producer.term.limit }\n        if let some checked := Pending.check? edge input producer.source then\n          pending := pending.push checked\n  return {trace with starts := trace.starts.insert occurrence ⟨command, ordinal, pending,format⟩}\n\ndef Trace.finish (trace : Trace) (occurrence : Occurrence) (ordinal : Nat) (output : String)\n    (format : DataFormat := .text) :\n    Except String Trace := do\n  let trace ← trace.advance ordinal\n  let some started := trace.starts[occurrence]? | throw \"output has no observed start\"\n  if let some previous := trace.finished[occurrence]? then\n    unless previous == output && trace.finishedFormats[occurrence]? == some format do throw \"one occurrence changed its output\"\n    return trace\n  unless started.ordinal < ordinal do throw \"output predates call start\"\n  let mut graph := trace.graph\n  for pending in started.pending do graph ← graph.insert (.consumed pending.edge)\n  let mut outputs := trace.outputs\n  let source := output.toList.toArray\n  for term in ← payloadOccurrences format output do\n    let previous := outputs[(term.kind, term.text)]?.getD {}\n    let positions := previous[occurrence]?.getD #[]\n    outputs := outputs.insert (term.kind, term.text)\n      (previous.insert occurrence (positions.push ⟨occurrence, ordinal, term, source,format⟩))\n  return {trace with\n    graph, outputs\n    finished := trace.finished.insert occurrence output\n    finishedFormats := trace.finishedFormats.insert occurrence format}\n\n/-- Attach verified row locations after exact native occurrence binding. -/\ndef Trace.locate (trace : Trace) (rows : Std.HashMap Occurrence (Array OutputRow)) :\n    Except String Trace := do\n  let mut facts := #[]\n  for fact in trace.graph.snapshot do\n    match fact with\n    | .consumed edge =>\n      let projected := project (rows[edge.producer]?.getD {}) edge.outputFirst edge.outputLimit\n      facts := facts.push (.consumed {edge with rows := projected})\n    | other => facts := facts.push other\n  return {trace with rows, graph := ← Graph.ofFacts facts}\n\ndef supportCitations (graph : Graph) (claim : Claim) (cited : Array Range) (reads : Array Read)\n    (original : Array Read := #[]) :\n    Except String Graph := do\n  let mut graph := graph\n  for citation in cited do\n    for recorded in reads do\n      if let some source := citation.intersection? recorded.source then\n        let rows := original.filter (fun row => row.occurrence == recorded.occurrence &&\n          row.binding.database == recorded.binding.database &&\n          row.binding.owner == recorded.binding.owner && row.binding.work == recorded.binding.work &&\n          source.contains row.source)\n        let binding ← if source == recorded.source then pure recorded.binding else do\n          unless covered source (rows.map (·.source)) do continue\n          let first := rows.foldl (fun first row => min first row.binding.first) recorded.binding.limit\n          let limit := rows.foldl (fun limit row => max limit row.binding.limit) recorded.binding.first\n          pure {recorded.binding with first, limit}\n        let support ← Support.checked recorded source claim binding citation\n        graph ← graph.insert (.supports support)\n        graph ← graph.insert (.coquoted (.answer claim.database claim.answer) source)\n        graph ← graph.insert (.coquoted (.claim claim) source)\n  return graph\n\n/-- Actual notifications only. Missing starts/finishes remain explicit errors. -/\ndef Trace.notification (trace : Trace) (ordinal : Nat) (record : Json) : Except String Trace := do\n  if (← record.getObjValAs? String \"direction\") != \"server\" then return trace\n  let message ← record.getObjVal? \"message\"\n  let method := (message.getObjValAs? String \"method\").toOption.getD \"\"\n  if method != \"item/started\" && method != \"item/completed\" then return trace\n  let params ← message.getObjVal? \"params\"\n  let item ← params.getObjVal? \"item\"\n  if (← item.getObjValAs? String \"type\") != \"commandExecution\" then return trace\n  let occurrence : Occurrence := ⟨← params.getObjValAs? String \"threadId\",\n    ← params.getObjValAs? String \"turnId\", ← item.getObjValAs? String \"id\"⟩\n  if method == \"item/started\" then\n    trace.start occurrence ordinal (← item.getObjValAs? String \"command\")\n  else\n    trace.finish occurrence ordinal ((item.getObjValAs? String \"aggregatedOutput\").toOption.getD \"\")\n\nend Eggshell.Synapses.Extraction\n"],["SynapseSource.lean","module\n\npublic import Eggshell.SynapseExtraction\npublic import Eggshell.SourceEvidence\npublic import Lean.Data.Json.Parser\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Extraction\nopen Lean\n\nstructure Layout where\n  text : String\n  original : String\n  offsets : Array Nat\n\n/-- Canonical JSON is checked once; coordinates name original scalar characters. -/\ndef canonicalLayout (raw : String) : Except String Layout := do\n  let projected ← if raw.startsWith \"\\\"\" then pure (some (raw, 0)) else\n    match Json.parse raw with\n    | .ok (.obj value) => do\n      let json := Json.obj value\n      unless json.compress == raw do throw \"noncanonical native response\"\n      let outputs := ([\"output\", \"aggregatedOutput\", \"stdout\"].filterMap fun key =>\n        (json.getObjValAs? String key).toOption).eraseDups\n      match outputs with\n      | [text] =>\n        let fragment := (toJson text).compress\n        match raw.splitOn fragment with\n        | [before, _] => pure (some (fragment, before.length))\n        | _ => pure none\n      | _ => pure none\n    | _ => pure none\n  let encoded := projected.isSome\n  let fragment := projected.map (·.1) |>.getD raw\n  let base := projected.map (·.2) |>.getD 0\n  let text ← if encoded then Json.parse fragment >>= Json.getStr? else pure raw\n  if encoded && (toJson text).compress != fragment then throw \"noncanonical saved scalar\"\n  let mut offsets := #[]\n  let mut position := base + if encoded then 1 else 0\n  for char in text.toList do\n    offsets := offsets.push position\n    position := position + if encoded then (toJson (String.singleton char)).compress.length - 2 else 1\n  offsets := offsets.push position\n  unless position + (if encoded then 1 else 0) == base + fragment.length do throw \"scalar layout mismatch\"\n  return ⟨text, raw, offsets⟩\n\n/-- A failed optional JSON projection never discards an observed body. The\nliteral view has a coordinate for every original character, including malformed\nor noncanonical JSON and arbitrary provider text. -/\ndef layoutView (raw : String) : Layout :=\n  match canonicalLayout raw with\n  | .ok view => {view with original := raw}\n  | .error _ => ⟨raw,raw,Array.range (raw.length+1)⟩\n\ndef layout (raw : String) : Except String Layout := .ok (layoutView raw)\n\ntheorem layout_total (raw : String) :\n    ∃ view, layout raw = .ok view ∧ view.original = raw := by\n  refine ⟨layoutView raw,rfl,?_⟩\n  simp only [layoutView]\n  split <;> rfl\n\nstructure TextLine where\n  text : String\n  first : Nat\n  limit : Nat\n  deriving Repr, BEq\n\ndef textLines (text : String) : Array TextLine := Id.run do\n  let mut lines := #[]\n  let mut position := 0\n  let size := text.length\n  for line in text.splitOn \"\\n\" do\n    let limit := min size (position + line.length + 1)\n    if position < limit then lines := lines.push ⟨line, position, limit⟩\n    position := limit\n  return lines\n\n/-- Terminal elision joins unrelated source fragments. Such a display row\nhas original observation bytes, but no complete file-line payload. -/\ndef outputElision (text : String) : Bool :=\n  [\"…\", \"...\"].any fun delimiter =>\n    ((text.splitOn delimiter).drop 1 |>.dropLast).any fun payload =>\n      match (payload.trimAscii.toString.splitOn \" \").filter (!·.isEmpty) with\n      | [count,unit,\"truncated\"] => count.toNat?.any (0 < ·) &&\n          [\"tokens\",\"chars\",\"bytes\",\"lines\"].contains unit\n      | _ => false\n\ndef numbered (text : String) : Option (Nat × String) := do\n  if outputElision text then none else do\n    let parts := text.splitOn \"\\t\"\n    let first ← parts.head?\n    let number ← first.trimAscii.copy.toNat?\n    if number == 0 || parts.length < 2 then none\n    else some (number, \"\\t\".intercalate parts.tail)\n\ntheorem elided_row_not_numbered (text : String) (elided : outputElision text = true) :\n    numbered text = none := by\n  simp [numbered,elided]\n\n/-- Literal shell lexer; unsupported syntax stays unsupported and is never run. -/\ndef shellWords (text : String) : Except String (Array String) := do\n  let mut words := #[]\n  let mut token : Array Char := #[]\n  let mut quote : Option Char := none\n  let mut escaped := false\n  for char in text.toList ++ [' '] do\n    if escaped then\n      token := token.push char\n      escaped := false\n    else if quote == some '\\'' then\n      if char == '\\'' then quote := none else token := token.push char\n    else if char == '\\\\' then escaped := true\n    else if let some delimiter := quote then\n      if char == delimiter then quote := none else token := token.push char\n    else if char == '\\'' || char == '\"' then quote := some char\n    else if char.isWhitespace || char == ';' || char == '|' then\n      if !token.isEmpty then words := words.push (String.ofList token.toList)\n      token := #[]\n      if char == ';' || char == '|' || char == '\\n' then words := words.push (String.singleton char)\n    else token := token.push char\n  if quote.isSome || escaped then throw \"unfinished shell quote\"\n  return words\n\ndef unwrap (command : String) : String :=\n  match shellWords command with\n  | .ok words =>\n    match words.toList with\n    | [shell, flag, inner] =>\n      if ([\"sh\", \"bash\", \"zsh\"].contains (shell.splitOn \"/\" |>.getLast!)) &&\n          (flag == \"-c\" || flag == \"-lc\") then inner else command\n    | _ => command\n  | .error _ => command\n\ndef workInput (work : String) : Except String Json := do\n  let parts := work.splitOn \"\\n\"\n  unless 2 ≤ parts.length do throw \"no native work command\"\n  Json.parse (\"\\n\".intercalate parts.tail)\n\n/-- All fields of the original native invocation participate. Field names\ncannot identify the tool's semantics or discard the other argument values. -/\ndef invocationData (work : String) : Except String (String × DataFormat) := do\n  let parts := work.splitOn \"\\n\"\n  unless 2 ≤ parts.length do throw \"no native invocation payload\"\n  let raw := \"\\n\".intercalate parts.tail\n  match Json.parse raw with\n  | .ok payload => return (payload.compress,.json)\n  | .error _ => return (raw,.text)\n\ndef invocationInput (work : String) : Except String String := (invocationData work).map (·.1)\n\n/-- A source-reader decoder, never a gate for recording or general data flow. -/\ndef workCommand (work : String) : Except String String := do\n  let payload ← workInput work\n  match payload.getObjValAs? String \"command\" with\n  | .ok value => return unwrap value\n  | .error _ => return unwrap (← payload.getObjValAs? String \"cmd\")\n\ndef fileMap (records : Array Json) : Except String (Array File) := do\n  let mut candidates : Std.HashMap String (Std.HashSet File) := {}\n  for record in records do\n    if !(← record.getObjValAs? Bool \"complete\") then continue\n    if !(← record.getObjValAs? (Array Json) \"uris\").isEmpty then continue\n    for value in ← record.getObjValAs? (Array Json) \"files\" do\n      let content ← value.getObjVal? \"content\"\n      if content == .null then continue\n      let file : File := ⟨← value.getObjValAs? String \"relative\",\n        ← content.getObjValAs? String \"root\", ← content.getObjValAs? Nat \"bytes\"⟩\n      if !file.valid then continue\n      candidates := add candidates file.relative file\n  return candidates.fold (fun result _ files =>\n    if files.size == 1 then result ++ files.toArray else result) #[]\n\ndef parseBounds (text : String) : Option (Nat × Nat) := do\n  let normalized := (text.replace \"–\" \"-\").replace \"—\" \"-\"\n  let parts := normalized.splitOn \"-\"\n  let first ← (← parts.head?).toNat?\n  let last ← if parts.length == 1 then some first else if parts.length == 2 then\n      ((parts[1]!).dropWhile (· == 'L')).toString.toNat? else none\n  if 0 < first && first ≤ last then some (first, last) else none\n\ndef readPlans (command : String) (files : Array File) : Except String (Array Range) := do\n  let some segments := SourceEvidence.sequenceSegments? command | throw \"unsupported read sequence\"\n  let mut plans := #[]\n  for segment in segments do\n    let [\"nl\", \"-ba\", path, \"|\", \"sed\", \"-n\", program] := (← shellWords segment).toList |\n      throw \"unsupported literal read sequence\"\n    if path.toList.any (fun c => \"$\\x60*?{}\".contains c) then throw \"nonliteral read path\"\n    let candidates := files.filter (fun f => path == f.relative || path.endsWith (\"/\" ++ f.relative))\n    unless candidates.size == 1 do throw \"ambiguous read path\"\n    for statement in program.splitOn \";\" do\n      let statement := statement.trimAscii.toString\n      unless statement.endsWith \"p\" do throw \"unsupported read program\"\n      let bounds := ((statement.dropEnd 1).copy.replace \",\" \"-\")\n      let some (first, last) := parseBounds bounds | throw \"invalid read interval\"\n      plans := plans.push ⟨candidates[0]!, first, last⟩\n  if plans.isEmpty then throw \"no numbered read\"\n  return plans\n\nstructure Document where\n  owner : String\n  work : String\n  workText : Option String\n  source : Option String\n  native : Bool\n  occurrences : Array Occurrence\n  files : Array File\n\ndef document (value : Json) : Except String Document := do\n  return {\n    owner := ← value.getObjValAs? String \"owner\"\n    work := ← value.getObjValAs? String \"workKey\"\n    workText := ← value.getObjValAs? (Option String) \"work\"\n    source := ← value.getObjValAs? (Option String) \"source\"\n    native := ← value.getObjValAs? Bool \"native\"\n    occurrences := ← value.getObjValAs? (Array Occurrence) \"occurrences\"\n    files := ← fileMap (← value.getObjValAs? (Array Json) \"records\") }\n\nstructure LocatedRead where\n  read : Read\n  rows : Array OutputRow\n  originalRows : Array Read\n  text : String\n\n/-- Presence in a pinned source archive, without inventing an execution order. -/\ndef recordedRows (database : String) (doc : Document) : Except String (Array Read) := do\n  let some raw := doc.source | throw \"no original observation\"\n  let some work := doc.workText | throw \"no original work\"\n  let some occurrence := doc.occurrences[0]? | throw \"missing native occurrence identity\"\n  let plans ← readPlans (← workCommand work) doc.files\n  let decoded ← layout raw\n  let mut rows := #[]\n  for line in textLines decoded.text do\n    let some (number, _) := numbered line.text | continue\n    let files := plans.foldl (fun files range =>\n      if range.first ≤ number && number ≤ range.last then\n        (range.file?.map files.insert).getD files else files)\n      ({} : Std.HashSet File)\n    if files.size != 1 then continue\n    let source : Range := ⟨files.toArray[0]!, number, number⟩\n    let binding : Binding := ⟨database, doc.owner, doc.work,\n      decoded.offsets[line.first]!, decoded.offsets[line.limit]!⟩\n    rows := rows.push {occurrence,source,binding}\n  return rows\n\ndef recordedReads (database : String) (doc : Document) : Except String (Array LocatedRead) := do\n  let rows ← recordedRows database doc\n  let mut chunks : Array LocatedRead := #[]\n  for row in rows do\n    if let some previous := chunks.back? then\n      if previous.read.source.subject == row.source.subject &&\n          previous.read.source.last + 1 == row.source.first &&\n          previous.read.binding.limit == row.binding.first then\n        let merged := {previous with\n          read := {previous.read with\n            source := {previous.read.source with last := row.source.last}\n            binding := {previous.read.binding with limit := row.binding.limit}}\n          originalRows := previous.originalRows.push row}\n        chunks := chunks.pop.push merged\n        continue\n    chunks := chunks.push ⟨row, #[], #[row], \"\"⟩\n  return chunks\n\ndef locateReads (database : String) (doc : Document) (trace : Trace) : Except String (Array LocatedRead) := do\n  let some raw := doc.source | throw \"no original observation\"\n  let some work := doc.workText | throw \"no original work\"\n  let command ← workCommand work\n  let (input,format) ← invocationData work\n  let plans ← readPlans command doc.files\n  let decoded ← layout raw\n  let original := (textLines decoded.text).filterMap fun line => do\n    let (number, body) ← numbered line.text\n    let files := plans.filter (fun range => range.first ≤ number && number ≤ range.last)\n    let unique := files.foldl (fun files range => (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\n    if unique.size != 1 then none else\n      some (line, number, body, unique.toArray[0]!)\n  if original.isEmpty then throw \"no unambiguous original numbered rows\"\n  let mut result := #[]\n  for occurrence in doc.occurrences do\n    let some start := trace.starts[occurrence]? | continue\n    let some output := trace.finished[occurrence]? | continue\n    let sameInput := match start.format with\n      | .json => start.command == input && start.format == format\n      | .text => unwrap start.command == command\n    if !sameInput then continue\n    let actualLayout ← layout output\n    let actual := (textLines actualLayout.text).filterMap fun line => do\n      let (number, body) ← numbered line.text\n      some (line, number, body)\n    if !original.all (fun (_, number, body, _) => actual.any (fun (_, n, b) => n == number && b == body)) then continue\n    let mut chunks : Array LocatedRead := #[]\n    for (line, number, body, file) in original do\n      let source : Range := ⟨file, number, number⟩\n      let first := decoded.offsets[line.first]!\n      let limit := decoded.offsets[line.limit]!\n      let binding : Binding := ⟨database, doc.owner, doc.work, first, limit⟩\n      let rows := actual.filterMap fun (actualLine, n, b) =>\n        if n == number && b == body then\n          some (OutputRow.mk source actualLayout.offsets[actualLine.first]! actualLayout.offsets[actualLine.limit]!)\n        else none\n      let recorded : Read := {occurrence,source,binding}\n      let located : LocatedRead := ⟨recorded, rows, #[recorded], line.text⟩\n      if let some previous := chunks.back? then\n        if previous.read.source.subject == .file file && previous.read.source.last + 1 == number &&\n            previous.read.binding.limit == first then\n          let merged : LocatedRead := {\n            read := {previous.read with\n              source := {previous.read.source with last := number}\n              binding := {previous.read.binding with limit}}\n            rows := previous.rows ++ rows\n            originalRows := previous.originalRows.push recorded\n            text := previous.text ++ \"\\n\" ++ line.text }\n          chunks := chunks.pop.push merged\n          continue\n      chunks := chunks.push located\n    result := result ++ chunks\n  if result.isEmpty then throw \"saved observation has no exact matching completed call\"\n  return result\n\ndef hexDigit (char : Char) : Option Nat :=\n  if '0' ≤ char && char ≤ '9' then some (char.toNat - '0'.toNat)\n  else if 'a' ≤ char && char ≤ 'f' then some (char.toNat - 'a'.toNat + 10)\n  else if 'A' ≤ char && char ≤ 'F' then some (char.toNat - 'A'.toNat + 10)\n  else none\n\ndef percentDecode (text : String) : Option String := do\n  let chars := text.toList.toArray\n  let mut bytes := ByteArray.empty\n  let mut position := 0\n  while position < chars.size do\n    let char := chars[position]!\n    if char == '%' then\n      let a ← chars[position+1]? >>= hexDigit\n      let b ← chars[position+2]? >>= hexDigit\n      bytes := bytes.push (UInt8.ofNat (16*a+b))\n      position := position+3\n    else\n      bytes := bytes ++ (String.singleton char).toUTF8\n      position := position+1\n  String.fromUTF8? bytes\n\n/-- Only declared paths and literal line intervals; destinations are never opened. -/\ndef citation (label destination : String) (files : Array File) : Option Range := do\n  let destination ← percentDecode destination\n  let destination := destination.trimAscii.copy |>.replace \"<\" \"\" |>.replace \">\" \"\"\n  let mut candidates := #[]\n  for file in files do\n    for separator in [\":\", \"#L\"] do\n      let marker := file.relative ++ separator\n      let parts := destination.splitOn marker\n      if parts.length != 2 then continue\n      let leading := parts[0]!\n      if !leading.isEmpty && !leading.endsWith \"/\" then continue\n      let some (first, last) := parseBounds parts[1]! | continue\n      let filename := file.relative.splitOn \"/\" |>.getLast!\n      let displayed := label.splitOn (filename ++ \":\")\n      let mut last := last\n      if displayed.length == 2 then\n        let bounds := String.ofList ((displayed[1]!).toList.takeWhile\n          (fun c => c.isDigit || c == '-' || c == '–' || c == '—'))\n        let (a, b) ← parseBounds bounds\n        if a != first || (first != last && b != last) then return ← none\n        last := b\n      candidates := candidates.push (Range.mk file first last)\n  if candidates.size == 1 then some candidates[0]! else none\n\ndef paragraphCitations (text : String) (files : Array File) : Array Range := Id.run do\n  let mut result : Std.HashSet Range := {}\n  for part in (text.splitOn \"](\").dropLast.zip ((text.splitOn \"](\").tail) do\n    let some label := (part.1.splitOn \"[\").getLast? | continue\n    let some destination := (part.2.splitOn \")\").head? | continue\n    if let some range := citation label destination files then result := result.insert range\n  return result.toArray\n\ndef addAnswer (database : String) (doc : Document) (reads : Array LocatedRead) (graph : Graph) :\n    Except String Graph := do\n  let some raw := doc.source | throw \"answer has no original scalar\"\n  let decoded ← layout raw\n  let files := reads.foldl (fun files located =>\n    (located.read.source.file?.map files.insert).getD files) ({} : Std.HashSet File)\n  let mut graph := graph\n  let mut position := 0\n  for paragraph in decoded.text.splitOn \"\\n\\n\" do\n    let limit := position + paragraph.length\n    if position < limit then\n      let claim : Claim := ⟨database, doc.owner, decoded.offsets[position]!, decoded.offsets[limit]!⟩\n      graph ← supportCitations graph claim (paragraphCitations paragraph files.toArray)\n        (reads.map (·.read)) (reads.flatMap (·.originalRows))\n    position := limit + 2\n  return graph\n\nend Eggshell.Synapses.Extraction\n"],["SynapseUsage.lean","module\n\npublic import Eggshell.SynapseSource\npublic import tools.SpanPostings\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Extraction\nopen Lean\n\nstructure Presentation where\n  ranges : Array Range := #[]\n  uncertain : Std.HashSet File := {}\n  bindings : Array (String × Nat × Nat) := #[]\n  uncertainOwners : Std.HashSet String := {}\n  addressed : Array (String × Nat × Nat × List JsonScalars.Segment) := #[]\n\ndef caption (text : String) : Option (Nat × Nat × Bool) := do\n  if !text.startsWith \"  ORIGINAL CHARS [\" && !text.startsWith \"  CHARS [\" then none else do\n    let parts := text.splitOn \"CHARS [\"\n    let rest ← parts[1]?\n    let bounds ← (rest.splitOn \")\").head?\n    let [first, limit] := bounds.splitOn \",\" | none\n    let first ← first.toNat?\n    let limit ← limit.toNat?\n    if first < limit then some (first, limit, text.endsWith \" decoded\") else none\n\ndef scalarSlice (raw : String) (first limit : Nat) : Option String :=\n  if first < limit && limit ≤ raw.length then\n    some (String.ofList ((raw.toList.drop first).take (limit-first))) else none\n\nstructure SharedSpelling where\n  file : File\n  number : Nat\n  code : String\n  origins : Array (String × String × String × Occurrence)\n\n/-- Decode only complete shared frames. This grants no original-byte status;\ncallers must bind each spelling to their saved original rows. -/\ndef sharedSpellings (body : String) : Array SharedSpelling := Id.run do\n  let wrapper := \"EGGSHELL SHARED SOURCE DATA\\nOriginal recorded file data; advisory, not a completed operation.\\n\"\n  let mut found : Array SharedSpelling := #[]\n  for packet in (body.splitOn wrapper).tail do\n    let parts := packet.splitOn \"END EGGSHELL SHARED SOURCE DATA\\n\"\n    if parts.length < 2 then continue\n    for block in ((\"\\n\" ++ parts.head!).splitOn \"\\nSOURCE \").tail do\n      let parts := block.splitOn \"\\nEND SOURCE\"\n      if parts.length < 2 then continue\n      let suffix := parts[1]!\n      if !suffix.isEmpty && !suffix.startsWith \"\\n\" then continue\n      let fileLine :: originsLine :: \"CODE\" :: codeLines := parts.head!.splitOn \"\\n\" | continue\n      let some file := (Json.parse fileLine >>= fromJson? (α := File)).toOption | continue\n      if !file.valid || !originsLine.startsWith \"ORIGINAL READS \" then continue\n      let encoded := String.ofList (originsLine.toList.drop \"ORIGINAL READS \".length)\n      let some origins := (Json.parse encoded >>= fromJson? (α := Array String)).toOption | continue\n      let origins := origins.filterMap fun origin =>\n        (Json.parse origin >>= fromJson? (α := String × String × String × Occurrence)).toOption\n      for line in codeLines do\n        let some (number,code) := numbered line | continue\n        found := found.push ⟨file,number,code,origins⟩\n  return found\n\n/-- A shared spelling can report only a range belonging to an original saved\nrow. Sharing the payload never manufactures another execution witness. -/\nstructure SharedWitness (reads : Array Read) where\n  row : Read\n  original : row ∈ reads\n  file : File\n  number : Nat\n  code : String\n  sourceExact : row.source = ⟨file,number,number⟩\n\ntheorem SharedWitness.original_range (witness : SharedWitness reads) :\n    ∃ row ∈ reads, row.source = ⟨witness.file,witness.number,witness.number⟩ :=\n  ⟨witness.row,witness.original,witness.sourceExact⟩\n\n/-- A file alias can cover just its original code bytes, without a numbered\nprefix. JSON escaping changes representation, never the saved code spelling. -/\nstructure SharedCode (original : String) where\n  text : String\n  exact : text = original ∨\n    String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original\n\ndef sharedCodes (original : String) : Array (SharedCode original) := Id.run do\n  let mut result := #[⟨original,Or.inl rfl⟩]\n  if let some text := (Json.parse (\"\\\"\" ++ original ++ \"\\\"\") >>= Json.getStr?).toOption then\n    if same : String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original then\n      if text != original then result := result.push ⟨text,Or.inr same⟩\n  return result\n\ntheorem SharedCode.original_spelling (code : SharedCode original) :\n    code.text = original ∨\n      String.ofList ((toJson code.text).compress.toList.drop 1 |>.dropLast) = original := code.exact\n\n/-- Recognize the producer's shared file frame, then compare every displayed\ncode row with its raw scalar coordinates and declared DB/owner/Work/occurrence.\nLocation-only notices and arbitrary matching prose cannot label delivery. -/\ndef sharedPresented (body : String) (docs : Array Document) (reads : Array Read) :\n    Array (SharedWitness reads) := Id.run do\n  let displayed := sharedSpellings body\n  if displayed.isEmpty || reads.isEmpty then return #[]\n  let mut index : Std.HashMap (File × Nat × String) (Array (SharedWitness reads)) := {}\n  let byOwner := reads.attach.foldl (fun found saved =>\n    found.insert saved.val.binding.owner\n      ((found.getD saved.val.binding.owner #[]).push saved))\n    ({} : Std.HashMap String (Array {row // row ∈ reads}))\n  for doc in docs do\n    if !doc.native then continue\n    let some raw := doc.source | continue\n    let characters := raw.toList.toArray\n    for saved in byOwner.getD doc.owner #[] do\n      let row := saved.val\n      if !row.valid || row.binding.work != doc.work || !doc.occurrences.contains row.occurrence then continue\n      let .file file := row.source.subject | continue\n      if row.source.first != row.source.last then continue\n      if !(row.binding.first < row.binding.limit && row.binding.limit ≤ characters.size) then continue\n      let original := String.ofList (characters.extract row.binding.first row.binding.limit).toList\n      for code in sharedCodes original do\n        if code.text.isEmpty || code.text.contains '\\n' || code.text.contains '\\r' then continue\n        if same : row.source = ⟨file,row.source.first,row.source.first⟩ then\n          let witness : SharedWitness reads := ⟨row,saved.property,file,row.source.first,code.text,same⟩\n          let key := (file,row.source.first,code.text)\n          index := index.insert key ((index.getD key #[]).push witness)\n    let .ok decoded := layout raw | continue\n    let spanOf := fun (saved : {row // row ∈ reads}) =>\n      if saved.val.valid && saved.val.binding.work == doc.work then\n        some (saved.val.binding.first,saved.val.binding.limit) else none\n    let spans := SpanPostings.prepare spanOf (byOwner.getD doc.owner #[]).toList\n    for line in textLines decoded.text do\n      let some (number,code) := numbered line.text | continue\n      for saved in spans.lookup (decoded.offsets[line.first]!,decoded.offsets[line.limit]!) do\n        let row := saved.val\n        let .file file := row.source.subject | continue\n        if same : row.source = ⟨file,number,number⟩ then\n          let witness : SharedWitness reads := ⟨row,saved.property,file,number,code,same⟩\n          let key := (file,number,code)\n          index := index.insert key ((index.getD key #[]).push witness)\n  let mut found := #[]\n  for spelling in displayed do\n    for witness in index.getD (spelling.file,spelling.number,spelling.code) #[] do\n      let row := witness.row\n      if spelling.origins.contains (row.binding.database,row.binding.owner,row.binding.work,row.occurrence) then\n        found := found.push witness\n  return found\n\n/-- Verify actual packet bytes against immutable raw coordinates before labelling. -/\ndef presented (body : String) (docs : Array Document) (reads : Array Read) : Presentation := Id.run do\n  let mut result : Presentation := {}\n  for part in body.splitOn \"\\nWORK GRAPH \" do\n    let some owner := (part.splitOn \"\\n\").head? | continue\n    let some doc := docs.find? (·.owner == owner) | continue\n    let some raw := doc.source | continue\n    let blocks := part.splitOn \"  GROUNDED OUTCOME\\n\"\n    let some evidence := blocks[1]? | continue\n    let evidence := (evidence.splitOn \"  TRACE\\n\").head!\n    let json := JsonScalars.prepare? raw\n    let rawChars := match json with | some index => index.characters | none => raw.toList.toArray\n    let evidenceChars := evidence.toList.toArray\n    let mut spans := #[]\n    let mut addressed := #[]\n    let mut path : Option String := none\n    let mut bad := false\n    for line in textLines evidence do\n      if line.text.startsWith \"  JSON PATH \" then\n        path := some (String.ofList (line.text.toList.drop \"  JSON PATH \".length))\n        continue\n      let some (first, limit, decoded) := caption line.text | continue\n      let location := json.bind (·.cover? first limit)\n      let declared := path\n      path := none\n      if declared.isSome && !location.any (fun address => declared == some address.label) then\n        bad := true\n        continue\n      if !(first < limit && limit ≤ rawChars.size) then bad := true; continue\n      let segment := String.ofList (rawChars.extract first limit).toList\n      let marker := \"  DECODED JSON STRING DATA\\n\"\n      let marked := literal evidenceChars line.limit (line.limit+marker.length) marker\n      let expected := if decoded || marked then\n          (Json.parse (\"\\\"\" ++ segment ++ \"\\\"\") >>= Json.getStr?).toOption\n        else some segment\n      let some expected := expected | bad := true; continue\n      let dataStart := line.limit + if marked then marker.length else 0\n      if dataStart+expected.length > evidenceChars.size ||\n          String.ofList (evidenceChars.extract dataStart (dataStart+expected.length)).toList != expected then\n        bad := true\n        continue\n      spans := spans.push (first, limit)\n      if let some address := location then\n        if declared == some address.label then addressed := addressed.push (owner,first,limit,address.path)\n    if spans.isEmpty then\n      let decoded := (layout raw).toOption.map (·.text)\n      if !raw.isEmpty && ((evidence.splitOn raw).length > 1 ||\n          decoded.any (fun text => !text.isEmpty && (evidence.splitOn text).length > 1)) then\n        spans := #[(0, raw.length)]\n      else bad := true\n    if bad then\n      result := {result with uncertainOwners := result.uncertainOwners.insert owner}\n      for file in doc.files do result := {result with uncertain := result.uncertain.insert file}\n    else\n      result := {result with\n        bindings := result.bindings ++ spans.map (fun (a,b) => (owner,a,b))\n        addressed := result.addressed ++ addressed}\n    for row in reads do\n      if row.binding.owner == owner && spans.any (fun (first, limit) =>\n          first ≤ row.binding.first && row.binding.limit ≤ limit) then\n        result := {result with ranges := result.ranges.push row.source}\n  for witness in sharedPresented body docs reads do\n    result := {result with\n      ranges := result.ranges.push witness.row.source\n      bindings := result.bindings.push\n        (witness.row.binding.owner,witness.row.binding.first,witness.row.binding.limit)}\n  return result\n\ndef Presentation.coversBinding (shown : Presentation) (binding : Binding) : Bool := Id.run do\n  if shown.uncertainOwners.contains binding.owner then return false\n  let spans := shown.bindings.filterMap fun (owner,first,limit) =>\n    if owner == binding.owner then some (first,limit) else none\n  let spans := spans.qsort fun a b => a.1 < b.1\n  let covered := spans.foldl (fun position (first,limit) =>\n    if first ≤ position then max position limit else position) binding.first\n  return binding.first < binding.limit && binding.limit ≤ covered\n\ndef Presentation.coversAddress (shown : Presentation) (binding : Binding) (path : List JsonScalars.Segment) : Bool :=\n  let bindings := shown.addressed.filterMap fun (owner,first,limit,actual) =>\n    if actual == path then some (owner,first,limit) else none\n  {shown with bindings}.coversBinding binding\n\ndef compactRanges (ranges : Array Range) : Array Range := Id.run do\n  let mut files : Std.HashMap Subject (Array Range) := {}\n  for range in ranges do files := files.insert range.subject (files[range.subject]?.getD #[] |>.push range)\n  let mut result := #[]\n  for (_, spans) in files do\n    let mut merged : Array Range := #[]\n    for span in spans.qsort (fun a b => a.first < b.first || (a.first == b.first && a.last < b.last)) do\n      if let some previous := merged.back? then\n        if span.first ≤ previous.last+1 then\n          merged := merged.pop.push {previous with last := max previous.last span.last}\n          continue\n      merged := merged.push span\n    result := result ++ merged\n  return result\n\n/-- Stored overlap minus verified delivery; does not expand a citation's line count. -/\ndef omittedRanges (requested : Range) (stored delivered : Array Range) : Array Range := Id.run do\n  let mut result : Std.HashSet Range := {}\n  for saved in compactRanges stored do\n    if saved.subject != requested.subject then continue\n    let first := max saved.first requested.first\n    let last := min saved.last requested.last\n    if last < first then continue\n    let relevant := (delivered.filter (·.subject == requested.subject)).toList.mergeSort\n      (fun a b => a.first ≤ b.first)\n    let mut position := first\n    for shown in relevant do\n      if position > last then break\n      if shown.last < position then continue\n      if position < shown.first then\n        result := result.insert {requested with first := position, last := min last (shown.first-1)}\n      position := max position (shown.last+1)\n    if position ≤ last then result := result.insert {requested with first := position, last}\n  return result.toArray\n\nstructure Feedback where\n  graph : Graph := .empty\n  delivered : Presentation := {}\n  atStart : Std.HashMap Occurrence Presentation := {}\n\ndef Feedback.present (feedback : Feedback) (packet : Presentation) : Feedback :=\n  {feedback with delivered := {\n    ranges := feedback.delivered.ranges ++ packet.ranges\n    uncertain := feedback.delivered.uncertain.union packet.uncertain\n    bindings := feedback.delivered.bindings ++ packet.bindings\n    addressed := feedback.delivered.addressed ++ packet.addressed\n    uncertainOwners := feedback.delivered.uncertainOwners.union packet.uncertainOwners }}\n\n/-- A PreToolUse packet arriving after proposal cannot rewrite what was known. -/\ndef Feedback.start (feedback : Feedback) (occurrence : Occurrence) : Feedback :=\n  if feedback.atStart.contains occurrence then feedback else\n    {feedback with atStart := feedback.atStart.insert occurrence feedback.delivered}\n\ndef Feedback.completedRead (feedback : Feedback) (occurrence : Occurrence) (query : String)\n    (requested stored : Array Range) : Except String Feedback := do\n  let some earlier := feedback.atStart[occurrence]? | throw \"read has no observed start\"\n  let mut graph := feedback.graph\n  let mut ordinal := 0\n  for source in compactRanges requested do\n    let checked := match source.subject with\n      | .file file => !earlier.uncertain.contains file\n      | .original _ => earlier.uncertainOwners.isEmpty\n    let gaps := if checked then omittedRanges source stored earlier.ranges else #[]\n    for gap in if gaps.isEmpty then #[source] else gaps do\n      graph ← graph.recordRead ⟨occurrence, ordinal, none⟩ query gap stored earlier.ranges checked\n      ordinal := ordinal+1\n  return {feedback with graph}\n\ndef Feedback.answer (feedback : Feedback) (occurrence : Occurrence) (query text : String) :\n    Except String Feedback := do\n  let files := feedback.delivered.ranges.foldl (fun files range =>\n    (range.file?.map files.insert).getD files) ({} : Std.HashSet File)\n  let cited := paragraphCitations text files.toArray\n  let mut graph := feedback.graph\n  for index in [:cited.size] do\n    graph ← graph.recordCitation ⟨occurrence, index, none⟩ query cited[index]! feedback.delivered.ranges\n  return {feedback with graph}\n\n/-- A native usage label may cover only an actual located consumption witness.\nThe native row remains tied to its original Work and response digest. -/\nstructure ConsumedSource (edge : Consumption) where\n  source : Range\n  valid : edge.valid = true\n  native : source.file?.isNone = true\n  consumed : edge.rows.any (·.contains source) = true\n\ndef consumedSource? (edge : Consumption) (source : Range) : Option (ConsumedSource edge) :=\n  if valid : edge.valid = true then\n    if native : source.file?.isNone = true then\n      if consumed : edge.rows.any (·.contains source) = true then\n        some ⟨source,valid,native,consumed⟩ else none\n    else none\n  else none\n\ntheorem consumed_source_has_witness (checked : ConsumedSource edge) :\n    ∃ row ∈ edge.rows, row.contains checked.source = true := by\n  obtain ⟨index,bound,present⟩ := Array.any_eq_true.mp checked.consumed\n  exact ⟨edge.rows[index],by simp,present⟩\n\ntheorem consumed_source_is_later (checked : ConsumedSource edge) :\n    edge.producerFinish < edge.consumerStart := by\n  exact Consumption.checked_before (edge := edge) (accepted := edge)\n    (by simp [Consumption.checked,checked.valid])\n\n/-- Literal reuse is advisory evidence, not proof of semantic necessity. The\ncaller supplies immutable pre-read stored and ACK ranges; no returned sibling\nfield is labelled merely because it was present in the tool's response. -/\ndef consumedUsage? (checked : ConsumedSource edge) (query : String)\n    (stored delivered : Array Range) : Option Usage :=\n  if covered checked.source stored && !covered checked.source delivered then some {\n    event := {occurrence := edge.producer,ordinal := 0,consumption := some ⟨edge.consumer,checked.source⟩}\n    query,source := checked.source,kind := .omittedThenConsumed}\n  else none\n\ntheorem consumed_omission_requires_stored (checked : ConsumedSource edge)\n    (observed : consumedUsage? checked query stored delivered = some usage) :\n    covered checked.source stored = true ∧ covered checked.source delivered = false := by\n  unfold consumedUsage? at observed\n  split at observed\n  next present => simpa only [Bool.and_eq_true,Bool.not_eq_true'] using present\n  next => contradiction\n\ndef recordConsumed (graph : Graph) (checked : ConsumedSource edge) (query : String)\n    (stored delivered : Array Range) : Except String Graph :=\n  match consumedUsage? checked query stored delivered with\n  | some usage => graph.insert (.used usage)\n  | none => .ok graph\n\nend Eggshell.Synapses.Extraction\n"],["SynapseIndex.lean","module\n\npublic import Eggshell.GraphStore\npublic import Eggshell.SynapseProvenance\npublic import Eggshell.SynapticTopologyStore\npublic import Eggshell.ObservedRecordView\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Index\nopen Lean DB\n\n/-- The implementation key follows source bytes, never a hand-maintained version. -/\ndef implementation : String :=\n  Blake3.hex (Blake3.digest \"eggshell.synaptic-index\".toUTF8 [\n    (include_str \"SynapticTopology.lean\").toUTF8,(include_str \"SynapticTopologyStore.lean\").toUTF8,\n    (include_str \"../tools/SpanPostings.lean\").toUTF8,\n    (include_str \"Synapses.lean\").toUTF8, (include_str \"SynapseExtraction.lean\").toUTF8,\n    (include_str \"SynapseSource.lean\").toUTF8, (include_str \"SynapseUsage.lean\").toUTF8,\n    (include_str \"SynapseIndex.lean\").toUTF8, (include_str \"SynapseBuild.lean\").toUTF8,\n    (include_str \"SynapseProvenance.lean\").toUTF8, (include_str \"ObservationAge.lean\").toUTF8,\n    (include_str \"ContentCapture.lean\").toUTF8,(include_str \"ContentMetadata.lean\").toUTF8,\n    (include_str \"../tools/ContentCorrespondence.lean\").toUTF8,\n    (include_str \"JsonScalars.lean\").toUTF8,\n    (include_str \"SynapseQuotes.lean\").toUTF8,\n    (include_str \"ObservationContext.lean\").toUTF8,(include_str \"Sha256.lean\").toUTF8,\n    (include_str \"QuotationContext.lean\").toUTF8,\n    (include_str \"ObservedRecords.lean\").toUTF8,\n    (include_str \"ObservedRecordView.lean\").toUTF8,\n    (include_str \"OriginalStructure.lean\").toUTF8,\n    (include_str \"../tools/LiteralSearch.lean\").toUTF8,\n    (include_str \"SourceEvidence.lean\").toUTF8,\n    (include_str \"SearchUnicode.lean\").toUTF8,\n    (include_str \"../tools/RetrievalCategories.lean\").toUTF8])\n\ndef factName (fact : Fact) : String := \"fact:\" ++ contentKey fact\n\ndef postingPrefix (key : Key) : String := \"lookup:\" ++ contentKey key ++ \":\"\n\nstructure Posting where\n  key : Key\n  fact : String\n  deriving BEq, ToJson, FromJson\n\ndef postingName (key : Key) (fact : Fact) : String := postingPrefix key ++ contentKey fact\n\ndef eventName (event : Event) : String := \"event:\" ++ contentKey event\n\ndef belongs (database : String) : Fact → Bool\n  | .read recorded => recorded.binding.database == database\n  | .supports support => support.claim.database == database && support.read.binding.database == database\n  | .coquoted (.answer owner _) _ => owner == database\n  | .coquoted (.claim claim) _ => claim.database == database\n  | .consumed _ | .used _ => true\n\ndef checkDestination (storage : Sidecar.Storage) (scope : Scope) : IO Unit :=\n  if scope == .usage && storage != .user then\n    throw (IO.userError \"synaptic usage must stay in the private DB overlay\")\n  else pure ()\n\nstructure Manifest where\n  source : PageMap.Head\n  implementation : String\n  scope : Scope\n  facts : Nat\n  deriving BEq, ToJson, FromJson\n\ndef manifest? (snapshot : PageMap.Snapshot) : IO (Option Manifest) := do\n  (← snapshot.get \"manifest\").mapM (decode (α := Manifest))\n\n/-- An old index is usable across derived-only commits, through exact parent heads.\nThe lookup path examines at most the supplied number of journal entries. -/\ndef sameSources (snapshot : PageMap.Snapshot) (saved : PageMap.Head) (limit : Nat := 16) : IO Bool := do\n  if saved.identity != snapshot.head.identity || saved.authority != snapshot.head.authority then return false\n  let mut current := snapshot.head\n  for _ in [:limit] do\n    if current == saved then return true\n    if current.revision ≤ saved.revision then return false\n    let publication ← Persistence.Store.readPublication snapshot current.revision\n    if !publication.change.neutral then return false\n    current := publication.parent\n  return current == saved\n\ndef directory (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\n    IO System.FilePath := do\n  return (← Sidecar.locate snapshot storage).directory / \"synapses\" / scope.directory\n\ndef prepare (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) :\n    IO PageMap.Snapshot := do\n  if scope == .usage && storage != .user then\n    throw (IO.userError \"synaptic usage must stay in the private DB overlay\")\n  let sidecar ← Sidecar.prepare (Sidecar.Owner.ofSnapshot snapshot) storage\n  let parent ← Sidecar.childDirectory sidecar.directory \"synapses\"\n  let path := parent / scope.directory\n  match ← PageMap.open? path with\n  | some snapshot => return snapshot\n  | none => PageMap.create path (\"advisory:\" ++ snapshot.head.identity ++ \":\" ++ scope.directory)\n\nstructure Reader where\n  index : PageMap.Snapshot\n  manifest : Manifest\n\n/-- Opening never creates an index or prepares a directory inside a shared DB. -/\ndef open? (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) : IO (Option Reader) := do\n  if scope == .usage && storage != .user then return none\n  let path ← directory source storage scope\n  let some index ← PageMap.open? path | return none\n  let some metadata ← manifest? index | return none\n  unless metadata.implementation == implementation && metadata.scope == scope do return none\n  if scope == .shared then\n    unless (← index.get \"provenance\") == some (toJson (← Provenance.stamp source)).compress.toUTF8 do return none\n    unless ← sameSources source metadata.source do return none\n  else\n    unless metadata.source.identity == source.head.identity &&\n        metadata.source.authority == source.head.authority do return none\n  return some ⟨index, metadata⟩\n\ndef openShared? (source : PageMap.Snapshot) : IO (Option Reader) := do\n  if let some reader ← open? source .database .shared then return some reader\n  open? source .user .shared\n\ndef putImmutable (writer : PageMap.Writer) (name : String) (bytes : ByteArray) : IO Bool := do\n  if let some previous ← writer.get name then\n    unless previous == bytes do throw (IO.userError \"conflicting synaptic content address\")\n    return false\n  writer.put name (some bytes)\n  return true\n\ndef insert (writer : PageMap.Writer) (database : String) (scope : Scope) (fact : Fact) : IO Bool := do\n  unless scope.accepts fact && belongs database fact && fact.valid do\n    throw (IO.userError \"invalid fact or wrong synaptic privacy/DB scope\")\n  if let .used usage := fact then\n    let _ ← putImmutable writer (eventName usage.event) (← checkedBytes usage)\n  let inserted ← putImmutable writer (factName fact) (← checkedBytes fact)\n  Routing.Store.insert writer fact\n  for key in addresses fact do\n    let posting : Posting := ⟨key, contentKey fact⟩\n    let _ ← putImmutable writer (postingName key fact) (← checkedBytes posting)\n  return inserted\n\ndef erase (writer : PageMap.Writer) (fact : Fact) : IO Bool := do\n  let name := factName fact\n  let some previous ← writer.get name | return false\n  unless previous == (toJson fact).compress.toUTF8 do\n    throw (IO.userError \"retired synaptic object differs from its content address\")\n  Routing.Store.erase writer fact\n  writer.put name none\n  for key in addresses fact do writer.put (postingName key fact) none\n  -- Retiring a recommendation does not permit relabelling an observed event.\n  -- The small immutable witness remains until its owning DB cache is retired.\n  return true\n\nstructure Delta where\n  removed : Array Fact := #[]\n  added : Array Fact := #[]\n\ndef checkFacts (database : String) (scope : Scope) (facts : Array Fact) : IO Unit :=\n  unless facts.all (fun fact => scope.accepts fact && belongs database fact && fact.valid) do\n    throw (IO.userError \"invalid fact or wrong synaptic privacy/DB scope\")\n\n/-- One metadata publication commits facts and all inverse postings together.\nAn incompatible prior implementation needs a full replacement, never reuse. -/\ndef publishDelta (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\n    (expected : Option PageMap.Head) (delta : Delta)\n    (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\n  checkDestination storage scope\n  checkFacts source.head.identity scope delta.added\n  checkFacts source.head.identity scope delta.removed\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\n    let index ← prepare source storage scope\n    let previous ← manifest? index\n    if let some previous := previous then\n      if scope == .shared && previous.source.revision > source.head.revision then\n        throw (IO.userError \"older source cannot replace a later synaptic publication\")\n      unless previous.source == expected.getD source.head && previous.implementation == implementation &&\n          previous.scope == scope do throw (IO.userError \"stale synaptic index update\")\n    else if expected.isSome then throw (IO.userError \"missing synaptic index update base\")\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\n      let mut count := previous.map (·.facts) |>.getD 0\n      for fact in delta.removed do\n        if ← erase writer fact then count := count-1\n      for fact in delta.added do\n        if ← insert writer source.head.identity scope fact then count := count+1\n      prepareRecords writer\n      let next : Manifest := ⟨source.head, implementation, scope, count⟩\n      Routing.Store.finish writer count\n      let bytes ← checkedBytes next\n      if (← writer.get \"manifest\") != some bytes then writer.put \"manifest\" (some bytes)\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\n      if (← writer.get \"provenance\") != some provenance then writer.put \"provenance\" (some provenance)\n    return head) storage\n\ndef allFacts (index : PageMap.Snapshot) : IO (Array Fact) :=\n  index.foldRange ⟨\"fact:\", \"fact;\"⟩ (fun facts row => do\n    let some bytes := row.2 | return facts\n    let fact ← decode (α := Fact) bytes\n    unless row.1 == factName fact && fact.valid do throw (IO.userError \"foreign synaptic fact row\")\n    return facts.push fact) #[]\n\n/-- Explicit warm/background replacement; it never runs in a search hook. -/\ndef replace (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope)\n    (facts : Array Fact) (prepareRecords : PageMap.Writer → IO Unit := fun _ => pure ()) : IO PageMap.Head := do\n  checkDestination storage scope\n  checkFacts source.head.identity scope facts\n  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun _ => do\n    let index ← prepare source storage scope\n    if let some previous ← manifest? index then\n      if scope == .shared && previous.source.revision > source.head.revision then\n        throw (IO.userError \"older source cannot replace a later synaptic publication\")\n    let wanted := facts.foldl (fun wanted fact => wanted.insert (factName fact)) ({} : Std.HashSet String)\n    let old ← allFacts index\n    let (_, head, _) ← PageMap.withWriter index fun writer => do\n      for fact in old do\n        if !wanted.contains (factName fact) then let _ ← erase writer fact; pure ()\n      for fact in facts do let _ ← insert writer source.head.identity scope fact; pure ()\n      prepareRecords writer\n      let next : Manifest := ⟨source.head, implementation, scope, wanted.size⟩\n      Routing.Store.finish writer wanted.size\n      let bytes ← checkedBytes next\n      if (← writer.get \"manifest\") != some bytes then writer.put \"manifest\" (some bytes)\n      let provenance := (toJson (← Provenance.stamp source)).compress.toUTF8\n      if (← writer.get \"provenance\") != some provenance then writer.put \"provenance\" (some provenance)\n    return head) storage\n\nstructure Scan where\n  postings : Array Posting := #[]\n  inspected : Nat := 0\n  pages : Nat := 0\n  complete : Bool := true\n\n/-- Stop in the tree, rather than materializing or traversing all postings. -/\ndef scanAt (index : PageMap.Snapshot) (ref : PageMap.Ref) (range : PageMap.KeyRange)\n    (limit deadline : Nat) (initial : Scan) : IO Scan := do\n  if !initial.complete then return initial\n  if initial.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {initial with complete := false}\n  let loaded ← index.load ref\n  let mut result := {initial with pages := initial.pages+1}\n  match loaded.page with\n  | .leaf rows =>\n    for row in range.select rows do\n      if result.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then return {result with complete := false}\n      let some bytes := row.2 | continue\n      let posting ← decode (α := Posting) bytes\n      unless row.1 == postingPrefix posting.key ++ posting.fact do throw (IO.userError \"foreign synaptic posting\")\n      result := {result with postings := result.postings.push posting, inspected := result.inspected+1}\n    return result\n  | .branch children =>\n    for child in children do\n      if range.overlaps child then\n        if _smaller : child.height < ref.height then\n          result ← scanAt index child range limit deadline result\n        else throw (IO.userError \"synaptic index height did not decrease\")\n        if !result.complete then return result\n    return result\ntermination_by ref.height\n\n/-- This certifies the advisory inverse relation, not Work or completion authority. -/\nstructure CheckedFact (key : Key) where\n  fact : Fact\n  valid : fact.valid = true\n  bound : key ∈ addresses fact\n\ndef CheckedFact.check? (key : Key) (fact : Fact) : Option (CheckedFact key) :=\n  if valid : fact.valid = true then\n    if bound : (addresses fact).contains key = true then\n      some ⟨fact, valid, Array.mem_of_contains_eq_true bound⟩\n    else none\n  else none\n\nstructure Lookup (key : Key) where\n  checked : Array (CheckedFact key)\n  complete : Bool\n  postingPages : Nat\n  index : PageMap.Head\n  payloadBytes : Nat := 0\n\ndef Lookup.facts (lookup : Lookup key) : Array Fact := lookup.checked.map (·.fact)\n\ntheorem Lookup.returned_bound (lookup : Lookup key) (fact : Fact)\n    (present : fact ∈ lookup.facts) :\n    fact.valid = true ∧ key ∈ addresses fact := by\n  simp only [Lookup.facts, Array.mem_map] at present\n  obtain ⟨checked, _, equal⟩ := present\n  subst fact\n  exact ⟨checked.valid, checked.bound⟩\n\ndef Reader.lookup (reader : Reader) (key : Key) (limit deadline : Nat)\n    (byteLimit : Option Nat := none) : IO (Lookup key) := do\n  let name := postingPrefix key\n  let scanned ← match reader.index.head.root with\n    | none => pure ({} : Scan)\n    | some root => scanAt reader.index root ⟨name, \"lookup:\" ++ contentKey key ++ \";\"⟩ limit deadline {}\n  let mut facts := #[]\n  let mut complete := scanned.complete\n  let mut payloadBytes := 0\n  for posting in scanned.postings do\n    if (← IO.monoMsNow) ≥ deadline then\n      complete := false\n      break\n    unless posting.key == key do throw (IO.userError \"ambiguous synaptic key digest\")\n    let some bytes ← reader.index.get (\"fact:\" ++ posting.fact) |\n      throw (IO.userError \"dangling synaptic posting\")\n    if byteLimit.any (payloadBytes+bytes.size > ·) then\n      complete := false\n      break\n    let fact ← decode (α := Fact) bytes\n    unless fact.valid && reader.manifest.scope.accepts fact && belongs reader.manifest.source.identity fact &&\n        contentKey fact == posting.fact && (addresses fact).contains key do\n      throw (IO.userError \"synaptic posting does not bind its original fact\")\n    let some checked := CheckedFact.check? key fact |\n      throw (IO.userError \"unbound advisory index result\")\n    facts := facts.push checked\n    payloadBytes := payloadBytes+bytes.size\n  return ⟨facts, complete, scanned.pages, reader.index.head, payloadBytes⟩\n\nend Eggshell.Synapses.Index\n"],["SynapseBuild.lean","module\n\npublic import Eggshell.SynapseIndex\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Build\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\n\n/-- This adapter reads a pinned native publication. No export, tool execution,\nor model is involved; unsupported observations remain unlocated. -/\ndef identities (edge : OutcomeEdge) : Array Occurrence := Provenance.identities edge\n\ndef document (reader : NodeReader snapshot) (id : Nat) : IO Document := Provenance.document reader id\n\nstructure Entry where\n  id : Nat\n  work : Nat\n\n/-- The candidate directory supplies headers only, not window lists or bodies. -/\ndef entries (snapshot : PageMap.Snapshot) : IO (Array Entry) := do\n  let mut result := #[]\n  for (ordinal, id) in ← directory snapshot \"searchCandidate\" do\n    let located ← locateOutcome snapshot id\n    unless (← getNat snapshot.get (key \"member\" id)) == ordinal &&\n        (← getNat snapshot.get (key \"candidate\" id)) == 1 do\n      throw (IO.userError \"synaptic candidate is not a live original owner\")\n    result := result.push ⟨id, located.header.work⟩\n  return result\n\ndef topology (snapshot : PageMap.Snapshot) : IO (Std.HashMap Nat (Array Nat)) := do\n  let mut result := {}\n  for header in ← allHeaders snapshot do\n    result := result.insert header.2.header.parent\n      (result[header.2.header.parent]?.getD #[] ++ header.2.header.children.toArray)\n  return result\n\ndef closure (edges : Std.HashMap Nat (Array Nat)) (roots : Array Nat) : Std.HashSet Nat := Id.run do\n  let mut seen := {}\n  let mut queue := roots\n  let mut position := 0\n  while position < queue.size do\n    let current := queue[position]!\n    position := position + 1\n    if seen.contains current then continue\n    seen := seen.insert current\n    queue := queue ++ edges[current]?.getD #[]\n  return seen\n\ndef reverse (edges : Std.HashMap Nat (Array Nat)) : Std.HashMap Nat (Array Nat) :=\n  edges.fold (fun result parent children => children.foldl\n    (fun result child => result.insert child (result[child]?.getD #[] |>.push parent)) result) {}\n\nstructure Changes where\n  owners : Std.HashSet Nat := {}\n  works : Std.HashSet Nat := {}\n  removed : Bool := false\n\n/-- Follow exact parent heads, not revision counters. A non-ancestor cache\nrequires an explicit rebuild rather than a fabricated incremental update. -/\ndef changes (snapshot : PageMap.Snapshot) (saved : PageMap.Head) : IO (Option Changes) := do\n  if saved.identity != snapshot.head.identity || saved.authority != snapshot.head.authority then return none\n  let mut current := snapshot.head\n  let mut result : Changes := {}\n  while current != saved do\n    if current.revision ≤ saved.revision then return none\n    let publication ← readPublication snapshot current.revision\n    result := {result with removed := result.removed || !publication.change.removed.isEmpty}\n    for id in publication.change.added ++ publication.change.removed ++ publication.change.affected do\n      let frame ← readFrame snapshot snapshot.get id\n      if let some header := OutcomeHeader.fromFrame? frame then\n        result := {result with owners := result.owners.insert id, works := result.works.insert header.work}\n      if let some header := AllHeader.fromFrame? frame then\n        result := {result with works := result.works.insert header.parent}\n      if let .apply .receipt references := frame.frame then\n        if let some fields := SourceEvidence.receiptFields? references then\n          if (← readNode snapshot snapshot.get fields.marker) == .text SourceEvidence.receiptMarker &&\n              (← readNode snapshot snapshot.get fields.purpose) == .text SourceEvidence.receiptPurpose then\n            let some owner := OutcomeHeader.fromFrame? (← readFrame snapshot snapshot.get fields.owner) |\n              throw (IO.userError \"source receipt does not refer to an original Outcome frame\")\n            result := {result with\n              owners := result.owners.insert fields.owner\n              works := result.works.insert owner.work}\n    current := publication.parent\n  return some result\n\ndef retain (readOwners answers : Std.HashSet String) (keepConsumption : Bool) : Fact → Bool\n  | .read read => !readOwners.contains read.binding.owner\n  | .supports support => !readOwners.contains support.read.binding.owner && !answers.contains support.claim.answer\n  | .coquoted (.answer _ answer) _ => !answers.contains answer\n  | .coquoted (.claim claim) _ => !answers.contains claim.answer\n  | .consumed _ => keepConsumption\n  | .used _ => false\n\ntheorem retained_support_independent (reads answers : Std.HashSet String) (keep : Bool) (support : Support)\n    (retained : retain reads answers keep (.supports support) = true) :\n    reads.contains support.read.binding.owner = false ∧ answers.contains support.claim.answer = false := by\n  simpa [retain, Bool.and_eq_true] using retained\n\ntheorem usage_never_enters_shared_rebuild (reads answers : Std.HashSet String) (keep : Bool) (usage : Usage) :\n    retain reads answers keep (.used usage) = false := rfl\n\nstructure Result where\n  mode : String\n  source : PageMap.Head\n  index : PageMap.Head\n  candidates : Nat := 0\n  hydrated : Nat := 0\n  consumptionRebuilt : Bool := false\n  provenanceOriginals : Nat := 0\n  provenanceIgnored : Nat := 0\n  answers : Nat := 0\n  unsupported : Nat := 0\n  facts : Nat := 0\n  elapsedMs : Nat := 0\n  deriving ToJson\n\nstructure Documents (snapshot : PageMap.Snapshot) where\n  reader : NodeReader snapshot\n  cache : IO.Ref (Std.HashMap Nat Document)\n  catalogs : IO.Ref (Std.HashMap Nat ObservationContext.Catalog)\n\ndef Documents.get (documents : Documents snapshot) (id : Nat) : IO Document := do\n  if let some doc := (← documents.cache.get)[id]? then return doc\n  let doc ← document documents.reader id\n  documents.cache.modify (·.insert id doc)\n  return doc\n\ndef Documents.catalog (documents : Documents snapshot) (id : Nat) : IO ObservationContext.Catalog := do\n  if let some catalog := (← documents.catalogs.get)[id]? then return catalog\n  let doc ← documents.get id\n  let original ← match ← ObservedRecords.load? snapshot id doc with\n    | some catalog => pure catalog\n    | none => do\n        let some raw := doc.source | throw (IO.userError \"original record body is missing\")\n        let prepared ← IO.ofExcept (ObservedRecords.prepare raw)\n        IO.ofExcept (ObservedRecords.catalog snapshot.head.identity doc prepared.records)\n  -- File aliases are additional coordinates, never the original domain gate.\n  let files := (recordedReads snapshot.head.identity doc).toOption.getD #[]\n  let captured ← match ← ContentMetadata.load? snapshot id doc with\n    | none => pure ({} : ObservationContext.Catalog)\n    | some captured => IO.ofExcept (ContentMetadata.catalog snapshot.head.identity doc captured)\n  let catalog := {original with\n    located := files ++ captured.located ++ original.located\n    quotations := captured.quotations ++ original.quotations}\n  documents.catalogs.modify (·.insert id catalog)\n  return catalog\n\ndef ownerId? (snapshot : PageMap.Snapshot) (owner : String) : IO (Option Nat) := do\n  let some checked := Persistence.SelectionKey.check? owner |\n    throw (IO.userError \"noncanonical synaptic owner locator\")\n  let ids ← getIds snapshot.get (\"owner:\" ++ toString checked.digest)\n  let live ← ids.filterM fun id => return (← snapshot.get (key \"member\" id)).isSome\n  match live with\n  | [] => return none\n  | [id] => return some id\n  | _ => throw (IO.userError \"ambiguous synaptic owner locator\")\n\n/-- Scheduling probe only: bounded metadata reads and no directory creation. -/\ndef required (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Bool := do\n  return (← Index.open? snapshot storage .shared).isNone\n\n/-- The background extractor keeps only metadata between publications. A new\nanswer hydrates its cited original reads, never every unrelated source body. -/\ndef refresh (snapshot : PageMap.Snapshot) (storage : Sidecar.Storage) : IO Result := do\n  let started ← IO.monoMsNow\n  if let some ready ← Index.open? snapshot storage .shared then\n    return {\n      mode := \"warm\", source := snapshot.head, index := ready.index.head\n      facts := ready.manifest.facts, elapsedMs := (← IO.monoMsNow) - started}\n  let path ← Index.directory snapshot storage .shared\n  let previous ← PageMap.open? path\n  let metadata ← previous.bindM Index.manifest?\n  let compatible := metadata.filter fun value => value.implementation == Index.implementation && value.scope == .shared\n  let delta ← compatible.bindM fun value => changes snapshot value.source\n  let incremental := delta.isSome\n  let previousFacts ← if incremental then previous.mapM Index.allFacts else pure none\n  let old := previousFacts.getD #[]\n  Index.checkFacts snapshot.head.identity .shared old\n  let catalog ← entries snapshot\n  let all ← topology snapshot\n  let changed := delta.getD {}\n  let affectedWorks := closure (reverse all) changed.works.toArray\n  let documents : Documents snapshot := ⟨← NodeReader.new snapshot, ← IO.mkRef {}, ← IO.mkRef {}⟩\n  let mut readOwners := #[]\n  let mut answerOwners := #[]\n  let mut retiredReads : Std.HashSet String := {}\n  let mut retiredAnswers : Std.HashSet String := {}\n  let mut unsupported := 0\n  for entry in catalog do\n    if !incremental || changed.owners.contains entry.id || affectedWorks.contains entry.work then\n      let doc ← documents.get entry.id\n      if doc.native then\n        if !incremental || changed.owners.contains entry.id then readOwners := readOwners.push entry\n      else\n        answerOwners := answerOwners.push entry\n        retiredAnswers := retiredAnswers.insert doc.owner\n  -- Retired original owners are absent from the current candidate directory.\n  for id in changed.owners do\n    let value ← readNode snapshot snapshot.get id\n    retiredReads := retiredReads.insert (Persistence.selectionKey value)\n    retiredAnswers := retiredAnswers.insert (Persistence.selectionKey value)\n  -- A source retraction also invalidates its former answer/coquotation groups.\n  for fact in old do\n    if let .supports support := fact then\n      if retiredReads.contains support.read.binding.owner then\n        retiredAnswers := retiredAnswers.insert support.claim.answer\n  for answer in retiredAnswers do\n    if let some id ← ownerId? snapshot answer then\n      if !answerOwners.any (·.id == id) && catalog.any (·.id == id) then\n        let doc ← documents.get id\n        if !doc.native then\n          let entry := catalog.find? (·.id == id)\n          if let some entry := entry then answerOwners := answerOwners.push entry\n  let stamp := (toJson (← Provenance.stamp snapshot)).compress.toUTF8\n  let previousStamp ← previous.bindM (·.get \"provenance\")\n  -- A new answer does not change previously observed call order or row\n  -- projections. Reuse those facts only if their origin stamp and source\n  -- metadata are unchanged; otherwise replay from the pinned originals.\n  let keepConsumption := incremental && readOwners.isEmpty && !changed.removed && previousStamp == some stamp\n  let mut graph ← IO.ofExcept (Graph.ofFacts (old.filter (retain retiredReads retiredAnswers keepConsumption)))\n  for entry in readOwners do\n    let catalog ← documents.catalog entry.id\n    if catalog.located.isEmpty then unsupported := unsupported+1\n    for read in catalog.reads do graph ← IO.ofExcept (graph.insert (.read read))\n  let reads := graph.snapshot.filterMap fun fact => match fact with | .read read => some read | _ => none\n  let mut workIds : Std.HashMap String Nat := {}\n  for entry in catalog do\n    if let some doc := (← documents.cache.get)[entry.id]? then workIds := workIds.insert doc.work entry.work\n  -- Resolve only recorded read owners whose metadata was reused.\n  let mut readIds : Std.HashMap String Nat := {}\n  for read in reads do\n    if readIds.contains read.binding.owner then continue\n    if let some id ← ownerId? snapshot read.binding.owner then\n      let located ← locateOutcome snapshot id\n      workIds := workIds.insert read.binding.work located.header.work\n      readIds := readIds.insert read.binding.owner id\n  for entry in answerOwners do\n    let doc ← documents.get entry.id\n    let route := closure all #[entry.work]\n    let available := reads.filter fun read => (workIds[read.binding.work]?).any route.contains\n    let files := available.foldl (fun files read =>\n      (read.source.file?.map files.insert).getD files) ({} : Std.HashSet File)\n    let citations := ((layout (doc.source.getD \"\")).map fun decoded =>\n      paragraphCitations decoded.text files.toArray).toOption.getD #[]\n    let needed := available.filter fun read => citations.any (fun cited =>\n      (cited.intersection? read.source).isSome)\n    let quoteTexts := ((layout (doc.source.getD \"\")).map fun decoded =>\n      decoded.text.splitOn \"\\n\\n\" |>.toArray.flatMap (fun paragraph =>\n        (Quotes.extract paragraph).map (·.text))).toOption.getD #[]\n    let quoteTexts := hashDistinct quoteTexts.toList |>.toArray\n    let index := LiteralSearch.prepare quoteTexts\n    let allowed := available.foldl (fun (set : Std.HashSet Read) read => set.insert read) {}\n    let mut spellings := #[]\n    let mut quoteOwners : Std.HashSet Nat := {}\n    if !quoteTexts.isEmpty then\n      for read in available do\n        let some id := readIds[read.binding.owner]? | continue\n        if quoteOwners.contains id then continue\n        quoteOwners := quoteOwners.insert id\n        let catalog ← documents.catalog id\n        spellings := spellings ++ ObservationContext.quoteMatches index\n          (catalog.quotations.filter (fun item => allowed.contains item.read))\n    let mut located := #[]\n    let mut seen : Std.HashSet Nat := {}\n    for read in needed ++ spellings.map (·.read) do\n      let some id := readIds[read.binding.owner]? | continue\n      if seen.contains id then continue\n      seen := seen.insert id\n      let catalog ← documents.catalog id\n      located := located ++ catalog.located\n    match addAnswer snapshot.head.identity doc located graph with\n    | .ok next => graph := next\n    | .error _ => unsupported := unsupported + 1\n    match ObservationContext.addQuotedAnswer snapshot.head.identity doc spellings graph with\n    | .ok next => graph := next\n    | .error _ => unsupported := unsupported + 1\n  let portable ← if keepConsumption then pure ({} : Provenance.Derived) else Provenance.derive snapshot\n  graph ← IO.ofExcept (graph.merge portable.graph)\n  let facts := graph.snapshot\n  -- The same changed-owner feed and the same atomic index publication own\n  -- the immutable original read view. Queries never normalize these bodies.\n  let prepareRecords := fun writer : PageMap.Writer => do\n    if !incremental then\n      let pinned ← writer.snapshot\n      let prior ← pinned.foldRange ⟨\"observed-view:owner:\",\"observed-view:owner;\"⟩\n        (fun keys row => pure (keys.push row.1)) (#[] : Array String)\n      for key in prior do writer.put key none\n    for owner in retiredReads do writer.put (ObservedRecordView.ownerKey owner) none\n    for entry in readOwners do\n      ObservedRecordView.stage writer snapshot.head.identity (← documents.get entry.id)\n  let head ← if incremental then\n      let wanted := graph.facts\n      let previous := old.foldl (fun set fact => set.insert fact) ({} : Std.HashSet Fact)\n      Index.publishDelta snapshot storage .shared (metadata.map (·.source)) {\n        removed := old.filter (!wanted.contains ·)\n        added := facts.filter (!previous.contains ·) } prepareRecords\n    else Index.replace snapshot storage .shared facts prepareRecords\n  return {\n    mode := if incremental then \"incremental\" else \"rebuild\", source := snapshot.head, index := head\n    candidates := catalog.size, hydrated := (← documents.cache.get).size, answers := answerOwners.size,\n    consumptionRebuilt := !keepConsumption,provenanceOriginals := portable.originals,provenanceIgnored := portable.ignored,\n    unsupported, facts := facts.size, elapsedMs := (← IO.monoMsNow) - started}\n\nend Eggshell.Synapses.Build\n"],["SynapseProvenance.lean","module\n\npublic import Eggshell.GraphStore\npublic import Eggshell.ObservationContext\npublic import Eggshell.ObservedRecords\npublic import Eggshell.ContentMetadata\npublic import Eggshell.ObservationAge\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Provenance\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\n\n/-- Native observation identity, with semantic positions checked independently\nof the Exact session/turn/tool identifiers. -/\ndef identities (edge : OutcomeEdge) : Array Occurrence :=\n  edge.observations.toArray.filterMap fun observation => do\n    let .apply .occurrence references := observation | none\n    let [(.semantic, result), (.semantic, work), (.exact, session),\n        (.exact, turn), (.exact, useId)] := references.toList | none\n    if result != edge.outcome || work != edge.work then none else\n      some ⟨← text? session, ← text? turn, ← text? useId⟩\n\ndef document (reader : NodeReader snapshot) (id : Nat) : IO Document := do\n  let edge ← reader.outcome (← reader.locateOutcome id)\n  let owner := Persistence.selectionKey edge.relation\n  let candidates ← getIds snapshot.get (\"owner:\" ++ toString (hash edge.relation).toNat)\n  let live ← candidates.filterM fun id => return (← snapshot.get (key \"member\" id)).isSome\n  unless live == [id] do throw (IO.userError \"ambiguous synaptic source owner\")\n  return {\n    owner, work := Persistence.selectionKey edge.work\n    workText := text? edge.work, source := text? edge.outcome\n    native := edge.observations.any (Relation.observesOutcomeWork edge.outcome edge.work)\n    occurrences := identities edge\n    files := ← IO.ofExcept (fileMap ((← reader.sources id).toArray.map toJson)) }\n\n/-- Query-free provenance. The body stays in its original native Outcome. -/\nstructure Origin where\n  owner : Nat\n  occurrence : Occurrence\n  domain : String\n  started : Nat\n  finished : Nat\n  receivedUnixMs : Option Nat := none\n  deriving BEq, FromJson\n\n/-- Absence stays absent, including in original records without a wall clock. -/\ninstance : ToJson Origin where\n  toJson origin := Json.mkObj ([\n    (\"owner\", toJson origin.owner), (\"occurrence\", toJson origin.occurrence),\n    (\"domain\", toJson origin.domain), (\"started\", toJson origin.started),\n    (\"finished\", toJson origin.finished)] ++\n    origin.receivedUnixMs.toList.map (fun time => (\"receivedUnixMs\", toJson time)))\n\ndef Origin.valid (origin : Origin) : Bool :=\n  origin.occurrence.valid && digest origin.domain && origin.started < origin.finished\n\nstructure Checked where\n  origin : Origin\n  valid : origin.valid = true\n\ndef Origin.check? (origin : Origin) : Option Checked :=\n  if valid : origin.valid = true then some ⟨origin, valid⟩ else none\n\ntheorem Checked.time_order (checked : Checked) : checked.origin.started < checked.origin.finished := by\n  have := checked.valid\n  simp only [Origin.valid, Bool.and_eq_true, decide_eq_true_eq] at this\n  exact this.2\n\ndef originPrefix : String := \"memo:synaptic-origin:\"\ndef stateKey : String := \"memo:synaptic-state\"\n\ndef contentKey [ToJson α] (value : α) : String :=\n  Blake3.hex (Blake3.digest \"eggshell.synaptic-provenance\".toUTF8 [(toJson value).compress.toUTF8])\n\ndef name (occurrence : Occurrence) : String := originPrefix ++ contentKey occurrence\n\ndef originRow (occurrence : Occurrence) (encoded : ByteArray) : PageMap.Row :=\n  (name occurrence, some encoded)\n\ndef stateRow (encoded : ByteArray) : PageMap.Row := (stateKey, some encoded)\n\n/-- The actual metadata row constructors preserve all graph and authority\nkeys. The publication journal is managed separately by the checked writer. -/\ntheorem metadata_preserves_authority (occurrence : Occurrence) (encoded root : ByteArray)\n    (before : String → Option ByteArray) (key : String) (outside : PageMap.derivedKey key = false) :\n    PageMap.applyRows [originRow occurrence encoded, stateRow root] before key = before key := by\n  apply PageMap.derived_rows_preserve _ _ _ key outside\n  simp [originRow, stateRow, name, originPrefix, stateKey, PageMap.derivedKey]\n\nstructure State where\n  count : Nat := 0\n  digest : String := contentKey (\"empty\" : String)\n  deriving BEq, ToJson, FromJson\n\nstructure Stored where\n  ordinal : Nat\n  previous : String\n  origin : Origin\n  deriving BEq, ToJson, FromJson\n\ndef bytes [ToJson α] (value : α) : IO ByteArray := do\n  let encoded := (toJson value).compress.toUTF8\n  unless encoded.size ≤ 65536 do throw (IO.userError \"synaptic provenance exceeds its metadata bound\")\n  return encoded\n\ndef decode [ToJson α] [FromJson α] (encoded : ByteArray) : IO α := do\n  unless encoded.size ≤ 65536 do throw (IO.userError \"synaptic provenance exceeds its metadata bound\")\n  let some text := String.fromUTF8? encoded | throw (IO.userError \"invalid provenance UTF-8\")\n  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))\n  unless (toJson value).compress.toUTF8 == encoded do throw (IO.userError \"noncanonical synaptic provenance\")\n  return value\n\ndef state (source : PageMap.Snapshot) : IO State := do\n  let result ← match ← source.get stateKey with\n    | none => pure ({} : State)\n    | some encoded => decode encoded\n  unless Synapses.digest result.digest do throw (IO.userError \"invalid synaptic provenance root\")\n  return result\n\ndef stamp (source : PageMap.Snapshot) : IO String := do\n  return contentKey (← state source)\n\ndef records (source : PageMap.Snapshot) : IO (Array Stored) := do\n  let values ← source.foldRange ⟨originPrefix, \"memo:synaptic-origin;\"⟩ (fun values row => do\n    let some encoded := row.2 | return values\n    let value ← decode (α := Stored) encoded\n    unless row.1 == name value.origin.occurrence && value.origin.valid do\n      throw (IO.userError \"provenance record is not bound to its original identity\")\n    return values.push value) #[]\n  let values := values.qsort (fun a b => a.ordinal < b.ordinal)\n  let mut previous : State := {}\n  for value in values do\n    unless value.ordinal == previous.count && value.previous == previous.digest do\n      throw (IO.userError \"incomplete or reordered provenance chain\")\n    previous := ⟨previous.count+1, contentKey value⟩\n  unless previous == (← state source) do throw (IO.userError \"provenance records disagree with their published root\")\n  return values\n\ndef checkedDocument (reader : NodeReader source) (origin : Origin) : IO Document := do\n  unless origin.valid do throw (IO.userError \"invalid native provenance interval\")\n  let doc ← document reader origin.owner\n  unless doc.native && doc.occurrences.contains origin.occurrence do\n    throw (IO.userError \"provenance does not belong to its original native observation\")\n  return doc\n\n/-- A single immutable metadata lookup against a pinned source, not a scan of\nthe origin log. The caller's native owner and occurrence must both agree. -/\ndef lookup? (source : PageMap.Snapshot) (owner : OutcomeEdge)\n    (occurrence : Occurrence) : IO (Option Origin) := do\n  unless (identities owner).contains occurrence do return none\n  let some encoded ← source.get (name occurrence) | return none\n  let stored ← decode (α := Stored) encoded\n  unless stored.origin.valid && stored.origin.occurrence == occurrence &&\n      stored.ordinal < (← state source).count do\n    throw (IO.userError \"invalid native observation metadata\")\n  unless (← findNode? source owner.relation) == some stored.origin.owner &&\n      (← source.get (key \"member\" stored.origin.owner)).isSome do\n    throw (IO.userError \"native observation metadata has another owner\")\n  return some stored.origin\n\n/-- One checked native observation, still bound to its complete original edge. -/\nstructure Binding where\n  edge : OutcomeEdge\n  checked : Checked\n  observed : (identities edge).contains checked.origin.occurrence = true\n\ndef Binding.check? (edge : OutcomeEdge) (origin : Origin) : Option Binding := do\n  let checked ← origin.check?\n  if observed : (identities edge).contains checked.origin.occurrence = true then\n    some ⟨edge,checked,observed⟩ else none\n\ntheorem binding_has_observed_interval (binding : Binding) :\n    binding.checked.origin.valid = true ∧\n      (identities binding.edge).contains binding.checked.origin.occurrence = true :=\n  ⟨binding.checked.valid,binding.observed⟩\n\ndef appendRows (writer : PageMap.Writer) (origins : Array Origin) : IO Bool := do\n  let initial ← match ← writer.get stateKey with\n    | none => pure ({} : State)\n    | some encoded => decode encoded\n  unless Synapses.digest initial.digest do throw (IO.userError \"invalid synaptic provenance root\")\n  let mut current := initial\n  for origin in origins do\n    let key := name origin.occurrence\n    unless PageMap.derivedKey key do throw (IO.userError \"provenance key escaped the non-authoritative namespace\")\n    if let some encoded ← writer.get key then\n      let old ← decode (α := Stored) encoded\n      unless old.origin == origin && old.ordinal < current.count do\n        throw (IO.userError \"conflicting immutable native provenance\")\n    else\n      let value : Stored := ⟨current.count,current.digest,origin⟩\n      let row := originRow origin.occurrence (← bytes value)\n      writer.put row.1 row.2\n      current := ⟨current.count+1,contentKey value⟩\n  if current == initial then return false\n  let row := stateRow (← bytes current)\n  writer.put row.1 row.2\n  return true\n\n/-- Stage after the same transaction's original roots. No source ACK can be\nreturned between body publication and this metadata publication. -/\ndef stage (intern : Persistence.Store.Intern) (bindings : Array Binding) : IO Bool := do\n  for binding in bindings do\n    let id ← intern.value binding.edge.relation\n    unless id == binding.checked.origin.owner &&\n        (← intern.writer.get (key \"member\" id)).isSome do\n      throw (IO.userError \"native interval is not bound to its live original root\")\n  appendRows intern.writer (bindings.map (·.checked.origin))\n\n/-- Background preparation consumes source-published originals. It never\nrepublishes source metadata, even when every proposed row is already present.\nMissing intervals remain source-publication debt; only `stage` may create them. -/\ndef requirePublished (source : PageMap.Snapshot) (origins : Array Origin) : IO Unit := do\n  if origins.isEmpty then return\n  let some encoded ← source.get stateKey |\n    throw (IO.userError \"original intervals have not been source-published\")\n  let state ← decode (α := State) encoded\n  unless digest state.digest do throw (IO.userError \"invalid native provenance root\")\n  let reader ← NodeReader.new source\n  for origin in origins do\n    let _ ← checkedDocument reader origin\n    let some encoded ← source.get (name origin.occurrence) |\n      throw (IO.userError \"original interval awaits its source publication\")\n    let stored ← decode (α := Stored) encoded\n    unless stored.origin == origin && stored.ordinal < state.count do\n      throw (IO.userError \"source-published original interval disagrees with native replay\")\n\nstructure Event where\n  origin : Origin\n  start : Bool\n\ndef Event.time (event : Event) : Nat := if event.start then event.origin.started else event.origin.finished\n\ndef Event.group (event : Event) : String :=\n  (toJson (event.origin.domain, event.origin.occurrence.session, event.origin.occurrence.turn)).compress\n\nstructure Derived where\n  graph : Graph := .empty\n  originals : Nat := 0\n  ignored : Nat := 0\n\n/-- Reconstruct only from DB-owned original bodies and observed intervals.\nAllocation ordinals validate storage; only actual times determine consumption. -/\ndef derive (source : PageMap.Snapshot) : IO Derived := do\n  let stored ← records source\n  if stored.isEmpty then return {}\n  let reader ← NodeReader.new source\n  let mut docs : Std.HashMap Nat Document := {}\n  let mut events : Array Event := #[]\n  let mut ignored := 0\n  for value in stored do\n    let origin := value.origin\n    if (← source.get (key \"member\" origin.owner)).isNone then ignored := ignored+1; continue\n    let doc ← checkedDocument reader origin\n    let some work := doc.workText | ignored := ignored+1; continue\n    if doc.source.isNone || (invocationData work).toOption.isNone then ignored := ignored+1; continue\n    docs := docs.insert origin.owner doc\n    events := events.push ⟨origin, true⟩ |>.push ⟨origin, false⟩\n  events := events.qsort fun a b =>\n    if a.group == b.group then\n      if a.time == b.time then name a.origin.occurrence < name b.origin.occurrence else a.time < b.time\n    else a.group < b.group\n  let mut result : Derived := {ignored, originals := events.size/2}\n  let mut trace : Trace := {}\n  let mut group := \"\"\n  let mut locations : Std.HashMap Occurrence (Array OutputRow) := {}\n  for event in events do\n    if group != event.group then\n      let located ← IO.ofExcept (trace.locate locations)\n      result := {result with graph := ← IO.ofExcept (result.graph.merge located.graph)}\n      trace := {}; locations := {}; group := event.group\n    let some doc := docs[event.origin.owner]? | throw (IO.userError \"missing original provenance body\")\n    if event.start then\n      let (input,format) ← IO.ofExcept (invocationData (doc.workText.getD \"\"))\n      trace ← IO.ofExcept (trace.start event.origin.occurrence event.time input format)\n    else\n      let raw := doc.source.getD \"\"\n      let format := if (Json.parse raw).isOk then DataFormat.json else .text\n      trace ← IO.ofExcept (trace.finish event.origin.occurrence event.time raw format)\n      let catalog ← match ← ObservedRecords.load? source event.origin.owner doc with\n        | some catalog => pure catalog\n        | none => do\n            let prepared ← IO.ofExcept (ObservedRecords.prepare raw)\n            IO.ofExcept (ObservedRecords.catalog source.head.identity doc prepared.records)\n      let reads := ObservationContext.locateUsing source.head.identity doc trace catalog\n      let rows := reads.filter (·.read.occurrence == event.origin.occurrence) |>.flatMap (·.rows)\n      locations := locations.insert event.origin.occurrence rows\n  let located ← IO.ofExcept (trace.locate locations)\n  return {result with graph := ← IO.ofExcept (result.graph.merge located.graph)}\n\nend Eggshell.Synapses.Provenance\n"],["ObservationAge.lean","module\n\npublic import Lean\npublic import Std.Time.DateTime.Timestamp\n\n@[expose] public section\n\nnamespace Eggshell.ObservationAge\nopen Lean\n\n/-- An advisory interval after receipt, not a proof that external data is unchanged. -/\ndef monthMs : Nat := 30 * 24 * 60 * 60 * 1000\n\ninductive Status where\n  | recent | expired | unknown | clockSkew\n  deriving BEq, ToJson, FromJson\n\nstructure Assessment where\n  receivedUnixMs : Option Nat\n  assessedUnixMs : Option Nat\n  updateAfterMs : Nat\n  status : Status\n  deriving BEq, ToJson, FromJson\n\n/-- Missing, invalid, or future receipt times cannot become recent. Zero TTL\nexpires immediately. Callers may supply an applicable provider interval. -/\ndef assess (now received : Option Nat) (interval : Nat := monthMs) : Assessment :=\n  let status := match now, received with\n    | some now, some received =>\n      if now = 0 ∨ received = 0 then .unknown\n      else if now < received then .clockSkew\n      else if now - received < interval then .recent else .expired\n    | _, _ => .unknown\n  ⟨received, now, interval, status⟩\n\ntheorem recent_is_within_interval (now received interval : Nat)\n    (recent : (assess (some now) (some received) interval).status = .recent) :\n    received ≤ now ∧ now - received < interval := by\n  simp only [assess] at recent\n  split at recent <;> try contradiction\n  split at recent <;> try contradiction\n  split at recent <;> simp_all <;> omega\n\ntheorem expired_is_at_least_interval (now received interval : Nat)\n    (expired : (assess (some now) (some received) interval).status = .expired) :\n    received ≤ now ∧ interval ≤ now - received := by\n  simp only [assess] at expired\n  split at expired <;> try contradiction\n  split at expired <;> try contradiction\n  split at expired <;> simp_all <;> omega\n\ntheorem missing_receipt_is_unknown (now : Option Nat) (interval : Nat) :\n    (assess now none interval).status = .unknown := by cases now <;> rfl\n\ntheorem assessment_preserves_receipt (now received : Option Nat) (interval : Nat) :\n    (assess now received interval).receivedUnixMs = received := rfl\n\n/-- Read the wall clock at ingress. Warm/replay must never call this to fill\nan absent receipt time on an old observation. -/\ndef now : IO (Option Nat) := do\n  try\n    let millis := (← Std.Time.Timestamp.now).toMillisecondsSinceUnixEpoch.val\n    return if millis > 0 then some millis.toNat else none\n  catch _ => return none\n\nend Eggshell.ObservationAge\n"],["ContentCapture.lean","module\npublic import Eggshell.ObservedRecords\npublic import tools.ContentCorrespondence\n@[expose] public section\n\nnamespace Eggshell.ContentCapture\nopen Lean Synapses Synapses.Extraction\nopen ContentCorrespondence\n\n/-- Literal coordinates supplement the original record. They are not an\nexecution certificate, a closed dependency set, or a reason to union Work. -/\nstructure Alias where\n  file : Synapses.File\n  line : Nat\n  spelling : Synapses.ObservedRecords.Spelling\n  chars : Nat\n  first : Nat\n  limit : Nat\n  deriving Repr, BEq, ToJson, FromJson\n\nstructure Captured where\n  implementation : String\n  /-- Export only files referenced by accepted matches. Unmatched argument\n  files and failed scans remain in the private pre-call capture. -/\n  inputs : Array SourceEvidence.File\n  complete : Bool\n  aliases : Array Alias\n  failure : Option String := none\n  deriving Repr, ToJson, FromJson\n\ndef implementation : String := Blake3.hex (Blake3.digest \"eggshell.content-capture\".toUTF8 [\n  (include_str \"ContentCapture.lean\").toUTF8,\n  (include_str \"ContentMetadata.lean\").toUTF8,(include_str \"SourceEvidence.lean\").toUTF8,\n  (include_str \"FileSystem.lean\").toUTF8,\n  (include_str \"../tools/ContentCorrespondence.lean\").toUTF8,\n  Synapses.ObservedRecords.implementation.toUTF8])\n\nstructure Output where\n  spelling : Synapses.ObservedRecords.Spelling\n  text : String\n\n/-- Index actual data projections, never a command or provider name. Base\npartitions remain in ObservedRecords even if no file correspondence exists. -/\ndef outputs (raw : String) : Array Output := Id.run do\n  let characters := raw.toList.toArray\n  let mut result := #[]\n  let mut seen : Std.HashSet (Nat × Nat × Synapses.ObservedRecords.Projection) := {}\n  for record in Synapses.ObservedRecords.normalize raw do\n    for spelling in record.spellings do\n      unless [Synapses.ObservedRecords.Projection.rawLine,.stringBodyLine,.string].contains spelling.projection do continue\n      let key := (spelling.first,spelling.limit,spelling.projection)\n      if seen.contains key then continue\n      seen := seen.insert key\n      let some text := Synapses.ObservedRecords.project characters spelling | continue\n      unless !text.isEmpty && !text.contains '\\n' do continue\n      result := result.push ⟨spelling,text⟩\n  return result\n\nstructure Trie where\n  outputs : Array Output\n  characters : Array (Array Char)\n  edges : Std.HashMap (Nat × Char) Nat := {}\n  -- Each node is a suffix of one immutable output projection. No input\n  -- text or unbounded posting list is retained during the file scan.\n  nodes : Array (Nat × Nat) := #[(0,0)]\n\ndef Trie.prepare (rows : Array Output) : Trie := Id.run do\n  let mut trie : Trie := {outputs := rows,characters := rows.map (fun row => row.text.toList.toArray)}\n  for row in [:rows.size] do\n    let some output := rows[row]? | continue\n    let mut node := 0\n    let mut depth := 0\n    for char in output.text.toList.reverse do\n      depth := depth+1\n      match trie.edges[(node,char)]? with\n      | some next => node := next\n      | none =>\n        let next := trie.nodes.size\n        trie := {trie with\n          edges := trie.edges.insert (node,char) next\n          nodes := trie.nodes.push (row,depth)}\n        node := next\n  return trie\n\ndef suffix (text : String) (chars : Nat) : String :=\n  String.ofList (text.toList.drop (text.length-chars))\n\ndef Trie.key? (trie : Trie) (node : Nat) : Option String := do\n  let (row,depth) ← trie.nodes[node]?\n  let characters ← trie.characters[row]?\n  if depth == 0 || characters.size < depth then none else\n    some (String.ofList (characters.extract (characters.size-depth) characters.size).toList)\n\ndef Trie.find? (trie : Trie) (text : String) : Option Nat := do\n  if text.isEmpty then none else do\n    let node ← text.toList.reverse.foldlM (fun node char => trie.edges[(node,char)]?) 0\n    if trie.key? node == some text then some node else none\n\nabbrev State := Array Candidate\n\ndef Trie.start (trie : Trie) : State := Array.replicate trie.nodes.size .absent\n\ndef Trie.observe (trie : Trie) (state : State) (position : Position) (text : String) : State :=\n  match trie.find? text with\n  | none => state\n  | some node => state.modify node (fun previous => previous.join (.one position))\n\ntheorem Trie.observe_size (trie : Trie) (state : State) (position : Position) (text : String) :\n    (trie.observe state position text).size = state.size := by\n  simp only [observe]\n  split <;> simp\n\ntheorem Trie.find_checked (trie : Trie) (text : String) (node : Nat)\n    (found : trie.find? text = some node) : trie.key? node = some text := by\n  cases vacant : text.isEmpty with\n  | true => simp [find?,vacant] at found\n  | false =>\n    cases traced : text.toList.reverse.foldlM (fun node char => trie.edges[(node,char)]?) 0 with\n    | none => simp [find?,vacant,traced] at found\n    | some selected =>\n      simp [find?,vacant,traced] at found\n      simpa [found.2] using found.1\n\ndef Trie.selected? (trie : Trie) (state : State) (output : Output) : Option (Position × Nat) := Id.run do\n  let mut node := 0\n  let mut depth := 0\n  let characters := output.text.toList.toArray\n  let mut found : Option (Candidate × Nat) := none\n  for char in output.text.toList.reverse do\n    let some next := trie.edges[(node,char)]? | break\n    node := next\n    depth := depth+1\n    let candidate := state[node]?.getD .absent\n    let expected := fun _ => String.ofList (characters.extract (characters.size-depth) characters.size).toList\n    if candidate != .absent && trie.key? node == some (expected ()) then\n      found := some (candidate,depth)\n  match found with\n  | some (.one position,count) => return some (position,count)\n  | _ => return none\n\ndef escapedWidth (text : String) : Nat := (toJson text).compress.length-2\n\ndef alias? (inputs : Array SourceEvidence.File) (characters : Array Char) (output : Output)\n    (position : Position) (chars : Nat) : Option Alias := do\n  let file ← inputs[position.1]?\n  let content ← file.content\n  if chars == 0 || output.text.length < chars || position.2 == 0 then none else do\n    let code := suffix output.text chars\n    let preceding := String.ofList (output.text.toList.take (output.text.length-chars))\n    let encoded := match output.spelling.projection with\n      | .string | .stringBody | .stringBodyLine => true\n      | _ => false\n    let base := output.spelling.first + if output.spelling.projection == .string then 1 else 0\n    let first := base + if encoded then escapedWidth preceding else preceding.length\n    let limit := first + if encoded then escapedWidth code else code.length\n    let literal := String.ofList (characters.extract first limit).toList\n    let expected := if encoded then String.ofList ((toJson code).compress.toList.drop 1 |>.dropLast) else code\n    if first < limit && limit ≤ output.spelling.limit && literal == expected then\n      some ⟨⟨file.relative,content.root,content.bytes⟩,position.2,output.spelling,chars,first,limit⟩\n    else none\n\n/-- JSON leaves and a general literal lexer supply path hints. The executable\nname is not a discriminator. Only regular files inside the workspace survive;\nthese hints never establish complete execution dependencies. -/\npartial def inputStrings : Json → Array String\n  | .str value => #[value]\n  | .arr values => values.flatMap inputStrings\n  | .obj values => values.toArray.flatMap (inputStrings ∘ Prod.snd)\n  | _ => #[]\n\ndef candidates (workspace : System.FilePath) (input : Json) : Array SourceEvidence.Relative := Id.run do\n  let some directory := SourceEvidence.inputDirectory? workspace input | return #[]\n  let mut result := #[]\n  let mut seen : Std.HashSet String := {}\n  for value in inputStrings input do\n    for word in #[value] ++ ((shellWords value).toOption.getD #[]) do\n      if word.contains \"://\" then continue\n      let some relative := SourceEvidence.relative? workspace directory word | continue\n      if seen.contains relative.text then continue\n      seen := seen.insert relative.text\n      result := result.push relative\n  return result\n\ndef captureInputs (workspace : System.FilePath) (input : Json)\n    (known : Option SourceEvidence.Capture) (deadline : Nat) : IO SourceEvidence.Capture := do\n  let mut probes := []\n  for relative in candidates workspace input do\n    if (← IO.monoMsNow) ≥ deadline then return SourceEvidence.unknown workspace\n    let path := workspace / relative.text\n    try\n      FileSystem.rejectSymlinkAncestors path\n      if (← FileSystem.regularMetadata? path).isNone then continue\n      unless probes.length < 256 do return SourceEvidence.unknown workspace\n      let previous := known.bind fun captured => captured.probes.find? (·.file.relative == relative.text)\n      let some observed ← match previous with\n          | some probe => pure (some probe)\n          | none => SourceEvidence.probe workspace relative deadline\n        | return SourceEvidence.unknown workspace\n      probes := probes ++ [observed]\n    catch _ => return SourceEvidence.unknown workspace\n  let record : SourceEvidence.Record := ⟨workspace.fileName.getD workspace.toString,\n    probes.map (·.file),[],true,false⟩\n  return ⟨record,probes⟩\n\n/-- The same held descriptor supplies fingerprint pages and line records.\nUniqueness is accepted only after every named input reaches stable EOF with\nits pre-call content fingerprint. Long irrelevant lines allocate no buffer. -/\ndef scan (workspace : System.FilePath) (file : SourceEvidence.File) (fileIndex : Nat)\n    (trie : Trie) (initial : State) (deadline : Nat) : IO (Option State) := do\n  let some expected := file.content | return none\n  let some relative := SourceEvidence.Relative.check? file.relative | return none\n  let path := workspace / relative.text\n  FileSystem.rejectSymlinkAncestors path\n  let handle ← FileSystem.openRead path.toString\n  let before ← FileSystem.readVersion handle\n  unless before.bytes == expected.bytes do return none\n  let maxLine := trie.outputs.foldl (fun size row => max size row.text.utf8ByteSize) 0\n  let mut root : SourceEvidence.Root :=\n    ⟨Blake3.digest \"eggshell.source.file\".toUTF8 [Blake3.u64le before.bytes],Blake3.hashSegments_size _⟩\n  let mut offset := 0\n  let mut line := 1\n  let mut pending := ByteArray.empty\n  let mut omitted := false\n  let mut state := initial\n  while offset < before.bytes do\n    if (← IO.monoMsNow) ≥ deadline then return none\n    let count := min 4096 (before.bytes-offset)\n    let page ← FileSystem.readPage handle offset.toUInt64 ⟨count,Nat.min_le_left _ _⟩\n    unless page.size == count do return none\n    root := SourceEvidence.stepRoot root page\n    offset := offset+count\n    for byte in page do\n      if byte == 10 then\n        if !omitted then\n          if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text\n        pending := ByteArray.empty\n        omitted := false\n        line := line+1\n      else if !omitted then\n        if pending.size < maxLine then pending := pending.push byte\n        else pending := ByteArray.empty; omitted := true\n  if !pending.isEmpty && !omitted then\n    if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text\n  let after ← FileSystem.readVersion handle\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\n  unless (← IO.monoMsNow) < deadline && FileSystem.stableRead before after current offset &&\n      Blake3.hex root.val == expected.root do return none\n  return some state\n\ndef finish (workspace : System.FilePath) (captured : SourceEvidence.Capture)\n    (raw : String) (deadline : Nat) : IO Captured := do\n  let inputs := captured.record.files.toArray\n  let failed := fun reason => ({implementation,inputs := #[],complete := false,aliases := #[],failure := some reason} : Captured)\n  unless captured.record.valid && captured.record.files == captured.probes.map (·.file) do\n    return failed \"input-not-captured\"\n  unless raw.utf8ByteSize ≤ 2*1024*1024 do return failed \"output-budget\"\n  let rows := outputs raw\n  let trie := Trie.prepare rows\n  let characters := raw.toList.toArray\n  let mut state := trie.start\n  for fileIndex in [:inputs.size] do\n    let some file := inputs[fileIndex]? | return failed \"input-domain\"\n    let result ← try scan workspace file fileIndex trie state deadline catch _ => pure none\n    let some next := result | return failed \"input-not-sealed\"\n    state := next\n  let aliases := rows.filterMap fun row => do\n    let (position,chars) ← trie.selected? state row\n    alias? inputs characters row position chars\n  let referenced := inputs.filter fun input => aliases.any fun alias =>\n    input.relative == alias.file.relative && input.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩\n  return ⟨implementation,referenced,true,aliases,none⟩\n\ndef code? (characters : Array Char) (alias : Alias) : Option String := do\n  let text ← Synapses.ObservedRecords.project characters alias.spelling\n  if alias.chars == 0 || alias.chars > text.length then none else do\n    let code := suffix text alias.chars\n    let reconstructed ← alias? #[⟨alias.file.relative,some ⟨alias.file.bytes,alias.file.fingerprint⟩⟩]\n      characters ⟨alias.spelling,text⟩ (0,alias.line) alias.chars\n    if reconstructed == alias then some code else none\n\nend Eggshell.ContentCapture\n"],["ContentMetadata.lean","module\npublic import Eggshell.ContentCapture\n@[expose] public section\n\nnamespace Eggshell.ContentMetadata\nopen Lean DB Synapses Synapses.Extraction Persistence.Store\n\nstructure Header where\n  database : String\n  owner : String\n  work : String\n  original : String\n  implementation : String\n  inputs : Array SourceEvidence.File\n  complete : Bool\n  failure : Option String\n  aliases : Nat\n  chunks : Array String\n  deriving ToJson, FromJson\n\ndef ownerKey (id : Nat) := \"memo:content-alias:owner:\" ++ toString id\ndef chunkKey (digest : String) := \"memo:content-alias:chunk:\" ++ digest\ndef chunkCount : Nat := 64\n\nstructure Line (raw : String) where\n  alias : ContentCapture.Alias\n  code : String\n  original : ContentCapture.code? raw.toList.toArray alias = some code\n  within : alias.first < alias.limit ∧ alias.limit ≤ raw.length\n\ndef line? (raw : String) (alias : ContentCapture.Alias) : Option (Line raw) := do\n  if within : alias.first < alias.limit ∧ alias.limit ≤ raw.length then\n    match original : ContentCapture.code? raw.toList.toArray alias with\n    | some code => some ⟨alias,code,original,within⟩\n    | none => none\n  else none\n\ntheorem Line.original_projection (line : Line raw) :\n    ContentCapture.code? raw.toList.toArray line.alias = some line.code := line.original\n\ntheorem Line.original_bounds (line : Line raw) :\n    line.alias.first < line.alias.limit ∧ line.alias.limit ≤ raw.length := line.within\n\ndef validAlias (inputs : Array SourceEvidence.File) (characters : Array Char)\n    (alias : ContentCapture.Alias) : Bool :=\n  alias.file.valid && 0 < alias.line && alias.first < alias.limit && alias.limit ≤ characters.size &&\n    (ContentCapture.code? characters alias).isSome && inputs.any (fun file =>\n      file.relative == alias.file.relative && file.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩)\n\n/-- Source metadata joins original bytes and portable origins in their one\nexisting transaction. No second writer, source reopen or derived repair. -/\ndef stage (writer : PageMap.Writer) (id : Nat) (doc : Document)\n    (captured : ContentCapture.Captured) : IO Bool := do\n  unless doc.native && captured.implementation == ContentCapture.implementation do\n    throw (IO.userError \"content correspondence is not from the selected native capture\")\n  let some raw := doc.source | throw (IO.userError \"content correspondence lost its original body\")\n  let characters := raw.toList.toArray\n  unless (captured.complete || captured.aliases.isEmpty) &&\n      captured.aliases.all (validAlias captured.inputs characters) do\n    throw (IO.userError \"invalid content correspondence projection\")\n  let mut chunks := #[]\n  let mut changed := false\n  for index in [: (captured.aliases.size+chunkCount-1)/chunkCount] do\n    let aliases := captured.aliases.extract (index*chunkCount) ((index+1)*chunkCount)\n    let bytes := (toJson aliases).compress.toUTF8\n    unless bytes.size ≤ 262144 do throw (IO.userError \"content correspondence block exceeds its bound\")\n    let digest := Sha256.hex bytes\n    if let some previous ← writer.get (chunkKey digest) then\n      unless previous == bytes do throw (IO.userError \"conflicting content correspondence block\")\n    else writer.put (chunkKey digest) (some bytes); changed := true\n    chunks := chunks.push digest\n  let pinned ← writer.snapshot\n  let header : Header := ⟨pinned.head.identity,doc.owner,doc.work,Sha256.hex raw.toUTF8,\n    captured.implementation,captured.inputs,captured.complete,captured.failure,captured.aliases.size,chunks⟩\n  let bytes := (toJson header).compress.toUTF8\n  unless bytes.size ≤ 262144 do throw (IO.userError \"content correspondence header exceeds its bound\")\n  if let some previous ← writer.get (ownerKey id) then\n    unless previous == bytes do throw (IO.userError \"content correspondence changed for an immutable native result\")\n  else writer.put (ownerKey id) (some bytes); changed := true\n  return changed\n\ndef load? (source : PageMap.Snapshot) (id : Nat) (doc : Document) : IO (Option ContentCapture.Captured) := do\n  let some bytes ← source.get (ownerKey id) | return none\n  let header ← ObservedRecords.decode (α := Header) bytes\n  if header.implementation != ContentCapture.implementation then return none\n  let some raw := doc.source | throw (IO.userError \"content metadata lost original native output\")\n  unless doc.native && header.database == source.head.identity && header.owner == doc.owner &&\n      header.work == doc.work && header.original == Sha256.hex raw.toUTF8 do\n    throw (IO.userError \"content correspondence belongs to another original\")\n  let mut aliases := #[]\n  for digest in header.chunks do\n    unless Synapses.digest digest do throw (IO.userError \"invalid content block address\")\n    let some bytes ← source.get (chunkKey digest) | throw (IO.userError \"missing content block\")\n    unless Sha256.hex bytes == digest do throw (IO.userError \"changed content block\")\n    let rows ← ObservedRecords.decode (α := Array ContentCapture.Alias) bytes\n    unless rows.size ≤ chunkCount do throw (IO.userError \"foreign content block extent\")\n    aliases := aliases ++ rows\n  let characters := raw.toList.toArray\n  unless aliases.size == header.aliases && (header.complete || aliases.isEmpty) &&\n      aliases.all (validAlias header.inputs characters) do\n    throw (IO.userError \"incomplete content correspondence directory\")\n  return some ⟨header.implementation,header.inputs,header.complete,aliases,header.failure⟩\n\ndef catalog (database : String) (doc : Document) (captured : ContentCapture.Captured) :\n    Except String ObservationContext.Catalog := do\n  let some raw := doc.source | throw \"missing original content body\"\n  let some occurrence := doc.occurrences[0]? | throw \"missing original occurrence\"\n  let characters := raw.toList.toArray\n  let mut result : ObservationContext.Catalog := {}\n  let quoteSource := QuotationContext.Source.make raw\n  for alias in captured.aliases do\n    let some code := ContentCapture.code? characters alias | throw \"content alias lost literal equality\"\n    let read : Read := {\n      occurrence,source := ⟨.file alias.file,alias.line,alias.line⟩\n      binding := ⟨database,doc.owner,doc.work,alias.first,alias.limit⟩\n      quotations := #[Quotes.digest code]}\n    unless read.valid do throw \"content alias has an invalid original binding\"\n    result := {\n      located := result.located.push ⟨read,#[⟨read.source,alias.first,alias.limit⟩],#[read],code⟩\n      quotations := result.quotations.push\n        (ObservationContext.Quotation.prepare quoteSource read alias.first alias.limit code)}\n  return result\n\nend Eggshell.ContentMetadata\n"],["../tools/ContentCorrespondence.lean","module\npublic import Std.Data.HashMap\npublic import Std.Data.HashSet.Lemmas\n@[expose] public section\n\n/- Content correspondence has no command, file-system, Work, Match or Union\ninput. A capture adapter must supply verified acquired input records and retain\ntheir identities. This module proves equality of content at actual positions;\nit does not turn a matching string into an execution or freshness certificate. -/\nnamespace ContentCorrespondence\n\nabbrev Inputs := Array (Array String)\nabbrev Position := Nat × Nat\nvariable {inputs : Inputs}\n\ndef positions (inputs : Inputs) : List Position :=\n  (List.finRange inputs.size).flatMap fun source =>\n    (List.finRange inputs[source].size).map fun row => (source.val,row.val)\n\ntheorem position_present (source : Fin inputs.size) (row : Fin inputs[source].size) :\n    (source.val,row.val) ∈ positions inputs := by\n  apply List.mem_flatMap.mpr\n  refine ⟨source,by simp,?_⟩\n  exact List.mem_map.mpr ⟨row,by simp,rfl⟩\n\ndef textAt (inputs : Inputs) (position : Position) : String :=\n  ((inputs[position.1]?).bind fun rows => rows[position.2]?).getD \"\"\n\n@[simp] theorem textAt_present (source : Fin inputs.size) (row : Fin inputs[source].size) :\n    textAt inputs (source.val,row.val) = inputs[source][row] := by\n  simp [textAt]\n\nstructure Correspondence (inputs : Inputs) (text : String) (position : Position) : Type where\n  sourceBound : position.1 < inputs.size\n  rowBound : position.2 < (inputs[position.1]'sourceBound).size\n  original : (inputs[position.1]'sourceBound)[position.2]'rowBound = text\n\ndef check? (inputs : Inputs) (text : String) (position : Position) :\n    Option (Correspondence inputs text position) :=\n  if sourceBound : position.1 < inputs.size then\n    if rowBound : position.2 < inputs[position.1].size then\n      if original : inputs[position.1][position.2] = text then\n        some ⟨sourceBound,rowBound,original⟩ else none\n    else none\n  else none\n\nabbrev Buckets := Std.HashMap String (Std.HashSet Position)\n\ndef bucket (buckets : Buckets) (text : String) : Std.HashSet Position :=\n  buckets[text]?.getD {}\n\n/-- The one-time completeness check permits safe absence/ambiguity decisions.\nHash collisions never suffice: the map key is the full original string. -/\ndef complete (inputs : Inputs) (buckets : Buckets) : Bool :=\n  (positions inputs).all fun position => (bucket buckets (textAt inputs position)).contains position\n\nstructure Index (inputs : Inputs) where\n  buckets : Buckets\n  complete : complete inputs buckets = true\n\ndef checkedIndex? (inputs : Inputs) (buckets : Buckets) : Option (Index inputs) :=\n  if checked : complete inputs buckets = true then some ⟨buckets,checked⟩ else none\n\ndef prepare? (inputs : Inputs) : Option (Index inputs) := Id.run do\n  let mut buckets : Buckets := {}\n  for position in positions inputs do\n    let text := textAt inputs position\n    buckets := buckets.insert text ((bucket buckets text).insert position)\n  return checkedIndex? inputs buckets\n\ntheorem Index.contains_original (index : Index inputs) (source : Fin inputs.size)\n    (row : Fin inputs[source].size) (text : String) (same : inputs[source][row] = text) :\n    (bucket index.buckets text).contains (source.val,row.val) = true := by\n  have present := List.all_eq_true.mp index.complete (source.val,row.val) (position_present source row)\n  simpa only [textAt_present,same] using present\n\nstructure Unique (index : Index inputs) (text : String) where\n  position : Position\n  correspondence : Correspondence inputs text position\n  only : (bucket index.buckets text).toList = [position]\n\ndef Index.unique? (index : Index inputs) (text : String) : Option (Unique index text) :=\n  match found : (bucket index.buckets text).toList with\n  | [position] => do\n      let correspondence ← check? inputs text position\n      some ⟨position,correspondence,found⟩\n  | _ => none\n\ntheorem Unique.only_original {index : Index inputs} {text : String}\n    (unique : Unique index text) (source : Fin inputs.size)\n    (row : Fin inputs[source].size) (same : inputs[source][row] = text) :\n    unique.position = (source.val,row.val) := by\n  have included := index.contains_original source row text same\n  have present : (source.val,row.val) ∈ (bucket index.buckets text).toList :=\n    Std.HashSet.mem_toList.mpr (Std.HashSet.mem_iff_contains.mpr included)\n  rw [unique.only] at present\n  exact (List.mem_singleton.mp present).symm\n\n/-- Neighboring records are accepted only through literal sequence equality.\nThe adapter may propose a run around a unique anchor, but cannot fill a gap\nfrom a path name, line-number hint or presumed tool operation. -/\nstructure Run (inputs : Inputs) (output : Array String)\n    (source first outputFirst count : Nat) : Type where\n  nonempty : 0 < count\n  sourceBound : source < inputs.size\n  sourceEnd : first+count ≤ (inputs[source]'sourceBound).size\n  outputEnd : outputFirst+count ≤ output.size\n  original : ∀ offset : Fin count,\n    (inputs[source]'sourceBound)[first+offset.val]'(by have := offset.isLt; omega) =\n      output[outputFirst+offset.val]'(by have := offset.isLt; omega)\n\ndef run? (inputs : Inputs) (output : Array String) (source first outputFirst count : Nat) :\n    Option (Run inputs output source first outputFirst count) :=\n  if nonempty : 0 < count then\n    if sourceBound : source < inputs.size then\n      if sourceEnd : first+count ≤ inputs[source].size then\n        if outputEnd : outputFirst+count ≤ output.size then\n          if original : (List.finRange count).all (fun offset =>\n              decide (inputs[source][first+offset.val]'(by have := offset.isLt; omega) =\n                output[outputFirst+offset.val]'(by have := offset.isLt; omega))) = true then\n            some ⟨nonempty,sourceBound,sourceEnd,outputEnd,by\n              intro offset\n              simpa only [decide_eq_true_eq] using\n                (List.all_eq_true.mp original offset (by simp))⟩\n          else none\n        else none\n      else none\n    else none\n  else none\n\nstructure AnchoredRun (index : Index inputs) (output : Array String) (anchorIndex : Fin output.size)\n    (anchor : Unique index output[anchorIndex]) (first count : Nat) : Type where\n  contains : first ≤ anchorIndex.val ∧ anchorIndex.val < first+count\n  preceding : anchorIndex.val-first ≤ anchor.position.2\n  original : Run inputs output anchor.position.1 (anchor.position.2-(anchorIndex.val-first)) first count\n\n/-- The source and its starting position come from a unique content anchor,\nnot a guessed path. Every neighboring output record is checked again. -/\ndef anchoredRun? (index : Index inputs) (output : Array String) (anchorIndex : Fin output.size)\n    (anchor : Unique index output[anchorIndex]) (first count : Nat) :\n    Option (AnchoredRun index output anchorIndex anchor first count) :=\n  if contains : first ≤ anchorIndex.val ∧ anchorIndex.val < first+count then\n    if preceding : anchorIndex.val-first ≤ anchor.position.2 then do\n      let original ← run? inputs output anchor.position.1 (anchor.position.2-(anchorIndex.val-first)) first count\n      some ⟨contains,preceding,original⟩\n    else none\n  else none\n\ntheorem AnchoredRun.anchor_preserved (run : AnchoredRun index output anchorIndex anchor first count) :\n    anchor.position.2-(anchorIndex.val-first)+(anchorIndex.val-first) = anchor.position.2 := by\n  have := run.preceding\n  omega\n\n/-- Capture needs only absence, one location, or proven ambiguity. It never\nstores an unbounded posting list for common records such as `}`. Replaying\nthe same immutable input position does not manufacture ambiguity. -/\ninductive Candidate where\n  | absent\n  | one (position : Position)\n  | ambiguous\n  deriving DecidableEq, BEq, Repr\n\ndef Candidate.join : Candidate → Candidate → Candidate\n  | .absent,right => right\n  | left,.absent => left\n  | .one left,.one right => if left = right then .one left else .ambiguous\n  | _,_ => .ambiguous\n\n@[simp] theorem Candidate.absent_join (candidate : Candidate) :\n    Candidate.absent.join candidate = candidate := rfl\n\n@[simp] theorem Candidate.join_absent (candidate : Candidate) :\n    candidate.join .absent = candidate := by cases candidate <;> rfl\n\n@[simp] theorem Candidate.ambiguous_join (candidate : Candidate) :\n    Candidate.ambiguous.join candidate = .ambiguous := by cases candidate <;> rfl\n\n@[simp] theorem Candidate.join_ambiguous (candidate : Candidate) :\n    candidate.join .ambiguous = .ambiguous := by cases candidate <;> rfl\n\ntheorem Candidate.join_idempotent (candidate : Candidate) :\n    candidate.join candidate = candidate := by\n  cases candidate <;> simp [join]\n\ntheorem Candidate.join_commutative (left right : Candidate) :\n    left.join right = right.join left := by\n  cases left <;> cases right <;>\n    try simp only [absent_join,join_absent,ambiguous_join,join_ambiguous]\n  rename_i a b\n  by_cases same : a = b\n  · subst b; simp [join]\n  · simp [join,same,Ne.symm same]\n\ntheorem Candidate.join_associative (left middle right : Candidate) :\n    (left.join middle).join right = left.join (middle.join right) := by\n  cases left <;> cases middle <;> cases right <;>\n    try simp only [absent_join,join_absent,ambiguous_join,join_ambiguous]\n  rename_i a b c\n  by_cases same : a = b\n  · subst b\n    by_cases next : a = c <;> simp [join,next]\n  · by_cases next : b = c\n    · subst c; simp [join,same]\n    · simp [join,same,next]\n\nabbrev StreamIndex := Std.HashMap String Candidate\n\ndef start (output : Array String) : StreamIndex :=\n  output.foldl (fun index text => index.insert text .absent) {}\n\n/-- Index the bounded observed output, then stream the acquired input once.\nUnwanted input records allocate no entry. The capture adapter must seal all\ninput fingerprints and EOF before treating a `.one` as final correspondence. -/\ndef observe (index : StreamIndex) (position : Position) (text : String) : StreamIndex :=\n  index.modify text (fun candidate => candidate.join (.one position))\n\ntheorem observe_size (index : StreamIndex) (position : Position) (text : String) :\n    (observe index position text).size = index.size := by\n  exact Std.HashMap.size_modify\n\ntheorem observe_keeps_domain (index : StreamIndex) (position : Position) (text query : String) :\n    (observe index position text).contains query = index.contains query := by\n  exact Std.HashMap.contains_modify\n\nend ContentCorrespondence\n"],["JsonScalars.lean","module\n\npublic import Lean.Data.Json.Parser\npublic import Lean.Data.Json.FromToJson\n\n@[expose] public section\n\nnamespace Eggshell.JsonScalars\nopen Lean\n\ninductive Segment where\n  | key (name : String)\n  | index (position : Nat)\n  deriving DecidableEq, BEq, ToJson, FromJson\n\ndef pathJson (path : List Segment) : Json :=\n  toJson (path.map fun part => match part with\n    | .key name => toJson name | .index position => toJson position)\n\ndef resolve (value : Json) : List Segment → Except String Json\n  | [] => .ok value\n  | .key name :: rest => do resolve (← value.getObjVal? name) rest\n  | .index position :: rest => do resolve (← value.getArrVal? position) rest\n\nstructure Scalar where\n  first : Nat\n  limit : Nat\n  literal : String\n  text : Option String\n  offsets : Array Nat\n  /-- Reversed paths share their ancestors instead of copying every prefix. -/\n  pathRev : List Segment\n  contextFirst : Nat\n\nstructure Frame where\n  object : Bool\n  pathRev : List Segment\n  next : Nat := 0\n  key : Option (String × Nat) := none\n\ndef place (frames : Array Frame) (first : Nat) :\n    Except String (List Segment × Nat × Array Frame) := do\n  let some frame := frames.back? | return ([],first,frames)\n  if frame.object then\n    let some (key,start) := frame.key | throw \"structured object has no pending key\"\n    return (.key key :: frame.pathRev,start,frames.pop.push {frame with key := none})\n  else\n    return (.index frame.next :: frame.pathRev,first,\n      frames.pop.push {frame with next := frame.next+1})\n\ndef primitive : Json → Bool\n  | .arr _ | .obj _ => false\n  | _ => true\n\ndef scalarLiteral (text : String) : Bool :=\n  (Json.parse text).toOption.any fun value => primitive value && value.compress == text\n\n/-- One canonical scan records literal coordinates, immediate member starts\nand shared ancestor paths. Keys provide context but never become witnesses. -/\ndef scan (json : Json) (raw : String) : Except String (Array Scalar) := do\n  unless json.compress == raw do throw \"noncanonical structured observation\"\n  let chars := raw.toList.toArray\n  let mut position := 0\n  let mut result := #[]\n  let mut frames : Array Frame := #[]\n  while position < chars.size do\n    let char := chars[position]!\n    if char == '{' || char == '[' then\n      let (path,_,next) ← place frames position\n      frames := next.push {object := char == '{',pathRev := path}\n      position := position+1\n    else if char == '}' || char == ']' then\n      frames := frames.pop\n      position := position+1\n    else if char.isWhitespace || \",:\".contains char then\n      position := position+1\n    else if char == '\"' then\n      let first := position\n      position := position+1\n      let mut escaped := false\n      let mut closed := false\n      while position < chars.size do\n        let char := chars[position]!\n        position := position+1\n        if escaped then escaped := false\n        else if char == '\\\\' then escaped := true\n        else if char == '\"' then closed := true; break\n      unless closed do throw \"unfinished structured string\"\n      let limit := position\n      let mut following := position\n      while following < chars.size && chars[following]!.isWhitespace do following := following+1\n      let literal := String.ofList (chars.extract first limit).toList\n      let text ← Json.parse literal >>= Json.getStr?\n      if chars[following]? == some ':' then\n        let some frame := frames.back? | throw \"structured key has no object\"\n        unless frame.object && frame.key.isNone do throw \"structured key outside an object\"\n        frames := frames.pop.push {frame with key := some (text,first)}\n        continue\n      let (path,contextFirst,next) ← place frames first\n      frames := next\n      let mut offsets := #[]\n      let mut original := first+1\n      for char in text.toList do\n        offsets := offsets.push original\n        original := original+(toJson (String.singleton char)).compress.length-2\n      offsets := offsets.push original\n      unless original+1 == limit do throw \"structured scalar coordinates differ\"\n      result := result.push ⟨first,limit,literal,some text,offsets,path,contextFirst⟩\n    else\n      let first := position\n      while position < chars.size && !chars[position]!.isWhitespace &&\n          !(\"{}[],:\".contains chars[position]!) do position := position+1\n      let literal := String.ofList (chars.extract first position).toList\n      unless scalarLiteral literal do throw \"invalid structured scalar\"\n      let (path,contextFirst,next) ← place frames first\n      frames := next\n      result := result.push ⟨first,position,literal,none,#[],path,contextFirst⟩\n  return result\n\ndef values (raw : String) : Except String (Array Scalar) := do scan (← Json.parse raw) raw\n\ndef Scalar.prefixExact (scalar : Scalar) (raw : Array Char) : Bool :=\n  match scalar.pathRev.head? with\n  | some (.key name) =>\n      String.ofList (raw.extract scalar.contextFirst scalar.first).toList ==\n        (toJson name).compress ++ \":\"\n  | _ => scalar.contextFirst == scalar.first\n\n/-- A displayed path is independently checked against the parsed original.\nIts member prefix and literal still refer to exact original characters. -/\nstructure Checked (root : Json) (raw : Array Char) where\n  scalar : Scalar\n  value : Json\n  resolved : resolve root scalar.pathRev.reverse = .ok value\n  primitive : primitive value = true\n  spelling : value.compress = scalar.literal\n  bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size\n  exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal\n  memberExact : scalar.prefixExact raw = true\n\ndef Checked.check? (root : Json) (raw : Array Char) (scalar : Scalar) : Option (Checked root raw) :=\n  match resolved : resolve root scalar.pathRev.reverse with\n  | .error _ => none\n  | .ok value =>\n    if primitive : JsonScalars.primitive value = true then\n      if spelling : value.compress = scalar.literal then\n        if bounds : scalar.contextFirst ≤ scalar.first ∧ scalar.first < scalar.limit ∧ scalar.limit ≤ raw.size then\n          if exact : String.ofList (raw.extract scalar.first scalar.limit).toList = scalar.literal then\n            if memberExact : scalar.prefixExact raw = true then\n              some ⟨scalar,value,resolved,primitive,spelling,bounds,exact,memberExact⟩ else none\n          else none\n        else none\n      else none\n    else none\n\nstructure Address (raw : String) where\n  root : Json\n  characters : Array Char\n  parsed : Json.parse raw = .ok root\n  charactersExact : characters = raw.toList.toArray\n  leaf : Checked root characters\n\ndef Address.path (address : Address raw) : List Segment := address.leaf.scalar.pathRev.reverse\n\ndef Address.label (address : Address raw) : String := (pathJson address.path).compress\n\ntheorem address_resolves (address : Address raw) :\n    Json.parse raw = .ok address.root ∧ resolve address.root address.path = .ok address.leaf.value :=\n  ⟨address.parsed,address.leaf.resolved⟩\n\ntheorem address_literal_is_original (address : Address raw) :\n    String.ofList (raw.toList.toArray.extract address.leaf.scalar.first address.leaf.scalar.limit).toList =\n      address.leaf.value.compress := by\n  rw [← address.charactersExact,address.leaf.spelling]\n  exact address.leaf.exact\n\nstructure Index (raw : String) where\n  root : Json\n  characters : Array Char\n  parsed : Json.parse raw = .ok root\n  charactersExact : characters = raw.toList.toArray\n  leaves : Array (Checked root characters)\n\ndef prepare? (raw : String) : Option (Index raw) := do\n  match parsed : Json.parse raw with\n  | .error _ => none\n  | .ok root =>\n    let scalars ← (scan root raw).toOption\n    let characters := raw.toList.toArray\n    let leaves ← scalars.mapM (Checked.check? root characters)\n    return ⟨root,characters,parsed,rfl,leaves⟩\n\n/-- Scalar limits are in original serialization order. Search once by the\nlast position; ancestors and field names do not require a linear leaf scan. -/\ndef Index.cover? (index : Index raw) (first limit : Nat) : Option (Address raw) := Id.run do\n  let mut lower := 0\n  let mut upper := index.leaves.size\n  while lower < upper do\n    let middle := (lower+upper)/2\n    let some leaf := index.leaves[middle]? | return none\n    if leaf.scalar.limit < limit then lower := middle+1 else upper := middle\n  let some leaf := index.leaves[lower]? | return none\n  if leaf.scalar.contextFirst ≤ first && first < limit && limit ≤ leaf.scalar.limit then\n    return some ⟨index.root,index.characters,index.parsed,index.charactersExact,leaf⟩\n  return none\n\ndef Index.witness? (index : Index raw) (first limit : Nat) : Option (Address raw) := do\n  let address ← index.cover? first limit\n  if address.leaf.scalar.first ≤ first then some address else none\n\nend Eggshell.JsonScalars\n"],["SynapseQuotes.lean","module\n\npublic import Eggshell.Sha256\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.Quotes\n\n/-- Only opaque keys of already stored source spellings enter the index. A\nkey selects candidates; the original spelling is checked again before use. -/\ndef digest (text : String) : String :=\n  Sha256.hex (\"eggshell.literal-quotation\\n\" ++ text).toUTF8\n\nstructure Quote (original : String) where\n  first : Nat\n  limit : Nat\n  text : String\n  within : first < limit ∧ limit ≤ original.length\n  exact : text = String.ofList (original.toList.toArray.extract first limit).toList\n\ntheorem quote_is_original (quote : Quote original) :\n    quote.text = String.ofList (original.toList.toArray.extract quote.first quote.limit).toList :=\n  quote.exact\n\n/-- Literal backtick spans only, with equally sized closing delimiters. No\nnormalization or semantic attribution is inferred from ordinary prose. The\ncursor never rewinds, including on unfinished or mismatched delimiters. -/\ndef extract (original : String) : Array (Quote original) := Id.run do\n  let chars := original.toList.toArray\n  let size := original.length\n  let mut position := 0\n  let mut result := #[]\n  while position < chars.size do\n    if chars[position]! != '`' then position := position+1; continue\n    let start := position\n    while position < chars.size && chars[position]! == '`' do position := position+1\n    let width := position-start\n    let first := position\n    while position < chars.size do\n      if chars[position]! != '`' then position := position+1; continue\n      let limit := position\n      while position < chars.size && chars[position]! == '`' do position := position+1\n      if position-limit != width then continue\n      if within : first < limit ∧ limit ≤ size then\n        result := result.push ⟨first,limit,String.ofList (chars.extract first limit).toList,within,rfl⟩\n      break\n  return result\n\nend Eggshell.Synapses.Quotes\n"],["ObservationContext.lean","module\n\npublic import Eggshell.SynapseSource\npublic import Eggshell.Sha256\npublic import Eggshell.SynapseQuotes\npublic import tools.LiteralSearch\npublic import Eggshell.QuotationContext\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.ObservationContext\nopen Lean Extraction\n\n/-- Plain text keeps its actual row. Structured data uses checked scalar\nmembers and ancestor paths, rather than copying the enclosing object. -/\ndef lineBounds (lines : Array TextLine) (first limit : Nat) : Nat × Nat := Id.run do\n  let mut lower := 0\n  let mut upper := lines.size\n  while lower < upper do\n    let middle := (lower+upper)/2\n    let some line := lines[middle]? | return (first,limit)\n    if line.limit < limit then lower := middle+1 else upper := middle\n  match lines[lower]? with\n  | some line => if line.first ≤ first && limit ≤ line.limit then (line.first,line.limit) else (first,limit)\n  | none => (first,limit)\n\ndef originalSubject (work raw : String) : Original := ⟨work,Sha256.hex raw.toUTF8,raw.length⟩\n\n/-- The original identity requires hashing once, not JSON/command parsing.\nThe same pinned native observation can then bind any valid stored interval. -/\nstructure OriginalOwner (doc : Document) where\n  raw : String\n  original : doc.source = some raw\n  identity : Original\n  identityExact : identity = originalSubject doc.work raw\n  native : doc.native = true\n\ndef OriginalOwner.prepare? (doc : Document) : Option (OriginalOwner doc) := do\n  let raw ← doc.source\n  if original : doc.source = some raw then\n    if native : doc.native = true then some ⟨raw,original,originalSubject doc.work raw,rfl,native⟩ else none\n  else none\n\nstructure OriginalOwner.Bound (owner : OriginalOwner doc) (database : String) (source : Range) where\n  read : Read\n  valid : read.valid = true\n  sourceExact : read.source = source\n  databaseExact : read.binding.database = database\n  ownerExact : read.binding.owner = doc.owner\n  workExact : read.binding.work = doc.work\n  nativeOrigin : doc.occurrences.contains read.occurrence = true\n  sourceIdentity : source.subject = .original owner.identity\n  withinOriginal : read.binding.limit ≤ owner.raw.length\n  firstExact : read.binding.first = source.first-1\n  limitExact : read.binding.limit = source.last\n\ndef OriginalOwner.bind (owner : OriginalOwner doc) (database : String) (source : Range) :\n    Array (owner.Bound database source) := Id.run do\n  if sourceIdentity : source.subject = .original owner.identity then\n    if sourceValid : source.valid = true then\n      have inBounds : source.last ≤ owner.raw.length := by\n        have checked := sourceValid\n        simp only [Range.valid,sourceIdentity,Bool.and_eq_true,decide_eq_true_eq] at checked\n        simpa [owner.identityExact,originalSubject] using checked.2\n      let mut result := #[]\n      for occurrence in doc.occurrences do\n        let read : Read := ⟨occurrence,source,⟨database,doc.owner,doc.work,source.first-1,source.last⟩,#[]⟩\n        if valid : read.valid = true then\n          if origin : doc.occurrences.contains occurrence = true then\n            result := result.push ⟨read,valid,rfl,rfl,rfl,rfl,origin,sourceIdentity,inBounds,rfl,rfl⟩\n      return result\n    else return #[]\n  else return #[]\n\ntheorem OriginalOwner.Bound.same_native_owner {doc : Document} {owner : OriginalOwner doc}\n    {database : String} {source : Range} (bound : owner.Bound database source) :\n    bound.read.binding.owner = doc.owner ∧ bound.read.binding.work = doc.work ∧\n      doc.occurrences.contains bound.read.occurrence = true :=\n  ⟨bound.ownerExact,bound.workExact,bound.nativeOrigin⟩\n\ntheorem OriginalOwner.Bound.same_requested_range {doc : Document} {owner : OriginalOwner doc}\n    {database : String} {source : Range} (bound : owner.Bound database source) :\n    bound.read.source = source ∧ bound.read.binding.first = source.first-1 ∧\n      bound.read.binding.limit = source.last := ⟨bound.sourceExact,bound.firstExact,bound.limitExact⟩\n\nstructure Prepared (doc : Document) where\n  raw : String\n  original : doc.source = some raw\n  view : Layout\n  mapped : layout raw = .ok view\n  rawChars : Array Char\n  rawCharsExact : rawChars = raw.toList.toArray\n  viewChars : Array Char\n  viewCharsExact : viewChars = view.text.toList.toArray\n  lines : Array TextLine\n  identity : Original\n  identityExact : identity = originalSubject doc.work raw\n  json : Option (JsonScalars.Index raw)\n\ndef prepare? (doc : Document) : Option (Prepared doc) := do\n  let raw ← doc.source\n  if original : doc.source = some raw then\n    match mapped : layout raw with\n    | .error _ => none\n    | .ok view => some ⟨raw,original,view,mapped,raw.toList.toArray,rfl,\n        view.text.toList.toArray,rfl,textLines view.text,originalSubject doc.work raw,rfl,JsonScalars.prepare? raw⟩\n  else none\n\ndef Prepared.rawBounds (prepared : Prepared doc) (edge : Consumption) :\n    Option (Nat × Nat × JsonScalars.Address prepared.raw) := do\n  let index ← prepared.json\n  let address ← index.witness? edge.outputFirst edge.outputLimit\n  let scalar := address.leaf.scalar\n  if edge.kind == .value then\n    if edge.outputFirst != scalar.first || edge.outputLimit != scalar.limit then none\n    else some (scalar.contextFirst,scalar.limit,address)\n  else if let some text := scalar.text then\n    if text.contains '\\n' then do\n      let first ← scalar.offsets.findIdx? (· == edge.outputFirst)\n      let limit ← scalar.offsets.findIdx? (· == edge.outputLimit)\n      let (first,limit) := lineBounds (textLines text) first limit\n      let first ← scalar.offsets[first]?\n      let limit ← scalar.offsets[limit]?\n      some (first,limit,address)\n    else some (scalar.contextFirst,scalar.limit,address)\n  else some (scalar.contextFirst,scalar.limit,address)\n\nstructure Fragment (doc : Document) where\n  occurrence : Occurrence\n  binding : Binding\n  raw : String\n  payload : String\n  address : Option (JsonScalars.Address raw)\n  native : doc.native = true\n  origin : doc.occurrences.contains occurrence = true\n  original : doc.source = some raw\n  owner : binding.owner = doc.owner\n  work : binding.work = doc.work\n  valid : binding.valid = true\n  within : binding.first < binding.limit ∧ binding.limit ≤ raw.length\n  exact : payload = String.ofList ((raw.toList.drop binding.first).take (binding.limit-binding.first))\n\n/-- Resolve only an actual producer and a literal saved output witness. Source\nfiles, shell syntax and line numbers are not prerequisites. -/\ndef Prepared.locate? (prepared : Prepared doc) (database : String) (edge : Consumption) : Option (Fragment doc) := do\n  if native : doc.native = true then\n    if origin : doc.occurrences.contains edge.producer = true then\n        let raw := prepared.raw\n        let view := if edge.outputFormat == .json then prepared.rawChars else prepared.viewChars\n        if !(literal view edge.outputFirst edge.outputLimit edge.term) then none else do\n          let (first,limit,address) ← if edge.outputFormat == .json then do\n              let (first,limit,address) ← prepared.rawBounds edge\n              if first ≤ edge.outputFirst && edge.outputLimit ≤ limit then some (first,limit,some address) else none\n            else do\n              let (first,limit) := lineBounds prepared.lines edge.outputFirst edge.outputLimit\n              if !(first ≤ edge.outputFirst && edge.outputLimit ≤ limit) then none else do\n                let first ← prepared.view.offsets[first]?\n                let limit ← prepared.view.offsets[limit]?\n                some (first,limit,prepared.json.bind (·.cover? first limit))\n          do\n            let binding : Binding := ⟨database,doc.owner,doc.work,first,limit⟩\n            if valid : binding.valid = true then\n              if bounded : binding.first < binding.limit ∧ binding.limit ≤ prepared.rawChars.size then\n                have size : prepared.rawChars.size = raw.length := by\n                  simp [prepared.rawCharsExact,raw,String.length_toList]\n                have within : binding.first < binding.limit ∧ binding.limit ≤ raw.length := by\n                  simpa only [size] using bounded\n                let payload := String.ofList (prepared.rawChars.extract binding.first binding.limit).toList\n                have exact : payload = String.ofList ((raw.toList.drop binding.first).take (binding.limit-binding.first)) := by\n                  simp [payload,prepared.rawCharsExact,raw]\n                some ⟨edge.producer,binding,raw,\n                  payload,address,native,origin,prepared.original,rfl,rfl,valid,within,exact⟩\n              else none\n            else none\n    else none\n  else none\n\ndef locate? (database : String) (doc : Document) (edge : Consumption) : Option (Fragment doc) := do\n  let prepared ← prepare? doc\n  prepared.locate? database edge\n\ntheorem fragment_is_original (fragment : Fragment doc) :\n    doc.source = some fragment.raw ∧\n    fragment.payload = String.ofList ((fragment.raw.toList.drop fragment.binding.first).take\n      (fragment.binding.limit-fragment.binding.first)) := ⟨fragment.original,fragment.exact⟩\n\ntheorem fragment_has_native_origin (fragment : Fragment doc) :\n    doc.native = true ∧ doc.occurrences.contains fragment.occurrence = true :=\n  ⟨fragment.native,fragment.origin⟩\n\n/-- Canonical data is independent of the occurrence that observed it. The\nactual origin remains in the binding and can never certify another Work. -/\ndef Fragment.read? (fragment : Fragment doc) : Option {read : Read // read.valid = true} :=\n  let source := Range.original (originalSubject fragment.binding.work fragment.raw)\n    fragment.binding.first fragment.binding.limit\n  let read : Read := {occurrence := fragment.occurrence,source,binding := fragment.binding}\n  if valid : read.valid = true then some ⟨read,valid⟩ else none\n\n/-- Resolve a stored canonical interval only against the same complete\nWork/output snapshot, then attach this observation's own native origin. -/\ndef Prepared.bindSource? (prepared : Prepared doc) (database : String) (source : Range) : Option Read := do\n  let .original original := source.subject | none\n  if !doc.native || original != prepared.identity || !source.valid then none else do\n    let occurrence ← doc.occurrences[0]?\n    let read : Read := {occurrence,source,binding := ⟨database,doc.owner,doc.work,source.first-1,source.last⟩}\n    if read.valid then some read else none\n\ndef bindSource? (database : String) (doc : Document) (source : Range) : Option Read := do\n  let prepared ← prepare? doc\n  prepared.bindSource? database source\n\n/-- Transient spellings are hydrated from the original owner. Only their\ndigests travel with a persisted Read; hash lookup alone never creates support. -/\nstructure Quotation where\n  read : Read\n  text : String\n  mapping : Option (Sigma fun source : QuotationContext.Source => QuotationContext.Projection source text) := none\n  anchor : Option (Nat × Nat) := none\n\ndef Prepared.quotationSource (prepared : Prepared doc) : QuotationContext.Source :=\n  ⟨prepared.raw,prepared.rawChars,prepared.rawCharsExact,prepared.identity.content,by\n    simpa [originalSubject] using congrArg Original.content prepared.identityExact⟩\n\ndef Quotation.prepare (source : QuotationContext.Source) (read : Read)\n    (first limit : Nat) (text : String) : Quotation :=\n  ⟨read,text,(QuotationContext.prepare? source first limit text).map (fun projection => ⟨source,projection⟩),none⟩\n\nstructure QuotationWitness (parent : Read) where\n  read : Read\n  first : Nat\n  limit : Nat\n  valid : read.valid = true\n  sourceWithin : parent.source.contains read.source = true\n  bindingWithin : parent.binding.first ≤ read.binding.first ∧ read.binding.limit ≤ parent.binding.limit\n  origin : read.occurrence = parent.occurrence ∧ read.binding.database = parent.binding.database ∧\n    read.binding.owner = parent.binding.owner ∧ read.binding.work = parent.binding.work\n\ndef Quotation.locate? (item : Quotation) (first limit : Nat) : Option (QuotationWitness item.read) := do\n  let ⟨source,projection⟩ ← item.mapping\n  let located ← projection.locate? first limit\n  let a := if projection.multiline then located.contextFirst else item.read.binding.first\n  let b := if projection.multiline then located.contextLimit else item.read.binding.limit\n  if !(a ≤ located.first && located.limit ≤ b && b ≤ source.characters.size) then none else do\n    let target ← match item.read.source.subject with\n      | .file _ => some item.read.source\n      | .original original =>\n        if original.content == source.fingerprint && original.chars == source.characters.size then\n          some (Range.original original a b) else none\n    let read : Read := {item.read with\n      source := target,binding := {item.read.binding with first := a,limit := b}\n      quotations := #[Quotes.digest (String.ofList (projection.characters.extract first limit).toList)]}\n    if valid : read.valid = true then\n      if inside : item.read.source.contains read.source = true then\n        if bounds : item.read.binding.first ≤ read.binding.first ∧ read.binding.limit ≤ item.read.binding.limit then\n          some ⟨read,located.first,located.limit,valid,inside,bounds,by exact ⟨rfl,rfl,rfl,rfl⟩⟩\n        else none\n      else none\n    else none\n\ntheorem quotation_witness_preserves_origin {read : Read} (witness : QuotationWitness read) :\n    witness.read.occurrence = read.occurrence ∧ witness.read.binding.database = read.binding.database ∧\n      witness.read.binding.owner = read.binding.owner ∧ witness.read.binding.work = read.binding.work := witness.origin\n\n/-- Scan the actual reachable record spellings for all of an answer's literal\nquotes together. A matching identifier may occur inside a row/member; it need\nnot equal the entire enclosing record. Duplicate aliases do not multiply a\nread's support. These are advisory citations, never execution certificates. -/\ndef quoteMatches (index : LiteralSearch.Index patterns) (spellings : Array Quotation) : Array Quotation := Id.run do\n  let mut seen : Std.HashMap (Occurrence × String × String × String × Nat × Nat × String) Nat := {}\n  let mut result := #[]\n  for item in spellings do\n    for hit in LiteralSearch.first index item.text do\n      let text := patterns[hit.pattern]\n      let witness := item.locate? hit.first hit.limit\n      let read := witness.map (·.read) |>.getD item.read\n      let anchor := witness.map (fun found => (found.first,found.limit))\n      let first := anchor.map Prod.fst |>.getD read.binding.first\n      let limit := anchor.map Prod.snd |>.getD read.binding.limit\n      let key := (read.occurrence,read.binding.database,read.binding.owner,read.binding.work,first,limit,text)\n      let next : Quotation := ⟨read,text,none,anchor⟩\n      if let some previous := seen[key]? then\n        let some prior := result[previous]? | continue\n        let width := read.binding.limit-read.binding.first\n        let oldWidth := prior.read.binding.limit-prior.read.binding.first\n        if width < oldWidth || (width == oldWidth && read.source.file?.isSome && prior.read.source.file?.isNone) then\n          result := result.set! previous next\n      else\n        seen := seen.insert key result.size\n        result := result.push next\n  return result\n\nstructure Catalog where\n  located : Array LocatedRead := #[]\n  quotations : Array Quotation := #[]\n\ndef Catalog.reads (catalog : Catalog) : Array Read := catalog.located.map (·.read)\n\n/-- Certified source rows have disjoint original intervals. Search their\nsorted limits once, instead of scanning the growing native catalog per row. -/\ndef fileCovers (rows : Array Read) (first limit : Nat) : Bool := Id.run do\n  let mut lower := 0\n  let mut upper := rows.size\n  while lower < upper do\n    let middle := (lower+upper)/2\n    let some row := rows[middle]? | return false\n    if row.binding.limit < limit then lower := middle+1 else upper := middle\n  return (rows[lower]?).any (fun row => row.binding.first ≤ first && limit ≤ row.binding.limit)\n\ndef Catalog.add (catalog : Catalog) (prepared : Prepared doc) (database : String)\n    (files : Array Read) (first limit : Nat) (spellings : Array String) : Catalog := Id.run do\n  if !doc.native || first ≥ limit || limit > prepared.rawChars.size then return catalog\n  -- Preserve an existing certified file row instead of giving it a second,\n  -- larger native identity. General data never requires such certification.\n  if fileCovers files first limit then return catalog\n  let some occurrence := doc.occurrences[0]? | return catalog\n  let spellings := spellings.filter (!·.isEmpty) |>.toList.eraseDups.toArray\n  let read : Read := {\n    occurrence,source := Range.original prepared.identity first limit\n    binding := ⟨database,doc.owner,doc.work,first,limit⟩\n    quotations := spellings.map Quotes.digest |>.toList.eraseDups.toArray}\n  if !read.valid then return catalog\n  let payload := String.ofList (prepared.rawChars.extract first limit).toList\n  return {\n    located := catalog.located.push ⟨read,#[⟨read.source,first,limit⟩],#[read],payload⟩\n    quotations := catalog.quotations ++ spellings.map (fun text =>\n      Quotation.prepare prepared.quotationSource read first limit text)}\n\n/-- Enumerate source members/rows once during indexing, independently of tool\nnames, command syntax and the presence of files. The immutable subject hash,\nJSON scan and character arrays are shared across all these spans. -/\ndef Prepared.catalog (prepared : Prepared doc) (database : String) : Catalog := Id.run do\n  let mut catalog : Catalog := {located := (recordedReads database doc).toOption.getD #[]}\n  let files := (catalog.located.flatMap (·.originalRows)).qsort (fun a b => a.binding.limit < b.binding.limit)\n  if let some index := prepared.json then\n    for leaf in index.leaves do\n      let scalar := leaf.scalar\n      let member := String.ofList (prepared.rawChars.extract scalar.contextFirst scalar.limit).toList\n      let aliases := #[scalar.literal,member] ++ scalar.text.toArray\n      catalog := catalog.add prepared database files scalar.contextFirst scalar.limit aliases\n      if let some text := scalar.text then\n        if text.contains '\\n' then\n          for line in textLines text do\n            let some first := scalar.offsets[line.first]? | continue\n            let some limit := scalar.offsets[line.limit]? | continue\n            let raw := String.ofList (prepared.rawChars.extract first limit).toList\n            catalog := catalog.add prepared database files first limit #[line.text,raw]\n    if index.leaves.isEmpty then\n      catalog := catalog.add prepared database files 0 prepared.rawChars.size #[prepared.raw]\n  else\n    for line in textLines prepared.raw do\n      let payload := String.ofList (prepared.rawChars.extract line.first line.limit).toList\n      catalog := catalog.add prepared database files line.first line.limit #[line.text,payload]\n  return catalog\n\ndef recorded (database : String) (doc : Document) : Option Catalog := do\n  return (← prepare? doc).catalog database\n\n/-- File certification remains optional. General rows are located only when\nthe actual completed call has the complete saved invocation and output. -/\ndef locateUsing (database : String) (doc : Document) (trace : Trace)\n    (catalog : Catalog) : Array LocatedRead := Id.run do\n  let mut result := (locateReads database doc trace).toOption.getD #[]\n  let some raw := doc.source | return result\n  let .ok (input,format) := invocationData (doc.workText.getD \"\") | return result\n  let native := catalog.located.filter (·.read.source.file?.isNone)\n  for occurrence in doc.occurrences do\n    let some started := trace.starts[occurrence]? | continue\n    if started.command != input || started.format != format || trace.finished[occurrence]? != some raw then continue\n    for located in native do\n      let read := {located.read with occurrence}\n      result := result.push {located with read,originalRows := #[read]}\n  return result\n\ndef locate (database : String) (doc : Document) (trace : Trace) : Array LocatedRead :=\n  locateUsing database doc trace ((recorded database doc).getD {})\n\n/-- Exact quoted spellings provide advisory support/coquotation. The caller\nrestricts the catalog to the answer's actual All-reachable source owners.\nThis records an observed citation, not the truth or causality of a claim. -/\ndef addQuotedAnswer (database : String) (doc : Document) (spellings : Array Quotation)\n    (graph : Graph) : Except String Graph := do\n  let decoded ← layout (doc.source.getD \"\")\n  let byText := spellings.foldl (fun (map : Std.HashMap String (Array Read)) item =>\n    map.insert item.text (map[item.text]?.getD #[] |>.push item.read)) {}\n  let mut graph := graph\n  let mut position := 0\n  for paragraph in decoded.text.splitOn \"\\n\\n\" do\n    let limit := position+paragraph.length\n    if position < limit then\n      let claim : Claim := ⟨database,doc.owner,decoded.offsets[position]!,decoded.offsets[limit]!⟩\n      for quote in Quotes.extract paragraph do\n        for read in byText[quote.text]?.getD #[] do\n          graph ← graph.insert (.read read)\n          let support ← Support.checked read read.source claim\n          graph ← graph.insert (.supports support)\n          graph ← graph.insert (.coquoted (.claim claim) read.source)\n          graph ← graph.insert (.coquoted (.answer database doc.owner) read.source)\n    position := limit+2\n  return graph\n\nend Eggshell.Synapses.ObservationContext\n"],["Sha256.lean","module\n\npublic import Eggshell.Blake3\n\n@[expose] public section\n\nnamespace Eggshell.Sha256\n\ndef constants : Array UInt32 := #[\n  0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\n  0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\n  0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\n  0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\n  0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\n  0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\n  0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\n  0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]\n\ndef rotate (x : UInt32) (n : UInt32) : UInt32 := (x >>> n) ||| (x <<< (32-n))\n\ndef compress (state : Array UInt32) (bytes : ByteArray) (offset : Nat) : Array UInt32 := Id.run do\n  let mut words := #[]\n  for i in [0:16] do\n    let p := offset + i*4\n    words := words.push ((bytes[p]!.toUInt32 <<< 24) ||| (bytes[p+1]!.toUInt32 <<< 16) |||\n      (bytes[p+2]!.toUInt32 <<< 8) ||| bytes[p+3]!.toUInt32)\n  for i in [16:64] do\n    let x := words[i-15]!\n    let y := words[i-2]!\n    words := words.push (words[i-16]! +\n      (rotate x 7 ^^^ rotate x 18 ^^^ (x >>> 3)) + words[i-7]! +\n      (rotate y 17 ^^^ rotate y 19 ^^^ (y >>> 10)))\n  let mut a := state[0]!\n  let mut b := state[1]!\n  let mut c := state[2]!\n  let mut d := state[3]!\n  let mut e := state[4]!\n  let mut f := state[5]!\n  let mut g := state[6]!\n  let mut h := state[7]!\n  for i in [0:64] do\n    let t1 := h + (rotate e 6 ^^^ rotate e 11 ^^^ rotate e 25) +\n      ((e &&& f) ^^^ (~~~e &&& g)) + constants[i]! + words[i]!\n    let t2 := (rotate a 2 ^^^ rotate a 13 ^^^ rotate a 22) +\n      ((a &&& b) ^^^ (a &&& c) ^^^ (b &&& c))\n    h := g; g := f; f := e; e := d + t1\n    d := c; c := b; b := a; a := t1 + t2\n  return (state.zip #[a,b,c,d,e,f,g,h]).map fun (x,y) => x+y\n\ndef digest (input : ByteArray) : ByteArray := Id.run do\n  let mut bytes := input.push 0x80\n  let padding := (64 - ((bytes.size + 8) % 64)) % 64\n  for _ in [0:padding] do bytes := bytes.push 0\n  let bits := input.size.toUInt64 * 8\n  for i in [0:8] do bytes := bytes.push ((bits >>> ((7-i)*8).toUInt64).toUInt8)\n  let mut state := Blake3.iv\n  for block in [0:bytes.size/64] do state := compress state bytes (block*64)\n  let mut result := ByteArray.empty\n  for word in state do\n    for i in [0:4] do result := result.push ((word >>> ((3-i)*8).toUInt32).toUInt8)\n  return result\n\ndef hex (bytes : ByteArray) : String := Blake3.hex (digest bytes)\n\nend Eggshell.Sha256\n"],["QuotationContext.lean","module\npublic import Eggshell.SynapseSource\npublic import Eggshell.Sha256\n@[expose] public section\n\nnamespace Eggshell.Synapses.QuotationContext\nopen Lean _root_.Eggshell.Synapses.Extraction\n\nstructure Source where\n  raw : String\n  characters : Array Char\n  exact : characters = raw.toList.toArray\n  fingerprint : String\n  fingerprintExact : fingerprint = Sha256.hex raw.toUTF8\n\ndef Source.make (raw : String) : Source := ⟨raw,raw.toList.toArray,rfl,Sha256.hex raw.toUTF8,rfl⟩\ndef Source.slice (source : Source) (first limit : Nat) : String :=\n  String.ofList (source.characters.extract first limit).toList\n\ntheorem Source.slice_exact (source : Source) (first limit : Nat) :\n    source.slice first limit = String.ofList (source.raw.toList.drop first |>.take (limit-first)) := by\n  simp [Source.slice,source.exact]\n\ndef encoded (text : String) : String :=\n  String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast)\n\nstructure Projection (source : Source) (text : String) where\n  characters : Array Char\n  exact : characters = text.toList.toArray\n  offsets : Array Nat\n  count : offsets.size = characters.size+1\n  lines : Array TextLine\n  multiline : Bool\n  first : Nat\n  limit : Nat\n\n/-- A projection is recognized by exact bytes, not by a tool/provider name.\nJSON member prefixes and a trimmed final newline remain in the containing\nrecord; the offset map refers only to this checked spelling. -/\ndef prepare? (source : Source) (first limit : Nat) (text : String) : Option (Projection source text) := do\n  if first ≥ limit || limit > source.characters.size then none else do\n    let raw := source.slice first limit\n    let (base,escaped) ←\n      if raw == text || raw == text ++ \"\\n\" then some (first,false)\n      else do\n        let quoted := (toJson text).compress\n        if raw == quoted then some (first+1,true)\n        else if raw == encoded text || raw == encoded (text ++ \"\\n\") then some (first,true)\n        else if raw.endsWith quoted then some (limit-quoted.length+1,true)\n        else if !text.isEmpty && raw.endsWith text then some (limit-text.length,false)\n        else none\n    let characters := text.toList.toArray\n    let mut offsets := #[base]\n    let mut position := base\n    for character in characters do\n      position := position + if escaped then (encoded (String.singleton character)).length else 1\n      offsets := offsets.push position\n    if position > limit || base < first then none else do\n      if count : offsets.size = characters.size+1 then\n        some ⟨characters,rfl,offsets,count,textLines text,text.contains '\\n',first,limit⟩\n      else none\n\nstructure Located (source : Source) (quote : String) where\n  first : Nat\n  limit : Nat\n  contextFirst : Nat\n  contextLimit : Nat\n  within : contextFirst ≤ first ∧ first < limit ∧ limit ≤ contextLimit ∧\n    contextLimit ≤ source.characters.size\n  literal : source.slice first limit = quote ∨ source.slice first limit = encoded quote\n\n/-- The enclosing logical rows are already prepared. A multiline quote\nkeeps every intervening row; this is independent of source language. -/\ndef row? (lines : Array TextLine) (position : Nat) : Option TextLine := Id.run do\n  let mut lower := 0\n  let mut upper := lines.size\n  while lower < upper do\n    let middle := lower+(upper-lower)/2\n    if (lines[middle]?).any (fun line => line.limit ≤ position) then lower := middle+1\n    else upper := middle\n  return (lines[lower]?).filter fun line => line.first ≤ position && position < line.limit\n\ndef Projection.locate? (projection : Projection source text) (first limit : Nat) :\n    Option (Located source (String.ofList (projection.characters.extract first limit).toList)) := do\n  if first ≥ limit || limit > projection.characters.size then none else do\n    let a ← projection.offsets[first]?\n    let b ← projection.offsets[limit]?\n    let (c,d) ← if projection.multiline then do\n        let start ← row? projection.lines first\n        let stop ← row? projection.lines (limit-1)\n        some (← projection.offsets[start.first]?,← projection.offsets[stop.limit]?)\n      else some (projection.first,projection.limit)\n    let quote := String.ofList (projection.characters.extract first limit).toList\n    if within : c ≤ a ∧ a < b ∧ b ≤ d ∧ d ≤ source.characters.size then\n      if literal : source.slice a b = quote ∨ source.slice a b = encoded quote then\n        some ⟨a,b,c,d,within,literal⟩ else none\n    else none\n\ntheorem Located.literal_is_original {source : Source} {text : String} (located : Located source text) :\n    source.slice located.first located.limit = text ∨\n      source.slice located.first located.limit = encoded text := located.literal\n\ntheorem Located.context_contains_match {source : Source} {text : String} (located : Located source text) :\n    located.contextFirst ≤ located.first ∧ located.limit ≤ located.contextLimit :=\n  ⟨located.within.1,located.within.2.2.1⟩\n\nend Eggshell.Synapses.QuotationContext\n"],["ObservedRecords.lean","module\npublic import Eggshell.GraphStore\npublic import Eggshell.ObservationContext\n@[expose] public section\n\nnamespace Eggshell.Synapses.ObservedRecords\nopen Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction\n\n/-- These describe literal representations, not tools or source semantics. -/\ninductive Projection where\n  | raw | rawLine | string | stringBody | stringBodyLine\n  deriving Repr, DecidableEq, BEq, Hashable, ToJson, FromJson\n\nstructure Spelling where\n  first : Nat\n  limit : Nat\n  projection : Projection\n  deriving Repr, DecidableEq, BEq, Hashable\n\ninstance : ToJson Spelling where\n  toJson spelling := toJson (spelling.first,spelling.limit,spelling.projection)\ninstance : FromJson Spelling where\n  fromJson? json := do\n    let (first,limit,projection) ← fromJson? (α := Nat × Nat × Projection) json\n    return ⟨first,limit,projection⟩\n\nstructure Record where\n  first : Nat\n  limit : Nat\n  field : Option Nat := none\n  spellings : Array Spelling := #[]\n  deriving BEq, Inhabited\n\ninstance : ToJson Record where\n  toJson record := toJson (record.first,record.limit,record.field,record.spellings)\ninstance : FromJson Record where\n  fromJson? json := do\n    let (first,limit,field,spellings) ← fromJson? (α := Nat × Nat × Option Nat × Array Spelling) json\n    return ⟨first,limit,field,spellings⟩\n\ndef project (characters : Array Char) (spelling : Spelling) : Option String := do\n  if spelling.first ≥ spelling.limit || spelling.limit > characters.size then none else do\n    let raw := String.ofList (characters.extract spelling.first spelling.limit).toList\n    let line := fun text : String => if text.endsWith \"\\n\" then (text.dropEnd 1).copy else text\n    let body := do\n      let text ← (Json.parse (\"\\\"\" ++ raw ++ \"\\\"\") >>= Json.getStr?).toOption\n      if String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) == raw then some text else none\n    match spelling.projection with\n    | .raw => some raw\n    | .rawLine => some (line raw)\n    | .string => do\n        let text ← (Json.parse raw >>= Json.getStr?).toOption\n        if (toJson text).compress == raw then some text else none\n    | .stringBody => body\n    | .stringBodyLine => line <$> body\n\ndef chunkChars : Nat := 2048\n\n/-- The base partition always retains every original character. Detailed\nrecords add selectable structure; none can delete a base interval. -/\ndef base (size : Nat) : Array Record :=\n  (Array.range (size/chunkChars+1)).filterMap fun index =>\n    let first := index*chunkChars\n    let limit := min size (first+chunkChars)\n    if first < limit then some ⟨first,limit,none,#[]⟩ else none\n\ntheorem base_covers (size position : Nat) (inside : position < size) :\n    ∃ record ∈ base size, record.first ≤ position ∧ position < record.limit := by\n  let index := position/chunkChars\n  have quotient : index < size/chunkChars+1 := by\n    have := Nat.div_le_div_right (c := chunkChars) (Nat.le_of_lt inside)\n    dsimp [index] at *\n    omega\n  have positive : 0 < chunkChars := by decide\n  have divide := Nat.mod_add_div position chunkChars\n  rw [Nat.mul_comm chunkChars (position/chunkChars)] at divide\n  have remainder := Nat.mod_lt position positive\n  have lower : index*chunkChars ≤ position := by dsimp [index]; omega\n  have upper : position < index*chunkChars+chunkChars := by dsimp [index]; omega\n  let record : Record := ⟨index*chunkChars,min size (index*chunkChars+chunkChars),none,#[]⟩\n  have ordered : index*chunkChars < min size (index*chunkChars+chunkChars) := by omega\n  refine ⟨record,?_,by dsimp [record]; omega⟩\n  apply Array.mem_filterMap.mpr\n  refine ⟨index,by simpa using quotient,?_⟩\n  simp only [record,if_pos ordered]\n\ndef add (records : Array Record) (directory : Std.HashMap (Nat × Nat) Nat)\n    (record : Record) : Array Record × Std.HashMap (Nat × Nat) Nat :=\n  match directory[(record.first,record.limit)]? with\n  | none => (records.push record,directory.insert (record.first,record.limit) records.size)\n  | some index =>\n      (records.modify index fun old => {\n        old with\n        field := old.field.or record.field\n        spellings := hashDistinct (old.spellings.toList ++ record.spellings.toList) |>.toArray },directory)\n\n/-- Only the original data determines record layout. No shell/input parser,\nfile alias, current question, model or external workspace is consulted. -/\ndef normalize (raw : String) : Array Record := Id.run do\n  let characters := raw.toList.toArray\n  let mut records := base characters.size\n  let mut directory : Std.HashMap (Nat × Nat) Nat := {}\n  for index in [:records.size] do\n    directory := directory.insert (records[index]!.first,records[index]!.limit) index\n  if let some json := JsonScalars.prepare? raw then\n    for index in List.finRange json.leaves.size do\n      let scalar := json.leaves[index].scalar\n      let spellings := #[⟨scalar.contextFirst,scalar.limit,.raw⟩,\n        ⟨scalar.first,scalar.limit,.raw⟩] ++\n        (if scalar.text.isSome then #[⟨scalar.first,scalar.limit,.string⟩] else #[])\n      let next := add records directory ⟨scalar.contextFirst,scalar.limit,some index.val,spellings⟩\n      records := next.1; directory := next.2\n      if let some text := scalar.text then\n        if text.contains '\\n' then\n          for line in textLines text do\n            let some first := scalar.offsets[line.first]? | continue\n            let some limit := scalar.offsets[line.limit]? | continue\n            let next := add records directory ⟨first,limit,some index.val,\n              #[⟨first,limit,.raw⟩,⟨first,limit,.stringBodyLine⟩]⟩\n            records := next.1; directory := next.2\n  else\n    for line in textLines raw do\n      let next := add records directory ⟨line.first,line.limit,none,\n        #[⟨line.first,line.limit,.raw⟩,⟨line.first,line.limit,.rawLine⟩]⟩\n      records := next.1; directory := next.2\n  return records\n\nstructure Prepared (raw : String) where\n  records : Array Record\n\ndef prepare (raw : String) : Except String (Prepared raw) := do\n  let records := normalize raw\n  let characters := raw.toList.toArray\n  for record in records do\n    unless record.first < record.limit && record.limit ≤ characters.size do throw \"invalid original record\"\n    for spelling in record.spellings do\n      unless record.first ≤ spelling.first && spelling.limit ≤ record.limit do throw \"foreign spelling interval\"\n      match project characters spelling with\n      | some _ => pure ()\n      | none => throw \"spelling is not an original data projection\"\n  return ⟨records⟩\n\ndef implementation : String := Blake3.hex (Blake3.digest \"eggshell.observed-records\".toUTF8 [\n  (include_str \"ObservedRecords.lean\").toUTF8,(include_str \"JsonScalars.lean\").toUTF8,\n  (include_str \"SynapseSource.lean\").toUTF8])\n\nstructure Header where\n  database : String\n  owner : String\n  work : String\n  original : Original\n  implementation : String\n  records : Nat\n  chunks : Array String\n  deriving BEq, ToJson, FromJson\n\ndef keyPrefix := \"memo:observed-record:\"\ndef ownerKey (id : Nat) := keyPrefix ++ \"owner:\" ++ toString id\ndef chunkKey (digest : String) := keyPrefix ++ \"chunk:\" ++ digest\ndef chunkRecords : Nat := 64\n\ndef decode [ToJson α] [FromJson α] (bytes : ByteArray) : IO α := do\n  unless bytes.size ≤ 262144 do throw (IO.userError \"original record metadata exceeds its block bound\")\n  let some text := String.fromUTF8? bytes | throw (IO.userError \"invalid original metadata UTF-8\")\n  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))\n  unless (toJson value).compress.toUTF8 == bytes do throw (IO.userError \"noncanonical original metadata\")\n  return value\n\ndef stage (writer : PageMap.Writer) (id : Nat) (doc : Document) : IO Bool := do\n  unless doc.native do throw (IO.userError \"record publication requires its original native owner\")\n  let some raw := doc.source | throw (IO.userError \"native record publication lost its original body\")\n  let prepared ← IO.ofExcept (prepare raw)\n  let mut chunks := #[]\n  let mut changed := false\n  for index in [: (prepared.records.size+chunkRecords-1)/chunkRecords] do\n    let records := prepared.records.extract (index*chunkRecords) ((index+1)*chunkRecords)\n    let bytes := (toJson records).compress.toUTF8\n    unless bytes.size ≤ 262144 do throw (IO.userError \"original record block exceeds its byte bound\")\n    let digest := Sha256.hex bytes\n    let key := chunkKey digest\n    if let some old ← writer.get key then\n      unless old == bytes do throw (IO.userError \"conflicting original record block\")\n    else writer.put key (some bytes); changed := true\n    chunks := chunks.push digest\n  let pinned ← writer.snapshot\n  let header : Header := ⟨pinned.head.identity,doc.owner,doc.work,\n    ObservationContext.originalSubject doc.work raw,implementation,prepared.records.size,chunks⟩\n  let bytes := (toJson header).compress.toUTF8\n  unless bytes.size ≤ 262144 do throw (IO.userError \"original record directory exceeds its bound\")\n  if (← writer.get (ownerKey id)) != some bytes then\n    writer.put (ownerKey id) (some bytes)\n    changed := true\n  return changed\n\ndef catalog (database : String) (doc : Document) (records : Array Record) : Except String ObservationContext.Catalog := do\n  let some raw := doc.source | throw \"missing native record body\"\n  let characters := raw.toList.toArray\n  let some occurrence := doc.occurrences[0]? | throw \"missing original record occurrence\"\n  let original := ObservationContext.originalSubject doc.work raw\n  let quoteSource : QuotationContext.Source := ⟨raw,characters,rfl,original.content,rfl⟩\n  let mut result : ObservationContext.Catalog := {}\n  for record in records do\n    unless record.first < record.limit && record.limit ≤ characters.size do throw \"invalid original record interval\"\n    let texts ← record.spellings.mapM fun spelling => do\n      unless record.first ≤ spelling.first && spelling.limit ≤ record.limit do throw \"foreign original spelling\"\n      match project characters spelling with\n      | some text => pure text\n      | none => throw \"invalid original spelling projection\"\n    let texts := hashDistinct texts.toList |>.toArray\n    let read : Read := {\n      occurrence\n      source := Range.original original record.first record.limit\n      binding := ⟨database,doc.owner,doc.work,record.first,record.limit⟩\n      quotations := texts.filter (!·.isEmpty) |>.map Quotes.digest }\n    unless read.valid do throw \"invalid original record binding\"\n    let payload := String.ofList (characters.extract record.first record.limit).toList\n    result := {\n      located := result.located.push ⟨read,#[⟨read.source,record.first,record.limit⟩],#[read],payload⟩\n      quotations := result.quotations ++ record.spellings.filterMap (fun spelling => do\n        let text ← project characters spelling\n        if text.isEmpty then none else\n          some (ObservationContext.Quotation.prepare quoteSource read spelling.first spelling.limit text)) }\n  return result\n\n/-- One source-owned directory lookup; no source repair or external file read.\nAn old source may be normalized by explicit background preparation instead. -/\ndef load? (source : PageMap.Snapshot) (id : Nat) (doc : Document) : IO (Option ObservationContext.Catalog) := do\n  let some bytes ← source.get (ownerKey id) | return none\n  let header ← decode (α := Header) bytes\n  if header.implementation != implementation then return none\n  let some raw := doc.source | throw (IO.userError \"original record header lost its source\")\n  unless doc.native && header.database == source.head.identity && header.owner == doc.owner &&\n      header.work == doc.work && header.original == ObservationContext.originalSubject doc.work raw do\n    throw (IO.userError \"original record directory belongs to another observation\")\n  let mut records := #[]\n  for digest in header.chunks do\n    let some bytes ← source.get (chunkKey digest) | throw (IO.userError \"missing original record block\")\n    unless Sha256.hex bytes == digest do throw (IO.userError \"original record block digest mismatch\")\n    let block ← decode (α := Array Record) bytes\n    unless block.size ≤ chunkRecords do throw (IO.userError \"oversized original record block\")\n    records := records ++ block\n  unless records.size == header.records do throw (IO.userError \"original record directory count mismatch\")\n  let spans := records.foldl (fun known record => known.insert (record.first,record.limit)) ({} : Std.HashSet (Nat × Nat))\n  unless (base raw.length).all (fun record => spans.contains (record.first,record.limit)) do\n    throw (IO.userError \"original record domain omits its complete base partition\")\n  return some (← IO.ofExcept (catalog source.head.identity doc records))\n\ntheorem metadata_preserves_authority (before : String → Option ByteArray) (id : Nat)\n    (bytes : ByteArray) (key : String) (outside : PageMap.derivedKey key = false) :\n    PageMap.applyRows [(ownerKey id,some bytes)] before key = before key := by\n  apply PageMap.derived_rows_preserve _ _ _ key outside\n  simp [ownerKey,keyPrefix,PageMap.derivedKey]\n\ntheorem block_preserves_authority (before : String → Option ByteArray) (digest : String)\n    (bytes : ByteArray) (key : String) (outside : PageMap.derivedKey key = false) :\n    PageMap.applyRows [(chunkKey digest,some bytes)] before key = before key := by\n  apply PageMap.derived_rows_preserve _ _ _ key outside\n  simp [chunkKey,keyPrefix,PageMap.derivedKey]\n\nend Eggshell.Synapses.ObservedRecords\n"],["ObservedRecordView.lean","module\npublic import Eggshell.ObservedRecords\npublic import Eggshell.OriginalStructure\npublic import Std.Sync.Mutex\n@[expose] public section\n\nnamespace Eggshell.Synapses.ObservedRecordView\nopen Lean DB _root_.Eggshell.Synapses.Extraction\n\n/-- Query-free structure from the original observation catalogue. File aliases\nand command syntax are not prerequisites for retaining any original byte. -/\nabbrev Span := Plugin.OriginalStructure.Span\n\nstructure Header where\n  database : String\n  owner : String\n  work : String\n  original : Original\n  occurrences : Array Occurrence\n  characters : Nat\n  blocks : Nat\n  recipes : Nat\n  deriving BEq, ToJson, FromJson\n\nstructure Geometry where\n  header : Header\n  spans : Array Span\n  deriving ToJson, FromJson\n\nstructure View where\n  header : Header\n  spans : Array Span\n  blocks : Array String\n  deriving ToJson, FromJson\n\nstructure Block where\n  text : String\n  spans : Array Span\n  deriving ToJson, FromJson\n\ndef ownerKey (owner : String) := \"observed-view:owner:\" ++ owner\ndef blockKey (digest : String) := \"observed-view:block:\" ++ digest\ndef blockRef (owner : String) (index : Nat) := \"observed-view:ref:\" ++ owner ++ \":\" ++ toString index\ndef blockChars := ObservedRecords.chunkChars\ndef recipeSize := 128\ndef recipeKey (digest : String) := \"observed-view:recipe:\" ++ digest\ndef recipeRef (owner : String) (index : Nat) := \"observed-view:recipe-ref:\" ++ owner ++ \":\" ++ toString index\n\ndef make (database : String) (document : Document) : Except String View := do\n  unless document.native && !document.occurrences.isEmpty do throw \"missing original observation authority\"\n  let some raw := document.source | throw \"missing original observation body\"\n  let characters := raw.toList.toArray\n  let spans := Plugin.OriginalStructure.prepare raw\n  unless Plugin.OriginalStructure.complete characters.size spans do\n    throw \"original recipe domain omitted source positions\"\n  let blocks := (ObservedRecords.base characters.size).map fun record =>\n    String.ofList (characters.extract record.first record.limit).toList\n  return ⟨⟨database,document.owner,document.work,ObservationContext.originalSubject document.work raw,\n    document.occurrences,characters.size,blocks.size,spans.size⟩,spans,blocks⟩\n\n/-- The payload is copied exactly once into bounded content-addressed blocks.\nThe source publication, original digest and observation identities stay in\nthe directory, independently of payload sharing. -/\ndef stage (writer : PageMap.Writer) (database : String) (document : Document) : IO Unit := do\n  let view ← IO.ofExcept (make database document)\n  for index in [:view.blocks.size] do\n    let block : Block := ⟨view.blocks[index]!,#[]⟩\n    let bytes := (toJson block).compress.toUTF8\n    unless bytes.size ≤ 60000 do throw (IO.userError \"original view block exceeds page bound\")\n    let digest := Sha256.hex bytes\n    if let some previous ← writer.get (blockKey digest) then\n      unless previous == bytes do throw (IO.userError \"conflicting original view block\")\n    else writer.put (blockKey digest) (some bytes)\n    writer.put (blockRef document.owner index) (some digest.toUTF8)\n  for page in [: (view.spans.size+recipeSize-1)/recipeSize] do\n    let spans := view.spans.extract (page*recipeSize) ((page+1)*recipeSize)\n    let bytes := (toJson spans).compress.toUTF8\n    unless bytes.size ≤ 16384 do throw (IO.userError \"original recipe page exceeds its bound\")\n    let digest := Sha256.hex bytes\n    if let some previous ← writer.get (recipeKey digest) then\n      unless previous == bytes do throw (IO.userError \"conflicting original recipe page\")\n    else writer.put (recipeKey digest) (some bytes)\n    writer.put (recipeRef document.owner page) (some digest.toUTF8)\n  let bytes := (toJson view.header).compress.toUTF8\n  unless bytes.size ≤ 16384 do throw (IO.userError \"original view directory exceeds its byte bound\")\n  writer.put (ownerKey document.owner) (some bytes)\n\ndef geometry? (index : PageMap.Snapshot) (database owner : String) (deadline : Nat) : IO (Option Geometry) := do\n  let some bytes ← index.get (ownerKey owner) | return none\n  unless bytes.size ≤ 16384 do throw (IO.userError \"oversized original view directory\")\n  let header ← ObservedRecords.decode (α := Header) bytes\n  unless header.database == database && header.owner == owner &&\n      header.occurrences.all Occurrence.valid && !header.occurrences.isEmpty &&\n      header.blocks == (header.characters+blockChars-1)/blockChars do\n    throw (IO.userError \"foreign or invalid original view directory\")\n  let mut spans := #[]\n  for page in [: (header.recipes+recipeSize-1)/recipeSize] do\n    unless (← IO.monoMsNow) < deadline do throw (IO.userError \"original recipe acquisition expired\")\n    let some pointer ← index.get (recipeRef owner page) | throw (IO.userError \"missing original recipe pointer\")\n    let some digest := String.fromUTF8? pointer | throw (IO.userError \"invalid original recipe pointer\")\n    let some bytes ← index.get (recipeKey digest) | throw (IO.userError \"missing original recipe page\")\n    unless bytes.size ≤ 16384 && Sha256.hex bytes == digest do throw (IO.userError \"invalid original recipe digest\")\n    let rows ← ObservedRecords.decode (α := Array Span) bytes\n    unless rows.size == min recipeSize (header.recipes-page*recipeSize) && rows.all (fun span =>\n        span.first < span.limit && span.limit ≤ header.characters && span.limit-span.first ≤ blockChars) do\n      throw (IO.userError \"invalid original recipe extent\")\n    spans := spans ++ rows\n  unless Plugin.OriginalStructure.complete header.characters spans do\n    throw (IO.userError \"stored original recipe domain is incomplete\")\n  return some ⟨header,spans⟩\n\ndef load? (index : PageMap.Snapshot) (database owner : String) : IO (Option View) := do\n  let some geometry ← geometry? index database owner ((← IO.monoMsNow)+30000) | return none\n  let header := geometry.header\n  let mut blocks := #[]\n  for position in [:header.blocks] do\n    let some pointer ← index.get (blockRef owner position) | throw (IO.userError \"missing original block pointer\")\n    let some digest := String.fromUTF8? pointer | throw (IO.userError \"invalid original block pointer\")\n    let some bytes ← index.get (blockKey digest) | throw (IO.userError \"missing original view block\")\n    unless bytes.size ≤ 60000 && Sha256.hex bytes == digest do\n      throw (IO.userError \"invalid original view block digest\")\n    let block ← ObservedRecords.decode (α := Block) bytes\n    let text := block.text\n    unless text.length == min blockChars (header.characters-position*blockChars) do\n      throw (IO.userError \"invalid original view character extent\")\n    unless block.spans.all (fun span => span.first < span.limit && span.limit ≤ header.characters &&\n        span.limit-span.first ≤ blockChars && span.first < (position+1)*blockChars && position*blockChars < span.limit) do\n      throw (IO.userError \"invalid original view record interval\")\n    blocks := blocks.push text\n  return some ⟨header,geometry.spans,blocks⟩\n\ndef geometryCapacity : Nat := 16*1024*1024\n\nstructure CachedGeometry where\n  geometry : Option Geometry\n  charge : Nat\n  stamp : Nat\n\nstructure CacheState where\n  entries : Std.HashMap String CachedGeometry := {}\n  bytes : Nat := 0\n  clock : Nat := 0\n  loads : Nat := 0\n  hits : Nat := 0\n\n/-- One bounded metadata cache is shared across all source scopes. A miss is\nsingle-flight under this short metadata lock; no payload block is decoded. -/\nabbrev Cache := Std.Mutex CacheState\n\ndef Cache.new : IO Cache := Std.Mutex.new {}\n\ndef Cache.acquire (cache : Cache) (index : PageMap.Snapshot) (database owner : String) (deadline : Nat) :\n    IO (Option Geometry) := cache.atomically do\n  unless (← IO.monoMsNow) < deadline do throw (IO.userError \"original recipe cache wait expired\")\n  let identity := (toJson (index.head,database,owner)).compress\n  let state ← get\n  let clock := state.clock+1\n  if let some found := state.entries[identity]? then\n    set {state with\n      clock,hits := state.hits+1\n      entries := state.entries.insert identity {found with stamp := clock}}\n    return found.geometry\n  let found ← geometry? index database owner deadline\n  let charge := (toJson found).compress.utf8ByteSize*4+256\n  let mut state := {state with clock,loads := state.loads+1}\n  if charge ≤ geometryCapacity then\n    while state.bytes+charge > geometryCapacity || state.entries.size ≥ 512 do\n      let some (key,value) := (state.entries.toArray.qsort fun a b => a.2.stamp < b.2.stamp)[0]? |\n        throw (IO.userError \"original recipe cache accounting failed\")\n      state := {state with entries := state.entries.erase key,bytes := state.bytes-value.charge}\n    state := {state with entries := state.entries.insert identity ⟨found,charge,clock⟩,bytes := state.bytes+charge}\n  set state\n  return found\n\ndef Cache.stats (cache : Cache) : IO Json := cache.atomically do\n  let state ← get\n  return Json.mkObj [(\"loads\",toJson state.loads),(\"hits\",toJson state.hits),\n    (\"chargedBytes\",toJson state.bytes),(\"capacity\",toJson geometryCapacity),\n    (\"entries\",toJson state.entries.size)]\n\nstructure Projection where\n  source : PageMap.Head\n  rows : Array (String × Option Geometry)\n  cache : Json\n  deriving ToJson, FromJson\n\n/-- A point extraction reads only intersecting blocks; it never walks the\nprefix of the owner's body or repeats JSON parsing/record normalization. -/\ndef View.slice (view : View) (first limit : Nat) : Option String := do\n  unless first < limit && limit ≤ view.header.characters do none\n  let start := first/blockChars\n  let stop := (limit-1)/blockChars+1\n  let mut parts := []\n  for index in [start:stop] do\n    let block ← view.blocks[index]?\n    let a := first-index*blockChars\n    let b := min blockChars (limit-index*blockChars)\n    parts := String.ofList (block.toList.drop a |>.take (b-a)) :: parts\n  return \"\".intercalate parts.reverse\n\nstructure Piece where\n  span : Span\n  original : String\n  deriving BEq, ToJson, FromJson\n\n/-- Only intersecting prepared records are offered. The base partition is\nalways available for bytes outside a structural record; no input shape can\nmake an original region disappear. The caller retains query priorities. -/\ndef View.pieces (view : View) (first limit : Nat) : Array Piece := Id.run do\n  if first ≥ limit || limit > view.header.characters then return #[]\n  let spans := (view.spans.filter fun span => span.first < limit && first < span.limit).qsort fun a b => a.first < b.first\n  let mut cursor := first\n  let mut all := spans\n  for span in spans do\n    if cursor < span.first then\n      for record in ObservedRecords.base view.header.characters do\n        let a := max cursor record.first\n        let b := min span.first record.limit\n        if a < b then all := all.push ⟨a,b,false⟩\n    cursor := max cursor span.limit\n  if cursor < limit then\n    for record in ObservedRecords.base view.header.characters do\n      let a := max cursor record.first\n      let b := min limit record.limit\n      if a < b then all := all.push ⟨a,b,false⟩\n  return all.filterMap fun span => (view.slice span.first span.limit).map (Piece.mk span)\n\n/-- A delivered piece is tied to the exact stored range. This constructor\ndoes not return any control Match, Union or completion certificate. -/\nstructure CheckedPiece (view : View) where\n  piece : Piece\n  exact : view.slice piece.span.first piece.span.limit = some piece.original\n\ndef Piece.check? (view : View) (piece : Piece) : Option (CheckedPiece view) :=\n  if exact : view.slice piece.span.first piece.span.limit = some piece.original then some ⟨piece,exact⟩ else none\n\ntheorem checked_piece_exact (view : View) (piece : CheckedPiece view) :\n    view.slice piece.piece.span.first piece.piece.span.limit = some piece.piece.original := piece.exact\n\nend Eggshell.Synapses.ObservedRecordView\n"],["OriginalStructure.lean","module\npublic import Lean.Data.Json.Parser\npublic import Lean.Data.Json.FromToJson\npublic import tools.PairDecisions\npublic import tools.IndexedCharacters\n@[expose] public section\nnamespace Eggshell.Plugin\nopen Lean\n\n/-- Publication intervals do not require allocating the whole source. -/\nstructure DeliveryInterval where\n  start : Nat\n  stop : Nat\n  ordered : start < stop\n\ndef DeliveryInterval.covers (range : DeliveryInterval) (position : Nat) : Prop :=\n  range.start ≤ position ∧ position < range.stop\n\ndef DeliveryInterval.subtract (range covered : DeliveryInterval) : List DeliveryInterval :=\n  (if ordered : range.start < min range.stop covered.start then\n    [⟨range.start, min range.stop covered.start, ordered⟩] else []) ++\n  (if ordered : max range.start covered.stop < range.stop then\n    [⟨max range.start covered.stop, range.stop, ordered⟩] else [])\n\ntheorem DeliveryInterval.subtract_covers (range covered : DeliveryInterval) (position : Nat) :\n    (∃ part ∈ range.subtract covered, part.covers position) ↔\n      range.covers position ∧ ¬covered.covers position := by\n  have := range.ordered\n  have := covered.ordered\n  unfold subtract\n  split <;> split <;> simp_all [covers] <;> omega\n\ndef DeliveryInterval.subtractAll (range : DeliveryInterval) : List DeliveryInterval → List DeliveryInterval\n  | [] => [range]\n  | first :: rest => (range.subtract first).flatMap (·.subtractAll rest)\n\ntheorem DeliveryInterval.subtractAll_covers (range : DeliveryInterval)\n    (covered : List DeliveryInterval) (position : Nat) :\n    (∃ part ∈ range.subtractAll covered, part.covers position) ↔\n      range.covers position ∧ ∀ prior ∈ covered, ¬prior.covers position := by\n  induction covered generalizing range with\n  | nil => simp [subtractAll]\n  | cons first rest ih =>\n      constructor\n      · rintro ⟨part, member, covers⟩\n        obtain ⟨middle, member, next⟩ := List.mem_flatMap.mp member\n        have tail := (ih middle).mp ⟨part, next, covers⟩\n        have head := (subtract_covers range first position).mp ⟨middle, member, tail.1⟩\n        exact ⟨head.1, by\n          intro prior member\n          rcases List.mem_cons.mp member with equal | member\n          · simpa [equal] using head.2\n          · exact tail.2 prior member⟩\n      · rintro ⟨covers, fresh⟩\n        obtain ⟨middle, member, covers⟩ := (subtract_covers range first position).mpr\n          ⟨covers, fresh first (by simp)⟩\n        obtain ⟨part, next, covers⟩ := (ih middle).mpr\n          ⟨covers, fun prior member => fresh prior (by simp [member])⟩\n        exact ⟨part, List.mem_flatMap.mpr ⟨middle, member, next⟩, covers⟩\n\ndef DeliveryInterval.connected (left right : DeliveryInterval) : Prop :=\n  left.start ≤ right.stop ∧ right.start ≤ left.stop\n\ninstance (left right : DeliveryInterval) : Decidable (left.connected right) :=\n  inferInstanceAs (Decidable (_ ∧ _))\n\ndef DeliveryInterval.join (left right : DeliveryInterval)\n    (_ : left.connected right) : DeliveryInterval :=\n  ⟨min left.start right.start,max left.stop right.stop,\n    by have := left.ordered; have := right.ordered; omega⟩\n\ntheorem DeliveryInterval.join_covers (left right : DeliveryInterval)\n    (connected : left.connected right) (position : Nat) :\n    (left.join right connected).covers position ↔ left.covers position ∨ right.covers position := by\n  simp only [join,covers]\n  unfold DeliveryInterval.connected at connected\n  omega\n\ndef DeliveryInterval.coalesceFrom (current : DeliveryInterval) : List DeliveryInterval → List DeliveryInterval\n  | [] => [current]\n  | next :: rest => if connected : current.connected next then\n      coalesceFrom (current.join next connected) rest\n    else current :: coalesceFrom next rest\n\ntheorem DeliveryInterval.coalesceFrom_covers (current : DeliveryInterval)\n    (rest : List DeliveryInterval) (position : Nat) :\n    (∃ part ∈ coalesceFrom current rest,part.covers position) ↔\n      current.covers position ∨ ∃ part ∈ rest,part.covers position := by\n  induction rest generalizing current with\n  | nil => simp [coalesceFrom]\n  | cons next rest ih =>\n    simp only [coalesceFrom]\n    split\n    · rw [ih,join_covers]; simp [or_assoc]\n    · simp only [List.mem_cons,exists_eq_or_imp]; rw [ih]\n\ndef DeliveryInterval.coalesce (ranges : List DeliveryInterval) : List DeliveryInterval :=\n  match ranges.mergeSort (fun left right => left.start ≤ right.start) with\n  | [] => []\n  | first :: rest => coalesceFrom first rest\n\ntheorem DeliveryInterval.coalesce_covers (ranges : List DeliveryInterval) (position : Nat) :\n    (∃ part ∈ coalesce ranges,part.covers position) ↔ ∃ part ∈ ranges,part.covers position := by\n  have sorted : (∃ part ∈ ranges.mergeSort (fun left right => left.start ≤ right.start),part.covers position) ↔\n      ∃ part ∈ ranges,part.covers position := by simp\n  cases publication : ranges.mergeSort (fun left right => left.start ≤ right.start) with\n  | nil => simpa [coalesce,publication] using sorted\n  | cons first rest => simpa [coalesce,publication,coalesceFrom_covers] using sorted\n\ntheorem DeliveryInterval.subtractAll_empty (range : DeliveryInterval) (prior : List DeliveryInterval) :\n    (range.subtractAll prior).isEmpty = true ↔\n      ¬ ∃ position,range.covers position ∧ ∀ part ∈ prior,¬part.covers position := by\n  constructor\n  · intro empty ⟨position,inside,fresh⟩\n    obtain ⟨part,member,_⟩ := (subtractAll_covers range prior position).mpr ⟨inside,fresh⟩\n    have missing : range.subtractAll prior = [] := List.isEmpty_iff.mp empty\n    simp [missing] at member\n  · intro none\n    cases output : range.subtractAll prior with\n    | nil => rfl\n    | cons part rest =>\n      exfalso\n      apply none\n      have member : part ∈ range.subtractAll prior := by simp [output]\n      exact ⟨part.start,(subtractAll_covers range prior part.start).mp\n        ⟨part,member,Nat.le_refl _,part.ordered⟩⟩\n\ntheorem DeliveryInterval.subtractAll_empty_same_union (range : DeliveryInterval)\n    (left right : List DeliveryInterval)\n    (same : ∀ position,(∃ part ∈ left,part.covers position) ↔ ∃ part ∈ right,part.covers position) :\n    (range.subtractAll left).isEmpty = (range.subtractAll right).isEmpty := by\n  apply Bool.eq_iff_iff.mpr\n  change (range.subtractAll left).isEmpty = true ↔ (range.subtractAll right).isEmpty = true\n  rw [subtractAll_empty,subtractAll_empty]\n  apply not_congr\n  apply exists_congr\n  intro position\n  apply and_congr_right\n  intro _\n  simpa only [not_exists,not_and] using not_congr (same position)\n\n\n/-- A decoded tool string is accepted only when serializing it recreates the\nentire immutable stored value. This changes display, never the Outcome identity. -/\nstructure DecodedToolText (source : String) where\n  text : String\n  exact : (Json.str text).compress = source\n\ndef decodedToolText? (source : String) : Option (DecodedToolText source) := do\n  let .ok (.str text) := Json.parse source | none\n  if exact : (Json.str text).compress = source then some ⟨text, exact⟩ else none\n\n\ntheorem decoded_tool_text_recreates_source (decoded : DecodedToolText source) :\n    (Json.str decoded.text).compress = source := decoded.exact\n\n\n/-- Certified contiguous original characters around a meaning-ranked window.\nThis is evidence for an existing graph owner, not a new Outcome or completion. -/\nstructure EvidenceRange (source : String) where\n  start : Nat\n  stop : Nat\n  ordered : start < stop\n  within : stop ≤ source.length\n  bounded : stop - start ≤ 2048\n\ntheorem EvidenceRange.coordinates_injective (left right : EvidenceRange source)\n    (first : left.start = right.start) (last : left.stop = right.stop) : left = right := by\n  cases left\n  cases right\n  cases first\n  cases last\n  rfl\n\ninstance : BEq (EvidenceRange source) where\n  beq left right := left.start == right.start && left.stop == right.stop\n\ninstance : LawfulBEq (EvidenceRange source) where\n  eq_of_beq := by\n    intro left right same\n    exact EvidenceRange.coordinates_injective left right\n      (eq_of_beq (Bool.and_eq_true_iff.mp same).1) (eq_of_beq (Bool.and_eq_true_iff.mp same).2)\n  rfl := by intro range; simp [BEq.beq]\n\ninstance : Hashable (EvidenceRange source) where\n  hash range := hash (range.start, range.stop)\n\ndef EvidenceRange.text (range : EvidenceRange source) : String :=\n  ((source.drop range.start).take (range.stop - range.start)).copy\n\ntheorem EvidenceRange.source_exact (range : EvidenceRange source) :\n    range.text.toList = (source.toList.drop range.start).take (range.stop - range.start) := by\n  simp [text]\n\ntheorem EvidenceRange.text_bounded (range : EvidenceRange source) :\n    range.text.length ≤ 2048 := by\n  have bounded := range.bounded\n  rw [← String.length_toList, range.source_exact]\n  simp only [List.length_take, List.length_drop, String.length_toList]\n  omega\n\ndef EvidenceRange.around? (source : String) (center : Nat) : Option (EvidenceRange source) :=\n  let start := min (center - 1024) (source.length - 2048)\n  let stop := min source.length (start + 2048)\n  if valid : start < stop ∧ stop ≤ source.length ∧ stop - start ≤ 2048 then\n    some ⟨start, stop, valid.1, valid.2.1, valid.2.2⟩\n  else none\n\n/-- A connected source interval before transport segmentation. Its extent is\nnot a range-count limit: dense meaning positions share one interval, while\nseparate positions keep their individual ownership and numerical priority. -/\nstructure ContextSpan (source : String) where\n  start : Nat\n  stop : Nat\n  ordered : start < stop\n  within : stop ≤ source.length\n\ndef ContextSpan.covers (span : ContextSpan source) (position : Nat) : Prop :=\n  span.start ≤ position ∧ position < span.stop\n\ndef EvidenceRange.covers (range : EvidenceRange source) (position : Nat) : Prop :=\n  range.start ≤ position ∧ position < range.stop\n\ninstance (span : ContextSpan source) (position : Nat) : Decidable (span.covers position) :=\n  inferInstanceAs (Decidable (_ ∧ _))\n\ninstance (range : EvidenceRange source) (position : Nat) : Decidable (range.covers position) :=\n  inferInstanceAs (Decidable (_ ∧ _))\n\n\ndef ContextSpan.ranges (span : ContextSpan source) : List (EvidenceRange source) :=\n  if bounded : span.stop - span.start ≤ 2048 then\n    [⟨span.start, span.stop, span.ordered, span.within, bounded⟩]\n  else\n    let first : EvidenceRange source := ⟨span.start, span.start + 2048,\n      by omega, by have := span.within; omega, by omega⟩\n    let tail : ContextSpan source := ⟨span.start + 2048, span.stop,\n      by omega, span.within⟩\n    first :: tail.ranges\ntermination_by span.stop - span.start\n\n/-- Segmentation is exact even for a dense cluster longer than one transport\nrange. It is not truncation to the first 2048 characters. -/\ntheorem ContextSpan.ranges_cover (span : ContextSpan source) (position : Nat) :\n    (∃ range ∈ span.ranges, range.covers position) ↔ span.covers position := by\n  rw [ContextSpan.ranges]\n  split\n  · simp [EvidenceRange.covers, ContextSpan.covers]\n  · simp only [List.mem_cons, exists_eq_or_imp]\n    rw [ContextSpan.ranges_cover]\n    simp only [EvidenceRange.covers, ContextSpan.covers]\n    omega\ntermination_by span.stop - span.start\n\n\ndef encodedTextBody (text : String) : String :=\n  (((Json.str text).compress.drop 1).dropEnd 1).copy\n\ntheorem encoded_text_body_exact (text : String) :\n    encodedTextBody text =\n      String.ofList (((Json.str text).compress.toList.drop 1).dropLast) := by\n  apply String.ext\n  simp [encodedTextBody, List.dropLast_eq_take]\n\n\ndef encodedCharacterWidths (chars : List Char) : List (Nat × Nat) :=\n  chars.zipIdx.map fun (char, index) => (index, (encodedTextBody (String.singleton char)).length)\n\ndef scalarPrefixHolds (source content : String) (first second : Nat) : Prop :=\n  (source.take first).copy = \"\\\"\" ++ encodedTextBody ((content.take second).copy)\n\ninstance : DecidableRel (scalarPrefixHolds source content) := fun first second =>\n  inferInstanceAs (Decidable ((source.take first).copy =\n    \"\\\"\" ++ encodedTextBody ((content.take second).copy)))\n\ndef scalarPrefixDepth (source content : String) : Nat :=\n  ((source.length + 1) * (content.length + 1)).log2 + 1\n\nabbrev ScalarPrefixMemo (source content : String) :=\n  PairDecisions (scalarPrefixHolds source content) (content.length + 1) (scalarPrefixDepth source content)\n\n/-- Request-local layout of one immutable scalar. The expensive canonical\nencoding of each character is prepared once, not for each budget/range. -/\nstructure DecodedLayout (source : String) where\n  decoded : DecodedToolText source\n  chars : List Char\n  charsExact : chars = decoded.text.toList\n  widths : List (Nat × Nat)\n  widthsExact : widths = encodedCharacterWidths chars\n  original : IndexedCharacters source\n  content : IndexedCharacters decoded.text\n  prefixes : ScalarPrefixMemo source decoded.text\n\ndef DecodedLayout.make (decoded : DecodedToolText source) : DecodedLayout source :=\n  let chars := decoded.text.toList\n  ⟨decoded, chars, rfl, encodedCharacterWidths chars, rfl,\n    IndexedCharacters.make source, ⟨chars.toArray, rfl⟩,\n    PairDecisions.make _ (decoded.text.length + 1) (scalarPrefixDepth source decoded.text)⟩\n\ntheorem DecodedLayout.is_canonical (layout : DecodedLayout source) :\n    layout = make layout.decoded := by\n  cases layout with\n  | mk decoded chars charsExact widths widthsExact original content prefixes =>\n    subst chars\n    subst widths\n    rw [IndexedCharacters.is_canonical original, IndexedCharacters.is_canonical content,\n      PairDecisions.is_canonical prefixes]\n    rfl\n\n/-- Recorded line boundaries in the original scalar, including JSON escape\nwidths. These are presentation spans, not file identity or relevance gates. -/\ndef contextRecordSpans (source : String) (layout : Option (DecodedLayout source)) :\n    List (ContextSpan source) := Id.run do\n  let units := match layout with\n    | some value => value.chars.zip (value.widths.map Prod.snd)\n    | none => source.toList.map fun char => (char, 1)\n  let mut position := if layout.isSome then 1 else 0\n  let mut first := position\n  let mut spans := []\n  for (char, width) in units do\n    position := position + width\n    if char == '\\n' then\n      if valid : first < position ∧ position ≤ source.length then\n        spans := (⟨first, position, valid.1, valid.2⟩ : ContextSpan source) :: spans\n      first := position\n  if valid : first < position ∧ position ≤ source.length then\n    spans := (⟨first, position, valid.1, valid.2⟩ : ContextSpan source) :: spans\n  return spans.reverse\n\n\n/-- Prefer complete adjacent records when they fit one bounded range. A very\nlong single record retains the explicitly partial original representation. -/\ndef recordContextRange (records : List (ContextSpan source)) (range : EvidenceRange source) :\n    EvidenceRange source :=\n  let start := ((records.find? fun record =>\n    record.start ≤ range.start && range.start < record.stop).map (·.start)).getD range.start\n  let stop := ((records.find? fun record =>\n    record.start < range.stop && range.stop ≤ record.stop).map (·.stop)).getD range.stop\n  if valid : start ≤ range.start ∧ range.stop ≤ stop ∧ start < stop ∧\n      stop ≤ source.length ∧ stop - start ≤ 2048 then\n    ⟨start, stop, valid.2.2.1, valid.2.2.2.1, valid.2.2.2.2⟩\n  else range\n\ntheorem record_context_retains_original (records : List (ContextSpan source))\n    (range : EvidenceRange source) (position : Nat) (covered : range.covers position) :\n    (recordContextRange records range).covers position := by\n  unfold recordContextRange\n  dsimp only\n  split\n  · rename_i bounds\n    simp only [EvidenceRange.covers] at *\n    exact ⟨Nat.le_trans bounds.1 covered.1, Nat.lt_of_lt_of_le covered.2 bounds.2.1⟩\n  · exact covered\n\n\n/-- Original offsets are accumulated while scanning, including canonical\nJSON escape widths. Numbered tool-output gaps reset the structural hint, so\nan earlier file or disjoint read cannot supply the next section's header. -/\ndef contextStructureHeads (source : String) (layout : Option (DecodedLayout source))\n    (scopeLabels : Bool := false) :\n    List (Nat × Option Nat) := Id.run do\n  let units := match layout with\n    | some value => value.chars.zip (value.widths.map Prod.snd)\n    | none => source.toList.map fun char => (char, 1)\n  let mut position := if layout.isSome then 1 else 0\n  let mut first := position\n  let mut line : List Char := []\n  let mut rows : List (Nat × String) := []\n  for (char, width) in units do\n    if char == '\\n' then\n      rows := (first, String.ofList line.reverse) :: rows\n      line := []\n      first := position + width\n    else line := char :: line\n    position := position + width\n  if !line.isEmpty then rows := (first, String.ofList line.reverse) :: rows\n  let mut previous : Option Nat := none\n  let mut previousDelimiter : Option Char := none\n  let mut scopes : List (Nat × Nat) := []\n  let mut heads : List (Nat × Option Nat) := []\n  let ordered := rows.reverse\n  let mut paragraph : Bool := ordered.length > 1\n  for (offset, text) in ordered do\n    let trimmed := text.toList.dropWhile (· == ' ')\n    let digits := trimmed.takeWhile Char.isDigit\n    let rest := trimmed.drop digits.length\n    -- `nl` uses a tab and `rg -n` uses a colon. Both carry original line\n    -- numbers; sparse hits and a change of representation break adjacency.\n    -- Otherwise a following file's grep result can borrow the preceding\n    -- file's function header and consume its whole context allowance.\n    let delimiter := rest.head?.filter (fun char => char == '\\t' || char == ':')\n    let numbered := !digits.isEmpty && delimiter.isSome\n    let number := if numbered then (String.ofList digits).toNat? else none\n    let body := if numbered then String.ofList (rest.drop 1) else text\n    if number.isSome && (number != previous.map (· + 1) || delimiter != previousDelimiter) then\n      scopes := []\n      heads := (offset, none) :: heads\n      paragraph := true\n    let blank := (body.toList.dropWhile (fun char => char == ' ' || char == '\\t')).isEmpty\n    let paragraphStart := paragraph && body.toList.head?.any (fun char => char != ' ' && char != '\\t')\n    -- Paragraph starts and explicit headings apply to prose, records and\n    -- tool text as well as source code. Shape hints never admit a candidate,\n    -- infer a relation or certify syntax/meaning. Single unstructured lines\n    -- have no paragraph boundary; their ranked nearby context is sufficient.\n    -- Indented scope labels belong to the original record too. Their\n    -- conditions must precede a selected result, just as prose headings do.\n    -- Numbered gaps above still reset this local hint; no relation or\n    -- completion authority is inferred from indentation or punctuation.\n    let label := String.ofList (body.toList.dropWhile (fun char => char == ' ' || char == '\\t'))\n    let scopeLabel := scopeLabels && label.endsWith \":\" && label.toList.head?.any Char.isAlpha\n    let indentation := (body.toList.takeWhile (fun char => char == ' ' || char == '\\t')).length\n    -- A monotone indentation stack prevents an earlier branch from lending\n    -- its label to a following function or sibling record. Retain a still\n    -- enclosing label when only an inner scope ends.\n    if !blank && !scopeLabel then\n      let enclosing := scopes.dropWhile (fun row => indentation <= row.1)\n      if enclosing.length != scopes.length then\n        heads := (offset, enclosing.head?.map Prod.snd) :: heads\n      scopes := enclosing\n    if scopeLabel && 0 < indentation then\n      scopes := (indentation, offset) :: scopes.dropWhile (fun row => indentation <= row.1)\n    if paragraphStart || body.startsWith \"# \" || body.startsWith \"##\" || scopeLabel ||\n        (body.toList.head?.any Char.isAlpha && (body.contains '(' || body.endsWith \":\")) then\n      heads := (offset, some offset) :: heads\n    paragraph := blank\n    previous := number\n    previousDelimiter := if numbered then delimiter else none\n  return heads.reverse\n\n\n/-- A nearby recorded paragraph/function start is part of the observation,\nnot optional peripheral data. This keeps a result with its invocation or\nprecondition, using only bounded original positions from the same section. -/\ndef prerequisiteContextRange (records : List (ContextSpan source))\n    (heads : List (Nat × Option Nat)) (range : EvidenceRange source) : EvidenceRange source :=\n  let complete := recordContextRange records range\n  let preceding := (heads.takeWhile (fun row => row.1 ≤ complete.start)).reverse\n  let first := preceding.head?.bind Prod.snd |>.getD complete.start\n  let lower := ((heads.filter fun row => row.2.isNone && row.1 ≤ complete.start).getLast?).map\n    Prod.fst |>.getD 0\n  -- Inputs and results may be separated by a blank record. The immediately\n  -- preceding bounded paragraph is retained, without crossing a file/read gap.\n  let prior := (preceding.dropWhile (fun row => first ≤ row.1)).head?.bind Prod.snd\n  let start := match prior with\n    | some position => if lower ≤ position && complete.stop - position ≤ 2048 then position else first\n    | none => first\n  if valid : start ≤ complete.start ∧ start < complete.stop ∧\n      complete.stop - start ≤ 2048 then\n    ⟨start, complete.stop, valid.2.1, complete.within, valid.2.2⟩\n  else complete\n\ntheorem prerequisite_context_keeps_cue (records : List (ContextSpan source))\n    (heads : List (Nat × Option Nat)) (range : EvidenceRange source) (position : Nat)\n    (covered : range.covers position) :\n    (prerequisiteContextRange records heads range).covers position := by\n  have complete := record_context_retains_original records range position covered\n  unfold prerequisiteContextRange\n  dsimp only\n  split\n  · rename_i valid\n    change _ ≤ position ∧ position < (recordContextRange records range).stop\n    exact ⟨Nat.le_trans valid.1 complete.1, complete.2⟩\n  · exact complete\n\n\n\nnamespace SharedRangeAdapter\n/-- A source record keeps its original paragraph and bounded scope entry.\nThe fixed-width surrounding display is an enrichment, not a prerequisite of\nthis smaller advisory offer. This creates no Match or completion authority. -/\ndef recordPrerequisite (records : List (ContextSpan source))\n    (heads scopedHeads : List (Nat × Option Nat)) (record : EvidenceRange source) :\n    EvidenceRange source :=\n  let prior := prerequisiteContextRange records heads record\n  let scope := prerequisiteContextRange records scopedHeads record\n  if valid : scope.start < prior.start ∧ prior.stop-scope.start ≤ 2048 then\n    ⟨scope.start,prior.stop,Nat.lt_trans valid.1 prior.ordered,prior.within,valid.2⟩\n  else prior\n\ntheorem record_prerequisite_retains_source (records : List (ContextSpan source))\n    (heads scopedHeads : List (Nat × Option Nat)) (record : EvidenceRange source)\n    (position : Nat) (inside : record.covers position) :\n    (recordPrerequisite records heads scopedHeads record).covers position := by\n  have retained := prerequisite_context_keeps_cue records heads record position inside\n  unfold recordPrerequisite\n  dsimp only\n  split\n  · rename_i valid\n    change _ ≤ position ∧ position < (prerequisiteContextRange records heads record).stop\n    exact ⟨Nat.le_trans (Nat.le_of_lt valid.1) retained.1,retained.2⟩\n  · exact retained\n\n\n/-- One whole-scalar check permits display decoding at recorded character\nboundaries. This is presentation evidence, never a file alias or Work proof. -/\nstructure ScalarLayout (source : String) where\n  layout : DecodedLayout source\n  canonical : source = (toJson layout.decoded.text).compress\n\ndef ScalarLayout.check? (source : String) : Option (ScalarLayout source) := do\n  let decoded ← decodedToolText? source\n  let layout := DecodedLayout.make decoded\n  if canonical : source = (toJson layout.decoded.text).compress then\n    some ⟨layout,canonical⟩ else none\n\ndef ScalarLayout.boundaries (prepared : ScalarLayout source) : Std.HashSet Nat := Id.run do\n  let mut position := 1\n  let mut result := ({} : Std.HashSet Nat).insert position\n  for (_,width) in prepared.layout.widths do\n    position := position+width\n    result := result.insert position\n  return result\n\n\n\nend SharedRangeAdapter\n\nnamespace OriginalStructure\n\n/-- A publication recipe names original positions. It carries no query value,\nfile alias, graph admission or completion authority. -/\nstructure Span where\n  first : Nat\n  limit : Nat\n  decoded : Bool\n  deriving BEq, Hashable\n\ninstance : ToJson Span where\n  toJson span := toJson (span.first,span.limit,span.decoded)\ninstance : FromJson Span where\n  fromJson? value := do\n    let (first,limit,decoded) ← fromJson? (α := Nat × Nat × Bool) value\n    return ⟨first,limit,decoded⟩\n\ndef Span.range? (span : Span) (source : String) : Option (EvidenceRange source) :=\n  if valid : span.first < span.limit ∧ span.limit ≤ source.length ∧ span.limit-span.first ≤ 2048 then\n    some ⟨span.first,span.limit,valid.1,valid.2.1,valid.2.2⟩ else none\n\n/-- A caller computes character count once. The source-size proof is erased,\nso checking each recipe never rescans its owner's entire UTF-8 string. -/\ndef Span.rangeUsing? (span : Span) (source : String) (characters : Nat)\n    (exact : characters = source.length) : Option (EvidenceRange source) :=\n  if valid : span.first < span.limit ∧ span.limit ≤ characters ∧ span.limit-span.first ≤ 2048 then\n    some ⟨span.first,span.limit,valid.1,by simpa [exact] using valid.2.1,valid.2.2⟩ else none\n\ntheorem Span.range_using_exact (span : Span) (source : String) (characters : Nat)\n    (exact : characters = source.length) : span.rangeUsing? source characters exact = span.range? source := by\n  subst characters\n  rfl\n\ndef Span.ofRange (range : EvidenceRange source) (decoded : Bool) : Span :=\n  ⟨range.start,range.stop,decoded⟩\n\ntheorem Span.range_roundtrip (range : EvidenceRange source) (decoded : Bool) :\n    (ofRange range decoded).range? source = some range := by\n  simp only [ofRange,range?,range.ordered,range.within,range.bounded,and_self,↓reduceDIte]\n\ntheorem Span.range_positions (span : Span) (source : String) (range : EvidenceRange source)\n    (found : span.range? source = some range) :\n    range.start = span.first ∧ range.stop = span.limit := by\n  unfold range? at found\n  split at found\n  · cases found; exact ⟨rfl,rfl⟩\n  · contradiction\n\ndef intervals (spans : Array Span) : List DeliveryInterval :=\n  spans.toList.filterMap fun span =>\n    if ordered : span.first < span.limit then some ⟨span.first,span.limit,ordered⟩ else none\n\ndef complete (characters : Nat) (spans : Array Span) : Bool :=\n  if positive : 0 < characters then\n    (DeliveryInterval.subtractAll ⟨0,characters,positive⟩ (intervals spans)).isEmpty\n  else true\n\n/-- A published complete recipe domain cannot omit any original position,\nregardless of tool name, file alias or the query's hints. -/\ntheorem complete_position (characters : Nat) (spans : Array Span) (position : Nat)\n    (ready : complete characters spans = true) (inside : position < characters) :\n    ∃ span ∈ spans, span.first ≤ position ∧ position < span.limit := by\n  classical\n  unfold complete at ready\n  split at ready\n  · rename_i positive\n    have whole := (DeliveryInterval.subtractAll_empty ⟨0,characters,positive⟩ (intervals spans)).mp ready\n    apply Classical.byContradiction\n    intro missing\n    apply whole\n    refine ⟨position,⟨Nat.zero_le _,inside⟩,?_⟩\n    intro interval member contains\n    unfold intervals at member\n    obtain ⟨span,belongs,found⟩ := List.mem_filterMap.mp member\n    by_cases ordered : span.first < span.limit\n    · simp only [ordered,↓reduceDIte,Option.some.injEq] at found\n      subst interval\n      exact missing ⟨span,by simpa using belongs,contains⟩\n    · simp [ordered] at found\n  · omega\n\nstructure Record (source : String) where\n  range : EvidenceRange source\n  decoded : Bool\n\n/-- The renderer's original immutable partition and prerequisite rules,\nincluding uncovered gaps. Query windows and weights do not occur here. -/\ndef catalogue (source : String) : Array (Record source) := Id.run do\n  if positive : 0 < source.length then\n    let wholeSpan : ContextSpan source := ⟨0,source.length,positive,Nat.le_refl _⟩\n    let scalar := SharedRangeAdapter.ScalarLayout.check? source\n    let layout := scalar.map (·.layout)\n    let boundaries := scalar.map SharedRangeAdapter.ScalarLayout.boundaries |>.getD {}\n    let records := contextRecordSpans source layout\n    let heads := contextStructureHeads source layout\n    let scopedHeads := contextStructureHeads source layout true\n    let covered := records.map fun record =>\n      (⟨record.start,record.stop,record.ordered⟩ : DeliveryInterval)\n    let whole : DeliveryInterval := ⟨wholeSpan.start,wholeSpan.stop,wholeSpan.ordered⟩\n    let gaps := (whole.subtractAll covered).attach.map fun gap =>\n      (⟨gap.val.start,gap.val.stop,gap.val.ordered,by\n        have inside : gap.val.covers (gap.val.stop-1) := by\n          have := gap.val.ordered\n          simp only [DeliveryInterval.covers]\n          omega\n        have contained := ((DeliveryInterval.subtractAll_covers whole covered (gap.val.stop-1)).mp\n          ⟨gap.val,gap.property,inside⟩).1\n        have bound := wholeSpan.within\n        simp only [DeliveryInterval.covers,whole] at contained\n        omega⟩ : ContextSpan source)\n    let mut result := #[]\n    let mut seen : Std.HashSet (Nat × Nat) := {}\n    for record in records ++ gaps do\n      for part in record.ranges do\n        let required := SharedRangeAdapter.recordPrerequisite records heads scopedHeads part\n        if seen.contains (required.start,required.stop) then continue\n        seen := seen.insert (required.start,required.stop)\n        result := result.push ⟨required,scalar.isSome && boundaries.contains required.start &&\n          boundaries.contains required.stop⟩\n    return result\n  else return #[]\n\ndef prepare (source : String) : Array Span :=\n  (catalogue source).map fun record => Span.ofRange record.range record.decoded\n\ntheorem prepared_span_has_original_range (source : String) (span : Span)\n    (present : span ∈ prepare source) :\n    ∃ range : EvidenceRange source, span.range? source = some range := by\n  obtain ⟨record,_,same⟩ := Array.mem_map.mp present\n  subst span\n  exact ⟨record.range,Span.range_roundtrip ..⟩\n\nend OriginalStructure\n\nend Eggshell.Plugin\n"],["../tools/LiteralSearch.lean","module\npublic import Std.Data.HashMap\n@[expose] public section\n\n/- Multi-pattern literal search. This module knows no tools, files, Work,\nfreshness, Union or model. Every reported occurrence is checked against both\nthe requested pattern and actual bounded source characters. -/\nnamespace LiteralSearch\n\nstructure Node where\n  next : Std.HashMap Char Nat := {}\n  failure : Nat := 0\n  terminal : Array Nat := #[]\n  exit : Option Nat := none\n  deriving Inhabited\n\nstructure Index (patterns : Array String) where\n  nodes : Array Node\n\ndef advance (nodes : Array Node) (start : Nat) (character : Char) : Nat := Id.run do\n  let mut state := start\n  for _ in [:nodes.size+1] do\n    let some node := nodes[state]? | return 0\n    if let some target := node.next[character]? then return target\n    if state == 0 then return 0\n    state := node.failure\n  return 0\n\n/-- Aho-Corasick failure/exit links share all prefixes and avoid copying the\noutputs of suffix states. Source data is scanned once for all requested\npatterns; repeated and overlapping occurrences remain distinct. -/\ndef prepare (patterns : Array String) : Index patterns := Id.run do\n  let mut nodes : Array Node := #[{}]\n  for pattern in [:patterns.size] do\n    let characters := patterns[pattern]!.toList\n    if characters.isEmpty then continue\n    let mut state := 0\n    for character in characters do\n      match nodes[state]!.next[character]? with\n      | some target => state := target\n      | none =>\n        let target := nodes.size\n        nodes := nodes.modify state fun node => {node with next := node.next.insert character target}\n        nodes := nodes.push {}\n        state := target\n    nodes := nodes.modify state fun node => {node with terminal := node.terminal.push pattern}\n  let mut queue := nodes[0]!.next.toArray.map (·.2)\n  let mut position := 0\n  while position < queue.size do\n    let parent := queue[position]!\n    position := position+1\n    for (character,child) in nodes[parent]!.next do\n      let failure := advance nodes nodes[parent]!.failure character\n      let exit := if nodes[failure]!.terminal.isEmpty then nodes[failure]!.exit else some failure\n      nodes := nodes.modify child fun node => {node with failure,exit}\n      queue := queue.push child\n  return ⟨nodes⟩\n\nstructure Hit (patterns : Array String) (original : String) where\n  pattern : Fin patterns.size\n  first : Nat\n  limit : Nat\n  within : first < limit ∧ limit ≤ original.length\n  exact : patterns[pattern] = String.ofList (original.toList.toArray.extract first limit).toList\n\ntheorem hit_is_requested_original (hit : Hit patterns original) :\n    hit.first < hit.limit ∧ hit.limit ≤ original.length ∧\n      patterns[hit.pattern] = String.ofList (original.toList.toArray.extract hit.first hit.limit).toList :=\n  ⟨hit.within.1,hit.within.2,hit.exact⟩\n\ndef collect (firstOnly : Bool) (index : Index patterns) (original : String) :\n    Array (Hit patterns original) := Id.run do\n  let characters := original.toList.toArray\n  let lengths := patterns.map String.length\n  let mut result := #[]\n  let mut seen : Std.HashMap Nat Unit := {}\n  let mut state := 0\n  for position in [:characters.size] do\n    state := advance index.nodes state characters[position]!\n    let mut output := some state\n    for _ in [:index.nodes.size+1] do\n      let some nodeIndex := output | break\n      let some node := index.nodes[nodeIndex]? | break\n      for pattern in node.terminal do\n        if firstOnly && seen.contains pattern then continue\n        if present : pattern < patterns.size then\n          let limit := position+1\n          let first := limit-lengths[pattern]!\n          if within : first < limit ∧ limit ≤ original.length then\n            if exact : patterns[pattern] = String.ofList (characters.extract first limit).toList then\n              result := result.push ⟨⟨pattern,present⟩,first,limit,within,exact⟩\n              if firstOnly then seen := seen.insert pattern ()\n      output := node.exit\n  return result\n\n/-- Full occurrences for independent diagnostic comparison. -/\ndef find (index : Index patterns) (original : String) : Array (Hit patterns original) :=\n  collect false index original\n\n/-- Advisory attachment needs presence in each original record, not an array\nof every repeated character occurrence. Retain one checked witness per\nrequested pattern, while scanning the same failure/exit automaton. -/\ndef first (index : Index patterns) (original : String) : Array (Hit patterns original) :=\n  collect true index original\n\nend LiteralSearch\n"],["SourceEvidence.lean","module\n\npublic import Eggshell.FileSystem\npublic import Eggshell.Blake3\npublic import Eggshell.Relation\npublic import Lean.Data.Json.FromToJson\npublic import Lean.Data.Json.Parser\n\n@[expose] public section\n\nnamespace Eggshell.SourceEvidence\nopen Lean\n\n/-- A portable locator is relative to the current workspace. The producing\nworkspace's absolute name is not an identity or permission to read elsewhere. -/\ndef safeRelative (path : String) : Bool :=\n  !path.isEmpty && !path.startsWith \"/\" && !path.contains '\\x00' &&\n    (path.splitOn \"/\").all (fun part =>\n      !part.isEmpty && part != \".\" && part != \"..\")\n\nstructure Relative where\n  text : String\n  safe : safeRelative text = true\n\ndef Relative.check? (path : String) : Option Relative :=\n  if safe : safeRelative path = true then some ⟨path, safe⟩ else none\n\ntheorem relative_cannot_escape (path : Relative) :\n    (path.text.splitOn \"/\").all (fun part => part != \"..\") = true := by\n  have parts := path.safe\n  simp only [safeRelative, Bool.and_eq_true] at parts\n  apply List.all_eq_true.mpr\n  intro part member\n  have valid := List.all_eq_true.mp parts.2 part member\n  simpa only [Bool.and_eq_true] using (Bool.and_eq_true_iff.mp valid).2\n\ndef withoutDots (path : String) : String :=\n  (if path.startsWith \"/\" then \"/\" else \"\") ++\n    \"/\".intercalate ((path.splitOn \"/\").filter (fun part => !part.isEmpty && part != \".\"))\n\ndef relative? (workspace directory : System.FilePath) (path : String) : Option Relative := do\n  if path.isEmpty || path.contains '\\x00' then none else do\n    let workspace := withoutDots workspace.normalize.toString\n    let actual := withoutDots (directory / System.FilePath.mk path).normalize.toString\n    let basePrefix := if workspace.endsWith \"/\" then workspace else workspace ++ \"/\"\n    if !actual.startsWith basePrefix then none else\n      Relative.check? ((actual.drop basePrefix.length).copy)\n\nstructure Fingerprint where\n  bytes : Nat\n  root : String\n  deriving Repr, DecidableEq, BEq, ToJson, FromJson\n\nstructure File where\n  relative : String\n  content : Option Fingerprint\n  deriving Repr, DecidableEq, BEq, ToJson, FromJson\n\nstructure Record where\n  workspace : String\n  files : List File\n  uris : List String := []\n  complete : Bool\n  /-- File observations may be complete while a directory search or another\n      operation has an open dependency domain. Such a record never completes Work. -/\n  closed : Bool := false\n  deriving Repr, DecidableEq, ToJson\n\n/-- Absence of a closed-domain witness never asserts complete operation\ncoverage. It also does not discard the independently recorded file data. -/\ninstance : FromJson Record where\n  fromJson? json := do\n    let workspace ← json.getObjValAs? String \"workspace\"\n    let files ← json.getObjValAs? (List File) \"files\"\n    let uris ← json.getObjValAs? (List String) \"uris\"\n    let complete ← json.getObjValAs? Bool \"complete\"\n    let closed ← match json.getObjVal? \"closed\" with\n      | .error _ => pure false\n      | .ok value => fromJson? value\n    pure ⟨workspace, files, uris, complete, closed⟩\n\ninstance : BEq Record := ⟨fun left right => decide (left = right)⟩\ninstance : LawfulBEq Record where\n  rfl := by intro record; simp [BEq.beq]\n  eq_of_beq := by intro left right equal; exact of_decide_eq_true equal\n\ndef Record.valid (record : Record) : Bool :=\n  record.complete && record.uris.isEmpty && !record.files.isEmpty &&\n    decide ((record.files.map (·.relative)).Nodup) &&\n    record.files.all (fun file => safeRelative file.relative &&\n      file.content.all (fun content => content.root.length == 64 &&\n        content.root.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f'))))\n\n/-- Freshness authorizes only exact currently observed dependency descriptors.\nIt does not assert collision freedom or prove a provider's external behavior. -/\ndef agrees (record : Record) (current : List File) : Bool :=\n  record.valid && decide (current = record.files)\n\nstructure Checked (record : Record) (current : List File) : Type where\n  valid : record.valid = true\n  exact : current = record.files\n\ndef check? (record : Record) (current : List File) : Option (Checked record current) :=\n  if accepted : agrees record current = true then\n    some ⟨(Bool.and_eq_true_iff.mp accepted).1,\n      of_decide_eq_true (Bool.and_eq_true_iff.mp accepted).2⟩\n  else none\n\ntheorem checked_dependencies_exact (checked : Checked record current) :\n    current = record.files := checked.exact\n\n/-- A valid historical observation becomes usable again exactly when its\nactual dependencies match; a later observation cannot refresh its hashes. -/\ntheorem checked_iff_valid_dependencies (record : Record) (current : List File) :\n    (check? record current).isSome = true ↔ record.valid = true ∧ current = record.files := by\n  unfold check?\n  split\n  · rename_i accepted\n    constructor\n    · intro _\n      exact ⟨(Bool.and_eq_true_iff.mp accepted).1,\n        of_decide_eq_true (Bool.and_eq_true_iff.mp accepted).2⟩\n    · intro _\n      rfl\n  · rename_i rejected\n    constructor\n    · intro impossible\n      simp at impossible\n    · rintro ⟨valid, equal⟩\n      exact False.elim (rejected (by simp [agrees, valid, equal]))\n\ntheorem changed_dependency_rejected (record : Record) (current : List File)\n    (changed : current ≠ record.files) : check? record current = none := by\n  simp [check?, agrees, changed]\n\ntheorem incomplete_record_rejected (record : Record) (current : List File)\n    (incomplete : record.complete = false) : check? record current = none := by\n  simp [check?, agrees, Record.valid, incomplete]\n\n/-- Workspace names are display provenance. Relocation changes neither the\nrelative dependency keys nor the contents which the receiving machine checks. -/\ntheorem relocated_record_agreement (record : Record) (current : List File) (name : String) :\n    agrees {record with workspace := name} current = agrees record current := rfl\n\nstructure Probe where\n  file : File\n  stamp : Option String\n  deriving Repr, ToJson, FromJson\n\nstructure Capture where\n  record : Record\n  probes : List Probe\n  deriving Repr, ToJson, FromJson\n\ndef pageRoot (previous page : ByteArray) : ByteArray :=\n  Blake3.digest \"eggshell.source.page\".toUTF8 [previous, page]\n\ntheorem page_root_size (previous page : ByteArray) : (pageRoot previous page).size = 32 := by\n  exact Blake3.hashSegments_size _\n\nabbrev Root := {bytes : ByteArray // bytes.size = 32}\n\ndef stepRoot (previous : Root) (page : ByteArray) : Root :=\n  ⟨pageRoot previous.val page, page_root_size _ _⟩\n\n/-- The scanner holds a single bounded native page, a digest and counters.\nThe chain commits page order and file length. It is a content fingerprint,\nnot an assertion that equal finite hashes imply equal arbitrary files. -/\ndef fingerprint (path : System.FilePath) (deadline : Nat) : IO (Option (Fingerprint × String)) := do\n  if (← IO.monoMsNow) ≥ deadline then return none\n  let handle ← FileSystem.openRead path.toString\n  let before ← FileSystem.readVersion handle\n  let mut offset := 0\n  let mut root : Root := ⟨Blake3.digest \"eggshell.source.file\".toUTF8 [Blake3.u64le before.bytes],\n    Blake3.hashSegments_size _⟩\n  while offset < before.bytes do\n    if (← IO.monoMsNow) ≥ deadline then return none\n    let count := min 4096 (before.bytes - offset)\n    let page ← FileSystem.readPage handle offset.toUInt64 ⟨count, Nat.min_le_left _ _⟩\n    if page.size != count then return none\n    root := stepRoot root page\n    offset := offset + count\n  let after ← FileSystem.readVersion handle\n  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)\n  if (← IO.monoMsNow) ≥ deadline then return none\n  if !FileSystem.stableRead before after current offset then return none\n  pure (some (⟨before.bytes, Blake3.hex root.val⟩, before.stamp))\n\ndef probe (workspace : System.FilePath) (relative : Relative) (deadline : Nat) : IO (Option Probe) := do\n  if (← IO.monoMsNow) ≥ deadline then return none\n  let path := workspace / relative.text\n  try\n    FileSystem.rejectSymlinkAncestors path\n    match ← FileSystem.regularMetadata? path with\n    | none => pure (some ⟨⟨relative.text, none⟩, none⟩)\n    | some _ =>\n        pure ((← fingerprint path deadline).map fun (content, stamp) =>\n          ⟨⟨relative.text, some content⟩, some stamp⟩)\n  catch _ => pure none -- inaccessible, symlink or interrupted is unverified, never absent\n\ndef stillCurrent (workspace : System.FilePath) (probe : Probe) : IO Bool := do\n  let some relative := Relative.check? probe.file.relative | return false\n  let path := workspace / relative.text\n  try\n    FileSystem.rejectSymlinkAncestors path\n    match probe.stamp, ← FileSystem.regularMetadata? path with\n    | none, none => pure true\n    | some expected, some _ => pure ((← FileSystem.readVersion\n        (← FileSystem.openRead path.toString)).stamp == expected)\n    | _, _ => pure false\n  catch _ => pure false\n\n/-- Recheck the version after all related fingerprints have been collected.\nThe OS version checks are observations, not an atomic filesystem snapshot. -/\ndef checkedProbeFile (workspace : System.FilePath) (observed : Option Probe)\n    (deadline : Nat) : IO (Option File) := do\n  let some observed := observed | return none\n  if (← IO.monoMsNow) ≥ deadline then return none\n  unless ← stillCurrent workspace observed do return none\n  if (← IO.monoMsNow) ≥ deadline then return none\n  pure (some observed.file)\n\n/-- Observe precisely the declared files. There is no workspace scan, Git\ndependency, remote request, persistent negative cache or hard file-count cap. -/\ndef observe (workspace : System.FilePath) (files : List File) (deadline : Nat) :\n    IO (Option (List File)) := do\n  let mut observations := []\n  for file in files do\n    let some relative := Relative.check? file.relative | return none\n    let some observed ← probe workspace relative deadline | return none\n    observations := observed :: observations\n  let mut files := []\n  for observed in observations.reverse do\n    let some file ← checkedProbeFile workspace (some observed) deadline | return none\n    files := file :: files\n  pure (some files.reverse)\n\ndef verify (workspace : System.FilePath) (record : Record) (deadline : Nat) : IO Bool := do\n  if !record.valid then return false\n  let some current ← observe workspace record.files deadline | return false\n  pure ((check? record current).isSome)\n\ndef unknown (workspace : System.FilePath) (uris : List String := []) : Capture :=\n  ⟨⟨workspace.fileName.getD workspace.toString, [], uris, false, false⟩, []⟩\n\n/-- Only explicitly named local files are captured. Unrecognized shell syntax,\ndirectory searches and remote providers remain historical evidence. -/\ndef pathsFromInput (input : Json) : List String :=\n  [\"path\", \"file_path\", \"filename\", \"file\"].filterMap fun key =>\n    (input.getObjValAs? String key).toOption\n\ndef urisFromInput (input : Json) : List String :=\n  [\"url\", \"uri\"].filterMap fun key => (input.getObjValAs? String key).toOption\n\ndef isURI (path : String) : Bool := (path.splitOn \"://\").length > 1\n\n/-- Literal shell words. Expansion, redirection and substitution do not\nestablish a closed local read. Quoted patterns are separate from operands. -/\ndef literalWords? (text : String) : Option (List String) := do\n  if text.contains '\\x00' then return ← none\n  let mut words := []\n  let mut word := \"\"\n  let mut quote := (0 : Nat)\n  let mut started := false\n  let mut escaped := false\n  for c in text.toList do\n    if quote == 1 then\n      if c == '\\'' then quote := 0 else word := word.push c\n    else if quote == 2 then\n      if escaped then\n        if c == '\\n' || c == '\\r' then return ← none\n        if !['$', '`', '\"', '\\\\'].contains c then word := word.push '\\\\'\n        word := word.push c\n        escaped := false\n      else if c == '\\\\' then escaped := true\n      else if c == '\"' then quote := 0\n      else if c == '$' || c == '`' then return ← none\n      else word := word.push c\n    else if c == '\\'' then\n      quote := 1\n      started := true\n    else if c == '\"' then\n      quote := 2\n      started := true\n    else if c == '\\n' || c == '\\r' then return ← none\n    else if c.isWhitespace then\n      if started then words := word :: words\n      word := \"\"\n      started := false\n    else if ['$', '`', '\\\\', ';', '|', '&', '<', '>', '*', '?', '[', ']', '(', ')', '{', '}'].contains c then\n      return ← none\n    else\n      word := word.push c\n      started := true\n  if quote != 0 || escaped then return ← none\n  if started then words := word :: words\n  pure words.reverse\n\ndef printProgram (program : String) : Bool :=\n  (program.splitOn \";\").all fun range =>\n    range.endsWith \"p\" && !(range.dropEnd 1).isEmpty &&\n      ((range.dropEnd 1).copy.toList).all (fun c => c.isDigit || c == ',' || c == '$')\n\n/-- A stream filter has no file operand. Programs which read/write another\nfile, execute a command or substitute shell expressions cannot inhabit this\nplan. The external command/OS observation remains outside this pure contract. -/\ninductive StreamFilter where\n  | print (program : String) (literal : printProgram program = true)\n  | prefix (lines : Nat)\n  | suffix (lines : Nat)\n\ndef streamFilter? (words : List String) : Option StreamFilter := do\n  match words with\n  | [\"sed\", \"-n\", program] =>\n      if literal : printProgram program = true then some (.print program literal) else none\n  | [\"head\", \"-n\", count] => count.toNat? |>.map StreamFilter.prefix\n  | [\"head\", count] =>\n      if count.startsWith \"-\" then\n        ((count.drop 1).copy.toNat?).map StreamFilter.prefix else none\n  | [\"tail\", \"-n\", count] => count.toNat? |>.map StreamFilter.suffix\n  | [\"tail\", count] =>\n      if count.startsWith \"-\" then\n        ((count.drop 1).copy.toNat?).map StreamFilter.suffix else none\n  | _ => none\n\n/-- Split only unquoted pipes; every filter must consume its input stream\nwithout introducing another source. -/\ndef pipelineSegments? (command : String) : Option (List String) := do\n  let mut parts := []\n  let mut part := \"\"\n  let mut quote := (0 : Nat)\n  let mut escaped := false\n  for c in command.toList do\n    if escaped then\n      part := part.push c\n      escaped := false\n    else if quote == 2 && c == '\\\\' then\n      part := part.push c\n      escaped := true\n    else if quote == 0 && c == '|' then\n      parts := part :: parts\n      part := \"\"\n    else\n      part := part.push c\n      if quote == 1 then\n        if c == '\\'' then quote := 0\n      else if quote == 2 then\n        if c == '\"' then quote := 0\n      else if c == '\\'' then quote := 1\n      else if c == '\"' then quote := 2\n  if quote != 0 || escaped then return ← none\n  pure ((part :: parts).reverse)\n\n/-- Split a literal list of read pipelines. Both sides of `&&` are included:\nan unexecuted right side can only make the dependency set conservative.\nQuotes retain separators in regexes and sed programs. Unsupported operators,\nexpansion and commands are rejected by the subsequent pipeline parser. -/\ndef sequenceSegments? (command : String) : Option (List String) := do\n  let mut parts := []\n  let mut part := \"\"\n  let mut quote := (0 : Nat)\n  let mut ampersand := false\n  let mut afterAnd := false\n  let mut escaped := false\n  for c in command.toList do\n    if escaped then\n      part := part.push c\n      escaped := false\n    else if quote == 2 && c == '\\\\' then\n      part := part.push c\n      escaped := true\n    else if ampersand then\n      if c != '&' then return ← none\n      if part.trimAscii.isEmpty then return ← none\n      parts := part :: parts\n      part := \"\"\n      ampersand := false\n      afterAnd := true\n    else if quote == 0 && c == '&' then\n      ampersand := true\n    else if quote == 0 && (c == ';' || c == '\\n') then\n      if part.trimAscii.isEmpty then return ← none\n      parts := part :: parts\n      part := \"\"\n    else\n      part := part.push c\n      if !c.isWhitespace then afterAnd := false\n      if quote == 1 then\n        if c == '\\'' then quote := 0\n      else if quote == 2 then\n        if c == '\"' then quote := 0\n      else if c == '\\'' then quote := 1\n      else if c == '\"' then quote := 2\n  if quote != 0 || escaped || ampersand || afterAnd then return ← none\n  if !part.trimAscii.isEmpty then parts := part :: parts\n  pure parts.reverse\n\ndef readerFiles? (words : List String) : Option (List String) := do\n  let executable ← words.head?\n  let arguments := words.tail\n  let name := (System.FilePath.mk executable).fileName.getD executable\n  match name with\n  | \"cat\" =>\n      let files := arguments.dropWhile (fun word => [\"--\", \"-n\", \"-b\", \"-s\", \"-v\", \"-E\", \"-T\"].contains word)\n      if files.isEmpty || files.any (fun file => file.startsWith \"-\") then none else some files\n  | \"sed\" =>\n      match arguments with\n      | \"-n\" :: program :: files =>\n          if !files.isEmpty && printProgram program &&\n              !files.any (fun file => file.startsWith \"-\") then some files else none\n      | _ => none\n  | \"rg\" =>\n      let arguments := arguments.dropWhile (fun word =>\n        [\"-n\", \"-l\", \"-i\", \"-S\", \"-F\", \"-w\", \"-s\", \"--fixed-strings\", \"--line-number\",\n          \"--ignore-case\", \"--word-regexp\"].contains word)\n      let files ← match arguments with\n        | \"--\" :: _pattern :: files => some files\n        | pattern :: files => if pattern.startsWith \"-\" then none else some files\n        | _ => none\n      if !files.isEmpty && !files.any (fun file => file.startsWith \"-\") then some files else none\n  | \"nl\" =>\n      match arguments with\n      | [file] | [\"-ba\", file] => if file.startsWith \"-\" then none else some [file]\n      | _ => none\n  | _ => none\n\nstructure ReadPlan where\n  sources : {files : List String // files ≠ []}\n  filters : List StreamFilter\n\ndef pipelineReadPlan? (command : String) : Option ReadPlan := do\n  let segments ← pipelineSegments? command\n  let words ← segments.mapM literalWords?\n  let first ← words.head?\n  let files ← readerFiles? first\n  let filters ← words.tail.mapM streamFilter?\n  if nonempty : files ≠ [] then some ⟨⟨files, nonempty⟩, filters⟩ else none\n\ndef combinedFiles (plans : List ReadPlan) : List String :=\n  (plans.flatMap (·.sources.val)).eraseDups\n\n/-- No accepted pipeline is omitted. A batch can never authorize just its\nrecognizable prefix; parsing all pipelines succeeds before this is called. -/\ndef joinReadPlans? (plans : List ReadPlan) : Option ReadPlan :=\n  if nonempty : combinedFiles plans ≠ [] then\n    some ⟨⟨combinedFiles plans, nonempty⟩, plans.flatMap (·.filters)⟩\n  else none\n\ndef readPlan? (command : String) : Option ReadPlan := do\n  let segments ← sequenceSegments? command\n  let plans ← segments.mapM pipelineReadPlan?\n  joinReadPlans? plans\n\ndef commandFiles? (command : String) : Option (List String) :=\n  (readPlan? command).map (·.sources.val)\n\n/-- Preserve each independently recognized read in a mixed batch. Failure to\ndescribe the entire command does not erase observations of explicitly named\nfiles. This list gives observation targets only, never completion authority. -/\ndef observedCommandFiles (command : String) : List String :=\n  ((sequenceSegments? command).getD []).filterMap pipelineReadPlan? |>.flatMap (·.sources.val) |>.eraseDups\n\ntheorem observed_command_file_from_read (command : String) (file : String)\n    (present : file ∈ observedCommandFiles command) :\n    ∃ segment ∈ (sequenceSegments? command).getD [],\n      ∃ plan, pipelineReadPlan? segment = some plan ∧ file ∈ plan.sources.val := by\n  simp only [observedCommandFiles, List.mem_eraseDups, List.mem_flatMap, List.mem_filterMap] at present\n  obtain ⟨plan, ⟨segment, member, parsed⟩, filePresent⟩ := present\n  exact ⟨segment, member, plan, parsed, filePresent⟩\n\ntheorem accepted_read_plan_dependencies (command : String) (plan : ReadPlan)\n    (accepted : readPlan? command = some plan) :\n    commandFiles? command = some plan.sources.val := by\n  simp [commandFiles?, accepted]\n\ntheorem read_plan_dependencies_nonempty (plan : ReadPlan) : plan.sources.val ≠ [] :=\n  plan.sources.property\n\ntheorem stream_filters_preserve_dependencies (plan : ReadPlan) (filters : List StreamFilter) :\n    ({plan with filters} : ReadPlan).sources = plan.sources := rfl\n\ntheorem combined_files_exact (plans : List ReadPlan) (file : String) :\n    file ∈ combinedFiles plans ↔ ∃ plan ∈ plans, file ∈ plan.sources.val := by\n  simp [combinedFiles, List.mem_flatMap]\n\ntheorem joined_read_plan_dependencies (plans : List ReadPlan) (plan : ReadPlan)\n    (accepted : joinReadPlans? plans = some plan) :\n    plan.sources.val = combinedFiles plans := by\n  unfold joinReadPlans? at accepted\n  split at accepted\n  · cases accepted\n    rfl\n  · contradiction\n\ntheorem joined_read_plan_preserves_every_source (plans : List ReadPlan) (plan : ReadPlan)\n    (accepted : joinReadPlans? plans = some plan) (file : String) :\n    file ∈ plan.sources.val ↔ ∃ pipeline ∈ plans, file ∈ pipeline.sources.val := by\n  rw [joined_read_plan_dependencies plans plan accepted]\n  exact combined_files_exact plans file\n\ndef inputPaths (input : Json) : List String :=\n  let direct := pathsFromInput input ++ ((input.getObjValAs? (List String) \"paths\").toOption.getD [])\n  (if !direct.isEmpty then direct else\n    (((input.getObjValAs? String \"cmd\").toOption.orElse\n      (fun _ => (input.getObjValAs? String \"command\").toOption)).bind commandFiles?).getD []).eraseDups\n\ndef observedInputPaths (input : Json) : List String :=\n  let direct := pathsFromInput input ++ ((input.getObjValAs? (List String) \"paths\").toOption.getD [])\n  (if !direct.isEmpty then direct else\n    (((input.getObjValAs? String \"cmd\").toOption.orElse\n      (fun _ => (input.getObjValAs? String \"command\").toOption)).map observedCommandFiles).getD []).eraseDups\n\ndef inputDirectory? (workspace : System.FilePath) (input : Json) : Option System.FilePath := do\n  let mut directory := workspace\n  let mut specified := false\n  for key in [\"workdir\", \"cwd\"] do\n    if (input.getObjVal? key).isOk then\n      let raw ← (input.getObjValAs? String key).toOption\n      let actual := (workspace / raw).normalize\n      if specified && directory != actual then return ← none\n      directory := actual\n      specified := true\n  pure directory\n\ndef capture (workspace : System.FilePath) (input : Json) (deadline : Nat) : IO Capture := do\n  let paths := observedInputPaths input\n  let uris := (urisFromInput input ++ paths.filter isURI).eraseDups\n  if paths.isEmpty || !uris.isEmpty then return unknown workspace uris\n  let some directory := inputDirectory? workspace input | return unknown workspace\n  let mut probes := []\n  let mut closed := paths == inputPaths input && !paths.isEmpty\n  for path in paths do\n    let some relative := relative? workspace directory path | return unknown workspace\n    -- A named directory is an open search domain, not a failed file read.\n    -- Retain the other sealed file observations; do not traverse the directory.\n    if ← (directory / path).isDir then\n      closed := false\n      continue\n    let some observed ← probe workspace relative deadline | return unknown workspace\n    probes := observed :: probes\n  let completed := probes.reverse\n  let record : Record := ⟨workspace.fileName.getD workspace.toString, completed.map (·.file), [], true, closed⟩\n  if !record.valid then return unknown workspace\n  pure ⟨record, completed⟩\n\ndef sealCapture (workspace : System.FilePath) (capture : Capture) (deadline : Nat) : IO Record := do\n  if capture.record.files != capture.probes.map (·.file) || !capture.record.valid then\n    return {capture.record with complete := false}\n  for probe in capture.probes do\n    if (← IO.monoMsNow) ≥ deadline then return {capture.record with complete := false}\n    unless ← stillCurrent workspace probe do return {capture.record with complete := false}\n  pure capture.record\n\ndef sourceMarker : String := \"EGGSHELL SOURCE\\n\"\n\ndef encode (record : Record) : String := sourceMarker ++ (toJson record).compress\n\ndef decode? (text : String) : Option Record := do\n  if !text.startsWith sourceMarker then none else\n    (Json.parse ((text.drop sourceMarker.length).copy) >>= fromJson?).toOption\n\n/-- Source certificates are separate Exact-only roots. Adding one never\nchanges the identity of an observed Outcome or its semantic search terms. -/\ndef receiptMarker : String := \"eggshell.source\"\ndef receiptPurpose : String := \"observed dependency certificate\"\n\nstructure ReceiptFields (α : Type) where\n  marker : α\n  session : α\n  turn : α\n  tag : α\n  owner : α\n  data : α\n  purpose : α\n\ndef receiptFields? {α : Type} (references : List (Authority × α)) : Option (ReceiptFields α) :=\n  match Relation.exactValues references with\n  | some [marker, session, turn, tag, owner, data, purpose] =>\n      some ⟨marker, session, turn, tag, owner, data, purpose⟩\n  | _ => none\n\ndef receiptArguments (session turn tag owner : Value) (record : Record) : List Ref :=\n  [\n    .exact (.text receiptMarker), .exact session, .exact turn, .exact tag,\n    .exact owner, .exact (.text (encode record)), .exact (.text receiptPurpose)]\n\ndef receipt (session turn tag owner : Value) (record : Record) : Value :=\n  .applyList .receipt (receiptArguments session turn tag owner record)\n\ntheorem receipt_owner_bound (session turn tag owner : Value) (record : Record) :\n    (receiptFields? (receiptArguments session turn tag owner record)).map (·.owner) = some owner := by\n  rfl\n\ndef receiptRecord? (owner value : Value) : Option Record := do\n  match value with\n  | .apply .receipt references =>\n      let fields ← receiptFields? references.toList\n      if fields.marker != .text receiptMarker || fields.purpose != .text receiptPurpose ||\n          fields.owner != owner then none\n      else match fields.data with\n        | .atom bytes => String.fromUTF8? bytes >>= decode?\n        | _ => none\n  | _ => none\n\ntheorem receipt_other_owner_rejected (session turn tag owner other : Value) (record : Record)\n    (different : owner ≠ other) :\n    receiptRecord? other (receipt session turn tag owner record) = none := by\n  simp [receiptRecord?, receipt, receiptArguments, receiptFields?, Relation.exactValues,\n    Value.applyList, Refs.ofList, Refs.toList, Ref.exact, different]\n\n/-- Unknown is a real provenance state, not a successful check with no files. -/\ndef unverified : Record := ⟨\"\", [], [], false, false⟩\n\nabbrev Ledger := Std.HashMap String (Option File)\n\ndef currentFiles? (ledger : Ledger) (files : List File) : Option (List File) :=\n  files.mapM fun file => (ledger[file.relative]?).join\n\ndef recordAgrees (ledger : Ledger) (record : Record) : Bool :=\n  (currentFiles? ledger record.files).any (agrees record)\n\nstructure Authorization (records : List Record) where\n  ledger : Ledger\n  nonempty : records ≠ []\n  checked : ∀ record ∈ records, recordAgrees ledger record = true\n\ndef authorize? (records : List Record) (ledger : Ledger) : Option (Authorization records) :=\n  if checked : (!records.isEmpty && records.all (recordAgrees ledger)) = true then\n    some ⟨ledger, by\n      intro empty\n      simp [empty] at checked,\n      List.all_eq_true.mp (Bool.and_eq_true_iff.mp checked).2⟩ else none\n\ntheorem authorization_uses_observed_ledger (records : List Record) (ledger : Ledger)\n    (authorization : Authorization records)\n    (accepted : authorize? records ledger = some authorization) :\n    authorization.ledger = ledger := by\n  unfold authorize? at accepted\n  split at accepted\n  · cases accepted\n    rfl\n  · contradiction\n\n/-- A currently named file/directory must occur in the selected sources under\nthe same relative locator, not merely with a matching basename or bytes. -/\ndef targetAgreement (targets : List String) (records : List Record) : Bool :=\n  targets.all fun target => (records.flatMap (·.files)).any fun file =>\n    file.relative == target || file.relative.startsWith (target ++ \"/\")\n\ntheorem target_agreement_has_each_locator (targets : List String) (records : List Record)\n    (accepted : targetAgreement targets records = true) (target : String) (present : target ∈ targets) :\n    ∃ file ∈ records.flatMap (·.files), file.relative == target ||\n      file.relative.startsWith (target ++ \"/\") := by\n  have covered := List.all_eq_true.mp accepted target present\n  simpa only [List.any_eq_true] using covered\n\ndef workTargets? (workspace : System.FilePath) (work : String) : Option (List String) := do\n  let lines := work.splitOn \"\\n\"\n  let input ← (Json.parse (\"\\n\".intercalate lines.tail)).toOption\n  let paths := inputPaths input\n  if paths.isEmpty || !(urisFromInput input).isEmpty || paths.any isURI then none else do\n    let directory ← inputDirectory? workspace input\n    paths.mapM fun path => (relative? workspace directory path).map (·.text)\n\ntheorem authorization_has_current_dependencies (authorization : Authorization records)\n    (record : Record) (present : record ∈ records) :\n    ∃ current, currentFiles? authorization.ledger record.files = some current ∧\n      record.valid = true ∧ current = record.files := by\n  have accepted := authorization.checked record present\n  cases observed : currentFiles? authorization.ledger record.files with\n  | none => simp [recordAgrees, observed] at accepted\n  | some current =>\n      refine ⟨current, rfl, ?_⟩\n      simpa [recordAgrees, observed, agrees] using accepted\n\ninductive ProbeStatus where\n  | checked | unverified | timedOut\n  deriving BEq, ToJson\n\ninductive RecordStatus where\n  | matched | changed | unverified | timedOut | external\n  deriving BEq, ToJson\n\nstructure FileCheck where\n  relative : String\n  status : ProbeStatus\n  deriving ToJson\n\nstructure RecordCheck where\n  ordinal : Nat\n  status : RecordStatus\n  deriving ToJson\n\nstructure Observation where\n  ledger : Ledger\n  files : Array FileCheck\n  records : Array RecordCheck\n  startedMs : Nat\n  finishedMs : Nat\n  deadlineMs : Nat\n\ndef Observation.receipt (observation : Observation) : Json := Json.mkObj [\n  (\"startedMs\",toJson observation.startedMs),(\"finishedMs\",toJson observation.finishedMs),\n  (\"deadlineMs\",toJson observation.deadlineMs),\n  (\"elapsedMs\",toJson (observation.finishedMs-observation.startedMs)),\n  (\"files\",toJson observation.files),(\"records\",toJson observation.records)]\n\ndef recordStatus (ledger : Ledger) (failures : Std.HashMap String ProbeStatus) (record : Record) : RecordStatus :=\n  if !record.uris.isEmpty then .external\n  else if !record.valid then .unverified\n  else if recordAgrees ledger record then .matched\n  else if record.files.any (fun file => (ledger[file.relative]?).join.any (· != file)) then .changed\n  else if record.files.any (fun file => failures[file.relative]? == some .timedOut) then .timedOut\n  else .unverified\n\ntheorem matched_status_has_checked_dependencies (ledger : Ledger)\n    (failures : Std.HashMap String ProbeStatus) (record : Record)\n    (matched : recordStatus ledger failures record = .matched) : recordAgrees ledger record = true := by\n  unfold recordStatus at matched\n  split at matched <;> try contradiction\n  split at matched <;> try contradiction\n  split at matched\n  · assumption\n  · split at matched <;> try contradiction\n    split at matched <;> contradiction\n\ntheorem external_status_never_matches (ledger : Ledger)\n    (failures : Std.HashMap String ProbeStatus) (record : Record)\n    (external : record.uris.isEmpty = false) : recordStatus ledger failures record = .external := by\n  simp [recordStatus,external]\n\n/-- Request-local observation is shared by all selected owners. A failed or\nexpired probe stays unknown, independently of a definite changed fingerprint.\nThe diagnostic states never populate the authorization ledger. -/\ndef observeRecords (workspace : System.FilePath) (records : List Record) (deadline : Nat) :\n    IO Observation := do\n  let startedMs ← IO.monoMsNow\n  let mut observations : Std.HashMap String (Option Probe) := {}\n  let mut failures : Std.HashMap String ProbeStatus := {}\n  for record in records do\n    if !record.valid then continue\n    for file in record.files do\n      if observations.contains file.relative then continue\n      let some relative := Relative.check? file.relative | continue\n      let observed ← probe workspace relative deadline\n      observations := observations.insert file.relative observed\n      if observed.isNone then\n        failures := failures.insert file.relative (if (← IO.monoMsNow) ≥ deadline then .timedOut else .unverified)\n  let mut ledger : Ledger := {}\n  for (relative, observed) in observations.toList do\n    let checked ← checkedProbeFile workspace observed deadline\n    ledger := ledger.insert relative checked\n    if checked.isNone && !failures.contains relative then\n      failures := failures.insert relative (if (← IO.monoMsNow) ≥ deadline then .timedOut else .unverified)\n  let files := ledger.toArray.map fun (relative,current) =>\n    ({relative,status := if current.isSome then .checked else failures[relative]?.getD .unverified} : FileCheck)\n  return {\n    ledger,files := files.qsort (fun a b => a.relative < b.relative)\n    records := records.toArray.mapIdx (fun ordinal record => ⟨ordinal,recordStatus ledger failures record⟩)\n    startedMs,finishedMs := ← IO.monoMsNow,deadlineMs := deadline}\n\n/-- Delivery status replaces the previous observation for the same selected\nsource scope. Graph delivery and completion keys use separate namespaces. -/\ndef deliveryScope? (key : String) : Option String :=\n  match key.splitOn \":\" with\n  | [\"s\", scope, status] => if scope.isEmpty || status.isEmpty then none else some scope\n  | _ => none\n\nend Eggshell.SourceEvidence\n"],["SearchUnicode.lean","module\n\npublic import Std\n\n@[expose] public section\n\nnamespace Eggshell.SearchUnicode\n\n/-- Frozen Unicode 16.0.0 mappings from the previous provider. -/\ndef foldBlock0 : Array (Nat × String) := #[\n  (65, \"a\"),\n  (66, \"b\"),\n  (67, \"c\"),\n  (68, \"d\"),\n  (69, \"e\"),\n  (70, \"f\"),\n  (71, \"g\"),\n  (72, \"h\"),\n  (73, \"i\"),\n  (74, \"j\"),\n  (75, \"k\"),\n  (76, \"l\"),\n  (77, \"m\"),\n  (78, \"n\"),\n  (79, \"o\"),\n  (80, \"p\"),\n  (81, \"q\"),\n  (82, \"r\"),\n  (83, \"s\"),\n  (84, \"t\"),\n  (85, \"u\"),\n  (86, \"v\"),\n  (87, \"w\"),\n  (88, \"x\"),\n  (89, \"y\"),\n  (90, \"z\"),\n  (181, \"μ\"),\n  (192, \"à\"),\n  (193, \"á\"),\n  (194, \"â\"),\n  (195, \"ã\"),\n  (196, \"ä\"),\n  (197, \"å\"),\n  (198, \"æ\"),\n  (199, \"ç\"),\n  (200, \"è\"),\n  (201, \"é\"),\n  (202, \"ê\"),\n  (203, \"ë\"),\n  (204, \"ì\"),\n  (205, \"í\"),\n  (206, \"î\"),\n  (207, \"ï\"),\n  (208, \"ð\"),\n  (209, \"ñ\"),\n  (210, \"ò\"),\n  (211, \"ó\"),\n  (212, \"ô\"),\n  (213, \"õ\"),\n  (214, \"ö\"),\n 
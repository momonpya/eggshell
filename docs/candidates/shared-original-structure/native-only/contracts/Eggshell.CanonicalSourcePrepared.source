["module\n\npublic import Eggshell.CanonicalSourceCache\npublic import Eggshell.CanonicalSourceDelivery\npublic import Std.Sync.Mutex\npublic import Init.System.Promise\n\n@[expose] public section\n\nnamespace Eggshell.Synapses.CanonicalSource.Shared\nopen Lean DB\n\ndef allOwners (registry : Registry) : Std.HashSet (String × String) := Id.run do\n  let mut allowed : Std.HashSet (String × String) := {}\n  for (_,atom) in registry.atoms do\n    for origin in atom.origins do\n      allowed := allowed.insert (origin.binding.database,origin.binding.owner)\n  return allowed\n\nstructure Loaded where\n  ready : Cache.Ready\n  owners : Std.HashMap String (Array StoredRow)\n  exact : owners = Delivery.byOwner ready.registry (allOwners ready.registry)\n  /-- Opened once for the pinned preparation, sharing the bounded PageMap\n  -- block cache across sessions. No per-session original record rebuild. -/\n  originals : Option Index.Reader := none\n\n/-- All owners are projected once. Filtering the request then performs point\nlookups; neither a full registry nor another customer's state crosses the wire. -/\ndef Loaded.make (ready : Cache.Ready) : Loaded :=\n  ⟨ready,Delivery.byOwner ready.registry (allOwners ready.registry),rfl,none⟩\n\ntheorem Loaded.lookup_exact (loaded : Loaded) (owner : String) :\n    loaded.owners[owner]? =\n      (Delivery.byOwner loaded.ready.registry (allOwners loaded.ready.registry))[owner]? := by\n  rw [loaded.exact]\n\ndef Loaded.rows (loaded : Loaded) (owners : Array String) : Array (String × Array StoredRow) :=\n  owners.map fun owner => (owner,loaded.owners[owner]?.getD #[])\n\ntheorem Loaded.requested_domain (loaded : Loaded) (owners : Array String) :\n    (loaded.rows owners).map Prod.fst = owners := by\n  simp [Loaded.rows,Array.map_map,Function.comp_def]\n\nstructure Budget (capacity : Nat) where\n  used : Nat := 0\n  within : used ≤ capacity := by omega\n\ndef Budget.reserve? (budget : Budget capacity) (amount : Nat) : Option (Budget capacity) :=\n  if fits : budget.used+amount ≤ capacity then some ⟨budget.used+amount,fits⟩ else none\n\ndef Budget.release (budget : Budget capacity) (amount : Nat) : Budget capacity :=\n  ⟨budget.used-amount,Nat.le_trans (Nat.sub_le ..) budget.within⟩\n\ntheorem Budget.reserved_within (budget next : Budget capacity) (amount : Nat)\n    (_reserved : budget.reserve? amount = some next) : next.used ≤ capacity := next.within\n\n-- The original-recipe cache is global across entries and shares this service\n-- budget; it is not another 16 MiB reservation for each DB or connection.\ndef capacity : Nat := 512*1024*1024-ObservedRecordView.geometryCapacity\ndef maxLoads : Nat := 2\ndef maxEntries : Nat := 128\n\nstructure Entry where\n  promise : IO.Promise (Except String Loaded)\n  charge : Nat\n  borrowers : Nat\n  stamp : Nat\n  serial : Nat\n  loading : Bool := true\n\nstructure State where\n  entries : Std.HashMap String Entry := {}\n  budget : Budget capacity := {}\n  active : Nat := 0\n  clock : Nat := 0\n  closed : Bool := false\n  loads : Nat := 0\n  hits : Nat := 0\n  joins : Nat := 0\n  evictions : Nat := 0\n  readBytes : Nat := 0\n\nstructure Pool where\n  state : Std.Mutex State\n  tasks : Std.Mutex (Array (Task (Except IO.Error Unit)))\n\ndef Pool.new : IO Pool := return ⟨← Std.Mutex.new {},← Std.Mutex.new #[]⟩\n\ninductive Admission where\n  | borrowed (entry : Entry)\n  | start (entry : Entry)\n  | busy\n\ndef evict (state : State) : Option State := do\n  let idle := state.entries.toArray.filter fun (_,entry) => !entry.loading && entry.borrowers == 0\n  let (key,entry) ← (idle.qsort fun a b => a.2.stamp < b.2.stamp)[0]?\n  return {state with\n    entries := state.entries.erase key\n    budget := state.budget.release entry.charge\n    evictions := state.evictions+1}\n\ndef reclaim (state : State) (charge : Nat) : Nat → State\n  | 0 => state\n  | fuel+1 =>\n      if state.budget.used+charge ≤ capacity && state.entries.size < maxEntries then state else\n      match evict state with\n      | none => state\n      | some next => reclaim next charge fuel\n\ndef State.borrow? (state : State) (key : String) : Option (State × Entry) := do\n  let entry ← state.entries[key]?\n  let entry := {entry with borrowers := entry.borrowers+1,stamp := state.clock+1}\n  return ({state with\n    entries := state.entries.insert key entry\n    clock := state.clock+1\n    hits := state.hits + (if entry.loading then 0 else 1)\n    joins := state.joins + (if entry.loading then 1 else 0)},entry)\n\ndef Pool.borrow? (pool : Pool) (key : String) : IO (Option Entry) := pool.state.atomically do\n  let state ← get\n  unless !state.closed do throw (IO.userError \"prepared source service is closed\")\n  let some (next,entry) := state.borrow? key | return none\n  set next\n  return some entry\n\ndef Pool.admit (pool : Pool) (key : String) (charge : Nat) : IO Admission := pool.state.atomically do\n  let state ← get\n  unless !state.closed do throw (IO.userError \"prepared source service is closed\")\n  if let some (state,entry) := state.borrow? key then\n    set state\n    return .borrowed entry\n  if state.active ≥ maxLoads then return .busy\n  let state := reclaim state charge maxEntries\n  if state.active ≥ maxLoads || state.entries.size ≥ maxEntries then\n    set state\n    return .busy\n  let some budget := state.budget.reserve? charge | set state; return .busy\n  let entry : Entry := ⟨← IO.Promise.new,charge,1,state.clock+1,state.clock+1,true⟩\n  set {state with\n    entries := state.entries.insert key entry\n    budget\n    clock := state.clock+1\n    active := state.active+1\n    loads := state.loads+1}\n  return .start entry\n\ndef Pool.release (pool : Pool) (key : String) (serial : Nat) : IO Unit := pool.state.atomically do\n  modify fun state => match state.entries[key]? with\n    | none => state\n    | some entry => if entry.serial != serial then state else\n        {state with entries := state.entries.insert key {entry with borrowers := entry.borrowers-1}}\n\ndef Pool.finish (pool : Pool) (key : String) (entry : Entry)\n    (bytes : Nat) (result : Except String Loaded) : IO Unit := pool.state.atomically do\n  let state ← get\n  if !state.closed then\n    match state.entries[key]? with\n    | none => pure ()\n    | some current =>\n        if current.serial != entry.serial then pure () else match result with\n        | .ok _ => set {state with\n            active := state.active-1\n            readBytes := state.readBytes+bytes\n            entries := state.entries.insert key {current with loading := false}}\n        | .error _ => set {state with\n            active := state.active-1\n            entries := state.entries.erase key\n            budget := state.budget.release current.charge}\n  unless ← entry.promise.isResolved do entry.promise.resolve result\n\n/-- Closing and launching share the same short ownership lock. A requester\ncannot spawn a preparation after close has retired its task registry. -/\ndef Pool.launch (pool : Pool) (identity : String) (entry : Entry) (bytes : Nat)\n    (load : IO Loaded) : IO Unit := pool.state.atomically do\n  let state ← get\n  if state.closed then\n    unless ← entry.promise.isResolved do entry.promise.resolve (.error \"prepared source service stopped\")\n    return\n  let task ← IO.asTask (do\n    let result ← try pure (.ok (← load) : Except String Loaded)\n      catch error => pure (.error error.toString)\n    pool.finish identity entry bytes result) .dedicated\n  pool.tasks.atomically do\n    let live ← (← get).filterM fun task => return !(← IO.hasFinished task)\n    set (live.push task)\n\ndef key (path : System.FilePath) (metadata : Cache.Manifest) : String :=\n  (toJson (path.normalize.toString,metadata)).compress\n\ninductive Reuse where\n  | loaded | joined | hit\n  deriving BEq, ToJson, FromJson\n\n/-- A read capability names one source scope and immutable preparation.\nOnly its non-secret identity belongs in a delivery/memo receipt. -/\nstructure Access where\n  database : String\n  scope : String\n  capability : String\n  source : PageMap.Head\n  metadata : Cache.Manifest\n  reuse : Reuse\n  deriving ToJson, FromJson\n\ndef Access.identity (access : Access) : Json :=\n  toJson (access.database,access.scope,access.source,access.metadata)\n\ntheorem Access.capability_not_identity (access : Access) (secret : String) :\n    ({access with capability := secret}).identity = access.identity := rfl\n\nstructure Projection where\n  identity : Json\n  rows : Array (String × Array StoredRow)\n  reuse : Reuse\n  deriving ToJson, FromJson\n\n/-- Payload bytes are verified only by the preparation owner. Admission\ncharges a conservative footprint including decoder and origin-index overhead;\nthe process RSS limit is measured independently of this accounting. -/\ndef Pool.acquire (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)\n    (metadata : Cache.Manifest) (deadline : Nat) : IO (Entry × Reuse) := do\n  unless (← IO.monoMsNow) < deadline do throw (IO.userError \"prepared source request expired\")\n  let identity := key path metadata\n  if let some entry ← pool.borrow? identity then\n    return (entry,if entry.loading then .joined else .hit)\n  let payload := path / (metadata.payload ++ \".json\")\n  let bytes := (← payload.metadata).byteSize.toNat\n  unless bytes ≤ 32*1024*1024 do throw (IO.userError \"prepared source payload exceeds its bound\")\n  -- Include the original view's bounded page cache in service admission.\n  let charge := bytes*8+metadata.rows*1024+65536+256*1024*1024\n  unless charge ≤ capacity do throw (IO.userError \"prepared source footprint exceeds service capacity\")\n  repeat\n    unless (← IO.monoMsNow) < deadline do throw (IO.userError \"prepared source admission expired\")\n    match ← pool.admit identity charge with\n    | .busy => IO.sleep 1\n    | .borrowed entry => return (entry,if entry.loading then .joined else .hit)\n    | .start entry =>\n        try\n          pool.launch identity entry bytes do\n            let some ready ← Cache.atSource? source path metadata |\n              throw (IO.userError \"prepared source no longer matches its publication\")\n            return {Loaded.make ready with originals := ← Index.openShared? source}\n        catch error => pool.finish identity entry 0 (.error error.toString)\n        return (entry,.loaded)\n  throw (IO.userError \"unreachable prepared source admission\")\n\ndef Pool.withReady (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)\n    (metadata : Cache.Manifest) (deadline : Nat) (use : Loaded → Reuse → IO α) : IO α := do\n  let identity := key path metadata\n  let (entry,reuse) ← pool.acquire source path metadata deadline\n  try\n    repeat\n      unless (← IO.monoMsNow) < deadline do throw (IO.userError \"prepared source wait expired\")\n      if ← entry.promise.isResolved then\n        let some result := entry.promise.result?.get | throw (IO.userError \"prepared source reply missing\")\n        return ← use (← IO.ofExcept result) reuse\n      IO.sleep 1\n    throw (IO.userError \"unreachable prepared source wait\")\n  finally pool.release identity entry.serial\n\ndef Pool.close (pool : Pool) : IO Unit := do\n  pool.state.atomically do\n    let state ← get\n    set {state with closed := true,entries := {},budget := {},active := 0}\n    for (_,entry) in state.entries do\n      unless ← entry.promise.isResolved do entry.promise.resolve (.error \"prepared source service stopped\")\n  for task in ← pool.tasks.atomically get do IO.cancel task\n\ndef Pool.stats (pool : Pool) : IO Json := pool.state.atomically do\n  let state ← get\n  return Json.mkObj [(\"entries\",toJson state.entries.size),(\"chargedBytes\",toJson state.budget.used),\n    (\"capacity\",toJson capacity),(\"active\",toJson state.active),(\"loads\",toJson state.loads),\n    (\"hits\",toJson state.hits),(\"joins\",toJson state.joins),(\"evictions\",toJson state.evictions),\n    (\"verifiedPayloadBytes\",toJson state.readBytes),(\"closed\",toJson state.closed),\n    (\"accountedExact\",toJson (state.budget.used ==\n      state.entries.fold (fun total _ entry => total+entry.charge) 0))]\n\nend Eggshell.Synapses.CanonicalSource.Shared\n",[]]
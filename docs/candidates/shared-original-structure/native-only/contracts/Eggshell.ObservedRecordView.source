["module\npublic import Eggshell.ObservedRecords\npublic import Eggshell.OriginalStructure\npublic import Std.Sync.Mutex\n@[expose] public section\n\nnamespace Eggshell.Synapses.ObservedRecordView\nopen Lean DB _root_.Eggshell.Synapses.Extraction\n\n/-- Query-free structure from the original observation catalogue. File aliases\nand command syntax are not prerequisites for retaining any original byte. -/\nabbrev Span := Plugin.OriginalStructure.Span\n\nstructure Header where\n  database : String\n  owner : String\n  work : String\n  original : Original\n  occurrences : Array Occurrence\n  characters : Nat\n  blocks : Nat\n  recipes : Nat\n  deriving BEq, ToJson, FromJson\n\nstructure Geometry where\n  header : Header\n  spans : Array Span\n  deriving ToJson, FromJson\n\nstructure View where\n  header : Header\n  spans : Array Span\n  blocks : Array String\n  deriving ToJson, FromJson\n\nstructure Block where\n  text : String\n  spans : Array Span\n  deriving ToJson, FromJson\n\ndef ownerKey (owner : String) := \"observed-view:owner:\" ++ owner\ndef blockKey (digest : String) := \"observed-view:block:\" ++ digest\ndef blockRef (owner : String) (index : Nat) := \"observed-view:ref:\" ++ owner ++ \":\" ++ toString index\ndef blockChars := ObservedRecords.chunkChars\ndef recipeSize := 128\ndef recipeKey (digest : String) := \"observed-view:recipe:\" ++ digest\ndef recipeRef (owner : String) (index : Nat) := \"observed-view:recipe-ref:\" ++ owner ++ \":\" ++ toString index\n\ndef make (database : String) (document : Document) : Except String View := do\n  unless document.native && !document.occurrences.isEmpty do throw \"missing original observation authority\"\n  let some raw := document.source | throw \"missing original observation body\"\n  let characters := raw.toList.toArray\n  let spans := Plugin.OriginalStructure.prepare raw\n  unless Plugin.OriginalStructure.complete characters.size spans do\n    throw \"original recipe domain omitted source positions\"\n  let blocks := (ObservedRecords.base characters.size).map fun record =>\n    String.ofList (characters.extract record.first record.limit).toList\n  return ⟨⟨database,document.owner,document.work,ObservationContext.originalSubject document.work raw,\n    document.occurrences,characters.size,blocks.size,spans.size⟩,spans,blocks⟩\n\n/-- The payload is copied exactly once into bounded content-addressed blocks.\nThe source publication, original digest and observation identities stay in\nthe directory, independently of payload sharing. -/\ndef stage (writer : PageMap.Writer) (database : String) (document : Document) : IO Unit := do\n  let view ← IO.ofExcept (make database document)\n  for index in [:view.blocks.size] do\n    let block : Block := ⟨view.blocks[index]!,#[]⟩\n    let bytes := (toJson block).compress.toUTF8\n    unless bytes.size ≤ 60000 do throw (IO.userError \"original view block exceeds page bound\")\n    let digest := Sha256.hex bytes\n    if let some previous ← writer.get (blockKey digest) then\n      unless previous == bytes do throw (IO.userError \"conflicting original view block\")\n    else writer.put (blockKey digest) (some bytes)\n    writer.put (blockRef document.owner index) (some digest.toUTF8)\n  for page in [: (view.spans.size+recipeSize-1)/recipeSize] do\n    let spans := view.spans.extract (page*recipeSize) ((page+1)*recipeSize)\n    let bytes := (toJson spans).compress.toUTF8\n    unless bytes.size ≤ 16384 do throw (IO.userError \"original recipe page exceeds its bound\")\n    let digest := Sha256.hex bytes\n    if let some previous ← writer.get (recipeKey digest) then\n      unless previous == bytes do throw (IO.userError \"conflicting original recipe page\")\n    else writer.put (recipeKey digest) (some bytes)\n    writer.put (recipeRef document.owner page) (some digest.toUTF8)\n  let bytes := (toJson view.header).compress.toUTF8\n  unless bytes.size ≤ 16384 do throw (IO.userError \"original view directory exceeds its byte bound\")\n  writer.put (ownerKey document.owner) (some bytes)\n\ndef geometry? (index : PageMap.Snapshot) (database owner : String) (deadline : Nat) : IO (Option Geometry) := do\n  let some bytes ← index.get (ownerKey owner) | return none\n  unless bytes.size ≤ 16384 do throw (IO.userError \"oversized original view directory\")\n  let header ← ObservedRecords.decode (α := Header) bytes\n  unless header.database == database && header.owner == owner &&\n      header.occurrences.all Occurrence.valid && !header.occurrences.isEmpty &&\n      header.blocks == (header.characters+blockChars-1)/blockChars do\n    throw (IO.userError \"foreign or invalid original view directory\")\n  let mut spans := #[]\n  for page in [: (header.recipes+recipeSize-1)/recipeSize] do\n    unless (← IO.monoMsNow) < deadline do throw (IO.userError \"original recipe acquisition expired\")\n    let some pointer ← index.get (recipeRef owner page) | throw (IO.userError \"missing original recipe pointer\")\n    let some digest := String.fromUTF8? pointer | throw (IO.userError \"invalid original recipe pointer\")\n    let some bytes ← index.get (recipeKey digest) | throw (IO.userError \"missing original recipe page\")\n    unless bytes.size ≤ 16384 && Sha256.hex bytes == digest do throw (IO.userError \"invalid original recipe digest\")\n    let rows ← ObservedRecords.decode (α := Array Span) bytes\n    unless rows.size == min recipeSize (header.recipes-page*recipeSize) && rows.all (fun span =>\n        span.first < span.limit && span.limit ≤ header.characters && span.limit-span.first ≤ blockChars) do\n      throw (IO.userError \"invalid original recipe extent\")\n    spans := spans ++ rows\n  unless Plugin.OriginalStructure.complete header.characters spans do\n    throw (IO.userError \"stored original recipe domain is incomplete\")\n  return some ⟨header,spans⟩\n\ndef load? (index : PageMap.Snapshot) (database owner : String) : IO (Option View) := do\n  let some geometry ← geometry? index database owner ((← IO.monoMsNow)+30000) | return none\n  let header := geometry.header\n  let mut blocks := #[]\n  for position in [:header.blocks] do\n    let some pointer ← index.get (blockRef owner position) | throw (IO.userError \"missing original block pointer\")\n    let some digest := String.fromUTF8? pointer | throw (IO.userError \"invalid original block pointer\")\n    let some bytes ← index.get (blockKey digest) | throw (IO.userError \"missing original view block\")\n    unless bytes.size ≤ 60000 && Sha256.hex bytes == digest do\n      throw (IO.userError \"invalid original view block digest\")\n    let block ← ObservedRecords.decode (α := Block) bytes\n    let text := block.text\n    unless text.length == min blockChars (header.characters-position*blockChars) do\n      throw (IO.userError \"invalid original view character extent\")\n    unless block.spans.all (fun span => span.first < span.limit && span.limit ≤ header.characters &&\n        span.limit-span.first ≤ blockChars && span.first < (position+1)*blockChars && position*blockChars < span.limit) do\n      throw (IO.userError \"invalid original view record interval\")\n    blocks := blocks.push text\n  return some ⟨header,geometry.spans,blocks⟩\n\ndef geometryCapacity : Nat := 16*1024*1024\n\nstructure CachedGeometry where\n  geometry : Option Geometry\n  charge : Nat\n  stamp : Nat\n\nstructure CacheState where\n  entries : Std.HashMap String CachedGeometry := {}\n  bytes : Nat := 0\n  clock : Nat := 0\n  loads : Nat := 0\n  hits : Nat := 0\n\n/-- One bounded metadata cache is shared across all source scopes. A miss is\nsingle-flight under this short metadata lock; no payload block is decoded. -/\nabbrev Cache := Std.Mutex CacheState\n\ndef Cache.new : IO Cache := Std.Mutex.new {}\n\ndef Cache.acquire (cache : Cache) (index : PageMap.Snapshot) (database owner : String) (deadline : Nat) :\n    IO (Option Geometry) := cache.atomically do\n  unless (← IO.monoMsNow) < deadline do throw (IO.userError \"original recipe cache wait expired\")\n  let identity := (toJson (index.head,database,owner)).compress\n  let state ← get\n  let clock := state.clock+1\n  if let some found := state.entries[identity]? then\n    set {state with\n      clock,hits := state.hits+1\n      entries := state.entries.insert identity {found with stamp := clock}}\n    return found.geometry\n  let found ← geometry? index database owner deadline\n  let charge := (toJson found).compress.utf8ByteSize*4+256\n  let mut state := {state with clock,loads := state.loads+1}\n  if charge ≤ geometryCapacity then\n    while state.bytes+charge > geometryCapacity || state.entries.size ≥ 512 do\n      let some (key,value) := (state.entries.toArray.qsort fun a b => a.2.stamp < b.2.stamp)[0]? |\n        throw (IO.userError \"original recipe cache accounting failed\")\n      state := {state with entries := state.entries.erase key,bytes := state.bytes-value.charge}\n    state := {state with entries := state.entries.insert identity ⟨found,charge,clock⟩,bytes := state.bytes+charge}\n  set state\n  return found\n\ndef Cache.stats (cache : Cache) : IO Json := cache.atomically do\n  let state ← get\n  return Json.mkObj [(\"loads\",toJson state.loads),(\"hits\",toJson state.hits),\n    (\"chargedBytes\",toJson state.bytes),(\"capacity\",toJson geometryCapacity),\n    (\"entries\",toJson state.entries.size)]\n\nstructure Projection where\n  source : PageMap.Head\n  rows : Array (String × Option Geometry)\n  cache : Json\n  deriving ToJson, FromJson\n\n/-- A point extraction reads only intersecting blocks; it never walks the\nprefix of the owner's body or repeats JSON parsing/record normalization. -/\ndef View.slice (view : View) (first limit : Nat) : Option String := do\n  unless first < limit && limit ≤ view.header.characters do none\n  let start := first/blockChars\n  let stop := (limit-1)/blockChars+1\n  let mut parts := []\n  for index in [start:stop] do\n    let block ← view.blocks[index]?\n    let a := first-index*blockChars\n    let b := min blockChars (limit-index*blockChars)\n    parts := String.ofList (block.toList.drop a |>.take (b-a)) :: parts\n  return \"\".intercalate parts.reverse\n\nstructure Piece where\n  span : Span\n  original : String\n  deriving BEq, ToJson, FromJson\n\n/-- Only intersecting prepared records are offered. The base partition is\nalways available for bytes outside a structural record; no input shape can\nmake an original region disappear. The caller retains query priorities. -/\ndef View.pieces (view : View) (first limit : Nat) : Array Piece := Id.run do\n  if first ≥ limit || limit > view.header.characters then return #[]\n  let spans := (view.spans.filter fun span => span.first < limit && first < span.limit).qsort fun a b => a.first < b.first\n  let mut cursor := first\n  let mut all := spans\n  for span in spans do\n    if cursor < span.first then\n      for record in ObservedRecords.base view.header.characters do\n        let a := max cursor record.first\n        let b := min span.first record.limit\n        if a < b then all := all.push ⟨a,b,false⟩\n    cursor := max cursor span.limit\n  if cursor < limit then\n    for record in ObservedRecords.base view.header.characters do\n      let a := max cursor record.first\n      let b := min limit record.limit\n      if a < b then all := all.push ⟨a,b,false⟩\n  return all.filterMap fun span => (view.slice span.first span.limit).map (Piece.mk span)\n\n/-- A delivered piece is tied to the exact stored range. This constructor\ndoes not return any control Match, Union or completion certificate. -/\nstructure CheckedPiece (view : View) where\n  piece : Piece\n  exact : view.slice piece.span.first piece.span.limit = some piece.original\n\ndef Piece.check? (view : View) (piece : Piece) : Option (CheckedPiece view) :=\n  if exact : view.slice piece.span.first piece.span.limit = some piece.original then some ⟨piece,exact⟩ else none\n\ntheorem checked_piece_exact (view : View) (piece : CheckedPiece view) :\n    view.slice piece.piece.span.first piece.piece.span.limit = some piece.piece.original := piece.exact\n\nend Eggshell.Synapses.ObservedRecordView\n",[]]
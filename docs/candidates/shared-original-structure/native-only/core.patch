+def Cache.acquire (cache : Cache) (index : PageMap.Snapshot) (database owner : String) (deadline : Nat) :
+    IO (Option Geometry) := cache.atomically do
+  unless (← IO.monoMsNow) < deadline do throw (IO.userError "original recipe cache wait expired")
+  let identity := (toJson (index.head,database,owner)).compress
+  let state ← get
+  let clock := state.clock+1
+  if let some found := state.entries[identity]? then
+    set {state with
+      clock,hits := state.hits+1
+      entries := state.entries.insert identity {found with stamp := clock}}
+    return found.geometry
+  let found ← geometry? index database owner deadline
+  let charge := (toJson found).compress.utf8ByteSize*4+256
+  let mut state := {state with clock,loads := state.loads+1}
+  if charge ≤ geometryCapacity then
+    while state.bytes+charge > geometryCapacity || state.entries.size ≥ 512 do
+      let some (key,value) := (state.entries.toArray.qsort fun a b => a.2.stamp < b.2.stamp)[0]? |
+        throw (IO.userError "original recipe cache accounting failed")
+      state := {state with entries := state.entries.erase key,bytes := state.bytes-value.charge}
+    state := {state with entries := state.entries.insert identity ⟨found,charge,clock⟩,bytes := state.bytes+charge}
+  set state
+  return found

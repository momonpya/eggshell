["module\npublic import Lean.Data.Json.Parser\npublic import Lean.Data.Json.FromToJson\npublic import tools.PairDecisions\npublic import tools.IndexedCharacters\n@[expose] public section\nnamespace Eggshell.Plugin\nopen Lean\n\n/-- Publication intervals do not require allocating the whole source. -/\nstructure DeliveryInterval where\n  start : Nat\n  stop : Nat\n  ordered : start < stop\n\ndef DeliveryInterval.covers (range : DeliveryInterval) (position : Nat) : Prop :=\n  range.start ≤ position ∧ position < range.stop\n\ndef DeliveryInterval.subtract (range covered : DeliveryInterval) : List DeliveryInterval :=\n  (if ordered : range.start < min range.stop covered.start then\n    [⟨range.start, min range.stop covered.start, ordered⟩] else []) ++\n  (if ordered : max range.start covered.stop < range.stop then\n    [⟨max range.start covered.stop, range.stop, ordered⟩] else [])\n\ntheorem DeliveryInterval.subtract_covers (range covered : DeliveryInterval) (position : Nat) :\n    (∃ part ∈ range.subtract covered, part.covers position) ↔\n      range.covers position ∧ ¬covered.covers position := by\n  have := range.ordered\n  have := covered.ordered\n  unfold subtract\n  split <;> split <;> simp_all [covers] <;> omega\n\ndef DeliveryInterval.subtractAll (range : DeliveryInterval) : List DeliveryInterval → List DeliveryInterval\n  | [] => [range]\n  | first :: rest => (range.subtract first).flatMap (·.subtractAll rest)\n\ntheorem DeliveryInterval.subtractAll_covers (range : DeliveryInterval)\n    (covered : List DeliveryInterval) (position : Nat) :\n    (∃ part ∈ range.subtractAll covered, part.covers position) ↔\n      range.covers position ∧ ∀ prior ∈ covered, ¬prior.covers position := by\n  induction covered generalizing range with\n  | nil => simp [subtractAll]\n  | cons first rest ih =>\n      constructor\n      · rintro ⟨part, member, covers⟩\n        obtain ⟨middle, member, next⟩ := List.mem_flatMap.mp member\n        have tail := (ih middle).mp ⟨part, next, covers⟩\n        have head := (subtract_covers range first position).mp ⟨middle, member, tail.1⟩\n        exact ⟨head.1, by\n          intro prior member\n          rcases List.mem_cons.mp member with equal | member\n          · simpa [equal] using head.2\n          · exact tail.2 prior member⟩\n      · rintro ⟨covers, fresh⟩\n        obtain ⟨middle, member, covers⟩ := (subtract_covers range first position).mpr\n          ⟨covers, fresh first (by simp)⟩\n        obtain ⟨part, next, covers⟩ := (ih middle).mpr\n          ⟨covers, fun prior member => fresh prior (by simp [member])⟩\n        exact ⟨part, List.mem_flatMap.mpr ⟨middle, member, next⟩, covers⟩\n\ndef DeliveryInterval.connected (left right : DeliveryInterval) : Prop :=\n  left.start ≤ right.stop ∧ right.start ≤ left.stop\n\ninstance (left right : DeliveryInterval) : Decidable (left.connected right) :=\n  inferInstanceAs (Decidable (_ ∧ _))\n\ndef DeliveryInterval.join (left right : DeliveryInterval)\n    (_ : left.connected right) : DeliveryInterval :=\n  ⟨min left.start right.start,max left.stop right.stop,\n    by have := left.ordered; have := right.ordered; omega⟩\n\ntheorem DeliveryInterval.join_covers (left right : DeliveryInterval)\n    (connected : left.connected right) (position : Nat) :\n    (left.join right connected).covers position ↔ left.covers position ∨ right.covers position := by\n  simp only [join,covers]\n  unfold DeliveryInterval.connected at connected\n  omega\n\ndef DeliveryInterval.coalesceFrom (current : DeliveryInterval) : List DeliveryInterval → List DeliveryInterval\n  | [] => [current]\n  | next :: rest => if connected : current.connected next then\n      coalesceFrom (current.join next connected) rest\n    else current :: coalesceFrom next rest\n\ntheorem DeliveryInterval.coalesceFrom_covers (current : DeliveryInterval)\n    (rest : List DeliveryInterval) (position : Nat) :\n    (∃ part ∈ coalesceFrom current rest,part.covers position) ↔\n      current.covers position ∨ ∃ part ∈ rest,part.covers position := by\n  induction rest generalizing current with\n  | nil => simp [coalesceFrom]\n  | cons next rest ih =>\n    simp only [coalesceFrom]\n    split\n    · rw [ih,join_covers]; simp [or_assoc]\n    · simp only [List.mem_cons,exists_eq_or_imp]; rw [ih]\n\ndef DeliveryInterval.coalesce (ranges : List DeliveryInterval) : List DeliveryInterval :=\n  match ranges.mergeSort (fun left right => left.start ≤ right.start) with\n  | [] => []\n  | first :: rest => coalesceFrom first rest\n\ntheorem DeliveryInterval.coalesce_covers (ranges : List DeliveryInterval) (position : Nat) :\n    (∃ part ∈ coalesce ranges,part.covers position) ↔ ∃ part ∈ ranges,part.covers position := by\n  have sorted : (∃ part ∈ ranges.mergeSort (fun left right => left.start ≤ right.start),part.covers position) ↔\n      ∃ part ∈ ranges,part.covers position := by simp\n  cases publication : ranges.mergeSort (fun left right => left.start ≤ right.start) with\n  | nil => simpa [coalesce,publication] using sorted\n  | cons first rest => simpa [coalesce,publication,coalesceFrom_covers] using sorted\n\ntheorem DeliveryInterval.subtractAll_empty (range : DeliveryInterval) (prior : List DeliveryInterval) :\n    (range.subtractAll prior).isEmpty = true ↔\n      ¬ ∃ position,range.covers position ∧ ∀ part ∈ prior,¬part.covers position := by\n  constructor\n  · intro empty ⟨position,inside,fresh⟩\n    obtain ⟨part,member,_⟩ := (subtractAll_covers range prior position).mpr ⟨inside,fresh⟩\n    have missing : range.subtractAll prior = [] := List.isEmpty_iff.mp empty\n    simp [missing] at member\n  · intro none\n    cases output : range.subtractAll prior with\n    | nil => rfl\n    | cons part rest =>\n      exfalso\n      apply none\n      have member : part ∈ range.subtractAll prior := by simp [output]\n      exact ⟨part.start,(subtractAll_covers range prior part.start).mp\n        ⟨part,member,Nat.le_refl _,part.ordered⟩⟩\n\ntheorem DeliveryInterval.subtractAll_empty_same_union (range : DeliveryInterval)\n    (left right : List DeliveryInterval)\n    (same : ∀ position,(∃ part ∈ left,part.covers position) ↔ ∃ part ∈ right,part.covers position) :\n    (range.subtractAll left).isEmpty = (range.subtractAll right).isEmpty := by\n  apply Bool.eq_iff_iff.mpr\n  change (range.subtractAll left).isEmpty = true ↔ (range.subtractAll right).isEmpty = true\n  rw [subtractAll_empty,subtractAll_empty]\n  apply not_congr\n  apply exists_congr\n  intro position\n  apply and_congr_right\n  intro _\n  simpa only [not_exists,not_and] using not_congr (same position)\n\n\n/-- A decoded tool string is accepted only when serializing it recreates the\nentire immutable stored value. This changes display, never the Outcome identity. -/\nstructure DecodedToolText (source : String) where\n  text : String\n  exact : (Json.str text).compress = source\n\ndef decodedToolText? (source : String) : Option (DecodedToolText source) := do\n  let .ok (.str text) := Json.parse source | none\n  if exact : (Json.str text).compress = source then some ⟨text, exact⟩ else none\n\n\ntheorem decoded_tool_text_recreates_source (decoded : DecodedToolText source) :\n    (Json.str decoded.text).compress = source := decoded.exact\n\n\n/-- Certified contiguous original characters around a meaning-ranked window.\nThis is evidence for an existing graph owner, not a new Outcome or completion. -/\nstructure EvidenceRange (source : String) where\n  start : Nat\n  stop : Nat\n  ordered : start < stop\n  within : stop ≤ source.length\n  bounded : stop - start ≤ 2048\n\ntheorem EvidenceRange.coordinates_injective (left right : EvidenceRange source)\n    (first : left.start = right.start) (last : left.stop = right.stop) : left = right := by\n  cases left\n  cases right\n  cases first\n  cases last\n  rfl\n\ninstance : BEq (EvidenceRange source) where\n  beq left right := left.start == right.start && left.stop == right.stop\n\ninstance : LawfulBEq (EvidenceRange source) where\n  eq_of_beq := by\n    intro left right same\n    exact EvidenceRange.coordinates_injective left right\n      (eq_of_beq (Bool.and_eq_true_iff.mp same).1) (eq_of_beq (Bool.and_eq_true_iff.mp same).2)\n  rfl := by intro range; simp [BEq.beq]\n\ninstance : Hashable (EvidenceRange source) where\n  hash range := hash (range.start, range.stop)\n\ndef EvidenceRange.text (range : EvidenceRange source) : String :=\n  ((source.drop range.start).take (range.stop - range.start)).copy\n\ntheorem EvidenceRange.source_exact (range : EvidenceRange source) :\n    range.text.toList = (source.toList.drop range.start).take (range.stop - range.start) := by\n  simp [text]\n\ntheorem EvidenceRange.text_bounded (range : EvidenceRange source) :\n    range.text.length ≤ 2048 := by\n  have bounded := range.bounded\n  rw [← String.length_toList, range.source_exact]\n  simp only [List.length_take, List.length_drop, String.length_toList]\n  omega\n\ndef EvidenceRange.around? (source : String) (center : Nat) : Option (EvidenceRange source) :=\n  let start := min (center - 1024) (source.length - 2048)\n  let stop := min source.length (start + 2048)\n  if valid : start < stop ∧ stop ≤ source.length ∧ stop - start ≤ 2048 then\n    some ⟨start, stop, valid.1, valid.2.1, valid.2.2⟩\n  else none\n\n/-- A connected source interval before transport segmentation. Its extent is\nnot a range-count limit: dense meaning positions share one interval, while\nseparate positions keep their individual ownership and numerical priority. -/\nstructure ContextSpan (source : String) where\n  start : Nat\n  stop : Nat\n  ordered : start < stop\n  within : stop ≤ source.length\n\ndef ContextSpan.covers (span : ContextSpan source) (position : Nat) : Prop :=\n  span.start ≤ position ∧ position < span.stop\n\ndef EvidenceRange.covers (range : EvidenceRange source) (position : Nat) : Prop :=\n  range.start ≤ position ∧ position < range.stop\n\ninstance (span : ContextSpan source) (position : Nat) : Decidable (span.covers position) :=\n  inferInstanceAs (Decidable (_ ∧ _))\n\ninstance (range : EvidenceRange source) (position : Nat) : Decidable (range.covers position) :=\n  inferInstanceAs (Decidable (_ ∧ _))\n\n\ndef ContextSpan.ranges (span : ContextSpan source) : List (EvidenceRange source) :=\n  if bounded : span.stop - span.start ≤ 2048 then\n    [⟨span.start, span.stop, span.ordered, span.within, bounded⟩]\n  else\n    let first : EvidenceRange source := ⟨span.start, span.start + 2048,\n      by omega, by have := span.within; omega, by omega⟩\n    let tail : ContextSpan source := ⟨span.start + 2048, span.stop,\n      by omega, span.within⟩\n    first :: tail.ranges\ntermination_by span.stop - span.start\n\n/-- Segmentation is exact even for a dense cluster longer than one transport\nrange. It is not truncation to the first 2048 characters. -/\ntheorem ContextSpan.ranges_cover (span : ContextSpan source) (position : Nat) :\n    (∃ range ∈ span.ranges, range.covers position) ↔ span.covers position := by\n  rw [ContextSpan.ranges]\n  split\n  · simp [EvidenceRange.covers, ContextSpan.covers]\n  · simp only [List.mem_cons, exists_eq_or_imp]\n    rw [ContextSpan.ranges_cover]\n    simp only [EvidenceRange.covers, ContextSpan.covers]\n    omega\ntermination_by span.stop - span.start\n\n\ndef encodedTextBody (text : String) : String :=\n  (((Json.str text).compress.drop 1).dropEnd 1).copy\n\ntheorem encoded_text_body_exact (text : String) :\n    encodedTextBody text =\n      String.ofList (((Json.str text).compress.toList.drop 1).dropLast) := by\n  apply String.ext\n  simp [encodedTextBody, List.dropLast_eq_take]\n\n\ndef encodedCharacterWidths (chars : List Char) : List (Nat × Nat) :=\n  chars.zipIdx.map fun (char, index) => (index, (encodedTextBody (String.singleton char)).length)\n\ndef scalarPrefixHolds (source content : String) (first second : Nat) : Prop :=\n  (source.take first).copy = \"\\\"\" ++ encodedTextBody ((content.take second).copy)\n\ninstance : DecidableRel (scalarPrefixHolds source content) := fun first second =>\n  inferInstanceAs (Decidable ((source.take first).copy =\n    \"\\\"\" ++ encodedTextBody ((content.take second).copy)))\n\ndef scalarPrefixDepth (source content : String) : Nat :=\n  ((source.length + 1) * (content.length + 1)).log2 + 1\n\nabbrev ScalarPrefixMemo (source content : String) :=\n  PairDecisions (scalarPrefixHolds source content) (content.length + 1) (scalarPrefixDepth source content)\n\n/-- Request-local layout of one immutable scalar. The expensive canonical\nencoding of each character is prepared once, not for each budget/range. -/\nstructure DecodedLayout (source : String) where\n  decoded : DecodedToolText source\n  chars : List Char\n  charsExact : chars = decoded.text.toList\n  widths : List (Nat × Nat)\n  widthsExact : widths = encodedCharacterWidths chars\n  original : IndexedCharacters source\n  content : IndexedCharacters decoded.text\n  prefixes : ScalarPrefixMemo source decoded.text\n\ndef DecodedLayout.make (decoded : DecodedToolText source) : DecodedLayout source :=\n  let chars := decoded.text.toList\n  ⟨decoded, chars, rfl, encodedCharacterWidths chars, rfl,\n    IndexedCharacters.make source, ⟨chars.toArray, rfl⟩,\n    PairDecisions.make _ (decoded.text.length + 1) (scalarPrefixDepth source decoded.text)⟩\n\ntheorem DecodedLayout.is_canonical (layout : DecodedLayout source) :\n    layout = make layout.decoded := by\n  cases layout with\n  | mk decoded chars charsExact widths widthsExact original content prefixes =>\n    subst chars\n    subst widths\n    rw [IndexedCharacters.is_canonical original, IndexedCharacters.is_canonical content,\n      PairDecisions.is_canonical prefixes]\n    rfl\n\n/-- Recorded line boundaries in the original scalar, including JSON escape\nwidths. These are presentation spans, not file identity or relevance gates. -/\ndef contextRecordSpans (source : String) (layout : Option (DecodedLayout source)) :\n    List (ContextSpan source) := Id.run do\n  let units := match layout with\n    | some value => value.chars.zip (value.widths.map Prod.snd)\n    | none => source.toList.map fun char => (char, 1)\n  let mut position := if layout.isSome then 1 else 0\n  let mut first := position\n  let mut spans := []\n  for (char, width) in units do\n    position := position + width\n    if char == '\\n' then\n      if valid : first < position ∧ position ≤ source.length then\n        spans := (⟨first, position, valid.1, valid.2⟩ : ContextSpan source) :: spans\n      first := position\n  if valid : first < position ∧ position ≤ source.length then\n    spans := (⟨first, position, valid.1, valid.2⟩ : ContextSpan source) :: spans\n  return spans.reverse\n\n\n/-- Prefer complete adjacent records when they fit one bounded range. A very\nlong single record retains the explicitly partial original representation. -/\ndef recordContextRange (records : List (ContextSpan source)) (range : EvidenceRange source) :\n    EvidenceRange source :=\n  let start := ((records.find? fun record =>\n    record.start ≤ range.start && range.start < record.stop).map (·.start)).getD range.start\n  let stop := ((records.find? fun record =>\n    record.start < range.stop && range.stop ≤ record.stop).map (·.stop)).getD range.stop\n  if valid : start ≤ range.start ∧ range.stop ≤ stop ∧ start < stop ∧\n      stop ≤ source.length ∧ stop - start ≤ 2048 then\n    ⟨start, stop, valid.2.2.1, valid.2.2.2.1, valid.2.2.2.2⟩\n  else range\n\ntheorem record_context_retains_original (records : List (ContextSpan source))\n    (range : EvidenceRange source) (position : Nat) (covered : range.covers position) :\n    (recordContextRange records range).covers position := by\n  unfold recordContextRange\n  dsimp only\n  split\n  · rename_i bounds\n    simp only [EvidenceRange.covers] at *\n    exact ⟨Nat.le_trans bounds.1 covered.1, Nat.lt_of_lt_of_le covered.2 bounds.2.1⟩\n  · exact covered\n\n\n/-- Original offsets are accumulated while scanning, including canonical\nJSON escape widths. Numbered tool-output gaps reset the structural hint, so\nan earlier file or disjoint read cannot supply the next section's header. -/\ndef contextStructureHeads (source : String) (layout : Option (DecodedLayout source))\n    (scopeLabels : Bool := false) :\n    List (Nat × Option Nat) := Id.run do\n  let units := match layout with\n    | some value => value.chars.zip (value.widths.map Prod.snd)\n    | none => source.toList.map fun char => (char, 1)\n  let mut position := if layout.isSome then 1 else 0\n  let mut first := position\n  let mut line : List Char := []\n  let mut rows : List (Nat × String) := []\n  for (char, width) in units do\n    if char == '\\n' then\n      rows := (first, String.ofList line.reverse) :: rows\n      line := []\n      first := position + width\n    else line := char :: line\n    position := position + width\n  if !line.isEmpty then rows := (first, String.ofList line.reverse) :: rows\n  let mut previous : Option Nat := none\n  let mut previousDelimiter : Option Char := none\n  let mut scopes : List (Nat × Nat) := []\n  let mut heads : List (Nat × Option Nat) := []\n  let ordered := rows.reverse\n  let mut paragraph : Bool := ordered.length > 1\n  for (offset, text) in ordered do\n    let trimmed := text.toList.dropWhile (· == ' ')\n    let digits := trimmed.takeWhile Char.isDigit\n    let rest := trimmed.drop digits.length\n    -- `nl` uses a tab and `rg -n` uses a colon. Both carry original line\n    -- numbers; sparse hits and a change of representation break adjacency.\n    -- Otherwise a following file's grep result can borrow the preceding\n    -- file's function header and consume its whole context allowance.\n    let delimiter := rest.head?.filter (fun char => char == '\\t' || char == ':')\n    let numbered := !digits.isEmpty && delimiter.isSome\n    let number := if numbered then (String.ofList digits).toNat? else none\n    let body := if numbered then String.ofList (rest.drop 1) else text\n    if number.isSome && (number != previous.map (· + 1) || delimiter != previousDelimiter) then\n      scopes := []\n      heads := (offset, none) :: heads\n      paragraph := true\n    let blank := (body.toList.dropWhile (fun char => char == ' ' || char == '\\t')).isEmpty\n    let paragraphStart := paragraph && body.toList.head?.any (fun char => char != ' ' && char != '\\t')\n    -- Paragraph starts and explicit headings apply to prose, records and\n    -- tool text as well as source code. Shape hints never admit a candidate,\n    -- infer a relation or certify syntax/meaning. Single unstructured lines\n    -- have no paragraph boundary; their ranked nearby context is sufficient.\n    -- Indented scope labels belong to the original record too. Their\n    -- conditions must precede a selected result, just as prose headings do.\n    -- Numbered gaps above still reset this local hint; no relation or\n    -- completion authority is inferred from indentation or punctuation.\n    let label := String.ofList (body.toList.dropWhile (fun char => char == ' ' || char == '\\t'))\n    let scopeLabel := scopeLabels && label.endsWith \":\" && label.toList.head?.any Char.isAlpha\n    let indentation := (body.toList.takeWhile (fun char => char == ' ' || char == '\\t')).length\n    -- A monotone indentation stack prevents an earlier branch from lending\n    -- its label to a following function or sibling record. Retain a still\n    -- enclosing label when only an inner scope ends.\n    if !blank && !scopeLabel then\n      let enclosing := scopes.dropWhile (fun row => indentation <= row.1)\n      if enclosing.length != scopes.length then\n        heads := (offset, enclosing.head?.map Prod.snd) :: heads\n      scopes := enclosing\n    if scopeLabel && 0 < indentation then\n      scopes := (indentation, offset) :: scopes.dropWhile (fun row => indentation <= row.1)\n    if paragraphStart || body.startsWith \"# \" || body.startsWith \"##\" || scopeLabel ||\n        (body.toList.head?.any Char.isAlpha && (body.contains '(' || body.endsWith \":\")) then\n      heads := (offset, some offset) :: heads\n    paragraph := blank\n    previous := number\n    previousDelimiter := if numbered then delimiter else none\n  return heads.reverse\n\n\n/-- A nearby recorded paragraph/function start is part of the observation,\nnot optional peripheral data. This keeps a result with its invocation or\nprecondition, using only bounded original positions from the same section. -/\ndef prerequisiteContextRange (records : List (ContextSpan source))\n    (heads : List (Nat × Option Nat)) (range : EvidenceRange source) : EvidenceRange source :=\n  let complete := recordContextRange records range\n  let preceding := (heads.takeWhile (fun row => row.1 ≤ complete.start)).reverse\n  let first := preceding.head?.bind Prod.snd |>.getD complete.start\n  let lower := ((heads.filter fun row => row.2.isNone && row.1 ≤ complete.start).getLast?).map\n    Prod.fst |>.getD 0\n  -- Inputs and results may be separated by a blank record. The immediately\n  -- preceding bounded paragraph is retained, without crossing a file/read gap.\n  let prior := (preceding.dropWhile (fun row => first ≤ row.1)).head?.bind Prod.snd\n  let start := match prior with\n    | some position => if lower ≤ position && complete.stop - position ≤ 2048 then position else first\n    | none => first\n  if valid : start ≤ complete.start ∧ start < complete.stop ∧\n      complete.stop - start ≤ 2048 then\n    ⟨start, complete.stop, valid.2.1, complete.within, valid.2.2⟩\n  else complete\n\ntheorem prerequisite_context_keeps_cue (records : List (ContextSpan source))\n    (heads : List (Nat × Option Nat)) (range : EvidenceRange source) (position : Nat)\n    (covered : range.covers position) :\n    (prerequisiteContextRange records heads range).covers position := by\n  have complete := record_context_retains_original records range position covered\n  unfold prerequisiteContextRange\n  dsimp only\n  split\n  · rename_i valid\n    change _ ≤ position ∧ position < (recordContextRange records range).stop\n    exact ⟨Nat.le_trans valid.1 complete.1, complete.2⟩\n  · exact complete\n\n\n\nnamespace SharedRangeAdapter\n/-- A source record keeps its original paragraph and bounded scope entry.\nThe fixed-width surrounding display is an enrichment, not a prerequisite of\nthis smaller advisory offer. This creates no Match or completion authority. -/\ndef recordPrerequisite (records : List (ContextSpan source))\n    (heads scopedHeads : List (Nat × Option Nat)) (record : EvidenceRange source) :\n    EvidenceRange source :=\n  let prior := prerequisiteContextRange records heads record\n  let scope := prerequisiteContextRange records scopedHeads record\n  if valid : scope.start < prior.start ∧ prior.stop-scope.start ≤ 2048 then\n    ⟨scope.start,prior.stop,Nat.lt_trans valid.1 prior.ordered,prior.within,valid.2⟩\n  else prior\n\ntheorem record_prerequisite_retains_source (records : List (ContextSpan source))\n    (heads scopedHeads : List (Nat × Option Nat)) (record : EvidenceRange source)\n    (position : Nat) (inside : record.covers position) :\n    (recordPrerequisite records heads scopedHeads record).covers position := by\n  have retained := prerequisite_context_keeps_cue records heads record position inside\n  unfold recordPrerequisite\n  dsimp only\n  split\n  · rename_i valid\n    change _ ≤ position ∧ position < (prerequisiteContextRange records heads record).stop\n    exact ⟨Nat.le_trans (Nat.le_of_lt valid.1) retained.1,retained.2⟩\n  · exact retained\n\n\n/-- One whole-scalar check permits display decoding at recorded character\nboundaries. This is presentation evidence, never a file alias or Work proof. -/\nstructure ScalarLayout (source : String) where\n  layout : DecodedLayout source\n  canonical : source = (toJson layout.decoded.text).compress\n\ndef ScalarLayout.check? (source : String) : Option (ScalarLayout source) := do\n  let decoded ← decodedToolText? source\n  let layout := DecodedLayout.make decoded\n  if canonical : source = (toJson layout.decoded.text).compress then\n    some ⟨layout,canonical⟩ else none\n\ndef ScalarLayout.boundaries (prepared : ScalarLayout source) : Std.HashSet Nat := Id.run do\n  let mut position := 1\n  let mut result := ({} : Std.HashSet Nat).insert position\n  for (_,width) in prepared.layout.widths do\n    position := position+width\n    result := result.insert position\n  return result\n\n\n\nend SharedRangeAdapter\n\nnamespace OriginalStructure\n\n/-- A publication recipe names original positions. It carries no query value,\nfile alias, graph admission or completion authority. -/\nstructure Span where\n  first : Nat\n  limit : Nat\n  decoded : Bool\n  deriving BEq, Hashable\n\ninstance : ToJson Span where\n  toJson span := toJson (span.first,span.limit,span.decoded)\ninstance : FromJson Span where\n  fromJson? value := do\n    let (first,limit,decoded) ← fromJson? (α := Nat × Nat × Bool) value\n    return ⟨first,limit,decoded⟩\n\ndef Span.range? (span : Span) (source : String) : Option (EvidenceRange source) :=\n  if valid : span.first < span.limit ∧ span.limit ≤ source.length ∧ span.limit-span.first ≤ 2048 then\n    some ⟨span.first,span.limit,valid.1,valid.2.1,valid.2.2⟩ else none\n\n/-- A caller computes character count once. The source-size proof is erased,\nso checking each recipe never rescans its owner's entire UTF-8 string. -/\ndef Span.rangeUsing? (span : Span) (source : String) (characters : Nat)\n    (exact : characters = source.length) : Option (EvidenceRange source) :=\n  if valid : span.first < span.limit ∧ span.limit ≤ characters ∧ span.limit-span.first ≤ 2048 then\n    some ⟨span.first,span.limit,valid.1,by simpa [exact] using valid.2.1,valid.2.2⟩ else none\n\ntheorem Span.range_using_exact (span : Span) (source : String) (characters : Nat)\n    (exact : characters = source.length) : span.rangeUsing? source characters exact = span.range? source := by\n  subst characters\n  rfl\n\ndef Span.ofRange (range : EvidenceRange source) (decoded : Bool) : Span :=\n  ⟨range.start,range.stop,decoded⟩\n\ntheorem Span.range_roundtrip (range : EvidenceRange source) (decoded : Bool) :\n    (ofRange range decoded).range? source = some range := by\n  simp only [ofRange,range?,range.ordered,range.within,range.bounded,and_self,↓reduceDIte]\n\ntheorem Span.range_positions (span : Span) (source : String) (range : EvidenceRange source)\n    (found : span.range? source = some range) :\n    range.start = span.first ∧ range.stop = span.limit := by\n  unfold range? at found\n  split at found\n  · cases found; exact ⟨rfl,rfl⟩\n  · contradiction\n\ndef intervals (spans : Array Span) : List DeliveryInterval :=\n  spans.toList.filterMap fun span =>\n    if ordered : span.first < span.limit then some ⟨span.first,span.limit,ordered⟩ else none\n\ndef complete (characters : Nat) (spans : Array Span) : Bool :=\n  if positive : 0 < characters then\n    (DeliveryInterval.subtractAll ⟨0,characters,positive⟩ (intervals spans)).isEmpty\n  else true\n\n/-- A published complete recipe domain cannot omit any original position,\nregardless of tool name, file alias or the query's hints. -/\ntheorem complete_position (characters : Nat) (spans : Array Span) (position : Nat)\n    (ready : complete characters spans = true) (inside : position < characters) :\n    ∃ span ∈ spans, span.first ≤ position ∧ position < span.limit := by\n  classical\n  unfold complete at ready\n  split at ready\n  · rename_i positive\n    have whole := (DeliveryInterval.subtractAll_empty ⟨0,characters,positive⟩ (intervals spans)).mp ready\n    apply Classical.byContradiction\n    intro missing\n    apply whole\n    refine ⟨position,⟨Nat.zero_le _,inside⟩,?_⟩\n    intro interval member contains\n    unfold intervals at member\n    obtain ⟨span,belongs,found⟩ := List.mem_filterMap.mp member\n    by_cases ordered : span.first < span.limit\n    · simp only [ordered,↓reduceDIte,Option.some.injEq] at found\n      subst interval\n      exact missing ⟨span,by simpa using belongs,contains⟩\n    · simp [ordered] at found\n  · omega\n\nstructure Record (source : String) where\n  range : EvidenceRange source\n  decoded : Bool\n\n/-- The renderer's original immutable partition and prerequisite rules,\nincluding uncovered gaps. Query windows and weights do not occur here. -/\ndef catalogue (source : String) : Array (Record source) := Id.run do\n  if positive : 0 < source.length then\n    let wholeSpan : ContextSpan source := ⟨0,source.length,positive,Nat.le_refl _⟩\n    let scalar := SharedRangeAdapter.ScalarLayout.check? source\n    let layout := scalar.map (·.layout)\n    let boundaries := scalar.map SharedRangeAdapter.ScalarLayout.boundaries |>.getD {}\n    let records := contextRecordSpans source layout\n    let heads := contextStructureHeads source layout\n    let scopedHeads := contextStructureHeads source layout true\n    let covered := records.map fun record =>\n      (⟨record.start,record.stop,record.ordered⟩ : DeliveryInterval)\n    let whole : DeliveryInterval := ⟨wholeSpan.start,wholeSpan.stop,wholeSpan.ordered⟩\n    let gaps := (whole.subtractAll covered).attach.map fun gap =>\n      (⟨gap.val.start,gap.val.stop,gap.val.ordered,by\n        have inside : gap.val.covers (gap.val.stop-1) := by\n          have := gap.val.ordered\n          simp only [DeliveryInterval.covers]\n          omega\n        have contained := ((DeliveryInterval.subtractAll_covers whole covered (gap.val.stop-1)).mp\n          ⟨gap.val,gap.property,inside⟩).1\n        have bound := wholeSpan.within\n        simp only [DeliveryInterval.covers,whole] at contained\n        omega⟩ : ContextSpan source)\n    let mut result := #[]\n    let mut seen : Std.HashSet (Nat × Nat) := {}\n    for record in records ++ gaps do\n      for part in record.ranges do\n        let required := SharedRangeAdapter.recordPrerequisite records heads scopedHeads part\n        if seen.contains (required.start,required.stop) then continue\n        seen := seen.insert (required.start,required.stop)\n        result := result.push ⟨required,scalar.isSome && boundaries.contains required.start &&\n          boundaries.contains required.stop⟩\n    return result\n  else return #[]\n\ndef prepare (source : String) : Array Span :=\n  (catalogue source).map fun record => Span.ofRange record.range record.decoded\n\ntheorem prepared_span_has_original_range (source : String) (span : Span)\n    (present : span ∈ prepare source) :\n    ∃ range : EvidenceRange source, span.range? source = some range := by\n  obtain ⟨record,_,same⟩ := Array.mem_map.mp present\n  subst span\n  exact ⟨record.range,Span.range_roundtrip ..⟩\n\nend OriginalStructure\n\nend Eggshell.Plugin\n",[]]
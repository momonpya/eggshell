+module
+public import Eggshell.SourceOwners
+public import Eggshell.Paths
+
+@[expose] public section
+namespace Eggshell.OwnerViews
+open Lean DB Persistence.Store
+
+def implementation : String := Sha256.hex ((include_str "OwnerViews.lean").toUTF8 ++ SourceOwners.implementation.toUTF8)
+
+structure Item where
+  storage : Sidecar.Storage
+  captured : SourceOwners.Captured
+  deriving ToJson, FromJson
+
+instance : Repr Item where reprPrec value _ := repr (toJson value).compress
+
+structure Reference where
+  producer : String
+  sources : Array PageMap.Head
+  items : Array Item
+  deriving ToJson, FromJson
+
+def scope (source : Snapshot) : IO String := do
+  let project ← ProjectCacheScope.at? source
+  return project.map (·.scope.identity) |>.getD source.head.identity
+
+def directory (source : Snapshot) (storage : Sidecar.Storage) : IO System.FilePath := do
+  return (← Sidecar.locate source storage).directory/"owner-inputs"/implementation
+
+def dictionaryPath (source : Snapshot) (storage : Sidecar.Storage) : IO System.FilePath := do
+  return (← Sidecar.locate source storage).root/"owner-identities"/implementation/"tree"
+
+def sourceKey (source : Snapshot) : String := "source-"++Sha256.hex (toJson source.head).compress.toUTF8
+
+def openIndex (path : System.FilePath) (authority : String) : IO Snapshot := do
+  if let some index ← PageMap.open? path then
+    unless index.head.authority == authority do throw (IO.userError "owner-input authority mismatch")
+    return index
+  try PageMap.create path authority
+  catch error =>
+    let some index ← PageMap.open? path | throw error
+    unless index.head.authority == authority do throw (IO.userError "owner-input authority changed during creation")
+    return index
+
+def loadOne? (source : Snapshot) : IO (Option Item) := do
+  for storage in [Sidecar.Storage.database,.user] do
+    let found ← try
+        let some book ← PageMap.open? ((← directory source storage)/"ready.egg") | pure none
+        PreparedOwners.readJson (α := Item) book book.get (sourceKey source)
+      catch error => match error with
+        | .permissionDenied _ _ _ => pure none
+        | _ => throw error
+    if let some item := found then
+      unless item.storage == storage && item.captured.state.source.head == source.head &&
+          item.captured.state.source.directory == source.directory.toString &&
+          item.captured.state.binding.scope == (← scope source) &&
+          item.captured.state.binding.producer == SourceOwners.implementation do
+        throw (IO.userError "individual owner input changed its source or namespace")
+      return some item
+  return none
+
+/-- Publish one source's roots in its project cache or private read overlay.
+No read-set tuple is registered and original ACKs never wait for this writer. -/
+def prepareSource (source : Snapshot) (storage : Sidecar.Storage) : IO Item := do
+  if let some item ← loadOne? source then return item
+  let _ ← Sidecar.prepare (Sidecar.Owner.ofSnapshot source) storage
+  let folder ← directory source storage
+  FileSystem.privateDirectory folder
+  let dictionary ← dictionaryPath source storage
+  let some parent := dictionary.parent | throw (IO.userError "owner dictionary has no project parent")
+  FileSystem.privateDirectory parent
+  let scopeKey ← scope source
+  let _ ← openIndex dictionary ("owner-identities:"++scopeKey++":"++implementation)
+  let index ← openIndex (folder/"tree") ("owner-input:"++source.head.identity++":"++implementation)
+  let prepared ← SourceOwners.prepare dictionary index source scopeKey
+  let item : Item := ⟨storage,prepared.captured⟩
+  let book ← openIndex (folder/"ready.egg") ("owner-input-ready:"++source.head.identity++":"++implementation)
+  let _ ← PageMap.withWriter book fun writer => do
+    let name := sourceKey source
+    if (← writer.get (key name 0)).isNone then
+      let count ← getNat writer.get "count"
+      let slot := key "slot" (count%64)
+      if let some old ← writer.get slot then
+        let some old := String.fromUTF8? old | throw (IO.userError "invalid owner-input retirement slot")
+        writer.put (key old 0) none
+      writer.put slot (some name.toUTF8)
+      putNat writer "count" (count+1)
+    PreparedOwners.writeJson writer name item
+  return item
+
+def load? (sources : Array Snapshot) : IO (Option Reference) := do
+  let mut items := #[]
+  for source in sources do
+    let some item ← loadOne? source | return none
+    items := items.push item
+  return some ⟨implementation,sources.map (·.head),items⟩
+
+/-- Capture completed inputs only; this never creates a whole-cut index. -/
+def prepare (sources : Array Snapshot) : IO Reference := do
+  let some captured ← load? sources | throw (IO.userError "individual owner inputs are pending explicit/background warm")
+  return captured
+
+def common (reference : Reference) : Bool :=
+  match reference.items[0]? with
+  | none => true
+  | some first => reference.items.all fun item =>
+      item.captured.state.binding.scope == first.captured.state.binding.scope &&
+      item.captured.state.dictionary.directory == first.captured.state.dictionary.directory &&
+      item.captured.state.dictionary.head.identity == first.captured.state.dictionary.head.identity
+
+def requiredFor (source : Snapshot) : IO Bool := return (← loadOne? source).isNone
+
+structure Reader where
+  base : SourceOwners.Reader
+  stride : Nat
+
+def validate (reference : Reference) (sources : Array Snapshot) : IO Unit := do
+  unless reference.producer == implementation && reference.sources == sources.map (·.head) &&
+      reference.items.size == sources.size do throw (IO.userError "owner inputs omitted or substituted an original source")
+  for source in List.finRange sources.size do
+    let some item := reference.items[source.val]? | throw (IO.userError "missing owner input")
+    unless item.captured.state.source.head == sources[source].head &&
+        item.captured.state.source.directory == sources[source].directory.toString &&
+        item.captured.state.binding.scope == (← scope sources[source]) &&
+        item.captured.state.binding.producer == SourceOwners.implementation do
+      throw (IO.userError "owner input is outside the captured original cut")
+
+def restore (reference : Reference) (sources : Array Snapshot) : IO Reader := do
+  validate reference sources
+  let some first := reference.items[0]? | throw (IO.userError "empty owner input inventory")
+  unless common reference do throw (IO.userError "distinct project identity namespaces require complete cross-project federation")
+  let some base ← SourceOwners.open? (reference.items.map (·.captured)) first.captured.state.binding.scope (some sources) |
+    throw (IO.userError "captured individual owner roots cannot be restored")
+  let mut stride := 1
+  for source in sources do stride := max stride ((← getNat source.get "roots")+1)
+  return ⟨base,stride⟩
+
+def canonical (reader : Reader) (source node : Nat) : IO Nat := do
+  let some id ← reader.base.owner? source node |
+    throw (IO.userError "nominated owner is absent from its captured source index")
+  return id
+
+def entry (reader : Reader) (id : Nat) : IO PreparedOwners.Entry := do
+  let originals ← reader.base.originals id
+  let some first := originals.head? | throw (IO.userError "prepared owner has no live captured original")
+  return ⟨id,first,originals,[]⟩
+
+def ordinal (reader : Reader) (id : Nat) : IO Nat := do
+  let entry ← entry reader id
+  let some first := entry.originals.head? | throw (IO.userError "prepared owner lost original order")
+  return first.rank reader.stride
+
+def Reader.counts (reader : Reader) : IO (Nat × Nat) := return reader.base.counts
+def Reader.frequency (reader : Reader) (unit : String) : IO Nat := reader.base.frequency unit
+
+end Eggshell.OwnerViews

+def Frame.boundTo (frame : Frame) (heads : List (Option PageMap.Head)) (model encoder : String) : Bool :=
+  frame.producer == implementation && decide (frame.originals = heads) &&
+  decide (frame.inputs.map (·.source) = (heads.filterMap id).toArray) &&
+  frame.inputs.all (fun reference => reference.producer == implementation &&
+    reference.model == model && reference.encoder == encoder)
+
+theorem Frame.original_inventory (frame : Frame) (heads : List (Option PageMap.Head)) (model encoder : String)
+    (accepted : frame.boundTo heads model encoder = true) : frame.originals = heads := by
+  simp only [boundTo,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.1.1.2
+
+theorem Frame.input_inventory (frame : Frame) (heads : List (Option PageMap.Head)) (model encoder : String)
+    (accepted : frame.boundTo heads model encoder = true) :
+    frame.inputs.map (·.source) = (heads.filterMap id).toArray := by
+  simp only [boundTo,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.1.2
+
+def Frame.matches (frame : Frame) (heads : List (Option PageMap.Head)) (inputs : Array Reference)
+    (owners : Option OwnerViews.Reference) : Bool :=
+  decide (frame.originals = heads) && toJson frame.inputs == toJson inputs && toJson frame.owners == toJson owners
+

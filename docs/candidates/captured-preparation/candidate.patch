+/-- Derive an immutable cache root from a retained tree while appending after
+the current physical publication. Recovery uses the current published extent,
+never the older logical basis. Existing current-root writers stay strict.
+The cache caller must check source ancestry/coverage separately; a retained
+PageMap head by itself is not a certificate of original Work provenance. -/
+opaque withWriterFrom (snapshot : Snapshot) (basis : Head) (action : Writer → IO α) :
+    IO (α × Head × Nat) := do
+  let guard ← FileSystem.openRead (snapshot.directory / "writer").toString
+  unless ← FileSystem.tryReadLock guard true do throw (IO.userError "DB writer is busy")
+  try withWriterLocked snapshot action (some basis)
+  finally FileSystem.unlockRead guard
+

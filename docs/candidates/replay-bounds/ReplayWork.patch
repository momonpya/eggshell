+/-- Tombstones consume the same bounded row budget as live postings. The
+last visited key resumes this exact dependency; an empty live set is not a
+reason to rescan its entire dead history. -/
+def enqueueWatchers (journal : PageMap.Snapshot) (writer : PageMap.Writer)
+    (base directoryPrefix after : String) (deadline limit : Nat) : IO (WatchProgress limit) := do
+  unless after.isEmpty || after.startsWith directoryPrefix do
+    throw (IO.userError "foreign replay posting continuation")
+  let lower := if after.isEmpty then directoryPrefix else after ++ "\x00"
+  let found ← window journal lower (directoryPrefix ++ "~") limit
+  let mut result : WatchProgress limit := {after,complete := found.complete}
+  for row in found.rows do
+    if (← IO.monoMsNow) ≥ deadline then return {result with complete := false}
+    if within : result.rows < limit then
+      result := {result with after := row.1,rows := result.rows+1,bounded := by omega}
+    else throw (IO.userError "replay posting reader exceeded its bounded window")
+    let some raw := row.2 | continue
+    let name ← Index.decode (α := String) raw
+    unless row.1 == directoryPrefix ++ name do throw (IO.userError "foreign replay dependency posting")
+    enqueue writer base name
+    result := {result with postings := result.postings+1}
+  return result

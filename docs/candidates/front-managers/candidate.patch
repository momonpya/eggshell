+module
+public import Std
+@[expose] public section
+namespace Eggshell.HookBudget
+
+def clients : Nat := 128
+def readers : Nat := 4
+def bytes : Nat := 16*1024*1024
+def sessions : Nat := 128
+def maintenance : Nat := 2
+
+def admit (count held incoming : Nat) : Bool :=
+  decide (count < clients ∧ held+incoming ≤ bytes)
+
+theorem admitted_bounds (count held incoming : Nat) (accepted : admit count held incoming = true) :
+    count < clients ∧ held+incoming ≤ bytes := by simpa [admit] using accepted
+
+theorem full_refused (held incoming : Nat) : admit clients held incoming = false := by
+  simp [admit]
+
+theorem overflow_refused (count held incoming : Nat) (large : bytes < held+incoming) :
+    admit count held incoming = false := by simp [admit,Nat.not_le_of_gt large]
+
+def canStart (running : List String) (session : String) : Bool := !running.contains session
+
+theorem active_session_refused (running : List String) (session : String) :
+    canStart (session::running) session = false := by simp [canStart]
+
+end Eggshell.HookBudget

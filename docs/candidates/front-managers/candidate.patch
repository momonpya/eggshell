+module
+public import Eggshell.PluginHooks
+public import Eggshell.DaemonWire
+public import Eggshell.HookBudget
+
+@[expose] public section
+namespace Eggshell.Plugin.HookFrontend
+open Lean Std Async TCP
+
+structure Session where
+  name : String
+  touched : Nat
+  saveCursor : IO.Ref (String × List String)
+  indexCursor : IO.Ref String
+  indexWake : IO.Ref (Option String)
+
+def Session.create (name : String) (now : Nat) : IO Session := do
+  let _ ← IO.ofExcept (safeSession name)
+  return ⟨name,now,← IO.mkRef ("",[]),← IO.mkRef "",← IO.mkRef none⟩
+
+def Session.refresh (entry : Session) : IO Unit := do
+  if ← IO.checkCanceled then return
+  let deadline := (← IO.monoMsNow)+60000
+  flushDeferred entry.name deadline (some entry.saveCursor)
+  if ← IO.checkCanceled then return
+  let observed ← preparationWake entry.name
+  if PreparationPlan.Wake.needed observed (← entry.indexWake.get) then
+    let accepted ← flushIndexesResult entry.name deadline (some entry.indexCursor)
+    entry.indexWake.modify (fun before => PreparationPlan.Wake.record observed before accepted)
+
+structure Reading where
+  socket : Socket.Client
+  task : Task (Except IO.Error ByteArray)
+
+structure Client where
+  bytes : Nat
+  session : Option String
+  wake : Bool
+  task : Task (Except IO.Error Bool)
+
+structure Maintenance where
+  session : String
+  task : Task (Except IO.Error Unit)
+
+def requestSession (json : Json) : Except String (Option String) := do
+  let kind ← requiredString json "kind"
+  if ["hook","ack","register"].contains kind then
+    let session ← requiredString (json.getObjValD "payload") "session_id"
+    let _ ← safeSession session
+    return some session
+  return none
+
+def heldBytes (clients : Array Client) : Nat := clients.foldl (fun n client => n+client.bytes) 0
+
+def notify (pending : Array String) (session : String) : Array String :=
+  if pending.contains session then pending else pending.push session
+
+/-- The loop alone owns session registration, admission, queues and task phases.
+IO tasks return results; they never mutate this registry or replace its map.
+Cursor references belong to one maintenance task per session at a time. -/
+def run (server : Socket.Server) (secret initial : String)
+    (handle : String → Json → IO (Json × Bool)) : IO Unit := do
+  let stopReaders ← Std.CancellationToken.new
+  let mut sessions := #[← Session.create initial (← IO.monoMsNow)]
+  let mut readers : Array Reading := #[]
+  let mut clients : Array Client := #[]
+  let mut maintenance : Array Maintenance := #[]
+  let mut pending := #[initial]
+  let mut nextMaintenance := 0
+  let mut lastActivity ← IO.monoMsNow
+  let mut closing := false
+  let mut stopped := false
+  try
+    while !stopped do
+      let mut active := #[]
+      for client in clients do
+        if ← IO.hasFinished client.task then
+          match ← IO.wait client.task with
+          | .ok stop => if stop then stopped := true
+          | .error _ => pure ()
+          if client.wake then
+            if let some session := client.session then pending := notify pending session
+        else active := active.push client
+      clients := active
+      let mut working := #[]
+      for work in maintenance do
+        if ← IO.hasFinished work.task then
+          if let .error _ ← IO.wait work.task then
+            IO.eprintln "Eggshell retained unfinished session maintenance"
+        else working := working.push work
+      maintenance := working
+      if stopped then break
+      let mut receiving := #[]
+      for reader in readers do
+        if ← IO.hasFinished reader.task then
+          match ← IO.wait reader.task with
+          | .error _ => pure ()
+          | .ok bytes =>
+            if !closing && HookBudget.admit clients.size (heldBytes clients) bytes.size then
+              let parsed := match String.fromUTF8? bytes with
+                | some text => Json.parse text
+                | none => .error "invalid frontend UTF-8"
+              let mut selected : Option String := none
+              let mut error : Option String := none
+              let mut request := Json.null
+              match parsed with
+              | .error _ => error := some "invalid frontend frame"
+              | .ok json =>
+                request := json
+                if optionalString json "secret" != some secret then error := some "unauthorized daemon request"
+                else match requestSession json with
+                  | .error message => error := some message
+                  | .ok session => selected := session
+              if error.isNone then
+                if let some name := selected then
+                  if let some index := sessions.findIdx? (·.name == name) then
+                    let touched ← IO.monoMsNow
+                    sessions := sessions.modify index (fun entry => {entry with touched})
+                  else if sessions.size < HookBudget.sessions then
+                    sessions := sessions.push (← Session.create name (← IO.monoMsNow))
+                    pending := notify pending name
+                  else error := some "frontend session admission is full"
+              let stop := error.isNone && optionalString request "kind" == some "shutdown"
+              if stop then
+                closing := true
+                Worker.shutdown
+              let status := Json.mkObj [("registeredSessions",toJson sessions.size),
+                ("requestBytes",toJson (heldBytes clients)),("activeRequests",toJson clients.size),
+                ("readers",toJson readers.size),("activeMaintenance",toJson maintenance.size),
+                ("pendingMaintenance",toJson pending.size)]
+              let task ← IO.asTask (do
+                let (reply,stop) ← match error with
+                  | some error => pure (Daemon.response (.error error),false)
+                  | none =>
+                    if optionalString request "kind" == some "stats" then
+                      pure (Daemon.response (.ok status.compress),false)
+                    else handle (selected.getD "") request
+                Daemon.sendFrame reader.socket reply.compress.toUTF8
+                return stop) .dedicated
+              clients := clients.push {
+                bytes := bytes.size
+                session := selected
+                wake := [some "hook",some "ack"].contains (optionalString request "kind")
+                task := task }
+            -- No payload/authority is admitted when full. Dropping the socket
+            -- makes the caller fail explicitly under its existing deadline.
+        else receiving := receiving.push reader
+      readers := receiving
+      let now ← IO.monoMsNow
+      if !closing then
+        if readers.size < HookBudget.readers && readers.size+clients.size < HookBudget.clients then
+          if let some socket ← server.tryAccept then
+            lastActivity := now
+            readers := readers.push ⟨socket,← IO.asTask

+/-- Opening never creates an index or warms a source. A background publication
+may advance after a reader captured its source; the prior complete root remains
+addressable with one directory lookup and the same original validation. -/
+def open? (source : PageMap.Snapshot) (storage : Sidecar.Storage) (scope : Scope) : IO (Option Reader) := do
+  if scope == .usage && storage != .user then return none
+  let path ← directory source storage scope
+  let some index ← PageMap.open? path | return none
+  if let some ready ← atSource? source index scope then return some ready
+  if scope != .shared then return none
+  let some bytes ← index.get (retainedName source.head) | return none
+  let saved ← decode (α := Retained) bytes
+  unless saved.source == source.head do
+    throw (IO.userError "retained index directory changed its exact original source")
+  let some pinned ← PageMap.HistoryReader.make? index saved.index |
+    throw (IO.userError "retained index directory names an unavailable root")
+  atSource? source pinned.snapshot scope
+
+def retainPrepared (index : PageMap.Snapshot) (previous : Option Manifest)
+    (source : PageMap.Head) (scope : Scope) (writer : PageMap.Writer) : IO Unit := do
+  if scope != .shared then return
+  let some previous := previous | return
+  if previous.source == source || previous.implementation != implementation || previous.scope != scope then return
+  let bytes ← checkedBytes ({source := previous.source, index := index.head} : Retained)
+  writer.put (retainedName previous.source) (some bytes)
+
 def openShared? (source : PageMap.Snapshot) : IO (Option Reader) := do

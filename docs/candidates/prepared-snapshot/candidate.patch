+/-- The latest header is only a fast path. Old, already prepared readers use
+the exact-source directory committed with the newer immutable recipe root. -/
+def manifestAt? (source : PageMap.Snapshot) (path : System.FilePath) : IO (Option Manifest) := do
+  let some latest ← manifest? path | return none
+  if ← Index.sameSources source latest.source then return some latest
+  let some recipes ← PageMap.open? (path / "recipes") | return none
+  let some bytes ← recipes.get (Index.retainedName source.head) | return none
+  let saved ← decode (α := Manifest) bytes
+  unless saved.source == source.head do
+    throw (IO.userError "retained canonical directory changed its exact original source")
+  return some saved
+

+namespace LocalPages
+def maxBytes : Nat := 2*1024*1024
+def maxEntries : Nat := 512
+def used (entries : Array (SharedPageKey × CachedPage)) : Nat :=
+  (entries.toList.map (·.2.ref.bytes)).sum
+structure State where
+  entries : Array (SharedPageKey × CachedPage)
+  index : Std.HashMap SharedPageKey Nat
+  bytes : Nat
+  exact : bytes = used entries
+  bounded : bytes ≤ maxBytes
+  slotsBounded : entries.size ≤ maxEntries
+def State.empty : State := ⟨#[],{},0,rfl,by decide,by decide⟩
+def State.find (state : State) (key : SharedPageKey) (ref : Ref) : Option (Loaded ref) := do
+  let position ← state.index[key]?
+  let (known,page) ← state.entries[position]?
+  unless known == key do none
+  if same : page.ref = ref then some (same ▸ page.loaded) else none
+def State.insert (state : State) (key : SharedPageKey) (page : CachedPage) : State :=
+  if fits : state.bytes+page.ref.bytes ≤ maxBytes ∧ state.entries.size+1 ≤ maxEntries then
+    ⟨state.entries.push (key,page),state.index.insert key state.entries.size,state.bytes+page.ref.bytes,
+      by simp [used,state.exact],fits.1,by simpa using fits.2⟩
+  else if fits : page.ref.bytes ≤ maxBytes then
+    ⟨#[(key,page)],(∅ : Std.HashMap SharedPageKey Nat).insert key 0,page.ref.bytes,
+      by simp [used],fits,by simp [maxEntries]⟩
+  else state
+theorem encoded_bytes_bounded (state : State) : used state.entries ≤ maxBytes := by
+  rw [← state.exact]
+  exact state.bounded
+theorem slots_bounded (state : State) : state.entries.size ≤ maxEntries := state.slotsBounded
+theorem different_key_rejected (state : State) (key actual : SharedPageKey) (ref : Ref)
+    (position : Nat) (page : CachedPage) (located : state.index[key]? = some position)
+    (entry : state.entries[position]? = some (actual,page)) (different : actual ≠ key) :
+    state.find key ref = none := by
+  simp [State.find,located,entry,different]
+structure Front where
+  state : IO.Ref State
+  hits : IO.Ref Nat
+  misses : IO.Ref Nat
+def Front.new : IO Front := return ⟨← IO.mkRef State.empty,← IO.mkRef 0,← IO.mkRef 0⟩
+end LocalPages

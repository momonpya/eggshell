+/-- Canonical Outcome relations define the Work graph; physical source copies
+remain separate original admissions and provenance, not repeated graph facts. -/
+def identifiedGraph (hits : List Matcher.Match) : WorkGraph :=
+  {outcomes := AppendUnique.merge (·.relation) [] (hits.map (·.edge))}
+
+theorem identifiedGraph_membership (hits : List Matcher.Match) (relation : Value) :
+    relation ∈ (identifiedGraph hits).outcomes.map (·.relation) ↔
+      relation ∈ hits.map (·.edge.relation) := by
+  simpa [identifiedGraph, List.map_map] using
+    AppendUnique.merge_empty_membership (fun edge : OutcomeEdge => edge.relation) (hits.map (·.edge)) relation
+
+theorem identifiedGraph_nodup (hits : List Matcher.Match) :
+    ((identifiedGraph hits).outcomes.map (·.relation)).Nodup := by
+  simpa only [identifiedGraph] using
+    AppendUnique.merge_empty_nodup (fun edge : OutcomeEdge => edge.relation)
+      (hits.map fun matched : Matcher.Match => matched.edge)
+
@@ -7661 +7678 @@ def indexedIdentifiedRoot (selection : Config.Selection)
-  let graph : WorkGraph := {outcomes := hits.map (·.edge)}
+  let graph := identifiedGraph hits

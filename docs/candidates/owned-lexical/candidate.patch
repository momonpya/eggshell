index 2fa253a..daa6329 100644
--- a/Eggshell/AppendUnique.lean
+++ b/Eggshell/AppendUnique.lean
@@ -63,0 +64,61 @@ theorem merge_exact (key : α → β) (base added : List α) :
+omit [Hashable β] in
+theorem reference_key_membership (key : α → β) (base added : List α) (value : β) :
+    value ∈ (reference key base added).map key ↔ value ∈ base.map key ∨ value ∈ added.map key := by
+  induction added generalizing base with
+  | nil => simp [reference]
+  | cons item rest ih =>
+    simp only [reference, List.foldl_cons]
+    change value ∈ (reference key (if base.any (fun old => key old == key item)
+      then base else base ++ [item]) rest).map key ↔ _
+    rw [ih]
+    by_cases present : key item ∈ base.map key
+    · have found : base.any (fun old => key old == key item) = true := by
+        simpa only [List.mem_map, List.any_eq_true, beq_iff_eq] using present
+      simp only [found, ↓reduceIte, List.map_cons, List.mem_cons]
+      constructor
+      · intro h; exact h.elim Or.inl (fun h => Or.inr (Or.inr h))
+      · intro h
+        rcases h with h | same | h
+        · exact Or.inl h
+        · exact Or.inl (by simpa only [same] using present)
+        · exact Or.inr h
+    · have found : base.any (fun old => key old == key item) = false := by
+        apply Bool.eq_false_iff.mpr
+        intro found
+        apply present
+        obtain ⟨old,member,equal⟩ := List.any_eq_true.mp found
+        exact List.mem_map.mpr ⟨old,member,by simpa only [beq_iff_eq] using equal⟩
+      simp [found, List.map_append, or_assoc, or_left_comm, or_comm]
+
+omit [Hashable β] in
+theorem reference_keys_nodup (key : α → β) (base added : List α)
+    (unique : (base.map key).Nodup) : ((reference key base added).map key).Nodup := by
+  induction added generalizing base with
+  | nil => simpa [reference] using unique
+  | cons item rest ih =>
+      simp only [reference, List.foldl_cons]
+      change ((reference key (if base.any (fun old => key old == key item)
+        then base else base ++ [item]) rest).map key).Nodup
+      split
+      · exact ih _ unique
+      · apply ih
+        simp only [List.map_append, List.map_cons, List.map_nil]
+        apply List.nodup_append.mpr
+        refine ⟨unique, by simp, ?_⟩
+        intro value member other itemMember same
+        have itemEqual : other = key item := by simpa using itemMember
+        have member : key item ∈ base.map key := by simpa only [same,itemEqual] using member
+        have found : base.any (fun old => key old == key item) = true := by
+          simpa only [List.mem_map, List.any_eq_true, beq_iff_eq] using member
+        contradiction
+
+theorem merge_empty_membership (key : α → β) (added : List α) (value : β) :
+    value ∈ (merge key [] added).map key ↔ value ∈ added.map key := by
+  rw [merge_exact, reference_key_membership]
+  simp
+
+theorem merge_empty_nodup (key : α → β) (added : List α) :
+    ((merge key [] added).map key).Nodup := by
+  rw [merge_exact]
+  exact reference_keys_nodup key [] added (by simp)
+

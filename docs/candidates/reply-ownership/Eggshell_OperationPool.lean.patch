+def Pool.releaseReply (pool : Pool) (job : Job) : IO Unit := do
+  let amount ← job.reservation.atomically do
+    let (next,amount) := ReplyHold.close (← get)
+    set next
+    return amount
+  pool.returnReplyBytes job amount
+
+def Pool.finishReplyProducer (pool : Pool) (job : Job) : IO Unit := do
+  let amount ← job.reservation.atomically do
+    let (next,amount) := ReplyHold.finish (← get)
+    set next
+    return amount
+  pool.returnReplyBytes job amount
+
+/-- The callback is entered only after memory admission. Search actors remain
+independent; this bound applies to materializing and retaining wire replies.
+Cancellation cannot return their charge before the enclosing producer ends. -/
+@[noinline, nospecialize] def Pool.withReplyEncoding (pool : Pool) (job : Job) (input : α)
+    (encode : α → IO Json) : IO (Option Json) := do
+  unless ← pool.reserveReply job do return none
+  unless !(← job.cancelled.get) && (← IO.monoMsNow) < (← job.expires.get) do return none
+  let value ← encode input
+  let amount := value.compress.utf8ByteSize+1024
+  if amount ≤ replyBytes job.request.role && !(← job.cancelled.get) &&
+      (← IO.monoMsNow) < (← job.expires.get) then return some value
+  return none
+

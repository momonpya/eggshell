+/-- A checked immutable value, not a handle back to the mutable catalogue.
+All source ordering and prepared-root validation precedes this handoff. -/
+structure CheckedFrame where
+  private mk ::
+  image : Image
+  scopes : Array String
+  key : String
+  original : Array (String × PageMap.Head)
+  keyExact : image.key = key
+  originalExact : image.originals.map (fun image => (image.directory.toString,image.head)) = original
+
+@[no_expose] def CheckedFrame.bind (image : Image) (frame : Frame) : Except String CheckedFrame := do
+  if keyExact : image.key = frame.key then
+    if originalExact : image.originals.map (fun image => (image.directory.toString,image.head)) =
+        frame.sources.map (fun source => (source.directory.toString,source.head)) then
+      return ⟨image,frame.scopes,frame.key,_,keyExact,originalExact⟩
+    else throw "coordinator original image boundary differs"
+  else throw "coordinator returned a different public read cut"
+
+theorem CheckedFrame.original_boundary (checked : CheckedFrame) :
+    checked.image.originals.map (fun image => (image.directory.toString,image.head)) = checked.original :=
+  checked.originalExact
+
+theorem CheckedFrame.original_key (checked : CheckedFrame) : checked.image.key = checked.key := checked.keyExact
+
+def CheckedFrame.publicImage (checked : CheckedFrame) : Image := checked.image
+
+theorem CheckedFrame.public_image (checked : CheckedFrame) : checked.publicImage = checked.image := rfl
+
+def CheckedFrame.fork (checked : CheckedFrame) : IO Session :=
+  localSession checked.image checked.scopes
+
+theorem CheckedFrame.local_fork (checked : CheckedFrame) :
+    checked.fork = localSession checked.image checked.scopes := rfl
+

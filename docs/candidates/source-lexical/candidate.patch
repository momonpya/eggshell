@@ -0,0 +1,84 @@
+module
+public import Eggshell.GraphStore
+@[expose] public section
+
+namespace Eggshell.SourceLexical
+open Lean DB Persistence.Store
+
+structure Reader (source : Snapshot) where
+  roots : Nat
+  population : Nat
+
+def open? (source : Snapshot) : IO (Option (Reader source)) := do
+  let population ← getNat source.get "candidates"
+  unless SourceLexicalPolicy.ready (← source.get SourceLexicalPolicy.name) population do return none
+  return some ⟨← getNat source.get "roots", population⟩
+
+structure Status where
+  contract : String
+  roots : Nat
+  candidates : Nat
+  deriving ToJson
+
+/-- This probes one immutable source publication. It creates no sidecar and
+never scans, tokenizes or hydrates existing candidates. -/
+def status (source : Snapshot) : IO Status := do
+  let some reader ← open? source | throw (IO.userError "atomic source lexical index is unavailable")
+  return ⟨SourceLexicalPolicy.contract, reader.roots, reader.population⟩
+
+def ready (source : Snapshot) : IO Bool := return (← open? source).isSome
+
+structure Posting where
+  rows : List (Nat × Nat)
+  frequency : Nat
+  complete : rows.length = frequency
+
+/-- Authoritative postings already share the source commit. Nomination reads
+only the requested term directory; consumed owners are checked separately. -/
+def posting (reader : Reader source) (term : String) : IO Posting := do
+  let some found ← findTerm? source source.get term | return ⟨[],0,rfl⟩
+  let rows ← directory source (key "searchPosting" found.id)
+  let frequency ← getNat source.get (key "searchFrequency" found.id)
+  if complete : rows.length = frequency then
+    unless frequency ≤ reader.population && rows.all (fun row => row.1 < reader.roots) &&
+        (Std.HashSet.ofList (rows.map Prod.snd)).size == rows.length do
+      throw (IO.userError "invalid source lexical population or owner order")
+    return ⟨rows,frequency,complete⟩
+  else throw (IO.userError "source lexical posting frequency disagrees")
+
+structure OwnerWitness (owner ordinal : Nat) where
+  indexed : Option ByteArray
+  member : Option ByteArray
+  candidate : Option ByteArray
+  indexExact : payloadSize indexed = .ok owner
+  memberExact : payloadSize member = .ok ordinal
+  candidateExact : payloadSize candidate = .ok 1
+
+def OwnerWitness.check? (owner ordinal : Nat) (indexed member candidate : Option ByteArray) :
+    Option (OwnerWitness owner ordinal) := do
+  match a : payloadSize indexed, b : payloadSize member, c : payloadSize candidate with
+  | .ok found, .ok sourceOrdinal, .ok live =>
+    if sameOwner : found = owner then
+      if sameOrdinal : sourceOrdinal = ordinal then
+        if candidateLive : live = 1 then
+          some ⟨indexed,member,candidate,by simpa only [sameOwner] using a,
+            by simpa only [sameOrdinal] using b,by simpa only [candidateLive] using c⟩
+        else none
+      else none
+    else none
+  | _,_,_ => none
+
+theorem OwnerWitness.source_checks (witness : OwnerWitness owner ordinal) :
+    payloadSize witness.indexed = .ok owner ∧ payloadSize witness.member = .ok ordinal ∧
+      payloadSize witness.candidate = .ok 1 :=
+  ⟨witness.indexExact,witness.memberExact,witness.candidateExact⟩
+
+def original (source : Snapshot) (owner ordinal : Nat) : IO (OwnerWitness owner ordinal) := do
+  let indexed ← source.get (key "searchCandidate" ordinal)
+  let member ← source.get (key "member" owner)
+  let candidate ← source.get (key "candidate" owner)
+  let some checked := OwnerWitness.check? owner ordinal indexed member candidate |
+    throw (IO.userError "source lexical owner disagrees with its original publication")
+  return checked
+
+end Eggshell.SourceLexical

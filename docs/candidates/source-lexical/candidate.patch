+/-- Both source-side posting lists and ordinals belong to one pinned commit.
+No separately prepared lexical corpus is required after publication. -/
+def sourceQuery (source : PageMap.Snapshot) (receipt : Option String := none) : IO Query := do
+  let some reader ← SourceLexical.open? source |
+    throw (IO.userError "atomic source lexical index is unavailable")
+  let ordinals ← IO.mkRef ({} : Std.HashMap Nat Nat)
+  return {
+    posting := fun unit => do
+      let found ← SourceLexical.posting reader unit
+      for (ordinal,owner) in found.rows do
+        if let some previous := (← ordinals.get)[owner]? then
+          unless previous == ordinal do throw (IO.userError "source lexical postings disagree about owner order")
+        ordinals.modify (·.insert owner ordinal)
+      return (found.rows.map Prod.snd,found.frequency)
+    ordinal := fun owner => do
+      let some ordinal := (← ordinals.get)[owner]? |
+        throw (IO.userError "source lexical ordinal was not nominated")
+      let _ ← SourceLexical.original source owner ordinal
+      return ordinal
+    report := Receipt.observe receipt ("source-lexical-" ++ source.head.identity) (Json.mkObj [
+      ("source",toJson source.head),("contract",toJson SourceLexicalPolicy.contract),
+      ("candidates",toJson reader.population),("derivedWarmCalls",toJson (0 : Nat))]) }

+module
+public import Eggshell.SearchRank
+public import Eggshell.Sha256
+public import Eggshell.DB.PageMap
+@[expose] public section
+
+namespace Eggshell.SourceLexicalPolicy
+
+/-- The publication producer and reader share actual policy bytes. A primary
+index made by an unrecorded grammar is not silently treated as complete. -/
+def contract : String := Sha256.hex (
+  (include_str "SourceLexicalPolicy.lean").toUTF8 ++
+  (include_str "SearchRank.lean").toUTF8 ++
+  (include_str "SearchUnicode.lean").toUTF8 ++
+  (include_str "../tools/RetrievalGrams.lean").toUTF8 ++
+  (include_str "../tools/RetrievalCategories.lean").toUTF8)
+
+def name : String := "searchPolicy"
+
+def ready (stored : Option ByteArray) (population : Nat) : Bool :=
+  stored == some contract.toUTF8 || (stored.isNone && population == 0)
+
+theorem unrecorded_nonempty_rejected (population : Nat) (nonempty : population ≠ 0) :
+    ready none population = false := by
+  simp [ready, nonempty]
+
+def require (read : String → IO (Option ByteArray)) (population : Nat) : IO Unit := do
+  unless ready (← read name) population do
+    throw (IO.userError "source lexical policy is absent or differs from its publication producer")
+
+/-- Called inside the same source transaction as membership, postings and
+frequencies. Existing mixed-policy candidates cannot acquire a ready stamp. -/
+def record (writer : DB.PageMap.Writer) (population : Nat) : IO Unit := do
+  let stored ← writer.get name
+  unless ready stored population do
+    throw (IO.userError "cannot append to an unverified or different source lexical policy")
+  if stored.isNone then writer.put name (some contract.toUTF8)
+
+end Eggshell.SourceLexicalPolicy
--- a/Eggshell/SourceLexical.lean

@@ -9356,0 +9357,32 @@ theorem original_positions_complete (frontiers : List AdvisoryFrontier)
+/-- Retain the checked source directory separately from its query-local
+owner/family names. Numerical repair reads this same immutable directory;
+it does not rediscover it for every window of the same original. -/
+structure FocusDocument (sources : Array Persistence.Store.Snapshot) where
+  source : Fin sources.size
+  original : Persistence.Store.SearchDocument
+  owner : Nat
+  family : Nat
+
+def FocusDocument.request (document : FocusDocument sources) : Persistence.Store.SearchDocument :=
+  {document.original with owner := document.owner, work := document.family}
+
+theorem FocusDocument.windows_exact (document : FocusDocument sources) :
+    document.request.windows = document.original.windows := rfl
+
+theorem FocusDocument.cache_exact (document : FocusDocument sources) :
+    document.request.cache = document.original.cache := rfl
+
+def FocusDocument.work (document : FocusDocument sources)
+    (readers : Persistence.Store.NodeReaders sources) : IO String := do
+  let work ← (readers.at document.source).read document.original.work
+  match Matcher.atomText? work with
+  | some text => pure text
+  | none => throw (IO.userError "prepared focus Work is not textual")
+
+def FocusDocument.window (document : FocusDocument sources) (index : Nat) : IO String :=
+  Persistence.Store.readSearchWindow sources[document.source] document.original index
+
+theorem FocusDocument.window_original (document : FocusDocument sources) (index : Nat) :
+    document.window index =
+      Persistence.Store.readSearchWindow sources[document.source] document.original index := rfl
+

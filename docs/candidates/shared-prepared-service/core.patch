+module
+
+public import Eggshell.CanonicalSourceCache
+public import Eggshell.CanonicalSourceDelivery
+public import Std.Sync.Mutex
+public import Init.System.Promise
+
+@[expose] public section
+
+namespace Eggshell.Synapses.CanonicalSource.Shared
+open Lean DB
+
+def allOwners (registry : Registry) : Std.HashSet (String × String) := Id.run do
+  let mut allowed : Std.HashSet (String × String) := {}
+  for (_,atom) in registry.atoms do
+    for origin in atom.origins do
+      allowed := allowed.insert (origin.binding.database,origin.binding.owner)
+  return allowed
+
+structure Loaded where
+  ready : Cache.Ready
+  owners : Std.HashMap String (Array StoredRow)
+  exact : owners = Delivery.byOwner ready.registry (allOwners ready.registry)
+
+/-- All owners are projected once. Filtering the request then performs point
+lookups; neither a full registry nor another customer's state crosses the wire. -/
+def Loaded.make (ready : Cache.Ready) : Loaded :=
+  ⟨ready,Delivery.byOwner ready.registry (allOwners ready.registry),rfl⟩
+
+theorem Loaded.lookup_exact (loaded : Loaded) (owner : String) :
+    loaded.owners[owner]? =
+      (Delivery.byOwner loaded.ready.registry (allOwners loaded.ready.registry))[owner]? := by
+  rw [loaded.exact]
+
+def Loaded.rows (loaded : Loaded) (owners : Array String) : Array (String × Array StoredRow) :=
+  owners.map fun owner => (owner,loaded.owners[owner]?.getD #[])
+
+theorem Loaded.requested_domain (loaded : Loaded) (owners : Array String) :
+    (loaded.rows owners).map Prod.fst = owners := by
+  simp [Loaded.rows,Array.map_map,Function.comp_def]
+
+structure Budget (capacity : Nat) where
+  used : Nat := 0
+  within : used ≤ capacity := by omega
+
+def Budget.reserve? (budget : Budget capacity) (amount : Nat) : Option (Budget capacity) :=
+  if fits : budget.used+amount ≤ capacity then some ⟨budget.used+amount,fits⟩ else none
+
+def Budget.release (budget : Budget capacity) (amount : Nat) : Budget capacity :=
+  ⟨budget.used-amount,Nat.le_trans (Nat.sub_le ..) budget.within⟩
+
+theorem Budget.reserved_within (budget next : Budget capacity) (amount : Nat)
+    (_reserved : budget.reserve? amount = some next) : next.used ≤ capacity := next.within
+
+def capacity : Nat := 512*1024*1024
+def maxLoads : Nat := 2
+def maxEntries : Nat := 128
+
+structure Entry where
+  promise : IO.Promise (Except String Loaded)
+  charge : Nat
+  borrowers : Nat
+  stamp : Nat
+  serial : Nat
+  loading : Bool := true
+
+structure State where
+  entries : Std.HashMap String Entry := {}
+  budget : Budget capacity := {}
+  active : Nat := 0
+  clock : Nat := 0
+  closed : Bool := false
+  loads : Nat := 0
+  hits : Nat := 0
+  joins : Nat := 0
+  evictions : Nat := 0
+  readBytes : Nat := 0
+
+structure Pool where
+  state : Std.Mutex State
+  tasks : Std.Mutex (Array (Task (Except IO.Error Unit)))
+
+def Pool.new : IO Pool := return ⟨← Std.Mutex.new {},← Std.Mutex.new #[]⟩
+
+inductive Admission where
+  | borrowed (entry : Entry)
+  | start (entry : Entry)
+  | busy
+
+def evict (state : State) : Option State := do
+  let idle := state.entries.toArray.filter fun (_,entry) => !entry.loading && entry.borrowers == 0
+  let (key,entry) ← (idle.qsort fun a b => a.2.stamp < b.2.stamp)[0]?
+  return {state with
+    entries := state.entries.erase key
+    budget := state.budget.release entry.charge
+    evictions := state.evictions+1}
+
+def reclaim (state : State) (charge : Nat) : Nat → State
+  | 0 => state
+  | fuel+1 =>
+      if state.budget.used+charge ≤ capacity && state.entries.size < maxEntries then state else
+      match evict state with
+      | none => state
+      | some next => reclaim next charge fuel
+
+def State.borrow? (state : State) (key : String) : Option (State × Entry) := do
+  let entry ← state.entries[key]?
+  let entry := {entry with borrowers := entry.borrowers+1,stamp := state.clock+1}
+  return ({state with
+    entries := state.entries.insert key entry
+    clock := state.clock+1
+    hits := state.hits + (if entry.loading then 0 else 1)
+    joins := state.joins + (if entry.loading then 1 else 0)},entry)
+
+def Pool.borrow? (pool : Pool) (key : String) : IO (Option Entry) := pool.state.atomically do
+  let state ← get
+  unless !state.closed do throw (IO.userError "prepared source service is closed")
+  let some (next,entry) := state.borrow? key | return none
+  set next
+  return some entry
+
+def Pool.admit (pool : Pool) (key : String) (charge : Nat) : IO Admission := pool.state.atomically do
+  let state ← get
+  unless !state.closed do throw (IO.userError "prepared source service is closed")
+  if let some (state,entry) := state.borrow? key then
+    set state
+    return .borrowed entry
+  if state.active ≥ maxLoads then return .busy
+  let state := reclaim state charge maxEntries
+  if state.active ≥ maxLoads || state.entries.size ≥ maxEntries then
+    set state
+    return .busy
+  let some budget := state.budget.reserve? charge | set state; return .busy
+  let entry : Entry := ⟨← IO.Promise.new,charge,1,state.clock+1,state.clock+1,true⟩
+  set {state with
+    entries := state.entries.insert key entry
+    budget
+    clock := state.clock+1
+    active := state.active+1
+    loads := state.loads+1}
+  return .start entry
+
+def Pool.release (pool : Pool) (key : String) (serial : Nat) : IO Unit := pool.state.atomically do
+  modify fun state => match state.entries[key]? with
+    | none => state
+    | some entry => if entry.serial != serial then state else
+        {state with entries := state.entries.insert key {entry with borrowers := entry.borrowers-1}}
+
+def Pool.finish (pool : Pool) (key : String) (entry : Entry)
+    (bytes : Nat) (result : Except String Loaded) : IO Unit := pool.state.atomically do
+  let state ← get
+  if !state.closed then
+    match state.entries[key]? with
+    | none => pure ()
+    | some current =>
+        if current.serial != entry.serial then pure () else match result with
+        | .ok _ => set {state with
+            active := state.active-1
+            readBytes := state.readBytes+bytes
+            entries := state.entries.insert key {current with loading := false}}
+        | .error _ => set {state with
+            active := state.active-1
+            entries := state.entries.erase key
+            budget := state.budget.release current.charge}
+  unless ← entry.promise.isResolved do entry.promise.resolve result
+
+/-- Closing and launching share the same short ownership lock. A requester
+cannot spawn a preparation after close has retired its task registry. -/
+def Pool.launch (pool : Pool) (identity : String) (entry : Entry) (bytes : Nat)
+    (load : IO Loaded) : IO Unit := pool.state.atomically do
+  let state ← get
+  if state.closed then
+    unless ← entry.promise.isResolved do entry.promise.resolve (.error "prepared source service stopped")
+    return
+  let task ← IO.asTask (do
+    let result ← try pure (.ok (← load) : Except String Loaded)
+      catch error => pure (.error error.toString)
+    pool.finish identity entry bytes result) .dedicated
+  pool.tasks.atomically do
+    let live ← (← get).filterM fun task => return !(← IO.hasFinished task)
+    set (live.push task)
+
+def key (path : System.FilePath) (metadata : Cache.Manifest) : String :=
+  (toJson (path.normalize.toString,metadata)).compress
+
+inductive Reuse where
+  | loaded | joined | hit
+  deriving BEq, ToJson, FromJson
+
+/-- A read capability names one source scope and immutable preparation.
+Only its non-secret identity belongs in a delivery/memo receipt. -/
+structure Access where
+  database : String
+  scope : String
+  capability : String
+  source : PageMap.Head
+  metadata : Cache.Manifest
+  reuse : Reuse
+  deriving ToJson, FromJson
+
+def Access.identity (access : Access) : Json :=
+  toJson (access.database,access.scope,access.source,access.metadata)
+
+theorem Access.capability_not_identity (access : Access) (secret : String) :
+    ({access with capability := secret}).identity = access.identity := rfl
+
+structure Projection where
+  identity : Json
+  rows : Array (String × Array StoredRow)
+  reuse : Reuse
+  deriving ToJson, FromJson
+
+/-- Payload bytes are verified only by the preparation owner. Admission
+charges a conservative footprint including decoder and origin-index overhead;
+the process RSS limit is measured independently of this accounting. -/
+def Pool.acquire (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)
+    (metadata : Cache.Manifest) (deadline : Nat) : IO (Entry × Reuse) := do
+  unless (← IO.monoMsNow) < deadline do throw (IO.userError "prepared source request expired")
+  let identity := key path metadata
+  if let some entry ← pool.borrow? identity then
+    return (entry,if entry.loading then .joined else .hit)
+  let payload := path / (metadata.payload ++ ".json")
+  let bytes := (← payload.metadata).byteSize.toNat
+  unless bytes ≤ 32*1024*1024 do throw (IO.userError "prepared source payload exceeds its bound")
+  let charge := bytes*8+metadata.rows*1024+65536
+  unless charge ≤ capacity do throw (IO.userError "prepared source footprint exceeds service capacity")
+  repeat
+    unless (← IO.monoMsNow) < deadline do throw (IO.userError "prepared source admission expired")
+    match ← pool.admit identity charge with
+    | .busy => IO.sleep 1
+    | .borrowed entry => return (entry,if entry.loading then .joined else .hit)
+    | .start entry =>
+        try
+          pool.launch identity entry bytes do
+            let some ready ← Cache.atSource? source path metadata |
+              throw (IO.userError "prepared source no longer matches its publication")
+            return Loaded.make ready
+        catch error => pool.finish identity entry 0 (.error error.toString)
+        return (entry,.loaded)
+  throw (IO.userError "unreachable prepared source admission")
+
+def Pool.withReady (pool : Pool) (source : PageMap.Snapshot) (path : System.FilePath)
+    (metadata : Cache.Manifest) (deadline : Nat) (use : Loaded → Reuse → IO α) : IO α := do
+  let identity := key path metadata
+  let (entry,reuse) ← pool.acquire source path metadata deadline
+  try
+    repeat
+      unless (← IO.monoMsNow) < deadline do throw (IO.userError "prepared source wait expired")
+      if ← entry.promise.isResolved then
+        let some result := entry.promise.result?.get | throw (IO.userError "prepared source reply missing")
+        return ← use (← IO.ofExcept result) reuse
+      IO.sleep 1
+    throw (IO.userError "unreachable prepared source wait")
+  finally pool.release identity entry.serial
+
+def Pool.close (pool : Pool) : IO Unit := do
+  pool.state.atomically do
+    let state ← get
+    set {state with closed := true,entries := {},budget := {},active := 0}
+    for (_,entry) in state.entries do
+      unless ← entry.promise.isResolved do entry.promise.resolve (.error "prepared source service stopped")
+  for task in ← pool.tasks.atomically get do IO.cancel task
+
+def Pool.stats (pool : Pool) : IO Json := pool.state.atomically do
+  let state ← get
+  return Json.mkObj [("entries",toJson state.entries.size),("chargedBytes",toJson state.budget.used),
+    ("capacity",toJson capacity),("active",toJson state.active),("loads",toJson state.loads),
+    ("hits",toJson state.hits),("joins",toJson state.joins),("evictions",toJson state.evictions),
+    ("verifiedPayloadBytes",toJson state.readBytes),("closed",toJson state.closed),
+    ("accountedExact",toJson (state.budget.used ==
+      state.entries.fold (fun total _ entry => total+entry.charge) 0))]
+
+end Eggshell.Synapses.CanonicalSource.Shared

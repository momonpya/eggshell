+  sources : Std.Mutex (Array ReadSource)
+  prepared : CanonicalSource.Shared.Pool
+  sourceReplies : Std.Mutex Nat
+  deferredReplies : Std.Mutex (Array DeferredReply)
+
+def reserveReply (server : Server) (charge deadline : Nat) : IO Unit := do
+  repeat
+    unless !(← server.stopping.get) && (← IO.monoMsNow) < deadline do
+      throw (IO.userError "source service reply admission expired")
+    let admitted ← server.sourceReplies.atomically do
+      let used ← get
+      -- Large source responses leave control headroom. Slow readers must
+      -- not prevent stats, source ACKs or the service owner's shutdown.
+      let limit := if charge > 65536 then 48*1024*1024 else 64*1024*1024
+      if used+charge > limit then return false
+      set (used+charge)
+      return true
+    if admitted then return
+    IO.sleep 1
+
+/-- A timed-out send retains its byte reservation until the native write has
+released its buffers. Slow readers cannot create unaccounted output queues. -/
+def sendReply (server : Server) (client : Socket.Client) (payload : ByteArray)
+    (deadline : Nat) (reserved : IO.Ref Nat) : IO Unit := do
+  let charge ← reserved.get
+  unless payload.size ≤ Daemon.maxFrameBytes && payload.size ≤ charge && charge > 0 do
+    throw (IO.userError "unreserved or oversized source service reply")
+  let pending ← client.native.send #[Daemon.frameLength payload,payload]
+  let started ← IO.monoMsNow
+  repeat
+    if ← pending.isResolved then
+      let some result := pending.result?.get | throw (IO.userError "source service send disappeared")
+      return ← IO.ofExcept result
+    let now ← IO.monoMsNow
+    if now ≥ deadline || ((← server.stopping.get) && now ≥ started+25) then
+      let charge ← reserved.get
+      server.deferredReplies.atomically (modify (·.push ⟨pending,charge⟩))
+      reserved.set 0
+      throw (IO.userError "source service send expired")
+    IO.sleep 1
+
+def reapReplies (server : Server) : IO Unit := do
+  let released ← server.deferredReplies.atomically do
+    let mut live := #[]
+    let mut released := 0
+    for reply in ← get do
+      if ← reply.promise.isResolved then released := released+reply.charge
+      else live := live.push reply
+    set live
+    return released
+  server.sourceReplies.atomically (modify (·-released))
+
+/-- Read registration grants no publisher lease or source write authority.
+Paths are accepted only through the existing local administration capability. -/
+def readSource (server : Server) (path : System.FilePath) (database : String)
+    (storage : Sidecar.Storage) : IO ReadSource := server.sources.atomically do
+  let sources ← get
+  if let some source := sources.find? (fun source => source.directory == path &&
+      source.database == database && source.storage == storage) then return source
+  unless sources.size < 1024 do throw (IO.userError "prepared source registration is full")
+  let scope := Sha256.hex (toJson (path.normalize.toString,database,storage)).compress.toUTF8
+  let source : ReadSource := ⟨path,database,storage,scope,Blake3.hex (← IO.getRandomBytes 32)⟩
+  set (sources.push source)
+  return source
+
+def prepareRegistered (server : Server) (scope : ReadSource)
+    (requested : Option PageMap.Head) (deadline : Nat) : IO Json := do
+  let current ← PageMap.pin scope.directory
+  unless current.head.identity == scope.database do throw (IO.userError "prepared source incarnation changed")
+  let some pinned ← PageMap.HistoryReader.make? current (requested.getD current.head) |
+    throw (IO.userError "requested prepared source snapshot is unavailable")
+  let source := pinned.snapshot
+  let cachePath ← CanonicalSource.Cache.directory source scope.storage
+  let some metadata ← CanonicalSource.Cache.manifest? cachePath | return Json.null
+  unless metadata.implementation == CanonicalSource.Cache.implementation &&
+      digest metadata.payload && (← Index.sameSources source metadata.source) do return Json.null
+  server.prepared.withReady source cachePath metadata deadline fun loaded reuse => do
+    let access : CanonicalSource.Shared.Access := {
+      database := source.head.identity
+      scope := scope.scope
+      capability := scope.capability
+      source := source.head
+      metadata := loaded.ready.metadata
+      reuse}
+    return toJson access
+
+def prepareSource (server : Server) (payload : Json) (deadline : Nat) : IO Json := do
+  let path ← PageMap.absolute (.mk (← IO.ofExcept (payload.getObjValAs? String "directory")))
+  let head ← IO.ofExcept (payload.getObjVal? "source" >>= fromJson? (α := PageMap.Head))
+  let storage ← IO.ofExcept (payload.getObjVal? "storage" >>= fromJson? (α := Sidecar.Storage))
+  let current ← PageMap.pin path
+  unless current.head.identity == head.identity do throw (IO.userError "prepared source identity changed")
+  let scope ← readSource server path head.identity storage
+  prepareRegistered server scope (some head) deadline
+
+def scopedSource (server : Server) (secret : String) (payload : Json) : IO ReadSource := do
+  let database ← IO.ofExcept (payload.getObjValAs? String "database")
+  let identity ← IO.ofExcept (payload.getObjValAs? String "scope")
+  server.sources.atomically do
+    let some scope := (← get).find? (fun source => source.database == database && source.scope == identity) |
+      throw (IO.userError "unknown prepared source scope")
+    unless scope.capability == secret do throw (IO.userError "unauthorized prepared source projection")
+    return scope
+
+def refreshSource (server : Server) (secret : String) (payload : Json) (deadline : Nat) : IO Json := do
+  let scope ← scopedSource server secret payload
+  let requested ← IO.ofExcept (payload.getObjVal? "source" >>= fromJson? (α := Option PageMap.Head))
+  prepareRegistered server scope requested deadline
+
+def sourceRows (server : Server) (secret : String) (payload : Json) (deadline : Nat) : IO Json := do
+  let database ← IO.ofExcept (payload.getObjValAs? String "database")
+  let identity ← IO.ofExcept (payload.getObjValAs? String "scope")
+  let scope ← scopedSource server secret payload
+  let head ← IO.ofExcept (payload.getObjVal? "source" >>= fromJson? (α := PageMap.Head))
+  let metadata ← IO.ofExcept (payload.getObjVal? "metadata" >>= fromJson? (α := CanonicalSource.Cache.Manifest))
+  let owners ← IO.ofExcept (payload.getObjValAs? (Array String) "owners")

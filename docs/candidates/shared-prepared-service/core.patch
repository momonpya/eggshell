+structure SourceReference where
+  endpoint : Daemon.Endpoint
+  access : Synapses.CanonicalSource.Shared.Access
+
+def SourceReference.metadata (reference : SourceReference) := reference.access.metadata
+
+def SourceReference.identity (reference : SourceReference) : Json := reference.access.identity
+
+def liveBudget (deadline : Nat) : IO Nat := do
+  let now ← IO.monoMsNow
+  unless now < deadline do throw (IO.userError "prepared source request expired")
+  return min maxBudgetMs (deadline-now)
+
+/-- An explicitly supplied data-side owner is useful to native clients and
+does not require a writer registration for a read-only source. -/
+def prepareSourceUsing (endpoint : Daemon.Endpoint) (source : PageMap.Snapshot)
+    (storage : Sidecar.Storage) (deadline : Nat) : IO (Option SourceReference) := do
+  let budget ← liveBudget deadline
+  let response ← Daemon.exchange endpoint "prepare-source" (Json.mkObj [
+    ("directory",toJson source.directory.toString),("source",toJson source.head),("storage",toJson storage),
+    ("budgetMs",toJson budget)]) (budget := budget)
+  let value ← IO.ofExcept (Json.parse response)
+  if value == Json.null then return none
+  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)
+  unless access.database == source.head.identity && access.source == source.head &&
+      access.metadata.source.identity == source.head.identity && Synapses.digest access.scope &&
+      Synapses.digest access.capability &&
+      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do
+    throw (IO.userError "prepared source reply changed its scope or source")
+  return some ⟨{endpoint with secret := access.capability},access⟩
+
+/-- After local administration grants a read scope, refreshing it needs only
+that scope's read capability, including when the publisher is another owner. -/
+def SourceReference.refresh (reference : SourceReference) (source : PageMap.Head)
+    (deadline : Nat) : IO (Option SourceReference) := do
+  let budget ← liveBudget deadline
+  let response ← Daemon.exchange reference.endpoint "refresh-source" (Json.mkObj [
+    ("database",toJson reference.access.database),("scope",toJson reference.access.scope),
+    ("source",toJson (some source)),("budgetMs",toJson budget)]) (budget := budget)
+  let value ← IO.ofExcept (Json.parse response)
+  if value == Json.null then return none
+  let access ← IO.ofExcept (fromJson? (α := Synapses.CanonicalSource.Shared.Access) value)
+  unless access.database == reference.access.database && access.scope == reference.access.scope &&
+      access.capability == reference.access.capability && access.source == source &&
+      access.metadata.implementation == Synapses.CanonicalSource.Cache.implementation do
+    throw (IO.userError "prepared source refresh changed its read authority")
+  return some ⟨reference.endpoint,access⟩
+
+def sourceRows (reference : SourceReference) (owners : Array String) (deadline : Nat) :
+    IO Synapses.CanonicalSource.Shared.Projection := do
+  let access := reference.access
+  let owners := (hashDistinct owners.toList).toArray
+  let budget ← liveBudget deadline
+  let response ← Daemon.exchange reference.endpoint "source-rows" (Json.mkObj [
+    ("database",toJson access.database),("scope",toJson access.scope),("source",toJson access.source),
+    ("metadata",toJson access.metadata),("owners",toJson owners),("budgetMs",toJson budget)]) (budget := budget)
+  let result ← IO.ofExcept (Json.parse response >>= fromJson? (α := Synapses.CanonicalSource.Shared.Projection))
+  unless result.identity == reference.identity && result.rows.map Prod.fst == owners do
+    throw (IO.userError "prepared source projection changed its owner domain")
+  for (owner,rows) in result.rows do
+    unless rows.all (fun row => row.origins.all (fun origin =>
+        origin.binding.database == access.database && origin.binding.owner == owner)) do
+      throw (IO.userError "prepared source projection crossed its owner scope")
+    let _ ← IO.ofExcept (Synapses.CanonicalSource.load access.database rows)
+    pure ()
+  return result
+

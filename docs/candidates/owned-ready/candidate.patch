+def Sidecar.withRetirementRegions (directory : System.FilePath)
+    (regions : List Sidecar.IndexRegion) (action : IO (Option α)) : IO (Option α) := do
+  match regions with
+  | [] => action
+  | region :: rest =>
+    let path := directory / region.guardName
+    let lease ← if (← FileSystem.symlinkMetadata? path).isSome then
+        some <$> FileSystem.openRead path.toString

@@ -34 +34,26 @@
-def State.advance (state : State prior stored depth) (layout : Sparse.Layout p)
+
+def advanceKnown (seen : Known prior) (next : Selection p) (winner : Fin p.offers.size)
+    (extension : next.selected = prior.selected++[winner]) : Known next := {
+  selected := seen.selected.insert winner ()
+  exact := by
+    intro index
+    rw [Std.HashMap.contains_insert,seen.exact,extension,List.contains_append]
+    simp only [List.contains_cons,List.contains_nil,Bool.or_false]
+    rw [BEq.comm (a := winner) (b := index)]
+    exact Bool.or_comm _ _}
+
+theorem scoreSeen (stored : Sparse.Values prior) (first second : Known prior) (index : Fin p.offers.size) :
+    Sparse.score? prior stored first index = Sparse.score? prior stored second index := by
+  rw [Sparse.score_exact,Sparse.score_exact]
+  simp only [Deferred.score?]
+
+theorem ratingSeen (stored : Sparse.Values prior) (first second : Known prior) :
+    ratingAt prior stored first = ratingAt prior stored second := by
+  funext position
+  unfold ratingAt
+  by_cases inside : position < p.offers.size
+  · simp only [dif_pos inside]
+    rw [scoreSeen stored first second]
+  · simp only [dif_neg inside]
+
+def State.advanceUsing (state : State prior stored depth) (layout : Sparse.Layout p)

+def families (items : List SharedRangeAdapter.Family) : IO Unit := do
+  let mut measured := #[]
+  for (item,index) in items.zipIdx do
+    let item := item.contextualOutputs
+    let source := (Matcher.atomText? item.owner.outcome).getD ""
+    let characters ← Eggshell.Research.AllocationMeasure.run source
+      (fun text => (IndexedCharacters.make text).chars)
+      (fun chars => Json.mkObj [("characters",toJson chars.size)])
+    let candidates ← Eggshell.Research.AllocationMeasure.run item
+      (fun family => if family.isFile then SharedRangeAdapter.prepareOutputs index family
+        else SharedRangeAdapter.prepare index family) unitSummary
+    measured := measured.push (Json.mkObj [("family",toJson index),
+      ("owner",toJson (relationKey item.owner.relation)),("fileFamily",toJson item.isFile),
+      ("nativeOutcome",toJson (Matcher.nativeOutcome item.owner)),("sourceBytes",toJson source.utf8ByteSize),
+      ("outputRanges",toJson item.outputRanges.length),
+      ("independentCharacterIndexProbe",characters),("actualCandidatePreparation",candidates)])
+  Publication.Stream.profile "allocation-family-inputs" [("families",toJson measured),
+    ("independentProbesNotAddedToProductionTotals",toJson true)]
+end AllocationProbe

+/-- A source sharing a project matrix streams only its own requested keys.
+Other sources' rows are not enumerated or hydrated. -/
+def foldKeys (matrix : VectorMatrix.Ready) (keys : List String)
+    (consume : α → Row → IO α) (initial : α) : IO α := do
+  let rowBytes ← width matrix
+  let mut previous : Option String := none
+  let mut state := initial
+  for key in keys.mergeSort (· ≤ ·) do
+    unless previous.all (· < key) do throw (IO.userError "duplicate source projection request")
+    let some bytes ← matrix.snapshot.get ("row:"++key) |
+      throw (IO.userError "source projection is absent from its shared matrix")
+    let row ← checked key bytes
+    unless row.value.bytes == rowBytes do throw (IO.userError "source projection dimensions vary")
+    state ← consume state row
+    previous := some key
+  checkExtent matrix.snapshot
+  return state
+

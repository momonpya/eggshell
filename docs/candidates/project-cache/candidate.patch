+module
+
+public import Eggshell.DB.PageMap
+public import Eggshell.GraphCodec
+
+@[expose] public section
+namespace Eggshell.DB
+open Lean
+
+/-- Immutable cache placement metadata, not execution or equality authority. -/
+structure ProjectCacheScope where
+  identity : String
+  inventory : String
+  authority : String
+  deriving Repr, BEq, ToJson, FromJson
+
+def ProjectCacheScope.maxOwners : Nat := 128
+
+def ProjectCacheScope.valid (scope : ProjectCacheScope) : Bool :=
+  PageMap.validIdentity scope.identity && PageMap.validIdentity scope.inventory &&
+    scope.authority == (Persistence.valueToJson (.text ("egg project "++scope.identity))).compress
+
+def ProjectCacheScope.read (root : System.FilePath) : IO ProjectCacheScope := do
+  let bytes ← FileSystem.boundedBytes (root/"cache-scope") 4096
+  let some text := String.fromUTF8? bytes | throw (IO.userError "invalid project cache descriptor encoding")
+  let scope ← IO.ofExcept (Json.parse text >>= fromJson? (α := ProjectCacheScope))
+  unless scope.valid && (toJson scope).compress.toUTF8 == bytes do
+    throw (IO.userError "invalid project cache descriptor")
+  return scope
+
+structure ProjectCacheScope.Location where
+  root : System.FilePath
+  scope : ProjectCacheScope
+
+/-- Layout and the immutable source authority bind this small descriptor.
+The complete owner inventory is checked by the project read/write boundary. -/
+def ProjectCacheScope.at? (source : PageMap.Snapshot) : IO (Option ProjectCacheScope.Location) := do
+  if source.directory.fileName != some "source.egg" then return none
+  let some owner := source.directory.parent | return none
+  let some owners := owner.parent | return none
+  if owners.fileName != some "owners" then return none
+  let some root := owners.parent | return none
+  if !(← (root/"project").pathExists) then return none
+  let some slot := owner.fileName.bind String.toNat? |
+    throw (IO.userError "invalid project cache owner slot")
+  unless slot < ProjectCacheScope.maxOwners && owner.fileName == some (toString slot) do
+    throw (IO.userError "noncanonical project cache owner slot")
+  let scope ← read root
+  unless source.head.authority == scope.authority && source.head.identity != scope.identity do
+    throw (IO.userError "source crossed its project cache authority")
+  return some ⟨root,scope⟩
+
+end Eggshell.DB

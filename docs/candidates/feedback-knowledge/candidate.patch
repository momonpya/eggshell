+/-- One background source catalog owns both literal records and already
+validated file correspondences. No command parser or live file matching is
+used to reconstruct cached aliases. Supplements remain bound to their parent. -/
+def addFileCoordinates (snapshot : PageMap.Snapshot) (id : Nat) (doc : Document)
+    (original : ObservationContext.Catalog)
+    (prepared : Option PageMap.Snapshot := none) (addition : Option ContentCapture.Supplement := none) :
+    IO ObservationContext.Catalog := do
+  let captured ← match ← load? snapshot id doc with
+    | none => pure ({} : ObservationContext.Catalog)
+    | some parent => do
+        let extra ← match addition with
+          | some extra => pure (some extra)
+          | none => prepared.bindM fun index => loadSupplement? index snapshot.head.identity id doc parent
+        let original ← IO.ofExcept (catalog snapshot.head.identity doc parent)
+        match extra with
+        | none => pure original
+        | some extra =>
+            let added ← IO.ofExcept (catalogSupplement snapshot.head.identity doc parent extra)
+            pure {located := original.located ++ added.located,quotations := original.quotations ++ added.quotations}
+  return {
+    original with
+    located := captured.located ++ original.located
+    quotations := captured.quotations ++ original.quotations}
+
 end Eggshell.ContentMetadata

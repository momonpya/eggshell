+import Eggshell.Handoff
+open Lean Eggshell Eggshell.Plugin
+private def check (value : Bool) (message : String) : IO Unit :=
+  unless value do throw (IO.userError message)
+def main : IO Unit := do
+  let source := "\n".intercalate ((List.range 6).map fun i =>
+    toString (10+i) ++ "\t" ++ String.ofList (List.replicate 200 'a'))
+  let owner := OutcomeEdge.make (.text "read") (.text source) [] (by simp) (by simp)
+  let record : SourceEvidence.Record := {
+    workspace := "/unused",files := [{relative := "src/driver.cpp",content := none}]
+    complete := false}
+  let citation := "[driver.cpp:10-15](/unused/src/driver.cpp:10)"
+  let some (_,positions,ranks) := rankedCitedObservationCoordinates [(4,citation),(1,citation)] owner [record] |
+    throw (IO.userError "stored interval disappeared")
+  check (positions.contains 0 && positions.any (fun i => i >= 2)) "the citation end never reached its original source window"
+  check (ranks.all (fun row => row.2 == 1)) "producer rank was replaced by citation or source-window enumeration"
+  let original : TransportSlice := {
+    owner := some owner.relation,keys := [],text := source,members := [],visibleKeys := []}
+  let family : SharedRangeAdapter.Family := {
+    owner,template := original,windows := [],references := [0,1],referenceRanks := [(0,7),(1,3)]}
+  check ((SharedRangeAdapter.rankedCues family).map (·.priority) == [7,3]) "actual producer priority did not reach the fitter"
+  let huge := "[driver.cpp:1-100000000000000000000](/unused/src/driver.cpp:1)"
+  let some (_,bounded,_) := rankedCitedObservationCoordinates [(0,huge)] owner [record] |
+    throw (IO.userError "finite stored interval disappeared")
+  check (bounded.length <= 10) "untrusted line interval became an allocation bound"
+  check (owner.outcome == .text source) "original source was changed"
+  IO.println "citation range/rank projection checks passed"

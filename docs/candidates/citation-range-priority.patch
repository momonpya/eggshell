+import Eggshell.Handoff
+open Lean Eggshell Eggshell.Plugin
+private def check (value : Bool) (message : String) : IO Unit :=
+  unless value do throw (IO.userError message)
+def main : IO Unit := do
+  check (citationBounds? "10-15" == some (10,15)) "range end lost"
+  check (citationBounds? "10–15" == some (10,15)) "en dash lost"
+  check (citationBounds? "10-L15" == some (10,15)) "GitHub range lost"
+  check (citationBounds? "0-15" == none && citationBounds? "15-10" == none) "invalid interval admitted"
+  let path := "src/driver.cpp"
+  check (citedLineIntervals "[driver.cpp:10-15](/snapshot/src/driver.cpp:10)" path == [(10,15)]) "displayed range lost"
+  check (citedLineIntervals "[driver.cpp:10-15](/snapshot/src/driver.cpp#L10-L15)" path == [(10,15)]) "GitHub range lost"
+  check (citedLineIntervals "[driver.cpp:10-15](/snapshot/src/driver.cpp:11)" path == []) "conflicting start admitted"
+  check (citedLineIntervals "[driver.cpp:10-15](/snapshot/src/driver.cpp#L10-L16)" path == []) "conflicting end admitted"
+  check (citedLineIntervals "[driver.cpp:10-15](/snapshot/other/driver.cpp:10)" path == []) "undeclared path admitted"
+  check (citedLineIntervals "[driver.cpp:10-15](/snapshot/src/driver.cpp:10)" "../src/driver.cpp" == []) "unsafe path admitted"
+  check (citedLineIntervals "[driver.cpp:10-15](/snapshot/src/driver.cpp#L10-L10)" path == []) "explicit singleton conflict admitted"
+  IO.println "citation interval checks passed"

-structure LocatedOutput (doc : Extraction.Document) where
+/-- A checked advisory reference keeps only what delivery consumes. The full
+original fragment, including its JSON tree and character arrays, is a proof
+witness and is erased from the executable representation. -/
+structure OutputFragment (doc : Extraction.Document) where
+  occurrence : Occurrence
+  binding : Binding
+  path : Option (List JsonScalars.Segment)
+  checked : ∃ original : ObservationContext.Fragment doc,
+    occurrence = original.occurrence ∧ binding = original.binding ∧
+      path = original.address.map (·.path)
+
+def OutputFragment.ofOriginal (original : ObservationContext.Fragment doc) : OutputFragment doc :=
+  ⟨original.occurrence,original.binding,original.address.map (·.path),⟨original,rfl,rfl,rfl⟩⟩
+
+theorem OutputFragment.original_checks (fragment : OutputFragment doc) :
+    doc.native = true ∧ doc.occurrences.contains fragment.occurrence = true ∧
+      fragment.binding.owner = doc.owner ∧ fragment.binding.work = doc.work ∧
+      fragment.binding.valid = true := by
+  obtain ⟨original,occurrence,binding,_⟩ := fragment.checked
+  simpa only [occurrence,binding] using
+    And.intro original.native ⟨original.origin,original.owner,original.work,original.valid⟩
+
+theorem OutputFragment.path_checked (fragment : OutputFragment doc)
+    (path : List JsonScalars.Segment) (present : fragment.path = some path) :
+    ∃ raw, doc.source = some raw ∧ ∃ address : JsonScalars.Address raw, address.path = path := by
+  obtain ⟨original,_,_,samePath⟩ := fragment.checked
+  rw [samePath] at present
+  obtain ⟨address,_,exact⟩ := Option.map_eq_some_iff.mp present
+  exact ⟨original.raw,original.original,address,exact⟩
+
+/-- The original checked computation is kept as the refinement specification;
+each successful item is projected before it enters the retained array. -/
+structure OriginalOutput (doc : Extraction.Document) where
   offer : Offer
   fragment : ObservationContext.Fragment doc
   target : offer.target = .output fragment.occurrence
 
-def locateOutputsUsing (offers : Array Offer) (database : String)
-    (prepared : ObservationContext.Prepared doc) : Array (LocatedOutput doc) :=
-  offers.filterMap fun offer => do
+structure LocatedOutput (doc : Extraction.Document) where
+  offer : Offer
+  fragment : OutputFragment doc
+  target : offer.target = .output fragment.occurrence
+
+def OriginalOutput.compact (original : OriginalOutput doc) : LocatedOutput doc :=
+  ⟨original.offer,OutputFragment.ofOriginal original.fragment,original.target⟩
+
+def locateOutputUsing (database : String) (prepared : ObservationContext.Prepared doc)
+    (offer : Offer) : Option (OriginalOutput doc) := do
     let .output _ := offer.target | none
     let .consumed edge := offer.fact | none
     let fragment ← prepared.locate? database edge
     if target : offer.target = .output fragment.occurrence then some ⟨offer,fragment,target⟩ else none
 
+def locateOutputsUsing (offers : Array Offer) (database : String)
+    (prepared : ObservationContext.Prepared doc) : Array (LocatedOutput doc) :=
+  offers.filterMap fun offer => (locateOutputUsing database prepared offer).map OriginalOutput.compact
+
+/-- Preserve successful items, rejection, order and duplicates for every input.
+The right-hand side is a specification, not the executable allocation order. -/
+theorem locateOutputsUsing_exact (offers : Array Offer) (database : String)
+    (prepared : ObservationContext.Prepared doc) :
+    locateOutputsUsing offers database prepared =
+      (offers.filterMap (locateOutputUsing database prepared)).map OriginalOutput.compact :=
+  Array.map_filterMap.symm
+
+theorem OriginalOutput.compact_fields (original : OriginalOutput doc) :
+    original.compact.offer = original.offer ∧
+      original.compact.fragment.occurrence = original.fragment.occurrence ∧
+      original.compact.fragment.binding = original.fragment.binding ∧
+      original.compact.fragment.path = original.fragment.address.map (·.path) :=
+  ⟨rfl,rfl,rfl,rfl⟩
+
 def locateOutputs (offers : Array Offer) (database : String) (doc : Extraction.Document) : Array (LocatedOutput doc) :=
   (ObservationContext.prepare? doc).map (locateOutputsUsing offers database) |>.getD #[]
 

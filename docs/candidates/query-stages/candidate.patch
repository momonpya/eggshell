diff --git a/Eggshell/OperationPool.lean b/Eggshell/OperationPool.lean
index 33828eed..bb77b013 100644
--- a/Eggshell/OperationPool.lean
+++ b/Eggshell/OperationPool.lean
@@ -228,9 +228,28 @@ def Pool.searchActor (pool : Pool) (request : Worker.Search) (cancelled : IO.Ref
-  let request ← IO.ofExcept request.restorePrepared
-  let initial ← Worker.openSearchEnvironment request
-  let (environment,readers) ← match request.prepared,initial.snapshots with
-    | some inputs,some originals => do
-      let frame ← PreparedReaders.Frame.capture (originals.filterMap id).toArray inputs request.owners
-      let session ← pool.readers.borrow frame request.deadline cancelled
-      pure (← IO.ofExcept (initial.withSources session.sources),some session.pool)
-    | _,_ => pure (initial,none)
-  try Worker.executeUsing request (fun phase signal => searchPhase phase environment readers signal) ready
+  let times ← if (← IO.getEnv "EGGSHELL_TRACE_QUERY_STAGES") == some "1" then
+      some <$> IO.mkRef (#[] : Array (String × Nat))
+    else pure none
+  let mark := fun label => do
+    if let some times := times then
+      let now ← IO.monoMsNow
+      times.modify (·.push (label,now))
+  let finalReaders ← IO.mkRef (none : Option PreparedReaders.Pool)
+  try
+    mark "restore-request:start"
+    let request ← IO.ofExcept request.restorePrepared
+    mark "restore-request:end"
+    let initial ← Worker.openSearchEnvironment request mark
+    let (environment,readers) ← match request.prepared,initial.snapshots with
+      | some inputs,some originals => do
+        mark "frame-capture:start"
+        let frame ← PreparedReaders.Frame.capture (originals.filterMap id).toArray inputs request.owners
+        mark "frame-capture:end"
+        mark "reader-borrow:start"
+        let session ← pool.readers.borrow frame request.deadline cancelled
+        mark "reader-borrow:end"
+        pure (← IO.ofExcept (initial.withSources session.sources),some session.pool)
+      | _,_ => pure (initial,none)
+    finalReaders.set readers
+    mark "execute:start"
+    let result ← Worker.executeUsing request (fun phase signal => searchPhase phase environment readers signal) ready
+    mark "execute:end"
+    return result
@@ -238,2 +257,11 @@ def Pool.searchActor (pool : Pool) (request : Worker.Search) (cancelled : IO.Ref
-    if let some readers := readers then
-      Receipt.observe request.receipt "request-pages" (← readers.pages.stats)
+    let finalReaders ← finalReaders.get
+    let stats ← match finalReaders with
+      | some readers => readers.pages.stats
+      | none => pure Json.null
+    if finalReaders.isSome || times.isSome then
+      let stats ← match times with
+        | none => pure stats
+        | some times => do
+          mark "actor-finalized"
+          pure ((if stats == Json.null then Json.mkObj [] else stats).setObjVal! "queryStages" (toJson (← times.get)))
+      Receipt.observe request.receipt "request-pages" stats

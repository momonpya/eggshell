 open Lean
 
+/-- Only the built-in provider accepts this private-cache namespace. The
+selected write DB supplies it; the order of readable sources never does. -/
+def projectCommand (command : List String) (database : Option System.FilePath) : List String :=
+  match command with
+  | executable :: "search-provider" :: arguments =>
+      executable :: "search-provider" :: (arguments ++ match database with
+        | some path => ["--query-db", path.normalize.toString]
+        | none => ["--query-transient"])
+  | _ => command
+
+theorem project_command_uses_selected_database (executable : String) (arguments : List String)
+    (database : System.FilePath) :
+    projectCommand (executable :: "search-provider" :: arguments) (some database) =
+      executable :: "search-provider" :: (arguments ++ ["--query-db", database.normalize.toString]) := rfl
+
+theorem project_command_without_writer_is_transient (executable : String) (arguments : List String) :
+    projectCommand (executable :: "search-provider" :: arguments) none =
+      executable :: "search-provider" :: (arguments ++ ["--query-transient"]) := rfl
+
 structure Item where
   id : String
   text : String

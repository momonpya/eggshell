+/-- Text alignment and generated whole-Work identity are different evidence.
+An identity carries its actual generators, not invented lexical Coverage.
+Extraction checks it again against the current generated quotient. -/
+inductive WorkEvidence (demand : Value) (owner : OutcomeEdge) where
+  | aligned (value : WorkAlignment)
+  | identified (generators : List UnionEdge)
+      (generated : Equivalent generators demand owner.work) (subwork : Bool)
+
+namespace WorkEvidence
+
+instance : Coe WorkAlignment (WorkEvidence demand owner) := ⟨.aligned⟩
+
+def alignment? : WorkEvidence demand owner → Option WorkAlignment
+  | .aligned value => some value
+  | .identified .. => none
+
+def isIdentity : WorkEvidence demand owner → Bool
+  | .aligned _ => false
+  | .identified .. => true
+
+def subwork : WorkEvidence demand owner → Bool
+  | .aligned value => value.subwork
+  | .identified _ _ child => child
+
+def wholeWorkIdentity : WorkEvidence demand owner → Bool
+  | .aligned value => value.wholeWorkIdentity
+  | .identified .. => true
+
+def fragmentIdentity : WorkEvidence demand owner → Bool
+  | .aligned value => value.fragmentIdentity
+  | .identified .. => true
+
+def pastWholeWork : WorkEvidence demand owner → Bool
+  | .aligned value => value.pastWholeWork
+  | .identified .. => true
+
+def currentFragment : WorkEvidence demand owner → Value
+  | .aligned value => value.currentFragment
+  | .identified .. => demand
+
+def pastFragment : WorkEvidence demand owner → Value
+  | .aligned value => value.pastFragment
+  | .identified .. => owner.work
+
+def priorCoverage (work : WorkEvidence demand owner) : Option Coverage :=
+  work.alignment?.map (·.priorInDemand)
+
+def demandCoverage (work : WorkEvidence demand owner) : Option Coverage :=
+  work.alignment?.map (·.demandInPrior)
+
+def priorComplete (work : WorkEvidence demand owner) : Bool :=
+  work.priorCoverage.any (·.complete)
+
+def demandComplete (work : WorkEvidence demand owner) : Bool :=
+  work.demandCoverage.any (·.complete)
 
+def priorAnchors (work : WorkEvidence demand owner) : Nat :=
+  (work.priorCoverage.map (·.distinctiveAnchors)).getD 0
+
+def demandAnchors (work : WorkEvidence demand owner) : Nat :=
+  (work.demandCoverage.map (·.distinctiveAnchors)).getD 0
+
+def completionBasis (work : WorkEvidence demand owner) (grounded : Bool) : Prop :=
+  match work with
+  | .aligned value =>
+      (value.pastWholeWork = true ∧ value.priorInDemand.complete = true) ∨
+      (grounded = true ∧
+        (value.priorInDemand.complete = true ∨ value.demandInPrior.complete = true))
+  | .identified generators _ _ => Equivalent generators demand owner.work
+
+end WorkEvidence

+theorem file_ready_stored (file : File) : (fileReady file).stored = fileStored file := rfl
+
+/-- Every checked result of the former canonical publication is this same
+value, including the proof fields. This is not a hash-only approximation. -/
+theorem file_ready_unique (file : File) (ready : FileReady)
+    (published : ready.stored = fileStored file) : ready = fileReady file := by
+  cases ready
+  cases published
+  rfl
+
+theorem file_ready_scopes (file : File) (extents : Array Extent) :
+    ((fileReady file).addExtents extents).stored.extents =
+      (hashDistinct extents.toList).toArray := by
+  simp [FileReady.addExtents,fileReady,fileStored]
+
+theorem scoped_file_valid (descriptor : OwnerPalette.Descriptor) (database owner : String)
+    (file : File) (validScope : descriptor.inScope database owner = true)
+    (present : file ∈ descriptor.files) : file.valid = true := by
+  simp only [OwnerPalette.Descriptor.inScope,Bool.and_eq_true] at validScope
+  exact Array.all_eq_true_iff_forall_mem.mp validScope.1.1.1.1 file present

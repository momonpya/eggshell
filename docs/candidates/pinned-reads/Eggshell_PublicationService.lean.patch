+def batchPinRequests (entries : Array (ReadBoundary.Entry sources)) : List CanonicalSource.Leases.PinnedReads.Request :=
+  entries.toList.filterMap fun entry => entry.request.retained.map fun token =>
+    ⟨token,entry.request.access.scope,entry.request.access.source,entry.request.access.metadata⟩
+
+def withPinnedSource (server : Server) (pins : List CanonicalSource.Leases.PinnedReads.Pin)
+    (entry : ReadBoundary.Entry sources) (deadline : Nat)
+    (use : CanonicalSource.Shared.Loaded → CanonicalSource.Shared.Reuse → IO α) : IO α := do
+  if let some token := entry.request.retained then
+    let request : CanonicalSource.Leases.PinnedReads.Request :=
+      ⟨token,entry.request.access.scope,entry.request.access.source,entry.request.access.metadata⟩
+    let checked ← IO.ofExcept (CanonicalSource.Leases.PinnedReads.resolve pins request (← IO.monoMsNow))
+    return ← use checked.loaded .hit
+  withBatchSource server entry deadline use

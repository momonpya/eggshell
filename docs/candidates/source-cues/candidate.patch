+module
+
+public import Eggshell.SearchRank
+
+@[expose] public section
+namespace Eggshell.LexicalEvidence
+
+/-- Match the existing query terms against already hydrated original windows.
+All positive positions are retained; this reads no additional owner. -/
+def positions (wanted : List String) (windows : List String) : List Nat :=
+  (List.range windows.length).filter fun position =>
+    windows[position]?.any fun text => wanted.any ((SearchRank.terms text).contains)
+
+theorem positions_exact (wanted : List String) (windows : List String)
+    (position : Nat) : position ∈ positions wanted windows ↔
+      position < windows.length ∧
+        windows[position]?.any (fun text => wanted.any ((SearchRank.terms text).contains)) = true := by
+  simp [positions]
+
+end Eggshell.LexicalEvidence

+/-- Lexical nomination supplies owners, not vector positions. Match the
+question's existing lexical terms against the already hydrated original
+windows once; otherwise a contextual native observation receives no cue at
+all while a whole answer keeps its nomination value. No new owner is read. -/
+def lexicalSourceEvidence (question : String) (owners : List OutcomeEdge) : List (Value × List Nat) :=
+  let wanted := SearchRank.terms question
+  owners.map fun owner =>
+    (owner.relation,LexicalEvidence.positions wanted (evidenceSearchWindows owner))
 

+module
+public import Eggshell.ObservedRecords
+public import tools.ContentCorrespondence
+@[expose] public section
+
+namespace Eggshell.ContentCapture
+open Lean Synapses Synapses.Extraction
+open ContentCorrespondence
+
+/-- Literal coordinates supplement the original record. They are not an
+execution certificate, a closed dependency set, or a reason to union Work. -/
+structure Alias where
+  file : Synapses.File
+  line : Nat
+  spelling : Synapses.ObservedRecords.Spelling
+  chars : Nat
+  first : Nat
+  limit : Nat
+  deriving Repr, BEq, ToJson, FromJson
+
+structure Captured where
+  implementation : String
+  /-- Export only files referenced by accepted matches. Unmatched argument
+  files and failed scans remain in the private pre-call capture. -/
+  inputs : Array SourceEvidence.File
+  complete : Bool
+  aliases : Array Alias
+  failure : Option String := none
+  deriving Repr, ToJson, FromJson
+
+def implementation : String := Blake3.hex (Blake3.digest "eggshell.content-capture".toUTF8 [
+  (include_str "ContentCapture.lean").toUTF8,
+  (include_str "ContentMetadata.lean").toUTF8,(include_str "SourceEvidence.lean").toUTF8,
+  (include_str "FileSystem.lean").toUTF8,
+  (include_str "../tools/ContentCorrespondence.lean").toUTF8,
+  Synapses.ObservedRecords.implementation.toUTF8])
+
+structure Output where
+  spelling : Synapses.ObservedRecords.Spelling
+  text : String
+
+/-- Index actual data projections, never a command or provider name. Base
+partitions remain in ObservedRecords even if no file correspondence exists. -/
+def outputs (raw : String) : Array Output := Id.run do
+  let characters := raw.toList.toArray
+  let mut result := #[]
+  let mut seen : Std.HashSet (Nat × Nat × Synapses.ObservedRecords.Projection) := {}
+  for record in Synapses.ObservedRecords.normalize raw do
+    for spelling in record.spellings do
+      unless [Synapses.ObservedRecords.Projection.rawLine,.stringBodyLine,.string].contains spelling.projection do continue
+      let key := (spelling.first,spelling.limit,spelling.projection)
+      if seen.contains key then continue
+      seen := seen.insert key
+      let some text := Synapses.ObservedRecords.project characters spelling | continue
+      unless !text.isEmpty && !text.contains '\n' do continue
+      result := result.push ⟨spelling,text⟩
+  return result
+
+structure Trie where
+  outputs : Array Output
+  characters : Array (Array Char)
+  edges : Std.HashMap (Nat × Char) Nat := {}
+  -- Each node is a suffix of one immutable output projection. No input
+  -- text or unbounded posting list is retained during the file scan.
+  nodes : Array (Nat × Nat) := #[(0,0)]
+
+def Trie.prepare (rows : Array Output) : Trie := Id.run do
+  let mut trie : Trie := {outputs := rows,characters := rows.map (fun row => row.text.toList.toArray)}
+  for row in [:rows.size] do
+    let some output := rows[row]? | continue
+    let mut node := 0
+    let mut depth := 0
+    for char in output.text.toList.reverse do
+      depth := depth+1
+      match trie.edges[(node,char)]? with
+      | some next => node := next
+      | none =>
+        let next := trie.nodes.size
+        trie := {trie with
+          edges := trie.edges.insert (node,char) next
+          nodes := trie.nodes.push (row,depth)}
+        node := next
+  return trie
+
+def suffix (text : String) (chars : Nat) : String :=
+  String.ofList (text.toList.drop (text.length-chars))
+
+def Trie.key? (trie : Trie) (node : Nat) : Option String := do
+  let (row,depth) ← trie.nodes[node]?
+  let characters ← trie.characters[row]?
+  if depth == 0 || characters.size < depth then none else
+    some (String.ofList (characters.extract (characters.size-depth) characters.size).toList)
+
+def Trie.find? (trie : Trie) (text : String) : Option Nat := do
+  if text.isEmpty then none else do
+    let node ← text.toList.reverse.foldlM (fun node char => trie.edges[(node,char)]?) 0
+    if trie.key? node == some text then some node else none
+
+abbrev State := Array Candidate
+
+def Trie.start (trie : Trie) : State := Array.replicate trie.nodes.size .absent
+
+def Trie.observe (trie : Trie) (state : State) (position : Position) (text : String) : State :=
+  match trie.find? text with
+  | none => state
+  | some node => state.modify node (fun previous => previous.join (.one position))
+
+theorem Trie.observe_size (trie : Trie) (state : State) (position : Position) (text : String) :
+    (trie.observe state position text).size = state.size := by
+  simp only [observe]
+  split <;> simp
+
+theorem Trie.find_checked (trie : Trie) (text : String) (node : Nat)
+    (found : trie.find? text = some node) : trie.key? node = some text := by
+  cases vacant : text.isEmpty with
+  | true => simp [find?,vacant] at found
+  | false =>
+    cases traced : text.toList.reverse.foldlM (fun node char => trie.edges[(node,char)]?) 0 with
+    | none => simp [find?,vacant,traced] at found
+    | some selected =>
+      simp [find?,vacant,traced] at found
+      simpa [found.2] using found.1
+
+def Trie.selected? (trie : Trie) (state : State) (output : Output) : Option (Position × Nat) := Id.run do
+  let mut node := 0
+  let mut depth := 0
+  let characters := output.text.toList.toArray
+  let mut found : Option (Candidate × Nat) := none
+  for char in output.text.toList.reverse do
+    let some next := trie.edges[(node,char)]? | break
+    node := next
+    depth := depth+1
+    let candidate := state[node]?.getD .absent
+    let expected := fun _ => String.ofList (characters.extract (characters.size-depth) characters.size).toList
+    if candidate != .absent && trie.key? node == some (expected ()) then
+      found := some (candidate,depth)
+  match found with
+  | some (.one position,count) => return some (position,count)
+  | _ => return none
+
+def escapedWidth (text : String) : Nat := (toJson text).compress.length-2
+
+def alias? (inputs : Array SourceEvidence.File) (characters : Array Char) (output : Output)
+    (position : Position) (chars : Nat) : Option Alias := do
+  let file ← inputs[position.1]?
+  let content ← file.content
+  if chars == 0 || output.text.length < chars || position.2 == 0 then none else do
+    let code := suffix output.text chars
+    let preceding := String.ofList (output.text.toList.take (output.text.length-chars))
+    let encoded := match output.spelling.projection with
+      | .string | .stringBody | .stringBodyLine => true
+      | _ => false
+    let base := output.spelling.first + if output.spelling.projection == .string then 1 else 0
+    let first := base + if encoded then escapedWidth preceding else preceding.length
+    let limit := first + if encoded then escapedWidth code else code.length
+    let literal := String.ofList (characters.extract first limit).toList
+    let expected := if encoded then String.ofList ((toJson code).compress.toList.drop 1 |>.dropLast) else code
+    if first < limit && limit ≤ output.spelling.limit && literal == expected then
+      some ⟨⟨file.relative,content.root,content.bytes⟩,position.2,output.spelling,chars,first,limit⟩
+    else none
+
+/-- JSON leaves and a general literal lexer supply path hints. The executable
+name is not a discriminator. Only regular files inside the workspace survive;
+these hints never establish complete execution dependencies. -/
+partial def inputStrings : Json → Array String
+  | .str value => #[value]
+  | .arr values => values.flatMap inputStrings
+  | .obj values => values.toArray.flatMap (inputStrings ∘ Prod.snd)
+  | _ => #[]
+
+def candidates (workspace : System.FilePath) (input : Json) : Array SourceEvidence.Relative := Id.run do
+  let some directory := SourceEvidence.inputDirectory? workspace input | return #[]
+  let mut result := #[]
+  let mut seen : Std.HashSet String := {}
+  for value in inputStrings input do
+    for word in #[value] ++ ((shellWords value).toOption.getD #[]) do
+      if word.contains "://" then continue
+      let some relative := SourceEvidence.relative? workspace directory word | continue
+      if seen.contains relative.text then continue
+      seen := seen.insert relative.text
+      result := result.push relative
+  return result
+
+def captureInputs (workspace : System.FilePath) (input : Json)
+    (known : Option SourceEvidence.Capture) (deadline : Nat) : IO SourceEvidence.Capture := do
+  let mut probes := []
+  for relative in candidates workspace input do
+    if (← IO.monoMsNow) ≥ deadline then return SourceEvidence.unknown workspace
+    let path := workspace / relative.text
+    try
+      FileSystem.rejectSymlinkAncestors path
+      if (← FileSystem.regularMetadata? path).isNone then continue
+      unless probes.length < 256 do return SourceEvidence.unknown workspace
+      let previous := known.bind fun captured => captured.probes.find? (·.file.relative == relative.text)
+      let some observed ← match previous with
+          | some probe => pure (some probe)
+          | none => SourceEvidence.probe workspace relative deadline
+        | return SourceEvidence.unknown workspace
+      probes := probes ++ [observed]
+    catch _ => return SourceEvidence.unknown workspace
+  let record : SourceEvidence.Record := ⟨workspace.fileName.getD workspace.toString,
+    probes.map (·.file),[],true,false⟩
+  return ⟨record,probes⟩
+
+/-- The same held descriptor supplies fingerprint pages and line records.
+Uniqueness is accepted only after every named input reaches stable EOF with
+its pre-call content fingerprint. Long irrelevant lines allocate no buffer. -/
+def scan (workspace : System.FilePath) (file : SourceEvidence.File) (fileIndex : Nat)
+    (trie : Trie) (initial : State) (deadline : Nat) : IO (Option State) := do
+  let some expected := file.content | return none
+  let some relative := SourceEvidence.Relative.check? file.relative | return none
+  let path := workspace / relative.text
+  FileSystem.rejectSymlinkAncestors path
+  let handle ← FileSystem.openRead path.toString
+  let before ← FileSystem.readVersion handle
+  unless before.bytes == expected.bytes do return none
+  let maxLine := trie.outputs.foldl (fun size row => max size row.text.utf8ByteSize) 0
+  let mut root : SourceEvidence.Root :=
+    ⟨Blake3.digest "eggshell.source.file".toUTF8 [Blake3.u64le before.bytes],Blake3.hashSegments_size _⟩
+  let mut offset := 0
+  let mut line := 1
+  let mut pending := ByteArray.empty
+  let mut omitted := false
+  let mut state := initial
+  while offset < before.bytes do
+    if (← IO.monoMsNow) ≥ deadline then return none
+    let count := min 4096 (before.bytes-offset)
+    let page ← FileSystem.readPage handle offset.toUInt64 ⟨count,Nat.min_le_left _ _⟩
+    unless page.size == count do return none
+    root := SourceEvidence.stepRoot root page
+    offset := offset+count
+    for byte in page do
+      if byte == 10 then
+        if !omitted then
+          if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text
+        pending := ByteArray.empty
+        omitted := false
+        line := line+1
+      else if !omitted then
+        if pending.size < maxLine then pending := pending.push byte
+        else pending := ByteArray.empty; omitted := true
+  if !pending.isEmpty && !omitted then
+    if let some text := String.fromUTF8? pending then state := trie.observe state (fileIndex,line) text
+  let after ← FileSystem.readVersion handle
+  let current ← FileSystem.readVersion (← FileSystem.openRead path.toString)
+  unless (← IO.monoMsNow) < deadline && FileSystem.stableRead before after current offset &&
+      Blake3.hex root.val == expected.root do return none
+  return some state
+
+def finish (workspace : System.FilePath) (captured : SourceEvidence.Capture)
+    (raw : String) (deadline : Nat) : IO Captured := do
+  let inputs := captured.record.files.toArray
+  let failed := fun reason => ({implementation,inputs := #[],complete := false,aliases := #[],failure := some reason} : Captured)
+  unless captured.record.valid && captured.record.files == captured.probes.map (·.file) do
+    return failed "input-not-captured"
+  unless raw.utf8ByteSize ≤ 2*1024*1024 do return failed "output-budget"
+  let rows := outputs raw
+  let trie := Trie.prepare rows
+  let characters := raw.toList.toArray
+  let mut state := trie.start
+  for fileIndex in [:inputs.size] do
+    let some file := inputs[fileIndex]? | return failed "input-domain"
+    let result ← try scan workspace file fileIndex trie state deadline catch _ => pure none
+    let some next := result | return failed "input-not-sealed"
+    state := next
+  let aliases := rows.filterMap fun row => do
+    let (position,chars) ← trie.selected? state row
+    alias? inputs characters row position chars
+  let referenced := inputs.filter fun input => aliases.any fun alias =>
+    input.relative == alias.file.relative && input.content == some ⟨alias.file.bytes,alias.file.fingerprint⟩
+  return ⟨implementation,referenced,true,aliases,none⟩
+
+def code? (characters : Array Char) (alias : Alias) : Option String := do
+  let text ← Synapses.ObservedRecords.project characters alias.spelling
+  if alias.chars == 0 || alias.chars > text.length then none else do
+    let code := suffix text alias.chars
+    let reconstructed ← alias? #[⟨alias.file.relative,some ⟨alias.file.bytes,alias.file.fingerprint⟩⟩]
+      characters ⟨alias.spelling,text⟩ (0,alias.line) alias.chars
+    if reconstructed == alias then some code else none
+
+end Eggshell.ContentCapture

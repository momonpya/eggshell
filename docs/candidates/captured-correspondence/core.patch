+structure SharedCode (original : String) where
+  text : String
+  exact : text = original ∨
+    String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original
+
+def sharedCodes (original : String) : Array (SharedCode original) := Id.run do
+  let mut result := #[⟨original,Or.inl rfl⟩]
+  if let some text := (Json.parse ("\"" ++ original ++ "\"") >>= Json.getStr?).toOption then
+    if same : String.ofList ((toJson text).compress.toList.drop 1 |>.dropLast) = original then
+      if text != original then result := result.push ⟨text,Or.inr same⟩
+  return result
+

+def sealRecordedRead (pending : PendingTurn) (tool : ToolEvent) : IO ToolEvent := do
+  let tool ← sealRecordedSource pending tool
+  if tool.correspondence.isSome then return tool
+  let previous := pending.inFlight.find? fun previous =>
+    previous.useId == tool.useId && previous.name == tool.name &&
+      canonicalJson previous.input == canonicalJson tool.input
+  let captured ← match previous.bind (·.contentInputs) with
+    | none => pure ({
+        implementation := ContentCapture.implementation
+        inputs := #[]
+        complete := false
+        aliases := #[]
+        failure := some "input-not-captured"} : ContentCapture.Captured)
+    | some inputs => do
+        let deadline := (← IO.monoMsNow)+250
+        ContentCapture.finish (System.FilePath.mk pending.cwd) inputs (canonicalJson tool.response) deadline
+  return {tool with contentInputs := none,correspondence := some captured}

+    Option (DirectPlan ceiling cost mandatory) := Id.run do
+  let families := families.map fun family => Family.contextualOutputs
+    {family with cached := #[],template := {family.template with shared := none}}
+  let templates := families.toArray.map fun family =>
+    match family.template.context with
+    | none => family.template
+    | some context =>
+      let context := {context with fragments := [],cues := []}
+      {family.template with context := some context,keys := context.keys,text := context.render}
+  let shells := templates.toList.map fun slice => match slice.context with

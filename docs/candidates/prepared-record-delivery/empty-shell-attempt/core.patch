+module
+public import Eggshell.ObservedRecords
+@[expose] public section
+
+namespace Eggshell.Synapses.ObservedRecordView
+open Lean DB _root_.Eggshell.Synapses.Extraction
+
+/-- Query-free structure from the original observation catalogue. File aliases
+and command syntax are not prerequisites for retaining any original byte. -/
+structure Span where
+  first : Nat
+  limit : Nat
+  decoded : Bool
+  deriving BEq, Hashable
+
+instance : ToJson Span where
+  toJson span := toJson (span.first,span.limit,span.decoded)
+instance : FromJson Span where
+  fromJson? value := do
+    let (first,limit,decoded) ← fromJson? (α := Nat × Nat × Bool) value
+    return ⟨first,limit,decoded⟩
+
+structure Header where
+  database : String
+  owner : String
+  work : String
+  original : Original
+  occurrences : Array Occurrence
+  characters : Nat
+  blocks : Nat
+  deriving BEq, ToJson, FromJson
+
+structure View where
+  header : Header
+  spans : Array Span
+  blocks : Array String
+  deriving ToJson, FromJson
+
+structure Block where
+  text : String
+  spans : Array Span
+  deriving ToJson, FromJson
+
+def ownerKey (owner : String) := "observed-view:owner:" ++ owner
+def blockKey (digest : String) := "observed-view:block:" ++ digest
+def blockRef (owner : String) (index : Nat) := "observed-view:ref:" ++ owner ++ ":" ++ toString index
+def blockChars := ObservedRecords.chunkChars
+
+def make (database : String) (document : Document) : Except String View := do
+  unless document.native && !document.occurrences.isEmpty do throw "missing original observation authority"
+  let some raw := document.source | throw "missing original observation body"
+  let prepared ← ObservedRecords.prepare raw
+  let characters := raw.toList.toArray
+  let spans := prepared.records.filterMap fun record =>
+    if record.spellings.isEmpty || record.limit-record.first > blockChars then none else
+    some (⟨record.first,record.limit,
+      record.spellings.any fun spelling => spelling.first == record.first &&
+        spelling.limit == record.limit &&
+        (spelling.projection == .stringBody || spelling.projection == .stringBodyLine)⟩ : Span)
+  let blocks := (ObservedRecords.base characters.size).map fun record =>
+    String.ofList (characters.extract record.first record.limit).toList
+  return ⟨⟨database,document.owner,document.work,ObservationContext.originalSubject document.work raw,
+    document.occurrences,characters.size,blocks.size⟩,spans,blocks⟩
+
+/-- The payload is copied exactly once into bounded content-addressed blocks.
+The source publication, original digest and observation identities stay in
+the directory, independently of payload sharing. -/
+def stage (writer : PageMap.Writer) (database : String) (document : Document) : IO Unit := do
+  let view ← IO.ofExcept (make database document)
+  for index in [:view.blocks.size] do
+    let block : Block := ⟨view.blocks[index]!,view.spans.filter fun span =>
+      span.first < (index+1)*blockChars && index*blockChars < span.limit⟩
+    let bytes := (toJson block).compress.toUTF8
+    unless bytes.size ≤ 60000 do throw (IO.userError "original view block exceeds page bound")
+    let digest := Sha256.hex bytes
+    if let some previous ← writer.get (blockKey digest) then
+      unless previous == bytes do throw (IO.userError "conflicting original view block")
+    else writer.put (blockKey digest) (some bytes)
+    writer.put (blockRef document.owner index) (some digest.toUTF8)
+  let bytes := (toJson view.header).compress.toUTF8
+  unless bytes.size ≤ 16384 do throw (IO.userError "original view directory exceeds its byte bound")
+  writer.put (ownerKey document.owner) (some bytes)
+
+def load? (index : PageMap.Snapshot) (database owner : String) : IO (Option View) := do
+  let some bytes ← index.get (ownerKey owner) | return none
+  unless bytes.size ≤ 16384 do throw (IO.userError "oversized original view directory")
+  let header ← ObservedRecords.decode (α := Header) bytes
+  unless header.database == database && header.owner == owner &&
+      header.occurrences.all Occurrence.valid && !header.occurrences.isEmpty &&
+      header.blocks == (header.characters+blockChars-1)/blockChars do
+    throw (IO.userError "foreign or invalid original view directory")
+  let mut blocks := #[]
+  let mut spans := #[]
+  for position in [:header.blocks] do
+    let some pointer ← index.get (blockRef owner position) | throw (IO.userError "missing original block pointer")
+    let some digest := String.fromUTF8? pointer | throw (IO.userError "invalid original block pointer")
+    let some bytes ← index.get (blockKey digest) | throw (IO.userError "missing original view block")
+    unless bytes.size ≤ 60000 && Sha256.hex bytes == digest do
+      throw (IO.userError "invalid original view block digest")
+    let block ← ObservedRecords.decode (α := Block) bytes
+    let text := block.text
+    unless text.length == min blockChars (header.characters-position*blockChars) do
+      throw (IO.userError "invalid original view character extent")
+    unless block.spans.all (fun span => span.first < span.limit && span.limit ≤ header.characters &&
+        span.limit-span.first ≤ blockChars && span.first < (position+1)*blockChars && position*blockChars < span.limit) do
+      throw (IO.userError "invalid original view record interval")
+    spans := spans ++ block.spans
+    blocks := blocks.push text
+  return some ⟨header,(hashDistinct spans.toList).toArray,blocks⟩
+
+/-- A point extraction reads only intersecting blocks; it never walks the
+prefix of the owner's body or repeats JSON parsing/record normalization. -/
+def View.slice (view : View) (first limit : Nat) : Option String := do
+  unless first < limit && limit ≤ view.header.characters do none
+  let start := first/blockChars
+  let stop := (limit-1)/blockChars+1
+  let mut parts := []
+  for index in [start:stop] do
+    let block ← view.blocks[index]?
+    let a := first-index*blockChars
+    let b := min blockChars (limit-index*blockChars)
+    parts := String.ofList (block.toList.drop a |>.take (b-a)) :: parts
+  return "".intercalate parts.reverse
+
+structure Piece where
+  span : Span
+  original : String
+  deriving BEq, ToJson, FromJson
+
+/-- Only intersecting prepared records are offered. The base partition is
+always available for bytes outside a structural record; no input shape can
+make an original region disappear. The caller retains query priorities. -/
+def View.pieces (view : View) (first limit : Nat) : Array Piece := Id.run do
+  if first ≥ limit || limit > view.header.characters then return #[]
+  let spans := (view.spans.filter fun span => span.first < limit && first < span.limit).qsort fun a b => a.first < b.first
+  let mut cursor := first
+  let mut all := spans
+  for span in spans do
+    if cursor < span.first then
+      for record in ObservedRecords.base view.header.characters do
+        let a := max cursor record.first
+        let b := min span.first record.limit
+        if a < b then all := all.push ⟨a,b,false⟩
+    cursor := max cursor span.limit
+  if cursor < limit then
+    for record in ObservedRecords.base view.header.characters do
+      let a := max cursor record.first
+      let b := min limit record.limit
+      if a < b then all := all.push ⟨a,b,false⟩
+  return all.filterMap fun span => (view.slice span.first span.limit).map (Piece.mk span)
+
+/-- A delivered piece is tied to the exact stored range. This constructor
+does not return any control Match, Union or completion certificate. -/
+structure CheckedPiece (view : View) where
+  piece : Piece
+  exact : view.slice piece.span.first piece.span.limit = some piece.original
+
+def Piece.check? (view : View) (piece : Piece) : Option (CheckedPiece view) :=
+  if exact : view.slice piece.span.first piece.span.limit = some piece.original then some ⟨piece,exact⟩ else none
+
+theorem checked_piece_exact (view : View) (piece : CheckedPiece view) :
+    view.slice piece.piece.span.first piece.piece.span.limit = some piece.piece.original := piece.exact
+
+end Eggshell.Synapses.ObservedRecordView

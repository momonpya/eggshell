+def sourceRecords (reference : SourceReference) (owners : Array String) (deadline : Nat) :
+    IO (Array (String × Option Synapses.ObservedRecordView.View)) := do
+  let access := reference.access
+  let owners := (hashDistinct owners.toList).toArray
+  let budget ← liveBudget deadline
+  let response ← Daemon.exchange reference.endpoint "source-records" (Json.mkObj [
+    ("database",toJson access.database),("scope",toJson access.scope),("source",toJson access.source),
+    ("metadata",toJson access.metadata),("owners",toJson owners),("budgetMs",toJson budget)]) (budget := budget)
+  let (head,rows) ← IO.ofExcept (Json.parse response >>=
+    fromJson? (α := PageMap.Head × Array (String × Option Synapses.ObservedRecordView.View)))
+  unless head == access.source && rows.map Prod.fst == owners do
+    throw (IO.userError "original record projection changed its requested source or owner domain")
+  for (owner,found) in rows do
+    if let some view := found then
+      unless view.header.database == access.database && view.header.owner == owner do
+        throw (IO.userError "original record view crossed its read scope")
+  return rows
+

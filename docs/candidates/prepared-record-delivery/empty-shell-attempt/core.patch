+/-- The identical authenticated read scope serves generic original output.
+The prepared index snapshot is shared; no query repairs or normalizes it. -/
+def sourceRecords (server : Server) (secret : String) (payload : Json) (deadline : Nat) : IO Json := do
+  let scope ← scopedSource server secret payload
+  let head ← IO.ofExcept (payload.getObjVal? "source" >>= fromJson? (α := PageMap.Head))
+  let metadata ← IO.ofExcept (payload.getObjVal? "metadata" >>= fromJson? (α := CanonicalSource.Cache.Manifest))
+  let owners ← IO.ofExcept (payload.getObjValAs? (Array String) "owners")
+  unless owners.size ≤ 4096 && owners.all (fun owner => owner.utf8ByteSize ≤ 256) &&
+      head.identity == scope.database && metadata.source.identity == scope.database &&
+      metadata.implementation == CanonicalSource.Cache.implementation && digest metadata.payload do
+    throw (IO.userError "invalid original record projection request")
+  let current ← PageMap.pin scope.directory
+  let some pinned ← PageMap.HistoryReader.make? current head |
+    throw (IO.userError "original source snapshot retired")
+  let path ← CanonicalSource.Cache.directory pinned.snapshot scope.storage
+  server.prepared.withReady pinned.snapshot path metadata deadline fun loaded _ => do
+    let some original := loaded.originals | throw (IO.userError "original record view is not prepared")
+    let mut rows : Array (String × Option ObservedRecordView.View) := #[]
+    let mut size := 0
+    for owner in owners do
+      unless (← IO.monoMsNow) < deadline do throw (IO.userError "original record projection expired")
+      let found ← ObservedRecordView.load? original.index scope.database owner
+      let value := toJson (owner,found)
+      size := size+value.compress.utf8ByteSize
+      unless size ≤ (Daemon.maxFrameBytes-4096)/2 do throw (IO.userError "original record projection exceeds wire bound")
+      rows := rows.push (owner,found)
+    return toJson (head,rows)
+

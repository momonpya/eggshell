+fallback when the shared directory is absent or not readable. -/
+def readablePrepared? (read : Sidecar.Storage → IO (Option α)) : IO (Option α) := do
+  for storage in [.database,.user] do
+    let found ← try read storage catch error => match error with
+      | .permissionDenied _ _ _ => pure none
+      | _ => throw error
+    if found.isSome then return found
+  return none

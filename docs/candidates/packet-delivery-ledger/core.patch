+
+/-- The ledger is bound to the reconciled packet actually returned to the
+hook. An earlier selection or a modified envelope cannot label delivery. -/
+structure CapturedPacket (handoff : Handoff) where
+  packet : DeliveryPacket
+  saved : handoff.packet = some packet
+  exact : packet.render = (handoff.text.take (handoff.text.length-handoff.controlDeltaChars)).copy
+
+def Handoff.capturedPacket? (handoff : Handoff) : Option (CapturedPacket handoff) :=
+  match saved : handoff.packet with
+  | none => none
+  | some packet =>
+    if exact : packet.render = (handoff.text.take (handoff.text.length-handoff.controlDeltaChars)).copy then
+      some ⟨packet,saved,exact⟩ else none
+
+theorem CapturedPacket.exact_returned_body {handoff : Handoff} (captured : CapturedPacket handoff) :
+    captured.packet.render = (handoff.text.take (handoff.text.length-handoff.controlDeltaChars)).copy := captured.exact
+
+/-- Query-time diagnostics follow selected native pieces. They do not
+reparse the body, solve again, or scan every unselected recommendation. -/
+def Handoff.deliveryReceipt (handoff : Handoff) (plan : Synapses.Transport.Plan) : Json := Id.run do
+  let captured := handoff.capturedPacket?
+  let owners := (captured.map (fun captured => captured.packet.parts.flatMap (·.owners))).getD []
+    |>.foldl (fun found owner => found.insert owner) ({} : Std.HashSet String)
+  let native := Synapses.PacketReceipt.prepare (plan.documents.filter (fun doc => owners.contains doc.owner))
+  let canonical := plan.canonical.toArray.flatMap fun (owner,rows) =>
+    if owners.contains owner then rows else #[]
+  let savedReads := plan.rows ++ Synapses.PacketReceipt.canonicalReads canonical
+  let reads := KeyPostings.prepare (fun saved : {read : Synapses.Read // read ∈ savedReads} =>
+    (saved.val.binding,saved.val.occurrence)) (savedReads.attach.filter fun saved => owners.contains saved.val.binding.owner)
+  let mut originals := #[]
+  let mut shared := #[]
+  let mut unverified := #[]
+  if let some captured := captured then
+    for (part,partIndex) in captured.packet.parts.zipIdx do
+      if let some context := part.context then
+        if part.text != context.render then unverified := unverified.push partIndex; continue
+        let some source := native[context.owner]? | unverified := unverified.push partIndex; continue
+        if context.sourceChars != source.source.indexed.chars.size then
+          unverified := unverified.push partIndex; continue
+        for fragment in context.fragments do
+          let some piece := source.source.piece? fragment.first fragment.original |
+            unverified := unverified.push partIndex; continue
+          originals := originals.push (piece.json.setObjVal! "part" (toJson partIndex)
+            |>.setObjVal! "decoded" (toJson fragment.presentation.2)
+            |>.setObjVal! "declaredPath" (toJson (fragment.path.map JsonScalars.pathJson)))
+      else if let some body := part.shared then
+        if part.text != body.render then unverified := unverified.push partIndex; continue
+        for row in body.rows do
+          for origin in row.origins do
+            let some source := native[origin.binding.owner]? | unverified := unverified.push partIndex; continue
+            let mut checked := false
+            for read in reads.lookup (origin.binding,origin.occurrence) do
+              if let some witness := Synapses.PacketReceipt.shared? source.source row origin read then
+                shared := shared.push (Json.mkObj [("part",toJson partIndex),("source",toJson witness.read.source),
+                  ("binding",toJson origin.binding),("occurrence",toJson origin.occurrence),
+                  ("originalBytesChecked",toJson true)])
+                checked := true
+                break
+            if !checked then unverified := unverified.push partIndex
+      else unverified := unverified.push partIndex
+  return Json.mkObj [
+    ("bodySha256",toJson (Sha256.hex handoff.text.toUTF8)),
+    ("bodyChars",toJson handoff.text.length),("bodyBytes",toJson handoff.text.utf8ByteSize),
+    ("packetVerified",toJson captured.isSome),("complete",toJson plan.complete),
+    ("completed",toJson handoff.completed),("advisory",toJson handoff.advisory),
+    ("localUnions",toJson handoff.localUnions),
+    ("inputs",toJson (plan.results.map fun result => Json.mkObj [
+      ("available",toJson result.available),("complete",toJson result.complete),
+      ("index",toJson result.index),("usage",toJson result.usage),
+      ("routing",toJson result.routing),("usageRouting",toJson result.usageRouting),
+      ("requests",toJson result.nodes),("facts",toJson result.arcs),("bytes",toJson result.bytes),
+      ("failure",toJson result.failure)])),
+    ("bindingRequests",toJson plan.bindingRequests),("bindingBytes",toJson plan.bindingBytes),
+    ("bindingUnresolved",toJson plan.bindingUnresolved),("observationAges",toJson plan.observations),
+    ("originalPieces",toJson originals),("sharedRows",toJson shared),
+    ("unverifiedParts",toJson unverified.toList.eraseDups),
+    ("fullCandidateAudit",toJson false)]

+module
+public import Eggshell.SynapseTransport
+public import tools.IndexedCharacters
+@[expose] public section
+
+namespace Eggshell.Synapses.PacketReceipt
+open Lean _root_.Eggshell.Synapses.Extraction
+
+/-- One character view per native original, independent of output syntax. -/
+structure Source (doc : Document) where
+  raw : String
+  saved : doc.source = some raw
+  native : doc.native = true
+  indexed : IndexedCharacters raw
+
+def Source.prepare? (doc : Document) : Option (Source doc) := do
+  let raw ← doc.source
+  if saved : doc.source = some raw then
+    if native : doc.native = true then some ⟨raw,saved,native,IndexedCharacters.make raw⟩ else none
+  else none
+
+/-- The original spelling is checked at its actual coordinates. Rendering
+may decode JSON escapes; it may never replace the original with a summary. -/
+structure Piece (source : Source doc) where
+  first : Nat
+  original : String
+  nonempty : original.isEmpty = false
+  within : first+original.length ≤ source.indexed.chars.size
+  literal : source.indexed.slice first original.length = original
+
+def Source.piece? (source : Source doc) (first : Nat) (original : String) : Option (Piece source) :=
+  if nonempty : original.isEmpty = false then
+    if within : first+original.length ≤ source.indexed.chars.size then
+      if literal : source.indexed.slice first original.length = original then
+        some ⟨first,original,nonempty,within,literal⟩ else none
+    else none
+  else none
+
+theorem Piece.original_slice {doc : Document} {source : Source doc} (piece : Piece source) :
+    ((source.raw.drop piece.first).take piece.original.length).copy = piece.original := by
+  rw [← IndexedCharacters.slice_exact source.indexed]
+  exact piece.literal
+
+structure Native where
+  document : Document
+  source : Source document
+
+def prepare (docs : Array Document) : Std.HashMap String Native :=
+  docs.foldl (fun found doc => match Source.prepare? doc with
+    | none => found
+    | some source => found.insert doc.owner ⟨doc,source⟩) {}
+
+/-- Authenticated canonical rows are saved observations even when they were
+not nominated by a graph hint. Packet metadata alone never supplies them. -/
+def canonicalReads (rows : Array CanonicalSource.StoredRow) : Array Read :=
+  rows.flatMap fun row => row.origins.map fun origin =>
+    ⟨origin.occurrence,⟨.file row.key.file,row.key.line,row.key.line⟩,origin.binding,#[]⟩
+
+theorem canonical_read_origin (rows : Array CanonicalSource.StoredRow) (read : Read)
+    (present : read ∈ canonicalReads rows) :
+    ∃ row ∈ rows, ∃ origin ∈ row.origins,
+      read.source = ⟨.file row.key.file,row.key.line,row.key.line⟩ ∧
+      read.binding = origin.binding ∧ read.occurrence = origin.occurrence := by
+  simp only [canonicalReads,Array.mem_flatMap,Array.mem_map] at present
+  obtain ⟨row,rowPresent,origin,originPresent,same⟩ := present
+  subst read
+  exact ⟨row,rowPresent,origin,originPresent,rfl,rfl,rfl⟩
+
+def Piece.json {doc : Document} {source : Source doc} (piece : Piece source) : Json :=
+  Json.mkObj [("owner",toJson doc.owner),("work",toJson doc.work),
+    ("first",toJson piece.first),("limit",toJson (piece.first+piece.original.length)),
+    ("occurrences",toJson doc.occurrences),("originalBytesChecked",toJson true)]
+
+/-- Checking one selected shared row must not parse its owner's entire
+output. Both direct code and a saved numbered row are literal projections. -/
+def codeMatches (original : String) (number : Nat) (code : String) : Bool :=
+  (sharedCodes original).any fun spelling =>
+    spelling.text == code || numbered (if spelling.text.endsWith "\n" then
+      (spelling.text.dropEnd 1).copy else spelling.text) == some (number,code)
+
+structure Shared (saved : Array Read) (source : Source doc) (row : CanonicalSource.StoredRow) (origin : CanonicalSource.Origin) where
+  read : Read
+  present : read ∈ saved
+  valid : read.valid = true
+  sourceExact : read.source = ⟨.file row.key.file,row.key.line,row.key.line⟩
+  originBinding : read.binding = origin.binding
+  originOccurrence : read.occurrence = origin.occurrence
+  ownerExact : read.binding.owner = doc.owner
+  workExact : read.binding.work = doc.work
+  nativeOccurrence : doc.occurrences.contains read.occurrence = true
+  dependency : doc.files.contains row.key.file = true
+  within : read.binding.first < read.binding.limit ∧ read.binding.limit ≤ source.indexed.chars.size
+  spelling : codeMatches (source.indexed.slice read.binding.first
+    (read.binding.limit-read.binding.first)) row.key.line row.code = true
+
+def shared? {saved : Array Read} (source : Source doc) (row : CanonicalSource.StoredRow)
+    (origin : CanonicalSource.Origin) (savedRead : {read : Read // read ∈ saved}) : Option (Shared saved source row origin) :=
+  let read := savedRead.val
+  if valid : read.valid = true then
+    if sourceExact : read.source = ⟨.file row.key.file,row.key.line,row.key.line⟩ then
+      if binding : read.binding = origin.binding then
+        if occurrence : read.occurrence = origin.occurrence then
+          if owner : read.binding.owner = doc.owner then
+            if work : read.binding.work = doc.work then
+              if native : doc.occurrences.contains read.occurrence = true then
+                if dependency : doc.files.contains row.key.file = true then
+                  if within : read.binding.first < read.binding.limit ∧ read.binding.limit ≤ source.indexed.chars.size then
+                    if spelling : codeMatches (source.indexed.slice read.binding.first
+                        (read.binding.limit-read.binding.first)) row.key.line row.code = true then
+                      some ⟨read,savedRead.property,valid,sourceExact,binding,occurrence,owner,work,native,dependency,within,spelling⟩
+                    else none
+                  else none
+                else none
+              else none
+            else none
+          else none
+        else none
+      else none
+    else none
+  else none
+
+theorem Shared.same_native_origin {saved : Array Read} {doc : Document} {source : Source doc}
+    {row : CanonicalSource.StoredRow} {origin : CanonicalSource.Origin}
+    (witness : Shared saved source row origin) :
+    witness.read.binding = origin.binding ∧ witness.read.occurrence = origin.occurrence ∧
+      doc.occurrences.contains witness.read.occurrence = true :=
+  ⟨witness.originBinding,witness.originOccurrence,witness.nativeOccurrence⟩
+
+theorem Shared.original_saved_read {saved : Array Read} {doc : Document} {source : Source doc}
+    {row : CanonicalSource.StoredRow} {origin : CanonicalSource.Origin}
+    (witness : Shared saved source row origin) : witness.read ∈ saved := witness.present
+
+end Eggshell.Synapses.PacketReceipt

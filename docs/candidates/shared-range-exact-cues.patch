+module
+public import Std
+@[expose] public section
+namespace SourceWindow
+
+/-- Scalar coordinates of the actual source intersection of one search window.
+Context expansion belongs to the renderer and is not represented here. -/
+structure Slice (sourceLength : Nat) where
+  first : Nat
+  last : Nat
+  ordered : first < last
+  within : last ≤ sourceLength
+  bounded : last-first ≤ 512
+
+def project (sourceLength prefixChars index : Nat) : Option (Slice sourceLength) :=
+  let first := index*384-prefixChars
+  let last := min sourceLength (index*384+512-prefixChars)
+  if ordered : first < last then
+    some ⟨first,last,ordered,Nat.min_le_left _ _,by
+      have upper := Nat.min_le_right sourceLength (index*384+512-prefixChars)
+      omega⟩
+  else none
+
+/-- A source character is scored exactly when its global coordinate occurs
+in the producer's original window. A window center has no role in this test. -/
+theorem projected_covers_iff (sourceLength prefixChars index position : Nat) :
+    (∃ span, project sourceLength prefixChars index = some span ∧
+      span.first ≤ position ∧ position < span.last) ↔
+    position < sourceLength ∧ index*384 ≤ prefixChars+position ∧
+      prefixChars+position < index*384+512 := by
+  unfold project
+  dsimp only
+  split
+  · simp only [Option.some.injEq]
+    constructor
+    · rintro ⟨span,equal,first,last⟩
+      cases equal
+      dsimp only at first last
+      omega
+    · intro covered
+      refine ⟨_,rfl,?_,?_⟩ <;> (dsimp only; omega)
+  · constructor
+    · rintro ⟨span,equal,_⟩
+      cases equal
+    · intro covered
+      exfalso
+      omega
+
+end SourceWindow

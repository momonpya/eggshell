+/-- A valid empty worker reply adds no memory or completion authority. Retain
+the observed search status even when its fallback has no new body to publish. -/
+def emptySearchResult (trace : SearchTrace) : Handoff := {
+  text := "", reason := "no-new-memory"
+  deliveredGraphs := [], completed := 0, advisory := 0, localUnions := 0
+  coveredFragments := [], blocksCurrent := false, search := some trace }
+
+theorem empty_search_has_no_authority (trace : SearchTrace) :
+    (emptySearchResult trace).text = "" ∧
+    (emptySearchResult trace).deliveredGraphs = [] ∧
+    (emptySearchResult trace).completed = 0 ∧
+    (emptySearchResult trace).localUnions = 0 ∧
+    (emptySearchResult trace).coveredFragments = [] ∧
+    (emptySearchResult trace).blocksCurrent = false := by
+  exact ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩
+
+theorem empty_search_preserves_status (trace : SearchTrace) :
+    (emptySearchResult trace).search = some trace := rfl
+
 /-- Constant metadata per DB, never a scan or embedding job in the hook.
 The registry retains unavailable indexes. Actual numerical cache observations
 persist typed private repair debt; a deadline never invalidates a checkpoint. -/

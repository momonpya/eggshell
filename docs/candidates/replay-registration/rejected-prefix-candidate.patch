@@ -92,0 +93,39 @@ structure SourceCursor where
+def SourceCursor.inFlight (cursor : SourceCursor) : Bool :=
+  cursor.block > 0 || cursor.field > 0 ||
+    !cursor.watchAfter.isEmpty || !cursor.resetAfter.isEmpty
+
+/-- A new dependency may arrive after its source change or posting has been
+consumed. Revalidate that task alone; existing dependencies never rewind the
+shared cursor. A different captured head is conservatively rechecked, including
+source replacement and disappearance. This grants no completion authority. -/
+def SourceCursor.recheckRegistration (cursor : SourceCursor) (captured : PageMap.Head)
+    (newFields : Bool) : Bool :=
+  newFields && (cursor.inFlight || decide (cursor.head ≠ some captured))
+
+def registrationCursor (previous : Option SourceCursor) (path : String)
+    (captured : PageMap.Head) (sequence : Nat) : SourceCursor :=
+  previous.getD {path,head := some captured,sequence}
+
+theorem existing_registration_preserves_cursor (cursor : SourceCursor) (path : String)
+    (captured : PageMap.Head) (sequence : Nat) :
+    registrationCursor (some cursor) path captured sequence = cursor := rfl
+
+theorem unchanged_registration_never_requeues (cursor : SourceCursor) (captured : PageMap.Head) :
+    cursor.recheckRegistration captured false = false := by
+  simp [SourceCursor.recheckRegistration]
+
+theorem changed_head_rechecks_new_dependency (cursor : SourceCursor) (captured : PageMap.Head)
+    (different : cursor.head ≠ some captured) :
+    cursor.recheckRegistration captured true = true := by
+  simp [SourceCursor.recheckRegistration,different]
+
+theorem partial_scan_rechecks_new_dependency (cursor : SourceCursor) (captured : PageMap.Head)
+    (partialScan : cursor.inFlight = true) :
+    cursor.recheckRegistration captured true = true := by
+  simp [SourceCursor.recheckRegistration,partialScan]
+
+theorem settled_registration_needs_no_recheck (cursor : SourceCursor) (captured : PageMap.Head)
+    (sameHead : cursor.head = some captured) (settled : cursor.inFlight = false) :
+    cursor.recheckRegistration captured true = false := by
+  simp [SourceCursor.recheckRegistration,sameHead,settled]
+

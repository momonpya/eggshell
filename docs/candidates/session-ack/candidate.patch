+/-- Native receipt identities are unique, but compare the complete captured
+offer as well: a replacement must not inherit an earlier confirmation. -/
+def sameDeliveryOffer (left right : DeliveryOffer) : Bool :=
+  left.id == right.id && left.stamp.turn == right.stamp.turn &&
+    left.stamp.epoch == right.stamp.epoch && left.stamp.deadline == right.stamp.deadline &&
+    left.graphs == right.graphs && left.text == right.text && left.reason == right.reason &&
+    toJson left.search == toJson right.search && left.projection == right.projection
+
+def AcknowledgmentBasis.accepts (basis : AcknowledgmentBasis) (state : ThreadState)
+    (pending : PendingTurn) (now : Nat) : Bool :=
+  state.enabled && state.epoch == basis.epoch &&
+    basis.offer.stamp.accepts pending.turnId state.epoch now &&
+    state.confirmedDelivery == basis.previous && state.offers.any (sameDeliveryOffer basis.offer)
+
+theorem acknowledgment_rejects_new_context (basis : AcknowledgmentBasis) (state : ThreadState)
+    (pending : PendingTurn) (now : Nat) (changed : state.epoch ≠ basis.epoch) :
+    basis.accepts state pending now = false := by
+  simp [AcknowledgmentBasis.accepts, changed]

+/-- Only this short compare-and-publish section owns the session guard. An
+expired, compacted, disabled, replaced, or concurrently changed context cannot
+receive a staged delivery head. -/
+def finishAcknowledgment (session : String) (basis : AcknowledgmentBasis)
+    (confirmed : Option Synapses.DeliveryLedger.Reference) : IO Bool :=
+    withSession session fun files => do
+  let some state ← readState? files | return false
+  let some pending ← readPendingBase? files | return false
+  let now ← IO.monoMsNow
+  unless basis.accepts state pending now do
+    Synapses.Live.unconfirmed files
+    return false
+  if !basis.offer.projection.complete then Synapses.Live.unconfirmed files
+  let state := {state with offers := state.offers.filter (·.id != basis.offer.id)}
+  writeJson files.state {(acceptOffer state pending.turnId now basis.offer) with confirmedDelivery := confirmed}
+  return true
 
+def acknowledge (session id : String) : IO Bool := do
+  -- The offer supplies an existing absolute deadline, not a fresh allowance.
+  let deadline ← withSession session fun files => do
+    let some state ← readState? files | return none
+    return state.offers.find? (·.id == id) |>.map (·.stamp.deadline)
+  let some deadline := deadline | return false
+  if deadline ≤ (← IO.monoMsNow) then
+    let _ ← acknowledgmentBasis? session id
+    return false
+  let files ← sessionFiles session
+  Persistence.withLockUntil (files.directory / "acknowledgment") deadline do
+    let some basis ← acknowledgmentBasis? session id | return false
+    let confirmed ← if basis.offer.projection.complete then do
+        try Synapses.DeliveryLedger.confirm session basis.epoch basis.previous basis.offer.projection
+        catch error =>
+          withSession session fun files => Synapses.Live.unconfirmed files
+          throw error
+      else pure basis.previous
+    finishAcknowledgment session basis confirmed
+

--- /dev/null
+++ b/Eggshell/Hex.lean
@@ -0,0 +1,10 @@
+module
+@[expose] public section
+namespace Eggshell.Hex
+def digit (value : UInt8) : Char :=
+  if value < 10 then Char.ofNat ('0'.toNat + value.toNat)
+  else Char.ofNat ('a'.toNat + value.toNat - 10)
+def encode (bytes : ByteArray) : String :=
+  String.ofList <| bytes.toList.flatMap fun byte =>
+    [digit (byte.toNat / 16).toUInt8, digit (byte.toNat % 16).toUInt8]
+end Eggshell.Hex
--- /dev/null
+++ b/Eggshell/ReceiptId.lean
@@ -0,0 +1,9 @@
+module
+public import Eggshell.Hex
+@[expose] public section
+namespace Eggshell.ReceiptId
+def valid (id : String) : Bool :=
+  id.length == 64 && id.toList.all (fun c =>
+    ('0' ≤ c && c ≤ '9') || ('a' ≤ c && c ≤ 'f'))
+def fresh : IO String := do pure (Hex.encode (← IO.getRandomBytes 32))
+end Eggshell.ReceiptId

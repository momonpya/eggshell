+def measuredSessionStep (timings : Option (IO.Ref (Array Json)))
+    (name : String) (action : IO α) : IO α := do
+  let some timings := timings | return ← action
+  let started ← IO.monoMsNow
+  try action finally
+    let finished ← IO.monoMsNow
+    timings.modify (·.push (Json.mkObj [("step",toJson name),
+      ("startedMs",toJson started),("finishedMs",toJson finished)]))
+
+/-- An isolated observer: all diagnostic writes happen after releasing the

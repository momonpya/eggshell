+/-- Consume already prepared literal components. Staged/unprepared owners keep
+the original bounded path; authenticated stored facts never reread the text. -/
+def literalFocusWith (facts : Option Research.PreparedLiteralFocus.Data)
+    (question : String) (owner : OutcomeEdge) (ranked : List Nat) : QueryLiterals.Focus :=
+  match facts with
+  | some facts => facts.focus question ranked
+  | none => QueryLiterals.focus question (evidenceSearchWindows owner) ranked
+
+theorem literalFocusWith_exact (facts : Research.PreparedLiteralFocus.Data)
+    (question : String) (owner : OutcomeEdge) (ranked : List Nat)
+    (exact : facts.words = (evidenceSearchWindows owner).map QueryLiterals.identifiers) :
+    literalFocusWith (some facts) question owner ranked =
+      QueryLiterals.focus question (evidenceSearchWindows owner) ranked :=
+  Research.PreparedLiteralFocus.Data.focus_exact _ _ _ _ exact
+
+theorem literalFocusWith_unprepared (question : String) (owner : OutcomeEdge) (ranked : List Nat) :
+    literalFocusWith none question owner ranked = QueryLiterals.focus question (evidenceSearchWindows owner) ranked := rfl

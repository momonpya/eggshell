+theorem prepared_literal_original_evidence (owner : OutcomeEdge) :
+    Synapses.PreparedFocusFacts.evidence ((Persistence.Store.text? owner.work).getD "")
+      ((Persistence.Store.text? owner.outcome).getD "") = evidenceSearchWindows owner := by
+  have same : Matcher.atomText? owner.work = Persistence.Store.text? owner.work := by
+    cases owner.work <;> rfl
+  simp only [Synapses.PreparedFocusFacts.evidence,Synapses.PreparedFocusFacts.trim,
+    evidenceSearchWindows,Persistence.Store.searchText,same]
 
+theorem literalFocusWith_compiled (owner : OutcomeEdge) (question : String) (ranked : List Nat) :
+    literalFocusWith (some (Synapses.PreparedFocusFacts.compile (relationKey owner.relation)
+      (relationKey owner.work) ((Persistence.Store.text? owner.work).getD "")
+      ((Persistence.Store.text? owner.outcome).getD "")).literalData) question owner ranked =
+      QueryLiterals.focus question (evidenceSearchWindows owner) ranked := by
+  change (Synapses.PreparedFocusFacts.compile _ _ _ _).literalData.focus _ _ = _
+  rw [Synapses.PreparedFocusFacts.compiled_literal_focus_exact,prepared_literal_original_evidence]
 

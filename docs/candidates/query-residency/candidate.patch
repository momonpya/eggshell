@@ -241,3 +258 @@ def prepare (source : PageMap.Snapshot) (deadline : Option Nat := none)
-      return {
-        source,shared,usage,canonical
-        canonicalFailure := if canonical.isSome then none else some "captured-canonical-unavailable"}
+      return attachCanonical readers (.ok canonical)
@@ -270,0 +286,38 @@ def Prepared.release (prepared : Prepared) (deadline : Nat) : IO Unit := do
+/-- Open source-local shared/private readers as before, then retain completed
+canonical inputs through bounded transport groups. The array remains complete
+and in original source order, including empty and explicitly failed sources. -/
+def prepareMany (sources : Array PageMap.Snapshot) (captured : Option (Array PreparedInputs.Reference))
+    (deadline : Nat) : IO (Array Prepared) := do
+  let some inputs := captured | do
+    return ← sources.mapM fun source => do
+      let now ← IO.monoMsNow
+      try prepare source (some (min deadline (now+(deadline-now)/4))) (some deadline)
+      catch _ => pure {source,shared := none,usage := none}
+  unless inputs.size == sources.size do throw (IO.userError "recommendation input inventory changed")
+  let mut prepared ← (sources.zip inputs).mapM fun (source,input) => do
+    try capturedLocal source input
+    catch error => pure {source,shared := none,usage := none,failure := some s!"index-open: {error}"}
+  let mut requests : Array Plugin.Publication.Client.SourcePin := #[]
+  let mut slots : Array Nat := #[]
+  for i in [:sources.size] do
+    let some item := prepared[i]? | throw (IO.userError "recommendation source disappeared")
+    let some input := inputs[i]? | throw (IO.userError "recommendation input disappeared")
+    if item.failure.isSome || input.population == 0 then continue
+    match input.canonical with
+    | none => prepared := prepared.set! i (attachCanonical item (.ok none))
+    | some (storage,metadata) =>
+      requests := requests.push ⟨item.source,storage,metadata⟩
+      slots := slots.push i
+  let now ← IO.monoMsNow
+  let readDeadline := min deadline (now+(deadline-now)/4)
+  let replies ← try Plugin.Publication.Client.retainSources requests readDeadline deadline
+    catch error => pure (requests.map fun _ => Except.error error.toString)
+  unless replies.size == slots.size do throw (IO.userError "recommendation retained-source inventory changed")
+  for (slot,reply) in slots.zip replies do
+    let some item := prepared[slot]? | throw (IO.userError "recommendation retained source disappeared")
+    prepared := prepared.set! slot (attachCanonical item reply)
+  return prepared
+
+def releaseMany (prepared : Array Prepared) (deadline : Nat) : IO Unit :=
+  Plugin.Publication.Client.releaseSources (prepared.filterMap (·.canonical)) deadline
+

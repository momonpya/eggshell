+def capturedLocal (source : PageMap.Snapshot) (inputs : PreparedInputs.Reference) : IO Prepared := do
+  unless inputs.source == source.head && inputs.producer == PreparedInputs.implementation do
+    throw (IO.userError "prepared recommendation changed its captured source")
+  unless inputs.population == (← Persistence.Store.getNat source.get "candidates") do
+    throw (IO.userError "prepared recommendation changed its original population")
+  if inputs.population == 0 then return {source,shared := none,usage := none}
+  return {source,shared := ← PreparedInputs.shared inputs source,usage := ← PreparedInputs.usage inputs source}
+
+def attachCanonical (prepared : Prepared)
+    (result : Except String (Option Plugin.Publication.Client.SourceReference)) : Prepared :=
+  match result with
+  | .ok canonical => {prepared with
+      canonical := canonical
+      canonicalFailure := if canonical.isSome then none else some "captured-canonical-unavailable"}
+  | .error error => {source := prepared.source,shared := none,usage := none,failure := some s!"index-open: {error}"}
+
+theorem attach_source (prepared : Prepared) (result) :
+    (attachCanonical prepared result).source = prepared.source := by cases result <;> rfl
+
+theorem attach_private_usage (prepared : Prepared) (canonical) :
+    (attachCanonical prepared (.ok canonical)).usage = prepared.usage := rfl
+

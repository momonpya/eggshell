+structure SourcePin where
+  source : PageMap.Snapshot
+  storage : Sidecar.Storage
+  captured : Synapses.CanonicalSource.Cache.Manifest
+
+/-- Every item goes through the scalar scope/head/manifest checker. A failed
+item keeps its position and cannot shift another source's capability. -/
+def checkedSourceBatch (endpoint : Daemon.Endpoint) (requests : Array SourcePin)
+    (holdUntil : Nat) (values : Array Json) : IO (Array (Except String (Option SourceReference))) := do
+  unless values.size == requests.size do throw (IO.userError "source pin reply changed its complete inventory")
+  (requests.zip values).mapM fun (request,value) => do
+    try
+      if let .ok error := value.getObjValAs? String "error" then return .error error
+      let value ← IO.ofExcept (value.getObjVal? "value")
+      return .ok (← checkedSourceReference endpoint request.source (some holdUntil) (some request.captured) value)
+    catch error => return .error error.toString
+
+def prepareSourcesUsing (endpoint : Daemon.Endpoint) (requests : Array SourcePin)
+    (deadline holdUntil : Nat) : IO (Array (Except String (Option SourceReference))) := do
+  if requests.isEmpty then return #[]
+  unless requests.size ≤ sourcePinBatchSize do throw (IO.userError "source pin batch exceeds its bound")
+  let budget ← liveBudget deadline
+  let payload := Json.mkObj [("budgetMs",toJson budget),("requests",toJson (requests.map fun request =>
+    Json.mkObj [("directory",toJson request.source.directory.toString),("source",toJson request.source.head),
+      ("storage",toJson request.storage),("holdUntil",toJson (some holdUntil)),("captured",toJson (some request.captured))]))]
+  let response ← Daemon.exchangeBefore endpoint "prepare-source-batch" payload deadline
+  let values ← IO.ofExcept (Json.parse response >>= fromJson? (α := Array Json))
+  checkedSourceBatch endpoint requests holdUntil values
+
@@ -425,0 +459,41 @@ def retainSourceAt (source : PageMap.Snapshot) (storage : Sidecar.Storage)
+/-- One resolution per bounded sequence, preserving the complete source order.
+A transport failure stays explicit for each item, never empty success. -/
+def retainSources (requests : Array SourcePin) (deadline holdUntil : Nat) :
+    IO (Array (Except String (Option SourceReference))) := do
+  if requests.isEmpty then return #[]
+  let endpoint ← resolve
+  let mut found := #[]
+  for batch in [:(requests.size+sourcePinBatchSize-1)/sourcePinBatchSize] do
+    let part := requests.extract (batch*sourcePinBatchSize) (min requests.size ((batch+1)*sourcePinBatchSize))
+    let results ← try prepareSourcesUsing endpoint part deadline holdUntil
+      catch error => pure (part.map fun _ => Except.error error.toString)
+    found := found++results
+  return found
+
+/-- Release only leases issued by this exact local service. Each item still
+proves possession of its own scope capability; foreign owners use their scalar endpoint. -/
+def releaseSources (references : Array SourceReference) (deadline : Nat) : IO Unit := do
+  let wanted := references.filter (·.retained.isSome)
+  if wanted.isEmpty then return
+  let some endpoint ← endpoint? | do
+    for reference in wanted do try reference.release deadline catch _ => pure ()
+    return
+  let belongs := fun (reference : SourceReference) => reference.endpoint.pid == endpoint.pid &&
+    reference.endpoint.port == endpoint.port && reference.endpoint.generation == endpoint.generation
+  let sameOwner := wanted.filter belongs
+  for reference in wanted do
+    unless belongs reference do
+      try reference.release deadline catch _ => pure ()
+  for batch in [:(sameOwner.size+sourcePinBatchSize-1)/sourcePinBatchSize] do
+    let part := sameOwner.extract (batch*sourcePinBatchSize) (min sameOwner.size ((batch+1)*sourcePinBatchSize))
+    if (← IO.monoMsNow) ≥ deadline then return
+    try
+      let budget ← liveBudget deadline
+      let payload := Json.mkObj [("budgetMs",toJson budget),("requests",toJson (part.map fun reference =>
+        Json.mkObj [("secret",toJson reference.endpoint.secret),("database",toJson reference.access.database),
+          ("scope",toJson reference.access.scope),("retained",toJson reference.retained)]))]
+      let response ← Daemon.exchangeBefore endpoint "release-retained-source-batch" payload deadline
+      let values ← IO.ofExcept (Json.parse response >>= fromJson? (α := Array Bool))
+      unless values.size == part.size && values.all id do throw (IO.userError "source pin release was not acknowledged")
+    catch _ => pure () -- Leases retain their original hard expiry.
+

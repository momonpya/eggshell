+module
+public import Eggshell.ProjectGatewayPeer
+@[expose] public section
+namespace Eggshell.Plugin.ProjectHookRead
+open Lean Publication Publication.Gateway
+structure Captured where
+  descriptor : Descriptor
+  boundary : Boundary
+  deriving ToJson, FromJson
+def capture (pending : PendingTurn) (deadline : Nat) : IO (Option PendingTurn) := do
+  let some target := pending.remoteRead | throw (IO.userError "missing remote read configuration")
+  unless pending.write.isNone && pending.read.isEmpty && pending.remoteFrame.isNone do
+    throw (IO.userError "ambiguous local and remote project selection")
+  Worker.withRemoteRequest pending.sessionId "search" fun _ cancelled => do
+    withPeer target.command.toArray ⟨target.projects.toArray,none⟩ deadline (fun peer => do
+      unless peer.descriptor.policy.chars ≤ pending.handoffChars do
+        throw (IO.userError "remote host delivery policy exceeds this profile's handoff_chars")
+      let boundary ← peer.pin deadline
+      return some {pending with remoteFrame := some ⟨toJson (⟨peer.descriptor,boundary⟩ : Captured)⟩}) cancelled.get
+def restored (advice : Read.Advice) (packet : Option DeliveryPacket) : Handoff :=
+  {text := advice.text,reason := advice.reason,deliveredGraphs := advice.delivered,
+    completed := 0,advisory := advice.advisory,localUnions := 0,coveredFragments := [],
+    blocksCurrent := false,packet,search := advice.search,synapticComplete := advice.synapticComplete}
+theorem restored_has_no_completion (advice : Read.Advice) (packet : Option DeliveryPacket) :
+    (restored advice packet).completed = 0 ∧ (restored advice packet).blocksCurrent = false ∧
+    (restored advice packet).localUnions = 0 := ⟨rfl,rfl,rfl⟩
+def handoff (advice : Read.Advice) : Except String Handoff := do
+  let packet ← advice.packet.mapM (fromJson? (α := DeliveryPacket))
+  unless packet.all (fun packet => packet.render == advice.text) &&
+      (advice.text.isEmpty || packet.isSome) do throw "remote delivery packet differs from its actual body"
+  return restored advice packet
+def exchange (request : Worker.Search) : IO (Option Json) :=
+  Worker.withRemoteRequest request.pending.sessionId "search" fun _ cancelled => do
+    let some target := request.pending.remoteRead | throw (IO.userError "missing remote project selection")
+    let some frame := request.pending.remoteFrame | throw (IO.userError "remote turn did not capture a complete cut")
+    let captured ← IO.ofExcept (fromJson? (α := Captured) frame.payload)
+    if request.enforce || request.evidence.isSome || request.staged then return none
+    unless request.pending.projection == .automatic do
+      throw (IO.userError "remote read_service requires automatic advisory projection")
+    withPeer target.command.toArray ⟨target.projects.toArray,none⟩ request.deadline (fun peer => do
+      unless toJson peer.descriptor == toJson captured.descriptor && peer.accepts captured.boundary do
+        throw (IO.userError "remote service changed this turn's captured project scope")
+      let delivered := request.state.deliveryClaims request.pending.turnId (← IO.monoMsNow)
+      let response ← peer.query captured.boundary request.work delivered request.deadline
+      let result ← IO.ofExcept (response.advice.mapM handoff)
+      return some (toJson (⟨result,response.search⟩ : Worker.SearchReply))) cancelled.get
+end Eggshell.Plugin.ProjectHookRead

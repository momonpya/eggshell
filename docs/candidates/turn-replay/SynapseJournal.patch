+def turnCheckpoint? (journal : PageMap.Snapshot) (name : String) : IO (Option TurnReplay.Checkpoint) := do
+  let name := "scoped:" ++ name
+  let some framed ← journal.get name | return none
+  unless (← IO.ofExcept (payloadSize (some framed))) ≤ maxBytes do
+    throw (IO.userError "turn checkpoint exceeds its metadata bound")
+  return some (← Index.decode (← journal.readPayload name))
+
+def markTurn (source : PageMap.Snapshot) (name : String) (checkpoint : TurnReplay.Checkpoint) : IO Unit := do
+  let bytes := (toJson checkpoint).compress.toUTF8
+  unless bytes.size ≤ maxBytes do throw (IO.userError "turn checkpoint exceeds its metadata bound")
+  withPublication source fun journal => do
+    let _ ← PageMap.withWriter journal fun writer => putPayload writer ("scoped:" ++ name) bytes
+
+/-- Retire the old success before replacing any of its published facts.
+Restoring earlier inputs cannot resurrect a checkpoint for removed output. -/
+def retireTurn (source : PageMap.Snapshot) (name : String) : IO Unit :=
+  withPublication source fun journal => do
+    let name := "scoped:" ++ name
+    if (← journal.get name).isNone then return
+    let _ ← PageMap.withWriter journal fun writer => writer.put name none

+-- Keep the family cue list shared while competing. Clip only selected records.
+def Record.materializationCues (record : Record) : List (Nat × Nat) :=
+  record.envelope.cues.filterMap fun (a,b) =>
+    let first := max a record.range.start
+    let last := min b record.range.stop
+    if first < last then some (first,last) else none

+/-- Prepare source-only pooled hints after raw-cache coverage is checked.
+Questions remain private and do not enter this DB-owned matrix. -/
+def prepareMatrix (options : Options) (keys : List String) : IO VectorMatrix.Result := do
+  let started ← IO.monoMsNow
+  let keys := hashDistinct keys
+  if keys.isEmpty then return ⟨"empty",0,0,(← IO.monoMsNow)-started⟩
+  if let some ready ← try VectorMatrix.open? options.cache options.model encoderContract catch _ => pure none then
+    let valid ← try keys.allM fun key => return (← VectorMatrix.read ready key).isSome catch _ => pure false
+    if valid then return ⟨"warm",ready.rows.size,ready.metadata.bytes,(← IO.monoMsNow)-started⟩
+  let mut entries := #[]
+  for key in keys do
+    let cached ← indexedWindow options key
+    let pooled ← IO.ofExcept (Eggshell.WindowCentroid.project cached.vector
+      cached.coverage.sourceTokens (cached.coverage.contextTokens - 2) cached.coverage.overlapTokens)
+    entries := entries.push ⟨key,(toJson cached.coverage).compress,pooled⟩
+  VectorMatrix.write options.cache options.model encoderContract entries

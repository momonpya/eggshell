+def readSourceBindings (server : Server) (scope : ReadSource) (head : PageMap.Head)
+    (metadata : CanonicalSource.Cache.Manifest) (retained : Option String)
+    (wanted : Array Range) (allowed : Array String) (deadline : Nat) : IO IndexedBindings.Projection := do
+  let started ← IO.monoMsNow
+  unless wanted.size ≤ 32768 && allowed.size ≤ 4096 && head.identity == scope.database &&
+      metadata.source.identity == scope.database && metadata.implementation == CanonicalSource.Cache.implementation &&
+      digest metadata.payload do throw (IO.userError "invalid prepared binding request")
+  withPreparedSource server scope head metadata retained deadline fun loaded _ => do
+    let some original := loaded.originals | throw (IO.userError "original bindings are not prepared")
+    let acquired ← IO.monoMsNow
+    let report ← BindingPageScan.resolveReport original wanted (Std.HashSet.ofArray allowed) deadline
+    let result := report.resolved
+    let scanned ← IO.monoMsNow
+    profile "source-bindings-profile" [("prepareMs",toJson (acquired-started)),
+      ("scanMs",toJson (scanned-acquired)),("targets",toJson wanted.size),
+      ("pages",toJson report.pages),("leaves",toJson report.leaves),
+      ("bytes",toJson result.bytes),("complete",toJson result.complete)]
+    let access : CanonicalSource.Shared.Access := ⟨scope.database,scope.scope,"",head,metadata,.hit⟩
+    return {
+      identity := access.identity
+      index := original.index.head
+      rows := result.rows.toArray
+      complete := result.complete
+      requests := result.requests
+      bytes := result.bytes
+      unresolved := result.unresolved
+      unusable := result.unusable}
+

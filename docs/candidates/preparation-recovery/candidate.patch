+module
+public import Eggshell.PreparedInputs
+public import Eggshell.ProjectSources
+@[expose] public section
+namespace Eggshell.ProjectReadSnapshot
+open Lean DB Persistence.Store
+
+/-- Opaque immutable metadata roots. No host path, query, original body,
+private usage state or completion authority crosses this boundary. -/
+structure Pin where
+  source : PageMap.Head
+  query : PageMap.Head
+  owners : PageMap.Head
+  deriving ToJson, FromJson, BEq
+def boundTo (pins : Array Pin) (heads : Array PageMap.Head) : Bool :=
+  decide (pins.map (·.source) = heads)
+theorem bound_sources (pins : Array Pin) (heads : Array PageMap.Head)
+    (bound : boundTo pins heads = true) : pins.map (·.source) = heads := by
+  exact of_decide_eq_true bound
+theorem bound_count (pins : Array Pin) (heads : Array PageMap.Head)
+    (bound : boundTo pins heads = true) : pins.size = heads.size := by
+  have same := congrArg Array.size (bound_sources pins heads bound)
+  simpa using same
+
+structure Captured where
+  original : PageMap.Snapshot
+  pin : Pin
+  input : PreparedInputs.Reference
+  owner : OwnerViews.Item
+  originalBound : original.head = pin.source
+  inputBound : input.source = pin.source
+  ownerBound : owner.captured.state.source.head = pin.source
+  shared : input.sharedSafe = true
+  ownerShared : (owner.storage == .database) = true
+
+def queryAuthority (source : PageMap.Head) : String :=
+  "prepared-query-inputs:"++source.identity++":"++PreparedInputs.implementation
+def ownerAuthority (source : PageMap.Head) : String :=
+  "owner-input-ready:"++source.identity++":"++OwnerViews.implementation
+def restore (path : System.FilePath) (head : PageMap.Head) (authority : String) : IO PageMap.Snapshot := do
+  let current ← PageMap.pin path
+  unless current.head.identity == head.identity && head.authority == authority &&
+      current.head.authority == authority do throw (IO.userError "prepared snapshot metadata belongs to another owner")
+  let some retained ← PageMap.HistoryReader.make? current head |
+    throw (IO.userError "pinned preparation metadata extent is unavailable")
+  return retained.snapshot
+
+/-- Restore the roots actually admitted, rather than looking a source up in
+the later 64-entry name directory. Retirement of a live name cannot change
+this immutable record. Metadata validation never prepares an index. -/
+def load (source : PageMap.Snapshot) (pin : Pin) (model encoder : String) : IO Captured := do
+  let query ← restore (← PreparedInputs.folder source .database model encoder)
+    pin.query (queryAuthority source.head)
+  let some raw ← query.get (PreparedInputs.sourceKey pin.source) |
+    throw (IO.userError "admitted preparation metadata omitted its source")
+  let input ← Synapses.Index.decode (α := PreparedInputs.Reference) raw
+  let owners ← restore ((← OwnerViews.directory source .database)/"ready.egg") pin.owners (ownerAuthority source.head)
+  let some owner ← PreparedOwners.readJson (α := OwnerViews.Item) owners owners.get (OwnerViews.sourceKey source) |
+    throw (IO.userError "admitted preparation metadata omitted its owner input")
+  unless input.producer == PreparedInputs.implementation && input.model == model &&
+      input.encoder == encoder do throw (IO.userError "prepared snapshot producer changed")
+  OwnerViews.validate ⟨OwnerViews.implementation,#[source.head],#[owner]⟩ #[source]
+  if originalBound : source.head = pin.source then
+    if inputBound : input.source = pin.source then
+      if ownerBound : owner.captured.state.source.head = pin.source then
+        if shared : input.sharedSafe = true then
+          if ownerShared : (owner.storage == .database) = true then
+            return ⟨source,pin,input,owner,originalBound,inputBound,ownerBound,shared,ownerShared⟩
+  throw (IO.userError "prepared snapshot changed its source or public storage boundary")
+
+/-- Select the earliest retained prepared prefix covering the admission fence.
+Only the bounded metadata directory is examined; no Work, Outcome, source
+body, vector, lexical posting or synaptic edge is reconstructed here. -/
+def find? (current : PageMap.Snapshot) (minimum : PageMap.Head) (model encoder : String) : IO (Option Captured) := do
+  unless ← ProjectStore.sourceContains current minimum do
+    throw (IO.userError "query admission fence is not in the owner's original history")
+  let some query ← PageMap.open? (← PreparedInputs.folder current .database model encoder) |
+    return none
+  unless query.head.authority == queryAuthority current.head do throw (IO.userError "foreign prepared query directory")
+  let some owners ← PageMap.open? ((← OwnerViews.directory current .database)/"ready.egg") | return none
+  if (← query.get (PreparedInputs.sourceKey minimum)).isSome then
+    let some retained ← PageMap.HistoryReader.make? current minimum |
+      throw (IO.userError "admission fence extent is unavailable")
+    let source := retained.snapshot
+    if (← PreparedOwners.readJson (α := OwnerViews.Item) owners owners.get (OwnerViews.sourceKey source)).isSome then
+      return some (← load source ⟨minimum,query.head,owners.head⟩ model encoder)
+  let mut heads : List PageMap.Head := []
+  if (← query.get (PreparedInputs.sourceKey minimum)).isSome then heads := [minimum]
+  let count ← getNat query.get "count"
+  for slot in [:min count 64] do
+    if let some raw ← query.get (key "slot" slot) then
+      let head ← Synapses.Index.decode (α := PageMap.Head) raw
+      if head.revision ≥ minimum.revision && !heads.contains head then heads := head::heads
+  for head in heads.mergeSort (fun a b => a.revision ≤ b.revision) do
+    unless head.identity == current.head.identity && head.authority == current.head.authority do
+      throw (IO.userError "prepared directory mixed original incarnations")
+    unless ← ProjectStore.sourceContains current head do
+      throw (IO.userError "prepared directory names a divergent original history")
+    let some retained ← PageMap.HistoryReader.make? current head |
+      throw (IO.userError "prepared original extent is unavailable")
+    let source := retained.snapshot
+    unless ← ProjectStore.sourceContains source minimum do continue
+    if (← query.get (PreparedInputs.sourceKey head)).isNone then continue
+    if (← PreparedOwners.readJson (α := OwnerViews.Item) owners owners.get (OwnerViews.sourceKey source)).isNone then continue
+    return some (← load source ⟨head,query.head,owners.head⟩ model encoder)
+  return none
+end Eggshell.ProjectReadSnapshot

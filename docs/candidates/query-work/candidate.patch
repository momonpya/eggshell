+/-- Compile each cited parent's reach once for this exact graph and persistent
+Union boundary. Membership is all the citation filter observes; no route or
+authority is synthesized by this advisory lookup. -/
+def citationReach (parents : List (Nat × Value × String))
+    (all : List AllEdge) (unions : List UnionEdge) : List (Nat × Std.HashSet Value × String) :=
+  parents.map fun (rank,work,text) =>
+    (rank,Std.HashSet.ofList ((sourceNeighborhood [work] all unions).map (·.work)),text)
+
+def citedParents (compiled : List (Nat × Std.HashSet Value × String))
+    (work : Value) : List (Nat × String) :=
+  compiled.filterMap fun (rank,reached,text) =>
+    if reached.contains work then some (rank,text) else none
+
+theorem citedParents_exact (parents : List (Nat × Value × String))
+    (all : List AllEdge) (unions : List UnionEdge) (work : Value) :
+    citedParents (citationReach parents all unions) work =
+      parents.filterMap (fun (rank,parent,text) =>
+        if (sourceNeighborhood [parent] all unions).any (fun row => row.work == work) then
+          some (rank,text) else none) := by
+  simp only [citedParents,citationReach,List.filterMap_map]
+  apply congrArg (fun choose => parents.filterMap choose)
+  funext parent
+  rcases parent with ⟨rank,parent,text⟩
+  simp only [Function.comp_apply,Std.HashSet.contains_ofList,List.contains_map]
+  have same : (sourceNeighborhood [parent] all unions).any (fun row => work == row.work) =
+      (sourceNeighborhood [parent] all unions).any (fun row => row.work == work) :=
+    List.any_congr rfl (fun _ => BEq.comm)
+  rw [same]
+
 /-- Meaning search supplies entry points. A selected surrounding owner must

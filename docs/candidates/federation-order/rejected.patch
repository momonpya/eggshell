+
+/-- The construction buffer has constant-time insertion; reversing once
+retains exactly the previous source, root and provenance order. -/
+theorem reversed_push_order (reversed : List α) (item : α) :
+    (item :: reversed).reverse = reversed.reverse ++ [item] := List.reverse_cons
+
+theorem reversed_batch_order (reversed added : List α) :
+    (added.reverseAux reversed).reverse = reversed.reverse ++ added := by
+  rw [List.reverseAux_eq, List.reverse_append, List.reverse_reverse]

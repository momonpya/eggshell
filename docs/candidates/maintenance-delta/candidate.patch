@@ -0,0 +1,107 @@
+module
+public import Eggshell.SynapseTraceCache
+
+@[expose] public section
+namespace Eggshell.Synapses.Maintenance
+open Lean DB Persistence.Store
+
+structure View (source : PageMap.Snapshot) where
+  forward : IO.Ref (Std.HashMap Nat (Array Nat))
+  backward : IO.Ref (Std.HashMap Nat (Array Nat))
+  workKeys : IO.Ref (Std.HashMap Nat String)
+  headersRead : IO.Ref Nat
+
+def View.new (source : PageMap.Snapshot) : IO (View source) := do
+  return ⟨← IO.mkRef {},← IO.mkRef {},← IO.mkRef {},← IO.mkRef 0⟩
+
+/-- Numeric Work references are read from the same live All directories used
+by the source producer. No Work/Outcome payload is decoded to follow an edge. -/
+def View.neighbors (view : View source) (reverse : Bool) (work : Nat) : IO (Array Nat) := do
+  let cache := if reverse then view.backward else view.forward
+  if let some found := (← cache.get)[work]? then return found
+  let population ← getNat source.get "alls"
+  unless (← getNat source.get "indexedAllReferences") == population do
+    throw (IO.userError "All reference index is incomplete")
+  let tag := if reverse then "allChild" else "allParent"
+  let mut found := #[]
+  for (ordinal,id) in ← directory source (key tag work) do
+    let member ← IO.ofExcept (payloadSize (← source.get (key "member" id)))
+    unless (← IO.ofExcept (payloadSize (← source.get (key "root" member)))) == id &&
+        (← IO.ofExcept (payloadSize (← source.get (key "allOrdinal" id)))) == ordinal &&
+        (← IO.ofExcept (payloadSize (← source.get (key "all" ordinal)))) == id && ordinal < population do
+      throw (IO.userError "maintenance All posting differs from its live source")
+    let some header := AllHeader.fromFrame? (← readFrame source source.get id) |
+      throw (IO.userError "maintenance All posting has no checked frame")
+    unless (← IO.ofExcept (payloadSize (← source.get (key "allParentOf" id)))) == header.parent do
+      throw (IO.userError "maintenance All parent inverse differs from its source")
+    view.headersRead.modify (·+1)
+    if reverse then
+      unless header.children.contains work do throw (IO.userError "maintenance child is absent from its original frame")
+      found := found.push header.parent
+    else
+      unless header.parent == work do throw (IO.userError "maintenance parent is absent from its original frame")
+      found := found ++ header.children.toArray
+  cache.modify (·.insert work found)
+  return found
+
+def View.closure (view : View source) (reverse : Bool) (roots : Array Nat) : IO (Std.HashSet Nat) := do
+  let mut queue := roots
+  let mut position := 0
+  let mut seen := {}
+  while position < queue.size do
+    let current := queue[position]!
+    position := position+1
+    if seen.contains current then continue
+    seen := seen.insert current
+    queue := queue ++ (← view.neighbors reverse current)
+  return seen
+
+/-- The source already stores nomination hashes with collision buckets.
+Read that metadata instead of decoding a potentially large Work or child.
+Callers still verify each returned original owner's numeric Work identity. -/
+def View.workKey (view : View source) (work : Nat) : IO String := do
+  if let some found := (← view.workKeys.get)[work]? then return found
+  let found := "v" ++ toString (← nodeHash source work)
+  view.workKeys.modify (·.insert work found)
+  return found
+
+def entry? (source : PageMap.Snapshot) (id : Nat) : IO (Option SearchDocument) := do
+  let some member ← source.get (key "member" id) | return none
+  let ordinal ← IO.ofExcept (payloadSize (some member))
+  if (← getNat source.get (key "candidate" id)) != 1 then return none
+  unless (← IO.ofExcept (payloadSize (← source.get (key "searchCandidate" ordinal)))) == id do
+    throw (IO.userError "maintenance owner differs from its source candidate ordinal")
+  let located ← locateOutcome source id
+  return some ⟨id,located.header.work,[],some (Sidecar.Owner.ofSnapshot source)⟩
+
+structure Facts where
+  reader : Index.Reader
+  seen : IO.Ref (Std.HashSet String)
+  values : IO.Ref (Std.HashSet Fact)
+  inspected : IO.Ref Nat
+
+def Facts.new (reader : Index.Reader) : IO Facts := do
+  return ⟨reader,← IO.mkRef {},← IO.mkRef {},← IO.mkRef 0⟩
+
+/-- Complete background bucket lookup. Exceeding a bound is an error, never a
+successful negative. No all-fact tree scan is reachable through this path. -/
+def Facts.include (facts : Facts) (key : Index.Key) : IO Unit := do
+  let name := (toJson key).compress
+  if (← facts.seen.get).contains name then return
+  let found ← facts.reader.lookup key (facts.reader.manifest.facts+1) (2^64)
+  unless found.complete do throw (IO.userError "incomplete background maintenance posting")
+  facts.inspected.modify (·+found.facts.size)
+  for fact in found.facts do facts.values.modify (·.insert fact)
+  facts.seen.modify (·.insert name)
+
+def Facts.snapshot (facts : Facts) : IO (Array Fact) := do
+  return (← facts.values.get).toArray
+
+def readsAt (reader : Index.Reader) (work : String) : IO (Array Read) := do
+  let found ← reader.lookup (.readWork reader.manifest.source.identity work) (reader.manifest.facts+1) (2^64)
+  unless found.complete do throw (IO.userError "incomplete background Work read posting")
+  found.facts.mapM fun fact => match fact with
+    | .read read => pure read
+    | _ => throw (IO.userError "Work read posting contains another fact kind")
+
+end Eggshell.Synapses.Maintenance

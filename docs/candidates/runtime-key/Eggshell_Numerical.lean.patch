+def Config.binding (config : Config) : String × String × String × String :=
+  (config.model,config.models.normalize.toString,config.python.normalize.toString,implementation)
+
+theorem Config.binding_model (config : Config) : config.binding.1 = config.model := rfl
+theorem Config.binding_models (config : Config) : config.binding.2.1 = config.models.normalize.toString := rfl
+theorem Config.binding_python (config : Config) : config.binding.2.2.1 = config.python.normalize.toString := rfl
+theorem Config.binding_implementation (config : Config) : config.binding.2.2.2 = implementation := rfl
+
+theorem Config.foreign_model_binding (left right : Config) (different : left.model ≠ right.model) :
+    left.binding ≠ right.binding := by
+  intro same
+  exact different (congrArg Prod.fst same)
+
+def Config.key (config : Config) : String := Sha256.hex (toJson config.binding).compress.toUTF8
+
+theorem Config.key_uses_binding (config : Config) :
+    config.key = Sha256.hex (toJson config.binding).compress.toUTF8 := rfl
+

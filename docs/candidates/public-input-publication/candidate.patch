-  if (← getNat source.get "candidates") == 0 then return some (empty source model encoder)
+def public? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Public) := do
+  let population ← getNat source.get "candidates"
@@ -182,7 +228,3 @@ def load? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Refe
-      match ← PageMap.open? path with
-      | none => pure none
-      | some index =>
-        let raw ← match ← index.get (sourceKey source.head) with
-          | some raw => pure (some raw)
-          | none => index.get "latest"
-        raw.mapM (Synapses.Index.decode (α := Reference))
+      match ← readPublic? (publicPath path source.head) with
+      | some value => pure (some value)
+      | none => readPublic? (path/"public"/"latest.json")
@@ -192,3 +234,2 @@ def load? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Refe
-    if let some reference := found then
-      unless reference.producer == implementation && reference.source.identity == source.head.identity &&
-          reference.source.authority == source.head.authority && reference.model == model && reference.encoder == encoder do
+    if let some value := found then
+      unless value.storage == storage && (← value.validFor source model encoder) do
@@ -195,0 +237 @@ def load? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Refe
+      let reference := value.input
@@ -197,3 +239,5 @@ def load? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Refe
-        -- Usage is private and may advance without a source publication.
-        let usage ← Synapses.UsageCache.open? source
-        return some {reference with source := source.head,usage := usage.map (·.index.head)}
+        let owner ← if reference.source == source.head then pure value.owner else OwnerViews.loadOne? source
+        return some {value with input := {reference with source := source.head},owner}
+  -- Empty originals are still members of the complete captured inventory.
+  if population == 0 then
+    return some ⟨source.directory.toString,.database,empty source model encoder,← OwnerViews.loadOne? source⟩
@@ -201,0 +246,17 @@ def load? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Refe
+def publicOwners (sources : Array PageMap.Snapshot) (values : Array Public) : IO (Option OwnerViews.Reference) := do
+  unless sources.size == values.size do throw (IO.userError "public inputs omitted an original source")
+  let mut items := #[]
+  for (source,value) in sources.zip values do
+    unless value.directory == source.directory.toString && value.input.source == source.head do
+      throw (IO.userError "public owner input changed its original source")
+    let some owner := value.owner | return none
+    items := items.push owner
+  let reference : OwnerViews.Reference := ⟨OwnerViews.implementation,sources.map (·.head),items⟩
+  OwnerViews.validate reference sources
+  return some reference
+
+def load? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Reference) := do
+  let some value ← public? source model encoder | return none
+  let usage ← Synapses.UsageCache.open? source
+  return some {value.input with usage := usage.map (·.index.head)}
+

+  unless ← published.validFor source model encoder do throw (IO.userError "invalid public input publication")
+  let bytes := (toJson published).compress.toUTF8
+  unless bytes.size ≤ 131072 do throw (IO.userError "public input publication exceeds its byte bound")
+  let folder ← Sidecar.childDirectory path "public"
+  let exact := publicPath path source.head
+  let latest := folder / "latest.json"
+  if (← index.get (sourceKey source.head)) == some encoded &&
+      (← readPublic? exact).any (fun value => (toJson value).compress.toUTF8 == bytes) &&
+      (← readPublic? latest).any (fun value => (toJson value).compress.toUTF8 == bytes) then return reference
@@ -168 +208,4 @@ def publish (source : PageMap.Snapshot) (storage : Sidecar.Storage) (model encod
-        if old != source.head then writer.put (sourceKey old) none
+        if old != source.head then

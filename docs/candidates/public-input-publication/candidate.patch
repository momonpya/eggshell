@@ -45,0 +46,19 @@ structure Reference where
+/-- Query-independent read projection of one completed publication. Private
+usage is attached only after the caller has captured its original boundary. -/
+structure Public where
+  directory : String
+  storage : Sidecar.Storage
+  input : Reference
+  owner : Option OwnerViews.Item
+  deriving ToJson,FromJson
+
+def Public.validFor (value : Public) (source : PageMap.Snapshot) (model encoder : String) : IO Bool := do
+  let scope ← OwnerViews.scope source
+  return value.directory == source.directory.toString && value.input.producer == implementation &&
+    value.input.source.identity == source.head.identity && value.input.source.authority == source.head.authority &&
+    value.input.model == model && value.input.encoder == encoder && value.input.usage.isNone &&
+    value.owner.all (fun item => item.captured.state.source.head == value.input.source &&
+      item.captured.state.source.directory == value.directory &&
+      item.captured.state.binding.producer == SourceOwners.implementation &&
+      item.captured.state.binding.scope == scope)
+
@@ -147,0 +167,11 @@ def sourceKey (head : PageMap.Head) : String := "source:"++Synapses.Index.conten
+def publicPath (path : System.FilePath) (head : PageMap.Head) : System.FilePath :=
+  path / "public" / (Sha256.hex (toJson head).compress.toUTF8 ++ ".json")
+
+def readPublic? (path : System.FilePath) : IO (Option Public) := do
+  unless (← FileSystem.symlinkMetadata? path).isSome do return none
+  let bytes ← FileSystem.boundedBytes path 131072
+  let value ← Synapses.Index.decode (α := Public) bytes
+  unless bytes == (toJson value).compress.toUTF8 do
+    throw (IO.userError "noncanonical public input publication")
+  return some value
+
@@ -161 +191,11 @@ def publish (source : PageMap.Snapshot) (storage : Sidecar.Storage) (model encod
-  if (← index.get (sourceKey source.head)) == some encoded then return reference
+  let owner ← OwnerViews.loadOne? source

+def Part.check? (rows : Array StoredRow) (plan : String := "") : Option Part :=
+  if nonempty : rows.isEmpty = false then some ⟨rows,plan,nonempty⟩ else none
+
+theorem empty_part_rejected (plan : String) : Part.check? #[] plan = none := by
+  simp [Part.check?]
+
+theorem checked_part_nonempty (rows : Array StoredRow) (plan : String) (part : Part)
+    (checked : Part.check? rows plan = some part) : rows.isEmpty = false := by
+  unfold Part.check? at checked
+  split at checked
+  · assumption
+  · contradiction
+
+instance : BEq Part := ⟨fun a b => a.rows == b.rows && a.plan == b.plan⟩
+instance : ToJson Part := ⟨fun part => Json.mkObj [("rows",toJson part.rows),("plan",toJson part.plan)]⟩
+instance : FromJson Part where
+  fromJson? value := do
+    let rows ← value.getObjValAs? (Array StoredRow) "rows"
+    let plan ← match value.getObjVal? "plan" with
+      | .ok field => field.getStr?
+      | .error _ => pure ""
+    let some part := Part.check? rows plan | throw "empty shared source payload"
+    return part
+

+module
+public import Eggshell.PublicationClient
+public import Eggshell.Warm
+
+@[expose] public section
+namespace Eggshell.Plugin.ExplicitWarm
+open Lean DB
+
+def inspect (source : PageMap.Snapshot) (target : IndexTarget) : IO Warm.Inspection := do
+  if Warm.lexicalOnly target.command then
+    return {coverage := {
+      database := Sidecar.Owner.ofSnapshot source
+      revision := source.head.revision
+      model := "lexical-only"
+      windows := 0
+      valid := 0
+      missing := 0
+      invalid := 0
+      encoderContract := SearchProvider.encoderContract
+      input := {}
+      focusContract := focusWindowContract
+      discovery := {}
+      focus := {} },needed := []}
+  Warm.inspect source (← Warm.options source target.command target.storage)
+
+/-- Register all sources once and retain one bounded claim over their exact
+heads. This path never executes an index producer or takes its writer lock.
+The existing scheduler owns exclusion and merges identical captured requests. -/
+def run (requests : Array (PageMap.Snapshot × Bool)) (command : List String) : IO (Array Json) := do
+  let started ← IO.monoMsNow
+  let deadline := started+PreparationPlan.warmBudgetMs
+  let targets ← requests.mapM fun (source,writable) => do
+    let target ← registerIndexTarget source command writable
+    return {target with sourceHead := some source.head}
+  let before ← (requests.zip targets).mapM fun ((source,_),target) => inspect source target
+  let needed ← (requests.zip targets).mapM fun ((source,_),target) => Warm.required target source
+  if needed.any id then
+    let some token ← Publication.Client.openWarmPreparation deadline |
+      throw (IO.userError "preparation service has no room for an explicit warm")
+    try
+      for batch in [:(targets.size+PreparationPlan.claimBatchSize-1)/PreparationPlan.claimBatchSize] do
+        let mut claims := #[]
+        for index in [batch*PreparationPlan.claimBatchSize:min targets.size ((batch+1)*PreparationPlan.claimBatchSize)] do
+          if !(needed[index]?.getD false) then continue
+          let some target := targets[index]? | throw (IO.userError "warm source inventory changed")
+          let some source := requests[index]? | throw (IO.userError "warm source inventory changed")
+          let registry := {target with sourceHead := none}
+          claims := claims.push (registry.key,source.1.head)
+        unless claims.isEmpty do
+          let accepted ← Publication.Client.claimPreparations claims token deadline
+          unless accepted.all id do throw (IO.userError "preparation service could not admit every warm source")
+      let mut delay := 20
+      repeat
+        if ← IO.checkCanceled then throw (IO.userError "explicit warm cancelled")
+        let now ← IO.monoMsNow
+        unless now < deadline do throw (IO.userError "explicit warm did not finish before its cutoff")
+        let pending ← (requests.zip targets).mapM fun ((source,_),target) => Warm.required target source
+        if !(pending.any id) then break
+        unless ← Publication.Client.preparationLive token deadline do
+          throw (IO.userError "explicit warm lost its preparation claim")
+        IO.sleep (min delay (deadline-now)).toUInt32
+        delay := min 200 (delay*2)
+    finally Publication.Client.releasePreparation token deadline
+  (requests.zip targets).zipIdx.mapM fun (((source,_),target),index) => do
+    let after ← inspect source target
+    unless after.needed.isEmpty do throw (IO.userError "warm completed without valid numerical coverage")
+    let model ← if Warm.lexicalOnly command then pure MiniLM.model else Warm.model command
+    let some prepared ← PreparedInputs.load? source model SearchProvider.encoderContract |
+      throw (IO.userError "warm completed without its exact prepared source")
+    unless prepared.accepts source model SearchProvider.encoderContract do
+      throw (IO.userError "warm prepared reference changed its captured source")
+    let some previous := before[index]? | throw (IO.userError "warm coverage inventory changed")
+    return Json.mkObj [("prepared",toJson (some prepared)),("before",toJson previous.coverage),
+      ("after",toJson after.coverage),("requested",toJson previous.needed.length),
+      ("elapsedMs",toJson ((← IO.monoMsNow)-started)),("scope",toJson "shared-service"),
+      ("coordinated",toJson true)]
+
+end Eggshell.Plugin.ExplicitWarm

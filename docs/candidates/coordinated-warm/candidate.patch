+/-- A shared prepared frame cannot contain addresses relative to the creating
+user's private cache. Usage is attached only after loading into a private turn. -/
+def Reference.publicStorages (reference : Reference) : List Sidecar.Storage :=
+  reference.windows.toList.map (·.storage) ++ reference.lexical.toList.map (·.storage) ++
+    reference.numeric.toList.map (·.storage) ++ reference.canonical.toList.map Prod.fst ++
+    reference.shared.toList.map (·.storage)
+
+def Reference.sharedSafe (reference : Reference) : Bool :=
+  reference.publicStorages.all (· == .database) && reference.usage.isNone
+
+theorem Reference.shared_storage (reference : Reference) (safe : reference.sharedSafe = true)
+    (storage : Sidecar.Storage) (present : storage ∈ reference.publicStorages) :
+    storage = .database := by
+  have flags := safe
+  simp only [Reference.sharedSafe, Bool.and_eq_true] at flags
+  have all := flags.1
+  simp only [List.all_eq_true] at all
+  have accepted := all storage present
+  cases storage with
+  | database => rfl
+  | user => cases accepted
+
+structure StoredReference (storage : Sidecar.Storage) where
+  reference : Reference

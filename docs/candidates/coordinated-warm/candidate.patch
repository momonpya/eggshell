+theorem waiterExpiry_window (now requested window : Nat) :
+    waiterExpiry now requested window ≤ now + window :=
+  Nat.le_trans (Nat.min_le_right _ _) (Nat.add_le_add_left (Nat.min_le_left _ _) _)

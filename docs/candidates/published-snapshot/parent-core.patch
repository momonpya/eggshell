+module
+public import Eggshell.CanonicalSourceRecords
+public import Eggshell.CanonicalSourceDelivery
+@[expose] public section
+
+namespace Eggshell.Synapses.CanonicalSource.Recipe
+open Lean DB
+
+/-- Publication-time layout only. Query cues, relevance, budgets, selections
+and authority never enter this representation. -/
+structure Entry where
+  indices : List Nat
+  before : Option Nat
+  after : Nat
+  deriving BEq,ReflBEq,LawfulBEq,Hashable,ToJson,FromJson
+
+def Entry.ofRecord (record : Records.Record rows) : Entry :=
+  ⟨record.indices.map Fin.val,record.before.map Fin.val,record.after.val⟩
+
+def Entry.check? (rows : Array StoredRow) (entry : Entry) : Except String (Records.Record rows) := do
+  let indices ← entry.indices.mapM fun index =>
+    if inside : index < rows.size then pure (⟨index,inside⟩ : Fin rows.size)
+    else throw "prepared record index is outside its original rows"
+  let before ← entry.before.mapM fun index =>
+    if inside : index < rows.size then pure (⟨index,inside⟩ : Fin rows.size)
+    else throw "prepared predecessor is outside its original rows"
+  if inside : entry.after < rows.size then
+    let some record := Records.check? rows indices before ⟨entry.after,inside⟩ |
+      throw "prepared record differs from its original layout"
+    return record
+  else throw "prepared successor is outside its original rows"
+
+structure Stored where
+  rows : Array StoredRow
+  records : List Entry
+  deriving BEq,ToJson,FromJson
+
+def compile (parts : Array StoredRow) : Except String Stored := do
+  let rows ← Delivery.merge parts
+  return ⟨rows,(Records.prepare rows).map Entry.ofRecord⟩
+
+structure Checked (rows : Array StoredRow) where
+  records : List (Records.Record rows)
+  catalogue : List (List (Fin rows.size))
+  exact : catalogue = Records.catalogue rows records
+
+def check (rows : Array StoredRow) (entries : List Entry) : Except String (Checked rows) := do
+  let records ← entries.mapM (Entry.check? rows)
+  return ⟨records,Records.catalogue rows records,rfl⟩
+
+theorem Checked.catalogue_complete (prepared : Checked rows) (index : Fin rows.size) :
+    index ∈ prepared.catalogue.flatten := by
+  rw [prepared.exact]
+  exact Records.catalogue_complete rows prepared.records index
+
+/-- Federation remaps already published records by original row identity.
+It never invents a boundary by parsing the combined output, nor loses the
+singleton domain of rows that have no bounded original record. -/
+def reindex (source target : Array StoredRow) (entries : List Entry) : Except String (List Entry) := do
+  let positions := target.toList.zipIdx.foldl (fun found (row,position) => found.insert row.key position)
+    ({} : Std.HashMap Key Nat)
+  let resolve := fun (index : Nat) => (do
+    let some row := source[index]? | throw "federated record is outside its source"
+    let some position := positions[row.key]? | throw "federation lost a published original row"
+    let some selected := target[position]? | throw "federated row directory is inconsistent"
+    unless selected.code == row.code do throw "federation changed original code"
+    return position : Except String Nat)
+  entries.mapM fun entry => return ⟨← entry.indices.mapM resolve,← entry.before.mapM resolve,← resolve entry.after⟩
+
+def combine (left right merged : Array StoredRow) (a b : List Entry) : Except String (List Entry) := do
+  let entries := hashDistinct ((← reindex left merged a) ++ (← reindex right merged b))
+  let _ ← check merged entries
+  return entries
+
+def name (owner : String) := "owner:" ++ owner
+
+def read? (snapshot : PageMap.Snapshot) (owner : String) : IO (Option Stored) := do
+  let key := name owner
+  let descriptor ← snapshot.get key
+  if descriptor.isNone then return none
+  let size ← IO.ofExcept (PageMap.payloadSize descriptor)
+  unless size ≤ 32*1024*1024 do throw (IO.userError "prepared owner exceeds reply bound")
+  let bytes ← snapshot.readPayload key
+  unless bytes.size ≤ 32*1024*1024 do throw (IO.userError "prepared owner exceeds reply bound")
+  let some text := String.fromUTF8? bytes | throw (IO.userError "prepared owner is not UTF-8")
+  let stored ← IO.ofExcept (Json.parse text >>= fromJson? (α := Stored))
+  return some stored
+
+def write (writer : PageMap.Writer) (owner : String) (stored : Stored) : IO Unit := do
+  let bytes := (toJson stored).compress.toUTF8
+  unless bytes.size ≤ 32*1024*1024 do throw (IO.userError "prepared owner exceeds reply bound")
+  Persistence.Store.putPayload writer (name owner) bytes
+
+end Eggshell.Synapses.CanonicalSource.Recipe

@@ -162,6 +162,13 @@
 def publicationTemporary (kind : PublicationKind) (suffix : String) : String :=
   (match kind with | .replace => ".egg-tmp-" | .immutable => ".egg-object-") ++ suffix
 
+/-- Time is not an allocation identity, including between threads in one
+process. Exclusive filesystem creation remains the uniqueness authority. -/
+def freshSuffix : IO String := do
+  let random ← IO.getRandomBytes 16
+  return s!"{← IO.Process.getPID}-" ++
+    String.intercalate "-" (random.toList.map fun byte => toString byte.toNat)
+
 def isPublicationTemporary (name : String) : Bool :=
   name.startsWith ".egg-tmp-" || name.startsWith ".egg-object-"
 

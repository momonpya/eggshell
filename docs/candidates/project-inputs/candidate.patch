diff --git a/Eggshell/ProjectInputs.lean b/Eggshell/ProjectInputs.lean
new file mode 100644
index 0000000..571ff97
--- /dev/null
+++ b/Eggshell/ProjectInputs.lean
@@ -0,0 +1,81 @@
+module
+
+public import Eggshell.ProjectSources
+
+@[expose] public section
+namespace Eggshell.ProjectInputs
+open Lean DB ProjectStore Persistence.Store
+
+/-- Original read boundaries, without locations, credentials or foreign bodies. -/
+structure Image where
+  project : String
+  inventory : String
+  cut : Cut
+  deriving ToJson, FromJson, BEq
+
+def ofView (view : View) : Image :=
+  ⟨view.project.manifest.identity,manifestChecksum view.project.manifest,view.cut⟩
+
+theorem ofView_owner_count (view : View) :
+    (ofView view).cut.heads.size = view.project.manifest.owners.size := by
+  simpa only [ofView, ← view.exact, Array.size_map] using view.complete
+
+def maxBytes : Nat := 1024*1024
+def digest (images : Array Image) :=
+  Blake3.hex (Blake3.digest "eggshell.project.inputs".toUTF8 [(toJson images).compress.toUTF8])
+def base (digest : String) := "project:inputs:"++digest
+
+/-- Repeated observations in the same read boundary share one descriptor.
+The exact descriptor is checked even when a digest is already present. -/
+def store (writer : PageMap.Writer) (images : Array Image) : IO String := do
+  let bytes := (toJson images).compress.toUTF8
+  unless bytes.size ≤ maxBytes do throw (IO.userError "project read boundary exceeds its bound")
+  let stamp := digest images
+  let recordBase := base stamp
+  if let some raw ← writer.get (recordBase++":count") then
+    let (count,tail) ← IO.ofExcept (Wire.natural.decode raw.toList)
+    unless tail.isEmpty && (Wire.natural.encode count).toByteArray == raw &&
+        count == (bytes.size+2047)/2048 do
+      throw (IO.userError "project read boundary count changed")
+    for index in [:count] do
+      unless (← writer.get (recordBase++":"++toString index)) ==
+          some (bytes.extract (index*2048) ((index+1)*2048)) do
+        throw (IO.userError "project read boundary was replaced")
+  else
+    putNat writer (recordBase++":count") ((bytes.size+2047)/2048)
+    for index in [:(bytes.size+2047)/2048] do
+      writer.put (recordBase++":"++toString index) (some (bytes.extract (index*2048) ((index+1)*2048)))
+  return stamp
+
+def load (source : PageMap.Snapshot) (stamp : String) : IO (Array Image) := do
+  unless PageMap.validIdentity stamp do throw (IO.userError "invalid project input digest")
+  let count ← getNat source.get (base stamp++":count")
+  unless 0 < count && count ≤ (maxBytes+2047)/2048 do
+    throw (IO.userError "missing or oversized project input descriptor")
+  let mut bytes := ByteArray.empty
+  for index in [:count] do
+    let some part ← source.get (base stamp++":"++toString index) |
+      throw (IO.userError "incomplete project input descriptor")
+    unless !part.isEmpty && part.size ≤ 2048 do throw (IO.userError "invalid project input block")
+    bytes := bytes++part
+  unless bytes.size ≤ maxBytes do throw (IO.userError "oversized project input descriptor")
+  let some text := String.fromUTF8? bytes | throw (IO.userError "invalid project input encoding")
+  let images ← IO.ofExcept (Json.parse text >>= fromJson? (α := Array Image))
+  unless (toJson images).compress.toUTF8 == bytes && digest images == stamp do
+    throw (IO.userError "project input digest or canonical encoding changed")
+  return images
+
+def binding (receiptKey : String) := receiptKey++":inputs"
+
+def bind (writer : PageMap.Writer) (receiptKey : String) (images : Array Image) : IO Unit := do
+  let stamp ← store writer images
+  if let some previous ← writer.get (binding receiptKey) then
+    unless previous == stamp.toUTF8 do throw (IO.userError "project ACK changed its read boundary")
+  else writer.put (binding receiptKey) (some stamp.toUTF8)
+
+def recorded (source : PageMap.Snapshot) (receiptKey : String) : IO (Array Image) := do
+  let some bytes ← source.get (binding receiptKey) | throw (IO.userError "project ACK has no read boundary")
+  let some stamp := String.fromUTF8? bytes | throw (IO.userError "invalid project ACK input binding")
+  load source stamp
+
+end Eggshell.ProjectInputs

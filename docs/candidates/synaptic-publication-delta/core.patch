+module
+public import Eggshell.GraphStore
+public import Eggshell.SynapseSource
+@[expose] public section
+namespace Eggshell.Synapses
+open Lean DB
+namespace Index
+inductive Scope where
+  | shared | usage
+  deriving Repr, BEq, ToJson, FromJson
+
+def Scope.directory : Scope → String
+  | .shared => "recommendations"
+  | .usage => "usage"
+
+def Scope.accepts (scope : Scope) : Fact → Bool
+  | .used _ => scope == .usage
+  | _ => scope == .shared
+
+theorem shared_rejects_usage (usage : Usage) : Scope.shared.accepts (.used usage) = false := rfl
+
+inductive Key where
+  | owner (database owner : String)
+  | answer (database owner : String)
+  | claim (claim : Claim)
+  | consumer (occurrence : Occurrence)
+  | group (group : Group)
+  | quoted (source : Range)
+  | source (source : Range)
+  | subject (subject : Subject)
+  | quotation (digest : String)
+  | query (digest : String)
+  | usage (source : Range)
+  deriving Repr, DecidableEq, BEq, ReflBEq, LawfulBEq, ToJson, FromJson
+
+def addresses : Fact → Array Key
+  | .read recorded => #[.owner recorded.binding.database recorded.binding.owner, .source recorded.source, .subject recorded.source.subject] ++
+      recorded.quotations.map Key.quotation
+  | .supports support => #[
+      .answer support.claim.database support.claim.answer, .claim support.claim, .source support.source]
+  | .consumed edge => #[.consumer edge.consumer]
+  | .coquoted group source => #[.group group, .quoted source]
+  | .used usage => #[.query usage.query, .usage usage.source]
+
+def contentKey [ToJson α] (value : α) : String :=
+  Blake3.hex (Blake3.digest "eggshell.synaptic-object".toUTF8 [(toJson value).compress.toUTF8])
+
+def payloadLimit : Nat := 262144
+
+def decode [FromJson α] [ToJson α] (bytes : ByteArray) : IO α := do
+  unless bytes.size ≤ payloadLimit do throw (IO.userError "synaptic record exceeds its byte bound")
+  let some text := String.fromUTF8? bytes | throw (IO.userError "invalid synaptic UTF-8")
+  let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := α))
+  unless (toJson value).compress.toUTF8 == bytes do
+    throw (IO.userError "noncanonical synaptic record")
+  return value
+
+def checkedBytes [ToJson α] (value : α) : IO ByteArray := do
+  let bytes := (toJson value).compress.toUTF8
+  unless bytes.size ≤ payloadLimit do throw (IO.userError "synaptic record exceeds its byte bound")
+  return bytes
+
+end Index
+namespace Recommend
+/-- Output identity is native occurrence identity. File coordinates are an
+additional addressing scheme, never a prerequisite for recommending data. -/
+inductive Target where
+  | range (source : Range)
+  | output (producer : Occurrence)
+  deriving DecidableEq, BEq, ToJson
+
+def Target.source? : Target → Option Range
+  | .range source => some source
+  | .output _ => none
+
+/-- A recommendation names data actually carried by its advisory witness.
+Ordinary rereads and changed sources do not reward a candidate. -/
+def carries (fact : Fact) : Target → Bool
+  | .output producer => match fact with
+    | .consumed edge => edge.producer == producer
+    | _ => false
+  | .range source => match fact with
+    | .supports support => support.source == source
+    | .consumed edge => edge.rows.contains source
+    | .coquoted _ quoted => quoted == source
+    | .used usage => usage.source == source &&
+        (usage.kind == .omittedThenRead || usage.kind == .omittedThenConsumed || usage.kind == .deliveredThenCited)
+    | .read _ => false
+
+deriving instance FromJson for Target
+end Recommend
+namespace Routing
+open Recommend
+/-- One step in the existing advisory relation. No original output, command
+grammar, similarity score, or human reference list enters this projection. -/
+structure Step where
+  targets : Array Target := #[]
+  next : Array Index.Key := #[]
+  deriving BEq
+
+def project (key : Index.Key) (fact : Fact) : Step :=
+  match key, fact with
+  | .answer .., .supports support =>
+    ⟨#[.range support.source], #[.group (.claim support.claim),
+      .consumer support.read.occurrence, .quoted support.source]⟩
+  | .consumer _, .consumed edge =>
+    ⟨if edge.rows.isEmpty then #[.output edge.producer] else edge.rows.map Target.range,
+      edge.rows.map Index.Key.quoted |>.push (.consumer edge.producer)⟩
+  | .quoted _, .coquoted group _ => ⟨#[], #[.group group]⟩
+  | .group _, .coquoted _ source => ⟨#[.range source], #[]⟩
+  | .query _, .used value =>
+    if value.kind == .omittedThenRead || value.kind == .omittedThenConsumed ||
+        value.kind == .deliveredThenCited then
+      ⟨#[.range value.source], #[.quoted value.source]⟩ else {}
+  | _, _ => {}
+
+/-- Projection cannot invent a recommended target. Control authority remains
+outside this module: a supported target is still only an advisory witness. -/
+theorem project_carries (key : Index.Key) (fact : Fact) (target : Target)
+    (present : target ∈ (project key fact).targets) : carries fact target = true := by
+  cases key <;> cases fact <;> simp only [project] at present <;>
+    try simp_all [carries]
+  all_goals
+    split at present <;> simp_all [Array.mem_map, Bool.or_eq_true, beq_iff_eq]
+  obtain ⟨source,member,rfl⟩ := present
+  simpa using member
+
+end Routing
+end Eggshell.Synapses

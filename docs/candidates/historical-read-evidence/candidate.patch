@@ -0,0 +1,83 @@
+module
+public import Eggshell.SynapseBuild
+@[expose] public section
+
+namespace Eggshell.Synapses.StoredReadEvidence
+open Lean DB Persistence.Store _root_.Eggshell.Synapses.Extraction
+
+def implementation : String := Blake3.hex (Blake3.digest "eggshell.stored-read-evidence".toUTF8 [
+  (include_str "StoredReadEvidence.lean").toUTF8,(include_str "ContentMetadata.lean").toUTF8,
+  (include_str "ObservedRecords.lean").toUTF8])
+
+/-- Quote digests do not change the original range or observation identity. -/
+def core (read : Read) : Read := {read with quotations := #[]}
+
+structure Owner where
+  doc : Document
+  raw : String
+  original : doc.source = some raw
+  native : doc.native = true
+  reads : Array Read
+  byCore : Std.HashMap Read {read : Read // read ∈ reads}
+
+structure Witness (candidate : Read) where
+  owner : Owner
+  saved : {read : Read // read ∈ owner.reads}
+  same : core candidate = core saved.val
+
+theorem Witness.original_member (witness : Witness candidate) : witness.saved.val ∈ witness.owner.reads :=
+  witness.saved.property
+
+theorem Witness.same_source (witness : Witness candidate) : candidate.source = witness.saved.val.source := by
+  simpa [core] using congrArg Read.source witness.same
+
+theorem Witness.same_binding (witness : Witness candidate) : candidate.binding = witness.saved.val.binding := by
+  simpa [core] using congrArg Read.binding witness.same
+
+theorem Witness.same_occurrence (witness : Witness candidate) : candidate.occurrence = witness.saved.val.occurrence := by
+  simpa [core] using congrArg Read.occurrence witness.same
+
+structure Prepared (source : PageMap.Snapshot) where
+  documents : Build.Documents source
+  owners : IO.Ref (Std.HashMap String (Option Owner))
+
+/-- The pinned pre-read publication owns these documents. A later prepared
+index is only a locator; it cannot supply originals absent from this source. -/
+def prepare (source : PageMap.Snapshot) (index : PageMap.Snapshot) : IO (Prepared source) := do
+  let reader ← NodeReader.new source
+  let cache ← IO.mkRef ({} : Std.HashMap Nat Document)
+  let catalogs ← IO.mkRef ({} : Std.HashMap Nat ObservationContext.Catalog)
+  let owners ← IO.mkRef ({} : Std.HashMap String (Option Owner))
+  return {documents := {reader,cache,catalogs,prepared := some index},owners}
+
+def Prepared.loadOwner? (prepared : Prepared source) (owner : String) : IO (Option Owner) := do
+  let some id ← Build.ownerId? source owner | return none
+  let doc ← prepared.documents.get id
+  let some raw := doc.source | return none
+  if original : doc.source = some raw then
+    if native : doc.native = true then
+      let catalog ← prepared.documents.catalog id
+      let reads := catalog.located.flatMap (·.originalRows)
+      let byCore := reads.attach.foldl
+        (fun found row => found.insert (core row.val) row) {}
+      return some {doc,raw,original,native,reads,byCore}
+    else return none
+  else return none
+
+def Prepared.owner? (prepared : Prepared source) (owner : String) : IO (Option Owner) := do
+  if let some known := (← prepared.owners.get)[owner]? then return known
+  let found ← prepared.loadOwner? owner
+  prepared.owners.modify (·.insert owner found)
+  return found
+
+def Prepared.check? (prepared : Prepared source) (candidate : Read) : IO (Option (Witness candidate)) := do
+  unless candidate.valid && candidate.binding.database == source.head.identity &&
+      (Persistence.SelectionKey.check? candidate.binding.owner).isSome do return none
+  let some owner ← prepared.owner? candidate.binding.owner | return none
+  unless owner.doc.owner == candidate.binding.owner && owner.doc.work == candidate.binding.work &&
+      owner.doc.occurrences.contains candidate.occurrence do return none
+  let some saved := owner.byCore[core candidate]? | return none
+  if same : core candidate = core saved.val then return some ⟨owner,saved,same⟩
+  else return none
+
+end Eggshell.Synapses.StoredReadEvidence

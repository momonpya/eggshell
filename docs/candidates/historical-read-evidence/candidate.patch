+/-- Historical index facts are navigation, not evidence by themselves. Every
+returned Read must equal an original catalog row at the pre-read publication. -/
+def storedReadsAt? (source : PageMap.Snapshot) (known : Knowledge) (index : Index.Reader)
+    (subjects : Std.HashSet Subject) (excluded : Occurrence) (deadline : Nat) : IO (Option (Array Read)) := do
+  let some original ← originalAt? source known.source | return none
+  let prepared ← StoredReadEvidence.prepare original index.index
+  let mut stored := #[]
+  for subject in subjects do
+    let found ← index.lookup (.subject subject) 100000 deadline
+    unless found.complete do throw (IO.userError "incomplete historical stored-read evidence")
+    for fact in found.facts do
+      let .read read := fact | continue
+      if read.occurrence == excluded then continue
+      if (← IO.monoMsNow) ≥ deadline then throw (IO.userError "historical stored-read validation deadline")
+      let some witness ← prepared.check? read | return none
+      stored := stored.push witness.saved.val
+  return some stored
+
 def ownerKeys (known : List String) : Array String :=

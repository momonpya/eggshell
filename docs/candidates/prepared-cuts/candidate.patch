+structure Ancestor (target : PageMap.Head) (α : Type) where
+  source : PageMap.Head
+  value : α
+  lineage : Lineage source target
+
+/-- Search only the unprepared publication difference. A lookup cannot replace
+the actual parent chain with revision ordering or a different original fork. -/
+private def findAncestorAt (source : PageMap.Snapshot) (head : PageMap.Head)
+    (lookup : PageMap.Head → IO (Option α)) (remaining byteBudget : Nat) :
+    IO (Option (Ancestor head α)) := do
+  if let some value ← lookup head then return some ⟨head,value,.same head⟩
+  match remaining with
+  | 0 => return none
+  | remaining+1 =>
+    if head.revision == 0 then return none
+    let historical := {source with head}
+    let some encoded ← historical.get (key "change" head.revision) | return none
+    let size ← IO.ofExcept (payloadSize (some encoded))
+    if size > byteBudget then return none
+    let publication ← readPublication historical head.revision
+    if valid : linked publication.parent head = true then
+      let some found ← findAncestorAt source publication.parent lookup remaining (byteBudget-size) | return none
+      return some ⟨found.source,found.value,.step found.lineage valid⟩
+    else return none
+
+opaque findAncestor (source : PageMap.Snapshot) (lookup : PageMap.Head → IO (Option α)) :
+    IO (Option (Ancestor source.head α)) :=
+  findAncestorAt source source.head lookup 4096 (8*1024*1024)

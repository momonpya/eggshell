+/-- Final reconciliation may split or remove fragments. Project only the
+native rows still wholly represented by its actual returned packet. -/
+def DeliveryPart.projectionComplete (part : DeliveryPart) : Bool :=
+  part.projected && match part.context with
+    | some context => part.text == context.render && part.keys == context.keys && !part.nativeOwners.isEmpty &&
+      context.fragments.all (fun fragment => 0 < fragment.original.length &&
+        fragment.first+fragment.original.length ≤ context.sourceChars)
+    | none => part.shared.any fun shared => part.text == shared.render && part.keys == shared.keys
+
+def DeliveryPart.acknowledgmentPolicy (part : DeliveryPart) : Synapses.Read → Bool :=
+  if !part.projectionComplete then fun _ => false else
+  match part.context with
+  | some context => fun read => read.binding.owner == context.owner &&
+    context.fragments.any (fun fragment =>
+      fragment.first ≤ read.binding.first && read.binding.limit ≤ fragment.first+fragment.original.length)
+  | none =>
+    let keys := part.shared.toArray.foldl (fun keys shared => shared.rows.foldl (fun keys row =>
+      row.origins.foldl (fun keys origin => keys.insert (origin.binding,origin.occurrence,
+        (⟨row.key.file,row.key.line,row.key.line⟩ : Synapses.Range))) keys) keys)
+      ({} : Std.HashSet (Synapses.Binding × Synapses.Occurrence × Synapses.Range))
+    fun read => keys.contains (read.binding,read.occurrence,read.source)
+
+def DeliveryPart.acknowledgedReads (part : DeliveryPart) : Array Synapses.Read :=
+  let accepts := part.acknowledgmentPolicy
+  part.evidence.filter fun read => read.valid && accepts read

+module
+public import tools.RetrievalGrams
+@[expose] public section
+namespace Eggshell.Research.PreparedQueryWeights
+open RetrievalResearch
+
+/-- Strict query-local data. Frequency and log1p are absent from the row loop. -/
+def prepare (wanted : List String) (frequency : String → Nat) (population : Nat) : List (String × Float) :=
+  wanted.map fun term => (term,log1p (population.toFloat / (frequency term).toFloat))
+
+@[noinline, nospecialize] def score (wanted : List (String × Float)) (contains : α → String → Bool)
+    (row : α) : Float × Float :=
+  wanted.foldl (fun scores (term,value) =>
+    if contains row term then
+      if term.startsWith "P" then (scores.1+value,scores.2) else (scores.1,scores.2+value)
+    else scores) (0.0,0.0)
+
+theorem score_exact (wanted : List String) (frequency : String → Nat) (population : Nat)
+    (contains : α → String → Bool) (row : α) :
+    score (prepare wanted frequency population) contains row =
+      wanted.foldl (fun scores term =>
+        if contains row term then
+          let value := log1p (population.toFloat / (frequency term).toFloat)
+          if term.startsWith "P" then (scores.1+value,scores.2) else (scores.1,scores.2+value)
+        else scores) (0.0,0.0) := by
+  simp only [score,prepare,List.foldl_map]
+
+@[noinline, nospecialize] def rankPrepared (wanted : List (String × Float))
+    (rows : List α) (contains : α → String → Bool) : List Nat :=
+  let scored := rows.zipIdx.filterMap fun (row,index) =>
+    let scores := score wanted contains row
+    if scores.1 > 0 || scores.2 > 0 then some (scores.1,scores.2,index) else none
+  ((scored.mergeSort fun a b => a.1 > b.1 ||
+    (a.1 == b.1 && (a.2.1 > b.2.1 || (a.2.1 == b.2.1 && a.2.2 ≤ b.2.2)))).map (·.2.2))
+
+def rankRows (query : String) (rows : List α) (contains : α → String → Bool)
+    (frequency : String → Nat) (anchors : Bool) (population : Nat := rows.length) : List Nat :=
+  let wanted := (tokens query).filter fun term => !anchors || anchor term
+  let weights := prepare wanted frequency population
+  rankPrepared weights rows contains
+
+theorem rankRows_exact (query : String) (rows : List α) (contains : α → String → Bool)
+    (frequency : String → Nat) (anchors : Bool) (population : Nat) :
+    rankRows query rows contains frequency anchors population =
+      RetrievalResearch.rankRows query rows contains frequency anchors population := by
+  simp only [rankRows,rankPrepared,RetrievalResearch.rankRows,score_exact]
+
+#print axioms score_exact
+#print axioms rankRows_exact
+end Eggshell.Research.PreparedQueryWeights

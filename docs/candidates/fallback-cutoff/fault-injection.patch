+      let fault ← IO.getEnv "EGGSHELL_RESEARCH_PHASE_FAULT"
+      if request.route == .configured then
+        if fault == some "before-ready" then
+          while !(← IO.checkCanceled) do IO.sleep 1
+          throw (IO.userError "controlled semantic timeout before readiness")
+        else if fault == some "after-ready" || fault == some "legacy-after-ready" then
+          ready
+          let now ← IO.monoMsNow
+          IO.sleep ((request.semanticCutoff.getD now)+100-now).toUInt32
+          throw (IO.userError "controlled semantic failure after cutoff")
@@ -287 +297,6 @@

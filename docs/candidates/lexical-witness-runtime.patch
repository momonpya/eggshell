+/-- The ordinary source-counter decoder, factored without changing its
+missing-value or malformed-tail behavior. -/
+def counterValue (data : Option ByteArray) : Except String Nat := do
+  let some bytes := data | return 0
+  let (value,tail) ← Wire.natural.decode bytes.toList
+  unless tail.isEmpty do throw "trailing bytes in DB counter"
+  return value
+
+/-- These are the actual retained bytes of all three original checks. A
+request-local entry cannot merely assert an ordinal or a live-owner flag. -/
+structure OwnerWitness where
+  ordinal : Nat
+  indexed : Option ByteArray
+  member : Option ByteArray
+  candidate : Option ByteArray
+  indexedExact : payloadSize indexed = .ok ordinal
+  memberExact : payloadSize member = .ok ordinal
+  candidateExact : counterValue candidate = .ok 1
+
+def OwnerWitness.check? (ordinal : Nat) (indexed member candidate : Option ByteArray) :
+    Option OwnerWitness := do
+  match indexedExact : payloadSize indexed with
+  | .error _ => none
+  | .ok original =>
+    if same : original = ordinal then
+      match memberExact : payloadSize member with
+      | .error _ => none
+      | .ok current =>
+        if sameMember : current = ordinal then
+          match candidateExact : counterValue candidate with
+          | .ok 1 => some ⟨ordinal,indexed,member,candidate,
+              by simpa only [same] using indexedExact,
+              by simpa only [sameMember] using memberExact,candidateExact⟩
+          | _ => none
+        else none
+    else none
+
+theorem OwnerWitness.original_checks (witness : OwnerWitness) :
+    payloadSize witness.indexed = .ok witness.ordinal ∧
+    payloadSize witness.member = .ok witness.ordinal ∧
+    counterValue witness.candidate = .ok 1 :=
+  ⟨witness.indexedExact,witness.memberExact,witness.candidateExact⟩
+

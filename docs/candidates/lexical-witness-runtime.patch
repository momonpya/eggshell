+def posting (reader : RetrievalResearch.Index.Reader source) (metrics : IO.Ref Metrics)
+    (receipt : Option String) (unit : String) : IO (List Nat × Nat) := do
+  postingWith reader (← IO.mkRef {}) metrics receipt unit
+
+structure Query where
+  posting : String → IO (List Nat × Nat)
+  ordinal : Nat → IO Nat
+  report : IO Unit := pure ()
+
+/-- One immutable source/index pair owns this cache. It never crosses a
+request boundary. Ranking reuses the member bytes already checked above. -/
+def query (reader : RetrievalResearch.Index.Reader source) (receipt : Option String := none) :
+    IO Query := do
+  let known ← IO.mkRef ({} : Std.HashMap Nat OwnerWitness)
+  let metrics ← IO.mkRef ({} : Metrics)
+  return {
+    posting := postingWith reader known metrics receipt
+    ordinal := fun owner => do
+      let some checked := (← known.get)[owner]? |
+        throw (IO.userError "lexical ordinal was not validated by this request")
+      source.observe (.point (key "member" owner) checked.member)
+      metrics.modify fun before => {before with ordinalHits := before.ordinalHits+1}
+      return checked.ordinal
+    report := do observe source receipt (← metrics.get) }
+

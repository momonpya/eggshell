+/-- A spelling witness locates candidate data. It does not assert that the
+answer cited that data, and therefore carries no inherited answer rank. -/
+def rankingPriority (kind priority : Nat) : Option Nat :=
+  if kind == 6 then none else some priority
+
+theorem spelling_has_no_answer_rank (priority : Nat) :
+    rankingPriority 6 priority = none := by simp [rankingPriority]
+
+theorem spelling_support_has_no_answer_rank (support : Support)
+    (spelling : support.basis = .spelling) (priority : Nat) :
+    rankingPriority (Routing.Store.kind (.supports support)) priority = none := by
+  simp [rankingPriority,Routing.Store.kind,spelling]
+
+theorem citation_retains_answer_rank (support : Support)
+    (citation : support.basis = .citation) (priority : Nat) :
+    rankingPriority (Routing.Store.kind (.supports support)) priority = some priority := by
+  simp [rankingPriority,Routing.Store.kind,citation]
+
+theorem other_reason_retains_rank (kind priority : Nat) (other : kind ≠ 6) :
+    rankingPriority kind priority = some priority := by simp [rankingPriority,other]
+

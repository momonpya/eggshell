+def sourcePlan (server : Server) (secret : String) (payload : Json) (deadline : Nat)
+    (reservedReply : IO.Ref Nat) : IO Json := do
+  let requests ← IO.ofExcept (payload.getObjValAs? (Array SourceViewBatch.Request) "sources")
+  let lease ← IO.ofExcept (payload.getObjValAs? String "lease")
+  let query ← IO.ofExcept (payload.getObjVal? "selector" >>= fromJson? (α := SharedRangeAdapter.ServiceQuery))
+  -- Keep the borrower charged while an external reply waits for its wire
+  -- reservation. The local path creates no socket reply or send queue item.
+  selectSourcePlan server secret requests lease query deadline (do
+    reserveReply server Stream.maxBytes deadline
+    reservedReply.set Stream.maxBytes)
+
+def localReadAccess (server : Server) (endpoint : Daemon.Endpoint) : SourceViewBatch.ReadAccess := {
+  pid := endpoint.pid,port := endpoint.port,generation := endpoint.generation
+  read := fun requests deadline => do
+    let some first := requests[0]? | throw (IO.userError "original batch has no read scope")
+    readSourceViews server first.access.capability requests deadline
+  release := fun requests lease => do
+    let some first := requests[0]? | throw (IO.userError "original batch release has no read scope")
+    checkBatchRequests server first.access.capability requests
+    server.palettes.release lease (SourceViewBatch.key requests)
+  select := fun requests lease selector deadline => do
+    let some first := requests[0]? | throw (IO.userError "original selection has no read scope")
+    let query ← IO.ofExcept (fromJson? (α := SharedRangeAdapter.ServiceQuery) selector)
+    selectSourcePlan server first.access.capability requests lease query deadline
+  fetch := fun requests lease wanted deadline => do
+    let some first := requests[0]? | throw (IO.userError "original fetch has no read scope")
+    readSelectedRows server first.access.capability requests lease wanted deadline }

+/-- A coordinator freezes a checked public image once for a complete read cut.
+It contains no query, usage root or borrower-owned mutable counters/bitmaps. -/
+structure Frozen where
+  private mk ::
+  image : Image
+  private pages : PageMap.PagePool
+
+def Frozen.matches (frozen : Frozen) (sources : Array PageMap.Snapshot) (scopes : Array String)
+    (inputs : Array PreparedInputs.Reference) (reference : Option OwnerViews.Reference) : Bool :=
+  acceptsKey frozen.image.key (frameKey sources scopes inputs reference)
+
+theorem Frozen.matches_exact (frozen : Frozen) (sources scopes inputs reference) :
+    frozen.matches sources scopes inputs reference = true ↔
+      frozen.image.key = frameKey sources scopes inputs reference :=
+  acceptsKey_exact _ _
+
+/-- Called by the public-view owner before dispatching request-local workers.
+The shared image has the existing catalogue's metadata and handle bounds. -/
+@[no_expose] def Pool.freeze (pool : Pool) (sources : Array PageMap.Snapshot)
+    (inputs : Array PreparedInputs.Reference) (reference : Option OwnerViews.Reference) : IO Frozen := do
+  let borrow ← pool.acquire sources inputs reference
+  let _ ← IO.ofExcept (Catalogue.check #[borrow.image])
+  return ⟨borrow.image,pool.pages⟩
+
+structure Session where
+  sources : Array PageMap.Snapshot
+  pool : Pool
+
+/-- Each worker gets its own reader catalogue, mutable bitmap overlays and
+source trace/counters. Only immutable images and the existing bounded page pool
+are shared. A changed scope, root, producer or owner order needs a new freeze. -/
+@[no_expose] def Frozen.fork (frozen : Frozen) (sources : Array PageMap.Snapshot)
+    (inputs : Array PreparedInputs.Reference) (reference : Option OwnerViews.Reference) : IO Session := do
+  unless inputs.size == sources.size && (inputs.zip sources).all (fun (input,source) =>
+      input.producer == PreparedInputs.implementation && input.source == source.head) do
+    throw (IO.userError "session reader changed its complete original boundary")
+  let scopes ← sources.mapM OwnerViews.scope
+  unless frozen.matches sources scopes inputs reference do
+    throw (IO.userError "session reader needs a different checked public image")
+  let catalogue ← IO.ofExcept (Catalogue.check #[frozen.image])
+  unless frozen.image.originals.map (fun image => (image.directory.toString,image.head)) ==
+      sources.map (fun source => (source.directory.toString,source.head)) do
+    throw (IO.userError "shared original images changed their exact source boundary")
+  let originals ← (frozen.image.originals.zip scopes).mapM fun (image,scope) => image.borrow frozen.pages scope
+  let pool : Pool := ⟨← IO.mkRef {catalogue},frozen.pages⟩
+  return ⟨originals,pool⟩
+
+/-- Captured by each actor after authorization; only public preparation enters
+the coordinator. The private usage root is carried unchanged to the borrower. -/
+structure Frame where
+  private mk ::
+  sources : Array PageMap.Snapshot
+  scopes : Array String
+  inputs : Array PreparedInputs.Reference
+  reference : Option OwnerViews.Reference
+  key : String
+  exact : key = frameKey sources scopes inputs reference
+
+@[no_expose] def Frame.capture (sources : Array PageMap.Snapshot) (inputs : Array PreparedInputs.Reference)
+    (reference : Option OwnerViews.Reference) : IO Frame := do
+  unless inputs.size == sources.size && (inputs.zip sources).all (fun (input,source) =>
+      input.producer == PreparedInputs.implementation && input.source == source.head) do
+    throw (IO.userError "search frame changed its prepared original boundary")
+  let scopes ← sources.mapM OwnerViews.scope
+  return ⟨sources,scopes,inputs,reference,frameKey sources scopes inputs reference,rfl⟩
+
+/-- A single coordinator calls this operation. Hits reuse the validated image;
+workers never concurrently mutate its catalogue or repeat its public build. -/
+@[no_expose] def Pool.forkFrame (pool : Pool) (frame : Frame) : IO Session := do
+  let frozen ← match ← pool.find frame.key with
+    | some image => pure (⟨image,pool.pages⟩ : Frozen)
+    | none => pool.freeze frame.sources frame.inputs frame.reference
+  unless frozen.image.key == frame.key do throw (IO.userError "coordinator returned a different public read cut")
+  let catalogue ← IO.ofExcept (Catalogue.check #[frozen.image])
+  unless frozen.image.originals.map (fun image => (image.directory.toString,image.head)) ==
+      frame.sources.map (fun source => (source.directory.toString,source.head)) do
+    throw (IO.userError "coordinator original image boundary differs")
+  let originals ← (frozen.image.originals.zip frame.scopes).mapM fun (image,scope) => image.borrow pool.pages scope
+  return ⟨originals,⟨← IO.mkRef {catalogue},pool.pages⟩⟩
+

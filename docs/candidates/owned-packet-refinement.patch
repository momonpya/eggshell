+/-- Enrichment replaces only an already admitted owner. It cannot admit a
+new owner, remove another owner, or exceed the same complete-packet budget. -/
+def refineOwnedPacket [DecidableEq β] (chars bytes : Nat)
+    (cost : List α → Nat × Nat) (owner : α → β)
+    (accepted : {items : List α // (cost items).1 ≤ chars ∧ (cost items).2 ≤ bytes}) :
+    List α → {items : List α // (cost items).1 ≤ chars ∧ (cost items).2 ≤ bytes}
+  | [] => accepted
+  | offered :: rest =>
+      let next := accepted.val.map fun prior =>
+        if owner prior = owner offered then offered else prior
+      if fits : (cost next).1 ≤ chars ∧ (cost next).2 ≤ bytes then
+        refineOwnedPacket chars bytes cost owner ⟨next, fits⟩ rest
+      else refineOwnedPacket chars bytes cost owner accepted rest
+
+theorem owned_replacement_preserves_domain [DecidableEq β]
+    (owner : α → β) (items : List α) (offered : α) :
+    (items.map (fun prior => if owner prior = owner offered then offered else prior)).map owner =
+      items.map owner := by
+  simp only [List.map_map]
+  apply List.map_congr_left
+  intro prior member
+  dsimp only [Function.comp_def]
+  split <;> simp_all
+
+theorem owned_enrichment_preserves_domain [DecidableEq β]
+    (chars bytes : Nat) (cost : List α → Nat × Nat) (owner : α → β)
+    (accepted : {items : List α // (cost items).1 ≤ chars ∧ (cost items).2 ≤ bytes})
+    (offers : List α) :
+    (refineOwnedPacket chars bytes cost owner accepted offers).val.map owner =
+      accepted.val.map owner := by
+  induction offers generalizing accepted with
+  | nil => rfl
+  | cons offered rest ih =>
+      simp only [refineOwnedPacket]
+      split
+      · exact (ih _).trans (owned_replacement_preserves_domain owner accepted.val offered)
+      · exact ih accepted


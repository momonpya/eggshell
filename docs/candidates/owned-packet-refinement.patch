+++ b/tools/OwnedPacketTests.lean
@@ -0,0 +1,28 @@
+import Eggshell.Handoff
+open Eggshell Eggshell.Plugin
+private def require (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+private def slice (owner : Option Value) (text : String) : TransportSlice :=
+  {owner, text, keys := [], members := [], visibleKeys := []}
+private def cost (items : List TransportSlice) : Nat × Nat :=
+  let text := "frame:" ++ "|".intercalate (items.map (·.text))
+  (text.length,text.utf8ByteSize)
+def main : IO Unit := do
+  let a := Value.text "first original owner"
+  let b := Value.text "other original owner"
+  let initial := [slice (some a) "cue",slice (some b) "other"]
+  let accepted : {items : List TransportSlice // (cost items).1 ≤ 50 ∧ (cost items).2 ≤ 50} :=
+    ⟨initial,by decide⟩
+  let result := refineOwnedPacket 50 50 cost (·.owner) accepted
+    [slice (some a) (String.ofList (List.replicate 100 'x')),
+     slice none "unowned", slice (some b) "other original data"]
+  require (result.val.map (·.owner) == initial.map (·.owner)) "An enrichment changed original owners"
+  require ((result.val.head?.map (·.text)) == some "cue") "An oversized original evicted another cue"
+  require ((result.val[1]?.map (·.text)) == some "other original data") "A later fitting original was lost"
+  require (result.val.all (fun item => item.members.isEmpty && item.visibleKeys.isEmpty))
+    "Advisory data acquired control"
+  let bytes : {items : List TransportSlice // (cost items).1 ≤ 20 ∧ (cost items).2 ≤ 20} :=
+    ⟨[slice (some a) "A",slice (some b) "B"],by decide⟩
+  let result := refineOwnedPacket 20 20 cost (·.owner) bytes [slice (some a) "あああああ"]
+  require (result.val.map (·.text) == ["A","B"]) "UTF-8 overflow passed a character-only bound"
+  IO.println "owned packet: original Value ownership, retained admitted data, exact bounds and no control passed"

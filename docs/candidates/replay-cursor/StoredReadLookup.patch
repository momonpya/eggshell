+/-- A caller-owned exhaustion signal distinguishes cooperative suspension
+from an ordinary IO/validation failure. It is never inferred from error text. -/
+structure Budget where
+  exhausted : IO.Ref Bool
+
+def Budget.new : IO Budget := return ⟨← IO.mkRef false⟩
+
+def checkBudget (budget : Option Budget) (deadline : Nat) (message : String) : IO Unit := do
+  if (← IO.monoMsNow) ≥ deadline then
+    if let some budget := budget then budget.exhausted.set true
+    throw (IO.userError message)
+

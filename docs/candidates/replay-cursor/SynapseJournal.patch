+/-- A producer group is committed to the cursor only after its complete
+validation. Budget exhaustion retries that group, not the completed prefix. -/
+def nativeFeedback (source : PageMap.Snapshot) (starts : Starts) (facts : Array Fact)
+    (graph : Graph) (deadline : Nat) (hint : Option Index.Reader := none)
+    (cache : Option StoredReadLookup.Cache := none) (catalogs : Option ReadCatalog.Pool := none)
+    (budget : Option StoredReadLookup.Budget := none)
+    (saved : Option (IO.Ref (Option FeedbackProgress)) := none) : IO NativeFeedback := do
+  let progress ← match ← saved.bindM (·.get) with
+    | some progress => pure progress
+    | none => pure (prepareFeedback source starts facts graph hint)
+  unless progress.source == source.head && progress.directory == source.directory.toString &&
+      progress.starts == starts.toArray && progress.input == facts && progress.initial == graph.snapshot &&
+      progress.index == hint.map (·.index.head) && progress.next ≤ progress.groups.size do
+    throw (IO.userError "native feedback cursor input changed")
+  let mut progress := progress
+  if let some saved := saved then saved.set (some progress)
+  for ordinal in [progress.next:progress.groups.size] do
+    let (producer,uses) := progress.groups[ordinal]!
+    let result ← feedbackGroup source starts producer uses progress.result deadline hint cache catalogs budget
+    progress := {progress with next := ordinal+1,result}
+    if let some saved := saved then saved.set (some progress)
+  return progress.result
+

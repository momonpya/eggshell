+/-- Only the explicit exhaustion signal suspends. Corruption, changed inputs
+and ordinary IO failures propagate to the caller. No partial result publishes. -/
+def resumeReplay (cursor : ReplayCursor) (deadline : Nat) : IO (Option Replay) := do
+  let budget ← StoredReadLookup.Budget.new
+  try return some (← runCursor cursor deadline budget)
+  catch error =>
+    if ← budget.exhausted.get then return none
+    throw error
+
+def replay (source : PageMap.Snapshot) (values : Array Entry) (deadline : Nat)
+    (preparedHint : Option Index.Reader := none) (readCache : Option StoredReadLookup.Cache := none)
+    (catalogPool : Option ReadCatalog.Pool := none) : IO Replay := do
+  let cursor ← beginReplay source values preparedHint readCache catalogPool
+  let some result ← resumeReplay cursor deadline | throw (IO.userError "synaptic replay deadline")
+  return result
+

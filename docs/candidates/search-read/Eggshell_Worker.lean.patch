+/-- Validation and callbacks run between joined reads. A failure here owns
+retirement; a failed/expired read is retired by awaitSearchFrame instead. -/
+def checkedSearchStep (slot : Slot) (child : Child) (action : IO α) : IO α := do
+  try action
+  catch error =>
+    retire slot child
+    throw error
+
+/-- Only this owner advances the immutable phase. The reader publishes one
+frame result and never mutates the caller's deadline. -/
+def readSearchReply (slot : Slot) (child : Child) (payload : Json) (policy : SearchPolicy)
+    (deadline : Nat) : IO (Option Json) := do
+  let some (frame,arrived) ← awaitSearchFrame slot child deadline (do
+    child.stdin.putStr (payload.compress ++ "\n")
+    child.stdin.flush
+    readSearchFrame child.stdout) | return none
+  match ← checkedSearchStep slot child (IO.ofExcept
+      (Research.SearchReadCut.first policy.identity policy.finishReady deadline arrived frame)) with
+  | .finished value => return some (toJson value)
+  | .final cutoff =>
+    checkedSearchStep slot child (policy.onReady arrived)
+    unless ← checkedSearchStep slot child (return decide ((← IO.monoMsNow) < cutoff)) do
+      retire slot child
+      return none
+    let some (reply,arrived) ← awaitSearchFrame slot child cutoff (readSearchFrame child.stdout) | return none
+    return some (toJson (← checkedSearchStep slot child (IO.ofExcept
+      (Research.SearchReadCut.final policy.identity cutoff arrived reply))))

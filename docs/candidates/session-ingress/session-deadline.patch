+def withLockWithin (path : System.FilePath) (waitMs : Nat) (action : IO α) : IO α :=
+  withLockAcquisition path (fun handle => acquireLock handle path (waitMs / 5 + 1)) action
+
+/-- A native request spends its existing absolute deadline while waiting for
+metadata. A busy sibling must not turn a 100ms admission cutoff into lost
+ingress. An expired request cannot start its protected action. -/
+partial def acquireLockUntil (handle : IO.FS.Handle) (path : System.FilePath)
+    (deadline : Nat) : IO Unit := do
+  let now ← IO.monoMsNow
+  unless now < deadline do throw (IO.userError s!"timed out waiting for {lockPath path}")
+  if ← handle.tryLock then return
+  IO.sleep (UInt32.ofNat (min 5 (deadline-now)))
+  acquireLockUntil handle path deadline
+
+def withLockUntil (path : System.FilePath) (deadline : Nat) (action : IO α) : IO α :=
+  withLockAcquisition path (fun handle => acquireLockUntil handle path deadline) action
+
 def withLock (path : System.FilePath) (action : IO α) : IO α :=
   withLockWithin path 1000 action
 

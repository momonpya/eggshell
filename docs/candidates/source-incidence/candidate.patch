diff --git a/Eggshell/OrderedIncidence.lean b/Eggshell/OrderedIncidence.lean
new file mode 100644
index 00000000..923fa83f
--- /dev/null
+++ b/Eggshell/OrderedIncidence.lean
@@ -0,0 +1,87 @@
+module
+public import Eggshell.HashDistinct
+
+@[expose] public section
+namespace Eggshell.OrderedIncidence
+
+variable {κ α : Type} [BEq κ] [LawfulBEq κ] [Hashable κ]
+
+/-- One original row enters each incident key once. Keys are full Values,
+not display digests; neither collisions nor repeated endpoints duplicate rows. -/
+def addKeys (table : Std.HashMap κ (List α)) (row : α) (keys : List κ) :
+    Std.HashMap κ (List α) :=
+  keys.foldl (fun known key => known.insert key (row :: known.getD key [])) table
+
+theorem addKeys_lookup (table : Std.HashMap κ (List α)) (row : α)
+    (keys : List κ) (unique : keys.Nodup) (query : κ) :
+    (addKeys table row keys).getD query [] =
+      if query ∈ keys then row :: table.getD query [] else table.getD query [] := by
+  induction keys generalizing table with
+  | nil => simp [addKeys]
+  | cons head tail ih =>
+    have distinct := List.nodup_cons.mp unique
+    simp only [addKeys, List.foldl_cons]
+    rw [show (tail.foldl (fun known key => known.insert key (row :: known.getD key []))
+      (table.insert head (row :: table.getD head []))).getD query [] =
+      if query ∈ tail then row :: (table.insert head (row :: table.getD head [])).getD query []
+      else (table.insert head (row :: table.getD head [])).getD query [] from ih _ distinct.2]
+    by_cases same : head = query
+    · subst query
+      simp [distinct.1]
+    · simp [Std.HashMap.getD_insert, same, Ne.symm same, List.mem_cons]
+
+def add (keys : α → List κ) (table : Std.HashMap κ (List α)) (row : α) :
+    Std.HashMap κ (List α) := addKeys table row (hashDistinct (keys row))
+
+theorem add_lookup (keys : α → List κ) (table : Std.HashMap κ (List α))
+    (row : α) (query : κ) :
+    (add keys table row).getD query [] =
+      if query ∈ keys row then row :: table.getD query [] else table.getD query [] := by
+  rw [add, addKeys_lookup _ _ _ (HashDistinct.nodup _) query]
+  simp only [HashDistinct.mem]
+
+theorem fold_lookup (keys : α → List κ) (rows : List α)
+    (table : Std.HashMap κ (List α)) (query : κ) :
+    (rows.foldl (add keys) table).getD query [] =
+      (rows.filter (fun row => decide (query ∈ keys row))).reverse ++ table.getD query [] := by
+  induction rows generalizing table with
+  | nil => simp
+  | cons head tail ih =>
+    simp only [List.foldl_cons, ih, add_lookup]
+    by_cases present : query ∈ keys head <;>
+      simp [present, List.reverse_cons, List.append_assoc]
+
+/-- The certificate includes order and multiplicity of original rows, not
+just reachability. Independent original owners remain independent rows. -/
+structure Index (keys : α → List κ) (rows : List α) where
+  table : Std.HashMap κ (List α)
+  exact : ∀ query, (table.getD query []).reverse = rows.filter (fun row => decide (query ∈ keys row))
+
+def build (keys : α → List κ) (rows : List α) : Index keys rows :=
+  ⟨rows.foldl (add keys) {}, by
+    intro query
+    have same := fold_lookup keys rows {} query
+    simpa using congrArg List.reverse same⟩
+
+def Index.lookup {keys : α → List κ} {rows : List α} (index : Index keys rows) (query : κ) : List α :=
+  (index.table.getD query []).reverse
+
+theorem Index.lookup_exact {keys : α → List κ} {rows : List α} (index : Index keys rows) (query : κ) :
+    index.lookup query = rows.filter (fun row => decide (query ∈ keys row)) := index.exact query
+
+/-- Incident lookup can replace a complete scan when nonincident rows emit
+nothing. This preserves every emitted row, its position and its multiplicity. -/
+theorem Index.flatMap_exact {β : Type} {keys : α → List κ} {rows : List α}
+    (index : Index keys rows) (query : κ) (emit : α → List β)
+    (inactive : ∀ row, query ∉ keys row → emit row = []) :
+    (index.lookup query).flatMap emit = rows.flatMap emit := by
+  rw [index.lookup_exact]
+  clear index
+  induction rows with
+  | nil => rfl
+  | cons head tail ih =>
+    by_cases present : query ∈ keys head
+    · simpa [present] using congrArg (emit head ++ ·) ih
+    · simpa [present, inactive head present] using ih
+
+end Eggshell.OrderedIncidence

+structure Coordinates where
+  rows : Nat
+  maximum : Nat
+  complete : Bool
+  producer : String
+  deriving ToJson,FromJson
+
+def coordinateBase (subject : Subject) := "memo:source-read-view:coordinates:" ++ Index.contentKey subject
+def coordinateMeta (subject : Subject) := coordinateBase subject ++ ":complete"
+def coordinateCell (subject : Subject) (power bucket : Nat) :=
+  coordinateBase subject ++ ":cell:" ++ toString power ++ ":" ++ toString bucket
+
+def existingRowsAt (source : Snapshot) (range : PageMap.KeyRange) (ref : PageMap.Ref) : IO Bool := do
+  unless range.overlaps ref do return false
+  let loaded ← source.load ref
+  match loaded.page with
+  | .leaf rows => return (range.select rows).any (·.2.isSome)
+  | .branch children =>
+    for child in children do
+      if range.overlaps child then
+        if _smaller : child.height < ref.height then
+          if ← existingRowsAt source range child then return true
+        else throw (IO.userError "source read existence probe did not descend")
+    return false
+termination_by ref.height
+
+def existingSubject (source : Snapshot) (subject : Subject) : IO Bool :=
+  match source.head.root with
+  | none => pure false
+  | some root => existingRowsAt source ⟨subjectBase subject ++ ":",subjectBase subject ++ ";"⟩ root
+

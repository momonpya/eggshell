+/-- Exact overlap lookup. Wide requests use the complete subject walk when
+there are fewer stored rows than coordinate probes. An older partial index
+never hides original rows which have not been compiled into coordinates. -/
+def Reader.lookupRanges (reader : Reader source) (subject : Subject) (requested : Array Range)
+    (limit deadline : Nat) : IO Result := do
+  unless subject.valid && requested.all Range.valid do throw (IO.userError "invalid source read interval request")
+  let requested := requested.filter (·.subject == subject)
+  if requested.isEmpty then return {}
+  let full := do
+    let found ← reader.lookup subject limit deadline
+    pure {found with rows := found.rows.filter (fun row => ReadRangeIndex.wanted requested row.source)}
+  let some raw ← source.get (coordinateMeta subject) | return ← full
+  let metadata ← ObservedRecords.decode (α := Coordinates) raw
+  unless digest metadata.producer && metadata.rows > 0 do throw (IO.userError "invalid source coordinate extent")
+  if !metadata.complete || ReadRangeIndex.estimate requested metadata.maximum ≥ metadata.rows then return ← full
+  let some root := source.head.root | throw (IO.userError "source coordinate directory lost its source root")
+  let mut result : ScanResult := {}
+  let mut probes := 0
+  for (power,bucket) in ReadRangeIndex.probes requested metadata.maximum do
+    if result.inspected ≥ limit || (← IO.monoMsNow) ≥ deadline then
+      result := {result with complete := false}; break
+    let base := coordinateCell subject power bucket
+    result ← reader.scan subject ⟨base ++ ":",base ++ ";"⟩ root limit deadline result (some (power,bucket))
+    probes := probes+1
+    if !result.complete then break
+  let mut seen : Std.HashSet String := {}
+  let ordered := result.rows.qsort (fun a b => a.1 < b.1)
+  let mut rows := #[]
+  for (digest,row) in ordered do
+    if seen.contains digest || !ReadRangeIndex.wanted requested row.source then continue
+    seen := seen.insert digest
+    rows := rows.push row
+  return {
+    rows,pages := result.pages,inspected := result.inspected
+    complete := result.complete,probes,indexed := true}
+

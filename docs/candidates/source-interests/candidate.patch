+module
+public import Eggshell.DB.PageMap
+
+@[expose] public section
+namespace Eggshell.InputBoundary
+open Lean DB
+
+/-- Private request metadata, independent of shared-index readiness. -/
+structure Boundary where
+  producer : String
+  originals : List (Option PageMap.Head)
+  model : String
+  encoder : String
+  usage : Array (Option PageMap.Head)
+  deriving ToJson, FromJson
+
+def Boundary.boundTo (boundary : Boundary) (producer : String)
+    (heads : List (Option PageMap.Head)) (model encoder : String) : Bool :=
+  boundary.producer == producer && decide (boundary.originals = heads) &&
+    boundary.model == model && boundary.encoder == encoder &&
+    boundary.usage.size == (heads.filterMap id).length
+
+/-- The same predicate serves concrete rooted inputs without importing their
+payload/index implementations into the structural contract or its proofs. -/
+def frameBoundTo (producer actual : String) (originals heads : List (Option PageMap.Head))
+    (inputs : Array α) (source : α → PageMap.Head) (contract : α → Bool) : Bool :=
+  actual == producer && decide (originals = heads) &&
+    decide (inputs.map source = (heads.filterMap id).toArray) && inputs.all contract
+
+def Boundary.accepts (boundary : Boundary) (producer actual : String)
+    (originals : List (Option PageMap.Head)) (inputs : Array α)
+    (source : α → PageMap.Head) (contract : α → Bool) (usage : α → Option PageMap.Head) : Bool :=
+  boundary.boundTo producer originals boundary.model boundary.encoder &&
+    frameBoundTo producer actual originals boundary.originals inputs source contract &&
+    decide (inputs.map usage = boundary.usage)
+
+theorem boundary_original_inventory (boundary : Boundary) (producer : String)
+    (heads : List (Option PageMap.Head)) (model encoder : String)
+    (accepted : boundary.boundTo producer heads model encoder = true) : boundary.originals = heads := by
+  simp only [Boundary.boundTo,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.1.1.1.2
+
+theorem frame_original_inventory (producer actual : String) (originals heads : List (Option PageMap.Head))
+    (inputs : Array α) (source : α → PageMap.Head) (contract : α → Bool)
+    (accepted : frameBoundTo producer actual originals heads inputs source contract = true) : originals = heads := by
+  simp only [frameBoundTo,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.1.1.2
+
+theorem frame_input_inventory (producer actual : String) (originals heads : List (Option PageMap.Head))
+    (inputs : Array α) (source : α → PageMap.Head) (contract : α → Bool)
+    (accepted : frameBoundTo producer actual originals heads inputs source contract = true) :
+    inputs.map source = (heads.filterMap id).toArray := by
+  simp only [frameBoundTo,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.1.2
+
+theorem accepted_originals (boundary : Boundary) (producer actual : String)
+    (originals : List (Option PageMap.Head)) (inputs : Array α)
+    (source : α → PageMap.Head) (contract : α → Bool) (usage : α → Option PageMap.Head)
+    (accepted : boundary.accepts producer actual originals inputs source contract usage = true) :
+    originals = boundary.originals := by
+  simp only [Boundary.accepts,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact frame_original_inventory _ _ _ _ _ _ _ accepted.1.2
+
+theorem accepted_private_roots (boundary : Boundary) (producer actual : String)
+    (originals : List (Option PageMap.Head)) (inputs : Array α)
+    (source : α → PageMap.Head) (contract : α → Bool) (usage : α → Option PageMap.Head)
+    (accepted : boundary.accepts producer actual originals inputs source contract usage = true) :
+    inputs.map usage = boundary.usage := by
+  simp only [Boundary.accepts,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.2
+
+theorem accepted_complete_inputs (boundary : Boundary) (producer actual : String)
+    (originals : List (Option PageMap.Head)) (inputs : Array α)
+    (source : α → PageMap.Head) (contract : α → Bool) (usage : α → Option PageMap.Head)
+    (accepted : boundary.accepts producer actual originals inputs source contract usage = true) :
+    inputs.map source = (boundary.originals.filterMap id).toArray := by
+  simp only [Boundary.accepts,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact frame_input_inventory _ _ _ _ _ _ _ accepted.1.2
+
+theorem changed_private_roots_rejected (boundary : Boundary) (producer actual : String)
+    (originals : List (Option PageMap.Head)) (inputs : Array α)
+    (source : α → PageMap.Head) (contract : α → Bool) (usage : α → Option PageMap.Head)
+    (changed : inputs.map usage ≠ boundary.usage) :
+    boundary.accepts producer actual originals inputs source contract usage = false := by
+  simp [Boundary.accepts,changed]
+
+end Eggshell.InputBoundary

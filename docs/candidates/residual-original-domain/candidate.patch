+/-- Aliases share their payload; they do not erase the rest of an observation. -/
+def originalResiduals (length : Nat) (known : List DeliveryInterval) : List DeliveryInterval :=
+  if nonempty : 0 < length then (⟨0,length,nonempty⟩ : DeliveryInterval).subtractAll known else []
+
+theorem original_residuals_exact (length position : Nat) (known : List DeliveryInterval) :
+    (∃ part ∈ originalResiduals length known,part.covers position) ↔
+      position < length ∧ ∀ prior ∈ known,¬prior.covers position := by
+  unfold originalResiduals
+  split
+  · simpa [DeliveryInterval.covers] using
+      (DeliveryInterval.subtractAll_covers ⟨0,length,by assumption⟩ known position)
+  · simp_all
 

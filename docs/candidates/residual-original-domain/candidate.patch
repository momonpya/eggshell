+/-- Only the complement of file aliases uses the original-output envelope.
+The complement is complete and bounded; neither a shell decoder nor a gold
+range decides which original characters remain available. -/
+def prepareResiduals (familyIndex : Nat) (family : Family) : List UnitPlan := Id.run do
+  let some source := Matcher.atomText? family.owner.outcome | return []
+  let rawFamily := {family with cached := #[],template := {family.template with shared := none}}
+  let some envelope := rawFamily.contextualOutputs.template.context | return []
+  let owner := relationKey family.owner.relation
+  let known := (CoverageIndex.prepare (cachedBindings owner family.cached)).intervals
+  let original := IndexedCharacters.make source
+  let mut units := []
+  for part in originalResiduals source.length known do
+    if within : part.stop ≤ source.length then
+      let span : ContextSpan source := ⟨part.start,part.stop,part.ordered,within⟩
+      for range in span.ranges do
+        let fragment := originalRecordFragment original range false
+        let ranges := [(range.start,range.stop)]
+        let context := {envelope with fragments := [fragment],cues := ranges}
+        let slice : TransportSlice := {family.template with
+          shared := none,context := some context
+          keys := context.keys,text := context.render,members := [],visibleKeys := []}
+        units := units ++ [{family := familyIndex,slice,ranges}]
+  return units
+

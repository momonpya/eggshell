+def cuePieces (scale : Nat) (families : List Family)
+    (units : List UnitPlan) : List CuePiece :=
+  families.zipIdx.flatMap fun (family,familyIndex) =>
+    if !family.cached.isEmpty then
+      let raw := units.filter fun unit => unit.family == familyIndex && unit.slice.shared.isNone
+      cachedCuePieces scale familyIndex family ++
+        (positionedCuePieces scale familyIndex family raw).filter fun piece =>
+          raw.any (fun unit => unit.coversPrepared piece.first piece.last)
+    else if family.template.context.isNone then
+      match Matcher.atomText? family.owner.outcome with
+      | some source => if source.isEmpty then [] else
+          [{family := familyIndex,first := 0,last := source.length,weight := scale/(61+familyIndex)}]
+      | none => []
+    else positionedCuePieces scale familyIndex family units

+  by_cases same : index = anchor <;> simp [Slot.trim,same]
+
+theorem Slot.trim_retiring (anchor token index owner : Nat) (resource : α) :
+    (Slot.retiring owner resource).trim anchor token index = .retiring owner resource := by
+  by_cases same : index = anchor <;> simp [Slot.trim,same]

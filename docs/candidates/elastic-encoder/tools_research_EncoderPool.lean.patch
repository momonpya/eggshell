+def Pool.queueLeavePlan (pool : Pool α) : IO (Array (Ticket α × α)) :=
+  pool.state.atomically do
+    let state ← get
+    let (state,spare) := {state with waiting := state.waiting-1}.trimIdle
+    set state
+    return spare

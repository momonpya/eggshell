+module
+
+public import Eggshell.SourceDelta
+
+@[expose] public section
+namespace Eggshell.PublicationHistory
+open DB
+
+/-- The specification of the owner-local append-only head index. The live
+head is not stored inside itself. An append adds exactly its previous head. -/
+inductive Trace : PageMap.Head → Type where
+  | boot (head : PageMap.Head) : Trace head
+  | append {before after} : Trace before → SourceDelta.linked before after = true → Trace after
+
+def Trace.previous : Trace current → List PageMap.Head
+  | .boot _ => []
+  | @Trace.append before _ history _ => before :: history.previous
+
+def Trace.lookup : Trace current → Nat → Option PageMap.Head
+  | .boot _, _ => none
+  | @Trace.append before _ history _, revision =>
+      if revision = before.revision then some before else history.lookup revision
+
+theorem Trace.previous_older (history : Trace current) (head : PageMap.Head)
+    (present : head ∈ history.previous) : head.revision < current.revision := by
+  induction history with
+  | boot => simp [previous] at present
+  | @append before after history link ih =>
+    simp only [previous,List.mem_cons] at present
+    have advance := link
+    simp only [SourceDelta.linked,Bool.and_eq_true,beq_iff_eq,decide_eq_true_eq] at advance
+    rcases present with same | present
+    · subst head; omega
+    · have earlier := ih present; omega
+
+theorem Trace.previous_canonical (history : Trace current) (head : PageMap.Head)
+    (present : head ∈ history.previous) : SourceDelta.Lineage head current := by
+  induction history with
+  | boot => simp [previous] at present
+  | @append before after history link ih =>
+    simp only [previous,List.mem_cons] at present
+    rcases present with same | present
+    · subst head; exact .step (.same before) link
+    · exact .step (ih present) link
+
+theorem Trace.lookup_complete (history : Trace current) (head : PageMap.Head)
+    (present : head ∈ history.previous) : history.lookup head.revision = some head := by
+  induction history with
+  | boot => simp [previous] at present
+  | @append before after history link ih =>
+    simp only [previous,List.mem_cons] at present
+    rcases present with same | present
+    · subst head; simp [lookup]
+    · have earlier := history.previous_older head present
+      have different : head.revision ≠ before.revision := by omega
+      simp only [lookup,if_neg different]
+      exact ih present
+
+theorem Trace.lookup_previous (history : Trace current) (revision : Nat) (head : PageMap.Head)
+    (found : history.lookup revision = some head) : head ∈ history.previous := by
+  induction history with
+  | boot => simp [lookup] at found
+  | @append before after history link ih =>
+    simp only [lookup] at found
+    split at found
+    · cases found; simp [previous]
+    · exact List.mem_cons_of_mem before (ih found)
+
+theorem Trace.lookup_canonical (history : Trace current) (revision : Nat) (head : PageMap.Head)
+    (found : history.lookup revision = some head) : SourceDelta.Lineage head current :=
+  history.previous_canonical head (history.lookup_previous revision head found)
+
+/-- A point table produced by the append rule loses no earlier publication
+and nominates no head outside the canonical trace. Decoding and the atomic
+PageMap writer still have their separate runtime refinement obligations. -/
+theorem Trace.index_exact (history : Trace current) (head : PageMap.Head) :
+    head ∈ history.previous ↔ history.lookup head.revision = some head :=
+  ⟨history.lookup_complete head,history.lookup_previous head.revision head⟩
+
+end Eggshell.PublicationHistory

+/-- Each edit is routed once. Buckets retain the exact reference filter order,
+including empty buckets and malformed/unsorted directory inputs. No extra
+ordering assumption or recommended-candidate bound enters storage writes. -/
+structure EditRouting (refs : List Ref) (edits : List Row) where
+  buckets : Std.HashMap Nat (List Row)
+  exact : ∀ index, (buckets.getD index []).reverse = edits.filter (routesTo refs index)
+
+def routeEdits (refs : List Ref) (edits : List Row) : EditRouting refs edits :=
+  ⟨edits.foldl (routeEdit refs) {},by
+    intro index
+    have exact := routeEdits_lookup refs edits {} index
+    simpa using congrArg List.reverse exact⟩
+
+def EditRouting.selected (routing : EditRouting refs edits) (index : Nat) : List Row :=
+  (routing.buckets.getD index []).reverse
+
+theorem EditRouting.selected_exact (routing : EditRouting refs edits) (index : Nat) :
+    routing.selected index = edits.filter (fun edit => (route refs edit.1).map Prod.fst == some index) :=
+  routing.exact index
+

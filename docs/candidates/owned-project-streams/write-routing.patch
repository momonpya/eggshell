+
+def routesTo (refs : List Ref) (index : Nat) (edit : Row) : Bool :=
+  (route refs edit.1).map Prod.fst == some index
+
+def routeEdit (refs : List Ref) (buckets : Std.HashMap Nat (List Row)) (edit : Row) :
+    Std.HashMap Nat (List Row) :=
+  match route refs edit.1 with
+  | none => buckets
+  | some (index,_) => buckets.insert index (edit :: buckets.getD index [])
+
+theorem routeEdit_lookup (refs : List Ref) (buckets : Std.HashMap Nat (List Row))
+    (edit : Row) (index : Nat) :
+    (routeEdit refs buckets edit).getD index [] =
+      if routesTo refs index edit then edit :: buckets.getD index [] else buckets.getD index [] := by
+  cases chosen : route refs edit.1 with
+  | none => simp [routeEdit,routesTo,chosen]
+  | some selected =>
+    obtain ⟨selected,ref⟩ := selected
+    by_cases same : selected = index
+    · subst selected; simp [routeEdit,routesTo,chosen]
+    · simp [routeEdit,routesTo,chosen,Std.HashMap.getD_insert,same]
+
+theorem routeEdits_lookup (refs : List Ref) (edits : List Row)
+    (buckets : Std.HashMap Nat (List Row)) (index : Nat) :
+    (edits.foldl (routeEdit refs) buckets).getD index [] =
+      (edits.filter (routesTo refs index)).reverse ++ buckets.getD index [] := by
+  induction edits generalizing buckets with
+  | nil => simp
+  | cons edit rest ih =>
+    simp only [List.foldl_cons]
+    rw [ih,routeEdit_lookup]
+    cases chosen : routesTo refs index edit <;>
+      simp [chosen,List.reverse_cons,List.append_assoc]

+/-- One checked configuration/read boundary for one maintenance pass. This is
+not retained across turns and contains no additional writer grant. -/
+structure MaintenanceScope where
+  pending : Option PendingTurn
+  context : Option ProjectContext.Context
+  sources : Option (Array String)
+
+def MaintenanceScope.canPrepare (scope : MaintenanceScope) (owner : DB.Sidecar.Owner) : Bool :=
+  match scope.pending with
+  | none => true
+  | some pending => scope.context.any (·.canPrepare owner) || pending.write.any (fun path =>
+      (System.FilePath.mk path).normalize == (System.FilePath.mk owner.directory).normalize)
+
+theorem MaintenanceScope.current_grant (scope : MaintenanceScope) (pending : PendingTurn)
+    (present : scope.pending = some pending) (owner : DB.Sidecar.Owner) :
+    scope.canPrepare owner = (scope.context.any (·.canPrepare owner) || pending.write.any (fun path =>
+      (System.FilePath.mk path).normalize == (System.FilePath.mk owner.directory).normalize)) := by
+  simp only [canPrepare,present]
+
+theorem MaintenanceScope.standalone_recovery (scope : MaintenanceScope)
+    (absent : scope.pending = none) (owner : DB.Sidecar.Owner) : scope.canPrepare owner = true := by
+  simp only [canPrepare,absent]
+
+def MaintenanceScope.capture (session : String) (deadline : Nat) : IO MaintenanceScope := do
+  let files ← sessionFiles session
+  let pending ← readPendingBase? files
+  let some current := pending | return ⟨none,none,none⟩
+  let context ← ProjectContext.open? current deadline
+  if let some checked := context then
+    return ⟨pending,context,some (checked.reads.sources.map (·.head.identity))⟩
+  let mut sources := #[]
+  for path in (current.read++current.write.toList).eraseDups do
+    if let some source ← DB.PageMap.open? (.mk path) then sources := sources.push source.head.identity
+  return ⟨pending,context,some sources⟩
+
+def drainIndexTarget (scope : MaintenanceScope) (deadline : Nat)

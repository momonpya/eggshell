+/-- Keep the finite rows of one evidence item together. Scalar row positions
+are needed by the renderer, but flattening them must not erase that a citation
+or a usage observation recommends a complete interval. -/
+def Plan.groups (plan : Plan) : List (Value × List (Nat × List (Nat × Nat))) :=
+  plan.owners.toList.map fun owner =>
+    let identities := (owner.located.toList.map (·.offer.identity)).eraseDups
+    (owner.owner.relation, identities.filterMap fun identity => do
+      let locations := owner.located.toList.filter (·.offer.identity == identity)
+      let first ← locations.head?
+      pure (first.offer.priority, (locations.map fun location =>
+        (location.row.binding.first,location.row.binding.limit)).eraseDups))
+
 /-- Stored original rows are the only source of transport coordinates.
 Neither a graph hint nor its priority may invent a range or an owner. -/

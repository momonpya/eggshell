+def idleIntervention (root engine : System.FilePath) (mode : String) : IO Unit := do
+  let began ← IO.monoMsNow
+  let deadline := began+10000
+  let mut samples := #[]
+  repeat
+    let stats ← command engine #["publication-control","stats"]
+    check (stats.exitCode == 0) "diagnostic idle stats unavailable"
+    let value ← IO.ofExcept (Json.parse stats.stdout)
+    samples := samples.push (Json.mkObj [("elapsedMs",toJson ((← IO.monoMsNow)-began)),("stats",value)])
+    if Eggshell.Research.WorkQuiescence.idle value then break
+    if (← IO.monoMsNow) ≥ deadline then
+      save (root/("idle-"++mode++".json")) (toJson samples)
+      throw (IO.userError "background work never reached the diagnostic idle cut")
+    IO.sleep 5
+  save (root/("idle-"++mode++".json")) (toJson samples)
+  let result ← command engine #["retention-probe",mode]
+  check (result.exitCode == 0) ("single idle intervention failed: "++result.stderr)
+  let value ← IO.ofExcept (Json.parse result.stdout)
+  check (Eggshell.Research.WorkQuiescence.idle (value.getObjValD "beforeStats") &&
+    Eggshell.Research.WorkQuiescence.idle (value.getObjValD "afterStats")) "intervention raced background work"
+  save (root/("retention-"++mode++".json")) value
+

+/-- The saved basis is written atomically with readiness, after all batches.
+An unfinished workspace cannot supply the assumptions of a sparse update. -/
+def basis? (index : Snapshot) (name : String := "basis") : IO (Option DB.PageMap.Head) := do
+  let some bytes ← index.get name | return none
+  unless bytes.size ≤ 16384 do throw (IO.userError "oversized lexical source basis")
+  let some text := String.fromUTF8? bytes | throw (IO.userError "invalid lexical source basis")
+  some <$> IO.ofExcept (Json.parse text >>= fromJson?)
+
+def checkedOwner (index : Snapshot) (owner : Nat) (expected : Option Nat) : IO Unit := do
+  let actual ← (← index.get (key "owner" owner)).mapM fun bytes =>
+    IO.ofExcept (payloadSize (some bytes))
+  unless actual == expected do throw (IO.userError "complete lexical workspace disagrees with its source membership")
+
+/-- Point reads only. The verified publication delta supplies every possibly
+changed owner; source Values and their token sets are immutable across ordinals. -/
+def deltaPlan (source index : Snapshot) : IO (Option Plan) := do
+  let some previous ← readStamp index | return none
+  let some basis ← basis? index | return none
+  let some delta ← SourceDelta.read? source basis | return none
+  let some history ← DB.PageMap.HistoryReader.make? source basis | return none
+  unless previous == (← stamp history.snapshot) &&
+      (← getNat index.get "documents") == previous.candidates do
+    throw (IO.userError "complete lexical workspace has a different source basis")
+  let old ← (← SourceDelta.documents history.snapshot delta.owners).mapM fun document => do
+    return (document.owner,← getNat history.snapshot.get (key "member" document.owner))
+  let wanted ← (← SourceDelta.documents source delta.owners).mapM fun document => do
+    return (document,← getNat source.get (key "member" document.owner))
+  let before := Std.HashMap.ofList old
+  let after := Std.HashMap.ofList (wanted.map fun (document,ordinal) => (document.owner,ordinal))
+  for owner in delta.owners do checkedOwner index owner before[owner]?
+  return some {
+    mode := "publication-delta",before := previous.candidates
+    removed := old.filter fun (owner,ordinal) => after[owner]? != some ordinal
+    added := wanted.filter fun (document,ordinal) => before[document.owner]? != some ordinal
+    full := none,publications := delta.records,changedOwners := delta.owners.length }
+
+/-- Bootstrap and incomplete/divergent workspace recovery keep the existing
+batch-atomic prefix. Already committed token sets need not be regenerated. -/
+def fullPlan (source index : Snapshot) : IO Plan := do
+  let wanted ← (← searchDocuments source).mapM fun document => do
+    return (document,← getNat source.get (key "member" document.owner))
+  let live := Std.HashMap.ofList (wanted.map fun (document,ordinal) => (document.owner,ordinal))
+  let origin ← if (← readStamp index).isSome then basis? index else basis? index "preparing"
+  let reusable ← match origin with
+    | none => pure false
+    | some origin => do pure (← SourceDelta.read? source origin).isSome
+  let previous ← if reusable then directory index "owner" else pure []
+  let known := Std.HashMap.ofList previous
+  return {
+    mode := "full-reconcile",before := previous.length
+    removed := previous.filter fun (owner,ordinal) => live[owner]? != some ordinal
+    added := wanted.filter fun (document,ordinal) => known[document.owner]? != some ordinal
+    full := some live,reset := !reusable }
+
+structure Population (before removed added : Nat) where
+  after : Nat
+  removedWithin : removed ≤ before
+  exact : after = before-removed+added
+
+def checkedPopulation (before removed added expected : Nat) : Except String (Population before removed added) :=
+  if valid : removed ≤ before ∧ before-removed+added = expected then
+    .ok ⟨expected,valid.1,valid.2.symm⟩
+  else .error "lexical change population differs from its complete source"
+
+theorem Population.exact_balance (population : Population before removed added) :
+    population.after+removed = before+added := by
+  have := population.removedWithin
+  have := population.exact
+  omega
+

+module
+public import Std.Data.HashMap.Lemmas
+@[expose] public section
+namespace Eggshell.SpanPostings
+
+/-- Exact original-byte coordinates index the original candidate sequence.
+Values, order and duplicates are retained; hashing is only a directory. -/
+def directory (spanOf : α → Option (Nat × Nat)) (values : List α) :
+    Std.HashMap (Nat × Nat) (List α) :=
+  values.foldr (fun value found => match spanOf value with
+    | none => found
+    | some span => found.insert span (value :: found[span]?.getD [])) {}
+
+theorem directory_exact (spanOf : α → Option (Nat × Nat)) (values : List α)
+    (span : Nat × Nat) :
+    (directory spanOf values)[span]?.getD [] = values.filter (fun value => spanOf value == some span) := by
+  induction values with
+  | nil => simp [directory]
+  | cons value rest ih =>
+    cases found : spanOf value with
+    | none => simpa [directory,found] using ih
+    | some actual =>
+      by_cases same : actual = span
+      · simpa [directory,found,same] using congrArg (List.cons value) ih
+      · simpa [directory,found,same,Std.HashMap.getElem?_insert] using ih
+
+structure Index (spanOf : α → Option (Nat × Nat)) (values : List α) where
+  postings : Std.HashMap (Nat × Nat) (List α)
+  exact : ∀ span, postings[span]?.getD [] = values.filter (fun value => spanOf value == some span)
+
+def prepare (spanOf : α → Option (Nat × Nat)) (values : List α) : Index spanOf values :=
+  ⟨directory spanOf values,directory_exact spanOf values⟩
+
+variable {α : Type u} {spanOf : α → Option (Nat × Nat)} {values : List α}
+
+def Index.lookup (index : Index spanOf values) (span : Nat × Nat) : List α :=
+  index.postings[span]?.getD []
+
+theorem Index.lookup_exact (index : Index spanOf values) (span : Nat × Nat) :
+    index.lookup span = values.filter (fun value => spanOf value == some span) := index.exact span
+
+end Eggshell.SpanPostings

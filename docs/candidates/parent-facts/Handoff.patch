+def rankedCitedObservationCoordinatesUsing (parse : Nat → String → String → List (Nat × Nat))
+    (texts : List (Nat × String)) (owner : OutcomeEdge)
+    (records : List SourceEvidence.Record) : Option
+      (Nat × List Nat × List (Nat × Nat) × List (Nat × List (Nat × Nat))) := Id.run do
+  let some source := Matcher.atomText? owner.outcome | return none
+  let some work := Matcher.atomText? owner.work | return none
+  let layout := (decodedToolText? source).map DecodedLayout.make
+  let text := layout.map (·.decoded.text) |>.getD source
+  let rows := (contextRecordSpans source layout).zip (text.splitOn "\n")
+  let native := nativeReadRows source layout work records
+  let mut hints : List (Nat × Nat) := []
+  let mut groups : List (Nat × List (Nat × Nat)) := []
+  for (priority,parent) in texts do
+    let intervals := ((records.flatMap (·.files)).flatMap fun file =>
+      parse priority parent file.relative).eraseDups
+    for (first,last) in intervals do
+      -- Filter finite saved rows, never enumerate an untrusted interval.
+      let numbered := (rows.filterMap fun (span,row) => do
+        let (number,_) ← observedLineNumber? row
+        if first ≤ number && number ≤ last then some (number,span) else none) ++
+        (native.filterMap fun (span,number) =>
+          if first ≤ number && number ≤ last then some (number,span) else none)
+      let spans := numbered.map Prod.snd
+      -- Completeness counts the finite stored row domain; it never expands
+      -- citation-controlled line bounds into a new allocation or file read.
+      if (numbered.map Prod.fst).eraseDups.length == last-first+1 && !spans.isEmpty then
+        let original := (spans.map fun span => (span.start,span.stop)).eraseDups
+        if !groups.contains (priority,original) then groups := groups ++ [(priority,original)]
+      for position in (spans.flatMap (observedSpanWindows (work.length+1))).eraseDups do
+        match hints.find? (·.1 == position) with
+        | none => hints := hints ++ [(position,priority)]
+        | some (_,old) => if priority < old then
+            hints := hints.map fun row => if row.1 == position then (position,priority) else row
+  let some first := hints.head? | return none
+  return some (first.2,hints.map Prod.fst,hints,groups)
+theorem ranked_citation_parser_exact
+    (parse : Nat → String → String → List (Nat × Nat))
+    (same : ∀ rank text relative,parse rank text relative = citedLineIntervals text relative)
+    (texts : List (Nat × String)) (owner : OutcomeEdge) (records : List SourceEvidence.Record) :
+    rankedCitedObservationCoordinatesUsing parse texts owner records = rankedCitedObservationCoordinates texts owner records := by
+  have exactParser : parse = fun _ => citedLineIntervals := by funext rank text relative; exact same rank text relative
+  subst parse
+  rfl
+
+theorem ranked_prepared_parser_exact (parents texts : List (Nat × String))
+    (owner : OutcomeEdge) (records : List SourceEvidence.Record) :
+    rankedCitedObservationCoordinatesUsing (PreparedCitationLinks.Parser.prepare parents).parse texts owner records =
+      rankedCitedObservationCoordinates texts owner records :=
+  ranked_citation_parser_exact _ (PreparedCitationLinks.Parser.parse_exact _ (PreparedCitationLinks.Parser.prepared_valid parents)) ..
+#print axioms ranked_prepared_parser_exact
+
+namespace SourceCitationFacts
+def prepare (index : SourceIncidence all unions) (parents : List (Nat × Value × String)) : List (Nat × List Value × String) :=
+  parents.map fun (rank,work,text) => (rank,(index.neighborhood [work]).map (·.work),text)
+def admitted (facts : List (Nat × List Value × String)) (work : Value) : List (Nat × String) :=
+  facts.filterMap fun (rank,reached,text) => if reached.any (· == work) then some (rank,text) else none
+theorem admitted_exact (index : SourceIncidence all unions) (parents : List (Nat × Value × String)) (work : Value) :
+    admitted (prepare index parents) work = (parents.filterMap fun (rank,parent,text) =>
+      if (index.neighborhood [parent]).any (·.work == work) then some (rank,text) else none) := by
+  unfold admitted prepare
+  rw [List.filterMap_map]
+  apply congrArg (fun f => parents.filterMap f)
+  funext row
+  rcases row with ⟨rank,parent,text⟩
+  simp only [Function.comp_apply,List.any_map]
+  rfl
+#print axioms admitted_exact
+end SourceCitationFacts

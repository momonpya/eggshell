+module
+public import Eggshell.PublicationWire
+@[expose] public section
+namespace Eggshell.Plugin.Publication.Read
+open Lean DB
+structure Policy where
+  chars : Nat := 120000
+  numeric : Bool := true
+  deriving ToJson, FromJson, BEq
+def Policy.valid (policy : Policy) : Bool := 0 < policy.chars && policy.chars ≤ 500000
+structure Question where
+  text : String
+  delivered : List String
+  policy : Policy
+  deriving ToJson, FromJson
+def Question.valid (question : Question) : Bool :=
+  !question.text.isEmpty && question.text.utf8ByteSize ≤ 65536 && question.policy.valid &&
+  question.delivered.length ≤ 4096 && question.delivered.all (fun key => key.utf8ByteSize ≤ 1024)
+structure Request where
+  reads : Array ReadInput
+  question : Question
+  deriving ToJson, FromJson
+def image (manifest : ProjectStore.Manifest) (cut : ProjectStore.Cut) : ProjectInputs.Image :=
+  ⟨manifest.identity,ProjectStore.manifestChecksum manifest,cut⟩
+theorem image_keeps_inventory (manifest : ProjectStore.Manifest) (cut : ProjectStore.Cut) :
+    (image manifest cut).inventory = ProjectStore.manifestChecksum manifest := rfl
+def requestKey (question : Question) (inputs : String) :=
+  Blake3.hex (Blake3.digest "eggshell.project-read-question".toUTF8 [(toJson (question,inputs)).compress.toUTF8])
+/-- Advisory originals have no constructor or flag that can stop current Work.
+Client-local Exact/freshness checks remain a separate authority path. -/
+structure Advice where
+  text : String
+  reason : String
+  delivered : List String
+  advisory : Nat
+  synapticComplete : Bool
+  search : Option SearchTrace
+  deriving ToJson, FromJson
+def Advice.completed (_ : Advice) : Nat := 0
+def Advice.blocksCurrent (_ : Advice) : Bool := false
+theorem advice_never_completes (advice : Advice) : advice.completed = 0 ∧ advice.blocksCurrent = false := ⟨rfl,rfl⟩
+structure Response where
+  inputs : String
+  question : String
+  advice : Option Advice
+  deriving ToJson, FromJson
+def Response.check (response : Response) (question : Question) (images : Array ProjectInputs.Image) : Bool :=
+  response.inputs == ProjectInputs.digest images && response.question == requestKey question response.inputs &&
+    response.advice.all (fun advice => advice.text.length ≤ question.policy.chars &&
+      advice.text.utf8ByteSize ≤ 4*question.policy.chars && advice.reason != "search-incomplete")
+theorem response_keeps_inputs (response : Response) (question : Question) (images : Array ProjectInputs.Image)
+    (accepted : response.check question images = true) : response.inputs = ProjectInputs.digest images := by
+  simp only [Response.check,Bool.and_eq_true,beq_iff_eq] at accepted
+  exact accepted.1.1
+end Eggshell.Plugin.Publication.Read

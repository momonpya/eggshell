+module
+public import Eggshell.ProjectReadWire
+public import Eggshell.ProjectPublication
+public import Eggshell.SearchReaders
+public import Eggshell.Handoff
+@[expose] public section
+namespace Eggshell.Plugin.Publication.Read
+open Lean DB
+def advice (handoff : Handoff) : Except String Advice := do
+  unless handoff.completed == 0 && !handoff.blocksCurrent && handoff.localUnions == 0 &&
+      handoff.reason != "search-incomplete" do throw "shared advisory query did not finish without completion authority"
+  return ⟨handoff.text,handoff.reason,handoff.deliveredGraphs,handoff.advisory,handoff.synapticComplete,handoff.search⟩
+/-- Reuse complete project images and the public-reader coordinator already
+owned by the service. Mutable reader state is forked for each request. -/
+def query (pool : Owned.Pool) (readers : SearchReaders.Coordinator) (request : Request)
+    (cancelled : IO.Ref Bool) (deadline : Nat) : IO Response := do
+  unless request.question.valid && 0 < request.reads.size && request.reads.size ≤ 64 &&
+      (request.reads.toList.map (·.database)).Nodup do throw (IO.userError "invalid project read request")
+  let held ← IO.mkRef (#[] : Array ProjectViews.Borrow)
+  try
+    let mut sources : Array PageMap.Snapshot := #[]
+    let mut images : Array ProjectInputs.Image := #[]
+    let mut names : List Config.Egg := []
+    for input in request.reads do
+      TaskDeadline.ensureLive deadline
+      unless !(← cancelled.get) do throw (IO.userError "project read cancelled")
+      let registered ← pool.readProject input.database input.capability
+      let borrow ← pool.views.acquire registered.project input.cut deadline
+      held.modify (·.push borrow)
+      let (originals,image) ← borrow.withReader fun view => pure (view.sources,ProjectInputs.ofView view)
+      images := images.push image
+      for slot in [:originals.size] do
+        let some source := originals[slot]? | throw (IO.userError "project view omitted an original owner")
+        sources := sources.push source
+        names := names++[⟨input.database++":"++toString slot,source.directory⟩]
+    let mut inputs : Array PreparedInputs.Reference := #[]
+    for source in sources do
+      let some input ← PreparedInputs.loadStored? source .database MiniLM.model SearchProvider.encoderContract |
+        throw (IO.userError "project read is waiting for publication preparation")
+      let input := {input with usage := none}
+      unless input.sharedSafe do throw (IO.userError "project reader contains private preparation")
+      inputs := inputs.push input
+    let owners ← OwnerViews.load? sources
+    let frame ← PreparedReaders.Frame.capture sources inputs owners
+    let session ← readers.borrow frame deadline cancelled
+    let prepared ← session.pool.acquire session.sources inputs owners
+    let synaptic ← Synapses.Recommend.prepareMany session.sources (some inputs) deadline (some prepared)
+    try
+      unless synaptic.all (·.failure.isNone) do throw (IO.userError "project read omitted a prepared synaptic source")
+      let executable ← IO.appPath
+      let selection : Config.Selection := {
+        label := "project-service",semanticMatcher := if request.question.policy.numeric then
+          some [executable.toString,"search-provider"] else none
+        read := names,write := none,handoffChars := request.question.policy.chars,localUnion := false }
+      let started ← IO.monoMsNow
+      let semanticReady ← IO.mkRef (none : Option Nat)
+      let result ← computeAutomaticHandoff selection (session.sources.toList.map some) request.question.text
+        request.question.delivered false (enableLocalUnion := false) (meaningQuery := some request.question.text)
+        (synaptic := synaptic) (upstreamDeadline := some deadline) (queryInputs := some inputs)
+        (queryOwners := owners) (preparedReaders := some prepared)
+        (onSemanticReady := do semanticReady.set (some (← IO.monoMsNow)))
+      TaskDeadline.ensureLive deadline
+      unless !(← cancelled.get) do throw (IO.userError "project read cancelled before delivery")
+      let ended ← IO.monoMsNow
+      let completed ← semanticReady.get
+      let trace : SearchTrace := {
+        semantic := if !request.question.policy.numeric then .notRequested
+          else if completed.isSome then .completed else .failed
+        route := if request.question.policy.numeric then .configured else .lexical
+        semanticMs := if request.question.policy.numeric then completed.getD ended-started else 0
+        lexicalMs := if request.question.policy.numeric then 0 else ended-started }
+      let body ← IO.ofExcept (result.mapM fun handoff => advice {handoff with search := some trace})
+      let stamp := ProjectInputs.digest images
+      let response : Response := ⟨stamp,requestKey request.question stamp,body⟩
+      unless response.check request.question images do throw (IO.userError "project read response changed its input boundary")
+      return response
+    finally
+      Synapses.Recommend.releaseMany synaptic ((← IO.monoMsNow)+1000)
+  finally
+    for borrow in ← held.get do borrow.release
+end Eggshell.Plugin.Publication.Read

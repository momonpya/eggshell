+module
+public import Lean.Data.Json.Parser
+public import Lean.Data.Json.FromToJson
+@[expose] public section
+namespace Eggshell.Plugin
+open Lean
+def requiredString (json : Json) (name : String) : Except String String := do
+  (json.getObjVal? name).bind Json.getStr?
+
+def optionalString (json : Json) (name : String) : Option String :=
+  (json.getObjVal? name).toOption.bind (Json.getStr? · |>.toOption)
+
+def jsonField (json : Json) (name : String) : String :=
+  json.getObjValD name |>.compress
+
+def emptyHook : String := "{}"
+
+def systemMessage (message : String) : String :=
+  Json.mkObj [("systemMessage", message)] |>.compress
+
+def pendingSearchText : String := "EGGSHELL SEARCH INCOMPLETE\n" ++
+    "Local memory search is busy or unavailable. This is not a completed search with no matches.\n" ++
+    "No prior work is certified as complete by this notice. Continue uncovered work using accessible evidence; " ++
+    "if required evidence is unavailable, report that gap instead of repeatedly checking the same source.\n" ++
+    "END EGGSHELL SEARCH INCOMPLETE"
+
+def hookContext (event : String) (text : String) : String :=
+  Lean.Json.mkObj [
+    ("hookSpecificOutput", Lean.Json.mkObj [
+      ("hookEventName", event),
+      ("additionalContext", text)
+    ])
+  ] |>.compress
+
+end Eggshell.Plugin

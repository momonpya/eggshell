+def originalFeedUsing (journal : PageMap.Snapshot)
+    (get : String → IO (Option ByteArray)) : IO OriginalFeed := do
+  let some raw ← get "original-feed" | do
+    unless (← getNat get "count") == 0 do
+      throw (IO.userError "private journal has no original-only append feed")
+    return OriginalFeed.empty journal
+  let feed ← Index.decode (α := OriginalFeed) raw
+  let count ← getNat get "count"
+  unless (toJson feed).compress.toUTF8 == raw && feed.producer == implementation &&
+      feed.count ≤ count && feed.latest ≤ count && digest feed.chain &&
+      ((feed.count == 0 && feed == OriginalFeed.empty journal) ||
+        (feed.count > 0 && feed.latest > 0)) do
+    throw (IO.userError "invalid original-only append feed")
+  return feed
+
+def originalFeed (journal : PageMap.Snapshot) : IO OriginalFeed :=
+  originalFeedUsing journal journal.get
+
+def originalOrdinal (journal : PageMap.Snapshot) (position : Nat) : IO Nat := do
+  let some raw ← journal.get (originalKey position) |
+    throw (IO.userError "original-only append feed has a hole")
+  let ordinal ← IO.ofExcept (payloadSize (some raw))
+  let inverse ← journal.get (originalPositionKey ordinal)
+  unless ordinal < (← getNat journal.get "count") &&
+      (← journal.get (referenceKey ordinal)).isNone &&
+      inverse == some (Wire.natural.encode position).toByteArray do
+    throw (IO.userError "original-only append feed changed its original location")
+  return ordinal
+
+inductive EntryStorage where
+  | original
+  | reference (value : EntryReference)
+

+module
+
+public import Std
+
+@[expose] public section
+
+namespace Eggshell.OriginalEventIndex
+
+/-- The ordinal written to the sparse feed, if this append is original. -/
+def posting (position ordinal : Nat) (original : Bool) : Option (Nat × Nat) :=
+  if original then some (position,ordinal) else none
+
+def next (position : Nat) (original : Bool) : Nat :=
+  position + if original then 1 else 0
+
+/-- Full mixed-journal oracle. `true` denotes an original, `false` an alias. -/
+def enumerate (start : Nat) : List Bool → List Nat
+  | [] => []
+  | original :: rest => (if original then [start] else []) ++ enumerate (start+1) rest
+
+theorem enumerate_append (left right : List Bool) (start : Nat) :
+    enumerate start (left ++ right) = enumerate start left ++ enumerate (start+left.length) right := by
+  induction left generalizing start with
+  | nil => simp [enumerate]
+  | cons original rest ih =>
+    simp [enumerate,ih,List.append_assoc,Nat.add_comm,Nat.add_left_comm]
+
+/-- Appending one posting agrees with filtering the complete mixed journal. -/
+theorem append_matches_full_scan (events : List Bool) (original : Bool) :
+    enumerate 0 (events ++ [original]) =
+      enumerate 0 events ++ (posting (enumerate 0 events).length events.length original).toList.map Prod.snd := by
+  rw [enumerate_append]
+  cases original <;> simp [enumerate,posting]
+
+theorem alias_preserves_originals (events : List Bool) :
+    enumerate 0 (events ++ [false]) = enumerate 0 events := by
+  simp [append_matches_full_scan,posting]
+
+theorem next_matches_full_scan (events : List Bool) (original : Bool) :
+    next (enumerate 0 events).length original = (enumerate 0 (events ++ [original])).length := by
+  rw [append_matches_full_scan]
+  cases original <;> simp [next,posting]
+
+theorem posting_position (position ordinal : Nat) :
+    posting position ordinal true = some (position,ordinal) := rfl
+
+end Eggshell.OriginalEventIndex

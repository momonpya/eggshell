@@ -399 +444 @@ def serveClient (backend : Backend) (config : Config) (secret : String) (client
-          backend.scoreBlocks config client (← IO.ofExcept (request.getObjValAs? String "payload")) deadline
+          backend.scoreBlocks config client (← IO.ofExcept (request.getObjValAs? String "payload")) deadline mark
@@ -401 +446 @@ def serveClient (backend : Backend) (config : Config) (secret : String) (client
-          backend.encode config client (← IO.ofExcept (request.getObjValAs? String "payload")) deadline
+          backend.encode config client (← IO.ofExcept (request.getObjValAs? String "payload")) deadline mark
@@ -403 +448,4 @@ def serveClient (backend : Backend) (config : Config) (secret : String) (client

+/-- Optional metadata never changes an unobserved reply, and does not replace
+the numerical fields consumed by ranking. Real hooks check observed erasure. -/
+def observedOutput (enabled : Bool) (output : String) (metadata : Json) : String :=
+  if enabled then match Json.parse output with
+    | .ok json => (json.setObjVal! "numericalTrace" metadata).compress++"\n"
+    | .error _ => output
+  else output
+
+theorem unobserved_output_unchanged (output : String) (metadata : Json) :
+    observedOutput false output metadata = output := by simp [observedOutput]
+
+def serveClient (backend : Backend) (config : Config) (secret : String) (client : Socket.Client)
+    (acceptedAt : Nat := 0) : IO Unit := do
+  let enabled := (← IO.getEnv "EGGSHELL_TRACE_NUMERICAL_STAGES") == some "1"
+  let started ← IO.monoMsNow
+  let events ← IO.mkRef (#[ ("accepted",if acceptedAt == 0 then started else acceptedAt) ] : Array (String × Nat))
+  let mark := fun label => do
+    if enabled then
+      let now ← IO.monoMsNow
+      events.modify (·.push (label,now))
+  mark "handler:start"
@@ -380,0 +422 @@ def serveClient (backend : Backend) (config : Config) (secret : String) (client
+    mark "request-read:start"

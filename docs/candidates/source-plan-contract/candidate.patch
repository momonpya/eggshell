+theorem published_result_checked (database owner : String) (stored : CanonicalSource.Recipe.Stored)
+    (metadata : PublishedPlanMetadata.Stored) (ready : Ready)
+    (accepted : preparePublished database owner stored metadata = .ok ready) :
+    ∃ witness, SourcePlanContract.check ready.owner ready.stored.rows metadata = .ok witness := by
+  cases produced : prepare database owner stored with
+  | error message => simp [preparePublished,produced] at accepted
+  | ok original =>
+    cases validated : SourcePlanContract.check original.owner original.stored.rows metadata with
+    | error message => simp [preparePublished,produced,validated] at accepted
+    | ok witness =>
+      have same : original = ready := by simpa [preparePublished,produced,validated] using accepted
+      cases same
+      exact ⟨witness,validated⟩

diff --git a/tools/research/SharedMetadataCache.lean b/tools/research/SharedMetadataCache.lean
index b991d0f4..17772fc9 100644
--- a/tools/research/SharedMetadataCache.lean
+++ b/tools/research/SharedMetadataCache.lean
@@ -4,0 +5 @@ public import Init.System.Promise
+public import Lean.Data.Json.FromToJson
@@ -155,0 +157,20 @@ def Cache.withReady (cache : Cache α capacity) (key : String) (amount deadline
+def Cache.stats (cache : Cache α capacity) (empty : α → Bool) : IO Lean.Json := do
+  let state ← cache.state.atomically get
+  let tasks ← cache.tasks.atomically get
+  let finished ← tasks.filterM fun task => return (← IO.hasFinished task)
+  let mut resolved := 0
+  let mut emptyEntries := 0
+  for (_,entry) in state.entries do
+    if ← entry.promise.isResolved then
+      if let some (.ok value) := entry.promise.result?.get then
+        resolved := resolved+1
+        if empty value then emptyEntries := emptyEntries+1
+  return Lean.Json.mkObj [("entries",Lean.toJson state.entries.size),("chargedBytes",Lean.toJson state.budget.used),
+    ("capacity",Lean.toJson capacity),("active",Lean.toJson state.active),("loads",Lean.toJson state.loads),
+    ("hits",Lean.toJson state.hits),("joins",Lean.toJson state.joins),("evictions",Lean.toJson state.evictions),
+    ("borrowers",Lean.toJson (state.entries.fold (fun n _ entry => n+entry.borrowers) 0)),
+    ("resolvedEntries",Lean.toJson resolved),("emptyEntries",Lean.toJson emptyEntries),
+    ("retainedTasks",Lean.toJson tasks.size),("finishedRetainedTasks",Lean.toJson finished.size),
+    ("accountedExact",Lean.toJson (state.budget.used == state.entries.fold (fun n _ entry => n+entry.charge) 0)),
+    ("chargesNotHeapBytes",Lean.toJson true)]
+

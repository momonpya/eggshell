+/-- Comparison work is deferred until a transported result actually requires
+an audit. Graph membership remains an erased witness, not a retained graph. -/
+structure DeferredSelectionAudit where
+  current : Value
+  selection : Selection
+  equality : Equality
+  persistent : List UnionEdge
+  runLocal : List UnionEdge
+  runAll : List AllEdge
+  passes : Nat
+  completed : List Selected
+  certified : ∃ graph policy, selection.validFor graph equality policy current = true
+
+@[noinline] def prepareDeferredSelectionAudit (receipt : Option String)
+    (discovery : Matcher.Discovery)
+    (prepared : {extraction : Extraction // extraction = Matcher.extraction discovery}) :
+    Option DeferredSelectionAudit :=
+  if receipt.isNone then none else
+    some {
+      current := discovery.current,selection := prepared.val.selection
+      equality := discovery.view.quotient.toEquality
+      persistent := discovery.persistentUnions,runLocal := discovery.view.localUnions
+      runAll := discovery.runAll,passes := discovery.passes
+      completed := (selectedMatches discovery prepared.val).filter
+        (fun selected => selected.applicability == .completed)
+      certified := ⟨discovery.view.graph,discovery.policy,by
+        simpa only [prepared.property] using Matcher.extraction_sound discovery⟩ }
@@ -1603,0 +1632,30 @@
+def auditDeferredSelection (receipt : Option String) (prepared : Option DeferredSelectionAudit)
+    (result : Option Handoff) (observed : List SelectionAudit.Admission := [])
+    (trail : DiscoveryAudit.Trail := {}) : IO (Option Handoff) := do
+  if receipt.isNone then return result
+  let some handoff := result | return none
+  if handoff.completed == 0 && !handoff.blocksCurrent then return result
+  let some ready := prepared | throw (IO.userError "selected equality audit input is missing")
+  let owners := ready.completed.map (fun selected => relationKey selected.matched.edge.relation)
+  let bindings := ready.completed.map fun selected =>
+    (selected.matched.projectedEdge.relation,relationKey selected.matched.edge.relation)
+  let admissions := ready.completed.filterMap fun selected =>
+    (observed.find? (fun admission => Matcher.sameMatch admission.matched selected.matched)).map
+      (fun admission => (admission,relationKey selected.matched.edge.relation))
+  let reference ← SelectionAudit.capture receipt
+    (SelectionAudit.Snapshot.ofSelection ready.persistent ready.runLocal ready.equality ready.current ready.selection
+      (SelectionDependency.comparisons ready.equality ready.current ready.selection) owners bindings
+      admissions observed trail ready.runAll (some ready.passes))
+    ((handoff.sourceUses.filter (·.completed)).map (·.owner))
+    (handoff.sourceCheckpoints.map (·.use.owner))
+  pure (some {handoff with equalitySelection := reference})
+
+theorem audit_deferred_exact (receipt : Option String) (discovery : Matcher.Discovery)
+    (prepared : {extraction : Extraction // extraction = Matcher.extraction discovery})
+    (result : Option Handoff) (observed : List SelectionAudit.Admission) (trail : DiscoveryAudit.Trail) :
+    auditDeferredSelection receipt (prepareDeferredSelectionAudit receipt discovery prepared) result observed trail =
+      auditRenderedSelection receipt discovery prepared result observed trail := by
+  cases receipt <;> cases result <;>
+    simp [auditDeferredSelection,prepareDeferredSelectionAudit,auditRenderedSelection,
+      SelectionAudit.snapshot_ofReport_deferred,SelectionDependency.Report.ofValid]
+

+module
+public import Eggshell.CanonicalSourceDelivery
+public import tools.RangeReach
+@[expose] public section
+
+namespace Eggshell.Synapses.SharedReadReceipt
+open Lean
+
+def implementation : String := Blake3.hex (Blake3.digest "eggshell.shared-read-receipt".toUTF8 [
+  (include_str "SharedReadReceipt.lean").toUTF8,
+  (include_str "CanonicalSourceDelivery.lean").toUTF8,
+  (include_str "../tools/RangeReach.lean").toUTF8])
+
+/-- A confirmed row key is navigation into stored evidence, not an owner ACK.
+The complete key spelling is retained; plans and locators cannot name a row. -/
+structure Token (keys : List String) where
+  fileKey : String
+  line : Nat
+  original : String
+  accepted : original ∈ keys
+  canonical : original = "c:" ++ fileKey ++ ":" ++ toString line
+
+def tokens (keys : List String) : Std.HashMap String (List (Token keys)) := Id.run do
+  let mut found := {}
+  let mut seen : Std.HashSet (String × Nat) := {}
+  for item in keys.attach do
+    let ["c",fileKey,spelling] := item.val.splitOn ":" | continue
+    let some line := spelling.toNat? | continue
+    if same : item.val = "c:" ++ fileKey ++ ":" ++ toString line then
+      if seen.contains (fileKey,line) then continue
+      seen := seen.insert (fileKey,line)
+      let token : Token keys := ⟨fileKey,line,item.val,item.property,same⟩
+      found := found.insert fileKey (token :: found[fileKey]?.getD [])
+  return found
+
+structure Witness (keys : List String) (reads : Array Read) where
+  token : Token keys
+  file : File
+  old : {read : Read // read ∈ reads}
+  oldValid : old.val.valid = true
+  fileKey : token.fileKey = Index.contentKey file
+  rowValid : (⟨file,token.line,token.line⟩ : Range).valid = true
+  contained : old.val.source.contains ⟨file,token.line,token.line⟩ = true
+
+def Witness.range (witness : Witness keys reads) : Range :=
+  ⟨witness.file,witness.token.line,witness.token.line⟩
+
+theorem Witness.original (witness : Witness keys reads) :
+    ∃ read ∈ reads, read.valid = true ∧ read.source.contains witness.range = true :=
+  ⟨witness.old.val,witness.old.property,witness.oldValid,witness.contained⟩
+
+theorem Witness.confirmed_key (witness : Witness keys reads) :
+    ∃ key ∈ keys, key = CanonicalSource.Delivery.rowKey ⟨witness.file,witness.token.line⟩ := by
+  refine ⟨witness.token.original,witness.token.accepted,?_⟩
+  rw [witness.token.canonical,witness.fileKey]
+  rfl
+
+/-- Build once over already verified pre-read facts. Equivalent footprints
+need one existence witness; their original executions are not merged. Point
+queries use a prefix-maximum interval directory, not a keys × reads scan. -/
+def collect (keys : List String) (reads : Array Read) : Array (Witness keys reads) := Id.run do
+  let known := tokens keys
+  if known.isEmpty then return #[]
+  let mut seen : Std.HashSet (File × Nat × Nat) := {}
+  let mut groups : Std.HashMap File (List {read : Read // read ∈ reads}) := {}
+  for saved in reads.attach do
+    unless saved.val.valid do continue
+    let some file := saved.val.source.file? | continue
+    let shape := (file,saved.val.source.first,saved.val.source.last)
+    if seen.contains shape then continue
+    seen := seen.insert shape
+    groups := groups.insert file (saved :: groups[file]?.getD [])
+  let mut result := #[]
+  for (file,originals) in groups do
+    let fileKey := Index.contentKey file
+    let some acknowledged := known[fileKey]? | continue
+    let entries := originals.toArray.map fun (saved : {read : Read // read ∈ reads}) =>
+      ({first := saved.val.source.first,limit := saved.val.source.last+1,value := saved} :
+        RangeReach.Entry {read : Read // read ∈ reads})
+    let directory := RangeReach.prepare entries
+    for token in acknowledged do
+      let some found := directory.lookup? token.line | continue
+      let row : Range := ⟨file,token.line,token.line⟩
+      if oldValid : found.value.val.valid = true then
+        if same : token.fileKey = fileKey then
+          if rowValid : row.valid = true then
+            if contained : found.value.val.source.contains row = true then
+              result := result.push ⟨token,file,found.value,oldValid,same,rowValid,contained⟩
+  return result
+
+end Eggshell.Synapses.SharedReadReceipt

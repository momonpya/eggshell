+theorem shared_presentation_keeps_raw_bindings (known : Knowledge) (stored : Array Read) (shown : Presentation) :
+    (presentationWithShared known stored shown).bindings = shown.bindings := by
+  cases state : known.uncertain <;> simp [presentationWithShared,state]
+
+theorem shared_presentation_keeps_uncertainty (known : Knowledge) (stored : Array Read) (shown : Presentation) :
+    (presentationWithShared known stored shown).uncertain = shown.uncertain ∧
+    (presentationWithShared known stored shown).uncertainOwners = shown.uncertainOwners := by
+  cases state : known.uncertain <;> simp [presentationWithShared,state]
 
+theorem unconfirmed_shared_presentation (known : Knowledge) (stored : Array Read) (shown : Presentation)
+    (unconfirmed : known.uncertain = true) : presentationWithShared known stored shown = shown := by
+  simp [presentationWithShared,unconfirmed]
+

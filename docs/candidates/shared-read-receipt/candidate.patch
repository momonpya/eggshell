+module
+public import Eggshell.SynapseIndex
+public import Eggshell.SharedReadReceipt
+@[expose] public section
+
+namespace Eggshell.Synapses.UsageCache
+open Lean DB
+
+/-- Labels are a derived interpretation of immutable journal events. A new
+classifier cannot append to the old classifier's immutable event witnesses. -/
+def implementation : String := Blake3.hex (Blake3.digest "eggshell.usage-classifier".toUTF8 [
+  Index.implementation.toUTF8,SharedReadReceipt.implementation.toUTF8,
+  (include_str "UsageCache.lean").toUTF8,(include_str "SynapseJournal.lean").toUTF8,
+  (include_str "SynapseUsage.lean").toUTF8,(include_str "PluginModel.lean").toUTF8,
+  (include_str "SynapseLive.lean").toUTF8])
+
+def name : String := "usage-" ++ implementation
+
+def directory (source : PageMap.Snapshot) : IO System.FilePath := do
+  return (← Sidecar.locate source .user).directory / "synapses" / name
+
+/-- Read-only lookup never falls back to an older classifier or a shared DB. -/
+def open? (source : PageMap.Snapshot) : IO (Option Index.Reader) := do
+  let some index ← PageMap.open? (← directory source) | return none
+  let some metadata ← Index.manifest? index | return none
+  unless metadata.scope == .usage && metadata.implementation == Index.implementation &&
+      metadata.source.identity == source.head.identity &&
+      metadata.source.authority == source.head.authority &&
+      (← index.get "classifier") == some implementation.toUTF8 do return none
+  return some ⟨index,metadata⟩
+
+/-- Only this turn's labels are inserted. The PageMap transaction commits the
+facts, routing and classifier marker together; raw events remain elsewhere. -/
+def publish (source : PageMap.Snapshot) (facts : Array Fact) : IO PageMap.Head := do
+  Index.checkFacts source.head.identity .usage facts
+  if facts.isEmpty then
+    if let some current ← open? source then return current.index.head
+  Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) (fun sidecar => do
+    let parent ← Sidecar.childDirectory sidecar.directory "synapses"
+    let path := parent / name
+    let index ← match ← PageMap.open? path with
+      | some index => pure index
+      | none => PageMap.create path ("advisory-usage:" ++ source.head.identity ++ ":" ++ implementation)
+    let previous ← Index.manifest? index
+    if let some previous := previous then
+      unless previous.scope == .usage && previous.implementation == Index.implementation &&
+          previous.source.identity == source.head.identity &&
+          previous.source.authority == source.head.authority &&
+          (← index.get "classifier") == some implementation.toUTF8 do
+        throw (IO.userError "usage cache has a different classifier or source")
+    let (_,head,_) ← PageMap.withWriter index fun writer => do
+      let mut count := previous.map (·.facts) |>.getD 0
+      for fact in facts do
+        if ← Index.insert writer source.head.identity .usage fact then count := count+1
+      Routing.Store.finish writer count
+      let metadata : Index.Manifest := ⟨source.head,Index.implementation,.usage,count⟩
+      let bytes ← Index.checkedBytes metadata
+      if (← writer.get "manifest") != some bytes then writer.put "manifest" (some bytes)
+      if (← writer.get "classifier") != some implementation.toUTF8 then
+        writer.put "classifier" (some implementation.toUTF8)
+    return head) .user
+
+def ensure (source : PageMap.Snapshot) : IO Index.Reader := do
+  if let some reader ← open? source then return reader
+  let _ ← publish source #[]
+  let some reader ← open? source | throw (IO.userError "usage cache did not become ready")
+  return reader
+
+/-- Recreating either derived index invalidates replay checkpoints even if
+the original journal and source publication have not changed. -/
+def replayIdentity (shared usage : Index.Reader) : String :=
+  Index.contentKey (shared.index.head.identity,usage.index.head.identity)
+
+end Eggshell.Synapses.UsageCache

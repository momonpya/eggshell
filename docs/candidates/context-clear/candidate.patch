+/-- A cleared model context has no visible prior delivery, including the
+checkpoints deliberately retained by compaction. DB evidence is unchanged. -/
+def clearState (state : ThreadState) : ThreadState := {
+  (compactState state) with
+    deliveredGraphs := []
+    lastSearch := none
+    searchStarted := false
+    lastReason := "cleared; graph may be resent" }
+
+theorem clear_forgets_claims (state : ThreadState) (turn : String) (now : Nat) :
+    (clearState state).deliveryClaims turn now = [] := by
+  simp [ThreadState.deliveryClaims,clearState,compactState]
+
+theorem clear_forgets_delivery_projection (state : ThreadState) :
+    (clearState state).confirmedDelivery = none := rfl
+
+theorem clear_advances_epoch (state : ThreadState) :
+    (clearState state).epoch = state.epoch + 1 := rfl
+
+theorem clear_preserves_settings (state : ThreadState) :
+    ((clearState state).profile,(clearState state).enabled,
+      (clearState state).nextProfile,(clearState state).nextProjection) =
+    (state.profile,state.enabled,state.nextProfile,state.nextProjection) := rfl
 
 def boundedHookDeadline (now budget : Nat) (upstream : Option Nat) : Nat :=
   min (now + budget) (upstream.getD (now + budget))

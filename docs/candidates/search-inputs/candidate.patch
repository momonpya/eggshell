+    (captured.owners.map Prod.fst)
+
+def Captured.accepts (captured : Captured) (request : KeyedProtocol.Request) : Bool :=
+  decide (captured.key = inputKey request.sources request.prepared request.owners)
+
+theorem Captured.accepts_exact (captured : Captured) (request : KeyedProtocol.Request) :
+    captured.accepts request = true ↔
+      captured.key = inputKey request.sources request.prepared request.owners := by
+  simp [accepts]
+
+theorem Captured.query_not_retained (captured : Captured) (request : KeyedProtocol.Request) (query : String) :
+    captured.accepts {request with query} = captured.accepts request := rfl
+
+theorem Captured.changed_key_rejected (captured : Captured) (request : KeyedProtocol.Request)
+    (different : captured.key ≠ inputKey request.sources request.prepared request.owners) :
+    captured.accepts request = false := by simp [accepts,different]
+
+/-- Check the complete source order and captured derived roots at the typed
+boundary. No latest-root substitution, dropped source or caller-provided wire
+reader is permitted. Construction does not certify any Work equivalence. -/
+@[no_expose] def Captured.borrow (sources : Array Snapshot) (inputs : Array PreparedInputs.Reference)
+    (views : Array (Option SourceView)) (owners : Option (OwnerViews.Reference × OwnerViews.Reader)) :
+    IO Captured := do
+  unless sources.size == inputs.size && views.size == sources.size do
+    throw (IO.userError "borrowed provider omitted an original input")
+  for ((source,input),view) in (sources.zip inputs).zip views do
+    unless input.source == source.head && input.producer == PreparedInputs.implementation do
+      throw (IO.userError "borrowed provider changed an original root")
+    match view with
+    | none => unless input.population == 0 do throw (IO.userError "borrowed provider omitted a populated source")
+    | some view =>
+      unless source.head == view.source.head && source.directory == view.source.directory &&
+          input.windows.any (·.head == view.windows.snapshot.head) &&
+          input.lexical.any (·.head == view.lexical.index.head) &&
+          input.population == view.lexical.expected.candidates do
+        throw (IO.userError "borrowed provider changed a prepared source")
+      match input.numeric,view.numeric with
+      | none,none => pure ()
+      | some saved,some (numeric,storage) =>
+        unless saved.partition == numeric.partition.snapshot.head && saved.matrix == numeric.matrix.snapshot.head &&
+            saved.storage == storage do throw (IO.userError "borrowed provider changed numeric roots")
+      | _,_ => throw (IO.userError "borrowed provider omitted or invented numeric preparation")
+  if let some (reference,reader) := owners then
+    unless reference.sources == sources.map (·.head) &&
+        toJson (reader.base.inputs.map (·.captured)) == toJson (reference.items.map (·.captured)) do
+      throw (IO.userError "borrowed provider changed its owner inventory")
+  return ⟨sources,publicReferences inputs,views,owners⟩
+
+def Captured.use (captured : Captured) (request : KeyedProtocol.Request)
+    (model : String) (numeric : Bool) : IO (Array Snapshot × Array (Option SourceView)) := do
+  unless captured.accepts request do throw (IO.userError "borrowed provider belongs to different captured inputs")
+  for (source,input) in captured.sources.zip captured.inputs do
+    unless input.accepts source model encoderContract do
+      throw (IO.userError "borrowed provider changed its source or encoder")
+  let views ← captured.views.mapM fun entry => entry.mapM fun view => do
+    if numeric && view.numeric.isNone then throw (IO.userError "borrowed numeric input was not prepared")
+    return if numeric then view else {view with numeric := none}
+  return (captured.sources,views)
+

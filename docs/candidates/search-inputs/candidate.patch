+structure NumericInput where
+  partition : SnapshotImage
+  header : VectorPartition.Header
+  matrix : SnapshotImage
+  metadata : VectorMatrix.Manifest
+  storage : Sidecar.Storage
+
+structure SearchInput where
+  windows : SnapshotImage
+  windowManifest : WindowOwners.Manifest
+  lexical : SnapshotImage
+  lexicalStamp : RetrievalResearch.Index.Stamp
+  numeric : Option NumericInput
+
+def SearchInput.capture (pages : PageMap.PagePool) (scope : String)
+    (source : PageMap.Snapshot) (input : PreparedInputs.Reference) : IO (Option SearchInput) := do
+  if input.population == 0 then
+    unless (← getNat source.get "candidates") == 0 do throw (IO.userError "empty provider input changed its source")
+    return none
+  let windows ← PreparedInputs.windows input source
+  let lexical ← PreparedInputs.lexical input source
+  let numeric ← input.numeric.mapM fun _ => do
+    let (view,storage) ← PreparedInputs.numerical input source
+    return (⟨← SnapshotImage.capture pages scope view.partition.snapshot,view.partition.header,
+      ← SnapshotImage.capture pages scope view.matrix.snapshot,view.matrix.metadata,storage⟩ : NumericInput)
+  return some ⟨← SnapshotImage.capture pages scope windows.snapshot,windows.manifest,
+    ← SnapshotImage.capture pages scope lexical.index,lexical.expected,numeric⟩
+
+def SearchInput.borrow (image : SearchInput) (pages : PageMap.PagePool) (scope : String)
+    (source : PageMap.Snapshot) : IO KeyedSearchProvider.SourceView := do
+  let windows : WindowOwners.Ready := ⟨← image.windows.borrow pages scope,image.windowManifest⟩
+  let lexical : RetrievalResearch.Index.Reader source := ⟨← image.lexical.borrow pages scope,image.lexicalStamp⟩
+  let numeric ← image.numeric.mapM fun image => do
+    let partition : VectorPartition.Ready := ⟨← image.partition.borrow pages scope,image.header⟩
+    let matrix : VectorMatrix.Ready := ⟨image.metadata,← image.matrix.borrow pages scope⟩
+    if same : partition.header.basis.matrix = matrix.snapshot.head then
+      return ((⟨partition,matrix,same⟩ : PartitionBuild.ReadView source),image.storage)
+    else throw (IO.userError "borrowed routing basis changed its matrix")
+  return ⟨source,windows,lexical,numeric⟩
+
+def SearchInput.bytes (image : SearchInput) : Nat :=
+  (toJson (image.windowManifest,image.lexicalStamp,
+    image.numeric.map fun numeric => (numeric.header,numeric.metadata.rows,numeric.metadata.bytes,numeric.storage))).compress.utf8ByteSize
+
+def SearchInput.handles (image : SearchInput) : Nat := 2+image.numeric.toArray.size*2

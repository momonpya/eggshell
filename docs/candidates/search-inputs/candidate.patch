+/-- Fork only operation-owned read state from checked public input images.
+The same captured source/root order and public prepared references are required;
+private usage remains outside this image and no query is retained. -/
+@[no_expose] def Borrow.keyed (borrow : Borrow) (sources : Array PageMap.Snapshot)
+    (inputs : Array PreparedInputs.Reference)
+    (reference : Option OwnerViews.Reference) : IO KeyedSearchProvider.Captured := do
+  unless (sources.map SourceOwners.refOf) == borrow.sources.map SourceOwners.refOf &&
+      toJson (publicInputs inputs) == toJson borrow.image.inputs &&
+      toJson reference == toJson borrow.image.ownerReference &&
+      borrow.image.search.size == sources.size && borrow.image.searchReads.size == sources.size &&
+      borrow.image.scopes.size == sources.size do
+    throw (IO.userError "borrowed provider changed its complete public boundary")
+  for (reads,source) in borrow.image.searchReads.zip sources do reads.replay source
+  -- Numerical work can overlap graph discovery. Its original traces, counters,
+  -- cursors and owner bitmap arena must not share mutable state with discovery.
+  let sources ← (sources.zip borrow.image.scopes).mapM fun (source,scope) => do
+    SnapshotImage.borrow ⟨source.directory,source.head,source.handle⟩ borrow.pages scope
+  let views ← ((borrow.image.search.zip sources).zip borrow.image.scopes).mapM fun ((image,source),scope) =>
+    image.mapM fun image => image.borrow borrow.pages scope source
+  let owners ← reference.mapM fun reference => do return (reference,← borrow.owners sources reference)
+  KeyedSearchProvider.Captured.borrow sources inputs views owners
+

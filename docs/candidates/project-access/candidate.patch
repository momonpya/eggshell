+module
+
+public import Eggshell.ProjectSources
+public import Eggshell.Config
+
+@[expose] public section
+namespace Eggshell.ProjectAccess
+open Lean DB ProjectStore
+
+structure Write where
+  private mk ::
+  session : String
+  project : Project
+  slot : Fin project.manifest.owners.size
+  routed : slot.val = routeSlot session project.manifest.owners.size
+
+def Write.directory (write : Write) := write.project.directory
+def Write.sourceDirectory (write : Write) := write.project.sourceDirectory write.slot.val
+def Write.original (write : Write) := write.project.manifest.owners[write.slot]
+
+theorem Write.registered (write : Write) :
+    write.original ∈ write.project.manifest.owners.toList := by
+  simp [Write.original]
+
+theorem Write.physical_not_logical (write : Write) :
+    write.original.identity ≠ write.project.manifest.identity := by
+  exact (write.project.checked.2.2.2.2 _ write.registered).2.1
+
+/-- Configured logical projects remain separate from physical source regions.
+Only the explicitly configured write project grants a route. -/
+structure Selection where
+  private mk ::
+  config : Config.Selection
+  reads : Array Project
+  write : Option Write
+  complete : reads.size = config.read.length
+  readDirectories : reads.toList.map (·.directory) = config.read.map (·.path.normalize)
+  writeDirectory : write.map (·.directory) = config.write.map (·.path.normalize)
+
+theorem Selection.only_configured_write (selection : Selection) (route : Write)
+    (selected : selection.write = some route) :
+    ∃ configured, selection.config.write = some configured ∧ route.directory = configured.path.normalize := by
+  have same := selection.writeDirectory
+  rw [selected] at same
+  cases configured : selection.config.write with
+  | none => simp [configured] at same
+  | some target =>
+    refine ⟨target,rfl,?_⟩
+    simpa [configured] using same
+
+theorem Selection.read_only (selection : Selection) (readOnly : selection.config.write = none) :
+    selection.write = none := by
+  have same := selection.writeDirectory
+  rw [readOnly] at same
+  cases selected : selection.write <;> simp_all
+
+private def rejectAliases (projects : Array Project) : IO Unit := do
+  let mut locations : Std.HashMap String (System.FilePath × Manifest) := {}
+  for project in projects do
+    if let some (path,manifest) := locations[project.manifest.identity]? then
+      unless path == project.directory && manifest == project.manifest do
+        throw (IO.userError "one logical project was configured at conflicting locations or inventories")
+    else locations := locations.insert project.manifest.identity (project.directory,project.manifest)
+
+@[no_expose] def resolve (session : String) (config : Config.Selection) : IO Selection := do
+  unless !session.isEmpty && (config.read ++ config.write.toList).all (·.path.isAbsolute) do
+    throw (IO.userError "project selection requires a native session and absolute configured paths")
+  let reads ← config.read.toArray.mapM fun egg => openProject egg.path
+  let write ← config.write.mapM fun egg => do
+    let project ← openProject egg.path
+    let slot := routeSlot session project.manifest.owners.size
+    let bounded := routeSlot_bounded session _ project.inventory_bounded.1
+    return (⟨session,project,⟨slot,bounded⟩,rfl⟩ : Write)
+  rejectAliases (reads ++ write.toArray.map (·.project))
+  if complete : reads.size = config.read.length then
+    if readDirectories : reads.toList.map (·.directory) = config.read.map (·.path.normalize) then
+      if writeDirectory : write.map (·.directory) = config.write.map (·.path.normalize) then
+        return ⟨config,reads,write,complete,readDirectories,writeDirectory⟩
+      else throw (IO.userError "resolved project changed the configured write destination")
+    else throw (IO.userError "resolved projects changed the configured read inventory")
+  else throw (IO.userError "resolved project omitted a configured read database")
+
+/-- The caller retains these views throughout its operation. No warm-state,
+recommendation rank or writable-route filter can remove a read project. -/
+structure ReadSet (selection : Selection) where
+  private mk ::
+  views : Array View
+  complete : views.size = selection.reads.size
+  projects : views.map (·.project.directory) = selection.reads.map (·.directory)
+  manifests : views.map (·.project.manifest) = selection.reads.map (·.manifest)
+
+def ReadSet.sources (set : ReadSet selection) : Array PageMap.Snapshot := set.views.flatMap (·.sources)
+
+theorem ReadSet.no_project_omitted (set : ReadSet selection) :
+    set.views.size = selection.config.read.length := set.complete.trans selection.complete
+
+theorem ReadSet.source_count (set : ReadSet selection) :
+    set.sources.size = (set.views.map fun view => view.project.manifest.owners.size).sum := by
+  simp only [ReadSet.sources,Array.size_flatMap]
+  congr 1
+  apply Array.map_congr_left
+  intro view _
+  exact view.complete
+
+@[no_expose] def pin (selection : Selection) (deadline : Nat) : IO (ReadSet selection) := do
+  let views ← selection.reads.mapM fun project => ProjectStore.pin project deadline
+  if complete : views.size = selection.reads.size then
+    if projects : views.map (·.project.directory) = selection.reads.map (·.directory) then
+      if manifests : views.map (·.project.manifest) = selection.reads.map (·.manifest) then
+        return ⟨views,complete,projects,manifests⟩
+      else throw (IO.userError "project read view changed its configured inventory")
+    else throw (IO.userError "project read view changed its configured location")
+  else throw (IO.userError "project read view omitted a configured database")
+
+end Eggshell.ProjectAccess

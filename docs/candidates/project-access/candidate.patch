+    (receipt : NativePublication.SourceReceipt) : IO NativePublication.Published := do
+  unless request.pending.sessionId == write.session && request.pending.write == some write.directory.toString &&
+      request.target.normalize == write.sourceDirectory && request.identity == some write.original.identity &&

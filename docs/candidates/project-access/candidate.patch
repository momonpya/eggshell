+/-- The selected logical project authorizes one physical ingress route. The
+caller supplies the actual retained read boundary, never a later current cut. -/
+def prepareProject (write : ProjectAccess.Write) (view : ProjectStore.View)
+    (pending : PendingTurn) (checkpoint : Bool) : IO NativePublication.Prepared := do
+  unless pending.sessionId == write.session && pending.write == some write.directory.toString &&
+      view.project.directory == write.directory && view.project.manifest == write.project.manifest do
+    throw (IO.userError "project publication changed its configured session, destination or read inventory")

+def lexicalRanking (work : MemoryCapacity.Input) (prompt : String) (warm : String) : IO Json := do
+  let response ← IO.ofExcept (Json.parse warm >>= fromJson? (α := StudyWarm.Response))
+  let references := response.databases.flatMap fun database => database.sources.filterMap (·.prepared)
+  let snapshot ← DB.PageMap.pin (.mk work.project)
+  let query ← capturedLexicalQuery snapshot (some references) none
+  let population ← Persistence.Store.getNat snapshot.get "candidates"
+  let nominations ← lexicalNominations population query.posting query.ordinal prompt []
+  let reader ← Persistence.Store.NodeReader.new snapshot
+  let mut rows := #[]
+  for (id,rank) in nominations.durableRanking.zipIdx do
+    let owner ← reader.outcome (← reader.locateOutcome id)
+    rows := rows.push (Json.mkObj [("rank",toJson rank),("id",toJson id),
+      ("owner",toJson (relationKey owner.relation)),("work",toJson (relationKey owner.work)),
+      ("nominated",toJson (nominations.durable.contains id))])
+  return Json.arr rows

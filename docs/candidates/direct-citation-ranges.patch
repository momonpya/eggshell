--- a/tools/DirectCitationTests.lean
+++ b/tools/DirectCitationTests.lean
@@ -0,0 +1,58 @@
+import Eggshell.Handoff
+open Lean Eggshell Eggshell.Plugin
+private def check (value : Bool) (message : String) : IO Unit :=
+  unless value do throw (IO.userError message)
+private def nativeOwner (source : String) : OutcomeEdge :=
+  let work := Value.text "read immutable source"
+  let result := Value.text source
+  let observation := Value.applyList .occurrence [.semantic result,.semantic work,.exact (.text "observed")]
+  OutcomeEdge.make work result [observation] (by simp) (by simp [maxOutcomeObservations])
+def main : IO Unit := do
+  let text := "\n".intercalate ((List.range 36).map fun i =>
+    toString (10+i) ++ "\t" ++ String.ofList (List.replicate 180 'a') ++ " 条件🧪")
+  let source := (toJson text).compress
+  let owner := nativeOwner source
+  let record : SourceEvidence.Record := {
+    workspace := "/unused",files := [{relative := "src/example.cpp",content := none}]
+    complete := false}
+  let some (_,positions,ranks,groups) := rankedCitedObservationCoordinates
+      [(3,"[example.cpp:12-13](/unused/src/example.cpp:12)")] owner [record] |
+    throw (IO.userError "complete original citation disappeared")
+  check (groups.length == 1 && groups.all (fun row => row.1 == 3))
+    "citation source rows or real producer rank vanished"
+  let template : TransportSlice := {owner := some owner.relation,keys := [],text := "",members := [],visibleKeys := []}
+  let some part := (prepareContextualOwnerPlan [] positions owner "source conditions" [] template).eval 120000 |
+    throw (IO.userError "source envelope could not be prepared")
+  let family : SharedRangeAdapter.Family := {
+    owner := owner
+    windows := []
+    references := positions
+    referenceRanks := ranks
+    referenceRanges := groups
+    template := {template with context := part.context,text := part.text,keys := part.keys}}
+  let (units,_) := SharedRangeAdapter.prepare 0 family
+  let some envelope := part.context | throw (IO.userError "missing original envelope")
+  let exact := groups.flatMap (·.2)
+  check (units.any fun unit => exact.all (fun (a,b) =>
+      let first := max 1 a
+      let last := min (source.length-1) b
+      SharedRangeAdapter.covers unit.ranges first last) &&
+      (unit.ranges.map fun (a,b) => b-a).sum < 1024)
+    "literal source rows were inflated to a fixed surrounding window"
+  for unit in units do
+    check unit.slice.members.isEmpty "a citation created a native-control member"
+    let some context := unit.slice.context | throw (IO.userError "source context vanished")
+    check (decide (context.sameEnvelope envelope)) "citation changed source status or provenance"
+    check (context.cues.all fun (a,b) => SharedRangeAdapter.covers unit.ranges a b)
+      "a quote received credit for undispatched source"
+    for fragment in context.fragments do
+      check (fragment.original == ((source.drop fragment.first).take fragment.original.length).copy)
+        "a quote rewrote original source or mixed decoded coordinates"
+  let sparse := nativeOwner "10\ta\n11\tb\n14\tc\n15\td"
+  let some (_,_,_,partialGroups) := rankedCitedObservationCoordinates
+      [(0,"[example.cpp:10-15](/unused/src/example.cpp:10)")] sparse [record] |
+    throw (IO.userError "partial citation lost its bounded window hints")
+  check partialGroups.isEmpty "a missing stored row was invented to complete a citation"
+  check ((SharedRangeAdapter.citationRecordRanges source [(0,source.length+1)]).isNone)
+    "a citation escaped the original source"
+  IO.println s!"direct citation offers={units.length}; original range, complete-row, Unicode, envelope and authority checks passed"

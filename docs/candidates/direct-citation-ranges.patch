+/-- A source record keeps its original paragraph and bounded scope entry.
+The fixed-width surrounding display is an enrichment, not a prerequisite of
+this smaller advisory offer. This creates no Match or completion authority. -/
+def recordPrerequisite (records : List (ContextSpan source))
+    (heads scopedHeads : List (Nat × Option Nat)) (record : EvidenceRange source) :
+    EvidenceRange source :=
+  let prior := prerequisiteContextRange records heads record
+  let scope := prerequisiteContextRange records scopedHeads record
+  if valid : scope.start < prior.start ∧ prior.stop-scope.start ≤ 2048 then
+    ⟨scope.start,prior.stop,Nat.lt_trans valid.1 prior.ordered,prior.within,valid.2⟩
+  else prior
+
+theorem record_prerequisite_retains_source (records : List (ContextSpan source))
+    (heads scopedHeads : List (Nat × Option Nat)) (record : EvidenceRange source)
+    (position : Nat) (inside : record.covers position) :
+    (recordPrerequisite records heads scopedHeads record).covers position := by
+  have retained := prerequisite_context_keeps_cue records heads record position inside
+  unfold recordPrerequisite
+  dsimp only
+  split
+  · rename_i valid
+    change _ ≤ position ∧ position < (prerequisiteContextRange records heads record).stop
+    exact ⟨Nat.le_trans (Nat.le_of_lt valid.1) retained.1,retained.2⟩
+  · exact retained
+
+/-- Preserve all finite stored rows of a citation in bounded original
+ranges. Joining adjacent rows adds no surrounding window or unobserved byte. -/
+def citationRecordRanges (source : String) (spans : List (Nat × Nat)) :
+    Option (List (EvidenceRange source)) := do
+  let mut combined : Array (Nat × Nat) := #[]
+  for (first,last) in (spans.eraseDups.mergeSort fun a b => a.1 ≤ b.1) do
+    if first < last ∧ last ≤ source.length ∧ last-first ≤ 2048 then
+      match combined.back? with
+      | some (a,b) =>
+          if first ≤ b && max b last-a ≤ 2048 then
+            combined := combined.pop.push (a,max b last)
+          else combined := combined.push (first,last)
+      | none => combined := combined.push (first,last)
+    else none
+  combined.toList.mapM fun (first,last) =>
+    if valid : first < last ∧ last ≤ source.length ∧ last-first ≤ 2048 then
+      some (⟨first,last,valid.1,valid.2.1,valid.2.2⟩ : EvidenceRange source)
+    else none
 

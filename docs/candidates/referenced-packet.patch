+import Eggshell.Handoff
+open Eggshell Eggshell.Plugin
+private def require (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+def main : IO Unit := do
+  let first : ContextDelivery := {
+    owner := "original", outcome := "result", sourceChars := 20
+    cues := [(0,3)], leading := "scope\n", trailing := "\nend"
+    fragments := [{first := 0, original := "cue"}]}
+  let citation : ContextDelivery := {first with
+    cues := [(10,14)], fragments := [{first := 10, original := "more"}]}
+  let rich : ContextDelivery := {first with
+    cues := [(3,6)], fragments := [{first := 3, original := "old"}]}
+  let make := fun (c : ContextDelivery) =>
+    ({owner := some (.text "original"), keys := c.keys, text := c.render,
+      members := [], visibleKeys := [], context := some c} : TransportSlice)
+  let original := (make first,[make rich])
+  let plan := referencedContextPlan original [make citation]
+  require (plan.1.text == original.1.text) "The original minimum changed"
+  let some final := (plan.2.getLast?.getD plan.1).context |
+    throw (IO.userError "Original context disappeared")
+  for pair in [(0,"cue"),(3,"old"),(10,"more")] do
+    require (final.fragments.any fun f => f.first == pair.1 && f.original == pair.2)
+      "A later alternative evicted earlier observed bytes"
+  require (plan.2.all fun slice => slice.members.isEmpty && slice.visibleKeys.isEmpty)
+    "Citation context created control"
+  let conflict := {citation with fragments := [{first := 0, original := "bad"}]}
+  let rejected := referencedContextPlan (make first,[]) [make conflict]
+  require (rejected.2.isEmpty) "Conflicting original bytes were accepted"
+  let foreign := {citation with owner := "other"}
+  require ((referencedContextPlan (make first,[]) [make foreign]).2.isEmpty)
+    "A citation crossed the original owner envelope"
+  IO.println "referenced packet: minimum retained, original-coordinate union, conflict/envelope rejection and no control passed"

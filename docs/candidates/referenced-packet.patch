+import Eggshell.Handoff
+open Eggshell Eggshell.Plugin
+private def require (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+def main : IO Unit := do
+  require (citedLineNumbers ["[ref](/root/pkg/α.cc:17), pkg/α.cc#L23"] "pkg/α.cc" == [17,23])
+    "Recorded relative locators did not resolve"
+  require ((citedLineNumbers ["../outside:9"] "../outside").isEmpty)
+    "An escaping locator was admitted"
+  require (observedLineNumber? "   128\tdata" == some (128,'\t')) "Numbered tab row lost"
+  require (observedLineNumber? "plain text" == none) "Prose became a numbered source row"
+  let text := "   17\tfirst\n   18\tsecond\n   90\tother\n   91\tlast\n"
+  let source := (Lean.toJson text).compress
+  let layout := (decodedToolText? source).map DecodedLayout.make
+  let groups := observedNumberedSegments source layout
+  require (groups.map Prod.snd == [[17,18],[90,91]]) "Independent read ranges were merged"
+  require (groups.all fun item => item.1.start < item.1.stop && item.1.stop ≤ source.length)
+    "A hint left the original scalar"
+  let spans := contextRecordSpans source layout
+  require (groups.head?.map (·.1.start) == spans.head?.map (·.start)) "JSON offset changed"
+  IO.println "cited sources: dependency locators, original escaped offsets and independent read ranges passed"

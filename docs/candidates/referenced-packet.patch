+import Eggshell.Handoff
+open Eggshell Eggshell.Plugin
+private def require (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+def main : IO Unit := do
+  require (literalReadRange? "sed -n '17,19p' pkg/α.cc" == some ("pkg/α.cc",17,19))
+    "A literal read lost its recorded coordinates"
+  require (literalReadRange? "sed -n '1,$p' pkg/α.cc" == none) "An open range was guessed"
+  require (literalReadRange? "sed -n '1,2p' $(secret)" == none) "An expanded path was admitted"
+  let command := "sed -n '17,19p' pkg/α.cc\nsed -n '90,91p' pkg/β.cc\nunknown command\nsed -n '1,2p' later"
+  let work := "native tool\n" ++ (Lean.Json.mkObj [("command",Lean.toJson command)]).compress
+  require (nativeReadPrefix work == [("pkg/α.cc",17,19),("pkg/β.cc",90,91)])
+    "Unknown output did not stop the projected prefix"
+  let source := (Lean.toJson "first\nsecond\nthird\nfourth\nfifth\nextra\n").compress
+  let layout := (decodedToolText? source).map DecodedLayout.make
+  let records : List SourceEvidence.Record := [{
+    workspace := "example"
+    complete := true
+    files := [{relative := "pkg/α.cc",content := none},{relative := "pkg/β.cc",content := none}]}]
+  let projected := nativeReadRows source layout work records
+  require (projected.map Prod.snd == [17,18,19,90,91]) "Independent read offsets were lost"
+  require (projected.all fun (span,_) => span.start < span.stop && span.stop ≤ source.length)
+    "A metadata hint escaped the original scalar"
+  require ((nativeReadRows source layout work []).isEmpty) "An unrecorded dependency was used"
+  IO.println "native read context: literal ranges, safe dependency binding, original row bounds and unknown-prefix stop passed"

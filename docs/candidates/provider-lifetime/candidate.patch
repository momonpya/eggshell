+/-- A transport can request only positions in the caller's current corpus.
+The same repair and response checker serve pipes and built-in typed calls. -/
+def withTaskResponseDeadline (action : IO α) (budgetMs : Nat := 15000) : IO α := do
+  let deadline := (← IO.monoMsNow)+budgetMs
+  TaskDeadline.ensureLive deadline
+  let task ← IO.asTask action .dedicated
+  try TaskDeadline.wait task deadline
+  finally
+    if !(← IO.hasFinished task) then IO.cancel task
+    discard <| IO.wait task
+
+abbrev IndexedRepair := Nat → List Nat → IO (List String)
+abbrev IndexedExchange := Json → IndexedRepair → IO Json
+
+def indexedProcess (command : List String) : IndexedExchange := fun request repair =>
+  withProvider command fun running => withResponseDeadline running do
+    write running (request.compress++"\n")
+    let mut json ← IO.ofExcept (Json.parse (← running.child.stdout.getLine))
+    while let .ok need := json.getObjVal? "need_windows" do
+      let document ← IO.ofExcept (need.getObjValAs? Nat "document")
+      let indices ← IO.ofExcept (need.getObjValAs? (List Nat) "indices")
+      let texts ← repair document indices
+      write running ((Json.mkObj [("windows",toJson texts)]).compress++"\n")
+      json ← IO.ofExcept (Json.parse (← running.child.stdout.getLine))
+    return json
+
+def nominateIndexedUsing (exchange : IndexedExchange) (queryText : String)

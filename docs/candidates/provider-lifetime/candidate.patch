+module
+public import Eggshell.KeyedSearchProvider
+@[expose] public section
+namespace Eggshell.BuiltinSearch
+open Lean
+
+/-- A configured external executable is never silently treated as this
+builtin, even if its subcommand happens to have the same spelling. -/
+def arguments? (command : List String) (kind : String) : IO (Option (List String)) := do
+  let executable :: selected :: arguments := command | return none
+  if selected != kind then return none
+  let path := System.FilePath.mk executable
+  unless path.isAbsolute do return none
+  let current ← IO.FS.realPath (← IO.appPath)
+  let supplied ← try some <$> IO.FS.realPath path catch _ => pure none
+  return if supplied == some current then some arguments else none
+
+/-- Join the real operation after cancellation; a returning borrower cannot
+leave a live numerical request or a temporary question store behind. -/
+def bounded (action : IO α) (budgetMs : Nat := 15000) : IO α :=
+  SemanticMatcher.withTaskResponseDeadline action budgetMs
+
+def withRuntime (arguments : List String) (action : SearchProvider.Options → Option SearchProvider.Encoder → IO α) : IO α :=
+  bounded <| IO.FS.withTempDir fun scratch => do
+    let scratch ← IO.FS.realPath scratch
+    let layout := MiniLM.layout (← Paths.installRoot)
+    let options ← IO.ofExcept (SearchProvider.parse {
+      cache := scratch,queryTemporary := some (scratch/"queries"),models := layout.models} arguments)
+    let child ← if options.mode == "lexical" then pure none else some <$> SearchProvider.encoder options
+    try action options child
+    finally if let some child := child then SearchProvider.stopEncoder child
+
+def keyed (command : List String) (request : KeyedProtocol.Request) : IO Json := do
+  if let some arguments ← arguments? command "keyed-search-provider" then
+    Receipt.observe request.receipt "provider-keyed-profile" (Json.mkObj [
+      ("transport",toJson "typed"),("sources",toJson request.sources.size)])
+    return ← withRuntime arguments fun options child => KeyedSearchProvider.handle options child request
+  Receipt.observe request.receipt "provider-keyed-profile" (Json.mkObj [("transport",toJson "process")])
+  SemanticMatcher.withProvider command fun running => SemanticMatcher.withResponseDeadline running do
+    SemanticMatcher.write running ((toJson request).compress++"\n")
+    IO.ofExcept (Json.parse (← running.child.stdout.getLine))
+
+def indexed (command : List String) : SemanticMatcher.IndexedExchange := fun request repair => do
+  let receipt := (request.getObjValAs? String "receipt").toOption.filter Receipt.validId
+  if let some arguments ← arguments? command "search-provider" then
+    Receipt.observe receipt "provider-indexed-profile" (Json.mkObj [("transport",toJson "typed")])
+    return ← withRuntime arguments fun options child => do
+      let query ← IO.ofExcept ((request.getObjValD "query").getObjValAs? String "text")
+      SearchProvider.handleIndexed options child query request (fun document windows => repair document (windows.map Prod.fst))
+  Receipt.observe receipt "provider-indexed-profile" (Json.mkObj [("transport",toJson "process")])
+  SemanticMatcher.indexedProcess command request repair
+
+def nominateIndexed (command : List String) (queryText : String)
+    (documents : List Persistence.Store.SearchDocument) (lexical anchors : List Nat)
+    (readWindow : SemanticMatcher.WindowReader) (allowDurableRepair : Bool := false)
+    (receipt : Option String := none) (purpose : String := "discovery") (preparedInputs : Option Json := none) :
+    IO (Option (SemanticMatcher.IndexedSearch documents)) :=
+  SemanticMatcher.nominateIndexedUsing (indexed command) queryText documents lexical anchors readWindow
+    allowDurableRepair receipt purpose preparedInputs
+
+end Eggshell.BuiltinSearch

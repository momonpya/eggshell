+partial def awaitReady (session : String) (deadline : Nat) : IO Endpoint := do
+  check deadline
+  if let some endpoint ← ready? session then return endpoint
+  IO.sleep (UInt32.ofNat (min 10 (deadline-(← IO.monoMsNow))))
+  awaitReady session deadline
+
+/-- Called only by the winner of the existing OS startup guard. Waiters never
+need this guard once that winner has published its ready endpoint. -/
+def startOwned (session : String) (deadline : Nat) : IO Endpoint := do
+  check deadline
+  if let some endpoint ← ready? session then return endpoint
+  try
+    let stale ← loadEndpoint session
+    let _ ← exchangeBefore stale "shutdown" Json.null (min deadline ((← IO.monoMsNow)+250))
+  catch _ => pure ()
+  check deadline
+  removeIfExists (← endpointPath)
+  spawn session
+  awaitReady session deadline
+
+partial def observeOrStart (session : String) (deadline : Nat) (guard : IO.FS.Handle) : IO Endpoint := do
+  check deadline
+  if let some endpoint ← ready? session then return endpoint
+  if ← guard.tryLock then
+    try startOwned session deadline finally guard.unlock
+  else
+    IO.sleep (UInt32.ofNat (min 10 (deadline-(← IO.monoMsNow))))
+    observeOrStart session deadline guard
+
+end Startup
+
+/-- All cold-start contenders observe the same endpoint without queueing for
+the winner's lock. Only a starter owns that existing guard. No short secondary
+admission budget can discard a request before its original deadline. -/
+def ensureBefore (session : String) (deadline : Nat) : IO Endpoint := do
+  Startup.check deadline
+  if let some endpoint ← Startup.ready? session then return endpoint
+  let path ← startupLock
+  Persistence.rejectSymlinkAncestors path
+  let lock := Persistence.lockPath path
+  Persistence.rejectSymlinkAncestors lock
+  if let some parent := lock.parent then
+    if !(← parent.pathExists) then Persistence.privateDirectory parent
+  let guard ← IO.FS.Handle.mk lock .append
+  Persistence.privateFile lock
+  Startup.observeOrStart session deadline guard
+
+def ensure (session : String) : IO Endpoint := do
+  ensureBefore session ((← IO.monoMsNow)+24000)
 

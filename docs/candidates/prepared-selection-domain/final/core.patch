+def step (fileIds : Std.HashMap Synapses.File Nat) (sourceIds : Std.HashMap Synapses.CanonicalSource.Key Nat)
+    (state : Costs × Payloads) (unit : UnitPlan) : Option ((Costs × Payloads) × List Nat) := do
+  let mut costs := state.1
+  let mut payloads := state.2
+  if let some shared := unit.slice.shared then
+    let mut closure := [unit.family]
+    for row in shared.rows do
+      let file ← fileIds[row.key.file]?
+      let payload ← sourceIds[row.key]?
+      closure := file :: payload :: closure
+    return ((costs,payloads),closure)
+  let parts := match unit.slice.context with
+    | none => [(none,unit.slice.text)]
+    | some context => context.fragments.map fun (fragment : DeliveryFragment) =>
+        (some (fragment.first,fragment.original,fragment.decoded),fragment.render context.compactCaptions)
+  let mut closure := [unit.family]
+  for (fragment,text) in parts do
+    let key := (unit.family,fragment)
+    let index := payloads[key]?.getD costs.size
+    if index == costs.size then
+      costs := costs.push (text.length+1,text.utf8ByteSize+1)
+      payloads := payloads.insert key index
+    closure := closure ++ [index]
+  return ((costs,payloads),closure)

+module
+public import Std
+@[expose] public section
+
+namespace Eggshell.LinearOutput
+
+variable {α β σ τ : Type}
+
+/-- A reference stateful output log; the tail append is intentionally explicit. -/
+def append (step : σ → α → Option (σ × β)) : List α → σ → List β → Option (σ × List β)
+  | [],state,rows => some (state,rows)
+  | value :: rest,state,rows => do
+    let (next,row) ← step state value
+    append step rest next (rows ++ [row])
+
+def prepend (step : σ → α → Option (σ × β)) : List α → σ → List β → Option (σ × List β)
+  | [],state,rows => some (state,rows)
+  | value :: rest,state,rows => do
+    let (next,row) ← step state value
+    prepend step rest next (row :: rows)
+
+theorem reversed_log (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :
+    append step values state rows.reverse =
+      (prepend step values state rows).map (fun result => (result.1,result.2.reverse)) := by
+  induction values generalizing state rows with
+  | nil => rfl
+  | cons value rest ih =>
+    cases outcome : step state value with
+    | none => simp [append,prepend,outcome]
+    | some result =>
+      rcases result with ⟨next,row⟩
+      simpa [append,prepend,outcome,List.reverse_cons] using ih next (row :: rows)
+
+def prepared (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :
+    Option (σ × List β) :=
+  (prepend step values state rows.reverse).map (fun result => (result.1,result.2.reverse))
+
+theorem append_prepared (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :
+    append step values state rows = prepared step values state rows := by
+  simpa only [prepared,List.reverse_reverse] using reversed_log step values state rows.reverse
+
+def loop (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :
+    Option (σ × List β) := do
+  let mut state := state
+  let mut rows := rows
+  for value in values do
+    let (next,row) ← step state value
+    state := next
+    rows := rows ++ [row]
+  return (state,rows)
+
+theorem loop_cons (step : σ → α → Option (σ × β)) (value : α) (rest : List α) (state : σ) (rows : List β) :
+    loop step (value :: rest) state rows = (do
+      let (next,row) ← step state value
+      loop step rest next (rows ++ [row])) := by
+  cases outcome : step state value with
+  | none => simp [loop,outcome]
+  | some result =>
+    rcases result with ⟨next,row⟩
+    simp [loop,outcome]
+
+theorem append_loop (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :
+    append step values state rows = loop step values state rows := by
+  induction values generalizing state rows with
+  | nil => rfl
+  | cons value rest ih =>
+    rw [append,loop_cons]
+    cases step state value <;> simp [ih]
+
+@[csimp] theorem loop_compiled : @loop = @prepared := by
+  funext α β σ step values state rows
+  rw [← append_loop,append_prepared]
+
+/-- A pair of mutable preparation fields keeps the original loop's state
+layout. Its output log still has the single shared linear implementation. -/
+def pairLoop (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)
+    (left : σ) (right : τ) (rows : List β) : Option (σ × τ × List β) := do
+  let mut left := left
+  let mut right := right
+  let mut rows := rows
+  for value in values do
+    let (next,row) ← step (left,right) value
+    left := next.1
+    right := next.2
+    rows := rows ++ [row]
+  return (left,right,rows)
+
+theorem pairLoop_cons (step : (σ × τ) → α → Option ((σ × τ) × β)) (value : α) (rest : List α)
+    (left : σ) (right : τ) (rows : List β) :
+    pairLoop step (value :: rest) left right rows = (do
+      let (next,row) ← step (left,right) value
+      pairLoop step rest next.1 next.2 (rows ++ [row])) := by
+  cases outcome : step (left,right) value with
+  | none => simp [pairLoop,outcome]
+  | some result =>
+    rcases result with ⟨⟨nextLeft,nextRight⟩,row⟩
+    simp [pairLoop,outcome]
+
+theorem pair_loop_agrees (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)
+    (left : σ) (right : τ) (rows : List β) :
+    pairLoop step values left right rows =
+      (loop step values (left,right) rows).map (fun result => (result.1.1,result.1.2,result.2)) := by
+  induction values generalizing left right rows with
+  | nil => rfl
+  | cons value rest ih =>
+    rw [pairLoop_cons,loop_cons]
+    cases outcome : step (left,right) value with
+    | none => simp
+    | some result =>
+      rcases result with ⟨⟨nextLeft,nextRight⟩,row⟩
+      simpa [outcome] using ih nextLeft nextRight (rows ++ [row])
+
+def pairPrepared (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)
+    (left : σ) (right : τ) (rows : List β) : Option (σ × τ × List β) :=
+  (prepared step values (left,right) rows).map (fun result => (result.1.1,result.1.2,result.2))
+
+@[csimp] theorem pair_loop_compiled : @pairLoop = @pairPrepared := by
+  funext α β σ τ step values left right rows
+  rw [pair_loop_agrees,loop_compiled]
+  rfl
+
+end Eggshell.LinearOutput

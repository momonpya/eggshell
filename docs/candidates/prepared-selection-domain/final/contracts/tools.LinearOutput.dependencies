[["Std","[\"/Users/ovm/.elan/toolchains/leanprover--lean4---v4.33.0\",\"Std\"]"],["tools.LinearOutput","[\"module\\npublic import Std\\n@[expose] public section\\n\\nnamespace Eggshell.LinearOutput\\n\\nvariable {α β σ τ : Type}\\n\\n/-- A reference stateful output log; the tail append is intentionally explicit. -/\\ndef append (step : σ → α → Option (σ × β)) : List α → σ → List β → Option (σ × List β)\\n  | [],state,rows => some (state,rows)\\n  | value :: rest,state,rows => do\\n    let (next,row) ← step state value\\n    append step rest next (rows ++ [row])\\n\\ndef prepend (step : σ → α → Option (σ × β)) : List α → σ → List β → Option (σ × List β)\\n  | [],state,rows => some (state,rows)\\n  | value :: rest,state,rows => do\\n    let (next,row) ← step state value\\n    prepend step rest next (row :: rows)\\n\\ntheorem reversed_log (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    append step values state rows.reverse =\\n      (prepend step values state rows).map (fun result => (result.1,result.2.reverse)) := by\\n  induction values generalizing state rows with\\n  | nil => rfl\\n  | cons value rest ih =>\\n    cases outcome : step state value with\\n    | none => simp [append,prepend,outcome]\\n    | some result =>\\n      rcases result with ⟨next,row⟩\\n      simpa [append,prepend,outcome,List.reverse_cons] using ih next (row :: rows)\\n\\ndef prepared (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    Option (σ × List β) :=\\n  (prepend step values state rows.reverse).map (fun result => (result.1,result.2.reverse))\\n\\ntheorem append_prepared (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    append step values state rows = prepared step values state rows := by\\n  simpa only [prepared,List.reverse_reverse] using reversed_log step values state rows.reverse\\n\\ndef loop (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    Option (σ × List β) := do\\n  let mut state := state\\n  let mut rows := rows\\n  for value in values do\\n    let (next,row) ← step state value\\n    state := next\\n    rows := rows ++ [row]\\n  return (state,rows)\\n\\ntheorem loop_cons (step : σ → α → Option (σ × β)) (value : α) (rest : List α) (state : σ) (rows : List β) :\\n    loop step (value :: rest) state rows = (do\\n      let (next,row) ← step state value\\n      loop step rest next (rows ++ [row])) := by\\n  cases outcome : step state value with\\n  | none => simp [loop,outcome]\\n  | some result =>\\n    rcases result with ⟨next,row⟩\\n    simp [loop,outcome]\\n\\ntheorem append_loop (step : σ → α → Option (σ × β)) (values : List α) (state : σ) (rows : List β) :\\n    append step values state rows = loop step values state rows := by\\n  induction values generalizing state rows with\\n  | nil => rfl\\n  | cons value rest ih =>\\n    rw [append,loop_cons]\\n    cases step state value <;> simp [ih]\\n\\n@[csimp] theorem loop_compiled : @loop = @prepared := by\\n  funext α β σ step values state rows\\n  rw [← append_loop,append_prepared]\\n\\n/-- A pair of mutable preparation fields keeps the original loop's state\\nlayout. Its output log still has the single shared linear implementation. -/\\ndef pairLoop (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)\\n    (left : σ) (right : τ) (rows : List β) : Option (σ × τ × List β) := do\\n  let mut left := left\\n  let mut right := right\\n  let mut rows := rows\\n  for value in values do\\n    let (next,row) ← step (left,right) value\\n    left := next.1\\n    right := next.2\\n    rows := rows ++ [row]\\n  return (left,right,rows)\\n\\ntheorem pairLoop_cons (step : (σ × τ) → α → Option ((σ × τ) × β)) (value : α) (rest : List α)\\n    (left : σ) (right : τ) (rows : List β) :\\n    pairLoop step (value :: rest) left right rows = (do\\n      let (next,row) ← step (left,right) value\\n      pairLoop step rest next.1 next.2 (rows ++ [row])) := by\\n  cases outcome : step (left,right) value with\\n  | none => simp [pairLoop,outcome]\\n  | some result =>\\n    rcases result with ⟨⟨nextLeft,nextRight⟩,row⟩\\n    simp [pairLoop,outcome]\\n\\ntheorem pair_loop_agrees (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)\\n    (left : σ) (right : τ) (rows : List β) :\\n    pairLoop step values left right rows =\\n      (loop step values (left,right) rows).map (fun result => (result.1.1,result.1.2,result.2)) := by\\n  induction values generalizing left right rows with\\n  | nil => rfl\\n  | cons value rest ih =>\\n    rw [pairLoop_cons,loop_cons]\\n    cases outcome : step (left,right) value with\\n    | none => simp\\n    | some result =>\\n      rcases result with ⟨⟨nextLeft,nextRight⟩,row⟩\\n      simpa [outcome] using ih nextLeft nextRight (rows ++ [row])\\n\\ndef pairPrepared (step : (σ × τ) → α → Option ((σ × τ) × β)) (values : List α)\\n    (left : σ) (right : τ) (rows : List β) : Option (σ × τ × List β) :=\\n  (prepared step values (left,right) rows).map (fun result => (result.1.1,result.1.2,result.2))\\n\\n@[csimp] theorem pair_loop_compiled : @pairLoop = @pairPrepared := by\\n  funext α β σ τ step values left right rows\\n  rw [pair_loop_agrees,loop_compiled]\\n  rfl\\n\\nend Eggshell.LinearOutput\\n\",[]]"]]
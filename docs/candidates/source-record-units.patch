--- a/tools/SourceRecordTests.lean
+++ b/tools/SourceRecordTests.lean
@@ -0,0 +1,56 @@
+import Eggshell.Handoff
+open Lean Eggshell Eggshell.Plugin
+private def check (value : Bool) (message : String) : IO Unit :=
+  unless value do throw (IO.userError message)
+private def nativeOwner (work source : String) : OutcomeEdge :=
+  let invocation := Value.text work
+  let result := Value.text source
+  let occurrence := Value.applyList .occurrence [.semantic result,.semantic invocation,.exact (.text "record")]
+  OutcomeEdge.make invocation result [occurrence] (by simp) (by simp [maxOutcomeObservations])
+def main : IO Unit := do
+  let lines := (List.range 60).flatMap fun n =>
+    [s!"{n*4+1}\tvoid item_{n}() " ++ "{",s!"{n*4+2}\t  if (ready) emit(\"条件🧪\");",s!"{n*4+3}\t" ++ "}",s!"{n*4+4}\t"]
+  let source := (toJson ("\n".intercalate lines)).compress
+  let work := "read immutable source ranges"
+  let owner := nativeOwner work source
+  check (Matcher.nativeOutcome owner) "fixture lost its original native occurrence"
+  let original : TransportSlice := {owner := some owner.relation,keys := [],text := "",members := [],visibleKeys := []}
+  let positions := [0,1,2]
+  let some part := (prepareContextualOwnerPlan [] positions owner "source status" [] original).eval 120000 |
+    throw (IO.userError "could not prepare source envelope")
+  let family : SharedRangeAdapter.Family := {
+    owner := owner
+    windows := positions
+    template := {original with text := part.text,keys := part.keys,context := part.context}}
+  let (units,cues) := SharedRangeAdapter.prepare 0 family
+  check (!units.isEmpty && !cues.isEmpty) "original source nominations vanished"
+  check (units.any fun unit => (unit.ranges.map fun (a,b) => b-a).sum < 512)
+    "complete small source records still require a fixed surrounding window"
+  let some envelope := family.template.context | throw (IO.userError "missing source envelope")
+  for unit in units do
+    check (unit.slice.members.isEmpty && unit.slice.visibleKeys == family.template.visibleKeys)
+      "an advisory source record changed native authority"
+    let some context := unit.slice.context | throw (IO.userError "source context disappeared")
+    check (decide (context.sameEnvelope envelope)) "a record changed provenance or source status"
+    check (context.cues.all fun (a,b) => SharedRangeAdapter.covers unit.ranges a b)
+      "a record received value for undispatched original data"
+    for fragment in context.fragments do
+      check (fragment.original == ((source.drop fragment.first).take fragment.original.length).copy)
+        "a source record was rewritten or used decoded offsets as raw coordinates"
+      if fragment.decoded then
+        check (Json.parse ("\"" ++ fragment.original ++ "\"")).isOk
+          "a record split a JSON escape or Unicode scalar"
+  let some layout := (decodedToolText? source).map DecodedLayout.make |
+    throw (IO.userError "fixture is not a canonical string scalar")
+  let records := contextRecordSpans source (some layout)
+  let heads := contextStructureHeads source (some layout)
+  let scopeHeads := contextStructureHeads source (some layout) true
+  let mut checked := 0
+  for record in records do
+    if bounds : record.start < record.stop ∧ record.stop ≤ source.length ∧ record.stop-record.start ≤ 2048 then
+      let range : EvidenceRange source := ⟨record.start,record.stop,bounds.1,bounds.2.1,bounds.2.2⟩
+      let prior := SharedRangeAdapter.recordPrerequisite records heads scopeHeads range
+      check (prior.start ≤ range.start && range.stop ≤ prior.stop && prior.stop-prior.start ≤ 2048)
+        "a record lost its requested source or exceeded the bounded prerequisite"
+      checked := checked+1
+  IO.println s!"source-record offers={units.length}; raw/Unicode/authority/envelope checks; prerequisites={checked}"

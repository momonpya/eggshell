+/-- Every request owns its pipe until the response read has joined. Only a
+failed owner retires that encoder; other in-flight encoders remain live. -/
+def encodePipe (child : Kernel) (body : String) (deadline : Nat) (live : IO Bool)
+    (retire : IO Unit) (mark : String → IO Unit := fun _ => pure ()) : IO String := do
+  let running ← IO.asTask (do
+    mark "encode-pipe-write:start"
+    child.stdin.putStr (if body.endsWith "\n" then body else body++"\n")
+    child.stdin.flush
+    mark "encode-pipe-write:end"
+    mark "encode-line-read:start"
+    let result ← child.stdout.getLine
+    mark "encode-line-read:end"
+    return result) .dedicated
+  let ready ← TaskDeadline.event running
+  try
+    repeat
+      let now ← IO.monoMsNow
+      unless (← live) && now < deadline do throw (IO.userError "encoder pipe expired or disconnected")
+      let result ← TaskDeadline.awaitEvent (do
+        let timer ← Selector.sleep (.ofNat (min 5 (deadline-now)))
+        Research.OwnedSelect.one #[.case ready (fun value => pure (some value)),.case timer (fun _ => pure none)])
+      if let some value := result then
+        discard <| IO.wait running
+        unless !value.isEmpty do throw (IO.userError "numerical encoder closed its response")
+        return value
+    throw (IO.userError "unreachable encoder wait")
+  catch error =>
+    try retire finally discard <| IO.wait running
+    throw error
+

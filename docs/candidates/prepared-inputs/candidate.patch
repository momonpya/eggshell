+module
+public import Eggshell.CanonicalSourceCache
+public import Eggshell.UsageCache
+public import Eggshell.WindowOwners
+public import PartitionBuild
+public import tools.RetrievalIndex
+@[expose] public section
+
+namespace Eggshell.PreparedInputs
+open Lean DB Persistence.Store
+
+def implementation : String := Sha256.hex ((include_str "PreparedInputs.lean").toUTF8 ++
+  RetrievalResearch.Index.contract.toUTF8 ++ WindowOwners.implementation.toUTF8 ++
+  PartitionBuild.implementation.toUTF8 ++ Synapses.CanonicalSource.Cache.implementation.toUTF8 ++
+  Synapses.UsageCache.implementation.toUTF8)
+
+structure Root where
+  storage : Sidecar.Storage
+  head : PageMap.Head
+  deriving BEq,ToJson,FromJson
+
+structure Numeric where
+  storage : Sidecar.Storage
+  partition : PageMap.Head
+  matrix : PageMap.Head
+  deriving BEq,ToJson,FromJson
+
+/-- Publication metadata only: no question, ranking, original body or token. -/
+structure Reference where
+  producer : String
+  source : PageMap.Head
+  model : String
+  encoder : String
+  population : Nat
+  windows : Option Root
+  lexical : Option Root
+  numeric : Option Numeric
+  canonical : Option (Sidecar.Storage × Synapses.CanonicalSource.Cache.Manifest)
+  shared : Option Root
+  usage : Option PageMap.Head := none
+  deriving BEq,ToJson,FromJson
+
+def Reference.accepts (reference : Reference) (source : PageMap.Snapshot) (model encoder : String) : Bool :=
+  reference.producer == implementation && decide (reference.source = source.head) &&
+  reference.model == model && reference.encoder == encoder
+
+theorem Reference.same_source (reference : Reference) (source : PageMap.Snapshot) (model encoder : String)
+    (accepted : reference.accepts source model encoder = true) : reference.source = source.head := by
+  simp only [accepts,Bool.and_eq_true,decide_eq_true_eq] at accepted
+  exact accepted.1.1.2
+
+def empty (source : PageMap.Snapshot) (model encoder : String) : Reference := {
+  producer := implementation,source := source.head,model,encoder,population := 0
+  windows := none,lexical := none,numeric := none,canonical := none,shared := none}
+
+def restore (path : System.FilePath) (head : PageMap.Head) : IO PageMap.Snapshot := do
+  let current ← PageMap.pin path
+  let some retained ← PageMap.HistoryReader.make? current head |
+    throw (IO.userError "captured prepared input extent is unavailable")
+  return retained.snapshot
+
+def capture (source : PageMap.Snapshot) (storage : Sidecar.Storage) (model encoder : String)
+    (numeric : Bool) : IO Reference := do
+  let population ← getNat source.get "candidates"
+  if population == 0 then return empty source model encoder
+  let some windows ← WindowOwners.open? source storage |
+    throw (IO.userError "window-owner input is not prepared")
+  let lexicalPath ← RetrievalResearch.Index.path source storage
+  let workspace ← PageMap.pin lexicalPath
+  let some lexical ← PreparedRoot.select? source workspace |
+    throw (IO.userError "lexical input is not prepared")
+  let expected ← RetrievalResearch.Index.stamp source
+  unless lexical.head.authority == RetrievalResearch.Index.authority source &&
+      (← RetrievalResearch.Index.readStamp lexical) == some expected &&
+      (← getNat lexical.get "documents") == population do
+    throw (IO.userError "prepared lexical input changed its original population")
+  let semantic := (← Sidecar.locate source storage).semantic
+  -- Lexical preparation must not discard an already completed numeric pair.
+  -- This is metadata capture off the hook, never construction of cold vectors.
+  let view ← PartitionBuild.read? semantic model encoder source
+  if numeric && view.isNone then throw (IO.userError "numeric input is not prepared")
+  let numerical := view.map fun view =>
+    ({storage,partition := view.partition.snapshot.head,matrix := view.matrix.snapshot.head} : Numeric)
+  let canonical ← Synapses.CanonicalSource.Cache.open? source storage
+  unless canonical.isSome do throw (IO.userError "canonical input is not prepared")
+  let shared ← match canonical with
+    | some canonical =>
+      let path ← Synapses.CanonicalSource.Cache.directory source storage
+      let bound ← Synapses.CanonicalSource.Cache.boundIndex? source path canonical.metadata
+      pure (bound.map (·.reader))
+    | none => Synapses.Index.open? source storage .shared
+  return {
+    producer := implementation,source := source.head,model,encoder,population
+    windows := some ⟨storage,windows.snapshot.head⟩,lexical := some ⟨storage,lexical.head⟩,numeric := numerical
+    canonical := canonical.map (fun ready => (storage,ready.metadata))
+    shared := shared.map (fun ready => ⟨storage,ready.index.head⟩),usage := none}
+
+def folder (source : PageMap.Snapshot) (storage : Sidecar.Storage) (model encoder : String) : IO System.FilePath := do
+  return (← Sidecar.locate source storage).indexes / "query-inputs" /
+    Sha256.hex (toJson (implementation,model,encoder)).compress.toUTF8
+
+def sourceKey (head : PageMap.Head) : String := "source:"++Synapses.Index.contentKey head
+
+/-- Prepared roots are published once outside hooks. The live source-name
+directory is bounded; an admitted caller carries the full immutable record. -/
+def publish (source : PageMap.Snapshot) (storage : Sidecar.Storage) (model encoder : String)
+    (numeric : Bool) : IO Reference := do
+  let reference ← capture source storage model encoder numeric
+  let path ← folder source storage model encoder
+  let (_,index) ← Sidecar.withIndexClaim (Sidecar.Owner.ofSnapshot source) .canonical (fun _ => do
+    let index ← match ← PageMap.open? path with
+      | some index => pure index
+      | none => PageMap.create path ("prepared-query-inputs:"++source.head.identity++":"++implementation)
+    return (path,index)) storage
+  let encoded := (toJson reference).compress.toUTF8
+  unless encoded.size ≤ 65536 do throw (IO.userError "prepared input metadata exceeds its byte bound")
+  if (← index.get (sourceKey source.head)) == some encoded then return reference
+  let (_,_,_) ← PageMap.withWriter index fun writer => do
+    if (← writer.get (sourceKey source.head)).isNone then
+      let count ← getNat writer.get "count"
+      let slot := key "slot" (count%64)
+      if let some previous ← writer.get slot then
+        let old ← Synapses.Index.decode (α := PageMap.Head) previous
+        if old != source.head then writer.put (sourceKey old) none
+      writer.put slot (some (toJson source.head).compress.toUTF8)
+      putNat writer "count" (count+1)
+    writer.put (sourceKey source.head) (some encoded)
+    writer.put "latest" (some encoded)
+  return reference
+
+def load? (source : PageMap.Snapshot) (model encoder : String) : IO (Option Reference) := do
+  -- An actually empty source needs no lexical or numerical publication. Its
+  -- original head still belongs to the complete certification/read inventory.
+  if (← getNat source.get "candidates") == 0 then return some (empty source model encoder)
+  for storage in [Sidecar.Storage.database,.user] do
+    let path ← folder source storage model encoder
+    let found ← try
+      match ← PageMap.open? path with
+      | none => pure none
+      | some index =>
+        let raw ← match ← index.get (sourceKey source.head) with
+          | some raw => pure (some raw)
+          | none => index.get "latest"
+        raw.mapM (Synapses.Index.decode (α := Reference))
+      catch error => match error with
+        | .permissionDenied _ _ _ => pure none
+        | _ => throw error
+    if let some reference := found then
+      unless reference.producer == implementation && reference.source.identity == source.head.identity &&
+          reference.source.authority == source.head.authority && reference.model == model && reference.encoder == encoder do
+        throw (IO.userError "foreign prepared query input record")
+      if reference.source == source.head || (← Synapses.Index.sameSources source reference.source) then
+        -- Usage is private and may advance without a source publication.
+        let usage ← Synapses.UsageCache.open? source
+        return some {reference with source := source.head,usage := usage.map (·.index.head)}
+  return none
+
+def lexical (reference : Reference) (source : PageMap.Snapshot) : IO (RetrievalResearch.Index.Reader source) := do
+  unless reference.source == source.head && reference.producer == implementation do
+    throw (IO.userError "captured lexical input changed its source")
+  let some root := reference.lexical | throw (IO.userError "captured lexical input has no root")
+  let index ← restore (← RetrievalResearch.Index.path source root.storage) root.head
+  let expected ← RetrievalResearch.Index.stamp source
+  unless index.head.authority == RetrievalResearch.Index.authority source &&
+      (← RetrievalResearch.Index.readStamp index) == some expected &&
+      (← getNat index.get "documents") == expected.candidates && reference.population == expected.candidates do
+    throw (IO.userError "captured lexical input changed its population or producer")
+  return ⟨index,expected⟩
+
+def windows (reference : Reference) (source : PageMap.Snapshot) : IO WindowOwners.Ready := do
+  unless reference.source == source.head && reference.producer == implementation do
+    throw (IO.userError "captured window input changed its source")
+  let some root := reference.windows | throw (IO.userError "captured window input has no root")
+  let index ← restore (← WindowOwners.folder source root.storage) root.head
+  let some ready ← WindowOwners.at? source index | throw (IO.userError "captured window input is unavailable")
+  unless ready.manifest.stamp == (← SourceCatalogue.stamp source) &&
+      (← PartitionBuild.sourceCompatible source ready.manifest.source) do
+    throw (IO.userError "captured window input changed its original publication")
+  return ready
+
+def numerical (reference : Reference) (source : PageMap.Snapshot) : IO (PartitionBuild.ReadView source × Sidecar.Storage) := do
+  unless reference.accepts source reference.model reference.encoder do
+    throw (IO.userError "captured numeric input changed its source")
+  let some numeric := reference.numeric | throw (IO.userError "captured numeric input was not prepared")
+  let root := (← Sidecar.locate source numeric.storage).semantic
+  let index ← restore (PartitionBuild.folder root reference.model reference.encoder source) numeric.partition
+  let some partition ← VectorPartition.at? index | throw (IO.userError "captured partition is unavailable")
+  let matrixIndex ← restore (VectorMatrix.folder root reference.model reference.encoder) numeric.matrix
+  unless matrixIndex.head.authority == VectorMatrix.authority reference.model reference.encoder &&
+      partition.header.basis.eligibility == (← PartitionBuild.eligibility source) &&
+      (← PartitionBuild.sourceCompatible source partition.header.basis.source) do
+    throw (IO.userError "captured numeric input changed its authority or eligibility")
+  let stats ← VectorMatrix.statistics matrixIndex
+  let matrix : VectorMatrix.Ready := ⟨⟨stats.rows,stats.bytes⟩,matrixIndex⟩
+  unless partition.header.basis.width*8 == (← ProjectionCursor.width matrix) do
+    throw (IO.userError "captured matrix width changed")
+  if same : partition.header.basis.matrix = matrix.snapshot.head then
+    return (⟨partition,matrix,same⟩,numeric.storage)
+  else throw (IO.userError "captured matrix differs from its routing basis")
+
+def shared (reference : Reference) (source : PageMap.Snapshot) : IO (Option Synapses.Index.Reader) := do
+  unless reference.source == source.head && reference.producer == implementation do
+    throw (IO.userError "captured shared input changed its source")
+  let some root := reference.shared | return none
+  let path ← Synapses.Index.directory source root.storage .shared
+  let index ← restore path root.head
+  let some reader ← Synapses.Index.atSource? source index .shared |
+    throw (IO.userError "captured shared synapse input changed its source or producer")
+  return some reader
+
+def forSources (references : Option (Array Reference)) (sources : Array PageMap.Snapshot) :
+    IO (Option (Array Reference)) := references.mapM fun references =>
+  sources.mapM fun source => do
+    let some reference := references.find? (·.source == source.head) |
+      throw (IO.userError "prepared input record omitted a requested source")
+    unless reference.producer == implementation do throw (IO.userError "prepared input producer changed")
+    return reference
+
+def usage (reference : Reference) (source : PageMap.Snapshot) : IO (Option Synapses.Index.Reader) := do
+  unless reference.source == source.head && reference.producer == implementation do
+    throw (IO.userError "captured usage input changed its source")
+  let some head := reference.usage | return none
+  let index ← restore (← Synapses.UsageCache.directory source) head
+  let some reader ← Synapses.Index.atSource? source index .usage |
+    throw (IO.userError "captured private usage input changed its scope")
+  unless (← index.get "classifier") == some Synapses.UsageCache.implementation.toUTF8 do
+    throw (IO.userError "captured private usage input changed its classifier")
+  return some reader
+
+end Eggshell.PreparedInputs

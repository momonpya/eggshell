+def capturePrepared (request : Search) : IO Search := do
+  if !(decide (request.pending.projection = .automatic)) then return request
+  if request.prepared.isSome then
+    unless request.originals.isSome do throw (IO.userError "prepared query omitted its original boundary")
+    return request
+  let context ← ProjectContext.open? request.pending request.deadline
+  let selection := context.map (·.physicalSelection) |>.getD (pendingSelection request.pending)
+  let snapshots ← retainedSelection selection (context.map (·.snapshots))
+  let model ← match request.pending.semanticMatcher with
+    | some (_ :: _ :: args) =>
+      let settings ← IO.ofExcept (SearchProvider.parse {cache := .mk ".",models := .mk "."} args)
+      pure settings.model
+    | _ => pure MiniLM.model
+  let prepared ← (snapshots.filterMap id).toArray.mapM fun source => do
+    unless (← IO.monoMsNow) < request.deadline do throw (IO.userError "prepared query capture expired")
+    let some inputs ← PreparedInputs.load? source model SearchProvider.encoderContract |
+      throw (IO.userError "source query inputs are pending preparation")
+    return inputs
+  return {request with
+    prepared := some prepared
+    originals := some (snapshots.map (·.map (·.head)))}
+
+/-- Raw DB readers carry the same retained heads as project readers. Waiting
+for an execution slot must not replace the captured boundary with latest. -/
+def originalSnapshots (request : Search) (selection : Config.Selection)
+    (project : Option (List (Option DB.PageMap.Snapshot))) : IO (Option (List (Option DB.PageMap.Snapshot))) := do
+  let some heads := request.originals | return project
+  unless heads.length == selection.read.length do throw (IO.userError "captured original inventory changed")
+  if let some snapshots := project then
+    unless snapshots.map (·.map (·.head)) == heads do throw (IO.userError "captured project boundary changed")
+    return some snapshots
+  return some (← (selection.read.zip heads).mapM fun (path,head) => do
+    let some head := head | return none
+    let current ← DB.PageMap.pin path.path
+    let some retained ← DB.PageMap.HistoryReader.make? current head |
+      throw (IO.userError "captured original extent is unavailable")
+    return some retained.snapshot)

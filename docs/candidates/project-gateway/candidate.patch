+module
+public import Eggshell.PublicationClient
+@[expose] public section
+
+namespace Eggshell.Plugin.Publication.Gateway
+open Lean DB
+
+/-- Actual protocol/source bytes, not a manually maintained version. -/
+def implementation : String := Blake3.hex (Blake3.digest "eggshell.project-gateway".toUTF8 [
+  (include_str "ProjectGateway.lean").toUTF8,(include_str "ProjectGatewayPeer.lean").toUTF8,
+  Publication.implementation.toUTF8])
+
+/-- Host-side configuration, never a client request. The process channel is
+authenticated by its operator (for example a forced SSH command). -/
+structure Entry where
+  name : String
+  directory : String
+  readable : Bool
+  writable : Bool
+  deriving FromJson, ToJson
+structure Catalog where
+  projects : Array Entry
+  deriving FromJson, ToJson
+structure Selection where
+  read : Array String
+  write : Option String
+  deriving FromJson, ToJson, BEq
+structure NamedManifest where
+  name : String
+  manifest : ProjectStore.Manifest
+  deriving FromJson, ToJson
+structure Descriptor where
+  protocol : String
+  projects : Array NamedManifest
+  write : Option String
+  deriving FromJson, ToJson
+structure NamedCut where
+  name : String
+  cut : ProjectStore.Cut
+  deriving FromJson, ToJson
+structure Boundary where
+  scope : String
+  projects : Array NamedCut
+  deriving FromJson, ToJson
+structure Write where
+  name : String
+  grant : ProjectGrant
+structure Scope where
+  descriptor : Descriptor
+  key : String
+  readers : Array (String × ReadGrant)
+  writer : Option Write
+
+def Boundary.inScope (boundary : Boundary) (scope : Scope) : Bool :=
+  boundary.scope == scope.key &&
+    boundary.projects.map (·.name) == scope.readers.map (·.1) &&
+    (boundary.projects.zip scope.readers).all (fun (cut,(_,grant)) => cut.cut.inScope grant.manifest)
+
+theorem boundary_keeps_all_projects (boundary : Boundary) (scope : Scope)
+    (accepted : boundary.inScope scope = true) :
+    boundary.projects.map (·.name) = scope.readers.map (·.1) := by
+  simp only [Boundary.inScope,Bool.and_eq_true,beq_iff_eq] at accepted
+  exact accepted.1.2
+
+def writeFor (scope : Scope) (target : String) : Except String Write :=
+  match scope.writer with
+  | none => .error "read-only project scope"
+  | some writer => if writer.grant.manifest.identity == target then .ok writer
+      else .error "publication changed its captured project"
+
+theorem readonly_rejects_publication (scope : Scope) (target : String) :
+    writeFor {scope with writer := none} target = .error "read-only project scope" := rfl
+
+theorem publication_keeps_target (scope : Scope) (target : String) (writer : Write)
+    (accepted : writeFor scope target = .ok writer) : writer.grant.manifest.identity = target := by
+  cases saved : scope.writer with
+  | none => simp [writeFor,saved] at accepted
+  | some selected =>
+      by_cases same : selected.grant.manifest.identity == target
+      · simp [writeFor,saved,same] at accepted
+        subst writer
+        simpa only [beq_iff_eq] using same
+      · simp [writeFor,saved,same] at accepted
+
+def openScope (endpoint : Daemon.Endpoint) (catalog : Catalog) (selection : Selection) : IO Scope := do
+  unless catalog.projects.size ≤ 64 && (catalog.projects.toList.map (·.name)).Nodup &&
+      catalog.projects.all (fun entry => !entry.name.isEmpty && (!entry.writable || entry.readable)) &&
+      selection.read.size ≤ 64 && selection.read.toList.Nodup &&
+      selection.write.all selection.read.contains do throw (IO.userError "invalid project selection")
+  let mut readers : Array (String × ReadGrant) := #[]
+  let mut descriptions : Array NamedManifest := #[]
+  let mut writer : Option Write := none
+  for name in selection.read do
+    let some entry := catalog.projects.find? (·.name == name) | throw (IO.userError "project scope denied")
+    unless entry.readable && (selection.write != some name || entry.writable) do
+      throw (IO.userError "project scope denied")
+    let project ← ProjectStore.openProject (.mk entry.directory)
+    let read ← Client.registerReadProject endpoint project.directory project.manifest.identity
+    unless read.manifest == project.manifest do throw (IO.userError "read inventory changed")
+    readers := readers.push (name,read)
+    descriptions := descriptions.push (⟨name,read.manifest⟩ : NamedManifest)
+    if selection.write == some name then
+      let grant ← Client.registerProject endpoint project.directory project.manifest.identity
+      unless grant.manifest == read.manifest do throw (IO.userError "write inventory changed")
+      writer := some ⟨name,grant⟩
+  unless ((descriptions.map (·.manifest.identity)).toList).Nodup do
+    throw (IO.userError "project aliases repeat one physical inventory")
+  let descriptor : Descriptor := ⟨implementation,descriptions,selection.write⟩
+  let key := Blake3.hex (Blake3.digest "eggshell.project-gateway-scope".toUTF8 [(toJson descriptor).compress.toUTF8])
+  return ⟨descriptor,key,readers,writer⟩
+
+def pin (endpoint : Daemon.Endpoint) (scope : Scope) (deadline : Nat) : IO Boundary := do
+  let projects ← scope.readers.mapM fun (name,grant) => do
+    return (⟨name,← Client.pinReadProject endpoint grant deadline⟩ : NamedCut)
+  let boundary : Boundary := ⟨scope.key,projects⟩
+  unless boundary.inScope scope do throw (IO.userError "project pin changed its complete scope")
+  return boundary
+
+inductive Operation where
+  | open (selection : Selection)
+  | pin
+  | publish (target : String) (boundary : Boundary) (capsule : Capsule)
+  deriving FromJson, ToJson
+structure Request where
+  id : String
+  protocol : String
+  budgetMs : Nat
+  operation : Operation
+  deriving FromJson, ToJson
+
+def execute (endpoint : Daemon.Endpoint) (scope : Scope) (operation : Operation) (deadline : Nat) : IO Json := do
+  match operation with
+  | .open _ => throw (IO.userError "project scope is immutable for this connection")
+  | .pin => return toJson (← pin endpoint scope deadline)
+  | .publish target boundary capsule =>
+    let writer ← IO.ofExcept (writeFor scope target)
+    unless boundary.inScope scope do throw (IO.userError "publication changed its complete read boundary")
+    let some original := boundary.projects.find? (·.name == writer.name) |
+      throw (IO.userError "publication omitted its write project cut")
+    let mut inputs := #[]
+    for (saved,(name,grant)) in boundary.projects.zip scope.readers do
+      if name != writer.name then inputs := inputs.push (grant,saved.cut)
+    return toJson (← Client.submitProject endpoint writer.grant original.cut capsule inputs deadline)
+
+/-- A connection owns its input/output streams. Neither a registry lock nor
+a shared request queue serializes independent gateway processes. -/
+partial def readExactly (input : IO.FS.Stream) (count : Nat) (accumulated : ByteArray := .empty) : IO (Option ByteArray) := do
+  if count == 0 then return some accumulated
+  let bytes ← input.read (min count 65536).toUSize
+  if bytes.isEmpty then
+    if accumulated.isEmpty then return none
+    else throw (IO.userError "truncated project frame")
+  unless bytes.size ≤ count do throw (IO.userError "invalid project frame extent")
+  readExactly input (count-bytes.size) (accumulated++bytes)
+
+def readFrame (input : IO.FS.Stream) : IO (Option ByteArray) := do
+  let some header ← readExactly input 4 | return none
+  let count := Daemon.decodeLength header
+  unless 0 < count && count ≤ Daemon.maxFrameBytes do throw (IO.userError "project frame exceeds its bound")
+  let some bytes ← readExactly input count | throw (IO.userError "truncated project frame")
+  return some bytes
+
+def writeFrame (output : IO.FS.Stream) (value : Json) : IO Unit := do
+  let bytes := value.compress.toUTF8
+  unless bytes.size ≤ Daemon.maxFrameBytes do throw (IO.userError "project reply exceeds its bound")
+  output.write (Daemon.frameLength bytes)
+  output.write bytes
+  output.flush
+
+inductive ReplyBody where
+  | value (data : Json)
+  | error (message : String)
+  deriving FromJson, ToJson
+structure Reply where
+  id : String
+  protocol : String
+  body : ReplyBody
+  deriving FromJson, ToJson
+
+def response (id : String) (result : Except String Json) : Reply :=
+  ⟨id,implementation,match result with | .ok value => .value value | .error message => .error message⟩
+
+theorem response_keeps_request (id : String) (result : Except String Json) :
+    (response id result).id = id := rfl
+
+def decode (bytes : ByteArray) : IO Request := do
+  let some text := String.fromUTF8? bytes | throw (IO.userError "invalid project request encoding")
+  let request ← IO.ofExcept (Json.parse text >>= fromJson? (α := Request))
+  unless request.protocol == implementation && !request.id.isEmpty && request.id.length ≤ 128 &&
+      0 < request.budgetMs && request.budgetMs ≤ maxBudgetMs do
+    throw (IO.userError "invalid project request bounds")
+  return request
+
+/-- This stdio boundary must be launched through an operator-authenticated
+channel. It never listens on an unauthenticated network socket or exports the
+local administration endpoint, filesystem paths, or private capabilities. -/
+def run (profile : System.FilePath) : IO UInt32 := do
+  let input ← IO.getStdin
+  let output ← IO.getStdout
+  try
+    let some first ← readFrame input | return 0
+    let request ← decode first
+    let .open selection := request.operation | throw (IO.userError "project selection must be first")
+    let raw ← FileSystem.boundedBytes profile 65536
+    let some text := String.fromUTF8? raw | throw (IO.userError "invalid project catalog")
+    let catalog ← IO.ofExcept (Json.parse text >>= fromJson? (α := Catalog))
+    -- A client connection never owns, starts, or stops the shared publisher.
+    let some endpoint ← Client.endpoint? | throw (IO.userError "project service is not running")
+    Client.ready endpoint
+    let scope ← openScope endpoint catalog selection
+    writeFrame output (toJson (response request.id (.ok (toJson scope.descriptor))))
+    repeat
+      let some bytes ← readFrame input | break
+      let request ← decode bytes
+      let deadline := (← IO.monoMsNow)+request.budgetMs
+      let result : Except String Json ← try pure (.ok (← execute endpoint scope request.operation deadline))
+        catch _ => pure (.error "project request rejected")
+      writeFrame output (toJson (response request.id result))
+    return 0
+  catch _ =>
+    -- Detailed filesystem errors and administration secrets stay on the host.
+    -- A failed bootstrap has issued neither a descriptor nor a project grant.
+    return 1
+end Eggshell.Plugin.Publication.Gateway

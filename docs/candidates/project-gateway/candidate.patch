+module
+public import Eggshell.ProjectGateway
+public import Eggshell.Worker
+@[expose] public section
+
+namespace Eggshell.Plugin.Publication.Gateway
+open Lean DB
+
+abbrev PipeChild := IO.Process.Child {stdin := .null,stdout := .piped,stderr := .piped}
+
+/-- One caller owns this connection. Independent requests use independent
+connections; no global channel mutex or serialized multi-client queue exists. -/
+structure Channel where
+  private mk ::
+  private input : IO.FS.Stream
+  private output : IO.FS.Stream
+  private child : PipeChild
+  private errors : Task (Except IO.Error Unit)
+  private closed : IO.Ref Bool
+
+private partial def drain (handle : IO.FS.Handle) : IO Unit := do
+  let bytes ← handle.read 65536
+  unless bytes.isEmpty do drain handle
+
+/-- Only this connection's sequential owner closes its child. Timeout and
+scope exit share the same flag, so a reaped PID is never signalled again. -/
+private def closeChannel (channel : Channel) : IO Unit := do
+  unless ← channel.closed.get do
+    channel.closed.set true
+    Worker.killGroup channel.child
+    discard <| channel.child.wait
+    discard <| IO.wait channel.errors
+
+@[no_expose] def Channel.exchange (channel : Channel) (operation : Operation) (deadline : Nat) : IO Json := do
+  let now ← IO.monoMsNow
+  unless now < deadline && !(← channel.closed.get) do throw (IO.userError "project request expired or closed")
+  let id ← Receipt.fresh
+  let request : Request := ⟨id,implementation,min maxBudgetMs (deadline-now),operation⟩
+  let task ← IO.asTask (do
+    writeFrame channel.output (toJson request)
+    let some bytes ← readFrame channel.input | throw (IO.userError "project channel closed without a reply")
+    let some text := String.fromUTF8? bytes | throw (IO.userError "project reply is not UTF-8")
+    let value ← IO.ofExcept (Json.parse text >>= fromJson? (α := Reply))
+    unless value.id == id && value.protocol == implementation do
+      throw (IO.userError "project reply belongs to another request or implementation")
+    match value.body with
+    | .value result => pure result
+    | .error message => throw (IO.userError message)) .dedicated
+  try
+    while !(← IO.hasFinished task) do
+      unless (← IO.monoMsNow) < deadline do throw (IO.userError "project request exceeded its deadline")
+      IO.sleep 2
+    IO.ofExcept (task.get.mapError IO.Error.toString)
+  finally
+    if !(← IO.hasFinished task) then
+      closeChannel channel
+      discard <| IO.wait task
+
+structure Peer where
+  private mk ::
+  private channel : Channel
+  descriptor : Descriptor
+  key : String
+
+def Peer.accepts (peer : Peer) (boundary : Boundary) : Bool :=
+  boundary.scope == peer.key &&
+    boundary.projects.map (·.name) == peer.descriptor.projects.map (·.name) &&
+    (boundary.projects.zip peer.descriptor.projects).all (fun (cut,project) => cut.cut.inScope project.manifest)
+
+@[no_expose] def Peer.pin (peer : Peer) (deadline : Nat) : IO Boundary := do
+  let boundary ← IO.ofExcept (fromJson? (α := Boundary) (← peer.channel.exchange .pin deadline))
+  unless peer.accepts boundary do throw (IO.userError "project pin changed its complete read scope")
+  return boundary
+
+@[no_expose] def Peer.publish (peer : Peer) (target : String) (boundary : Boundary) (capsule : Capsule)
+    (deadline : Nat) : IO ProjectReceipt := do
+  unless peer.accepts boundary do throw (IO.userError "publication changed its complete read scope")
+  let some name := peer.descriptor.write | throw (IO.userError "read-only project scope")
+  let some writer := peer.descriptor.projects.find? (·.name == name) | throw (IO.userError "missing write project")
+  unless writer.manifest.identity == target do throw (IO.userError "publication changed its captured project")
+  let some original := boundary.projects.find? (·.name == name) | throw (IO.userError "missing write cut")
+  let inputs := (boundary.projects.zip peer.descriptor.projects).filterMap fun (cut,project) =>
+    if project.name == name then none else some (project.manifest,cut.cut)
+  let result ← peer.channel.exchange (.publish target boundary capsule) deadline
+  let checked ← IO.ofExcept (Client.checkProjectReceipt writer.manifest original.cut capsule inputs result)
+  unless (← IO.monoMsNow) < deadline do throw (IO.userError "project ACK arrived after its deadline")
+  return checked
+
+/-- Command arguments are operator configuration, not tool output or request
+text. SSH authentication/forced-command policy belongs to that deployment.
+Child groups and pipe tasks are owned and joined on every exit. -/
+@[no_expose] def withPeer (command : Array String) (selection : Selection) (deadline : Nat) (action : Peer → IO α) : IO α := do
+  unless (← IO.monoMsNow) < deadline do throw (IO.userError "project connection expired")
+  let some executable := command[0]? | throw (IO.userError "empty project service command")
+  let spawned ← IO.Process.spawn {
+    cmd := executable, args := command.extract 1 command.size,
+    stdin := .piped, stdout := .piped, stderr := .piped, setsid := true }
+  let (stdin,child) ← spawned.takeStdin
+  let errors ← IO.asTask (drain child.stderr) .dedicated
+  let channel : Channel := ⟨IO.FS.Stream.ofHandle child.stdout,IO.FS.Stream.ofHandle stdin,child,errors,← IO.mkRef false⟩
+  try
+    let value ← channel.exchange (.open selection) deadline
+    let descriptor ← IO.ofExcept (fromJson? (α := Descriptor) value)
+    unless descriptor.protocol == implementation && descriptor.projects.map (·.name) == selection.read && descriptor.write == selection.write &&
+      descriptor.projects.all (fun project => decide project.manifest.Valid) &&
+      (descriptor.projects.toList.map (·.manifest.identity)).Nodup do
+      throw (IO.userError "project service changed its selected inventory")
+    let key := Blake3.hex (Blake3.digest "eggshell.project-gateway-scope".toUTF8 [(toJson descriptor).compress.toUTF8])
+    action ⟨channel,descriptor,key⟩
+  finally
+    closeChannel channel
+end Eggshell.Plugin.Publication.Gateway

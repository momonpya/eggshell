diff --git a/PartitionBuild.lean b/PartitionBuild.lean
index 19c0588..fda81ec 100644
--- a/PartitionBuild.lean
+++ b/PartitionBuild.lean
@@ -46,0 +47,32 @@ def open? (root : System.FilePath) (model encoder : String) (source : PageMap.Sn
+/-- Routing and scoring retain the same authenticated matrix publication.
+The source parameter is the caller's exact input, never a newer ready source. -/
+structure ReadView (source : PageMap.Snapshot) where
+  partition : VectorPartition.Ready
+  matrix : VectorMatrix.Ready
+  sameMatrix : partition.header.basis.matrix = matrix.snapshot.head
+
+theorem ReadView.matrix_is_routing_basis (view : ReadView source) :
+    view.matrix.snapshot.head = view.partition.header.basis.matrix := view.sameMatrix.symm
+
+/-- A later matrix suffix does not invalidate a completed partition. Restore
+its exact matrix root, with extent, authority and statistics validation. -/
+def read? (root : System.FilePath) (model encoder : String) (source : PageMap.Snapshot) :
+    IO (Option (ReadView source)) := do
+  let some workspace ← PageMap.open? (folder root model encoder) | return none
+  unless workspace.head.authority == VectorPartition.authority do
+    throw (IO.userError "foreign partition read authority")
+  let some snapshot ← PreparedRoot.select? source workspace | return none
+  let some partition ← VectorPartition.at? snapshot | return none
+  unless partition.header.basis.eligibility == (← eligibility source) &&
+      (← sourceCompatible source partition.header.basis.source) do return none
+  let some current ← PageMap.open? (VectorMatrix.folder root model encoder) | return none
+  unless current.head.authority == VectorMatrix.authority model encoder do
+    throw (IO.userError "foreign matrix read authority")
+  let some retained ← PageMap.HistoryReader.make? current partition.header.basis.matrix | return none
+  let stats ← VectorMatrix.statistics retained.snapshot
+  let matrix : VectorMatrix.Ready := ⟨⟨stats.rows,stats.bytes⟩,retained.snapshot⟩
+  unless partition.header.basis.width*8 == (← ProjectionCursor.width matrix) do return none
+  if exact : partition.header.basis.matrix = matrix.snapshot.head then
+    return some ⟨partition,matrix,exact⟩
+  else throw (IO.userError "retained matrix changed the routing basis")
+

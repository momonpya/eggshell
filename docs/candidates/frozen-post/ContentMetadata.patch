+/-- Native correspondence headers/chunks are immutable source records.
+Historical consumers may use them without borrowing any later supplement. -/
+def publishedCoordinates (snapshot : PageMap.Snapshot) (id : Nat) (doc : Document)
+    (original : ObservationContext.Catalog) : IO ObservationContext.Catalog := do
+  let some parent ← load? snapshot id doc | return original
+  let captured ← IO.ofExcept (catalog snapshot.head.identity doc parent)
+  return {
+    original with
+    located := captured.located ++ original.located
+    quotations := captured.quotations ++ original.quotations}
 

+/-- Only selected comparison data survives the rendering wait. The discovery
+graph and quotient are consumed while preparing this value, not captured in
+an IO continuation. Generator/Value encoding still waits for a receipt. -/
+structure PreparedSelectionAudit where
+  snapshot : SelectionAudit.Prepared
+  completed : List Selected
+
+@[noinline] def prepareRenderedSelectionAudit (receipt : Option String)
+    (discovery : Matcher.Discovery)
+    (prepared : {extraction : Extraction // extraction = Matcher.extraction discovery}) :
+    Option PreparedSelectionAudit :=
+  if receipt.isNone then none else
+    let valid : prepared.val.selection.validFor discovery.view.graph
+        discovery.view.quotient.toEquality discovery.policy discovery.current = true := by
+      simpa only [prepared.property] using Matcher.extraction_sound discovery
+    let report := SelectionDependency.Report.ofValid valid
+    let completed := (selectedMatches discovery prepared.val).filter
+      (fun selected => selected.applicability == .completed)
+    let owners := completed.map (fun selected => relationKey selected.matched.edge.relation)
+    let bindings := completed.map fun selected =>
+      (selected.matched.projectedEdge.relation,relationKey selected.matched.edge.relation)
+    some ⟨SelectionAudit.Prepared.ofReport discovery.persistentUnions discovery.view.localUnions report
+      owners bindings discovery.runAll (some discovery.passes),completed⟩
+
+def auditPreparedSelection (receipt : Option String) (prepared : Option PreparedSelectionAudit)
+    (result : Option Handoff) (observed : List SelectionAudit.Admission := [])
+    (trail : DiscoveryAudit.Trail := {}) : IO (Option Handoff) := do
+  if receipt.isNone then return result
+  let some handoff := result | return none
+  if handoff.completed == 0 && !handoff.blocksCurrent then return result
+  let some ready := prepared | throw (IO.userError "selected equality audit preparation is missing")
+  let admissions := ready.completed.filterMap fun selected =>
+    (observed.find? (fun admission => Matcher.sameMatch admission.matched selected.matched)).map
+      (fun admission => (admission,relationKey selected.matched.edge.relation))
+  let reference ← SelectionAudit.capture receipt (ready.snapshot.snapshot admissions observed trail)

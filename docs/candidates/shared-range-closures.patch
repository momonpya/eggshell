+/-- Reservation protects actual native-control connections. Intrinsic advisory
+Matches retain ordinary eligibility; provenance alone does not create control. -/
+def mandatorySlices (slices : List TransportSlice) : List TransportSlice :=
+  slices.filter fun slice => slice.members.any (·.blocks)
+
+theorem control_is_reserved (slices : List TransportSlice) (slice : TransportSlice)
+    (present : slice ∈ slices) (member : Selected) (belongs : member ∈ slice.members)
+    (controls : member.blocks = true) : slice ∈ mandatorySlices slices := by
+  apply List.mem_filter.mpr
+  exact ⟨present, List.any_eq_true.mpr ⟨member,belongs,controls⟩⟩
+
+theorem advisory_is_not_reserved (slice : TransportSlice)
+    (advisory : ∀ member ∈ slice.members, member.applicability = .advisory) :
+    slice.members.any (·.blocks) = false := by
+  apply List.any_eq_false.mpr
+  intro member present
+  simp [Selected.advisory_never_blocks (advisory member present)]
+
+theorem advisory_reservation_is_empty (slices : List TransportSlice)
+    (advisory : ∀ slice ∈ slices, ∀ member ∈ slice.members,
+      member.applicability = .advisory) : mandatorySlices slices = [] := by
+  apply List.filter_eq_nil_iff.mpr
+  intro slice present
+  simp [advisory_is_not_reserved slice (advisory slice present)]
+

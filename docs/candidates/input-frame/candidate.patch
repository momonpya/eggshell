+def Search.referPrepared (request : Search) (producer : String) : Search :=
+  {request with pending := {request.pending with preparedInputs := none},preparedInputProducer := some producer}
+
+def Search.restorePrepared (request : Search) : Except String Search := do
+  let some producer := request.preparedInputProducer | return request
+  unless request.referenceWellFormed do throw "invalid prepared-input reference"
+  let some inputs := request.prepared | throw "prepared-input reference omitted inputs"
+  let some originals := request.originals | throw "prepared-input reference omitted originals"
+  let frame : PreparedInputs.Frame := ⟨producer,originals,inputs,request.owners⟩

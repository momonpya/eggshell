+  let producer ← envelope.payload.getObjValAs? String "producer"
+  let frame : PreparedInputs.Frame := ⟨producer,originals,inputs,request.owners⟩
+  unless toJson frame == envelope.payload do throw "prepared-input envelope is not its checked canonical frame"
+  return request.referPrepared producer
+

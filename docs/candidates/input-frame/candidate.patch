+
+/-- Invoke only after capturePrepared has checked the original/private boundary
+and any duplicate frame. Canonical equality also preserves the private envelope
+byte-for-byte on restoration; unknown extra fields are not silently dropped. -/
+def Search.compactPrepared (request : Search) : Except String Search := do
+  unless request.referenceWellFormed do throw "ambiguous prepared-input reference"

+/-- Only the current query focus earns independent base relevance.
+Historical references keep their existing total relevance, but must earn its
+increment through a completely bound recipe rather than pre-crediting it. -/
+def focusedCues (family : Family) : List RankedCue :=
+  rankedCues {family with references := [],referenceRanks := [],synapticRanges := [],outputRanges := []}
+
+theorem focused_cues_ignore_historical (family : Family) (references : List Nat)
+    (ranks : List (Nat × Nat)) (ranges : List (Nat × Nat × Nat))
+    (outputs : List Synapses.Transport.OutputRange) :
+    focusedCues {family with references,referenceRanks := ranks,synapticRanges := ranges,outputRanges := outputs} =
+      focusedCues family := rfl
 
+theorem focused_cues_without_windows (family : Family) (empty : family.windows = []) :
+    focusedCues family = [] := by
+  unfold focusedCues rankedCues
+  cases source : Matcher.atomText? family.owner.outcome <;>
+    cases work : Matcher.atomText? family.owner.work <;>
+    simp [Family.outputCues,empty]

--- a/tools/research/CompiledOwnerPlan.lean
+++ b/tools/research/CompiledOwnerPlan.lean
@@ -0,0 +1,53 @@
+module
+public import tools.research.ReadEvidence
+@[expose] public section
+namespace Eggshell.Synapses.CompiledOwnerPlan
+
+/-- Pure publication metadata. No score, question, lease, mutable state or
+completion authority is retained in these precompiled keys and read indexes. -/
+structure Checked (owner : String) (descriptor : OwnerPalette.Descriptor) where
+  shell : PreparedPlanMetadata.Shell
+  shellExact : PreparedPlanMetadata.describe owner descriptor = some shell
+  evidence : ReadEvidence.Cached descriptor
+
+def Checked.prepare? (owner : String) (descriptor : OwnerPalette.Descriptor) : Option (Checked owner descriptor) :=
+  match found : PreparedPlanMetadata.describe owner descriptor with
+  | none => none
+  | some shell => do
+    let evidence ← ReadEvidence.prepare? descriptor
+    return ⟨shell,found,evidence⟩
+
+structure Ready where
+  owner : String
+  descriptor : OwnerPalette.Descriptor
+  compiled : Checked owner descriptor
+
+/-- A transient local reference is usable only with the exact owner and
+descriptor from the authorized palette; a foreign hint cannot replace it. -/
+def Ready.check (ready : Ready) (owner : String) (descriptor : OwnerPalette.Descriptor) :
+    Option (Checked owner descriptor) :=
+  if accepted : (ready.owner == owner && ready.descriptor == descriptor) = true then
+    some (by
+      have same : ready.owner = owner ∧ ready.descriptor = descriptor := by
+        simpa only [Bool.and_eq_true,beq_iff_eq] using accepted
+      simpa only [← same.1,← same.2] using ready.compiled)
+  else none
+
+theorem checked_shell (ready : Checked owner descriptor) :
+    PreparedPlanMetadata.describe owner descriptor = some ready.shell := ready.shellExact
+
+theorem checked_reads (ready : Checked owner descriptor) :
+    PreparedPlanMetadata.reads descriptor = some ready.evidence.part.rows := ready.evidence.exact
+
+theorem foreign_owner (ready : Ready) (owner : String) (descriptor : OwnerPalette.Descriptor)
+    (different : ready.owner ≠ owner) : ready.check owner descriptor = none := by
+  simp [Ready.check,different]
+
+theorem foreign_descriptor (ready : Ready) (owner : String) (descriptor : OwnerPalette.Descriptor)
+    (different : ready.descriptor ≠ descriptor) : ready.check owner descriptor = none := by
+  simp [Ready.check,different]
+
+theorem same_input (ready : Ready) : ready.check ready.owner ready.descriptor = some ready.compiled := by
+  simp [Ready.check]
+
+end Eggshell.Synapses.CompiledOwnerPlan
